<?xml version="1.0" encoding="utf-8"?>
<AutoVisualizer xmlns="http://schemas.microsoft.com/vstudio/debugger/natvis/2010">

  <!-- sw::array<T, N> -->
  <Type Name="sw::array&lt;*,*&gt;">
    <DisplayString>{{ size={$T2} }}</DisplayString>
    <Expand>
      <ArrayItems>
        <Size>$T2</Size>
        <ValuePointer>_elems</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- sw::basic_hashed_string -->
  <Type Name="sw::basic_hashed_string&lt;*,*&gt;">
    <DisplayString Condition="_comparisonIndex == 0">"" (None)</DisplayString>
    <DisplayString>Name = {_comparisonIndex}, Spelling = {_displayIndex}</DisplayString>
    <Expand>
      <Item Name="ComparisonIndex">_comparisonIndex</Item>
      <Item Name="DisplayIndex">_displayIndex</Item>
    </Expand>
  </Type>

  <!-- sw::basic_fixed_string<T, N> (fixed_string · fixed_wstring) — 길이 필드가 없다. 길이는 첫 널까지다 -->
  <Type Name="sw::basic_fixed_string&lt;*,*&gt;">
    <DisplayString>{_arrData,na}</DisplayString>
    <StringView>_arrData,na</StringView>
    <Expand>
      <Item Name="Capacity">$T2</Item>
      <Item Name="Data">_arrData</Item>
    </Expand>
  </Type>

  <!-- 아래 항목은 자체 구현의 배치를 읽는다. 컨테이너 형식은 `SW_ENABLE_STL_CONTAINER` 두 구성에서 같은 구현이고 할당자만 다르다. -->

  <!-- sw::vector<T, Alloc> — 자체 구현(_pData · _size · _capacity). std::vector 로 캐스트하면 배치가 달라 엉뚱한 값을 보인다 -->
  <Type Name="sw::vector&lt;*,*&gt;">
    <DisplayString>{{ size={_size} }}</DisplayString>
    <Expand>
      <Item Name="[capacity]" ExcludeView="simple">_capacity</Item>
      <ArrayItems>
        <Size>_size</Size>
        <ValuePointer>_pData</ValuePointer>
      </ArrayItems>
    </Expand>
  </Type>

  <!-- sw::deque<T, Alloc> -->
  <Type Name="sw::deque&lt;*,*&gt;">
    <DisplayString>{*(std::deque&lt;$T1,$T2&gt;*)this}</DisplayString>
    <Expand>
      <ExpandedItem>*(std::deque&lt;$T1,$T2&gt;*)this</ExpandedItem>
    </Expand>
  </Type>

  <!-- sw::list<T, Alloc> -->
  <Type Name="sw::list&lt;*,*&gt;">
    <DisplayString>{*(std::list&lt;$T1,$T2&gt;*)this}</DisplayString>
    <Expand>
      <ExpandedItem>*(std::list&lt;$T1,$T2&gt;*)this</ExpandedItem>
    </Expand>
  </Type>

  <!-- sw::unordered_map<K, V, ...> — 밀집 배열(_listDenseData)의 노드를 넣은 순서로 [키] = 값 으로 보인다 -->
  <Type Name="sw::unordered_map&lt;*,*,*,*,*&gt;">
    <DisplayString>{{ size={_listDenseData._size} }}</DisplayString>
    <Expand>
      <Item Name="[bucket_count]" ExcludeView="simple">_listBucket._size</Item>
      <CustomListItems MaxItemsPerView="5000">
        <Variable Name="i" InitialValue="0"/>
        <Size>_listDenseData._size</Size>
        <Loop>
          <Break Condition="i == _listDenseData._size"/>
          <Item Name="[{_listDenseData._pData[i]._keyValuePair.first}]">_listDenseData._pData[i]._keyValuePair.second</Item>
          <Exec>i++</Exec>
        </Loop>
      </CustomListItems>
    </Expand>
  </Type>

  <!-- sw::unordered_set<K, ...> — 밀집 배열(_listDenseData)의 키를 넣은 순서로 보인다 -->
  <Type Name="sw::unordered_set&lt;*,*,*,*&gt;">
    <DisplayString>{{ size={_listDenseData._size} }}</DisplayString>
    <Expand>
      <Item Name="[bucket_count]" ExcludeView="simple">_listBucket._size</Item>
      <IndexListItems>
        <Size>_listDenseData._size</Size>
        <ValueNode>_listDenseData._pData[$i]._key</ValueNode>
      </IndexListItems>
    </Expand>
  </Type>

  <!-- sw::basic_string<T, ...> -->
  <Type Name="sw::basic_string&lt;*,*,*&gt;">
    <DisplayString>{*(std::basic_string&lt;$T1,$T2,$T3&gt;*)this}</DisplayString>
    <Expand>
      <ExpandedItem>*(std::basic_string&lt;$T1,$T2,$T3&gt;*)this</ExpandedItem>
    </Expand>
  </Type>

</AutoVisualizer>
