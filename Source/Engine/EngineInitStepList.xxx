/**
 * @file Engine/EngineInitStepList.xxx
 * @brief 엔진 기동 · 종료 단계와 그 의존의 단일 등록표입니다(X-macro). `EngineInitSequence` 가 읽습니다.
 * @details include 하기 전에 `SW_ENGINE_STARTUP_STEP( Name, MemoryTag, Target, { Dependency, ... } )` 를 정의합니다(#pragma once 없음).
 *
 * - **줄 순서가 초기화 순서**이고, 종료는 그 역순입니다(초기화한 단계만). 객체 해제는 모든 종료 뒤에 같은 역순으로 **모든 단계**를 돕니다.
 * - `{}` 칸은 이 단계보다 **먼저 서야 하는** 단계입니다(UE `InitializeDependency`). 식별자라 오타는 컴파일 오류이고, 의존이 자기보다 아래
 *   줄에 있어도 컴파일 오류입니다(`EngineInitSequence.cpp` 의 static_assert).
 * - 순서는 의존 칸이 정합니다 — 의존만으로 위상 정렬(동점은 이름 순)한 결과가 이 표의 줄 순서와 같아야 합니다
 *   (`EngineInitSequenceTest.TableIsWrittenInStartupOrder`). 의존을 빼먹어 계산 순서가 바뀌면 그 시험이 진다.
 * - 둘째 칸은 그 단계의 초기화가 할당하는 메모리의 용도(`MemoryTag`)입니다. 초기화를 부르는 동안 그 태그가 걸립니다(`EngineInitSequence`).
 * - 셋째 칸은 그 단계가 도는 호스트(`EngineInitTarget`)입니다: `All` · `Client`(창 · 렌더러 · 플레이어 설정 — App · 에디터) · `Server`(전용 서버만).
 *   전용 서버(`EngineHostRole::DedicatedServer`)는 `Client` 줄을 돌리지 않습니다(초기화 · 종료 둘 다 — 해제는 모든 줄, 본문이 null 안전).
 *   단계가 도는 대상마다 그 의존도 돌아야 합니다 — 어기면 컴파일 오류입니다(`EngineInitSequence.cpp` 의 static_assert).
 * - 단계 본문은 호스트가 줄마다 구조체 하나로 줍니다: `<단계>StartupStep` 의 `initialize` · `shutdown` · `destroy`
 *   (`EngineInitStepDefaults` 를 상속해 필요한 것만 정의 — `EngineLoop.cpp`, 시험 하네스). 구조체가 없으면 컴파일 오류입니다.
 *   로거 · 명령줄 · 서비스 생성과 바인딩은 이 표 앞의 고정 부트스트랩이고, 그 종료는 표의 해제 뒤(`EngineBootstrap::shutdown`)입니다.
 */

//                      단계                 태그        대상    먼저 서야 하는 단계                     // 왜
SW_ENGINE_STARTUP_STEP( Compression,         EngineMisc, All,    {} )                            // 코덱 레지스트리 + Core 슬롯 + 외부 코덱
SW_ENGINE_STARTUP_STEP( Reflection,          Reflection, All,    {} )                           
SW_ENGINE_STARTUP_STEP( Config,              EngineMisc, All,    { Reflection } )                // 설정 역직렬화가 TypeInfo 를 쓴다
SW_ENGINE_STARTUP_STEP( Resource,            Asset,      All,    { Compression, Config } )       // 팩 루트는 GameConfig, 팩 스트림은 코덱
SW_ENGINE_STARTUP_STEP( EngineDefaultAssets, EngineMisc, All,    { Reflection, Resource } )     
SW_ENGINE_STARTUP_STEP( ShaderCache,         Shader,     All,    {} )                            // 서버는 빈 캐시만(씬 쿠킹의 Headless 가 의존)
SW_ENGINE_STARTUP_STEP( Task,                Task,       All,    {} )                           
SW_ENGINE_STARTUP_STEP( ModuleImages,        EngineMisc, All,    { Compression, Reflection, Resource, Task } ) // 모듈을 내리며 타입 · 코덱 · 캐시를 떼고 태스크를 기다린다
SW_ENGINE_STARTUP_STEP( Audio,               Audio,      All,    { ModuleImages, Task } )        // 음성 스트리밍이 태스크를 쓰고, 모듈 콜백을 든다 — 서버는 장치 없는 NullAudioSystem
SW_ENGINE_STARTUP_STEP( FileIo,              Asset,      All,    { ModuleImages, Task } )        // 완료 콜백을 태스크로 싣는다 — 모듈을 내리기 전에 걸린 읽기를 다 끝낸다
SW_ENGINE_STARTUP_STEP( Input,               EngineMisc, All,    { ModuleImages } )              // 모듈이 등록한 장치 · 콜백을 든다 — 서버는 이벤트가 오지 않는 장치 목록
SW_ENGINE_STARTUP_STEP( ModuleTypes,         Reflection, All,    { Config, ModuleImages, Reflection } ) // 호스트가 타입 공급자(GF · 킷 · 게임 모듈)를 올려 등록을 끝낸다 — 씬을 읽는 일은 이 뒤
SW_ENGINE_STARTUP_STEP( Physics,             Physics,    All,    { Resource, Task } )            // 설정 표(레이어 · 재질)는 리소스, Jolt 잡은 태스크
SW_ENGINE_STARTUP_STEP( Scene,               Scene,      All,    { Audio, FileIo, Input, ModuleImages, Physics, Resource, Task } ) // 컴포넌트가 입력 · 오디오 · 모듈 코드 · 에셋 · 물리 씬을 든다(스트리밍은 비동기 IO)
SW_ENGINE_STARTUP_STEP( Headless,            EngineMisc, All,    { EngineDefaultAssets, ModuleTypes, Scene, ShaderCache } ) // 셰이더 쿠킹 · 씬 쿠킹(모든 컴포넌트 타입이 있어야 쿠킹한다) — 하면 뒤 단계(창 · RHI · 렌더러)를 건너뛴다 — 서버는 씬 쿠킹만(셰이더 쿠킹 · 임포트는 거절)
SW_ENGINE_STARTUP_STEP( Fonts,               EngineMisc, Client, { EngineDefaultAssets, Headless, Resource } ) // 글꼴 카탈로그 · 기본 가족 — 문화권 표(EngineDefaultAssets)를 읽은 뒤, 쿠킹(Headless)이면 열지 않는다
SW_ENGINE_STARTUP_STEP( UserSettings,        EngineMisc, Client, { Audio, Headless, Input, Resource } ) // 플레이어 옵션 — 스키마 · 사용자 파일을 읽어 대상(오디오 · 입력 · 전역 변수)에 넣는다. 화면 값은 창을 만드는 RHI 가 읽는다
SW_ENGINE_STARTUP_STEP( RHI,                 RenderCPU,  Client, { Config, Headless, UserSettings } ) // 백엔드 선택 · 창 · 디바이스
SW_ENGINE_STARTUP_STEP( FrameRenderer,       RenderCPU,  Client, { RHI, Task } )                
SW_ENGINE_STARTUP_STEP( RenderThread,        RenderCPU,  Client, { FrameRenderer } )            
SW_ENGINE_STARTUP_STEP( LiveShader,          Shader,     Client, { FrameRenderer, RenderThread } ) // 재컴파일이 렌더 스레드를 세우고 렌더러에 알린다(Debug)
SW_ENGINE_STARTUP_STEP( SceneRHI,            RenderCPU,  Client, { RHI, Scene } )                // 씬에 디바이스를 건다 — 종료는 이것을 떼는 것이 처음
SW_ENGINE_STARTUP_STEP( Telemetry,           EngineMisc, Client, { UserSettings } )              // 동의는 사용자 설정 — 종료가 맨 처음이라 마지막 장면 요약 · 묶음을 쓴다 — 서버 크래시 묶기 · 텔레메트리는 후속(동의가 플레이어 설정이다)
SW_ENGINE_STARTUP_STEP( Ui,                  EngineMisc, Client, { Fonts, Input, UserSettings } ) // 런타임 UI — 입력(행동 · 포인터)을 읽고 글꼴로 잰다, UI 배율 · 글자 크기는 사용자 설정

// `AssetManager::shutdown` 은 Resource 단계의 해제에 있다 — 에셋을 드는 단계가 모두 Resource 뒤에 서므로, 역순 해제에서 그들의 소멸자가
// 에셋을 놓은 뒤에 캐시를 비운다. 소멸자가 태스크를 기다리는 객체(에셋 스트리밍 큐)는 Task 에 의존하는 단계(Scene)가 해제한다.
