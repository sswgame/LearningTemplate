/**
 * @file Engine/Reflection/ReflectBuiltins.xxx
 * @brief 기본 타입 · 컨테이너의 단일 등록표입니다(엔진 X-macro include + ReflectionParser 파싱).
 * @details
 * - 직접 만든 타입: REFLECT() / REFLECT_CONTAINER() 를 쓰고, 여기 넣지 않습니다.
 * - 손댈 수 없는 타입(sw::vector, int …): 이 파일에 한 번만 적습니다.
 * - Serialize/RPC/TypeRegistry: include 하기 전에 SW_REFLECT_BUILTIN_* 를 정의하면 여러 번 include 할 수 있습니다
 *   (#pragma once 없음. X-macro 파일).
 *
 * SW_REFLECT_BUILTIN_TYPE( Canonical, CppType, TextConvOrNone, NamespaceOr-, Widget, Layout, Roles, aliases... )
 *   TextConv: stoi|stoll|stoul|stoull|stof|stod|packed|none
 *     none 은 SerializeContext 가 따로 처리기를 등록하는 타입이고, packed 는 `PackedValueTraits` 의 성분 규칙(쉼표로 이은 실수)으로 등록합니다.
 *   Widget: 에디터 `InspectorValueWidget` 열거자 이름(Number · Checkbox · Text · Name · Vector2 · Vector3 · Vector4 · Matrix · Rotation · Handle · Tag · Packed · Direction).
 *     Packed 는 TextConv=packed 줄에만 씁니다(파서가 시작할 때 봅니다).
 *   Layout: 메모리 모양 — none | num | f32(멤버, …) | i32(멤버, …) | angle
 *     num   산술 스칼라 하나(정수 · 실수). 상태 직렬화 · 해시는 그 타입 그대로 싣습니다.
 *     f32 · i32 는 같은 형식(float32 · int32) 멤버를 선언 순서대로 적습니다 — 고정 배치형 코덱 · 상태 직렬화 · 해시가 성분마다 싣습니다.
 *       멤버 이름 · 형식 · 오프셋 · 크기는 Engine 컴파일이(`ReflectedValue.cpp`), i32 와 `PackedValueTraits` 의 정수 성분 표시가 맞는지도 거기서 봅니다.
 *     angle 은 라디안 float32 하나(`Radians`)이고, none 은 성분 규칙이 없는 타입(핸들 · 글 · 압축 타입)입니다.
 *   Roles: Interp(값 트랙 · UI 애니메이션이 섞는다, num · f32 · angle 에만) · State(`PROPERTY( RuntimeState )` 칸이 될 수 있다)를 | 로 잇고, 없으면 None.
 *     State 인데 Layout 이 none 이면 상태 직렬화 · 해시에 손 처리기(bool · string · hashed_string · GameObjectHandle)가 있어야 합니다(없으면 컴파일이 멈춥니다).
 *   별칭이 없으면 마지막에 _ 를 둡니다(빈 __VA_ARGS__ 경고 방지. 로더가 무시합니다).
 *   줄 하나가 정본입니다 — 위 칸에서 파서(고정 배치형 코덱 · Interp · RuntimeState 검사), 에디터 위젯, 보간, 상태 직렬화 · 해시가 만들어집니다.
 * SW_REFLECT_BUILTIN_CONTAINER( Match, Kind, WrapperStem, Roles )
 *   Kind: Sequence | Map. WrapperStem 은 `sw::<WrapperStem>Wrapper` 이고, 같은 줄기의 줄은 종류 · 역할이 같아야 합니다(파서가 시작할 때 봅니다).
 *   Roles: State(RuntimeState 칸이 될 수 있다 — 순서가 정해지고 원소를 제자리에서 쓰는 시퀀스) · Fixed(크기 고정)를 | 로 잇고, 없으면 None.
 *     래퍼 형식의 종류 · 고정 · 제자리 쓰기(`ContainerWrapperOf`)와 칸이 다르면 그 컨테이너를 쓴 생성 코드가 컴파일되지 않습니다.
 *   `array` 줄은 C 고정 배열(`T _arr[N]`)도 탑니다 — Sequence 에 Fixed 여야 합니다.
 */

// -----------------------------------------------------------------------------
// 스칼라·수학·커스텀
// -----------------------------------------------------------------------------
SW_REFLECT_BUILTIN_TYPE( int8, int8, stoi, sw, Number, num, Interp|State, signed char, int8_t )
SW_REFLECT_BUILTIN_TYPE( int16, int16, stoi, sw, Number, num, Interp|State, short, signed short, short int, int16_t )
SW_REFLECT_BUILTIN_TYPE( int32, int32, stoi, sw, Number, num, Interp|State, int, signed int, int32_t )
SW_REFLECT_BUILTIN_TYPE( int64, int64, stoll, sw, Number, num, Interp|State, long long, signed long long, int64_t )
SW_REFLECT_BUILTIN_TYPE( uint8, uint8, stoul, sw, Number, num, Interp|State, unsigned char, uint8_t )
SW_REFLECT_BUILTIN_TYPE( uint16, uint16, stoul, sw, Number, num, Interp|State, unsigned short, uint16_t )
SW_REFLECT_BUILTIN_TYPE( uint32, uint32, stoul, sw, Number, num, Interp|State, unsigned int, unsigned, uint32_t )
SW_REFLECT_BUILTIN_TYPE( uint64, uint64, stoull, sw, Number, num, Interp|State, unsigned long long, uint64_t )
SW_REFLECT_BUILTIN_TYPE( float32, float32, stof, sw, Number, num, Interp|State, float )
SW_REFLECT_BUILTIN_TYPE( float64, float64, stod, sw, Number, num, Interp|State, double )
SW_REFLECT_BUILTIN_TYPE( bool, bool, none, -, Checkbox, none, State, _ )
SW_REFLECT_BUILTIN_TYPE( string, std::string, none, std, Text, none, State, basic_string<char>, sw::string )
SW_REFLECT_BUILTIN_TYPE( hashed_string, sw::hashed_string, none, sw, Name, none, State, _ )
SW_REFLECT_BUILTIN_TYPE( float2, sw::float2, none, sw, Vector2, f32(_x,_y), Interp|State, _ )
SW_REFLECT_BUILTIN_TYPE( float3, sw::float3, none, sw, Vector3, f32(_x,_y,_z), Interp|State, _ )
SW_REFLECT_BUILTIN_TYPE( float4, sw::float4, none, sw, Vector4, f32(_x,_y,_z,_w), Interp|State, _ )
SW_REFLECT_BUILTIN_TYPE( float4x4, sw::float4x4, none, sw, Matrix, f32(_11,_12,_13,_14,_21,_22,_23,_24,_31,_32,_33,_34,_41,_42,_43,_44), None, _ )
SW_REFLECT_BUILTIN_TYPE( quaternion, sw::quaternion, none, sw, Rotation, f32(_x,_y,_z,_w), Interp|State, _ )
SW_REFLECT_BUILTIN_TYPE( SlotHandle, sw::SlotHandle, none, sw, Handle, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( ComponentHandle, sw::ComponentHandle, none, sw, Handle, none, None, sw::ComponentHandle )
SW_REFLECT_BUILTIN_TYPE( GameObjectHandle, sw::GameObjectHandle, none, sw, Handle, none, State, sw::GameObjectHandle )
SW_REFLECT_BUILTIN_TYPE( atomic_bool, sw::reflected_atomic<bool>, none, sw, Checkbox, none, None, reflected_atomic<bool>, sw::reflected_atomic<bool> )
SW_REFLECT_BUILTIN_TYPE( TagID, sw::TagID, none, sw, Tag, none, None, _ )

// -----------------------------------------------------------------------------
// 저장 전용 압축 타입
// C++ 타입 칸에는 별칭(`sw::unorm8x4`)을 적습니다. 템플릿 이름(`NormalizedVector<unorm8, 4>`)의 쉼표가 매크로 인자를 나눕니다.
// 줄을 더하면 `Core/Math/PackedValueTraits.h` 에 특수화가 있어야 합니다(없으면 SerializeContext 가 컴파일되지 않습니다).
// 줄 차례에 기대는 소비처는 없다 — 표마다 `ReflectBuiltinIndex` 로 줄을 찾고, 숫자 갈래는 형식(`ReflectBuiltinClass`) · Layout 칸이 정한다. 어디에 더해도 된다.
// -----------------------------------------------------------------------------
SW_REFLECT_BUILTIN_TYPE( half, sw::half, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( half2, sw::half2, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( half3, sw::half3, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( half4, sw::half4, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( unorm8, sw::unorm8, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( unorm16, sw::unorm16, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( snorm8, sw::snorm8, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( snorm16, sw::snorm16, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( unorm8x4, sw::unorm8x4, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( snorm8x4, sw::snorm8x4, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( unorm16x2, sw::unorm16x2, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( snorm16x2, sw::snorm16x2, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( snorm16x4, sw::snorm16x4, packed, sw, Packed, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( OctahedralNormal, sw::OctahedralNormal, packed, sw, Direction, none, None, _ )
SW_REFLECT_BUILTIN_TYPE( RGB10A2, sw::RGB10A2, packed, sw, Packed, none, None, _ )
// 각(`Core/Math/Radians.h`) — 압축 타입은 아니지만 같은 성분 규칙을 탄다. 메모리는 라디안이고 성분(글 · 인스펙터 · 숫자 · Min/Max)은 도다.
SW_REFLECT_BUILTIN_TYPE( Radians, sw::Radians, packed, sw, Packed, angle, Interp, _ )
// 정수 2 성분(`Core/Math/VectorMath.h` int2 — 타일 · 셀 좌표). 성분은 float32 로 정확한 정수 범위(±(2^24 - 1))까지만 받는다.
SW_REFLECT_BUILTIN_TYPE( int2, sw::int2, packed, sw, Packed, i32(_x,_y), State, _ )

// -----------------------------------------------------------------------------
// std:: / 서드파티 컨테이너
// -----------------------------------------------------------------------------
SW_REFLECT_BUILTIN_CONTAINER( unordered_map, Map, UnorderedMap, None )
SW_REFLECT_BUILTIN_CONTAINER( flat_map, Map, Map, None )
SW_REFLECT_BUILTIN_CONTAINER( unordered_set, Sequence, UnorderedSet, None )
SW_REFLECT_BUILTIN_CONTAINER( flat_set, Sequence, Set, None )
SW_REFLECT_BUILTIN_CONTAINER( vector, Sequence, Vector, State )
SW_REFLECT_BUILTIN_CONTAINER( TArray, Sequence, Vector, State )
SW_REFLECT_BUILTIN_CONTAINER( deque, Sequence, Deque, State )
SW_REFLECT_BUILTIN_CONTAINER( array, Sequence, Array, State|Fixed )
// 열거자로 색인하는 고정 배열(Core `EnumArray`)은 열거자 → 값 맵이다 — 텍스트 키가 열거자 이름이라 열거자를 끼워도 값이 밀리지 않는다(`EnumArrayWrapper`)
SW_REFLECT_BUILTIN_CONTAINER( EnumArray, Map, EnumArray, Fixed )
