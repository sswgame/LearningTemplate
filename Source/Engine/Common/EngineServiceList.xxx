/**
 * @file Engine/Common/EngineServiceList.xxx
 * @brief App이 소유하고 Engine.dll이 조회하는 코어 서비스 단일 등록표 (X-macro).
 * @details include 전에 아래 매크로를 정의한 뒤 여러 번 include 합니다 (#pragma once 없음).
 *          전방 선언 · EngineServices 멤버 · engine::getXxx() 선언/정의 · areEngineServicesBound() 본문 ·
 *          ModuleServiceId 열거형 · ModuleServiceTraits가 이 목록에서 생성됩니다.
 *
 * SW_ENGINE_SERVICE( member, Tag, Type, getter, required, gameAllowed )
 *   Type& getter()        — 바인딩 안 됐으면 assert. required=1이면 areEngineServicesBound() 검사에 포함.
 *                           gameAllowed=1이면 게임 모듈(SWGame)에 노출, 0이면 호스트/에디터 전용(게임 요청 시 nullptr).
 * SW_ENGINE_SERVICE_CONST( member, Tag, Type, getter, required, gameAllowed )
 *   const Type& getter()  — 위와 동일, const 참조 반환.
 * SW_ENGINE_SERVICE_OPT( member, Tag, Type, getter, gameAllowed )
 *   Type* getter()        — assert 없음(널 허용). bound 검사에서 제외.
 *
 * 정의하지 않은 변형은 includer가 빈 매크로로 채워야 합니다.
 */

SW_ENGINE_SERVICE( _pFrameDoubleBuffer, class, FrameDoubleBuffer, getFrameDoubleBuffer, 1, 1 )
SW_ENGINE_SERVICE( _pCommandLineManager, class, CommandLineManager, getCommandLineManager, 1, 0 )
SW_ENGINE_SERVICE( _pGlobalVariableManager, class, GlobalVariableManager, getGlobalVariableManager, 1, 1 )
