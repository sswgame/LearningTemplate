/**
 * @file Engine/Common/EngineServiceList.xxx
 * @brief App이 소유하고 Engine.dll이 조회하는 코어 서비스 단일 등록표 (X-macro).
 * @details include 전에 아래 매크로를 정의한 뒤 여러 번 include 합니다 (#pragma once 없음).
 *          EngineServices 멤버 · engine::getXxx() 선언/정의 · areEngineServicesBound() 본문이
 *          이 목록에서 생성됩니다.
 *
 * SW_ENGINE_SERVICE( member, Type, getter, required )
 *   Type& getter()        — 바인딩 안 됐으면 assert. required=1이면 areEngineServicesBound() 검사에 포함.
 * SW_ENGINE_SERVICE_CONST( member, Type, getter, required )
 *   const Type& getter()  — 위와 동일, const 참조 반환.
 * SW_ENGINE_SERVICE_OPT( member, Type, getter )
 *   Type* getter()        — assert 없음(널 허용). bound 검사에서 제외.
 *
 * 정의하지 않은 변형은 includer가 빈 매크로로 채워야 합니다.
 * FrameDoubleBuffer는 getter가 FrameDoubleBuffer::get()으로 위임되고 bind에 부수효과가
 * 있어 이 목록에서 제외하고 손으로 관리합니다.
 */

SW_ENGINE_SERVICE( _pCommandLineManager, CommandLineManager, getCommandLineManager, 1 )
SW_ENGINE_SERVICE( _pGlobalVariableManager, GlobalVariableManager, getGlobalVariableManager, 1 )
SW_ENGINE_SERVICE( _pLocalizationManager, LocalizationManager, getLocalizationManager, 1 )
SW_ENGINE_SERVICE( _pTaskManager, TaskManager, getTaskManager, 1 )
SW_ENGINE_SERVICE( _pTypeRegistry, TypeRegistry, getTypeRegistry, 1 )
SW_ENGINE_SERVICE( _pSceneManager, SceneManager, getSceneManager, 1 )
SW_ENGINE_SERVICE( _pInputManager, InputManager, getInputManager, 1 )
SW_ENGINE_SERVICE( _pAudioSystem, IAudioSystem, getAudioSystem, 1 )
SW_ENGINE_SERVICE( _pEventDispatcher, EventDispatcher, getEventDispatcher, 1 )
SW_ENGINE_SERVICE( _pResourceManager, ResourceManager, getResourceManager, 1 )
SW_ENGINE_SERVICE( _pAssetStreamingQueue, AssetStreamingQueue, getAssetStreamingQueue, 1 )
SW_ENGINE_SERVICE( _pCommandStack, CommandStack, getCommandStack, 1 )
SW_ENGINE_SERVICE( _pDebugOverlayState, DebugOverlayState, getDebugOverlayState, 1 )
SW_ENGINE_SERVICE( _pDebugDrawQueue, DebugDrawQueue, getDebugDrawQueue, 1 )
SW_ENGINE_SERVICE( _pRHIBackendRegistry, RHIBackendRegistry, getRHIBackendRegistry, 1 )
SW_ENGINE_SERVICE( _pCompressionCodecRegistry, CompressionCodecRegistry, getCompressionCodecRegistry, 1 )
SW_ENGINE_SERVICE( _pShaderCache, ShaderCache, getShaderCache, 1 )
SW_ENGINE_SERVICE( _pComponentDefaults, ComponentDefaults, getComponentDefaults, 1 )

SW_ENGINE_SERVICE_CONST( _pEngineData, EngineData, getEngineData, 1 )
SW_ENGINE_SERVICE_CONST( _pGameData, GameData, getGameData, 0 ) // 게임 모듈이 bind 시 채웁니다.

SW_ENGINE_SERVICE_OPT( _pMemoryProfiler, MemoryProfiler, getMemoryProfiler )
