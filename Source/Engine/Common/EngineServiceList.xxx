/**
 * @file Engine/Common/EngineServiceList.xxx
 * @brief 호스트가 소유하고 Engine.dll 이 조회하는 코어 서비스의 단일 등록표입니다(X-macro).
 * @details include 하기 전에 아래 매크로를 정의한 뒤 여러 번 include 합니다(#pragma once 없음).
 *          전방 선언 · EngineServices 멤버 · engine::getXxx() 선언/정의 · areEngineServicesBound() 본문 ·
 *          ModuleServiceId 열거형 · ModuleServiceTraits 가 이 목록에서 생성됩니다.
 *
 * SW_ENGINE_SERVICE( member, Tag, Type, getter, requirement, visibility, creator )
 *   Type& getter()        — 바인딩되지 않았으면 assert.
 *   requirement — `Required` 면 areEngineServicesBound() 검사에 포함, `Optional` 이면 제외.
 *   visibility  — `GameVisible` 이면 게임 모듈(SWGame)에 노출, `HostOnly` 면 호스트 · 에디터 전용(게임이 요청하면 nullptr).
 * SW_ENGINE_SERVICE_CONST( member, Tag, Type, getter, requirement, visibility, creator )
 *   const Type& getter()  — 위와 같고, const 참조를 반환.
 * SW_ENGINE_SERVICE_OPT( member, Tag, Type, getter, visibility, creator )
 *   Type* getter()        — assert 없음(널 허용). bound 검사에서 제외.
 *
 * creator — **누가 만드는가.** `EngineCreated` 면 `EngineServiceCollection`(Engine/EngineServiceCollection.h)가
 *         `make_unique<Type>()` 으로 만들고 표에 연결합니다. 호스트(EngineLoop · TestFramework)는
 *         그 저장소를 하나 들고 `createAll()` · `bindInto()` 만 부르면 됩니다. 그래서 서비스를
 *         늘릴 때 **이 줄 하나만** 고치면 두 호스트가 함께 따라옵니다.
 *         `HostCreated` 면 만드는 방법이 특별해서 호스트가 직접 만들고 직접 연결합니다. 지금은 셋뿐이고 이유가 있습니다.
 *           - IAudioSystem  : 팩토리(`IAudioSystem::create()`)가 플랫폼에 따라 구현을 고릅니다.
 *           - CommandStack  : 배포본에는 **아예 만들지 않습니다**(`#if !defined(SW_SHIPPING)`).
 *           - MemoryProfiler: Debug 에서만 만듭니다.
 *         `CheckEngineServiceBinding.py` 가 `Required, …, HostCreated` 행을 호스트가 실제로 채우는지 봅니다.
 *
 * 칸은 숫자가 아니라 낱말입니다. 값이 필요한 곳은 `RuntimeAPI/Service/ServiceListColumns.h` 의 매크로로 바꾸고,
 * 갈래를 고르는 곳은 낱말을 매크로 이름에 붙입니다(`SW_ENGINE_OWNED_STORAGE_EngineCreated`).
 *
 * 정의하지 않은 변형은 include 하는 쪽이 빈 매크로로 채워야 합니다.
 */

SW_ENGINE_SERVICE( _pCommandLineManager, class, CommandLineManager, getCommandLineManager, Required, HostOnly, EngineCreated )
SW_ENGINE_SERVICE( _pGlobalVariableManager, class, GlobalVariableManager, getGlobalVariableManager, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pLocalizationManager, class, LocalizationManager, getLocalizationManager, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pTaskManager, class, TaskManager, getTaskManager, Required, HostOnly, EngineCreated )
SW_ENGINE_SERVICE( _pTypeRegistry, class, TypeRegistry, getTypeRegistry, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pSceneManager, class, SceneManager, getSceneManager, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pInputManager, class, InputManager, getInputManager, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pAudioSystem, class, IAudioSystem, getAudioSystem, Required, GameVisible, HostCreated )
SW_ENGINE_SERVICE( _pEventDispatcher, class, EventDispatcher, getEventDispatcher, Required, GameVisible, EngineCreated )
// 비동기 파일 읽기(IOCP · io_uring · 스레드 풀). 에셋 스트리밍 큐 · 팩 리더가 쓴다. 시작 · 종료는 기동 표의 FileIo 단계다.
SW_ENGINE_SERVICE( _pAsyncFileIo, class, AsyncFileIo, getAsyncFileIo, Required, HostOnly, EngineCreated )
SW_ENGINE_SERVICE( _pAssetManager, class, AssetManager, getAssetManager, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pAssetStreamingQueue, class, AssetStreamingQueue, getAssetStreamingQueue, Required, HostOnly, EngineCreated )
// CommandStack 은 에디터 Undo/Redo 전용이라 Shipping 에서는 아예 만들지 않는다
// (EngineLoop 의 #if !defined(SW_SHIPPING) 참고). 그런데 Required 면
// areEngineServicesBound() 가 Shipping 에서 영영 false 가 되고, 그 함수로 게이팅되는 경로가
// 모두 무력화된다(셰이더 캐시를 건너뛰고 런타임 컴파일러를 직접 부르다 Shipping 에는 DXC 가 없어 죽는다).
// 이것을 쓰는 곳은 모두 Shipping 에서 빠져 있다.
SW_ENGINE_SERVICE( _pCommandStack, class, CommandStack, getCommandStack, Optional, HostOnly, HostCreated )
SW_ENGINE_SERVICE( _pDebugOverlayState, struct, DebugOverlayState, getDebugOverlayState, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pDebugDrawQueue, class, DebugDrawQueue, getDebugDrawQueue, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pRHIBackendRegistry, class, RHIBackendRegistry, getRHIBackendRegistry, Required, HostOnly, EngineCreated )
SW_ENGINE_SERVICE( _pCompressionCodecRegistry, class, CompressionCodecRegistry, getCompressionCodecRegistry, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pShaderCache, class, ShaderCache, getShaderCache, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pComponentDefaults, class, ComponentDefaults, getComponentDefaults, Required, GameVisible, EngineCreated )
SW_ENGINE_SERVICE( _pFrameProfiler, class, FrameProfiler, getFrameProfiler, Required, GameVisible, EngineCreated )


SW_ENGINE_SERVICE_CONST( _pEngineDefaultAssets, struct, EngineDefaultAssets, getEngineDefaultAssets, Required, HostOnly, EngineCreated )

SW_ENGINE_SERVICE_OPT( _pMemoryProfiler, class, MemoryProfiler, getMemoryProfiler, HostOnly, HostCreated )
// 렌더 타깃 목록. 렌더러가 공개하고 에디터 패널이 읽는다(패널은 렌더러 내부 상태 대신 이 목록만 본다).
// **OPT 다.** Required 로 두면 이것을 바인딩하지 않는 호스트(도구 · 테스트 하네스)에서
// areEngineServicesBound() 가 영영 false 가 되고, 그 함수로 게이팅되는 경로가 통째로 무력화된다.
// 위 CommandStack 주석이 그 실례다. 진단용 목록 하나 때문에 그런 일이 생겨서는 안 된다.
SW_ENGINE_SERVICE_OPT( _pRenderTargetRegistry, class, RenderTargetRegistry, getRenderTargetRegistry, HostOnly, EngineCreated )
SW_ENGINE_SERVICE_OPT( _pFrameRenderer, class, FrameRenderer, getFrameRenderer, HostOnly, HostCreated )

