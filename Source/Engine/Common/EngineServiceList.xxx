SW_ENGINE_SERVICE( _pTaskManager, class, TaskManager, getTaskManager, 1, 0 )
SW_ENGINE_SERVICE( _pTypeRegistry, class, TypeRegistry, getTypeRegistry, 1, 1 )
SW_ENGINE_SERVICE( _pSceneManager, class, SceneManager, getSceneManager, 1, 1 )
SW_ENGINE_SERVICE( _pInputManager, class, InputManager, getInputManager, 1, 1 )
SW_ENGINE_SERVICE( _pAudioSystem, class, IAudioSystem, getAudioSystem, 1, 1 )
SW_ENGINE_SERVICE( _pEventDispatcher, class, EventDispatcher, getEventDispatcher, 1, 1 )
SW_ENGINE_SERVICE( _pResourceManager, class, ResourceManager, getResourceManager, 1, 1 )
SW_ENGINE_SERVICE( _pAssetStreamingQueue, class, AssetStreamingQueue, getAssetStreamingQueue, 1, 0 )
SW_ENGINE_SERVICE( _pCommandStack, class, CommandStack, getCommandStack, 1, 0 )
SW_ENGINE_SERVICE( _pDebugOverlayState, struct, DebugOverlayState, getDebugOverlayState, 1, 1 )
SW_ENGINE_SERVICE( _pDebugDrawQueue, class, DebugDrawQueue, getDebugDrawQueue, 1, 1 )
SW_ENGINE_SERVICE( _pRHIBackendRegistry, class, RHIBackendRegistry, getRHIBackendRegistry, 1, 0 )
SW_ENGINE_SERVICE( _pCompressionCodecRegistry, class, CompressionCodecRegistry, getCompressionCodecRegistry, 1, 1 )
SW_ENGINE_SERVICE( _pShaderCache, class, ShaderCache, getShaderCache, 1, 1 )
SW_ENGINE_SERVICE( _pComponentDefaults, class, ComponentDefaults, getComponentDefaults, 1, 1 )

SW_ENGINE_SERVICE_CONST( _pEngineData, struct, EngineData, getEngineData, 1, 0 )

SW_ENGINE_SERVICE_OPT( _pMemoryProfiler, class, MemoryProfiler, getMemoryProfiler, 0 )

