/**
 * @file Engine/Common/EngineServiceList.xxx
 * @brief 엔진 범위에서 바인딩 때 한 번 찾아 두는 서비스의 단일 등록표입니다(X-macro). `engine::getSubsystem<T>()` 가 이 표의 칸을 읽습니다.
 * @details include 하기 전에 아래 매크로를 정의한 뒤 여러 번 include 합니다(#pragma once 없음).
 *          전방 선언 · 칸 색인 · 타입 → 칸 trait · 필수 행 검사 · 모듈 범위 채우기(`bindModuleServices`)가 이 목록에서 생성됩니다.
 *          모듈은 이 목록을 모른다 — 호스트가 넘긴 범위에서 타입으로 찾는다(`game::findSubsystem<T>()` · `editor::findSubsystem<T>()`).
 *
 * SW_ENGINE_SERVICE( Tag, Type, requirement, visibility )
 *   `engine::getSubsystem<Type>()` 는 `Type&`(비었으면 assert), `engine::findSubsystem<Type>()` 는 `Type*` 입니다.
 *   requirement — `Required` 면 areEngineServicesBound() 검사에 포함, `Optional` 이면 제외.
 *   visibility  — `GameVisible` 이면 게임 모듈(SWGame)의 범위에 건다, `HostOnly` 면 호스트 · 에디터 전용.
 * SW_ENGINE_SERVICE_CONST( Tag, Type, requirement, visibility )
 *   위와 같고, 두 창구 모두 const 로 돌려준다.
 * SW_ENGINE_SERVICE_OPT( Tag, Type, visibility )
 *   비어 있을 수 있는 칸입니다. `engine::findSubsystem<Type>()` 만 된다(`getSubsystem` 은 컴파일 오류). bound 검사에서 제외.
 *
 * 소유 — 줄의 객체는 **호스트의 서브시스템 컬렉션**(부트스트랩 · 서비스 · 엔진 범위)이 소유합니다. 이 목록은 무엇을 찾아 둘지만 말합니다 —
 *         `engine::bindEngineServices( 엔진 범위 )` 가 행마다 한 번 `locateSubsystem<Type>()`(타입 해시)으로 찾아 칸에 둡니다(프레임마다 찾지 않는다).
 *         `Type` 이 서브시스템이 아니면(값 묶음 · 소유한 서브시스템 안의 객체) 호스트가 그 객체를 범위에 `bind` 합니다.
 *         필수 행이 비면 엔진 루프가 서지 않습니다(호스트가 그 서브시스템을 넣지 않았다).
 *
 * 칸은 숫자가 아니라 낱말입니다. 값이 필요한 곳은 `Engine/Common/EngineServiceListColumns.h` 의 매크로로 바꿉니다.
 *
 * 정의하지 않은 변형은 include 하는 쪽이 빈 매크로로 채워야 합니다.
 */

SW_ENGINE_SERVICE( class, CommandLineManager, Required, HostOnly )
SW_ENGINE_SERVICE( class, GlobalVariableManager, Required, GameVisible )
SW_ENGINE_SERVICE( class, LocalizationManager, Required, GameVisible )
SW_ENGINE_SERVICE( class, TaskManager, Required, HostOnly )
SW_ENGINE_SERVICE( class, TypeRegistry, Required, GameVisible )
SW_ENGINE_SERVICE( class, SceneManager, Required, GameVisible )
SW_ENGINE_SERVICE( class, InputManager, Required, GameVisible )
SW_ENGINE_SERVICE( class, IAudioService, Required, GameVisible )
SW_ENGINE_SERVICE( class, EventDispatcher, Required, GameVisible )
// 비동기 파일 읽기(IOCP · io_uring · 스레드 풀). 에셋 스트리밍 큐 · 팩 리더가 쓴다. 시작 · 종료는 서브시스템 FileIO(`AsyncFileIO` 가 직접 상속)다.
SW_ENGINE_SERVICE( class, AsyncFileIO, Required, HostOnly )
SW_ENGINE_SERVICE( class, AssetManager, Required, GameVisible )
// 데이터 파일 종류(카탈로그 계약) 레지스트리. 서비스 범위가 소유하고, 모듈을 올리고 내리는 길(`engine::registerModuleTypes`)이 정적 등록자를 걷어 올리고 뺀다.
SW_ENGINE_SERVICE( class, AssetDataKindRegistry, Required, GameVisible )
SW_ENGINE_SERVICE( class, AssetStreamingQueue, Required, HostOnly )
// CommandStack 은 에디터 Undo/Redo 전용이라 Shipping 에서는 아예 만들지 않는다
// (엔진 루프의 서비스 범위 `#if !defined(SW_SHIPPING)` 참고). 그런데 Required 면
// areEngineServicesBound() 가 Shipping 에서 영영 false 가 되고, 그 함수로 게이팅되는 경로가
// 모두 무력화된다(셰이더 캐시를 건너뛰고 런타임 컴파일러를 직접 부르다 Shipping 에는 DXC 가 없어 죽는다).
// 이것을 쓰는 곳은 모두 Shipping 에서 빠져 있다.
SW_ENGINE_SERVICE( class, CommandStack, Optional, HostOnly )
// 같은 까닭으로 Optional 이다. 에디터 인스턴스를 다시 만들 때(백엔드 교체 · 에디터 모듈 리로드) 선택 · 미저장 표시를 넘기는 자리라 Shipping 에는 없다.
SW_ENGINE_SERVICE( class, EditSessionState, Optional, HostOnly )
SW_ENGINE_SERVICE( struct, DebugOverlayState, Required, GameVisible )
SW_ENGINE_SERVICE( class, DebugDrawQueue, Required, GameVisible )
// 시각 로그 — 프레임마다 기록을 넘기고(`Engine` 이 endFrame) 개발 명령 vlog.* 가 읽는다. DebugDrawQueue 와 같이 서비스 범위가 늘 넣는다.
SW_ENGINE_SERVICE( class, VisualLogger, Required, GameVisible )
SW_ENGINE_SERVICE( class, RHIBackendRegistry, Required, HostOnly )
SW_ENGINE_SERVICE( class, CompressionCodecRegistry, Required, GameVisible )
SW_ENGINE_SERVICE( class, ShaderCache, Required, GameVisible )
SW_ENGINE_SERVICE( class, ComponentDefaults, Required, GameVisible )
SW_ENGINE_SERVICE( class, FrameProfiler, Required, GameVisible )
SW_ENGINE_SERVICE( class, UserSettingsManager, Required, GameVisible )
// 글꼴 — 카탈로그 · 면 · 문화권 대체 사슬. 서브시스템 Fonts(Client 호스트)다.
SW_ENGINE_SERVICE( class, FontService, Required, GameVisible )
// 런타임 UI — 화면 스택 · 입력 → UI 사건 · 갱신. 서브시스템 UI(Client 호스트)다.
SW_ENGINE_SERVICE( class, UISystem, Required, GameVisible )
SW_ENGINE_SERVICE( class, PhysicsSystem, Required, GameVisible )
// 텔레메트리 — 동의(사용자 설정 telemetry.enabled, 기본 꺼짐)가 없으면 아무것도 모으지 않는다. 게임은 진행 사건을 `record` 한다.
// 서브시스템 Telemetry(Client 호스트)다.
SW_ENGINE_SERVICE( class, TelemetryService, Required, GameVisible )
// 크래시 보고 — 다음 실행이 지난 크래시를 묶는다. 게임 UI 는 "보낼까요?" 를 `collectReports` · `decide` 로 묻는다(동의가 ask 일 때).
SW_ENGINE_SERVICE( class, CrashReportService, Required, GameVisible )
SW_ENGINE_SERVICE( class, GameNetSession, Required, GameVisible )


// 엔진 기본 에셋 경로 표(읽기 전용). 게임 프레임워크도 엔진 데이터(포토 모드 입력 맵 등)의 경로를 여기서 읽는다.
SW_ENGINE_SERVICE_CONST( struct, EngineDefaultAssets, Required, GameVisible )
// 활성 팩의 `<Engine>` 요소(창 제목 · 렌더 파이프라인 · 스키마 · UI 규칙, 읽기 전용). 엔진과 에디터가 읽는다 — 게임은 자기 `GameSettings` 를 읽는다.
SW_ENGINE_SERVICE_CONST( struct, PackEngineSettings, Required, HostOnly )
// 호스트 설정 둘(읽기 전용) - 소유자는 서브시스템 Config(`ConfigManager`)다. 정적 활성본(`EngineConfig::getActive()` 따위)을 대신한다: 표가 둘이면 설정도 둘이고,
// 다시 읽기는 같은 자리에서 일어나 이 칸의 주소가 바뀌지 않는다. 테스트는 `ScopedEngineServiceOverride` 로 다른 값을 걸어 본다.
SW_ENGINE_SERVICE_CONST( struct, EngineConfig, Required, HostOnly )
SW_ENGINE_SERVICE_CONST( struct, GameConfig, Required, GameVisible )
// 2D 렌더 설정(정렬 레이어 · 투명 정렬 축, 읽기 전용) - 소유자는 서브시스템 Render2DSettings 다. 렌더러 · 2D 컴포넌트 검증 · 서버가 같이 읽는다
// (정적 활성본 `Render2DSettings::getActive()` 를 대신한다). 렌더러 폴더를 짓지 않는 Server 타깃에도 선다.
SW_ENGINE_SERVICE_CONST( class, Render2DSettings, Required, HostOnly )

SW_ENGINE_SERVICE_OPT( class, MemoryProfiler, HostOnly )
// 진단 도구 둘 — 에셋 로드 기록부와 상태 해시 이력. 엔진 루프와 테스트 하네스가 서비스 범위에 넣고, 엔진 범위를 세우지 않는 호스트(도구)는 없다(그때 기록은 꺼진 것과 같다).
// OPT 인 까닭은 아래 RenderTargetRegistry 와 같다 — 진단용 칸 하나 때문에 `areEngineServicesBound()` 가 꺼져서는 안 된다.
SW_ENGINE_SERVICE_OPT( class, AssetLoadProfiler, HostOnly )
SW_ENGINE_SERVICE_OPT( class, StateHashHistory, HostOnly )
// 렌더 타깃 목록. 렌더러가 공개하고 에디터 패널이 읽는다(패널은 렌더러 내부 상태 대신 이 목록만 본다).
// **OPT 다.** Required 로 두면 이것을 바인딩하지 않는 호스트(도구 · 테스트 하네스)에서
// areEngineServicesBound() 가 영영 false 가 되고, 그 함수로 게이팅되는 경로가 통째로 무력화된다.
// 위 CommandStack 주석이 그 실례다. 진단용 목록 하나 때문에 그런 일이 생겨서는 안 된다.
SW_ENGINE_SERVICE_OPT( class, RenderTargetRegistry, HostOnly )
SW_ENGINE_SERVICE_OPT( class, FrameRenderer, HostOnly )
// 모듈 렌더 패스(이름 → 패스 상수). 렌더러가 읽고 게임 · 키트 모듈이 등록한다. **OPT 다** — 렌더러 폴더를 짓지 않는 Server 타깃에는 이 타입이 없다.
// 클라이언트 엔진은 늘 서비스 범위에 넣는다(Engine.cpp).
SW_ENGINE_SERVICE_OPT( class, ModuleRenderPassRegistry, GameVisible )
// 스크린샷 요청 우편함(요청 한 칸 · 처리 결과 · `-gv_screenshotQuit` 장부). 렌더 스레드의 정적 창구(`RenderThread::requestScreenshot` …)가 찾아 쓴다.
// **OPT 다** — 렌더러 폴더를 짓지 않는 Server 타깃에는 이 타입이 없다. 클라이언트 엔진은 늘 서비스 범위에 넣는다(EngineSubsystemSet.cpp).
SW_ENGINE_SERVICE_OPT( class, ScreenshotMailbox, HostOnly )

// 주 창(소유자). 입력 · RHI · 자동화 · 에디터가 읽는다. **OPT 다** — 창이 없는 호스트(전용 서버 · 테스트 하네스)에는 서지 않는다. 정적 활성 창구(`IWindow::getActiveWindow`)를 대신한다.
SW_ENGINE_SERVICE_OPT( class, MainWindowSubsystem, HostOnly )
