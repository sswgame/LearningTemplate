/**
 * @file Engine/EngineStartupStepList.xxx
 * @brief 엔진 기동 · 종료 단계와 그 의존의 단일 등록표입니다(X-macro). `EngineStartupSequence` 가 읽습니다.
 * @details include 하기 전에 `SW_ENGINE_STARTUP_STEP( Name, { Dependency, ... } )` 를 정의합니다(#pragma once 없음).
 *
 * - **줄 순서가 초기화 순서**이고, 종료는 그 역순입니다(초기화한 단계만).
 * - `{}` 칸은 이 단계보다 **먼저 서야 하는** 단계입니다(UE `InitializeDependency`). 식별자라 오타는 컴파일 오류이고, 의존이 자기보다 아래
 *   줄에 있어도 컴파일 오류입니다(`EngineStartupSequence.cpp` 의 static_assert).
 * - 순서는 의존 칸이 정합니다 — 의존만으로 위상 정렬(동점은 이름 순)한 결과가 이 표의 줄 순서와 같아야 합니다
 *   (`EngineStartupSequenceTest.TableIsWrittenInStartupOrder`). 의존을 빼먹어 계산 순서가 바뀌면 그 시험이 진다.
 * - 단계 본문은 호스트가 줍니다(`EngineLoop::initializeStartupStep` · `shutdownStartupStep`, 시험 하네스). 로거 · 명령줄 · 서비스 생성과
 *   바인딩은 이 표 앞의 고정 부트스트랩이고, 객체 해제(`reset`)는 이 표 뒤의 끝 정리입니다.
 */

//                      단계            먼저 서야 하는 단계                                 // 왜
SW_ENGINE_STARTUP_STEP( Compression,   {} )                                                // 코덱 레지스트리 + Core 슬롯 + 외부 코덱
SW_ENGINE_STARTUP_STEP( Reflection,    {} )                                                //
SW_ENGINE_STARTUP_STEP( Config,        { Reflection } )                                    // 설정 역직렬화가 TypeInfo 를 쓴다
SW_ENGINE_STARTUP_STEP( Resource,      { Compression, Config } )                           // 팩 루트는 GameConfig, 팩 스트림은 코덱
SW_ENGINE_STARTUP_STEP( EngineData,    { Reflection, Resource } )                          //
SW_ENGINE_STARTUP_STEP( ShaderCache,   {} )                                                //
SW_ENGINE_STARTUP_STEP( Task,          {} )                                                //
SW_ENGINE_STARTUP_STEP( ModuleImages,  { Compression, Reflection, Resource, Task } )       // 모듈을 내리며 타입 · 코덱 · 캐시를 떼고 태스크를 기다린다
SW_ENGINE_STARTUP_STEP( Audio,         { ModuleImages, Task } )                            // 음성 스트리밍이 태스크를 쓰고, 모듈 콜백을 든다
SW_ENGINE_STARTUP_STEP( Input,         { ModuleImages } )                                  // 모듈이 등록한 장치 · 콜백을 든다
SW_ENGINE_STARTUP_STEP( Scene,         { Audio, Input, ModuleImages, Resource, Task } )    // 컴포넌트가 입력 · 오디오 · 모듈 코드 · 에셋을 든다
SW_ENGINE_STARTUP_STEP( Headless,      { EngineData, Scene, ShaderCache } )                // 셰이더 베이크 · 씬 쿠킹 — 하면 뒤 단계(창 · RHI · 렌더러)를 건너뛴다
SW_ENGINE_STARTUP_STEP( RHI,           { Config, Headless } )                              // 백엔드 선택 · 창 · 디바이스
SW_ENGINE_STARTUP_STEP( FrameRenderer, { RHI, Task } )                                     //
SW_ENGINE_STARTUP_STEP( RenderThread,  { FrameRenderer } )                                 //
SW_ENGINE_STARTUP_STEP( LiveShader,    { FrameRenderer, RenderThread } )                   // 재컴파일이 렌더 스레드를 세우고 렌더러에 알린다(Debug)
SW_ENGINE_STARTUP_STEP( SceneRhi,      { RHI, Scene } )                                    // 씬에 디바이스를 건다 — 종료는 이것을 떼는 것이 처음

// `ResourceManager::shutdown` 은 이 표가 아니라 끝 정리에 있다 — 다른 매니저의 소멸자가 에셋을 놓은 뒤에 캐시를 비운다.
