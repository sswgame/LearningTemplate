/**
 * @file PredefinedNameType.xxx
 * @brief 엔진이 늘 쓰는 이름을 intern 테이블 앞쪽에 고정 적재하는 목록.
 * @details include 전에 REGISTER_NAME( index, name ) 정의.
 *
 *          **번호는 줄 순서(0부터)와 같아야 한다.** 이 목록은 빈 intern 테이블에 줄 순서대로
 *          적재되므로 여기 적은 번호가 곧 그 이름의 intern 인덱스이고, basic_hashed_string 은
 *          `PredefinedNameType` 을 인덱스로 그대로 캐스팅한다(getPredefinedType 은 그 역이다).
 *          번호가 줄 순서와 어긋나면 hashed_string( NameType_float3 ) 이 조용히 다른 문자열을
 *          가리킨다 — hashed_string.h 의 static_assert 가 그것을 막는다.
 *
 *          **이름은 대소문자만 다르게 짓지 않는다.** intern 테이블의 비교·해시는 대소문자를
 *          무시하므로 `TagID` 와 `TAGID` 는 한 항목으로 합쳐지고, 그 뒤 줄의 인덱스가 전부
 *          한 칸씩 밀린다. AllocationInfo 생성자의 개수 단정이 그것을 잡는다.
 *
 *          그러므로 새 이름은 **끝에 덧붙인다**. 중간에 끼워 넣거나 순서를 바꾸면 번호가 전부
 *          바뀐다.
 */

REGISTER_NAME( 0, None )
REGISTER_NAME( 1, bool )
REGISTER_NAME( 2, int8 )
REGISTER_NAME( 3, int16 )
REGISTER_NAME( 4, int32 )
REGISTER_NAME( 5, int64 )
REGISTER_NAME( 6, uint8 )
REGISTER_NAME( 7, uint16 )
REGISTER_NAME( 8, uint32 )
REGISTER_NAME( 9, uint64 )
REGISTER_NAME( 10, float32 )
REGISTER_NAME( 11, float64 )
REGISTER_NAME( 12, utf8 )
REGISTER_NAME( 13, utf16 )
REGISTER_NAME( 14, hashed_string )
REGISTER_NAME( 15, hashed_wstring )
REGISTER_NAME( 16, string )
REGISTER_NAME( 17, wstring )
REGISTER_NAME( 18, float2 )
REGISTER_NAME( 19, float3 )
REGISTER_NAME( 20, float4 )
REGISTER_NAME( 21, float4x4 )
REGISTER_NAME( 22, quaternion )
REGISTER_NAME( 23, atomic_bool )
REGISTER_NAME( 24, TagID )
