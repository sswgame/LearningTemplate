/**
 * @file ArgumentList.xxx
 * @brief 엔진이 아는 커맨드라인 인자 목록입니다(CommandLineArgument 열거와 등록 정보가 함께 씁니다).
 * @details include 하기 전에 SW_REGISTER_ARGUMENT( Name, defaultValue, bUseDefaultValue, ... ) 를 정의하십시오.
 *          Name             : 열거자 이름. 그대로 동의어 하나로도 등록됩니다.
 *          defaultValue     : bUseDefaultValue 가 켜져 있을 때 반환할 값. 저장 타입은 bool · int32 · float32 · string
 *                             넷뿐입니다. **이 값의 타입이 곧 "값을 반드시 적어야 하는가" 입니다.** bool 은 `-key` 만 적을
 *                             수 있고(그때 true), 나머지는 `-key=value` 를 요구합니다. 예전에는 이것이 bMustHaveValue 라는
 *                             별도 칸이었고, 둘이 어긋날 수 있었습니다(아래 경고 참고).
 *          bUseDefaultValue : 인자를 **주지 않아도** getArgument 가 true 를 반환하고 defaultValue 를 채워 줄지 여부.
 *                             아래 경고를 먼저 읽으십시오.
 *          ...              : 추가 동의어. 없으면 비워 둡니다.
 *
 *          줄 순서 = CommandLineArgument 열거값 = _listArgument 인덱스이고, 이 일치 덕분에 findArgument 가 이름 조회 없이
 *          O(1) 인덱싱으로 끝납니다. initialize() 가 줄마다 이 일치를 확인합니다.
 */

// bUseDefaultValue 를 켜면 getArgument 의 반환값이 더 이상 "이 인자가 주어졌다" 는 뜻이 아니다.
// 창 크기의 기본값은 **EngineConfig 가 가진다**(`_window._width` / `_height`). 여기서 켜 두면 인자를 주지 않아도
// getArgument 가 등록된 기본값으로 true 를 반환하고, 호출하는 쪽의
//   uint32 h = config._window._height;  getArgument( HEIGHT, h );
// 패턴이 설정값을 **항상** 덮어쓴다. 실제로 1280×720 설정이 무시되고 창이 1280×1280 으로 떴다. WIDTH 의 기본값이
// 설정값과 같아서 폭만 우연히 맞았고, 그래서 아무도 알아채지 못했다.
//
// 기본값이 false 인 단독 플래그는 켤 이유가 전혀 없다. 켜 봐야 "주지 않았다" 와 "false 로 주었다" 를 구별할 수 없게
// 될 뿐이고, 호출하는 쪽은 반환값을 믿지 못해 `getArgument(...) && bFlag` 로 한 번 더 확인해야 한다(RHI.cpp 가 실제로
// 그렇게 쓴다). 주지 않았는지 알고 싶으면 isArgumentProvided 를 쓴다.
SW_REGISTER_ARGUMENT( WIDTH, 1280, false, "W" )
SW_REGISTER_ARGUMENT( HEIGHT, 1280, false, "H" )
SW_REGISTER_ARGUMENT( VSYNC, false, false, "vsync" )
SW_REGISTER_ARGUMENT( DIRECTX_11, false, false, "dx11", "d3d11" )
SW_REGISTER_ARGUMENT( DIRECTX_12, false, false, "dx12", "d3d12" )
SW_REGISTER_ARGUMENT( VULKAN, false, false, "vk", "vulkan" )
SW_REGISTER_ARGUMENT( OPENGL, false, false, "gl", "opengl" )
SW_REGISTER_ARGUMENT( ENABLE_EDITOR, false, false, "EnableEditor" )
SW_REGISTER_ARGUMENT( IP, "", false, )
SW_REGISTER_ARGUMENT( PORT, 0, false, )
SW_REGISTER_ARGUMENT( LANGUAGE, "", false, "lang", "language" )
SW_REGISTER_ARGUMENT( BAKE_SHADERS, false, false, "bake-shaders", "bakeshaders" )
SW_REGISTER_ARGUMENT( COOK_SCENES, false, false, "cook-scenes", "cookscenes" )
SW_REGISTER_ARGUMENT( COOKED_DIR, "", false, "cooked-dir", "cookeddir" )
