      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON",
        "SW_TARGET_TYPE": "Client"
      }
    },
    {
      "name": "WSL-Debug-Server",
      "displayName": "WSL Ninja Debug - Dedicated Server (Clang)",
      "description": "리눅스 전용 서버 Debug — X11 · Vulkan · GL 을 링크하지 않는다",
      "inherits": "WSL-Debug",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "WSL-Shipping-Server",
      "displayName": "WSL Ninja Shipping - Dedicated Server (Clang)",
      "description": "리눅스 전용 서버 배포본",
      "inherits": "WSL-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "CI-Debug",
      "displayName": "CI Debug (Ninja)",
      "description": "CI Debug. Windows job sets clang-cl; Linux uses the system compiler.",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_UNITY_BUILD": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "CI-Shipping",
      "displayName": "CI Shipping (Ninja, clang-cl on Windows)",
      "description": "CI Shipping. Windows job sets clang-cl like CI-Debug; Linux uses the system compiler plus distro libclang.",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON",
        "SW_ENABLE_UNITY_BUILD": "ON",
        "SW_TARGET_TYPE": "Client"
      }
    },
    {
      "name": "CI-Shipping-Server",
      "displayName": "CI Shipping - Dedicated Server",
      "description": "CI 전용 서버 배포본(Windows · Linux 잡)",
      "inherits": "CI-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "CI-Debug-ASAN",
      "displayName": "CI Debug + ASan (Ninja)",
      "description": "CI Debug with AddressSanitizer enabled",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_SANITIZER": "ON",
        "SW_ENABLE_UNITY_BUILD": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "CI-Debug-STL",
      "displayName": "CI Debug + STL containers (Ninja)",
      "description": "CI Debug with SW_ENABLE_STL_CONTAINER (std containers and std::allocator) so the option keeps compiling",
      "inherits": "CI-Debug",
      "cacheVariables": {
        "SW_ENABLE_STL_CONTAINER": "ON"
      }
    },
    {
      "name": "CI-Debug-TSAN",
      "displayName": "CI Debug + TSan (Ninja, Linux Clang)",
      "description": "CI Debug with ThreadSanitizer enabled (Linux Clang only). Ports that synchronize their own threads (Jolt, Box2D) are built with -fsanitize=thread by the x64-linux-tsan triplet (cmake/Modules/Toolchain/VcpkgTsan), installed under this preset's own build folder. CC/CXX pin the port compiler to the project's clang.",
      "inherits": "base-vcpkg",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan",
        "VCPKG_HOST_TRIPLET": "x64-linux",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/${presetName}/vcpkg_installed",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/Modules/Toolchain/VcpkgTsan;${sourceDir}/cmake/Modules/Toolchain/Vcpkg",
        "SW_VCPKG_FORCE_INSTALL": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_SANITIZER": "ON",
        "SW_SANITIZER_KIND": "thread",
        "SW_ENABLE_UNITY_BUILD": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "CI-Fuzz",
      "displayName": "CI Fuzz (Ninja, Linux Clang + ASan + libFuzzer)",
      "description": "Coverage-guided fuzzing of the loader target table (Test/FuzzTest/LoaderFuzzer). Linux clang only - the Windows clang_rt.fuzzer is /MT only. Built nightly by .github/workflows/fuzz.yml.",
      "inherits": "CI-Debug-ASAN",
      "cacheVariables": {
        "SW_ENABLE_FUZZING": "ON",
        "SW_ENABLE_UNITY_BUILD": "OFF"
      }
    }
  ],
