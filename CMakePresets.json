{
  "version": 8,

  "configurePresets": [
    {
      "name": "base-vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/Modules/Toolchain/Vcpkg",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/build/vcpkg_cache,readwrite"
      }
    },

    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base-vcpkg",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      }
    },

    {
      "name": "base-wsl",
      "hidden": true,
      "inherits": "base-vcpkg",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "remoteCopySources": true,
          "remoteCopySourcesMethod": "rsync",
          "remoteCopySourcesExclusionList": [
            ".vs",
            ".git",
            "${sourceDir}/Tools/vcpkg/buildtrees",
            "${sourceDir}/Tools/vcpkg/packages",
            "${sourceDir}/Tools/vcpkg/downloads"
          ]
        }
      }
    },

    {
      "name": "Ninja-Debug",
      "displayName": "Windows Ninja Debug (Clang-cl)",
      "description": "Windows Debug build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "Ninja-Release",
      "displayName": "Windows Ninja Release (Clang-cl)",
      "description": "Windows Release build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "Ninja-Shipping",
      "displayName": "Windows Ninja Shipping (Clang-cl)",
      "description": "Windows Shipping build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON"
      }
    },

    {
      "name": "WSL-Debug",
      "displayName": "WSL Ninja Debug (Clang)",
      "description": "WSL Ubuntu Debug build using Ninja + Clang",
      "inherits": "base-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "WSL-Release",
      "displayName": "WSL Ninja Release (Clang)",
      "description": "WSL Ubuntu Release build using Ninja + Clang",
      "inherits": "base-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },

    {
      "name": "WSL-Shipping",
      "displayName": "WSL Ninja Shipping (Clang)",
      "description": "WSL Ubuntu Shipping build using Ninja + Clang",
      "inherits": "base-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON"
      }
    },

    {
      "name": "CI-Debug",
      "displayName": "CI Debug (Ninja)",
      "description": "CI-oriented Debug build (system compiler + Tools/vcpkg toolchain)",
      "inherits": "base-vcpkg",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "Ninja-Debug",
      "configurePreset": "Ninja-Debug"
    },
    {
      "name": "Ninja-Release",
      "configurePreset": "Ninja-Release"
    },
    {
      "name": "Ninja-Shipping",
      "configurePreset": "Ninja-Shipping"
    },
    {
      "name": "WSL-Debug",
      "configurePreset": "WSL-Debug"
    },
    {
      "name": "WSL-Release",
      "configurePreset": "WSL-Release"
    },
    {
      "name": "WSL-Shipping",
      "configurePreset": "WSL-Shipping"
    },
    {
      "name": "CI-Debug",
      "configurePreset": "CI-Debug"
    }
  ]
}
