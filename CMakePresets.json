{
  "version": 8,
  "configurePresets": [
    {
      "name": "base-vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/build/vcpkg_cache,readwrite",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/Modules/Toolchain/Vcpkg",
        "SCCACHE_DIR": "${sourceDir}/build/sccache_cache"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base-vcpkg",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      }
    },
    {
      "name": "base-wsl",
      "hidden": true,
      "inherits": "base-vcpkg",
      "environment": {
        "CC": "clang",
        "CXX": "clang++"
      },
      "vendor": {
        "microsoft.com/VisualStudioRemoteSettings/CMake/1.0": {
          "remoteCopySources": true,
          "remoteCopySourcesMethod": "rsync",
          "remoteCopySourcesExclusionList": [
            ".vs",
            ".git",
            "${sourceDir}/Tools/vcpkg/buildtrees",
            "${sourceDir}/Tools/vcpkg/packages",
            "${sourceDir}/Tools/vcpkg/downloads"
          ]
        }
      }
    },
    {
      "name": "Ninja-Debug",
      "displayName": "Windows Ninja Debug (Clang-cl)",
      "description": "Windows Debug build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Ninja-Debug-AbilityArena",
      "displayName": "Windows Ninja Debug — AbilityArena",
      "description": "Ninja-Debug 와 같고 활성 게임만 AbilityArena (빌드 폴더 build/Ninja-Debug-AbilityArena, 게임 프리셋 Config/Game/AbilityArena.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "AbilityArena"
      }
    },
    {
      "name": "Ninja-Debug-HarvestValley",
      "displayName": "Windows Ninja Debug — HarvestValley",
      "description": "Ninja-Debug 와 같고 활성 게임만 HarvestValley (빌드 폴더 build/Ninja-Debug-HarvestValley, 게임 프리셋 Config/Game/HarvestValley.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "HarvestValley"
      }
    },
    {
      "name": "Ninja-Debug-NileCity",
      "displayName": "Windows Ninja Debug — NileCity",
      "description": "Ninja-Debug 와 같고 활성 게임만 NileCity (빌드 폴더 build/Ninja-Debug-NileCity, 게임 프리셋 Config/Game/NileCity.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "NileCity"
      }
    },
    {
      "name": "Ninja-Debug-Shooter3D",
      "displayName": "Windows Ninja Debug — Shooter3D",
      "description": "Ninja-Debug 와 같고 활성 게임만 Shooter3D (빌드 폴더 build/Ninja-Debug-Shooter3D, 게임 프리셋 Config/Game/Shooter3D.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "Shooter3D"
      }
    },
    {
      "name": "Ninja-Debug-StarSkirmish",
      "displayName": "Windows Ninja Debug — StarSkirmish",
      "description": "Ninja-Debug 와 같고 활성 게임만 StarSkirmish (빌드 폴더 build/Ninja-Debug-StarSkirmish, 게임 프리셋 Config/Game/StarSkirmish.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "StarSkirmish"
      }
    },
    {
      "name": "Ninja-Debug-ThemeParkTycoon",
      "displayName": "Windows Ninja Debug — ThemeParkTycoon",
      "description": "Ninja-Debug 와 같고 활성 게임만 ThemeParkTycoon (빌드 폴더 build/Ninja-Debug-ThemeParkTycoon, 게임 프리셋 Config/Game/ThemeParkTycoon.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "ThemeParkTycoon"
      }
    },
    {
      "name": "Ninja-Debug-VoxelCraft",
      "displayName": "Windows Ninja Debug — VoxelCraft",
      "description": "Ninja-Debug 와 같고 활성 게임만 VoxelCraft (빌드 폴더 build/Ninja-Debug-VoxelCraft, 게임 프리셋 Config/Game/VoxelCraft.json)",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_ACTIVE_GAME": "VoxelCraft"
      }
    },
    {
      "name": "Ninja-Debug-ASAN",
      "displayName": "Windows Ninja Debug + ASan (Clang-cl)",
      "description": "Debug build with AddressSanitizer (clang-cl /fsanitize=address)",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SW_ENABLE_SANITIZER": "ON"
      }
    },
    {
      "name": "Ninja-Release",
      "displayName": "Windows Ninja Release (Clang-cl)",
      "description": "Windows Release build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Ninja-Shipping",
      "displayName": "Windows Ninja Shipping (Clang-cl)",
      "description": "Windows Shipping build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON",
        "SW_TARGET_TYPE": "Client"
      }
    },
    {
      "name": "Ninja-Debug-Server",
      "displayName": "Windows Ninja Debug - Dedicated Server (Clang-cl)",
      "description": "전용 서버 타깃(SW_TARGET_TYPE=Server) Debug — 창 · GPU · 에디터 · RHI 백엔드 없음, Server 실행 파일만. 빌드 폴더 build/Ninja-Debug-Server",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "Ninja-Shipping-Server",
      "displayName": "Windows Ninja Shipping - Dedicated Server (Clang-cl)",
      "description": "전용 서버 배포본(SW_TARGET_TYPE=Server, 정적 링크 한 실행 파일)",
      "inherits": "Ninja-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "WSL-Debug",
      "displayName": "WSL Ninja Debug (Clang)",
      "description": "WSL Ubuntu Debug build using Ninja + Clang",
      "inherits": "base-wsl",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "WSL-Release",
      "displayName": "WSL Ninja Release (Clang)",
