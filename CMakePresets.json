{
  "version": 8,
  "configurePresets": [
    {
      "name": "base-vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/build/vcpkg_cache,readwrite"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base-vcpkg",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      }
    },
    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux-Debug",
      "displayName": "Linux Ninja Debug (Clang)",
      "description": "Linux Debug build using Ninja + Clang — 컴파일러는 DetectToolchain 이 Tools/LLVM 에서 고른다. X11 · ALSA · epoll · POSIX 구현은 이 구성만 짓는다",
      "inherits": "base-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Linux-Debug-ASan",
      "displayName": "Linux Ninja Debug + AddressSanitizer/UBSan (Clang)",
      "description": "수명 · 경계 · 미정의 동작 그물 — `py -3 Scripts/dev/LinuxScenarios.py sanitize address` 가 단위 테스트를 돌린다(감사 P-8, Godot CI 의 ASan 빌드 · 언리얼 -EnableASan 자리)",
      "inherits": "Linux-Debug",
      "cacheVariables": {
        "SW_ENABLE_SANITIZER": "ON",
        "SW_SANITIZER_KIND": "address"
      }
    },
    {
      "name": "Linux-Debug-TSan",
      "displayName": "Linux Ninja Debug + ThreadSanitizer (Clang)",
      "description": "데이터 경쟁 그물 — vcpkg 는 x64-linux-tsan 트리플릿(원자로 스스로 동기화하는 포트 계측). `py -3 Scripts/dev/LinuxScenarios.py sanitize thread`",
      "inherits": "Linux-Debug",
      "cacheVariables": {
        "SW_ENABLE_SANITIZER": "ON",
        "SW_SANITIZER_KIND": "thread",
        "VCPKG_TARGET_TRIPLET": "x64-linux-tsan"
      }
    },
    {
      "name": "Linux-Release",
      "displayName": "Linux Ninja Release (Clang)",
      "description": "Linux Release build — 모든 게임 · 키트의 전체 빌드. 텍스처 임포트가 Debug 보다 훨씬 빨라 게임 시나리오 체인은 이 구성으로 돈다",
      "inherits": "base-linux",
      "cacheVariables": {
        "SW_GAMES": "ALL",
        "SW_BUILD_UNUSED_KITS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "SW_ENABLE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "base-shipping",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON"
      }
    },
    {
      "name": "Ninja-Debug",
      "displayName": "Windows Ninja Debug (Clang-cl)",
      "description": "Windows Debug build using Ninja + Clang-cl — 활성 게임에 Shooter3D 를 함께 지어 온라인 키트(계정 · 채팅 · 경제 · 우편함과 서버 짝)가 매일 컴파일되고 UnitTests.Shooter3D 가 그 테스트를 돈다",
      "inherits": "base-windows",
      "cacheVariables": {
        "SW_GAMES": "Shooter3D",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Ninja-Release",
      "displayName": "Windows Ninja Release (Clang-cl)",
      "description": "Windows Release build using Ninja + Clang-cl — 모든 게임 · 키트가 컴파일되는지 보는 전체 빌드(일상 개발은 Ninja-Debug — 활성 게임과 그 키트만)",
      "inherits": "base-windows",
      "cacheVariables": {
        "SW_GAMES": "ALL",
        "SW_BUILD_UNUSED_KITS": "ON",
        "CMAKE_BUILD_TYPE": "Release",
        "SW_ENABLE_UNITY_BUILD": "ON"
      }
    },
    {
      "name": "Ninja-Shipping",
      "displayName": "Windows Ninja Shipping (Clang-cl)",
      "description": "Windows Shipping build using Ninja + Clang-cl",
      "inherits": [
        "base-windows",
        "base-shipping"
      ]
    },
    {
      "name": "Ninja-Debug-Server",
      "displayName": "Windows Ninja Debug - Dedicated Server (Clang-cl)",
      "description": "전용 서버 타깃(SW_TARGET_TYPE=Server) Debug — 창 · GPU · 에디터 · RHI 백엔드 없음, Server 실행 파일만. 빌드 폴더 build/Ninja-Debug-Server",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "Ninja-Shipping-Server",
      "displayName": "Windows Ninja Shipping - Dedicated Server (Clang-cl)",
      "description": "전용 서버 배포본(SW_TARGET_TYPE=Server, 정적 링크 한 실행 파일)",
      "inherits": "Ninja-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "Ninja-Shipping-Client",
      "displayName": "Windows Ninja Shipping - Client only (Clang-cl)",
      "description": "클라이언트 전용 배포본(SW_TARGET_TYPE=Client) — 이름이 Server 인 폴더(전용 서버 · 온라인 서비스 구현)를 짓지 않고 그 헤더를 게이트가 막는다(언리얼 Client 타깃). Ninja-Shipping 은 클라이언트 + 서버(Game)다",
      "inherits": "Ninja-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Client"
      }
    },
    {
      "name": "Web-Shipping",
      "displayName": "Web Shipping (Emscripten, WebGPU)",
      "description": "브라우저 배포(Emscripten + vcpkg dawn 의 emdawnwebgpu). 툴체인은 저장소의 Tools/emsdk(설치 py -3 Scripts/setup/PlatformSdk.py web — 판은 Config/Environment/search_paths.defaults.json)",
      "inherits": [
        "base-vcpkg",
        "base-shipping"
      ],
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/Tools/emsdk/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
        "VCPKG_TARGET_TRIPLET": "wasm32-emscripten-pthread",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed_${presetName}",
        "SW_SHIPPING_RHI_BACKEND": "WebGPU"
      },
      "environment": {
        "EMSDK": "${sourceDir}/Tools/emsdk",
        "EMSCRIPTEN_ROOT": "${sourceDir}/Tools/emsdk/upstream/emscripten",
        "EM_CONFIG": "${sourceDir}/Tools/emsdk/.emscripten"
      }
    },
    {
      "name": "Android-Shipping",
      "displayName": "Android Shipping (NDK, Vulkan, arm64)",
      "description": "Android 배포(API 29, arm64-v8a). NDK 는 저장소의 Tools/Android/ndk/<판>(설치 py -3 Scripts/setup/PlatformSdk.py android — 판은 Config/Environment/search_paths.defaults.json 의 android_ndk_version, 이 경로와 같은지 설치 스크립트가 본다) — APK 는 빌드 뒤 py -3 -m Scripts android-apk --game <게임>(서명한 디버그 APK, build/Android-Shipping/Apk)",
      "inherits": [
        "base-vcpkg",
        "base-shipping"
      ],
      "environment": {
        "ANDROID_NDK_HOME": "${sourceDir}/Tools/Android/ndk/29.0.14206865"
      },
      "cacheVariables": {
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/Tools/Android/ndk/29.0.14206865/build/cmake/android.toolchain.cmake",
        "VCPKG_TARGET_TRIPLET": "arm64-android",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed_${presetName}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-29",
        "SW_SHIPPING_RHI_BACKEND": "Vulkan"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Ninja-Debug",
      "configurePreset": "Ninja-Debug"
    },
    {
      "name": "Ninja-Release",
      "configurePreset": "Ninja-Release"
    },
    {
      "name": "Ninja-Shipping",
      "configurePreset": "Ninja-Shipping"
    },
    {
      "name": "Ninja-Debug-Server",
      "configurePreset": "Ninja-Debug-Server"
    },
    {
      "name": "Ninja-Shipping-Server",
      "configurePreset": "Ninja-Shipping-Server"
    },
    {
      "name": "Ninja-Shipping-Client",
      "configurePreset": "Ninja-Shipping-Client"
    },
    {
      "name": "Linux-Debug",
      "configurePreset": "Linux-Debug"
    },
    {
      "name": "Linux-Release",
      "configurePreset": "Linux-Release"
    },
    {
      "name": "Linux-Debug-ASan",
      "configurePreset": "Linux-Debug-ASan"
    },
    {
      "name": "Linux-Debug-TSan",
      "configurePreset": "Linux-Debug-TSan"
    }
  ],
  "testPresets": [
    {
      "name": "parallel",
      "hidden": true,
      "environment": {
        "CTEST_PARALLEL_LEVEL": ""
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Ninja-Debug-lint",
      "inherits": "parallel",
      "configurePreset": "Ninja-Debug",
      "filter": {
        "include": {
          "label": "lint"
        }
      }
    },
    {
      "name": "Linux-Debug-nogpu",
      "displayName": "Linux Debug - GPU 없는 테스트(단위 · 도구)",
      "inherits": "parallel",
      "configurePreset": "Linux-Debug",
      "filter": {
        "include": {
          "label": "nogpu"
        }
      }
    }
  ]
}
