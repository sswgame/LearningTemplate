{
  "version": 8,
  "configurePresets": [
    {
      "name": "base-vcpkg",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/install/${presetName}",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/build/vcpkg_installed",
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake"
      },
      "environment": {
        "VCPKG_BINARY_SOURCES": "clear;files,${sourceDir}/build/vcpkg_cache,readwrite",
        "VCPKG_OVERLAY_TRIPLETS": "${sourceDir}/cmake/Modules/Toolchain/Vcpkg"
      }
    },
    {
      "name": "base-windows",
      "hidden": true,
      "inherits": "base-vcpkg",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "environment": {
        "CC": "clang-cl",
        "CXX": "clang-cl"
      }
    },
    {
      "name": "base-linux",
      "hidden": true,
      "inherits": "base-vcpkg",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "Linux-Debug",
      "displayName": "Linux Ninja Debug (Clang)",
      "description": "Linux Debug build using Ninja + Clang — 컴파일러는 DetectToolchain 이 Tools/LLVM 에서 고른다. X11 · ALSA · epoll · POSIX 구현은 이 구성만 짓는다",
      "inherits": "base-linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "base-shipping",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SW_SHIPPING_BUILD": "ON"
      }
    },
    {
      "name": "Ninja-Debug",
      "displayName": "Windows Ninja Debug (Clang-cl)",
      "description": "Windows Debug build using Ninja + Clang-cl",
      "inherits": "base-windows",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Ninja-Release",
      "displayName": "Windows Ninja Release (Clang-cl)",
      "description": "Windows Release build using Ninja + Clang-cl — 모든 게임 · 키트가 컴파일되는지 보는 전체 빌드(일상 개발은 Ninja-Debug — 활성 게임과 그 키트만)",
      "inherits": "base-windows",
      "cacheVariables": {
        "SW_GAMES": "ALL",
        "SW_BUILD_UNUSED_KITS": "ON",
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Ninja-Shipping",
      "displayName": "Windows Ninja Shipping (Clang-cl)",
      "description": "Windows Shipping build using Ninja + Clang-cl",
      "inherits": [
        "base-windows",
        "base-shipping"
      ]
    },
    {
      "name": "Ninja-Shipping-NoAutomation",
      "displayName": "Windows Ninja Shipping - No Automation (Clang-cl)",
      "description": "자동화 런타임을 뺀 배포본(SW_ENABLE_AUTOMATION=OFF) — -scenario 가 기동 오류로 멈추는지 보는 구성(Scripts/dev/ShippingCheck.py)",
      "inherits": "Ninja-Shipping",
      "cacheVariables": {
        "SW_ENABLE_AUTOMATION": "OFF"
      }
    },
    {
      "name": "Ninja-Debug-Server",
      "displayName": "Windows Ninja Debug - Dedicated Server (Clang-cl)",
      "description": "전용 서버 타깃(SW_TARGET_TYPE=Server) Debug — 창 · GPU · 에디터 · RHI 백엔드 없음, Server 실행 파일만. 빌드 폴더 build/Ninja-Debug-Server",
      "inherits": "Ninja-Debug",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    },
    {
      "name": "Ninja-Shipping-Server",
      "displayName": "Windows Ninja Shipping - Dedicated Server (Clang-cl)",
      "description": "전용 서버 배포본(SW_TARGET_TYPE=Server, 정적 링크 한 실행 파일)",
      "inherits": "Ninja-Shipping",
      "cacheVariables": {
        "SW_TARGET_TYPE": "Server"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "Ninja-Debug",
      "configurePreset": "Ninja-Debug"
    },
    {
      "name": "Ninja-Release",
      "configurePreset": "Ninja-Release"
    },
    {
      "name": "Ninja-Shipping",
      "configurePreset": "Ninja-Shipping"
    },
    {
      "name": "Ninja-Shipping-NoAutomation",
      "configurePreset": "Ninja-Shipping-NoAutomation"
    },
    {
      "name": "Ninja-Debug-Server",
      "configurePreset": "Ninja-Debug-Server"
    },
    {
      "name": "Ninja-Shipping-Server",
      "configurePreset": "Ninja-Shipping-Server"
    },
    {
      "name": "Linux-Debug",
      "configurePreset": "Linux-Debug"
    }
  ],
  "testPresets": [
    {
      "name": "parallel",
      "hidden": true,
      "environment": {
        "CTEST_PARALLEL_LEVEL": ""
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "Ninja-Debug-lint",
      "inherits": "parallel",
      "configurePreset": "Ninja-Debug",
      "filter": {
        "include": {
          "label": "lint"
        }
      }
    },
    {
      "name": "Linux-Debug-nogpu",
      "displayName": "Linux Debug - GPU 없는 테스트(단위 · 도구)",
      "inherits": "parallel",
      "configurePreset": "Linux-Debug",
      "filter": {
        "include": {
          "label": "nogpu"
        }
      }
    }
  ]
}
