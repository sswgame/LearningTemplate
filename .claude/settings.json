{
  "permissions": {
    "allow": [
      "Bash(py -3 -m Scripts ci-jobs *)",
      "Bash(py -3 -m Scripts plans *)",
      "Bash(py -3 -m Scripts worktree-list)",
      "Bash(git merge-base *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/SessionGuard.py\"",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "if command -v py >/dev/null 2>&1; then py -3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/GuardCommands.py\"; else python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/GuardCommands.py\"; fi",
            "timeout": 10
          }
        ]
      }
    ]
  }
}