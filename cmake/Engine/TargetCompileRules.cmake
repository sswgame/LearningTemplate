# ==============================================================================
# @file cmake/Engine/TargetCompileRules.cmake
# @brief 타깃 하나의 컴파일 규칙 — 내보내기 매크로 짝 · PCH(진입 헤더 include 경로 · 소스 폴더 include 경로 금지) · 결정성 TU(부동소수점 축약 끄기)
# ==============================================================================

# ------------------------------------------------------------------------------
# 내보내기 매크로 — 종류(KIND)마다 짝이 정해져 있다. STATIC(배포)에는 아무것도 붙이지 않는다.
#   ENGINE : SHARED 면 SW_EXPORTS(PRIVATE) · SW_IMPORTS(INTERFACE)        — Engine.dll
#   GF     : SHARED 면 SW_GF_EXPORTS(PRIVATE) · SW_GF_IMPORTS(INTERFACE)  — GameFramework.dll (키트는 SW_KIT_EXPORTS · SW_KIT_SERVER_EXPORTS · SW_KIT_IMPORTS, `sw_addModuleLibrary`)
#   MODULE : MODULE 이면 SW_MODULE_EXPORTS(PRIVATE)                       — C-ABI 진입점을 내보내는 플러그인(RHI · 게임 · 에디터)
#   DEVTOOLS : SHARED 면 SW_DEVTOOLS_EXPORTS(PRIVATE) · SW_DEVTOOLS_IMPORTS(INTERFACE) — DevTools.dll(개발 빌드만)
# ------------------------------------------------------------------------------
function(sw_configureDLLExports TARGET_NAME LIB_TYPE KIND)
	if(NOT KIND MATCHES "^(ENGINE|GF|DEVTOOLS|MODULE|MODULE_SHARED|EDITOR)$")
		message(FATAL_ERROR "sw_configureDLLExports(${TARGET_NAME}): KIND 는 ENGINE | GF | DEVTOOLS | MODULE | MODULE_SHARED | EDITOR 이다 (받은 값: ${KIND})")
	endif()

	if(KIND STREQUAL "ENGINE" AND LIB_TYPE STREQUAL "SHARED")
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_EXPORTS INTERFACE SW_IMPORTS)
	elseif(KIND STREQUAL "GF" AND LIB_TYPE STREQUAL "SHARED")
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_GF_EXPORTS INTERFACE SW_GF_IMPORTS)
	elseif(KIND STREQUAL "DEVTOOLS" AND LIB_TYPE STREQUAL "SHARED")
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_DEVTOOLS_EXPORTS INTERFACE SW_DEVTOOLS_IMPORTS)
	elseif(KIND STREQUAL "MODULE" AND LIB_TYPE STREQUAL "MODULE")
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_MODULE_EXPORTS)
	elseif(KIND STREQUAL "MODULE_SHARED" AND LIB_TYPE STREQUAL "SHARED")
		# 다른 모듈을 링크하는 SHARED 모듈(에디터 확장) — 자기 C-ABI 진입점만 내보낸다.
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_MODULE_EXPORTS)
	elseif(KIND STREQUAL "EDITOR" AND LIB_TYPE STREQUAL "SHARED")
		# EditorModule: 호스트가 부르는 C-ABI 진입점(SW_MODULE_API)과, 확장 모듈이 링크하는 에디터 API(SW_EDITOR_API)를 함께 내보낸다.
		target_compile_definitions(${TARGET_NAME} PRIVATE SW_MODULE_EXPORTS SW_EDITOR_EXPORTS INTERFACE SW_EDITOR_IMPORTS)
	endif()
endfunction()

# SW_ENABLE_PCH 가 켜져 있을 때만 PCH 를 건다.
function(sw_configurePCH targetName headerPath)
	if(SW_ENABLE_PCH)
		target_precompile_headers(${targetName} PRIVATE "${headerPath}")
	endif()
endfunction()

# ------------------------------------------------------------------------------
# sw_addPCHEntryDirectory — `.cpp` 첫 줄 `#include "pch.h"` 를 푸는 include 경로를 타깃에 준다.
#   그 폴더에는 PCH 진입 헤더(ENTRY, `Source/` 기준 — `Engine/pch.h` · `Core/pch.h`)로 넘기는 생성 헤더 하나뿐이다. 소스 폴더(`Source/Engine`)를
#   include 경로로 내보내면 `#include "Scene/SceneManager.h"` 같은 접두 없는 include 가 풀려 층 게이트(`Engine/` 접두로 본다)를 비껴간다.
#   그래서 폴더가 아니라 이 헤더 하나만 내보낸다(`sw_verifySourceIncludeRoots` 가 소스 폴더 include 경로를 막는다). NAME 은 생성 폴더 이름이다.
# ------------------------------------------------------------------------------
function(sw_addPCHEntryDirectory TARGET_NAME VISIBILITY NAME ENTRY)
	if(NOT EXISTS "${CMAKE_SOURCE_DIR}/Source/${ENTRY}")
		message(FATAL_ERROR "sw_addPCHEntryDirectory(${TARGET_NAME}): no PCH entry header Source/${ENTRY}")
	endif()
	set(entryDir "${CMAKE_BINARY_DIR}/generated/sw/pchentry/${NAME}")
	get_property(previousEntry GLOBAL PROPERTY SW_PCH_ENTRY_${NAME})
	if(NOT previousEntry)
		file(GENERATE OUTPUT "${entryDir}/pch.h" CONTENT "// generated by sw_addPCHEntryDirectory (cmake/Engine/TargetCompileRules.cmake)\n#pragma once\n#include \"${ENTRY}\"\n")
		set_property(GLOBAL PROPERTY SW_PCH_ENTRY_${NAME} "${ENTRY}")
	elseif(NOT previousEntry STREQUAL ENTRY)
		message(FATAL_ERROR "sw_addPCHEntryDirectory(${TARGET_NAME}): '${NAME}' already forwards to ${previousEntry}, not ${ENTRY}")
	endif()
	target_include_directories(${TARGET_NAME} ${VISIBILITY} "${entryDir}")
endfunction()

# ------------------------------------------------------------------------------
# sw_verifySourceIncludeRoots — `Source/` 아래 폴더를 include 경로로 가진 타깃이 있으면 구성을 세운다.
#   include 는 `Source/` 기준 전체 경로(`Engine/Scene/SceneManager.h`)로만 풀려야 층 게이트가 경로 앞부분으로 층을 안다. `Source/Engine` · 모듈 폴더를
#   include 경로로 주면 접두 없는 include 가 다른 층으로 풀린다. 경로를 주는 줄은 CMake 어디에나 쓸 수 있어 형식으로 막지 못하므로 구성 끝에 여기서 본다.
#   남는 틈(그 파일의 폴더 기준 경로 — 컴파일러가 늘 먼저 본다)은 리뷰가 본다. 루트 CMakeLists 가 모든 타깃을 만든 뒤 부른다.
# ------------------------------------------------------------------------------
function(sw_verifySourceIncludeRoots)
	set(sourcePrefix "${CMAKE_SOURCE_DIR}/Source/")
	string(LENGTH "${sourcePrefix}" sourcePrefixLength)
	set(listDirectory "${CMAKE_SOURCE_DIR}")
	set(listViolation "")
	while(listDirectory)
		list(POP_FRONT listDirectory directory)
		get_property(listSubdirectory DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
		list(APPEND listDirectory ${listSubdirectory})
		get_property(listTarget DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
		foreach(target IN LISTS listTarget)
			foreach(property IN ITEMS INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
				get_target_property(listInclude ${target} ${property})
				foreach(includeDir IN LISTS listInclude)
					string(SUBSTRING "${includeDir}" 0 ${sourcePrefixLength} includePrefix)
					if(includePrefix STREQUAL sourcePrefix)
						list(APPEND listViolation "${target} (${property}): ${includeDir}")
					endif()
				endforeach()
			endforeach()
		endforeach()
	endwhile()
	if(listViolation)
		list(JOIN listViolation "\n  " violationText)
		message(FATAL_ERROR "A target puts a folder under Source/ on its include path — write includes as full Source/-rooted paths "
			"(the PCH entry goes through sw_addPCHEntryDirectory):\n  ${violationText}")
	endif()
endfunction()

# ------------------------------------------------------------------------------
# sw_addSharedPCHOwner — 같은 정의를 가진 타깃들이 PCH 하나를 나눠 쓰게 하는 중립 소유자(쓰는 쪽은 `sw_useSharedPCH`).
#   clang 은 PCH 와 명령줄의 `-D` 가 하나라도 다르면 거부한다(`definition of macro 'SW_LOG_TAG' differs`). 소유자는 타깃 고유 정의가 없고
#   `LINK` 만 받아 공통 정의(`SW_IMPORTS` 등)를 물려받는다 — 특정 킷이 소유하면 그 킷의 정의가 PCH 에 구워져 나머지로 샌다.
# ------------------------------------------------------------------------------
function(sw_addSharedPCHOwner OWNER_NAME HEADER_PATH)
	cmake_parse_arguments(ARG "" "" "LINK;DEFINITIONS" ${ARGN})
	if(NOT SW_ENABLE_PCH OR TARGET ${OWNER_NAME})
		return()
	endif()
	set(ownerSource "${CMAKE_BINARY_DIR}/generated/sw/pch/${OWNER_NAME}.cpp")
	file(GENERATE OUTPUT "${ownerSource}" CONTENT "// ${OWNER_NAME}: shared PCH owner (no code)\n")
	add_library(${OWNER_NAME} OBJECT "${ownerSource}")
	target_link_libraries(${OWNER_NAME} PRIVATE ${ARG_LINK})
	if(ARG_DEFINITIONS)
		target_compile_definitions(${OWNER_NAME} PRIVATE ${ARG_DEFINITIONS}) # 쓰는 타깃 모두가 같은 정의를 가질 때만(게임 팩의 `SW_LOG_TAG` · `SW_MODULE_EXPORTS`)
	endif()
	set_target_properties(${OWNER_NAME} PROPERTIES FOLDER "Build/PCH" EXCLUDE_FROM_ALL ON)
	target_precompile_headers(${OWNER_NAME} PRIVATE "${HEADER_PATH}")
endfunction()

# ------------------------------------------------------------------------------
# sw_useSharedPCH — 타깃이 `sw_addSharedPCHOwner` 의 PCH 를 쓴다(clang-cl 만 — 그 밖은 PCH 없이 짓는다).
#   CMake 의 `REUSE_PRECOMPILE_HEADERS_FROM` 을 쓰지 않는 까닭 둘:
#   - 속성만 세우면(`set_target_properties`) CMake 4.4 는 조용히 무시한다 — `target_precompile_headers( REUSE_FROM )` 이어야 붙는다.
#   - CMake 는 PCH 플래그(`/Yu` · `/FI<cmake_pch.hxx>`)를 명령줄 맨 끝에 둔다. clang-cl 은 PCH 헤더보다 **앞에** 강제 포함한 파일을 건너뛰므로
#     타깃 고유 정의 헤더(`sw_setTargetDefsHeader`)가 사라진다. 그래서 PCH 플래그를 타깃 옵션 맨 앞(`BEFORE`)에 직접 넣어 정의 헤더 ·
#     의존 타깃의 `FlagOps.gen.h` 가 PCH **뒤에** 읽히게 한다.
#   PCH 안 헤더는 `/showIncludes` 에 나오지 않으므로 소유자의 PCH 오브젝트를 모든 C++ 소스의 `OBJECT_DEPENDS` 로 건다 —
#   소스가 다 붙은 뒤(리플렉션 단계 뒤) 부른다. `SKIP_PRECOMPILE_HEADERS` 소스는 `/Y-` 로 PCH 를 끈다.
# ------------------------------------------------------------------------------
function(sw_useSharedPCH TARGET_NAME OWNER_NAME)
	if(NOT SW_ENABLE_PCH OR NOT MSVC OR NOT TARGET ${OWNER_NAME})
		return()
	endif()
	get_target_property(ownerBinaryDir ${OWNER_NAME} BINARY_DIR)
	set(pchDir "${ownerBinaryDir}/CMakeFiles/${OWNER_NAME}.dir")
	set(pchHeader "${pchDir}/cmake_pch.hxx")
	target_compile_options(${TARGET_NAME} BEFORE PRIVATE "/Yu${pchHeader}" "/Fp${pchDir}/cmake_pch.cxx.pch" "/FI${pchHeader}")
	add_dependencies(${TARGET_NAME} ${OWNER_NAME})
	get_target_property(listSource ${TARGET_NAME} SOURCES)
	foreach(src IN LISTS listSource)
		if(NOT src MATCHES "\\.(cpp|cxx|cc)$")
			continue()
		endif()
		get_source_file_property(bSkipPCH "${src}" TARGET_DIRECTORY ${TARGET_NAME} SKIP_PRECOMPILE_HEADERS)
		if(bSkipPCH)
			set_property(SOURCE "${src}" TARGET_DIRECTORY ${TARGET_NAME} APPEND PROPERTY COMPILE_OPTIONS "/Y-")
		else()
			set_property(SOURCE "${src}" TARGET_DIRECTORY ${TARGET_NAME} APPEND PROPERTY OBJECT_DEPENDS "${pchDir}/cmake_pch.cxx.obj")
		endif()
	endforeach()
endfunction()

# ------------------------------------------------------------------------------
# sw_setTargetDefsHeader — 타깃 고유 정의(`SW_LOG_TAG` · `SW_KIT_EXPORTS`)를 `-D` 대신 PCH 뒤에 강제 포함하는 헤더로 준다.
#   PCH 를 나눠 쓰려면 명령줄 정의가 같아야 하므로 타깃마다 다른 값은 여기로 옮긴다. `Logger.h` 가 PCH 안에서 기본 `SW_LOG_TAG` 를 정의해
#   두므로 `#undef` 로 덮는다. 인자: LOG_TAG, KIT_EXPORTS(켜면 `SW_KIT_EXPORTS` 정의), KIT_SERVER_EXPORTS(서버 키트 — `SW_KIT_SERVER_EXPORTS` 정의).
#   PCH 안의 헤더가 읽는 정의는 여기 둘 수 없다(PCH 를 만들 때 이미 정해졌다) — `SW_KIT_EXPORTS` 를 읽는 키트 헤더(`SW_KIT_API`)도 PCH 밖이다.
# ------------------------------------------------------------------------------
function(sw_setTargetDefsHeader TARGET_NAME)
	cmake_parse_arguments(ARG "KIT_EXPORTS;KIT_SERVER_EXPORTS" "LOG_TAG" "" ${ARGN})
	set(content "// ${TARGET_NAME}: per-target definitions (generated)\n#pragma once\n#undef SW_LOG_TAG\n#define SW_LOG_TAG \"${ARG_LOG_TAG}\"\n")
	if(ARG_KIT_EXPORTS)
		string(APPEND content "#define SW_KIT_EXPORTS\n")
	endif()
	if(ARG_KIT_SERVER_EXPORTS)
		string(APPEND content "#define SW_KIT_SERVER_EXPORTS\n")
	endif()
	set(header "${CMAKE_BINARY_DIR}/generated/sw/targetdefs/${TARGET_NAME}.h")
	file(GENERATE OUTPUT "${header}" CONTENT "${content}")
	if(MSVC)
		target_compile_options(${TARGET_NAME} PRIVATE "/FI${header}")
	else()
		target_compile_options(${TARGET_NAME} PRIVATE -include "${header}")
	endif()
endfunction()

# ------------------------------------------------------------------------------
# sw_markDeterministicSources —같은 입력이면 구성 · 컴파일러 · 플랫폼을 넘어 같은 비트를 내야 하는 시뮬레이션 TU(파괴 · 파쇄 · 그 복제)에
#   부동소수점 축약(FMA 합치기)을 끈다. Release 의 /arch:AVX2 · -mavx2 는 `a * b + c` 를 FMA 한 번으로 합쳐 반올림이 Debug(/Od · AVX2 없음)와
#   달라진다 — 씨앗과 사건만 보내고 받는 쪽이 같은 계산을 하는 파괴 네트워킹은 Debug 서버 ↔ Shipping 클라이언트에서 다른 그림이 된다.
#   엔진 전체에는 걸지 않는다(렌더 · 애니메이션 수학은 FMA 가 이득이고 비트 결정성이 필요 없다). 언리얼도 결정성이 필요한 물리 경로만 /fp:precise 로 짓는다.
#   clang-cl 의 기본 /fp:precise 는 축약을 허락하므로(-ffp-contract=on) 축약만 따로 끈다.
#   유니티 묶음에서 뺀다 — 묶음 파일은 묶음의 옵션 하나로 컴파일되므로 파일별 옵션이 묶음 전체에 퍼지거나 빠진다.
#   PCH 는 그대로 쓴다(축약 옵션은 PCH 호환 검사 대상이 아니다).
#   표시한 TU 는 libm 삼각함수(`MathUtil::sin` 등) 대신 `DeterministicMathUtil` 을 쓴다 — CRT 판 · 벡터화 판이 끝 비트를 바꾼다.
#   표시한 타깃은 전역 속성 `SW_DETERMINISTIC_TARGETS` 에 남는다(`sw_requireDeterministicMarkForRollback` 이 대조한다).
# ------------------------------------------------------------------------------
function(sw_markDeterministicSources TARGET_NAME)
	if(NOT TARGET ${TARGET_NAME})
		message(FATAL_ERROR "sw_markDeterministicSources: no target ${TARGET_NAME}")
	endif()
	if(MSVC)
		set(contractOff "/clang:-ffp-contract=off")
	else()
		set(contractOff "-ffp-contract=off")
	endif()
	foreach(src IN LISTS ARGN)
		if(NOT IS_ABSOLUTE "${src}")
			set(src "${CMAKE_CURRENT_SOURCE_DIR}/${src}")
		endif()
		# 없는 경로를 조용히 넘기면 파일을 옮겼을 때 결정성이 소리 없이 꺼진다.
		if(NOT EXISTS "${src}")
			message(FATAL_ERROR "sw_markDeterministicSources(${TARGET_NAME}): no such file -> ${src}")
		endif()
		set_source_files_properties("${src}" TARGET_DIRECTORY ${TARGET_NAME} PROPERTIES
			COMPILE_OPTIONS "${contractOff}"
			SKIP_UNITY_BUILD_INCLUSION ON)
	endforeach()
	set_property(GLOBAL APPEND PROPERTY SW_DETERMINISTIC_TARGETS ${TARGET_NAME})
endfunction()

# ------------------------------------------------------------------------------
# sw_requireDeterministicMarkForRollback — 롤백 게임 계약(`IRollbackGame::saveState( vector<uint8>& )` 과 같은 서명)을 구현하는 모듈은
#   결정성 표시(`sw_markDeterministicSources`)가 필수다. `sw_addModuleLibrary` 가 모든 모듈 타깃에 부른다.
#   게이트인 이유: 부동소수점 축약은 컴파일 옵션이라 C++ 형식이 알 수 없고, 표시를 빠뜨려도 빌드는 서고 Debug ↔ Release 의 롤백 해시만 갈린다.
#   모듈 헤더에서 그 서명을 찾으면(순수 가상 `= 0` 인 계약 선언 자체는 뺀다) 그 디렉터리의 CMakeLists 가 끝날 때 표시가 걸렸는지 본다 —
#   표시는 모듈을 만든 뒤 같은 CMakeLists 에서 부르므로 지금 보면 늘 없다.
# ------------------------------------------------------------------------------
function(sw_requireDeterministicMarkForRollback TARGET_NAME)
	set(listRollbackHeader "")
	foreach(src IN LISTS ARGN)
		if(NOT src MATCHES "\\.h$" OR src MATCHES "^\\$<")
			continue()
		endif()
		if(NOT IS_ABSOLUTE "${src}")
			set(src "${CMAKE_CURRENT_SOURCE_DIR}/${src}")
		endif()
		file(STRINGS "${src}" listSaveStateLine REGEX "void[ \t]+saveState[ \t]*\\([ \t]*vector<uint8>[ \t]*&")
		list(FILTER listSaveStateLine EXCLUDE REGEX "=[ \t]*0[ \t]*;")
		if(listSaveStateLine)
			list(APPEND listRollbackHeader "${src}")
		endif()
	endforeach()
	if(listRollbackHeader)
		# DEFER 의 인자는 실행할 때 풀리므로 지금 값을 글로 박아 넘긴다.
		cmake_language(EVAL CODE "cmake_language(DEFER CALL sw_verifyDeterministicMark [[${TARGET_NAME}]] [[${listRollbackHeader}]])")
	endif()
endfunction()

function(sw_verifyDeterministicMark TARGET_NAME ROLLBACK_HEADERS)
	get_property(listMarked GLOBAL PROPERTY SW_DETERMINISTIC_TARGETS)
	if(NOT TARGET_NAME IN_LIST listMarked)
		message(FATAL_ERROR "${TARGET_NAME} implements the rollback contract (saveState( vector<uint8>& ) in ${ROLLBACK_HEADERS}) "
			"but marks no deterministic sources - call sw_markDeterministicSources(${TARGET_NAME} <simulation .cpp files>) in its CMakeLists")
	endif()
endfunction()
