#pragma once

#include "Core/Foundation/Types.h"

namespace sw::config
{
    // -------------------------------------------------------------------------
    // 1) 디렉터리 경로
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kDirConfig       = "@SW_DIR_CONFIG@";        ///< 호스트 설정 폴더(프로젝트 루트 기준)
    inline constexpr const utf8* kDirConfigEditor = "@SW_DIR_CONFIG_EDITOR@"; ///< 사람이 쓰는 에디터 설정 폴더
    inline constexpr const utf8* kDirSavedEditor  = "@SW_DIR_SAVED_EDITOR@";  ///< 에디터가 쓰는 상태 폴더(git 무시)
    inline constexpr const utf8* kDirConfigEnv    = "@SW_DIR_CONFIG_ENV@";

    // -------------------------------------------------------------------------
    // 2) 설정 및 리플렉션 도구 파일 경로
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kFileAnnotationMeta     = "@SW_FILE_ANNOTATION_META@";
    inline constexpr const utf8* kFileEnvToolchainConfig = "@SW_DIR_CONFIG_ENV@/@SW_FILE_TOOLCHAIN_CONFIG@";
    inline constexpr const utf8* kFileParserConfig       = "@SW_DIR_CONFIG_ENV@/@SW_FILE_PARSER_CONFIG@";
    inline constexpr const utf8* kFileParserDefaults     = "@SW_DIR_CONFIG_ENV@/@SW_FILE_PARSER_DEFAULTS@";
    inline constexpr const utf8* kFileReflectBuiltins    = "@SW_FILE_REFLECT_BUILTINS@";

    // -------------------------------------------------------------------------
    // 3) 런타임 게임/엔진/에디터 설정 파일 경로
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kFileRuntimeEditorToolDefaults   = "@SW_FILE_RUNTIME_EDITOR_TOOL_DEFAULTS@";
    inline constexpr const utf8* kFileRuntimeEngineConfig = "@SW_FILE_RUNTIME_ENGINE_CONFIG@";
    /** @brief 게임 프리셋 폴더입니다 — 게임마다 `<게임>.json`(`GameSelection::getConfigPath`). */
    inline constexpr const utf8* kDirRuntimeGamePreset = "@SW_DIR_RUNTIME_GAME_PRESET@";
    /** @brief 전용 서버 운영 설정(`ServerConfig`) 폴더입니다 — 게임마다 `<게임>.json`(`GameSelection::getServerConfigPath`). 파일이 없을 수 있다(서버가 없는 게임). */
    inline constexpr const utf8* kDirRuntimeServerPreset = "@SW_DIR_RUNTIME_SERVER_PRESET@";
    /** @brief Shipping 이 구운 게임 이름입니다. Dev 는 비어 있다 — 실행할 때 고른다(`GameSelection`). 그래서 Dev 에서 활성 게임을 바꿔도 이 헤더가 바뀌지 않는다. */
    inline constexpr const utf8* kShippingGameName = "@SW_SHIPPING_GAME_NAME@";
    /** @brief 빌드의 활성 게임 이름을 담는 파일(Dev, `Bin/Modules/<이 이름>`)입니다. */
    inline constexpr const utf8* kFileActiveGame = "@SW_FILE_ACTIVE_GAME@";
    /** @brief 모듈 빌드 성공 스탬프(Dev, `Bin/Modules/<이 이름>`)입니다. 빌드가 동적 모듈을 모두 링크한 뒤에만 다시 쓴다(`sw_addModuleBuildStamp`, `LiveReloadManager`). */
    inline constexpr const utf8* kFileModuleBuildStamp = "@SW_FILE_MODULE_BUILD_STAMP@";
    /** @brief 함께 지은 게임 팩 폴더(Dev, `Bin/<이 이름>/<게임>/`)입니다. */
    inline constexpr const utf8* kDirBinGames = "@SW_DIR_BIN_GAMES@";

    // -------------------------------------------------------------------------
    // 4) toolchain_config.json 키
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kKeyLlvmPath          = "@SW_KEY_LLVM_PATH@";
    inline constexpr const utf8* kKeyMsvcToolsDir      = "@SW_KEY_MSVC_TOOLS_DIR@";
    inline constexpr const utf8* kKeyWindowsSdkDir     = "@SW_KEY_WINDOWS_SDK_DIR@";
    inline constexpr const utf8* kKeyWindowsSdkVersion = "@SW_KEY_WINDOWS_SDK_VERSION@";

    // -------------------------------------------------------------------------
    // 5) 리플렉션 템플릿 파일
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kFileTplBuiltinFooter    = "@SW_FILE_TPL_BUILTIN_FOOTER@";
    inline constexpr const utf8* kFileTplBuiltinHeader    = "@SW_FILE_TPL_BUILTIN_HEADER@";
    inline constexpr const utf8* kFileTplBuiltinRegistrar = "@SW_FILE_TPL_BUILTIN_REGISTRAR@";

    // -------------------------------------------------------------------------
    // 6) 동적 모듈 타겟 이름
    // -------------------------------------------------------------------------
    inline constexpr const utf8* kTargetEditorModule = "@SW_TARGET_EDITOR_MODULE@";
    inline constexpr const utf8* kTargetGameModule   = "@SW_TARGET_GAME_MODULE@";
