{
    "_listenAddress": "127.0.0.1",
    "_gamePort": 17790,
    "_servicePort": 17793,
    "_bGameConnectTicket": true,
    "_bOnlineServices": true,
    "_listStore": [
        {
            "_name": "main",
            "_driver": "postgres",
            "_connection": "host=127.0.0.1 port=5432 dbname=playground user=playground",
            "_secretEnvironment": "SW_PLAYGROUND_DB_PASSWORD"
        }
    ],
    "_listCache": [
        {
            "_name": "main",
            "_driver": "resp",
            "_endpoint": "127.0.0.1:6379?prefix=playground:",
            "_secretEnvironment": "SW_PLAYGROUND_CACHE_PASSWORD"
        }
    ],
    "_ops": {
        "_maxConnections": 64,
        "_idleTimeoutSeconds": 10,
        "_processSampleIntervalMs": 1000,
        "_minFrameDumpIntervalMs": 10000,
        "_loadWarningIntervalMs": 60000,
        "_crashTailTicks": 40,
        "_livenessTimeoutMs": 10000
    },
    "_admin": {
        "_idleTimeoutSeconds": 300
    }
}
