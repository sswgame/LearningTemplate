{
    "$schema_note": [
        "쿠킹이 C++ 과 Python 에서 같이 쓰는 표 둘의 단일 출처(SSOT)다.",
        "C++ 은 configure 때 Scripts/generate/GenerateCookContract.py 가 만든 sw/config/CookContract.gen.h 의 X-macro 로 읽고",
        "(ArgumentList.xxx · RHIBackendUtil · ShaderCooker · AssetCookPath), Python 쿠커(Scripts/generate/CookAssets.py)는",
        "Scripts/common/CookContract.py 로 이 파일을 직접 읽는다. 쿠커가 이 표를 따르는지는 lint/gate/CheckCookContract.py 가 본다.",
        "",
        "rhi_backends: 줄 순서 = RHIBackend 열거값(Config/RHIBackendType.h, static_assert 로 맞춘다).",
        "  name = RHIBackend 열거자, shader_folder = Resource/**/shaders/bin/<폴더>, shader_target = ShaderTargetFormat 열거자,",
        "  command_line_argument = CommandLineArgument 열거자, aliases = 명령줄 · 셰이더 폴더 · 쿠커 --target-rhi 가 받는 이름(소문자).",
        "cook_suffixes: 긴 접미사가 먼저다(.scene.xml 이 .scene 보다 먼저 맞아야 한다). kind = AssetKind 열거자,",
        "  is_authoring_source = 쿠커가 쿠킹하는 저작 소스인가(아니면 쿠킹본 · 확장자 없는 이름을 정본으로 돌리는 줄)."
    ],

    "default_rhi_backend": "DirectX12",

    "rhi_backends": [
        { "name": "DirectX11", "shader_folder": "dx11", "shader_target": "DXBC_D3D11", "command_line_argument": "DIRECTX_11", "aliases": [ "dx11", "d3d11", "directx11" ] },
        { "name": "DirectX12", "shader_folder": "dx12", "shader_target": "DXIL_D3D12", "command_line_argument": "DIRECTX_12", "aliases": [ "dx12", "d3d12", "directx12" ] },
        { "name": "Vulkan", "shader_folder": "vulkan", "shader_target": "SPIRV_Vulkan", "command_line_argument": "VULKAN", "aliases": [ "vk", "vulkan", "spirv" ] },
        { "name": "OpenGL", "shader_folder": "opengl", "shader_target": "SPIRV_OpenGL", "command_line_argument": "OPENGL", "aliases": [ "gl", "opengl" ] }
    ],

    "cook_suffixes": [
        { "source": ".scene.xml", "cooked": ".scene.bin", "kind": "Scene", "is_authoring_source": true },
        { "source": ".prefab.xml", "cooked": ".prefab.bin", "kind": "Prefab", "is_authoring_source": true },
        { "source": ".prefab.json", "cooked": ".prefab.bin", "kind": "Prefab", "is_authoring_source": true },
        { "source": ".scene.bin", "cooked": ".scene.bin", "kind": "Scene", "is_authoring_source": false },
        { "source": ".prefab.bin", "cooked": ".prefab.bin", "kind": "Prefab", "is_authoring_source": false },
        { "source": ".scene", "cooked": ".scene.bin", "kind": "Scene", "is_authoring_source": false },
        { "source": ".prefab", "cooked": ".prefab.bin", "kind": "Prefab", "is_authoring_source": false }
    ]
}
