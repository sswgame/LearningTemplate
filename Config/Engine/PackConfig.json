{
  "_compression": {
    "_codec": "Zlib",
    "_level": 0
  },
  "_layout": {
    "_mode": "Sorted",
    "_maxHolePercent": 25
  },
  "_bExcludeRawShaderSource": true,
  "_listGlobalExcludeDirectory": [
    "textures_raw",
    "shaders_raw",
    "models_raw",
    "heightfields_raw",
    "rigs_raw",
    "docs",
    ".git",
    ".vs"
  ],
  "_listGlobalExcludePattern": [
    "*.psd",
    "*.blend",
    "*.blend1",
    "*.sources.json",
    "*.matgraph.xml",
    "*.bak",
    "*.tmp",
    "thumbs.db",
    ".ds_store",
    "desktop.ini",
    "*.swp"
  ],
  "_listRule": [
    {
      "_name": "Exclude_Raw_Source_Assets",
      "_listExcludeDirectory": [
        "textures_raw",
        "shaders_raw",
        "models_raw",
        "heightfields_raw",
        "rigs_raw"
      ],
      "_listExcludePattern": [],
      "_bRecursive": true
    },
    {
      "_name": "Exclude_Documentation",
      "_listExcludeDirectory": [
        "docs"
      ],
      "_listExcludePattern": [],
      "_bRecursive": true
    }
  ],
  "_cookRules": {
    "_listAlwaysCook": [
      { "_name": "EngineLocalizationTables_NamedRelativeToTheProject", "_listPattern": [ "engine/localization/*" ] },
      { "_name": "GameCodeLiterals_EngineAssets", "_listPattern": [ "engine/textures/test/checker.dds" ] },
      { "_name": "GameData_FoundByKindPathRule", "_listPattern": [ "game/*/data/**" ] },
      { "_name": "GameMaps_OpenedByName", "_listPattern": [ "game/*/maps/**" ] },
      { "_name": "GameScenarios_RunByName", "_listPattern": [ "game/*/automation/**" ] },
      { "_name": "InputUIPipelineDialogue_ReadByName", "_listPattern": [ "game/*/input/**", "game/*/ui/**", "game/*/pipeline/**", "game/*/dialogue/**", "common/input/**", "common/ui/**" ] },
      { "_name": "CommonSql_ReadByLiteralPath", "_listPattern": [ "common/sql/**" ] },
      { "_name": "UnitModels_JoinedFromName", "_listPattern": [ "game/nilecity/models/**", "game/starskirmish/models/**" ] }
    ],
    "_gameSettingsPath": "data/gamesettings.xml",
    "_listRequiredData": [
      { "_kind": "items", "_path": "data/items.xml" },
      { "_kind": "appearance", "_path": "data/appearance" }
    ],
    "_listUnfollowedField": [ "assetRoots" ]
  }
}
