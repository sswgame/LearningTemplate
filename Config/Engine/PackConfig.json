{
  "_compression": {
    "_codec": "Zlib",
    "_level": 0
  },
  "_layout": {
    "_mode": "Sorted",
    "_maxHolePercent": 25
  },
  "_bExcludeRawShaderSource": true,
  "_listGlobalExcludeDirectory": [
    "textures_raw",
    "shaders_raw",
    "models_raw",
    "heightfields_raw",
    "rigs_raw",
    "docs",
    ".git",
    ".vs"
  ],
  "_listGlobalExcludePattern": [
    "*.psd",
    "*.blend",
    "*.blend1",
    "*.meta",
    "*.sources.json",
    "*.bak",
    "*.tmp",
    "thumbs.db",
    ".ds_store",
    "desktop.ini",
    "*.swp"
  ],
  "_listRule": [
    {
      "_name": "Exclude_Raw_Source_Assets",
      "_listExcludeDirectory": [
        "textures_raw",
        "shaders_raw",
        "models_raw",
        "heightfields_raw",
        "rigs_raw"
      ],
      "_listExcludePattern": [],
      "_bRecursive": true
    },
    {
      "_name": "Exclude_Documentation",
      "_listExcludeDirectory": [
        "docs"
      ],
      "_listExcludePattern": [],
      "_bRecursive": true
    }
  ]
}
