{
  "rules": [
    {
      "name": "file-names",
      "check": "naming",
      "description": "Lowercase letters, digits, underscore, dot and dash only; no spaces.",
      "severity": "error",
      "include_patterns": ["*"],
      "exclude_patterns": ["README.md"],
      "exclude_reason": "README.md — folder description documents (the name GitHub shows for a folder)",
      "name_pattern": "[a-z0-9_.\\-]+"
    },
    {
      "name": "prefab-folder",
      "check": "naming",
      "severity": "error",
      "include_patterns": ["game/*/prefabs/**"],
      "allowed_suffixes": [".prefab.xml", ".prefab.xml.meta"]
    },
    {
      "name": "map-folder",
      "check": "naming",
      "severity": "error",
      "include_patterns": ["game/*/maps/**"],
      "allowed_suffixes": [".scene.xml", ".tilemap.xml"]
    },
    {
      "name": "material-folder",
      "check": "naming",
      "severity": "error",
      "include_patterns": ["**/materials/**"],
      "allowed_suffixes": [".material", ".material.meta"]
    },
    {
      "name": "model-folder",
      "check": "naming",
      "severity": "error",
      "include_patterns": ["**/models/**"],
      "allowed_suffixes": [".mesh", ".sockets.xml", ".refpose.xml", ".skeleton.xml", ".animclip", ".fracture", ".facial.xml", ".livelinkface.xml", ".avatar.xml", ".bonelod.xml", ".vertexanimation.xml", ".modifiers.json", ".mfpc", ".material", ".material.meta", ".rig.xml", ".prefab.xml", ".prefab.xml.meta"]
    },
    {
      "name": "model-source-folder",
      "check": "naming",
      "severity": "error",
      "include_patterns": ["**/models_raw/**"],
      "allowed_suffixes": [".glb", ".gltf", ".vrm", ".bin", ".clips.json", "import.stamp"]
    },
    {
      "name": "texture-limits",
      "check": "texture",
      "description": "Every runtime texture: at most 4096, a known GPU format, and a power of two when it has mips (a mip chain halves each side; UI images and pixel-art atlases have none). Every format the texture importer can write is either allowed or rejected here (EditorTexturePipelineTest.EveryImportOutputFormatIsDecidedByTheAssetRules); a format outside allowed_formats (BC2 from an old tool, for one) fails here without being listed.",
      "severity": "error",
      "include_patterns": ["**/textures/**/*.dds"],
      "max_size": 4096,
      "mipped_power_of_two": true,
      "allowed_formats": ["BC1_UNORM", "BC1_UNORM_SRGB", "BC3_UNORM", "BC3_UNORM_SRGB", "BC4_UNORM", "BC5_UNORM", "BC6H_UF16",
                          "BC7_UNORM", "BC7_UNORM_SRGB", "R8G8B8A8_UNORM", "R8G8B8A8_UNORM_SRGB", "B8G8R8A8_UNORM",
                          "B8G8R8A8_UNORM_SRGB", "R16G16B16A16_FLOAT", "R8_UNORM"]
    },
    {
      "name": "texture-palette-no-mips",
      "check": "texture",
      "description": "Palette (colormap) and voxel atlas textures are sampled by exact texel; mips blur neighbouring swatches.",
      "severity": "error",
      "include_patterns": ["*colormap*.dds", "game/voxelcraft/textures/blocks.dds"],
      "require_mips": false
    },
    {
      "name": "texture-pixel-art",
      "check": "texture",
      "description": "Pixel-art atlases are sampled by exact texel: no mips (they blur neighbouring cells) and no block compression (it bleeds colours across 4x4 blocks and needs sides in multiples of 4).",
      "severity": "error",
      "include_patterns": ["**/textures/pixel/**/*.dds"],
      "require_mips": false,
      "allowed_formats": ["R8G8B8A8_UNORM_SRGB"]
    },
    {
      "name": "texture-ui-no-mips",
      "check": "texture",
      "severity": "warning",
      "include_patterns": ["**/textures/ui/**/*.dds"],
      "require_mips": false
    },
    {
      "name": "texture-world-mips",
      "check": "texture",
      "description": "Tiled world textures need the full mip chain (shimmering at distance otherwise).",
      "severity": "warning",
      "include_patterns": ["engine/textures/random/**/*.dds", "engine/textures/perlin.dds"],
      "require_mips": true
    },
    {
      "name": "mesh-budget",
      "check": "mesh_budget",
      "severity": "error",
      "include_patterns": ["*.mesh"],
      "max_triangles": 100000,
      "max_bounding_radius": 500
    },
    {
      "name": "mesh-budget-prop",
      "check": "mesh_budget",
      "description": "Packs that place many copies of one prop (city, park, skirmish units) keep props light.",
      "severity": "warning",
      "include_patterns": ["game/nilecity/models/**/*.mesh", "game/themepark/models/**/*.mesh", "game/starskirmish/models/**/*.mesh",
                           "game/harvestvalley/models/**/*.mesh"],
      "max_triangles": 20000
    },
    {
      "name": "xml-parses",
      "check": "xml_wellformed",
      "severity": "error",
      "include_patterns": ["*.xml", "*.material"]
    },
    {
      "name": "references-exist",
      "check": "missing_reference",
      "description": "transient_folders: the temp resource folder an editor run fills and removes (asset.import, Character Editor data preset export)",
      "severity": "error",
      "transient_folders": ["scratch/import"],
      "include_patterns": ["*.xml", "*.material", "*.json"]
    },
    {
      "name": "orphans",
      "check": "orphan",
      "description": "Assets nobody names.",
      "severity": "warning",
      "include_patterns": ["*.prefab.xml", "*.material", "*.mesh", "**/textures/**/*.dds", "*.ogg", "*.scene.xml"],
      "exclude_patterns": ["game/nilecity/models/**/*.mesh", "game/starskirmish/models/**/*.mesh", "game/harvestvalley/models/**/crop*.mesh",
                           "game/empty/models/avatarsample_d.mesh", "common/prefabs/gimmicks/**", "common/sounds/**", "common/music/**"],
      "exclude_reason": "meshes a game picks by name from a code table (path built at runtime), the merged mesh of a sectioned VRM import, the gimmick prefab library, and the shared CC0 audio library (common/audio.sources.json)"
    },
    {
      "name": "materials",
      "check": "material",
      "severity": "error",
      "include_patterns": ["*.material"],
      "allowed_blend_modes": ["Opaque", "Transparent"],
      "require_permutations": true
    },
    {
      "name": "material-dead-switches",
      "check": "material_keywords",
      "description": "A static switch whose keyword no shader reads compiles the same bytecode twice.",
      "severity": "warning",
      "include_patterns": ["*.material"]
    },
    {
      "name": "component-types",
      "check": "component_type",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"]
    },
    {
      "name": "scene-entity-ids",
      "check": "entity_id",
      "severity": "error",
      "include_patterns": ["*.scene.xml"]
    },
    {
      "name": "prefab-guids",
      "check": "prefab_guid",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml", "*.meta"],
      "stale_path_only": false
    },
    {
      "name": "prefab-stale-paths",
      "check": "prefab_guid",
      "description": "The guid wins at load time; a stale path still opens but misleads readers.",
      "severity": "info",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "stale_path_only": true
    },
    {
      "name": "physics-layer-names",
      "check": "component_reference",
      "description": "An unknown physics layer falls back to layer 0 at run time (ScenePhysics::resolveLayer).",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["RigidBodyComponent", "RigidBody2DComponent", "CharacterControllerComponent", "CharacterController2DComponent",
                          "TerrainColliderComponent", "FractureComponentBase", "DismembermentComponent", "ClothComponent"],
      "attributes": ["_layer", "_staticLayer", "_chunkLayer", "_debrisLayer", "_pieceLayer"],
      "target_patterns": ["engine/physics/physicssettings.xml"],
      "target_elements": ["PhysicsLayerDef"],
      "id_attribute": "_name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "physics-material-names",
      "check": "component_reference",
      "description": "An unknown physics material falls back to the first material at run time.",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["RigidBodyComponent", "RigidBody2DComponent", "TerrainColliderComponent", "DismembermentComponent"],
      "attributes": ["_material", "_pieceMaterial"],
      "target_patterns": ["engine/physics/physicssettings.xml"],
      "target_elements": ["PhysicsMaterialDef"],
      "id_attribute": "_name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "sorting-layer-names",
      "check": "component_reference",
      "description": "An unknown sorting layer draws in 'Default' at run time (SpriteRenderUtil::resolveSortKey).",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["SpriteComponent", "TileMapRendererComponent", "PixelPerfectCameraComponent"],
      "attributes": ["_sortingLayer", "_barSortingLayer"],
      "target_patterns": ["engine/data/render2d.xml", "{pack}/data/render2d.xml"],
      "target_elements": ["Layer"],
      "id_attribute": "name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "nav-area-names",
      "check": "component_reference",
      "description": "An unknown navigation area bakes as plain ground (NavGeometryCollector, NavMeshLinkComponent).",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["NavMeshLinkComponent", "NavMeshModifierComponent"],
      "attributes": ["_areaName"],
      "target_patterns": ["engine/navigation/navmeshsettings.xml"],
      "target_elements": ["NavAreaDef"],
      "id_attribute": "_name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "input-action-names",
      "check": "component_reference",
      "description": "A query for an action the InputMap does not have returns false forever - the control silently does nothing.",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["PawnComponent", "PlayerControllerComponent", "CameraDirectorComponent", "CameraManagerComponent"],
      "attributes": ["_moveAction", "_lookAction", "_upAction", "_mouseLockAction", "_cycleAction", "_panAction", "_rotateAction", "_lookHoldAction",
                     "_zoomAction"],
      "target_patterns": ["engine/input/*.input.xml", "{pack}/**/*.input.xml"],
      "target_elements": ["action"],
      "id_attribute": "name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "input-layer-names",
      "check": "component_reference",
      "description": "A pawn pushes its input layer by name on possession; an unknown layer leaves the actions of that layer off.",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["PawnComponent"],
      "attributes": ["_inputLayer"],
      "target_patterns": ["engine/input/*.input.xml", "{pack}/**/*.input.xml"],
      "target_elements": ["layer"],
      "id_attribute": "name",
      "ignore_values": ["", "None"]
    },
    {
      "name": "interaction-ids",
      "check": "component_reference",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["InteractableComponent"],
      "attributes": ["_interactionID"],
      "target_patterns": ["common/data/interactions/*.xml", "{pack}/data/interactions/*.xml"],
      "target_elements": ["Interaction"],
      "id_attribute": "id",
      "ignore_values": ["", "None"]
    },
    {
      "name": "smart-object-ids",
      "check": "component_reference",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["SmartObjectComponent"],
      "attributes": ["_smartObjectID"],
      "target_patterns": ["common/data/interactions/*.xml", "{pack}/data/interactions/*.xml"],
      "target_elements": ["SmartObject"],
      "id_attribute": "id",
      "ignore_values": ["", "None"]
    },
    {
      "name": "appearance-preset-ids",
      "check": "component_reference",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["CharacterAppearanceComponent"],
      "attributes": ["_presetID"],
      "target_patterns": ["{pack}/data/appearance/*.xml"],
      "target_elements": ["CharacterAppearance"],
      "id_attribute": "id",
      "ignore_values": ["", "None"]
    },
    {
      "name": "camera-preset-ids",
      "check": "component_reference",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["CameraDirectorComponent"],
      "attributes": ["_initialPreset"],
      "catalog_attribute": "_catalogPath",
      "target_patterns": ["engine/cameras/*.cameras.xml"],
      "target_elements": ["Preset"],
      "id_attribute": "id",
      "ignore_values": ["", "None"]
    },
    {
      "name": "ability-set-ids",
      "check": "component_reference",
      "severity": "error",
      "include_patterns": ["*.scene.xml", "*.prefab.xml"],
      "component_types": ["AbilitySystemComponent"],
      "attributes": ["_abilitySetID"],
      "target_patterns": ["{pack}/data/abilities.xml"],
      "target_elements": ["AbilitySet"],
      "id_attribute": "id",
      "ignore_values": ["", "None"]
    },
    {
      "name": "starskirmish-unit-tree",
      "check": "catalog_reference",
      "description": "Per-pack rule: producedBy / requires name another unit.",
      "severity": "error",
      "include_patterns": ["game/starskirmish/data/units.xml"],
      "elements": ["Unit"],
      "target_elements": ["Unit"],
      "reference_attributes": ["producedBy", "requires"],
      "id_attribute": "id"
    },
    {
      "name": "nilecity-goods",
      "check": "catalog_reference",
      "description": "Per-pack rule: a building's goods are declared Good ids.",
      "severity": "error",
      "include_patterns": ["game/nilecity/data/city.xml"],
      "elements": ["Building", "HouseLevel"],
      "target_elements": ["Good"],
      "reference_attributes": ["goods"],
      "id_attribute": "id"
    }
  ]
}
