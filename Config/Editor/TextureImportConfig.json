{
  "presets": {
    "Base_Default": {
      "format": "BC7",
      "generateMips": true,
      "sRGB": true,
      "invertGreen": false,
      "swizzle": "RGBA"
    },
    "Base_NormalMap": {
      "format": "BC5",
      "generateMips": true,
      "sRGB": false,
      "invertGreen": false,
      "swizzle": "RGBA"
    },
    "Base_UI": {
      "format": "B8G8R8A8",
      "generateMips": false,
      "sRGB": true,
      "invertGreen": false,
      "swizzle": "BGRA"
    },
    "Base_HDR": {
      "format": "BC6H",
      "generateMips": true,
      "sRGB": false,
      "invertGreen": false,
      "swizzle": "RGBA"
    },
    "Base_Uncompressed": {
      "format": "R8G8B8A8",
      "generateMips": true,
      "sRGB": true,
      "invertGreen": false,
      "swizzle": "RGBA"
    }
  },
  "rules": [
    {
      "name": "Pixel_Art",
      "inherits": "Base_Uncompressed",
      "filter": { "includePatterns": ["**/textures_raw/pixel/**"] },
      "generateMips": false
    },
    {
      "name": "Editor_Splash",
      "inherits": "Base_UI",
      "filter": { "includePatterns": ["*splash*"] },
      "format": "B8G8R8A8",
      "generateMips": false,
      "swizzle": "BGRA"
    },
    {
      "name": "Color_Grading_Luts",
      "inherits": "Base_Uncompressed",
      "filter": { "includePatterns": ["**/textures_raw/postprocess/lut_*"] },
      "generateMips": false,
      "sRGB": false
    },
    {
      "name": "Normal_Maps",
      "inherits": "Base_NormalMap",
      "filter": { "includePatterns": ["*_n.*", "*_normal.*", "*_norm.*", "*_nor_gl_*"], "excludePaths": ["ui/", "gui/", "icons/"] }
    },
    {
      "name": "ORM_Maps",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["*_orm.*", "*_arm_*"] },
      "format": "BC1",
      "sRGB": false
    },
    {
      "name": "Roughness_Maps",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["*_rough.*", "*_roughness.*"], "excludePaths": ["quaternius/"] },
      "sRGB": false
    },
    {
      "name": "Quaternius_Roughness",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["**/textures_raw/quaternius/**/*_roughness.*"] },
      "sRGB": false,
      "quickCompress": true
    },
    {
      "name": "Quaternius_Color",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["**/textures_raw/quaternius/**"], "excludePatterns": ["*_normal.*", "*_orm.*", "*_roughness.*"] },
      "quickCompress": true
    },
    {
      "name": "UI_Textures",
      "inherits": "Base_UI",
      "filter": { "includePaths": ["ui/", "gui/", "icons/"] }
    },
    {
      "name": "Palette_Textures",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["*colormap*", "*/voxelcraft/textures_raw/blocks.*"] },
      "generateMips": false
    },
    {
      "name": "Character_Atlases",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["*/shooter3d/textures_raw/kaykit_dungeon.*"] },
      "format": "BC1"
    },
    {
      "name": "Terrain_Detail",
      "inherits": "Base_Uncompressed",
      "filter": { "includePatterns": ["**/textures_raw/terrain/*_detail.*"] },
      "sRGB": false
    },
    {
      "name": "HDR_Cubemaps",
      "inherits": "Base_HDR",
      "filter": { "includePatterns": ["*.hdr", "*_sky.*", "*_env.*"] }
    },
    {
      "name": "Vrm_Character_Textures",
      "inherits": "Base_Default",
      "filter": { "includePatterns": ["**/textures_raw/avatarsample_d/**"] },
      "format": "BC3"
    },
    {
      "name": "Fallback_Default",
      "inherits": "Base_Default"
    }
  ]
}
