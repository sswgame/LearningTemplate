{
  "presets": {
    "Base_Default": {
      "format": "BC7_UNORM",
      "generate_mips": true,
      "srgb": true,
      "invert_green": false,
      "swizzle": "RGBA"
    },
    "Base_NormalMap": {
      "format": "BC5_UNORM",
      "generate_mips": true,
      "srgb": false,
      "invert_green": true,
      "swizzle": "RGBA"
    },
    "Base_UI": {
      "format": "B8G8R8A8_UNORM",
      "generate_mips": false,
      "srgb": true,
      "invert_green": false,
      "swizzle": "BGRA"
    },
    "Base_HDR": {
      "format": "BC6H_UF16",
      "generate_mips": true,
      "srgb": false,
      "invert_green": false,
      "swizzle": "RGBA"
    },
    "Base_Uncompressed": {
      "format": "R8G8B8A8_UNORM",
      "generate_mips": true,
      "srgb": true,
      "invert_green": false,
      "swizzle": "RGBA"
    },
    "Base_Mask": {
      "format": "R8_UNORM",
      "generate_mips": true,
      "srgb": false,
      "invert_green": false,
      "swizzle": "RGBA"
    }
  },
  "rules": [
    {
      "name": "Pixel_Art",
      "inherits": "Base_Uncompressed",
      "include_patterns": ["*/textures_raw/pixel/*"],
      "generate_mips": false
    },
    {
      "name": "Editor_Splash",
      "inherits": "Base_UI",
      "include_patterns": ["*splash*"],
      "format": "B8G8R8A8_UNORM",
      "generate_mips": false,
      "swizzle": "BGRA"
    },
    {
      "name": "Normal_Maps",
      "inherits": "Base_NormalMap",
      "include_patterns": ["*_n.*", "*_normal.*", "*_norm.*"]
    },
    {
      "name": "Roughness_Maps",
      "inherits": "Base_Default",
      "include_patterns": ["*_rough.*"],
      "srgb": false
    },
    {
      "name": "UI_Textures",
      "inherits": "Base_UI",
      "include_paths": ["ui/", "gui/", "icons/"]
    },
    {
      "name": "Palette_Textures",
      "inherits": "Base_Default",
      "include_patterns": ["*colormap*", "*/voxelcraft/textures_raw/blocks.*"],
      "generate_mips": false
    },
    {
      "name": "Character_Atlases",
      "inherits": "Base_Default",
      "include_patterns": ["*/shooter3d/textures_raw/kaykit_*"],
      "format": "BC1_UNORM"
    },
    {
      "name": "Terrain_Detail",
      "inherits": "Base_Uncompressed",
      "include_patterns": ["*/textures_raw/terrain/*_detail.*"],
      "srgb": false
    },
    {
      "name": "HDR_Cubemaps",
      "inherits": "Base_HDR",
      "include_patterns": ["*.hdr", "*_sky.*", "*_env.*"]
    },
    {
      "name": "Vrm_Character_Textures",
      "inherits": "Base_Default",
      "include_patterns": ["*/textures_raw/avatarsample_d/*"],
      "format": "BC3_UNORM"
    },
    {
      "name": "Mask_Textures",
      "inherits": "Base_Mask",
      "include_patterns": ["*_mask.*"]
    },
    {
      "name": "Fallback_Default",
      "inherits": "Base_Default"
    }
  ]
}
