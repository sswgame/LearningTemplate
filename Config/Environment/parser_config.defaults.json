{
    "parser_args": {
        "default": [
            "-D__REFLECT_PARSER__",
            "-DSW_TOOL_INTERNAL",
            "-DSW_API=",
            "-x",
            "c++",
            "-Wno-everything",
            "-Werror=ignored-attributes"
        ],
        "platform": {
            "windows": [
                "-DSW_GF_IMPORTS",
                "-DSW_KIT_IMPORTS"
            ],
            "linux": [],
            "android": [],
            "web": []
        },
        "extra": [
            "-fno-spell-checking"
        ],
        "force_include": [
            "Core/CoreMinimal.h"
        ]
    },
    "paths": {
        "llvm_clang_rel": "lib/clang",
        "clang_include_rel": "include",
        "msvc_include_rel": "include",
        "winsdk_include_rel": "Include",
        "winsdk_ucrt_rel": "ucrt"
    },
    "clang_flags": {
        "include_prefix": "-I",
        "isystem": "-isystem",
        "resource_dir": "-resource-dir",
        "force_include": "-include",
        "fms_compatibility": "-fms-compatibility",
        "fms_extensions": "-fms-extensions",
        "fms_compat_version_prefix": "-fms-compatibility-version"
    },
    "parsing": {
        "component_base_types": [
            "Component",
            "sw::Component",
            "SceneComponent",
            "sw::SceneComponent"
        ],
        "type_strip_prefixes": [
            "const ",
            "volatile ",
            "class ",
            "struct ",
            "enum "
        ],
        "name_field_skip_folders": [
            "Tests"
        ],
        "state_declaration_skip_paths": [
            "/Tests/"
        ]
    },
    "tuning": {
        "max_parallel_parses": 8
    },
    "target_options": {
        "/GR-": [
            "-fno-rtti"
        ],
        "-fno-rtti": [
            "-fno-rtti"
        ],
        "/EHsc": [
            "-fcxx-exceptions",
            "-fexceptions"
        ],
        "/utf-8": [
            "-finput-charset=UTF-8"
        ],
        "-finput-charset=UTF-8": [
            "-finput-charset=UTF-8"
        ],
        "-clang:-fno-delayed-template-parsing": [
            "-fno-delayed-template-parsing"
        ],
        "-fno-delayed-template-parsing": [
            "-fno-delayed-template-parsing"
        ]
    },
    "target_option_pass_prefixes": [
        "-m",
        "-fsanitize=",
        "-pthread",
        "-fexceptions",
        "-fcxx-exceptions",
        "-fno-exceptions",
        "-fno-rtti",
        "-frtti",
        "-std=",
        "-fchar8_t",
        "-fno-char8_t"
    ],
    "target_option_ignored_prefixes": [
        "-W",
        "/W",
        "/w",
        "/external:",
        "/MP",
        "/bigobj",
        "/Gw",
        "/Gy",
        "/Zc:inline",
        "/Zi",
        "/Z7",
        "/ZI",
        "/O",
        "-O",
        "/Fp",
        "/FI",
        "-g",
        "-clang:-fmerge-all-constants",
        "-clang:-fno-spell-checking",
        "-clang:-ftime-trace",
        "-ftime-trace",
        "-Xclang",
        "-fno-pch-timestamp",
        "SHELL:",
        "-fexec-charset=",
        "/execution-charset:",
        "/source-charset:",
        "-ffp-contract=",
        "-fdata-sections",
        "-ffunction-sections",
        "-fvisibility",
        "-fno-omit-frame-pointer",
        "-fomit-frame-pointer",
        "-gz",
        "-fuse-ld=",
        "-fcolor-diagnostics",
        "-fdiagnostics-",
        "-fmerge-all-constants",
        "-fno-spell-checking",
        "-s"
    ]
}
