{
    "parser_args": {
        "default": [
            "-std=c++17",
            "-D__REFLECT_PARSER__",
            "-DSW_TOOL_INTERNAL",
            "-DSW_API=",
            "-x",
            "c++",
            "-Wno-everything",
            "-Werror=ignored-attributes"
        ],
        "platform": {
            "windows": [
                "-fms-compatibility",
                "-fms-compatibility-version=19",
                "-fms-extensions",
                "-DSW_GF_IMPORTS",
                "-DSW_KIT_IMPORTS"
            ],
            "linux": [],
            "android": [],
            "web": []
        },
        "extra": [
            "-fno-spell-checking"
        ],
        "force_include": [
            "Core/CoreMinimal.h"
        ]
    },
    "paths": {
        "llvm_clang_rel": "lib/clang",
        "clang_include_rel": "include",
        "msvc_include_rel": "include",
        "winsdk_include_rel": "Include",
        "winsdk_ucrt_rel": "ucrt"
    },
    "clang_flags": {
        "include_prefix": "-I",
        "isystem": "-isystem",
        "resource_dir": "-resource-dir",
        "force_include": "-include",
        "fms_compatibility": "-fms-compatibility",
        "fms_extensions": "-fms-extensions",
        "fms_compat_version_prefix": "-fms-compatibility-version"
    },
    "parsing": {
        "component_base_types": [
            "Component",
            "sw::Component",
            "SceneComponent",
            "sw::SceneComponent"
        ],
        "type_strip_prefixes": [
            "const ",
            "volatile ",
            "class ",
            "struct ",
            "enum "
        ],
        "name_field_skip_folders": [
            "Tests"
        ],
        "state_declaration_skip_paths": [
            "/Tests/"
        ]
    },
    "tuning": {
        "max_parallel_parses": 8
    }
}
