+void ax::NodeEditor::NavigateToContent(float duration, float maxZoom)
+{
+    auto bounds = s_Editor->GetContentBounds();
+    if (bounds.GetWidth() <= 0.0f || bounds.GetHeight() <= 0.0f || maxZoom <= 0.0f)
+    {
+        NavigateToContent(duration);
+        return;
+    }
+    // Grow small content to the area the canvas shows at maxZoom so the fit never zooms in past it.
+    const auto screenSize = s_Editor->GetRect().GetSize();
+    const auto center     = bounds.GetCenter();
+    const auto halfWidth  = ImMax(bounds.GetWidth(), screenSize.x / maxZoom) * 0.5f;
+    const auto halfHeight = ImMax(bounds.GetHeight(), screenSize.y / maxZoom) * 0.5f;
+    s_Editor->NavigateTo(ImRect(center.x - halfWidth, center.y - halfHeight, center.x + halfWidth, center.y + halfHeight), true, duration);
+}
