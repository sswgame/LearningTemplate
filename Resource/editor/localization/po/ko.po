#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.AlignSelected"
msgid "Align and distribute the selected objects (select two or more)."
msgstr "선택한 오브젝트를 정렬하고 분배합니다(둘 이상 선택)."

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.AssetSlotClear"
msgid "Clear this asset reference."
msgstr "이 에셋 참조를 비웁니다."

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.AssetSlotDrop"
msgid "Drag an asset from the Content Browser and drop it here to assign it."
msgstr "콘텐츠 브라우저에서 에셋을 끌어 여기에 놓으면 지정됩니다."

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.AutoplayToggle"
msgid "{game} autoplay: {description} ({variable}, console: autoplay on|off)"
msgstr "{game} 자동 플레이: {description} ({variable}, 콘솔: autoplay on|off)"

#: Source/Editor/Popups/BoneHierarchyPopup.cpp
msgctxt "EdCommon.BoneNoSelection"
msgid "No selection. Select an object in the Hierarchy."
msgstr "선택한 것이 없습니다. Hierarchy 에서 오브젝트를 고르십시오."

#: Source/Editor/Popups/BoneHierarchyPopup.cpp
msgctxt "EdCommon.BoneObjectNotFound"
msgid "Object not found in the active scene."
msgstr "활성 씬에서 오브젝트를 찾지 못했습니다."

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.BuildCompiling"
msgid "Modules are being built in the background."
msgstr "현재 백그라운드에서 모듈을 빌드하고 있습니다"

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.BuildFailed"
msgid "The build failed. See the console window for the detailed errors."
msgstr "빌드에 실패했습니다. 콘솔 창에서 상세 오류를 확인하세요."

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.BuildReady"
msgid "Live Coding is ready to build."
msgstr "라이브 코딩 빌드 준비 완료"

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.BuildSucceeded"
msgid "The last build finished successfully."
msgstr "마지막 빌드가 성공적으로 완료되었습니다"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.CameraBookmarkPosition"
msgid "Position: {position}"
msgstr "위치: {position}"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.CameraBookmarks"
msgid "Camera bookmarks: move the view to a saved camera position (Ctrl+1~9)"
msgstr "카메라 북마크: 저장한 카메라 위치로 뷰를 옮깁니다 (Ctrl+1~9)"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.CameraSpeed"
msgid "Camera fly speed (0.5 to 20). Turning the mouse wheel while holding the right mouse button also changes it."
msgstr "카메라 비행 속도(0.5 ~ 20)입니다. 오른쪽 마우스 단추를 누른 채 휠을 돌려도 바뀝니다."

#: Source/Editor/Popups/CommandPalettePopup.cpp
msgctxt "EdCommon.CommandPaletteHint"
msgid "Type a command or search objects... (Esc to close)"
msgstr "명령을 입력하거나 오브젝트를 검색합니다... (Esc 로 닫기)"

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.CompileGame"
msgid "Live Coding: compile the SWGame module now and hot-reload it (Ctrl+Alt+F11)"
msgstr "라이브 코딩: SWGame 모듈을 즉시 컴파일하고 핫리로드합니다 (Ctrl+Alt+F11)"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.ComponentCardActive"
msgid "Enable or disable this component."
msgstr "컴포넌트 활성화/비활성화"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.ComponentCardOptions"
msgid "More options for this component, including removing it."
msgstr "컴포넌트 추가 옵션 및 삭제"

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EdCommon.CurveEditorHint"
msgid "Click a key to edit it. Right-click to add a key. F fits the view."
msgstr "키를 클릭하면 편집합니다. 오른쪽 클릭으로 키를 더합니다. F 를 누르면 뷰를 곡선에 맞춥니다."

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EdCommon.CurveNoKeys"
msgid "(no keys)"
msgstr "(키 없음)"

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EdCommon.CurvePreviewEdit"
msgid "Click to edit the curve"
msgstr "클릭하면 곡선을 편집합니다"

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EdCommon.DebugHUDNotRunning"
msgid "Debug HUD is not running"
msgstr "디버그 HUD 가 실행 중이 아닙니다"

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EdCommon.DebugHUDNotRunningHost"
msgid "Debug HUD is not running (Shipping or a test host)."
msgstr "디버그 HUD 가 실행 중이 아닙니다(Shipping 이거나 시험 호스트입니다)."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EdCommon.DebugHUDSavedIn"
msgid "Saved in the engine user settings (debug.hud, debug.hudSections, debug.hudCorner, debug.hudOpacity)"
msgstr "엔진 사용자 설정에 저장됩니다 (debug.hud, debug.hudSections, debug.hudCorner, debug.hudOpacity)"

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EdCommon.DebugHUDShow"
msgid "Show the in-game Debug HUD in the game view, with the sections chosen below (Ctrl+F3)"
msgstr "게임 뷰에 디버그 HUD 를 아래에서 고른 섹션과 함께 보입니다 (Ctrl+F3)"

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.DeleteLayout"
msgid "Delete this saved layout."
msgstr "저장된 레이아웃을 지웁니다."

#: Source/Editor/Common/GUI/EditorDocumentPanel.cpp
msgctxt "EdCommon.DocumentOpen"
msgid "Find and open an asset of this type (the same as Quick Open or double-clicking it in the Content Browser)."
msgstr "이 종류의 에셋을 찾아 엽니다(Quick Open · 콘텐츠 브라우저 더블클릭과 같다)"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.GizmoLocalSpace"
msgid "Local space: the gizmo follows the object's rotation. Click to switch to world space."
msgstr "로컬 공간: 기즈모가 오브젝트의 회전을 따릅니다. 클릭하면 월드 공간으로 바뀝니다."

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.GizmoRotate"
msgid "Rotate: turn the selection around an axis (E)"
msgstr "회전: 선택한 오브젝트를 축을 중심으로 돌립니다 (E)"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.GizmoScale"
msgid "Scale: resize the selection along an axis, or uniformly from the center (R)"
msgstr "크기: 선택한 오브젝트의 크기를 축 방향이나 중심에서 고르게 바꿉니다 (R)"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.GizmoTranslate"
msgid "Translate: move the selection along an axis or plane (W)"
msgstr "이동: 선택한 오브젝트를 축이나 평면을 따라 옮깁니다 (W)"

