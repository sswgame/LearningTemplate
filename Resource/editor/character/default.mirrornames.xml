<!-- 좌우 이름 표 — MirrorNameRules 가 읽는다. 쌍 하나가 철자 하나다(앞의 쌍이 먼저 맞춰 본다). 토큰은 대소문자를 구분하고, 이름의 앞 · 뒤나 구분자(_ . - 공백), CamelCase 경계에 놓일 때만 짝으로 인정한다. -->
<MirrorNames>
    <Pair first="_L" second="_R"/>
    <Pair first=".L" second=".R"/>
    <Pair first="_l" second="_r"/>
    <Pair first=".l" second=".r"/>
    <Pair first="Left" second="Right"/>
    <Pair first="left" second="right"/>
    <Pair first="L_" second="R_"/>
    <Pair first="l_" second="r_"/>
</MirrorNames>
