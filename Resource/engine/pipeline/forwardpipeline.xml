<?xml version="1.0" encoding="utf-8"?>
<!--
  Render Pipeline (frame graph + per-pass PSO recipe).
  Attachment *templates* for RHI live in engine/renderpass/*.xml (see _renderPassRefs).
  Transient frame targets are listed here under _attachments.
-->
<RenderPipelineDesc formatVersion="0">
	<_name>ForwardPipeline</_name>
	<_shadingModel>Forward</_shadingModel>
	<_renderPassRefs>
		<item>engine/renderpass/defaultrenderpass.xml</item>
	</_renderPassRefs>
	<_attachments>
		<item>
			<_name>SceneColor</_name>
			<_format>R8G8B8A8_UNORM</_format>
			<_clearColor>0.120000,0.150000,0.180000,1.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>SceneDepth</_name>
			<_format>D24_UNORM_S8_UINT</_format>
			<_clearColor>1.000000,0.000000,0.000000,0.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>ShadowMap</_name>
			<_format>D24_UNORM_S8_UINT</_format>
			<_clearColor>1.000000,0.000000,0.000000,0.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>BloomColor</_name>
			<_format>R16G16B16A16_FLOAT</_format>
			<_clearColor>0.000000,0.000000,0.000000,1.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>OutlineColor</_name>
			<_format>R8G8B8A8_UNORM</_format>
			<_clearColor>0.120000,0.150000,0.180000,1.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
	</_attachments>
	<_passes>
		<item>
			<_name>Shadow</_name>
			<_type>Shadow</_type>
			<_inputs/>
			<_outputs>
				<item>ShadowMap</item>
			</_outputs>
			<_shaderPath>engine/shaders/shadowdepth.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>Back</_cullMode>
			<_bEnableDepthTest>1</_bEnableDepthTest>
			<_bEnableDepthWrite>1</_bEnableDepthWrite>
			<_bEnableBlend>0</_bEnableBlend>
		</item>
		<item>
			<_name>ForwardOpaque</_name>
			<_type>ForwardOpaque</_type>
			<_inputs>
				<item>ShadowMap</item>
			</_inputs>
			<_outputs>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_outputs>
			<_shaderPath>engine/shaders/forwardlit.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>Back</_cullMode>
			<_bEnableDepthTest>1</_bEnableDepthTest>
			<_bEnableDepthWrite>1</_bEnableDepthWrite>
			<_bEnableBlend>0</_bEnableBlend>
			<_permutations>
				<item>SW_FORWARD=1</item>
			</_permutations>
		</item>
		<item>
			<_name>Transparent</_name>
			<_type>Transparent</_type>
			<_inputs>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_inputs>
			<_outputs>
				<item>SceneColor</item>
			</_outputs>
			<_shaderPath>engine/shaders/forwardlit.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>Back</_cullMode>
			<_bEnableDepthTest>1</_bEnableDepthTest>
			<_bEnableDepthWrite>0</_bEnableDepthWrite>
			<_bEnableBlend>1</_bEnableBlend>
			<_permutations>
				<item>SW_TRANSPARENT=1</item>
			</_permutations>
		</item>
		<item>
			<_name>PostBloom</_name>
			<_type>Bloom</_type>
			<_inputs>
				<item>SceneColor</item>
			</_inputs>
			<_outputs>
				<item>BloomColor</item>
			</_outputs>
			<_shaderPath>engine/shaders/postbloom.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>None</_cullMode>
			<_bEnableDepthTest>0</_bEnableDepthTest>
			<_bEnableDepthWrite>0</_bEnableDepthWrite>
			<_bEnableBlend>0</_bEnableBlend>
		</item>
		<item>
			<_name>Outline</_name>
			<_type>Outline</_type>
			<_inputs>
				<item>BloomColor</item>
			</_inputs>
			<_outputs>
				<item>OutlineColor</item>
			</_outputs>
			<_shaderPath>common/shaders/postoutline.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>None</_cullMode>
			<_bEnableDepthTest>0</_bEnableDepthTest>
			<_bEnableDepthWrite>0</_bEnableDepthWrite>
			<_bEnableBlend>0</_bEnableBlend>
		</item>
		<item>
			<_name>Present</_name>
			<_type>Present</_type>
			<_inputs>
				<item>OutlineColor</item>
			</_inputs>
			<_outputs>
				<item>Swapchain</item>
			</_outputs>
			<_shaderPath>engine/shaders/fullscreenblit.hlsl</_shaderPath>
			<_vertexEntryPoint>VSMain</_vertexEntryPoint>
			<_pixelEntryPoint>PSMain</_pixelEntryPoint>
			<_cullMode>None</_cullMode>
			<_bEnableDepthTest>0</_bEnableDepthTest>
			<_bEnableDepthWrite>0</_bEnableDepthWrite>
			<_bEnableBlend>0</_bEnableBlend>
		</item>
	</_passes>
</RenderPipelineDesc>
