<RenderPipelineDesc _name="DeferredPipeline" _shadingModel="Deferred">
	<_listAttachment>
		<RenderPassAttachment _name="GBufferAlbedo" _format="R8G8B8A8_UNORM" _clearColor="0,0,0,0" _bClear="true" />
		<!-- G버퍼 노멀 칸 — 옥타헤드럴 좌표 snorm16 둘(binding.hlsli Octahedral::encode). 클리어 (0, 0) 은 +z 로 풀린다. -->
		<RenderPassAttachment _name="GBufferNormal" _format="R16G16_SNORM" _clearColor="0,0,0,0" _bClear="true" />
		<!-- G버퍼 머티리얼 칸 — r 금속도, g 거칠기, a "그려졌다" 표시(binding.hlsli SurfaceOutput::encodeGbufferMaterial). 디퍼드 조명이 PBR 식에 넘긴다. -->
		<RenderPassAttachment _name="GBufferMaterial" _format="R8G8B8A8_UNORM" _clearColor="0,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="SceneDepth" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="ShadowMap" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="LitColor" _format="R16G16B16A16_FLOAT" _clearColor="0.12,0.15,0.18,1" _bClear="true" />
		<!-- 반투명 앞의 장면 색 · 깊이 사본 — 반투명(물의 굴절 · 화면 공간 두께)이 읽는다. 복사 패스가 쓰므로 지우지 않는다. -->
		<RenderPassAttachment _name="SceneColorCopy" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="false" />
		<RenderPassAttachment _name="SceneDepthCopy" _format="R32_FLOAT" _clearColor="1,0,0,0" _bClear="false" />
		<RenderPassAttachment _name="AOColor" _format="R8G8B8A8_UNORM" _clearColor="1,1,1,1" _bClear="true" />
		<!-- 블룸의 밝은 부분은 반해상도로 구한다(BloomDownsample) — PostBloom 이 업샘플해 더한다. -->
		<RenderPassAttachment _name="BloomBright"
		                      _format="R16G16B16A16_FLOAT"
		                      _clearColor="0,0,0,1"
		                      _bClear="true"
		                      _resolutionDivisor="2" />
		<RenderPassAttachment _name="BloomColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" />
		<RenderPassAttachment _name="TAAColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" />
		<RenderPassAttachment _name="DepthOfFieldColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" />
		<RenderPassAttachment _name="MotionBlurColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" />
		<!-- 외곽선은 톤맵 앞의 HDR 색에 그린다 — 원본(BloomColor)과 같은 형식이어야 꺼진 뷰에서 출력이 원본을 가리킬 수 있다(RGBA8 이면 TAA · 톤맵 앞에서 1 이 넘는 색이 잘렸다). -->
		<RenderPassAttachment _name="OutlineColor"
		                      _format="R16G16B16A16_FLOAT"
		                      _clearColor="0.12,0.15,0.18,1"
		                      _bClear="true" />
		<RenderPassAttachment _name="TonemapColor" _format="R8G8B8A8_UNORM" _clearColor="0.12,0.15,0.18,1" _bClear="true" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="Shadow"
		                     _type="Shadow"
		                     _depthAttachment="ShadowMap"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput />
			<_listOutput>
				<item>ShadowMap</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="GBuffer"
		                     _type="GBuffer"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput />
			<_listOutput>
				<item>GBufferAlbedo</item>
				<item>GBufferNormal</item>
				<item>GBufferMaterial</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Shading"
		                     _type="Lighting"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>GBufferAlbedo</item>
				<item>GBufferNormal</item>
				<item>GBufferMaterial</item>
				<item>SceneDepth</item>
				<item>ShadowMap</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- G버퍼로 나타낼 수 없는 머티리얼(MATERIAL_FORWARD_ONLY — 툰의 계단 셰이딩)을 조명 결과 위에 포워드로 그린다. G버퍼 패스는 그 배치를 뺀다.
		     장면 깊이를 테스트 · 쓰기 하므로 외곽선 · 반투명보다 앞이다. -->
		<RenderGraphPassDesc _name="ForwardOnly"
		                     _type="ForwardOnlyOpaque"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
				<item>ShadowMap</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 후처리 품질(graphics.postQuality) high 부터 돈다 — 낮으면 AOColor 를 가림 없음(흰색)으로 지운다. -->
		<RenderGraphPassDesc _name="SSAO"
		                     _type="SSAO"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false"
		                     _minPostQuality="2">
			<_listInput>
				<item>GBufferNormal</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>AOColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 뒤집은 껍질 외곽선(toon.hlsl 의 외곽선 퍼뮤테이션) — 외곽선을 켠 머티리얼(MATERIAL_OUTLINE)의 배치만 앞면을 컬링해 그린다.
		     불투명 깊이를 읽는 패스보다 뒤, 반투명보다 앞이다(외곽선이 깊이를 써서 뒤의 반투명을 가린다). -->
		<RenderGraphPassDesc _name="MeshOutline"
		                     _type="MeshOutline"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 강조 외곽선(highlightoutline.hlsl) — 강조 방식이 Outline 인 인스턴스만 뒤집은 껍질로 깊이 테스트해 그린다(상호작용 대상). 두께는 화면 높이 비율. -->
		<RenderGraphPassDesc _name="HighlightOutline"
		                     _type="HighlightOutline"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_HIGHLIGHT_WIDTH=0.004</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 하늘(SkyComponent) — 불투명 · 외곽선 뒤, 반투명 앞. 깊이 1 의 풀스크린 삼각형을 깊이 테스트로 그려 빈 곳만 칠한다(쓰기 없음). 씬에 하늘이 없으면 돌지 않는다. -->
		<RenderGraphPassDesc _name="Sky"
		                     _type="Sky"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 장면 색 사본 — 하늘까지 칠한 장면 색을 반투명이 읽을 수 있게 떠 둔다(반투명은 장면 색에 섞으며 써서 그 색을 읽을 수 없다). 셰이더 없는 복사 패스다. -->
		<RenderGraphPassDesc _name="SceneColorCopy"
		                     _type="SceneColorCopy"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
			</_listInput>
			<_listOutput>
				<item>SceneColorCopy</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 장면 깊이 사본 — 장면 깊이를 R32 실수로 옮긴다(scenedepthcopy.hlsl). 반투명이 읽는다. -->
		<RenderGraphPassDesc _name="SceneDepthCopy"
		                     _type="SceneDepthCopy"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneDepthCopy</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Transparent"
		                     _type="Transparent"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
				<item>SceneColorCopy</item>
				<item>SceneDepthCopy</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 감각 모드 외곽선 — 강조 방식이 Sense 인 인스턴스만 깊이 테스트 없이 그려 벽 너머에서도 보인다. 반투명 뒤. -->
		<RenderGraphPassDesc _name="HighlightSense"
		                     _type="HighlightSense"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_HIGHLIGHT_WIDTH=0.004</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 높이 · 거리 지수 안개(FogComponent · 물속) — 장면 깊이로 시선 위 광학 두께를 구해 이미 칠한 색 위에 프리멀티플라이로 블렌드한다(색을 읽지 않는다). 씬에 안개가 없으면 돌지 않는다. 하늘 픽셀은 건드리지 않는다. -->
		<RenderGraphPassDesc _name="Fog"
		                     _type="Fog"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>LitColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="BloomDownsample"
		                     _type="BloomDownsample"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>LitColor</item>
			</_listInput>
			<_listOutput>
				<item>BloomBright</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 후처리 품질 medium 부터 돈다 — low 면 원본(LitColor)을 그대로 넘긴다(블룸 · AO 적용 없음). -->
		<RenderGraphPassDesc _name="PostBloom"
		                     _type="Bloom"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false"
		                     _minPostQuality="1">
			<_listInput>
				<item>LitColor</item>
				<item>AOColor</item>
				<item>BloomBright</item>
			</_listInput>
			<_listOutput>
				<item>BloomColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Outline"
		                     _type="Outline"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>BloomColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>OutlineColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 시간 누적 — 기록을 깊이로 지난 프레임 자리에 재투영하고 이번 원본의 3x3 이웃 범위로 잘라 섞는다(taa.hlsl). 화면 밖에서 온 픽셀은 이번 원본이다. -->
		<RenderGraphPassDesc _name="TAA"
		                     _type="TAA"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>OutlineColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>TAAColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 피사계 심도 — TAA 가 고른 HDR 색을 장면 깊이의 착란원만큼 흐린다. 카메라 조리개가 0(기본)이거나 후처리를 끈 뷰는 원본을 그대로 낸다. -->
		<RenderGraphPassDesc _name="DepthOfField"
		                     _type="DepthOfField"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>TAAColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>DepthOfFieldColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 카메라 모션 블러 — 사용자 설정 graphics.motionBlur 를 끄거나 후처리 품질이 medium 아래면 DepthOfFieldColor 를 그대로 복사한다(같은 포맷). -->
		<RenderGraphPassDesc _name="MotionBlur"
		                     _type="MotionBlur"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false"
		                     _minPostQuality="1">
			<_listInput>
				<item>DepthOfFieldColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>MotionBlurColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Tonemap"
		                     _type="Tonemap"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>MotionBlurColor</item>
			</_listInput>
			<_listOutput>
				<item>TonemapColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present"
		                     _type="Present"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>TonemapColor</item>
			</_listInput>
			<_listOutput>
				<item>Swapchain</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 화면 2D(UI · 월드 글자) — Present(톤맵) 뒤 같은 출력에 불러온 채 그린다. Swapchain 을 쓰는 마지막 패스여야 한다(스크린샷 캡처 복사도 이 뒤). -->
		<RenderGraphPassDesc _name="Canvas"
		                     _type="Canvas"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput />
			<_listOutput>
				<item>Swapchain</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
	</_listPass>
	<_listRenderPassRef>
		<item>engine/renderpass/defaultrenderpass.xml</item>
	</_listRenderPassRef>
</RenderPipelineDesc>
