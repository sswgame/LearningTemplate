<!--
	깊이 프리패스(Depth Priming)를 앞에 둔 포워드 파이프라인. 나머지는 `forwardpipeline.xml` 과 같다.

	무엇을 사나: 불투명 지오메트리를 먼저 **깊이만** 그려 두면, 기본 패스는 보이는 픽셀만 셰이딩한다(겹친 면의 조명 · 텍스처
	계산을 건너뛴다). 언리얼의 EarlyZ 패스(r.EarlyZPass) · 유니티 URP 의 Depth Priming 자리다. 픽셀 셰이딩이 비싼 장면에서 이득이고,
	깊이만 그리는 비용이 하나 더 든다.

	맞물림: 프리패스는 shadowdepth.hlsl 을 **카메라** 행렬로 그리고(패스 define `SW_PASS_DEPTH_PREPASS`), 기본 패스는 같은 위치 함수
	(binding.hlsli `swComputeWorldPosition` · `swComputeClipPosition`, precise)로 같은 깊이를 내 LessEqual 을 통과한다 — 언리얼이 depth-only 와
	base pass 에 같은 정점 팩토리 코드를 쓰는 것과 같은 이유다. 프리패스가 돈 프레임의 ForwardOpaque 는 깊이 쓰기를 끈 PSO 로 그린다.
	같은 그림을 내는지 시험이 프리패스 없는 판과 대조한다(`RenderPassGpuTest.DepthPrepassRendersTheSameImage`).
-->
<RenderPipelineDesc _name="ForwardPrepassPipeline" _shadingModel="Forward">
	<_listAttachment>
		<RenderPassAttachment _name="SceneColor" _format="R8G8B8A8_UNORM" _clearColor="0.12,0.15,0.18,1" _bClear="true" />
		<RenderPassAttachment _name="SceneDepth" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="ShadowMap" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="Shadow"
		                     _type="Shadow"
		                     _depthAttachment="ShadowMap"
		                     _shaderPath="engine/shaders/shadowdepth.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput />
			<_listOutput>
				<item>ShadowMap</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="DepthPrepass"
		                     _type="DepthPrepass"
		                     _depthAttachment="SceneDepth"
		                     _shaderPath="engine/shaders/shadowdepth.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput />
			<_listOutput>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="ForwardOpaque"
		                     _type="ForwardOpaque"
		                     _depthAttachment="SceneDepth"
		                     _shaderPath="engine/shaders/forwardlit.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>ShadowMap</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_FORWARD=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Transparent"
		                     _type="Transparent"
		                     _depthAttachment="SceneDepth"
		                     _shaderPath="engine/shaders/forwardlit.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_TRANSPARENT=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present"
		                     _type="Present"
		                     _shaderPath="engine/shaders/postchain.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>Swapchain</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_POST_BLOOM=1</item>
				<item>SW_POST_OUTLINE=1</item>
				<item>SW_POST_TONEMAP=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
	</_listPass>
	<_listRenderPassRef>
		<item>engine/renderpass/defaultrenderpass.xml</item>
	</_listRenderPassRef>
</RenderPipelineDesc>
