<?xml version="1.0" encoding="utf-8"?>
<!--
  Engine default InputMap — Title Confirm/Continue/Cancel + Debug reload actions.
  Debug reload actions use Ctrl+F6, Ctrl+F7, Ctrl+F8 chords to prevent collision with gameplay F1~F12 skills.
-->
<InputMap defaultLayer="Title" doubleClickTime="0.35" doubleClickMaxDistance="6" holdThreshold="0.4">
	<layers>
		<layer name="Title" enabled="1" blockLower="1"/>
		<layer name="Gameplay" enabled="0" blockLower="0"/>
		<layer name="Debug" enabled="1" blockLower="0" alwaysOn="1"/>
	</layers>

	<action name="Confirm" layer="Title" trigger="Pressed">
		<bind source="key" code="Enter"/>
		<bind source="key" code="Space"/>
	</action>
	<action name="Continue" layer="Title" trigger="Pressed">
		<bind source="key" code="C"/>
	</action>
	<action name="Cancel" layer="Title" trigger="Pressed">
		<bind source="key" code="Escape"/>
	</action>
	<layer name="Debug" enabled="1" blockLower="0" alwaysOn="1">
		<action name="ReloadShaders" trigger="Pressed">
			<bind source="key" modifier="Ctrl" code="F8"/>
		</action>
		<action name="ReloadEditor" trigger="Pressed">
			<bind source="key" modifier="Ctrl" code="F6"/>
		</action>
		<action name="ReloadGame" trigger="Pressed">
			<bind source="key" modifier="Ctrl" code="F7"/>
		</action>
	</layer>
</InputMap>
