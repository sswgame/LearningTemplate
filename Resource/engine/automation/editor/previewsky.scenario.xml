<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 미리보기 창의 하늘(다중 월드 6절 3번). 미리보기 조명 환경은 하늘(SkyComponent)을 스폰하고(EditorPreviewEnvironment::_bSky 기본 켬),
  스카이 패스가 불투명 · 외곽선 뒤에 깊이 1 의 풀스크린 삼각형으로 빈 곳만 칠한다. 그래서 구 둘레의 배경은 SceneColor 클리어 색이 아니라 천정 → 지평선 그러데이션이어야 한다.
  ① 머티리얼 창에 빨간 테스트 머티리얼을 열어 구 미리보기가 그려지게 하고 타깃을 PPM 으로 저장한다(gv_editorPreviewScreenshot).
  ② 창을 닫고 다시 열어(새 미리보기 렌더러) 한 장 더 저장한다 — 스카이 패스가 다시 선 렌더러에서도 도는지 본다.
  그림이 맞는지(위가 천정색, 지평선 쪽이 밝고, 구 뒤는 하늘, 구 위는 하늘에 덮이지 않음)는 저장한 PPM 을 눈으로 본다. 평균 색 문턱값은 GPU 로 돌려 보기 전에는 맞출 수 없어 자동 단언을 두지 않았다.
  파일: Saved/Automation/previewsky_<first|reopen>.ppm. 디퍼드에서도 빈 곳만 칠하는지는 같은 시나리오를 -gv_deferred=1 로 돌려 본다(미리보기 렌더러는 창을 열 때 파이프라인을 고른다).
  실행: py -3 -m Scripts scenario previewsky (백엔드 vk · dx11 · gl 도 같다. 각 백엔드마다 -gv_deferred=1 을 더한 변형은 app-arg 옵션(이름 앞에 하이픈 둘)에 그 인자를 준다)
-->
<Scenario name="editor.previewsky" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/><Variable name="gv_editorProbePanel" value="material"/></At>

	<!-- ① 문서를 열어 구 미리보기가 그려지게 한 뒤 타깃을 저장한다 -->
	<At frame="30"><Variable name="gv_editorProbeAsset" value="engine/automation/editor/materialpreview/previewred.material"/></At>
	<At frame="60"><EditorKey key="Ctrl+P"/></At>
	<At frame="75"><EditorText value="previewred.material"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="95"><WaitUntil probe="Editor.MaterialDocumentIsProbeAsset" equals="1" timeoutFrames="600"/></At>
	<At frame="100"><DevCommand line="panel.focus material"/></At>
	<At frame="101"><WaitUntil probe="Editor.MaterialPreviewSceneFrames" atLeast="40" timeoutFrames="600"/></At>
	<At frame="110"><Variable name="gv_editorPreviewScreenshot" value="Saved/Automation/previewsky_first.ppm"/></At>
	<At frame="140">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<ExpectLog contains="Scene preview renderer started for scene key" atLeast="1"/>
		<ExpectLog contains="Preview viewport screenshot" atLeast="1"/>
	</At>

	<!-- ② 닫고 다시 연다 — 새 미리보기 렌더러에서도 하늘이 칠해진다 -->
	<At frame="150"><DevCommand line="panel.close material"/></At>
	<At frame="170"><EditorKey key="Ctrl+P"/></At>
	<At frame="185"><EditorText value="previewred.material"/></At>
	<At frame="200"><EditorKey key="Enter"/></At>
	<At frame="205"><WaitUntil probe="Editor.MaterialDocumentIsProbeAsset" equals="1" timeoutFrames="600"/></At>
	<At frame="210"><DevCommand line="panel.focus material"/></At>
	<At frame="211"><Remember probe="Editor.MaterialPreviewSceneFrames" as="frames"/></At>
	<At frame="212"><WaitUntil probe="Editor.MaterialPreviewSceneFrames" differsFrom="frames" timeoutFrames="300"/></At>
	<At frame="260"><Variable name="gv_editorPreviewScreenshot" value="Saved/Automation/previewsky_reopen.ppm"/></At>
	<At frame="290">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<ExpectLog contains="Scene preview renderer started for scene key" atLeast="2"/>
		<ExpectLog contains="Preview viewport screenshot" atLeast="2"/>
	</At>
	<At frame="295"><DevCommand line="panel.close material"/></At>
	<At frame="300"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
