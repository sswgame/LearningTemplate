<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 메시 모디파이어 패널(GF_EditorPlugIn_MeshModifiers, 후보 MeshModifierStack): 파괴 쇼케이스의 왼쪽 상자(CrateLeft, crate_medium.mesh - 통은 벽 뒤라 씬 뷰 그림에서 가려진다)을 골라 패널 대상으로 삼고
  모디파이어를 쌓는다. ① 휘기(Bend)를 더하고 각을 넣으면 GPU 미리보기(모프 풀 + 변형 프로그램)가 대상 메시에 걸리고 씬 뷰 그림이 레스트와 달라진다.
  ② 뷰포트의 이동 화살표(시각화 meshmodifiers.preview)를 끌면 기즈모 중심이 움직이고 **선택은 그대로다** — 손잡이를 집는 첫 클릭이 뷰포트 클릭 선택으로 새지 않는다.
  ③ 곡선 목록(Curve Sculpt Layered "Layer Curves") 항목 추가 · 항목마다 곡선 편집기 팝업에서 키 추가, ④ 참조 목록(Conform Multi "Targets") 항목 추가 · 선택 사용,
  ⑤ 묶음(Deformable) 하위 스택에 모디파이어 추가. CPU 전용 모디파이어가 들어오면 GPU 미리보기는 내려가고 CPU 결과 정점으로 셰이딩한다(그림은 GPU 결과와 같다).
  스크린샷은 렌더 출력(씬 뷰)만 담는다 — 패널 · 기즈모는 ImGui 오버레이라 그림에 없어 이름표 클릭과 탐침으로 보고, 눈으로 볼 그림은 CaptureEditorUI(meshmodifiers/*.png)로 남긴다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/meshmodifiers.scenario.xml -dx12
-->
<Scenario name="editor.meshmodifiers" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="10"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="15"><DevCommand line="layout.reset"/></At>
	<At frame="20"><DevCommand line="panel.resetOptional"/></At>
	<At frame="30"><DevCommand line="scene.open game/empty/maps/destructionshowcase.scene.xml"/></At>
	<At frame="40"><WaitUntil probe="Editor.ObjectCount" atLeast="9" timeoutFrames="600"/></At>
	<At frame="90"><EditorClick mark="hierarchy.row.CrateLeft"/></At>
	<At frame="100"><EditorExpectObject name="CrateLeft" selected="1"/></At>
	<!-- 씬 뷰가 상자를 비추게 한다(F = 고른 것에 맞추기) -->
	<At frame="105"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="115"><EditorKey key="F"/></At>
	<At frame="140"><DevCommand line="panel.focus game_view"/></At>
	<At frame="145"><Screenshot file="game.ppm"/></At>
	<At frame="147"><DevCommand line="panel.focus scene_view"/></At>
	<!-- 기준 그림은 게임 뷰 탭을 다녀온 뒤에 찍는다 — 탭을 바꾼 뒤 씬 뷰 폭이 1 px 달라져 앞에서 찍으면 뒤의 그림과 크기가 다르다 -->
	<At frame="152"><Screenshot file="rest.ppm"/></At>

	<!-- ① 대상 고르기 · 휘기 더하기 · 각 넣기 -->
	<At frame="160"><DevCommand line="panel.focus meshmodifiers.stack"/></At>
	<At frame="175"><EditorClick mark="meshmodifiers.useSelection"/></At>
	<At frame="190"><EditorClick mark="meshmodifiers.add"/></At>
	<At frame="200"><EditorClick mark="meshmodifiers.category.Deform"/></At>
	<At frame="210"><EditorClick mark="meshmodifiers.item.bend"/></At>
	<At frame="225"><Expect probe="MeshModifiers.ModifierCount" equals="1"/></At>
	<At frame="230"><EditorClick mark="meshmodifiers.param.Angle" mods="ctrl"/></At>
	<At frame="240"><EditorText value="80"/></At>
	<At frame="245"><EditorKey key="Enter"/></At>
	<At frame="265">
		<Expect probe="MeshModifiers.SelectedFirstParam" equals="80"/>
		<Expect probe="MeshModifiers.GPUPreviewActive" equals="1"/>
		<CaptureEditorUI file="meshmodifiers/panel.png"/>
	</At>
	<At frame="270"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="290"><Screenshot file="gpubend.ppm"/></At>
	<At frame="292"><ExpectImage file="gpubend.ppm" metric="differentFrom" reference="rest.ppm" atLeast="0.002"/></At>

	<!-- ② 이동 화살표 끌기 - 기즈모가 움직이고 선택(상자)은 그대로다 -->
	<!-- 패널이 씬 뷰 위에 떠 있으면 손잡이를 가린다 - 닫아도 세션(대상 · 스택)과 시각화는 그대로다 -->
	<At frame="295"><DevCommand line="panel.close meshmodifiers.stack"/></At>
	<At frame="300"><Expect probe="MeshModifiers.SelectedCenterOffset" atMost="0.0001"/></At>
	<At frame="305"><EditorDrag mark="meshmodifiers.handle.move.0" dx="70"/></At>
	<At frame="335">
		<Expect probe="MeshModifiers.SelectedCenterOffset" atLeast="0.01"/>
		<Expect probe="Editor.SelectionCount" equals="1"/>
		<EditorExpectObject name="CrateLeft" selected="1"/>
		<CaptureEditorUI file="meshmodifiers/gizmo.png"/>
	</At>
	<!-- 휘기는 X 이동에 모양이 그대로다(옆 방향은 Z) - 그림은 남기기만 한다 -->
	<At frame="340"><Screenshot file="gpubendmoved.ppm"/></At>

	<!-- ③ 곡선 목록: 항목 둘 → 둘째 항목 곡선 편집기에서 키 하나 더하기. CPU 전용이라 GPU 미리보기는 내려간다 -->
	<At frame="350"><DevCommand line="panel.focus meshmodifiers.stack"/></At>
	<At frame="365"><EditorClick mark="meshmodifiers.add"/></At>
	<At frame="375"><EditorClick mark="meshmodifiers.category.Curve"/></At>
	<At frame="385"><EditorClick mark="meshmodifiers.item.curvesculptlayered"/></At>
	<At frame="400">
		<Expect probe="MeshModifiers.ModifierCount" equals="2"/>
		<Expect probe="MeshModifiers.CurveListItemCount" equals="0"/>
		<Expect probe="MeshModifiers.GPUPreviewActive" equals="0"/>
	</At>
	<At frame="405"><EditorClick mark="meshmodifiers.curveList.add"/></At>
	<At frame="420"><EditorClick mark="meshmodifiers.curveList.add"/></At>
	<At frame="435">
		<Expect probe="MeshModifiers.CurveListItemCount" equals="2"/>
		<Expect probe="MeshModifiers.CurveListKeyCount" equals="4"/>
	</At>
	<At frame="440"><EditorClick mark="meshmodifiers.curve.1"/></At>
	<At frame="460"><EditorClick mark="curve.canvas" button="1"/></At>
	<At frame="475"><EditorClick mark="curve.menu.addKey"/></At>
	<At frame="495"><Expect probe="MeshModifiers.CurveListKeyCount" equals="5"/></At>
	<At frame="500"><EditorKey key="Escape"/></At>
	<!-- CPU 로 내려가도 셰이딩 미리보기는 남는다: 빈 곡선 층은 항등이라 그림이 GPU 휘기(옮긴 뒤)와 같고 레스트와 다르다 -->
	<At frame="508"><Screenshot file="cpubend.ppm"/></At>
	<At frame="510">
		<ExpectImage file="cpubend.ppm" metric="differentFrom" reference="rest.ppm" atLeast="0.002"/>
		<ExpectImage file="cpubend.ppm" metric="differingFraction" reference="gpubendmoved.ppm" atMost="0.001"/>
	</At>

	<!-- ④ 참조 목록: 항목 하나 → 선택 사용(상자 자신) -->
	<At frame="515"><EditorClick mark="meshmodifiers.add"/></At>
	<At frame="525"><EditorClick mark="meshmodifiers.category.Surface"/></At>
	<At frame="535"><EditorClick mark="meshmodifiers.item.conformmulti"/></At>
	<At frame="550">
		<Expect probe="MeshModifiers.ModifierCount" equals="3"/>
		<Expect probe="MeshModifiers.ReferenceListCount" equals="0"/>
	</At>
	<At frame="555"><EditorClick mark="meshmodifiers.referenceList.add"/></At>
	<At frame="570"><EditorClick mark="meshmodifiers.referenceList.0.useSelection"/></At>
	<!-- 클릭의 반영은 ImGui 입력 → 다음 프레임 그리기를 지나 도착한다 — 고정 프레임 수에 단언하지 않고 도착을 기다린다(MeshModifiersChainFailure: 부하 아래 한 번 0) -->
	<At frame="585">
		<WaitUntil probe="MeshModifiers.ReferenceListCount" equals="1" timeoutFrames="120"/>
		<Expect probe="MeshModifiers.ReferenceListCount" equals="1"/>
	</At>

	<!-- ⑤ 묶음 하위 스택에 비틀기 더하기 -->
	<At frame="595"><EditorClick mark="meshmodifiers.add"/></At>
	<At frame="605"><EditorClick mark="meshmodifiers.category.Group"/></At>
	<At frame="615"><EditorClick mark="meshmodifiers.item.deformable"/></At>
	<At frame="630">
		<Expect probe="MeshModifiers.ModifierCount" equals="4"/>
		<Expect probe="MeshModifiers.NestedCount" equals="0"/>
	</At>
	<At frame="635"><EditorClick mark="meshmodifiers.nested.add"/></At>
	<At frame="645"><EditorClick mark="meshmodifiers.nested.category.Deform"/></At>
	<At frame="655"><EditorClick mark="meshmodifiers.nested.item.twist"/></At>
	<At frame="670">
		<Expect probe="MeshModifiers.ModifierCount" equals="4"/>
		<Expect probe="MeshModifiers.NestedCount" equals="1"/>
	</At>
	<At frame="675"><EditorClick mark="meshmodifiers.nested.row.0"/></At>
	<At frame="685"><CaptureEditorUI file="meshmodifiers/nested.png"/></At>
	<At frame="690"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="710"><Screenshot file="stacked.ppm"/></At>
	<At frame="720"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
