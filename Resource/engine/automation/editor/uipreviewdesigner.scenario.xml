<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — UI Preview 디자이너(runtime-ui 8-5 뒤의 (6)): 팔레트 → 끌어 놓기 · 지우기 · 슬롯 손잡이. 문서를 저장하지 않으므로 저장소 파일은 바뀌지 않는다.
  1) 슬롯 손잡이 — pause 문서의 Window(캔버스의 자식)를 고르고 가운데 손잡이를 끌면 슬롯의 _offsetMin._x 가 늘고(Editor.UIPreviewSelectedOffsetMinX) 되돌리기 하나가 쌓이며 Undo 로 돌아온다.
  2) 팔레트 — 작은 문서(uipreview/save_probe.ui.xml, 위젯 하나)에서 팔레트를 TextWidget 으로 거르고 그 항목을 트리의 루트 줄에 끌어 놓으면 위젯이 하나 늘고, Delete 가 지우고,
     Undo 가 지운 위젯을 같은 자리에 되돌리고, Undo 가 추가를 되돌린다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/uipreviewdesigner.scenario.xml -dx12
-->
<Scenario name="editor.uipreviewdesigner" fixedDelta="0.0166667" timeoutFrames="3000" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<!-- 체인에서는 앞 시나리오(uipreview)가 고친 채 둔 문서를 이 시나리오가 다른 문서를 열며 버린다 — 그 경고는 체인에서만 난다 -->
	<At frame="26"><ExpectLog id="UIPreview.UnsavedEditsDiscarded" atLeast="0"/></At>
	<!-- 1) 슬롯 손잡이 -->
	<At frame="60"><EditorKey key="Ctrl+P"/></At>
	<At frame="75"><EditorText value="pause.ui.xml"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="100"><WaitUntil probe="Editor.UIPreviewWidgetCount" atLeast="9" timeoutFrames="900"/></At>
	<At frame="105"><WaitUntil probe="Editor.UIPreviewTextureReady" equals="1" timeoutFrames="900"/></At>
	<At frame="110"><EditorClick mark="uipreview.widget.Window"/></At>
	<At frame="125">
		<Expect probe="Editor.UIPreviewSlotEditable" equals="1"/>
		<Expect probe="Editor.UIPreviewPaletteCount" atLeast="10"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="130"><EditorDrag mark="uipreview.handle.move" dx="40" dy="0"/></At>
	<At frame="160">
		<Expect probe="Editor.UIPreviewSelectedOffsetMinX" atLeast="20"/>
		<Expect probe="Editor.UIPreviewDirty" equals="1"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="165"><DevCommand line="editor edit.undo"/></At>
	<At frame="180"><Expect probe="Editor.UIPreviewSelectedOffsetMinX" near="0" tolerance="0.5"/></At>
	<At frame="185"><DevCommand line="editor edit.redo"/></At>
	<At frame="200"><Expect probe="Editor.UIPreviewSelectedOffsetMinX" atLeast="20"/></At>
	<At frame="205"><DevCommand line="editor edit.undo"/></At>
	<At frame="220"><Expect probe="Editor.UIPreviewSelectedOffsetMinX" near="0" tolerance="0.5"/></At>
	<!-- 2) 팔레트 · 끌어 놓기 · 지우기 -->
	<At frame="230"><EditorKey key="Ctrl+P"/></At>
	<At frame="245"><EditorText value="save_probe.ui.xml"/></At>
	<At frame="260"><EditorKey key="Enter"/></At>
	<At frame="270"><WaitUntil probe="Editor.UIPreviewWidgetCount" equals="1" timeoutFrames="900"/></At>
	<!-- 1) 에서 고치고 되돌린 문서는 되돌려도 고친 표시(dirty)가 남는다 — 다른 문서를 열면 버린다고 알리는 경고가 의도한 출력이다 -->
	<At frame="271"><ExpectLog id="UIPreview.UnsavedEditsDiscarded" atLeast="1"/></At>
	<At frame="280"><EditorClick mark="uipreview.palette.filter"/></At>
	<At frame="290"><EditorText value="TextWidget"/></At>
	<At frame="305"><EditorDrag mark="uipreview.palette.TextWidget" toMark="uipreview.row.0"/></At>
	<At frame="330"><WaitUntil probe="Editor.UIPreviewWidgetCount" equals="2" timeoutFrames="180"/></At>
	<At frame="335">
		<Expect probe="Editor.UIPreviewDirty" equals="1"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="340"><EditorClick mark="uipreview.delete"/></At>
	<At frame="355">
		<Expect probe="Editor.UIPreviewWidgetCount" equals="1"/>
		<Expect probe="Editor.UndoCount" equals="2"/>
	</At>
	<At frame="360"><DevCommand line="editor edit.undo"/></At>
	<At frame="375"><Expect probe="Editor.UIPreviewWidgetCount" equals="2"/></At>
	<At frame="380"><DevCommand line="editor edit.undo"/></At>
	<At frame="395"><Expect probe="Editor.UIPreviewWidgetCount" equals="1"/></At>
	<At frame="400"><DevCommand line="editor edit.redo"/></At>
	<At frame="415"><Expect probe="Editor.UIPreviewWidgetCount" equals="2"/></At>
	<At frame="420"><DevCommand line="editor edit.undo"/></At>
	<At frame="435"><Expect probe="Editor.UIPreviewWidgetCount" equals="1"/></At>
	<!-- 정리: 거름 칸을 비우고 문서 값을 되찾는다 -->
	<At frame="440"><EditorClick mark="uipreview.palette.filter"/></At>
	<At frame="450"><EditorKey key="Ctrl+A"/></At>
	<At frame="455"><EditorKey key="Backspace"/></At>
	<At frame="465"><EditorClick mark="uipreview.reload"/></At>
	<At frame="490">
		<Expect probe="Editor.UIPreviewDirty" equals="0"/>
	</At>
	<At frame="495"><DevCommand line="panel.close ui_preview"/></At>
	<At frame="500"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
