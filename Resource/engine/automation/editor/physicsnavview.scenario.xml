<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰의 물리 셰이프 시각화(Phys, physics_shapes)와 내비메시 시각화(Nav, navmesh), 그리고 navigation.bake 커맨드.
  TestMesh 에 RigidBodyComponent 를 붙이고(기본 셰이프는 상자) Phys 를 켜면 셰이프 선분이 그려진다(기본은 꺼짐이라 켜기 전엔 0).
  navigation.bake 는 편집 중인 씬을 베이크한다 — 이 시나리오의 씬에는 걸을 바닥이 없어 내비메시가 서지 않을 수 있으므로 커맨드가 돌았는지만 본다
  (바닥이 있는 씬에서 내비메시가 서는 것은 EditorTest 의 EditorNavigationCommandsTest 가 본다). Nav 를 켜도 베이크 전에는 선이 없다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/physicsnavview.scenario.xml -dx12
-->
<Scenario name="editor.physicsnavview" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><EditorClick mark="hierarchy.row.TestMesh"/></At>
	<At frame="65"><DevCommand line="component.add RigidBodyComponent"/></At>
	<At frame="85"><Expect probe="Editor.PhysicsShapeSegments" equals="0"/></At>
	<At frame="90"><EditorClick mark="viewport.visualizer.physics_shapes"/></At>
	<At frame="110"><Expect probe="Editor.PhysicsShapeSegments" atLeast="1"/></At>
	<At frame="115"><EditorClick mark="viewport.visualizer.navmesh"/></At>
	<At frame="130"><Expect probe="Editor.NavigationBakeCount" equals="0"/></At>
	<At frame="135"><DevCommand line="editor navigation.bake"/></At>
	<At frame="160"><Expect probe="Editor.NavigationBakeCount" equals="1"/></At>
	<At frame="170"><EditorClick mark="viewport.visualizer.physics_shapes"/></At>
	<At frame="190">
		<Variable name="gv_editorProbeVisualizer" value="physics_shapes"/>
	</At>
	<At frame="192"><Expect probe="Editor.VisualizerOn" equals="0"/></At>
	<At frame="200"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
