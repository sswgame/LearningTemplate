<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터 다중 선택 편집(I1): 시험 씬의 카메라 둘(GameCamera · TestGameCamera)을 Ctrl+클릭으로 함께 고르고
  공통 컴포넌트 CameraComponent 의 _priority 에 5 를 치면 둘 다 5 가 되고(합 10), Ctrl+Z 한 번에 둘 다 0 으로 돌아온다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/multiedit.scenario.xml -dx12
-->
<Scenario name="editor.multiedit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><EditorClick mark="hierarchy.row.GameCamera"/></At>
	<At frame="60"><EditorClick mark="hierarchy.row.TestGameCamera" mods="ctrl"/></At>
	<At frame="75">
		<Expect probe="Editor.SelectionCount" equals="2"/>
		<Variable name="gv_editorProbeProperty" value="CameraComponent._priority"/>
	</At>
	<At frame="80"><Expect probe="Editor.SelectedPropertySum" equals="0"/></At>
	<At frame="85"><EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/></At>
	<At frame="95"><EditorKey key="Ctrl+A"/></At>
	<At frame="100"><EditorText value="5"/></At>
	<At frame="105"><EditorKey key="Enter"/></At>
	<At frame="125">
		<Expect probe="Editor.SelectedPropertySum" equals="10"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="130"><DevCommand line="editor edit.undo"/></At>
	<At frame="145"><Expect probe="Editor.SelectedPropertySum" equals="0"/></At>
	<At frame="150"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
