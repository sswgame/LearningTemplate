<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터의 씬 오브젝트 참조 선택기(SceneObjectReference, 씬 파일을 넘는 오브젝트 참조). 에디터 테스트 컴포넌트 EditorSceneReferenceProbeComponent(_target)를
  오브젝트 Prober 에 달아 본다. 값은 탐침 Editor.SelectedSceneReference 가 `<씬 파일> / <오브젝트>` 로 읽는다.
  ① 컴포넌트를 달면 값이 (none) 이다. ② 콤보를 열어 올라와 있는 씬의 TestMesh 를 고르면 값이 바뀌고 되돌리기 하나가 쌓인다(고르는 순간 그 오브젝트에 파일 id 가 생긴다).
  ③ Ctrl+Z 로 비운다. ④ 다시 고른 뒤 `(none)` 을 고르면 비워진다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/scenereference.scenario.xml -dx12
-->
<Scenario name="editor.scenereference" fixedDelta="0.0166667" timeoutFrames="700" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="2300" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/><Variable name="gv_editorProbeProperty" value="EditorSceneReferenceProbeComponent._target"/></At>
	<At frame="15"><DevCommand line="panel.close prefab_editor"/></At>

	<!-- ① 오브젝트에 컴포넌트를 단다 -->
	<At frame="30"><EditorClick mark="hierarchy.create"/></At>
	<At frame="45"><EditorClick mark="inspector.name"/></At>
	<At frame="55"><EditorKey key="Ctrl+A"/></At>
	<At frame="60"><EditorText value="Prober"/></At>
	<At frame="65"><EditorKey key="Enter"/></At>
	<At frame="80"><DevCommand line="component.add EditorSceneReferenceProbeComponent"/></At>
	<At frame="100">
		<Expect probe="Editor.SelectedNames" is="Prober"/>
		<Expect probe="Editor.SelectedSceneReference" is="(none)"/>
		<Remember probe="Editor.UndoIndex" as="undoBefore"/>
		<CaptureEditorUI file="scenereference/inspector.png"/>
	</At>

	<!-- ② 콤보로 고른다 -->
	<At frame="110"><EditorClick mark="inspector.property.EditorSceneReferenceProbeComponent._target"/></At>
	<At frame="130"><CaptureEditorUI file="scenereference/combo.png"/></At>
	<At frame="140"><EditorHover mark="inspector.sceneref.choice.TestMesh"/></At>
	<At frame="150"><EditorClick mark="inspector.sceneref.choice.TestMesh"/></At>
	<At frame="170">
		<Expect probe="Editor.SelectedSceneReference" is="editortest.scene.xml / TestMesh"/>
		<Expect probe="Editor.UndoIndex" differsFrom="undoBefore"/>
		<CaptureEditorUI file="scenereference/picked.png"/>
	</At>

	<!-- ③ 되돌리기 -->
	<At frame="180"><EditorKey key="Ctrl+Z"/></At>
	<At frame="200">
		<Expect probe="Editor.SelectedSceneReference" is="(none)"/>
		<Expect probe="Editor.UndoIndex" sameAs="undoBefore"/>
	</At>

	<!-- ④ 다시 고르고 (none) -->
	<At frame="210"><EditorClick mark="inspector.property.EditorSceneReferenceProbeComponent._target"/></At>
	<At frame="230"><EditorHover mark="inspector.sceneref.choice.TestMesh"/></At>
	<At frame="240"><EditorClick mark="inspector.sceneref.choice.TestMesh"/></At>
	<At frame="260"><Expect probe="Editor.SelectedSceneReference" is="editortest.scene.xml / TestMesh"/></At>
	<At frame="270"><EditorClick mark="inspector.property.EditorSceneReferenceProbeComponent._target"/></At>
	<At frame="290"><EditorHover mark="inspector.sceneref.none"/></At>
	<At frame="300"><EditorClick mark="inspector.sceneref.none"/></At>
	<At frame="320"><Expect probe="Editor.SelectedSceneReference" is="(none)"/></At>
	<At frame="330"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
