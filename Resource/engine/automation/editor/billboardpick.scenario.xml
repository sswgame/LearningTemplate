<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 뷰포트 빌보드와 클릭 선택(R4): 시험 씬(editortest)의 게임 카메라는 메시가 없어 레이 피킹으로 집히지 않는다. 뷰포트에 그 아이콘 배지
  (이름표 viewport.billboard.GameCamera)가 보이고, 누르면 그 카메라 오브젝트가 골라진다(선택 하나 · 그 선택에 카메라 우선순위 프로퍼티가 있다).
  툴바의 Icons(billboard) 체크박스로 끄고 켤 수 있다(끄면 그리기와 클릭 선택이 함께 꺼진다).
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/billboardpick.scenario.xml -dx12
-->
<Scenario name="editor.billboardpick" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="60">
		<Variable name="gv_editorProbeProperty" value="CameraComponent._priority"/>
		<Variable name="gv_editorProbeVisualizer" value="billboard"/>
		<Expect probe="Editor.VisualizerOn" equals="1"/>
		<Expect probe="Editor.SelectionCount" equals="0"/>
	</At>
	<At frame="65"><EditorClick mark="viewport.billboard.GameCamera"/></At>
	<At frame="85">
		<Expect probe="Editor.SelectionCount" equals="1"/>
		<Expect probe="Editor.SelectedProperty" equals="0"/>
		<Expect probe="Editor.SelectedIsEditorCamera" equals="0"/>
	</At>
	<At frame="90"><EditorClick mark="viewport.visualizer.billboard"/></At>
	<At frame="105"><Expect probe="Editor.VisualizerOn" equals="0"/></At>
	<At frame="130"><EditorClick mark="viewport.visualizer.billboard"/></At>
	<At frame="140"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
