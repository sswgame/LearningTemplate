<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 체인 사이의 키트 리로드 — 편집 중에 GF_Chat 을 다시 올려 (서버 전용 `GF_Server_Chat` · 키트에 의존하는 SWGame 까지 한 번에 도는 의존 사슬), 에디터가 멀쩡한지 본다: 그래프가 막히지 않았고, 의존 모듈이 지금 이미지에 묶였고, 씬 · 도크가 그대로다.
  `engine/automation/editor/*.scenario.xml` 을 한 프로세스로 묶을 때 시나리오 사이에 끼운다(실제 개발 중 리로드와 같은 조건). 혼자 돌려도 통과한다.
  실행: App.exe -EnableEditor -scenario=engine/automation/editor/chain/reloadkit.scenario.xml -dx12
-->
<Scenario name="editor.chainreloadkit" fixedDelta="0.0166667" timeoutFrames="9000" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="module.reload GF_Chat"/></At>
	<At frame="1"><WaitUntil probe="Module.ReloadPending" equals="0" timeoutFrames="6000"/></At>
	<At frame="60">
		<Expect probe="Module.GraphBroken" equals="0"/>
		<Expect probe="Module.BindingsOk" equals="1"/>
		<Expect probe="Editor.ObjectCount" atLeast="1"/>
		<EditorExpectDockLayout/>
		<ExpectLog contains="Manual Live Reload queued for GF_Chat" atLeast="1"/>
		<Pass/>
	</At>
</Scenario>
