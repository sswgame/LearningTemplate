<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 대화 그래프 패널 ↔ 저장 배선(D3-5): 임시 에셋을 새 문서로 열고(asset.open), 툴바 "+ Dialogue" 로 고쳐 더러워진 것을
  (탐침 Editor.DirtyDocumentCount) 툴바 Save 와 저장 커맨드(asset.save — Ctrl+S 와 같은 길) 두 길로 저장한다. 저장하면 파일이 생기고
  (Editor.TempAssetExists) 더러움이 걷힌다.
  문서: Saved/Automation/editor.dialoguegraphsave/temp.dialogue.xml — 작업 폴더 아래 임시 경로라 저장소 리소스를 바꾸지 않는다
  (asset.open 은 Saved/Automation/ 밖과 리소스 트리를 거절한다). 끝에서 asset.removeTemp 로 지운다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/dialoguegraphsave.scenario.xml -dx12
-->
<Scenario name="editor.dialoguegraphsave" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40"><DevCommand line="asset.open Saved/Automation/editor.dialoguegraphsave/temp.dialogue.xml"/></At>
	<At frame="45"><DevCommand line="panel.focus dialogue_graph"/></At>
	<At frame="80"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="0"/></At>
	<At frame="85"><EditorClick mark="dialogueGraph.add.Dialogue"/></At>
	<At frame="105"><Expect probe="Editor.DirtyDocumentCount" equals="1"/></At>
	<At frame="110"><EditorClick mark="dialogueGraph.save"/></At>
	<At frame="130"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="1"/></At>
	<At frame="135"><DevCommand line="asset.removeTemp Saved/Automation/editor.dialoguegraphsave/temp.dialogue.xml"/></At>
	<At frame="140"><Expect probe="Editor.TempAssetExists" equals="0"/></At>
	<At frame="145"><EditorClick mark="dialogueGraph.add.End"/></At>
	<At frame="165"><Expect probe="Editor.DirtyDocumentCount" equals="1"/></At>
	<At frame="170"><DevCommand line="panel.focus dialogue_graph"/></At>
	<At frame="190"><DevCommand line="editor asset.save"/></At>
	<At frame="210"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="1"/></At>
	<At frame="215"><DevCommand line="asset.removeTemp Saved/Automation/editor.dialoguegraphsave/temp.dialogue.xml"/></At>
	<At frame="220"><Expect probe="Editor.TempAssetExists" equals="0"/></At>
	<At frame="225"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
