<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 오디오 그래프 패널(audiograph): 패널을 열면 그려지고(에디터 UI 캡처에 마젠타 자리표시가 없다) 닫으면 닫힌다. 패널을 열고 닫는 길만 본다 —
  그래프 편집(노드 더하기 · 연결)은 EditorTest 의 AudioGraph 모델 테스트가 본다.
  연 뒤 그려지는 것은 조건 대기(Editor.PanelOpen)로 기다린다. 이 패널은 열기만 해서는 로그를 남기지 않는다.
  실행: py -3 -m Scripts scenario audiographpanel
-->
<Scenario name="editor.audiographpanel" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="0">
		<ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/>
		<Variable name="gv_editorProbePanel" value="audiograph"/>
	</At>
	<At frame="1"><DevCommand line="panel.focus audiograph"/></At>
	<At after="1"><WaitUntil probe="Editor.PanelOpen" equals="1" timeoutSeconds="10"/></At>
	<!-- 눈 확인용(GPU 검증): 열린 오디오 그래프 패널 -->
	<At after="1"><CaptureEditorUI file="audiographpanel/open.png" maxMagentaFraction="0"/></At>
	<At after="1"><DevCommand line="panel.close audiograph"/></At>
	<At after="1"><WaitUntil probe="Editor.PanelOpen" equals="0" timeoutSeconds="10"/></At>
	<At after="1"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
