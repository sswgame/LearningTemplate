<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 단축키 편집기(P3): Undo 줄의 Set 을 누르고 Ctrl+U 를 보내면 Undo 가 Ctrl+U 가 된다. 오브젝트를 만들고 Ctrl+U 로 되돌린다.
  Redo 에 같은 Ctrl+U 를 받으면 충돌을 묻는다(Cancel). 끝에 Reset All 로 덮어쓰기를 지운다. 저장 파일은 빈 상태 폴더의 Shortcuts.json 이다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/shortcuts.scenario.xml -dx12
-->
<Scenario name="editor.shortcuts" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="40"><DevCommand line="panel.focus shortcuts"/></At>
	<At frame="70"><EditorClick mark="shortcuts.set.edit.undo"/></At>
	<At frame="85"><EditorKey key="Ctrl+U"/></At>
	<At frame="100"><Expect probe="Editor.ShortcutOverrideCount" equals="1"/></At>
	<At frame="105"><DevCommand line="panel.focus hierarchy"/></At>
	<At frame="125"><EditorClick mark="hierarchy.create"/></At>
	<At frame="140"><Expect probe="Editor.UndoIndex" equals="1"/></At>
	<At frame="145"><EditorKey key="Ctrl+U"/></At>
	<At frame="160"><Expect probe="Editor.UndoIndex" equals="0"/></At>
	<At frame="165"><DevCommand line="panel.focus shortcuts"/></At>
	<At frame="190"><EditorClick mark="shortcuts.set.edit.redo"/></At>
	<At frame="205"><EditorKey key="Ctrl+U"/></At>
	<At frame="220"><Expect probe="Editor.ShortcutConflictCount" equals="1"/></At>
	<At frame="225"><EditorClick mark="shortcuts.cancel"/></At>
	<At frame="245">
		<Expect probe="Editor.ShortcutConflictCount" equals="0"/>
		<Expect probe="Editor.ShortcutOverrideCount" equals="1"/>
	</At>
	<At frame="250"><EditorClick mark="shortcuts.resetAll"/></At>
	<At frame="270"><Expect probe="Editor.ShortcutOverrideCount" equals="0"/></At>
	<At frame="280"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
