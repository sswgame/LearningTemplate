<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 맵 검사(T2): 반경 0 인 점광이 든 시험 씬(engine/automation/editor/mapcheck/mapcheck.scene.xml)을 열면 로드 검증이 오류 하나를 남긴다.
  상태줄의 경고 수(statusBar.mapCheck)를 누르면 Map Check 창이 열리고, 첫 줄(mapCheck.row.0 — 오류가 먼저다)을 누르면 그 점광 오브젝트가 골라진다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/mapcheck.scenario.xml -dx12
-->
<Scenario name="editor.mapcheck" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="20">
		<RequireForeground/><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/>
		<Variable name="gv_editorProbePanel" value="map_check"/>
	</At>
	<At frame="30"><DevCommand line="scene.open engine/automation/editor/mapcheck/mapcheck.scene.xml"/></At>
	<At frame="150">
		<EditorExpectObject name="ZeroRadiusLight"/>
		<Expect probe="Editor.PanelOpen" equals="0"/>
		<ExpectLog contains="Radius is 0" atLeast="1"/>
	</At>
	<!-- 단추는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<At frame="155"><EditorClick mark="statusBar.mapCheck" state="down"/></At>
	<At frame="158"><EditorClick mark="statusBar.mapCheck" state="up"/></At>
	<At frame="180"><Expect probe="Editor.PanelOpen" equals="1"/></At>
	<At frame="185"><EditorClick mark="mapCheck.row.0" state="down"/></At>
	<At frame="188"><EditorClick mark="mapCheck.row.0" state="up"/></At>
	<At frame="205">
		<Expect probe="Editor.SelectionCount" equals="1"/>
		<EditorExpectObject name="ZeroRadiusLight" selected="1"/>
		<CaptureWindow file="mapcheck.png"/>
	</At>
	<At frame="215"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
