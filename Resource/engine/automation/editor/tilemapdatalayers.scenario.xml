<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 타일맵 데이터 레이어(TilemapCellDataLayers T3): 새 맵에 데이터 레이어 "Cost"(기본값 0)를 더하고, 값 7 로 칸 하나를 칠한 뒤 임시 경로에 저장한다.
  저장 뒤 같은 칸을 지워(Erase) 메모리에서 0 칸으로 만들고 Load 로 파일을 다시 읽으면 레이어(1)와 칠한 칸(1)이 돌아와 있어야 한다 — 저장 왕복.
  탐침: Editor.TileMapDataLayers(레이어 수) · Editor.TileMapDataCells(모든 데이터 레이어에서 기본값과 다른 칸 수).
  문서: Saved/Automation/editor.tilemapdatalayers/temp.tilemap.xml — 끝에서 asset.removeTemp 로 지운다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/tilemapdatalayers.scenario.xml -dx12
-->
<Scenario name="editor.tilemapdatalayers" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="45"><DevCommand line="panel.focus tile_map"/></At>
	<At frame="70"><Expect probe="Editor.TileMapDataLayers" equals="0"/><Expect probe="Editor.TileMapDataCells" equals="0"/></At>

	<!-- 레이어 더하기 -->
	<At frame="75"><EditorClick mark="tileMap.dataLayer.name"/></At>
	<At frame="85"><EditorText value="Cost"/></At>
	<At frame="95"><EditorClick mark="tileMap.dataLayer.add"/></At>
	<At frame="110"><Expect probe="Editor.TileMapDataLayers" equals="1"/><Expect probe="Editor.TileMapDataCells" equals="0"/></At>

	<!-- 값 7 로 왼쪽 위 칸 하나 칠하기 -->
	<At frame="115"><EditorClick mark="tileMap.dataLayer.value"/></At>
	<At frame="120"><EditorKey key="Ctrl+A"/></At>
	<At frame="125"><EditorText value="7"/></At>
	<At frame="135"><EditorClick mark="tileMap.tool.brush"/></At>
	<At frame="145"><EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/></At>
	<At frame="160"><Expect probe="Editor.TileMapDataCells" equals="1"/></At>

	<!-- 저장 -->
	<At frame="165"><EditorClick mark="tileMap.path"/></At>
	<At frame="170"><EditorKey key="Ctrl+A"/></At>
	<At frame="175"><EditorText value="Saved/Automation/editor.tilemapdatalayers/temp.tilemap.xml"/></At>
	<At frame="185"><EditorClick mark="tileMap.save"/></At>

	<!-- 메모리에서만 지우기 → 다시 읽기 -->
	<At frame="200"><EditorClick mark="tileMap.erase"/></At>
	<At frame="210"><EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/></At>
	<At frame="225"><Expect probe="Editor.TileMapDataCells" equals="0"/></At>
	<At frame="230"><EditorClick mark="tileMap.erase"/></At>
	<At frame="240"><EditorClick mark="tileMap.load"/></At>
	<At frame="260"><Expect probe="Editor.TileMapDataLayers" equals="1"/><Expect probe="Editor.TileMapDataCells" equals="1"/></At>
	<At frame="265"><DevCommand line="asset.removeTemp Saved/Automation/editor.tilemapdatalayers/temp.tilemap.xml"/></At>
	<At frame="270"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
