<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터(EditorPropertyGrid)로 컴포넌트 값을 고치면 Undo 에 하나 쌓이고, Ctrl+Z 로 값이 돌아온다.
  시험 씬의 GameCamera 를 Hierarchy 에서 고르고 CameraComponent 의 _priority 칸(이름표 inspector.property.CameraComponent._priority)에 7 을 친다(드래그 칸은 Ctrl+클릭이 글 입력이다).
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/inspectoredit.scenario.xml -dx12
-->
<Scenario name="editor.inspectoredit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50">
		<EditorClick mark="hierarchy.row.GameCamera"/>
		<Variable name="gv_editorProbeProperty" value="CameraComponent._priority"/>
	</At>
	<At frame="70">
		<Expect probe="Editor.SelectedProperty" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="75"><EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/></At>
	<At frame="85"><EditorKey key="Ctrl+A"/></At>
	<At frame="90"><EditorText value="7"/></At>
	<At frame="95"><EditorKey key="Enter"/></At>
	<At frame="115">
		<Expect probe="Editor.SelectedProperty" equals="7"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="120"><DevCommand line="editor edit.undo"/></At>
	<At frame="135"><Expect probe="Editor.SelectedProperty" equals="0"/></At>
	<At frame="140"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
