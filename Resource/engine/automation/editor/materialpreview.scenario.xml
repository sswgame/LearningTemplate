<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 머티리얼 미리보기(N10): Quick Open 으로 빨간 테스트 머티리얼을 열면 Material 패널의 구 미리보기 평균 (R - B) 가 크게 양수이고,
  파란 테스트 머티리얼로 바꾸면 크게 음수다 — 미리보기가 머티리얼 색을 따른다. 테스트 머티리얼은 materialpreview/ 폴더에 있다.
  미리보기는 렌더 타깃이 아니라 패널이 머티리얼 값으로 CPU 에서 셰이딩해 ImGui 그리기 목록에 그린다(MaterialPreviewShading) — 그래서 "값이 안 따라온다" 의 가능한 까닭은 둘이다.
  (1) 문서가 바뀌지 않았다(Quick Open 의 Enter 가 목록 도착 전에 눌렸거나, 미저장 확인이 새 문서를 막았다) (2) 문서는 바뀌었는데 미리보기 계산이 따라오지 않았다.
  두 까닭을 시나리오가 나눠 보도록 문서 교체를 먼저 기다린다(Editor.MaterialDocumentIsProbeAsset) — 졌을 때 어느 쪽인지 보고서의 실패 줄이 말한다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/materialpreview.scenario.xml -dx12 (-opengl 도 같다)
-->
<Scenario name="editor.materialpreview" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="30"><Variable name="gv_editorProbeAsset" value="engine/automation/editor/materialpreview/previewred.material"/></At>
	<At frame="60"><EditorKey key="Ctrl+P"/></At>
	<At frame="75"><EditorText value="previewred.material"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="95"><WaitUntil probe="Editor.MaterialDocumentIsProbeAsset" equals="1" timeoutFrames="600"/></At>
	<At frame="98"><Expect probe="Editor.MaterialSwitchPending" equals="0"/></At>
	<At frame="100"><WaitUntil probe="Editor.MaterialPreviewRedMinusBlue" atLeast="40"/></At>
	<At frame="108"><Variable name="gv_editorProbeAsset" value="engine/automation/editor/materialpreview/previewblue.material"/></At>
	<At frame="110"><EditorKey key="Ctrl+P"/></At>
	<At frame="125"><EditorText value="previewblue.material"/></At>
	<At frame="140"><EditorKey key="Enter"/></At>
	<At frame="145"><WaitUntil probe="Editor.MaterialDocumentIsProbeAsset" equals="1" timeoutFrames="600"/></At>
	<At frame="148"><Expect probe="Editor.MaterialSwitchPending" equals="0"/></At>
	<At frame="150"><WaitUntil probe="Editor.MaterialPreviewRedMinusBlue" atMost="-40"/></At>
	<At frame="160"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
