<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 리타깃 프로필 창(AnimationAdvancedFeatures A4): 새 프로필(없는 경로의 빈 문서) · 기존 프로필 열기 · 3D 미리보기(두 스켈레톤 겹침) · 리타깃 포즈 줄 더하기.
  새 프로필: 경로 칸에 없는 리소스 id 를 적고 New 를 누르면 빈 문서로 열린다(사슬 0). 저장은 스켈레톤 · 뿌리와 골반이 묶이기 전에는 막힌다(저장하지 않고 닫는다).
  기존 프로필: knight_to_minion 을 열면 사슬이 채워지고, 미리보기가 두 스켈레톤을 선으로 긋는다(탐침 Editor.RetargetPreviewSegments). 대상 본 upperarm.l 을 더하면 리타깃 포즈 줄이 하나가 되고
  미리보기의 대상(주황)과 레퍼런스(회색)가 갈린다 — 눈으로 볼 사진을 찍는다.
  실행: py -3 -m Scripts scenario retarget
-->
<Scenario name="editor.retarget" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="10"><DevCommand line="layout.reset"/></At>
	<At frame="20"><ResizeWindow width="1900" height="1100"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="60"><EditorKey key="Ctrl+Shift+P"/></At>
	<At frame="75"><EditorText value="Retarget Profile"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="105"><DevCommand line="panel.focus charactereditor.retarget"/></At>
	<!-- 새 프로필: 없는 경로 → 빈 문서 -->
	<At frame="130"><EditorClick mark="retarget.newPath"/></At>
	<At frame="140"><EditorText value="editor/automationtemp/scenario_new.retarget.xml"/></At>
	<At frame="155"><EditorClick mark="retarget.new"/></At>
	<At frame="200">
		<Expect probe="Editor.RetargetChainCount" equals="0"/>
		<CaptureEditorUI file="retarget/new.png"/>
	</At>
	<!-- 기존 프로필 열기 -->
	<At frame="210"><EditorClick mark="retarget.open"/></At>
	<At frame="225"><EditorClick mark="retarget.open.knight_to_minion.retarget.xml"/></At>
	<At frame="290">
		<Expect probe="Editor.RetargetChainCount" atLeast="6"/>
		<Expect probe="Editor.RetargetPoseCount" equals="0"/>
		<Expect probe="Editor.RetargetPreviewSegments" atLeast="20"/>
		<CaptureEditorUI file="retarget/opened.png"/>
	</At>
	<!-- 리타깃 포즈 줄 더하기: 대상 스켈레톤에 있는 본만 받는다 -->
	<!-- 미리보기와 사슬 목록이 길어 아래 칸이 창의 보이는 영역 밖으로 밀린다 — 미리보기만 남기고 위 구역을 접어 닿게 한다 -->
	<At frame="295"><EditorClick mark="retarget.section.Skeletons"/></At>
	<At frame="300"><EditorClick mark="retarget.section.Root and pelvis"/></At>
	<At frame="305"><EditorClick mark="retarget.section.Options"/></At>
	<At frame="310"><EditorClick mark="retarget.section.Chains"/></At>
	<At frame="320"><EditorClick mark="retarget.targetPose.newBone"/></At>
	<At frame="330"><EditorText value="upperarm.l"/></At>
	<At frame="345"><EditorClick mark="retarget.targetPose.add"/></At>
	<At frame="370">
		<Expect probe="Editor.RetargetPoseCount" equals="1"/>
		<Expect probe="Editor.RetargetPreviewSegments" atLeast="20"/>
		<CaptureEditorUI file="retarget/targetpose.png"/>
	</At>
	<At frame="400"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
