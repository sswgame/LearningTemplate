<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — GM 도구 확장(GF_EditorPlugIn_Admin): 서버 없이 메모리 제공자로 조회 · 지급 · 회수 · 제재 · 감사 열람이 돈다.
  팔레트로 커맨드(admin.openToolPanel)를 실행해 GM Tool 패널을 열고, 계정을 조회한다. 메모 없는 지급은 거절되고(InvalidRequest), 메모를 적으면 들어가며 잔액을 다시 조회한다.
  잔액보다 큰 회수는 거절되고(InsufficientFunds), 제재와 감사 열람은 성공한다. 명령 결과는 패널이 남기는 로그 줄 "Admin command <명령>: <결과>" 로 센다.
  실행: py -3 -m Scripts scenario admintool
-->
<Scenario name="editor.admintool" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40">
		<Variable name="gv_editorProbePanel" value="admin.tool"/>
	</At>
	<At frame="45"><Expect probe="Editor.PanelOpen" equals="0"/></At>
	<At frame="60"><EditorKey key="Ctrl+Shift+P"/></At>
	<At frame="75"><EditorText value="Open the GM"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="110">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<ExpectLog contains="GM Tool panel opened" count="1"/>
	</At>
	<At frame="115"><DevCommand line="panel.focus admin.tool"/></At>
	<At frame="135"><EditorClick mark="admin.lookup"/></At>
	<At frame="150"><ExpectLog contains="Admin command LookupAccount: Ok" count="1"/></At>
	<!-- 메모 없는 지급은 거절된다 -->
	<At frame="160"><EditorClick mark="admin.grant"/></At>
	<At frame="175"><ExpectLog contains="Admin command AdjustAsset: InvalidRequest" count="1"/></At>
	<!-- 메모를 적으면 들어가고, 성공한 뒤 같은 계정을 다시 조회한다 -->
	<At frame="180"><EditorClick mark="admin.memo"/></At>
	<At frame="190"><EditorKey key="Ctrl+A"/></At>
	<At frame="195"><EditorText value="ticket-42"/></At>
	<At frame="210"><EditorClick mark="admin.grant"/></At>
	<At frame="225">
		<ExpectLog contains="Admin command AdjustAsset: Ok" count="1"/>
		<ExpectLog contains="Admin command LookupAccount: Ok" count="2"/>
	</At>
	<!-- 잔액(200)보다 큰 회수는 거절된다 -->
	<At frame="230"><EditorClick mark="admin.amount"/></At>
	<At frame="240"><EditorKey key="Ctrl+A"/></At>
	<At frame="245"><EditorText value="1000"/></At>
	<At frame="260"><EditorClick mark="admin.revoke"/></At>
	<At frame="275"><ExpectLog contains="Admin command AdjustAsset: InsufficientFunds" count="1"/></At>
	<At frame="285"><EditorClick mark="admin.sanction.apply"/></At>
	<At frame="300"><ExpectLog contains="Admin command SetSanction: Ok" count="1"/></At>
	<At frame="310"><EditorClick mark="admin.audit.list"/></At>
	<At frame="325"><ExpectLog contains="Admin command ListAudit: Ok" count="1"/></At>
	<At frame="335"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
