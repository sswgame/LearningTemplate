<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 중첩 프리팹. 안쪽 프리팹에 적용한 값이 바깥 프리팹이 스폰한 부품에도 퍼진다(유니티 중첩 프리팹 · 언리얼 차일드 액터).
  ① Lamp(점광)를 만들어 임시 프리팹 lamp 로 만든다. ② Post 를 만들고 Lamp 를 그 아래로 끌어 놓은 뒤 Post 를 프리팹 post 로 만든다 —
     자식 프리팹 인스턴스 Lamp 는 post 의 중첩 프리팹 부품이 된다(prefab.create → adoptChildPrefabInstances).
  ③ lamp 를 하나 더 스폰해 LampTop 으로 이름을 바꾸고 반경을 7 로 고쳐 Apply Overrides 한다.
  ④ Post 아래의 부품 Lamp 도 반경 7 이 된다(PrefabInstanceRegistry 의 부품도 같은 프리팹의 인스턴스다). 되돌리기 한 번이면 원래 값으로 돌아온다.
  ⑤ 씬을 저장하고 새 씬 → 다시 열기 — 부품은 씬에 엔티티로 저장되지 않고 Post 가 새 lamp 로 다시 스폰한다(Lamp 는 하나, 반경 7).
  실행: py -3 -m Scripts scenario flowprefabnested
-->
<Scenario name="editor.flowprefabnested" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/></At>

	<!-- ① 안쪽 프리팹 lamp -->
	<At frame="30"><EditorClick mark="hierarchy.create"/></At>
	<At frame="45"><EditorClick mark="inspector.name"/></At>
	<At frame="55"><EditorKey key="Ctrl+A"/></At>
	<At frame="60"><EditorText value="Lamp"/></At>
	<At frame="65"><EditorKey key="Enter"/></At>
	<At frame="80"><DevCommand line="component.add PointLightComponent"/></At>
	<At frame="95"><DevCommand line="prefab.create Saved/Automation/editor.flowprefabnested/lamp.prefab.xml"/></At>
	<At frame="110">
		<EditorExpectObject name="Lamp" component="PointLightComponent" selected="1"/>
		<Remember probe="Object.Property" target="Lamp" key="PointLightComponent._radius" as="templateRadius"/>
	</At>

	<!-- ② 바깥 프리팹 post — Lamp 를 자식으로 둔다 -->
	<At frame="120"><EditorClick mark="hierarchy.create"/></At>
	<At frame="135"><EditorClick mark="inspector.name"/></At>
	<At frame="145"><EditorKey key="Ctrl+A"/></At>
	<At frame="150"><EditorText value="Post"/></At>
	<At frame="155"><EditorKey key="Enter"/></At>
	<At frame="170"><EditorDrag mark="hierarchy.row.Lamp" toMark="hierarchy.row.Post"/></At>
	<At frame="200"><EditorClick mark="hierarchy.row.Post"/></At>
	<At frame="215">
		<Expect probe="Editor.SelectedNames" is="Post"/>
		<DevCommand line="prefab.create Saved/Automation/editor.flowprefabnested/post.prefab.xml"/>
	</At>
	<At frame="225"><ExpectLog contains="took 1 child prefab instance(s) as nested prefabs" count="1"/></At>

	<!-- ③ 둘째 lamp 를 고쳐 프리팹에 쓴다 -->
	<At frame="235"><DevCommand line="prefab.spawn Saved/Automation/editor.flowprefabnested/lamp.prefab.xml"/></At>
	<At frame="250"><EditorClick mark="inspector.name"/></At>
	<At frame="260"><EditorKey key="Ctrl+A"/></At>
	<At frame="265"><EditorText value="LampTop"/></At>
	<At frame="270"><EditorKey key="Enter"/></At>
	<At frame="285"><EditorClick mark="inspector.property.PointLightComponent._radius" mods="ctrl"/></At>
	<At frame="295"><EditorKey key="Ctrl+A"/></At>
	<At frame="300"><EditorText value="7"/></At>
	<At frame="305"><EditorKey key="Enter"/></At>
	<At frame="320">
		<Expect probe="Editor.SelectedNames" is="LampTop"/>
		<Expect probe="Object.Property" target="LampTop" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Object.Property" target="Lamp" key="PointLightComponent._radius" sameAs="templateRadius"/>
		<Remember probe="Editor.UndoIndex" as="beforeApply"/>
		<DevCommand line="editor prefab.applyOverrides"/>
	</At>

	<!-- ④ 부품에 퍼짐 · 되돌리기 -->
	<At frame="335">
		<Expect probe="Object.Property" target="Lamp" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Editor.UndoIndex" differsFrom="beforeApply"/>
		<ExpectLog contains="Updated 1 other instance(s) of" count="1"/>
	</At>
	<At frame="340"><DevCommand line="editor edit.undo"/></At>
	<At frame="355"><Expect probe="Object.Property" target="Lamp" key="PointLightComponent._radius" sameAs="templateRadius"/></At>
	<At frame="360"><DevCommand line="editor edit.redo"/></At>
	<At frame="375"><Expect probe="Object.Property" target="Lamp" key="PointLightComponent._radius" equals="7"/></At>

	<!-- ⑤ 저장 → 새 씬 → 다시 열기 -->
	<At frame="385"><DevCommand line="scene.saveAs Saved/Automation/editor.flowprefabnested/flowprefabnested.scene.xml"/></At>
	<At frame="400"><DevCommand line="editor scene.new"/></At>
	<At frame="415"><EditorExpectObject name="Lamp" count="0"/></At>
	<At frame="420"><DevCommand line="scene.open Saved/Automation/editor.flowprefabnested/flowprefabnested.scene.xml"/></At>
	<At frame="421"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="445">
		<EditorExpectObject name="Lamp" count="1"/>
		<Expect probe="Object.Property" target="Lamp" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Object.Property" target="LampTop" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
	</At>
	<At frame="450"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
