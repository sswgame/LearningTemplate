<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 프리팹 편집이 씬의 다른 인스턴스에 퍼진다(유니티 Apply Overrides · 언리얼 블루프린트 컴파일 뒤 레벨 인스턴스 갱신).
  ① 오브젝트를 만들고(Hierarchy "+ Create") 이름 · 점광을 달아 임시 프리팹(Saved/Automation)으로 만든다(prefab.create — 그 오브젝트가 첫 인스턴스가 된다).
  ② 같은 프리팹을 하나 더 스폰해 이름을 LanternB 로 바꾸고, 인스펙터로 세기(_intensity)를 3 으로 덮어쓴다(인스턴스 덮어쓰기).
  ③ 첫 인스턴스의 반경(_radius)을 인스펙터로 7 로 고치고 Apply Overrides(prefab.applyOverrides)로 프리팹에 쓴다.
  ④ LanternB 의 반경이 7 이 되고(퍼짐) 세기는 3 으로 남아야 한다(덮어쓴 값 유지). 되돌리기 한 번이면 LanternB 가 퍼지기 전 값으로 돌아온다.
  ⑤ 씬을 저장하고 새 씬 → 다시 열기 뒤에도 두 인스턴스의 값이 그대로다(씬은 덮어쓴 값만 저장하고 프리팹 원형에 얹는다).
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/flowprefab.scenario.xml -dx12
-->
<Scenario name="editor.flowprefab" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/></At>

	<!-- ① 만들기 → 이름 → 점광 → 프리팹 -->
	<At frame="30"><EditorClick mark="hierarchy.create"/></At>
	<At frame="45"><EditorClick mark="inspector.name"/></At>
	<At frame="55"><EditorKey key="Ctrl+A"/></At>
	<At frame="60"><EditorText value="Lantern"/></At>
	<At frame="65"><EditorKey key="Enter"/></At>
	<At frame="80"><DevCommand line="component.add PointLightComponent"/></At>
	<At frame="95"><DevCommand line="prefab.create Saved/Automation/editor.flowprefab/lantern.prefab.xml"/></At>
	<At frame="110">
		<EditorExpectObject name="Lantern" component="PointLightComponent" selected="1"/>
		<Remember probe="Object.Property" target="Lantern" key="PointLightComponent._radius" as="templateRadius"/>
	</At>

	<!-- ② 둘째 인스턴스 — 이름을 바꾸고 세기를 덮어쓴다 -->
	<At frame="120"><DevCommand line="prefab.spawn Saved/Automation/editor.flowprefab/lantern.prefab.xml"/></At>
	<At frame="135"><EditorClick mark="inspector.name"/></At>
	<At frame="145"><EditorKey key="Ctrl+A"/></At>
	<At frame="150"><EditorText value="LanternB"/></At>
	<At frame="155"><EditorKey key="Enter"/></At>
	<At frame="170"><EditorClick mark="inspector.property.PointLightComponent._intensity" mods="ctrl"/></At>
	<At frame="180"><EditorKey key="Ctrl+A"/></At>
	<At frame="185"><EditorText value="3"/></At>
	<At frame="190"><EditorKey key="Enter"/></At>
	<At frame="205">
		<Expect probe="Editor.SelectedNames" is="LanternB"/>
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._intensity" equals="3"/>
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._radius" sameAs="templateRadius"/>
	</At>

	<!-- ③ 첫 인스턴스의 반경을 고쳐 프리팹에 쓴다 -->
	<At frame="215"><EditorClick mark="hierarchy.row.Lantern"/></At>
	<At frame="230"><EditorClick mark="inspector.property.PointLightComponent._radius" mods="ctrl"/></At>
	<At frame="240"><EditorKey key="Ctrl+A"/></At>
	<At frame="245"><EditorText value="7"/></At>
	<At frame="250"><EditorKey key="Enter"/></At>
	<At frame="265">
		<Expect probe="Editor.SelectedNames" is="Lantern"/>
		<Expect probe="Object.Property" target="Lantern" key="PointLightComponent._radius" equals="7"/>
		<Remember probe="Editor.UndoIndex" as="beforeApply"/>
		<DevCommand line="editor prefab.applyOverrides"/>
	</At>

	<!-- ④ 퍼짐 · 덮어쓴 값 유지 · 되돌리기 -->
	<At frame="280">
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._intensity" equals="3"/>
		<Expect probe="Object.Property" target="Lantern" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Editor.UndoIndex" differsFrom="beforeApply"/>
		<ExpectLog contains="Saved prefab changes to" count="1"/>
	</At>
	<At frame="285"><DevCommand line="editor edit.undo"/></At>
	<At frame="300">
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._radius" sameAs="templateRadius"/>
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._intensity" equals="3"/>
		<Expect probe="Editor.UndoIndex" sameAs="beforeApply"/>
	</At>
	<At frame="305"><DevCommand line="editor edit.redo"/></At>
	<At frame="320"><Expect probe="Object.Property" target="LanternB" key="PointLightComponent._radius" equals="7"/></At>

	<!-- ⑤ 저장 → 새 씬 → 다시 열기 -->
	<At frame="330"><DevCommand line="scene.saveAs Saved/Automation/editor.flowprefab/flowprefab.scene.xml"/></At>
	<At frame="345"><DevCommand line="editor scene.new"/></At>
	<At frame="360"><EditorExpectObject name="LanternB" count="0"/></At>
	<At frame="365"><DevCommand line="scene.open Saved/Automation/editor.flowprefab/flowprefab.scene.xml"/></At>
	<At frame="366"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="390">
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Object.Property" target="LanternB" key="PointLightComponent._intensity" equals="3"/>
		<Expect probe="Object.Property" target="Lantern" key="PointLightComponent._radius" equals="7"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
		<!-- 에디터 문구 표가 올라왔다(인스펙터의 프리팹 줄 툴팁이 키 그대로 나오지 않는다) -->
		<ExpectLog contains="Missing localized text" count="0"/>
	</At>
	<At frame="395"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
