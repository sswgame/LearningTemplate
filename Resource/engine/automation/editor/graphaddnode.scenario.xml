<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 노드 그래프 찾아 넣기(T3): Dialogue Graph 캔버스 빈 곳을 오른쪽 클릭하면 검색 팝업이 열리고, 글자를 치고 Enter 를 누르면
  맨 위 줄의 노드가 그 자리에 하나 생긴다(탐침 Editor.GraphNodeCount). 같은 것을 Animation Graph 로 한 번 더 한다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/graphaddnode.scenario.xml -dx12
-->
<Scenario name="editor.graphaddnode" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40"><DevCommand line="panel.focus dialogue_graph"/></At>
	<At frame="90"><Expect probe="Editor.GraphNodeCount" equals="5"/></At>
	<At frame="95"><EditorClick mark="graph.canvas" button="1" anchor="0.06,0.9"/></At>
	<At frame="115"><EditorText value="choi"/></At>
	<At frame="125"><EditorKey key="Enter"/></At>
	<At frame="145"><Expect probe="Editor.GraphNodeCount" equals="6"/></At>
	<At frame="150"><DevCommand line="panel.focus animation_graph"/></At>
	<At frame="200"><Expect probe="Editor.GraphNodeCount" equals="2"/></At>
	<At frame="205"><EditorClick mark="graph.canvas" button="1" anchor="0.06,0.9"/></At>
	<At frame="225"><EditorText value="att"/></At>
	<At frame="235"><EditorKey key="Enter"/></At>
	<At frame="255"><Expect probe="Editor.GraphNodeCount" equals="3"/></At>
	<At frame="260"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
