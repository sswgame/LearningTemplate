<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 기믹 회로 그래프 편집 창(GF_Editor_Base): 기믹 쇼케이스 씬을 열고 회로가 있는 오브젝트들을 고르면 Gimmick Graph 창이 그 회로를 노드 그래프로 그린다(탐침 Editor.GraphNodeCount).
  도구 모음으로 Signal · Not 노드를 더하고, 옆 패널의 폼으로 signal_1.Active -> not_1.In 배선을 이으면 편집마다 Undo 에 한 줄씩 오른다(Editor.UndoCount).
  편집은 컴포넌트에 쓰이고 회로가 다시 지어지므로 로그 줄 "Gimmick graph <편집 이름>" 로 센다. 씬은 저장하지 않는다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/gimmickgraph.scenario.xml -dx12
-->
<Scenario name="editor.gimmickgraph" isolated="true" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="30"><DevCommand line="scene.open game/empty/maps/gimmickshowcase.scene.xml"/></At>
	<At frame="40"><WaitUntil probe="Editor.ObjectCount" atLeast="5" timeoutFrames="600"/></At>
	<At frame="60"><DevCommand line="select.type GimmickCircuitComponent"/></At>
	<At frame="70"><DevCommand line="panel.focus gimmick_graph"/></At>
	<At frame="110"><Expect probe="Editor.GraphNodeCount" atLeast="1"/></At>
	<!-- 노드 둘 -->
	<At frame="115"><EditorClick mark="gimmick.addnode"/></At>
	<At frame="130"><EditorClick mark="gimmick.kind.Signal"/></At>
	<At frame="150"><ExpectLog contains="Gimmick graph Add Gimmick Node" count="1"/></At>
	<At frame="155"><EditorClick mark="gimmick.addnode"/></At>
	<At frame="170"><EditorClick mark="gimmick.kind.Not"/></At>
	<At frame="190"><ExpectLog contains="Gimmick graph Add Gimmick Node" count="2"/></At>
	<!-- 배선: 폼의 From · To 를 고르고 Connect -->
	<At frame="195"><EditorClick mark="gimmick.wire.from"/></At>
	<At frame="210"><EditorClick mark="gimmick.wire.from.signal_1.Active"/></At>
	<At frame="225"><EditorClick mark="gimmick.wire.to"/></At>
	<At frame="240"><EditorClick mark="gimmick.wire.to.not_1.In"/></At>
	<At frame="255"><EditorClick mark="gimmick.wire.connect"/></At>
	<At frame="275">
		<ExpectLog contains="Gimmick graph Add Gimmick Wire" count="1"/>
		<Expect probe="Editor.UndoCount" atLeast="3"/>
	</At>
	<At frame="280"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
