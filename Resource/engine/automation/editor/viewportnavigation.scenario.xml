<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰 카메라 조작이 상용 엔진 표준을 따르는지 본다(UX 검토 U1).
  ① 휠: 원근 보기에서 궤도 거리가 줄어든다(dolly). ② 가운데 단추 끌기: 카메라가 옆으로 옮겨진다(팬).
  ③ 오른쪽 단추를 누른 채 D 로 옆으로 난 뒤 Alt 만 누르고 마우스를 움직이지 않으면 위치가 그대로다(비행 뒤 궤도 중심이 시선 앞으로 이어져 튀지 않는다).
  ④ 오른쪽 단추 비행 중 휠은 궤도 거리가 아니라 비행 속도를 바꾼다.
  커서는 EditorHover 가 씬 뷰 가운데에 붙잡아 둔다(키와 휠은 씬 뷰 호버를 본다). 가운데 단추는 button="2", 오른쪽은 button="1".
  실행: py -3 -m Scripts scenario viewportnavigation
-->
<Scenario name="editor.viewportnavigation" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="35"><DevCommand line="camera.reset"/></At>
	<At frame="45"><EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/></At>
	<At frame="55">
		<Expect probe="Editor.SceneViewOrthographic" equals="0"/>
		<Expect probe="Editor.SceneViewOrbitDistance" near="8" tolerance="0.01"/>
		<Remember probe="Editor.SceneViewCameraX" as="xStart"/>
	</At>

	<!-- ① 휠 세 눈금: 8 * 0.85^3 = 약 4.9 -->
	<At frame="60"><EditorWheel dy="3"/></At>
	<At frame="75">
		<Expect probe="Editor.SceneViewOrbitDistance" atMost="6"/>
		<Expect probe="Editor.SceneViewOrbitDistance" atLeast="0.5"/>
		<Expect probe="Editor.SceneViewCameraX" sameAs="xStart"/>
	</At>

	<!-- ② 가운데 단추 끌기: 카메라 X 가 바뀐다 -->
	<At frame="80"><EditorDrag mark="sceneView.canvas" button="2" dx="120" dy="0"/></At>
	<At frame="100"><Expect probe="Editor.SceneViewCameraX" differsFrom="xStart"/></At>

	<!-- ③ 오른쪽 단추 비행으로 옆으로 난 뒤 Alt 궤도 -->
	<At frame="110"><DevCommand line="camera.reset"/></At>
	<At frame="120"><EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/></At>
	<At frame="125"><Remember probe="Editor.SceneViewCameraX" as="xBeforeFly"/></At>
	<At frame="130"><EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.5" state="down"/></At>
	<At frame="140"><EditorKey key="D" state="down"/></At>
	<At frame="170"><EditorKey key="D" state="up"/></At>
	<At frame="175"><EditorClick mark="sceneView.canvas" button="1" state="up"/></At>
	<At frame="185">
		<Expect probe="Editor.SceneViewCameraX" differsFrom="xBeforeFly"/>
		<Remember probe="Editor.SceneViewCameraX" as="xFlown"/>
		<Remember probe="Editor.SceneViewOrbitDistance" as="distFlown"/>
	</At>
	<At frame="190"><EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/></At>
	<At frame="195"><EditorKey key="Alt" state="down"/></At>
	<At frame="215">
		<Expect probe="Editor.SceneViewCameraX" sameAs="xFlown"/>
		<Expect probe="Editor.SceneViewOrbitDistance" sameAs="distFlown"/>
	</At>
	<At frame="220"><EditorKey key="Alt" state="up"/></At>

	<!-- ④ 비행 중 휠은 속도다: 궤도 거리는 그대로 -->
	<At frame="230"><EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/></At>
	<At frame="235"><EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.5" state="down"/></At>
	<At frame="245"><Remember probe="Editor.SceneViewOrbitDistance" as="distBeforeFlyWheel"/></At>
	<At frame="250"><EditorWheel dy="3"/></At>
	<At frame="265"><Expect probe="Editor.SceneViewOrbitDistance" sameAs="distBeforeFlyWheel"/></At>
	<At frame="270"><EditorClick mark="sceneView.canvas" button="1" state="up"/></At>
	<At frame="285"><Pass/></At>
</Scenario>
