<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 라이트 프로브 나눠 굽기와 취소(결정 기록 5-5 P6).
  큰 볼륨이 든 픽스처 씬(engine/automation/editor/lightprobebake/bake_cancel.scene.xml)을 열고 lighting.bakeProbes 를 부르면 굽기가 에디터 프레임에 나눠 돈다
  (탐침 Editor.LightProbeBakeRunning 1, 상태줄 "Baking probes" 와 Cancel). Cancel 을 누르면 멈추고(끝난 굽기 수 1), 굽던 볼륨은 버려 구운 볼륨은 0 이다 —
  파일을 쓰지 않는다(저장소 리소스를 바꾸지 않는다). 굽는 동안 Bake 커맨드는 꺼져 있다(편집 잠금 — 꺼진 커맨드를 부르는 DevCommand 는 실패로 세므로 여기서 부르지 않는다).
  실행: py -3 -m Scripts scenario lightprobebakecancel
-->
<Scenario name="editor.lightprobebakecancel" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="30"><DevCommand line="scene.open engine/automation/editor/lightprobebake/bake_cancel.scene.xml"/></At>
	<At frame="120">
		<EditorExpectObject name="ProbeVolume"/>
		<!-- 픽스처 볼륨은 일부러 굽지 않았다 — 열 때 검증 경고("is not baked")를 낸다(lightprobebake 시나리오와 같다) -->
		<ExpectLog id="ObjectValidation.Issue" atLeast="1"/>
		<Expect probe="Editor.LightProbeBakeRunning" equals="0"/>
		<Expect probe="Editor.LightProbeBakeCount" equals="0"/>
	</At>
	<At frame="125"><DevCommand line="editor lighting.bakeProbes"/></At>
	<At frame="126"><WaitUntil probe="Editor.LightProbeBakeRunning" equals="1" timeoutFrames="300"/></At>
	<At frame="140">
		<Expect probe="Editor.LightProbeBakeRunning" equals="1"/>
		<Expect probe="Editor.LightProbeBakeCount" equals="0"/>
	</At>
	<!-- 눈 확인용(GPU 검증): 상태줄의 진행 "Baking probes 1/1 (n / 100)" 과 Cancel 단추 -->
	<At frame="150"><CaptureEditorUI file="lightprobebakecancel/baking.png"/></At>
	<!-- 단추는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<At frame="155"><EditorClick mark="statusBar.lightProbeBakeCancel" state="down"/></At>
	<At frame="158"><EditorClick mark="statusBar.lightProbeBakeCancel" state="up"/></At>
	<At frame="159"><WaitUntil probe="Editor.LightProbeBakeRunning" equals="0" timeoutFrames="600"/></At>
	<At frame="175">
		<Expect probe="Editor.LightProbeBakeRunning" equals="0"/>
		<Expect probe="Editor.LightProbeBakeCount" equals="1"/>
		<Expect probe="Editor.BakedLightProbeVolumeCount" equals="0"/>
	</At>
	<At frame="180"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
