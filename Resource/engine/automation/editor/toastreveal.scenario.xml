<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 토스트의 "Show in Explorer" 단추(후보 B-4): 단추가 달린 토스트를 띄우고 단추를 눌러, 탐색기 명령줄이 만들어지는지(호출 직전)까지 본다.
  explorer.dryRun 1 이 실제 탐색기 실행을 막는다 — 명령줄 조립과 횟수만 단언한다(Editor.ExplorerCommandWellFormed: 경로를 따옴표로 싸고 Windows 에서는 백슬래시만 쓴다).
  실행: py -3 -m Scripts scenario toastreveal
-->
<Scenario name="editor.toastreveal" requireForeground="true" fixedDelta="0.0166667" timeoutFrames="200" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1600" height="900"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="30"><DevCommand line="explorer.dryRun 1"/></At>
	<At frame="35"><DevCommand line="notify.reveal /tmp/reveal/shot.png"/></At>
	<!-- 단추는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<At frame="45"><EditorClick mark="notification.showInExplorer" state="down"/></At>
	<At frame="48"><EditorClick mark="notification.showInExplorer" state="up"/></At>
	<At frame="60"><Expect probe="Editor.ExplorerLaunchCount" atLeast="1"/><Expect probe="Editor.ExplorerCommandWellFormed" equals="1"/></At>
	<At frame="70"><DevCommand line="explorer.dryRun 0"/></At>
	<At frame="75"><Pass/></At>
</Scenario>
