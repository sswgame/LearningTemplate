<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 기본값과 다른 프로퍼티의 되돌리기 단추(I2): GameCamera 의 _priority 를 4 로 바꾸면 이름 칸 끝에 되돌리기 단추가 생기고
  (이름표 inspector.reset.CameraComponent._priority), 누르면 기본(0)으로 돌아온다. 기본값은 컴포넌트의 기본 인스턴스(CDO)에서 온다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/propertyreset.scenario.xml -dx12
-->
<Scenario name="editor.propertyreset" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50">
		<EditorClick mark="hierarchy.row.GameCamera"/>
		<Variable name="gv_editorProbeProperty" value="CameraComponent._priority"/>
	</At>
	<At frame="65"><EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/></At>
	<At frame="75"><EditorKey key="Ctrl+A"/></At>
	<At frame="80"><EditorText value="4"/></At>
	<At frame="85"><EditorKey key="Enter"/></At>
	<At frame="105"><Expect probe="Editor.SelectedProperty" equals="4"/></At>
	<At frame="110"><EditorClick mark="inspector.reset.CameraComponent._priority"/></At>
	<At frame="130">
		<Expect probe="Editor.SelectedProperty" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="2"/>
	</At>
	<At frame="140"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
