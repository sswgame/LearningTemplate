<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 회선 조절(서버 디버깅 S4). 전용 서버 + App 클라이언트 1 을 띄운 뒤, Multiplayer 창 Conditions 탭이 보내는 것과 같은 개발 명령을
  netplay.command 로 클라이언트 표준 입력에 보낸다: 두 방향 손실 30 %, 그리고 패킷 하나 크기의 신뢰 메시지 100 개(net.traffic — 재전송할 거리).
  netplay.stats 는 모든 프로세스에 net.emulation stats 를 묻고 답이 올 때까지 그 프레임을 붙잡는다. 탐침이 그 답을 읽어
  흉내가 버린 패킷(Editor.NetPlayEmulationDroppedPackets)과 연결이 다시 보낸 신뢰 메시지(Editor.NetPlayResentMessages)를 보고한다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/netconditions.scenario.xml -dx12
-->
<Scenario name="editor.netconditions" isolated="true" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20">
		<Expect probe="Editor.NetPlayProcessCount" equals="0"/>
		<DevCommand line="netplay.start dedicated 1"/>
	</At>
	<At frame="21"><DevCommand line="netplay.wait 1 120"/></At>
	<At frame="22">
		<Expect probe="Editor.NetPlayConnectedClients" equals="1"/>
		<DevCommand line="netplay.command clients net.emulation both lossPercent=30"/>
		<DevCommand line="netplay.command clients net.traffic 100 1000"/>
	</At>
	<At frame="90"><DevCommand line="netplay.stats 30"/></At>
	<At frame="91">
		<ExpectLog contains="net emulation up [latencyMs=0 jitterMs=0 lossPercent=30" atLeast="1"/>
		<ExpectLog contains="net traffic queued 100 reliable message(s) to 1 connection(s)" atLeast="1"/>
		<ExpectLog contains="netplay stats from 2 of 2 process(es)" atLeast="1"/>
		<Expect probe="Editor.NetPlayEmulationDroppedPackets" atLeast="1"/>
		<Expect probe="Editor.NetPlayResentMessages" atLeast="1"/>
	</At>
	<At frame="92"><DevCommand line="netplay.stop"/></At>
	<At frame="93">
		<Expect probe="Editor.NetPlayProcessCount" equals="0"/>
		<Pass/>
	</At>
</Scenario>
