<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 프로젝트 설정 창: 커맨드 팔레트로 열면 설정 색인(docs/Config/ConfigReference.json)에서 만든 파일 목록이 보인다.
  EngineConfig 를 고르고 _maxFrameDeltaTime 을 0.2 로 바꾸면 기본값과 다른 키가 1 개가 되고(저장 전 편집 1 개), Revert 를 누르면 0 으로 돌아온다.
  저장하지 않으므로 저장소의 Config 파일은 건드리지 않는다. 저장과 호스트 다시 읽기는 EditorTest 의 ProjectSettingsDocument 테스트가 임시 폴더에서 본다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/projectconfigedit.scenario.xml -dx12
-->
<Scenario name="editor.projectconfigedit" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="60"><EditorKey key="Ctrl+Shift+P"/></At>
	<At frame="75"><EditorText value="Open project settings"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="105"><DevCommand line="panel.focus projectsettings"/></At>
	<At frame="125">
		<Expect probe="Editor.ProjectSettingsPageCount" atLeast="3"/>
		<Expect probe="Editor.ProjectSettingsDirtyPageCount" equals="0"/>
	</At>
	<At frame="130"><EditorClick mark="projectsettings.page.EngineConfig"/></At>
	<At frame="150"><Expect probe="Editor.ProjectSettingsKeyCount" equals="0"/></At>
	<At frame="160"><EditorClick mark="inspector.property.EngineConfig._maxFrameDeltaTime" mods="ctrl"/></At>
	<At frame="170"><EditorKey key="Ctrl+A"/></At>
	<At frame="175"><EditorText value="0.2"/></At>
	<At frame="180"><EditorKey key="Enter"/></At>
	<At frame="195"><WaitUntil probe="Editor.ProjectSettingsDirtyPageCount" equals="1"/></At>
	<At frame="205">
		<Expect probe="Editor.ProjectSettingsKeyCount" equals="1"/>
		<Expect probe="Editor.ProjectSettingsDirtyPageCount" equals="1"/>
	</At>
	<At frame="215"><EditorClick mark="projectsettings.revert"/></At>
	<At frame="235">
		<Expect probe="Editor.ProjectSettingsKeyCount" equals="0"/>
		<Expect probe="Editor.ProjectSettingsDirtyPageCount" equals="0"/>
	</At>
	<At frame="245"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
