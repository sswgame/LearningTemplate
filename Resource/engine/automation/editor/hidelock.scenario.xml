<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 에디터에서만 숨김과 고르기 잠금(N12): Hierarchy 의 눈(hierarchy.toggle.<이름>)은 에디터에서만 숨긴다 — 씬 dirty · 되돌리기에 남지 않고
  오브젝트 활성 비트는 그대로다(게임 동작이 바뀌지 않는다). 자물쇠(hierarchy.lock.<이름>)를 건 오브젝트는 뷰포트에서 눌러도(빌보드) 골라지지 않는다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/hidelock.scenario.xml -dx12
-->
<Scenario name="editor.hidelock" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50">
		<Variable name="gv_editorProbeObject" value="TestMesh"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="55"><EditorClick mark="hierarchy.toggle.TestMesh"/></At>
	<At frame="75">
		<Expect probe="Editor.ObjectHiddenInEditor" equals="1"/>
		<Expect probe="Editor.ObjectActive" equals="1"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="80"><EditorClick mark="hierarchy.toggle.TestMesh"/></At>
	<At frame="100"><Expect probe="Editor.ObjectHiddenInEditor" equals="0"/></At>
	<At frame="105"><EditorClick mark="hierarchy.lock.GameCamera"/></At>
	<At frame="120"><EditorClick mark="viewport.billboard.GameCamera"/></At>
	<At frame="140"><Expect probe="Editor.SelectionCount" equals="0"/></At>
	<At frame="145"><EditorClick mark="hierarchy.lock.GameCamera"/></At>
	<At frame="160"><EditorClick mark="viewport.billboard.GameCamera"/></At>
	<At frame="180"><Expect probe="Editor.SelectionCount" equals="1"/></At>
	<At frame="185"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
