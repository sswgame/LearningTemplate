<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 행동 트리 패널(behavior_tree, GameFramework 에디터 확장): 패널을 열면 그려지고(에디터 UI 캡처에 마젠타 자리표시가 없다) 닫으면 닫힌다.
  열기 · 닫기만 본다 — 트리를 열어 노드를 더하고 저장하는 길은 파일을 쓰므로 BehaviorTreeSelfTest 와 EditorTest 가 본다.
  연 뒤 그려지는 것은 조건 대기(Editor.PanelOpen)로 기다린다. 이 패널은 열기만 해서는 로그를 남기지 않는다(파일을 읽을 때만 [Error] 가 난다).
  실행: py -3 -m Scripts scenario behaviortreepanel
-->
<Scenario name="editor.behaviortreepanel" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="0">
		<ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/>
		<Variable name="gv_editorProbePanel" value="behavior_tree"/>
	</At>
	<At frame="1"><DevCommand line="panel.focus behavior_tree"/></At>
	<At after="1"><WaitUntil probe="Editor.PanelOpen" equals="1" timeoutSeconds="10"/></At>
	<!-- 눈 확인용(GPU 검증): 열린 행동 트리 패널 -->
	<At after="1"><CaptureEditorUI file="behaviortreepanel/open.png" maxMagentaFraction="0"/></At>
	<At after="1"><DevCommand line="panel.close behavior_tree"/></At>
	<At after="1"><WaitUntil probe="Editor.PanelOpen" equals="0" timeoutSeconds="10"/></At>
	<At after="1"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
