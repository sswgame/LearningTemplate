<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 지형 칠하기 도구: envshowcase 를 열고(비동기 로드를 Scene.Transitioning 으로 기다린다) 씬 뷰 카메라를 지형 위로 옮긴 뒤 Terrain 토글(viewport.visualizer.terrainbrush)을 켠다.
  ① 칠하기 전을 찍는다. ② 레이어 3(모래)을 반경 20 m 로 씬 뷰 가운데에서 끌어 칠하면 드래그 하나가 되돌리기 하나로 남고(Editor.TerrainBrushStrokeCount),
  GPU 스플랫이 바뀐 구간만 올라가 그림이 달라진다. ③ Ctrl+Z 면 같은 사각형이 편집 전 값으로 다시 써져 ①과 거의 같다(브러시 원 · 마우스 위치만 다르다).
  ④ 높이 올리기로 끌면 청크 메시가 다시 만들어져 그림이 다시 달라진다. ⑤ 스무드(세기 60 — 프레임마다 이웃 평균 쪽으로 거의 다 간다)로 같은 자리를 끌면 솟은 곳이 눅는다. ⑥ 구멍 내기로 끌면 지형이 뚫려 그림이 달라진다. ⑦ 크기 바꾸기(terrain.resize 129)는 해상도를 257 에서 129 로 줄이고(Editor.TerrainResolution), Ctrl+Z 가 257 로 되돌린다.
  저장 단추는 누르지 않는다 — 에셋 파일은 그대로다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/terrainbrush.scenario.xml -dx12
-->
<Scenario name="editor.terrainbrush" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<At frame="1"><Variable name="gv_environmentAnimate" value="0"/></At>
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="panel.resetOptional"/><DevCommand line="layout.reset"/></At>
	<At frame="30"><DevCommand line="scene.open game/empty/maps/envshowcase.scene.xml"/></At>
	<At frame="31"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="40"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="50"><DevCommand line="camera.reset"/></At>
	<At frame="55"><DevCommand line="camera.set 0 70 -100 35 0"/></At>
	<At frame="70"><EditorClick mark="viewport.visualizer.terrainbrush"/></At>
	<At frame="71"><WaitUntil probe="Editor.TerrainBrushToolActive" equals="1" timeoutFrames="60"/></At>
	<At frame="80"><DevCommand line="terrain.brush paint 20 60 3"/></At>

	<!-- 브러시 원: 마우스를 씬 뷰 가운데에 두면 레이가 지형에 닿고 원이 그려진다(카메라는 지형 위) — 에디터 화면으로 찍는다 -->
	<At frame="95"><EditorHover mark="sceneView.canvas" anchor="0.5,0.55"/></At>
	<At frame="102">
		<Expect probe="Editor.TerrainBrushHit" equals="1"/>
		<CaptureEditorUI file="terrainbrush/circle.png"/>
	</At>

	<!-- ① 칠하기 전 -->
	<At frame="110">
		<Expect probe="Editor.SceneViewDrawn" equals="1"/>
		<Expect probe="Editor.SceneViewCameraY" near="70" tolerance="0.5"/>
		<Expect probe="Editor.GameViewRequested" equals="0"/>
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="0"/>
		<Screenshot file="terrain_before.ppm"/>
	</At>

	<!-- ② 레이어 칠하기 -->
	<At frame="120"><EditorDrag mark="sceneView.canvas" dx="160" dy="0"/></At>
	<At frame="122"><Expect probe="Editor.TerrainBrushHit" equals="1"/></At>
	<At frame="170">
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="1"/>
		<Expect probe="Editor.UndoCount" atLeast="1"/>
		<Screenshot file="terrain_painted.ppm"/>
	</At>
	<At frame="171"><ExpectImage file="terrain_painted.ppm" metric="differentFrom" reference="terrain_before.ppm" atLeast="0.001"/></At>

	<!-- ③ 되돌리기 -->
	<At frame="180"><EditorKey key="Ctrl+Z"/></At>
	<At frame="210"><Screenshot file="terrain_undone.ppm"/></At>
	<At frame="211"><ExpectImage file="terrain_undone.ppm" metric="differentFrom" reference="terrain_before.ppm" atMost="0.02"/></At>

	<!-- ④ 높이 올리기 -->
	<At frame="220"><DevCommand line="terrain.brush raise 15 120"/></At>
	<At frame="230"><EditorDrag mark="sceneView.canvas" dx="0" dy="60"/></At>
	<At frame="280">
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="2"/>
		<Screenshot file="terrain_raised.ppm"/>
	</At>
	<At frame="281"><ExpectImage file="terrain_raised.ppm" metric="differentFrom" reference="terrain_undone.ppm" atLeast="0.003"/></At>

	<!-- ⑤ 스무드 -->
	<At frame="290"><DevCommand line="terrain.brush smooth 25 60"/></At>
	<At frame="300"><EditorDrag mark="sceneView.canvas" dx="20" dy="0"/></At>
	<At frame="350">
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="3"/>
		<Screenshot file="terrain_smoothed.ppm"/>
	</At>
	<At frame="351"><ExpectImage file="terrain_smoothed.ppm" metric="differentFrom" reference="terrain_raised.ppm" atLeast="0.0002"/></At>

	<!-- ⑥ 구멍 내기 -->
	<At frame="360"><DevCommand line="terrain.brush hole 18 1"/></At>
	<At frame="370"><EditorDrag mark="sceneView.canvas" dx="40" dy="0"/></At>
	<At frame="420">
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="4"/>
		<Screenshot file="terrain_holes.ppm"/>
	</At>
	<At frame="421"><ExpectImage file="terrain_holes.ppm" metric="differentFrom" reference="terrain_smoothed.ppm" atLeast="0.002"/></At>

	<!-- ⑦ 크기 바꾸기 -->
	<At frame="430"><Expect probe="Editor.TerrainResolution" equals="257"/><DevCommand line="terrain.resize 129"/></At>
	<At frame="440">
		<Expect probe="Editor.TerrainResolution" equals="129"/>
		<Expect probe="Editor.TerrainBrushStrokeCount" equals="4"/>
		<Screenshot file="terrain_resized.ppm"/>
	</At>
	<At frame="450"><EditorKey key="Ctrl+Z"/></At>
	<At frame="470"><Expect probe="Editor.TerrainResolution" equals="257"/></At>
	<At frame="480"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
