<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 컴포넌트 · 오브젝트 아이콘(R3): 시험 씬(editortest)의 빛 오브젝트 줄은 방향광 아이콘, 카메라 줄은 카메라 아이콘,
  메시만 있는 줄은 오브젝트 아이콘이다(탐침 Editor.HierarchyRowIcon = 코드 포인트). Hierarchy 화면을 찍어 둔다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/componenticons.scenario.xml -dx12
-->
<Scenario name="editor.componenticons" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><Variable name="gv_editorProbeObject" value="TestKeyLight"/></At>
	<At frame="55"><Expect probe="Editor.HierarchyRowIcon" equals="57417"/></At>
	<At frame="60"><Variable name="gv_editorProbeObject" value="GameCamera"/></At>
	<At frame="65"><Expect probe="Editor.HierarchyRowIcon" equals="57394"/></At>
	<At frame="70"><Variable name="gv_editorProbeObject" value="TestMesh"/></At>
	<At frame="75"><Expect probe="Editor.HierarchyRowIcon" equals="57414"/></At>
	<At frame="80"><EditorClick mark="hierarchy.row.TestKeyLight"/></At>
	<At frame="100"><CaptureWindow file="hierarchy.png"/></At>
	<At frame="110"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
