<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 끌어 놓기(드래그 앤 드롭). Hierarchy 의 TestKeyLight 줄을 TestParent 줄에 끌어 놓으면 부모가 바뀌고(탐침 Editor.ObjectDepth 0 → 1) 되돌리기 하나가 쌓이며 Undo 로 루트로 돌아온다.
  받는 쪽은 `EditorDrag` 의 `toMark` 로 잡는다 — 줄 사이 픽셀 거리를 시나리오에 적지 않는다. 같은 길이 에셋 끌기(EditorWidgets::drawAssetDragSource → acceptAssetDrop)에도 쓰인다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/hierarchydrag.scenario.xml -dx12
-->
<Scenario name="editor.hierarchydrag" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><Variable name="gv_editorProbeObject" value="TestKeyLight"/></At>
	<At frame="60">
		<Expect probe="Editor.ObjectDepth" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="65"><EditorDrag mark="hierarchy.row.TestKeyLight" toMark="hierarchy.row.TestParent"/></At>
	<At frame="90"><WaitUntil probe="Editor.ObjectDepth" equals="1" timeoutFrames="180"/></At>
	<At frame="95">
		<Expect probe="Editor.UndoCount" equals="1"/>
		<Expect probe="Editor.SceneDirty" equals="1"/>
	</At>
	<At frame="100"><DevCommand line="editor edit.undo"/></At>
	<At frame="120">
		<Expect probe="Editor.ObjectDepth" equals="0"/>
	</At>
	<At frame="125"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
