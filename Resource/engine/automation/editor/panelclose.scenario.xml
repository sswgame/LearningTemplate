<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 문서 패널이 아닌 패널(Input Map Editor, IEditorPanel 직접 상속)의 닫기 확인. 닫는 길이 하나(IEditorPanel::requestClose)라서
  패널 메뉴 토글(= panel.close, 같은 setOpen(false))도 X 도 편집이 남았으면 닫지 않고 Save / Don't Save / Cancel 을 묻는다.
  ① 바인딩의 발화 규칙을 고쳐 문서를 더럽힌다. ② 메뉴 토글 경로(panel.close)는 닫지 않고 확인을 띄운다. Cancel 은 열어 두고 편집도 남는다.
  ③ X 도 같은 확인을 띄운다. Don't Save 는 파일을 다시 읽어 편집을 버리고 닫는다. ④ 다시 열면 깨끗하고, 깨끗한 패널은 panel.close 로 바로 닫힌다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/panelclose.scenario.xml -dx12
-->
<Scenario name="editor.panelclose" fixedDelta="0.0166667" timeoutFrames="800" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/><Variable name="gv_editorProbePanel" value="input_map"/></At>
	<At frame="40"><DevCommand line="panel.focus input_map"/></At>
	<At frame="70"><Expect probe="Editor.PanelOpen" equals="1"/><Expect probe="Editor.PanelDirty" equals="0"/></At>

	<!-- ① 편집 -->
	<At frame="80"><EditorClick mark="inputMap.filter"/></At>
	<At frame="85"><EditorText value="Confirm"/></At>
	<At frame="95"><EditorClick mark="inputMap.action.Confirm"/></At>
	<At frame="115"><EditorClick mark="inputMap.binding.0.trigger"/></At>
	<At frame="135"><EditorClick mark="inputMap.trigger.4"/></At>
	<At frame="155">
		<Expect probe="Editor.InputMapSelectedTrigger" equals="4"/>
		<Expect probe="Editor.PanelDirty" equals="1"/>
		<CaptureEditorUI file="panelclose/edited.png"/>
	</At>

	<!-- ② 메뉴 토글 경로 → 확인 → Cancel -->
	<At frame="160"><DevCommand line="panel.close input_map"/></At>
	<At frame="180">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<CaptureEditorUI file="panelclose/confirm.png"/>
	</At>
	<At frame="185"><EditorClick mark="unsaved.cancel"/></At>
	<At frame="205">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<Expect probe="Editor.PanelDirty" equals="1"/>
		<Expect probe="Editor.InputMapSelectedTrigger" equals="4"/>
	</At>

	<!-- ③ X → 확인 → Don't Save -->
	<At frame="210"><EditorClick mark="panel.close.Input Map Editor"/></At>
	<At frame="230">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<CaptureEditorUI file="panelclose/confirmX.png"/>
	</At>
	<At frame="235"><EditorClick mark="unsaved.discard"/></At>
	<At frame="255"><Expect probe="Editor.PanelOpen" equals="0"/></At>

	<!-- ④ 다시 열면 깨끗하다 -->
	<At frame="265"><DevCommand line="panel.focus input_map"/></At>
	<At frame="295">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<Expect probe="Editor.PanelDirty" equals="0"/>
		<CaptureEditorUI file="panelclose/reopened.png"/>
	</At>
	<At frame="300"><DevCommand line="panel.close input_map"/></At>
	<At frame="320"><Expect probe="Editor.PanelOpen" equals="0"/></At>
	<At frame="325"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
