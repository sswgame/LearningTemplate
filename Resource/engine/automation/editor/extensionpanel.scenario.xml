<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 확장 모듈(GF_EditorPlugIn_Admin, 확장 지점 C5)이 로드되어 커맨드 · 패널 · 서브시스템이 에디터에 붙는다.
  커맨드 팔레트로 확장의 커맨드(admin.openToolPanel)를 실행해 GM Tool 패널을 열고, 패널의 Lookup 단추를 누른다(메모리 제공자가 기본 계정을 답한다).
  결속기가 틀리면 확장의 ImGui 호출이 다른 컨텍스트로 가서 이름표가 남지 않고 클릭 단계가 진다. 확장이 기여한 서브시스템(AdminToolSession)이
  에디터 범위에 없으면 패널이 그 절을 그리지 않아 역시 진다. 기본 게임(Empty)이 쓰는 키트의 확장이다 — 고른 게임이 쓰지 않는 키트의 확장은 오르지 않는다.
  실행: py -3 -m Scripts scenario extensionpanel
-->
<Scenario name="editor.extensionpanel" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<At frame="40">
		<Variable name="gv_editorProbePanel" value="admin.tool"/>
	</At>
	<At frame="45"><Expect probe="Editor.PanelOpen" equals="0"/></At>
	<At frame="60"><EditorKey key="Ctrl+Shift+P"/></At>
	<At frame="75"><EditorText value="Open the GM tool"/></At>
	<At frame="90"><EditorKey key="Enter"/></At>
	<At frame="110">
		<Expect probe="Editor.PanelOpen" equals="1"/>
		<ExpectLog contains="GM Tool panel opened" count="1"/>
	</At>
	<At frame="115"><DevCommand line="panel.focus admin.tool"/></At>
	<At frame="135"><EditorClick mark="admin.lookup"/></At>
	<At frame="150"><ExpectLog contains="Admin command LookupAccount: Ok" count="1"/></At>
	<At frame="155"><DevCommand line="panel.close admin.tool"/></At>
	<At frame="160"><Pass/></At>
</Scenario>
