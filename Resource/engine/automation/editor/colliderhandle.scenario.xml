<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 콜라이더 크기 손잡이: TestMesh 에 RigidBodyComponent 를 붙이고 Phys(physics_shapes)를 켜면 선택한 상자 셰이프의 면마다 손잡이 여섯 개가 선다
  (표식 collider.handle.<셰이프>.<축><부호>). +X 손잡이를 끌면 셰이프 크기가 바뀌고 되돌리기 하나가 남으며(Editor.ColliderHandleCommitCount),
  Ctrl+Z 로 반 크기가 처음 값(0.5)으로 돌아온다. 끈 방향은 카메라에 따라 달라 늘었는지 줄었는지는 보지 않는다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/colliderhandle.scenario.xml -dx12
-->
<Scenario name="editor.colliderhandle" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><EditorClick mark="hierarchy.row.TestMesh"/></At>
	<At frame="65"><DevCommand line="component.add RigidBodyComponent"/></At>
	<At frame="80">
		<Expect probe="Editor.ColliderHandleCount" equals="0"/>
		<Expect probe="Editor.ColliderHalfExtentX" near="0.5" tolerance="0.001"/>
	</At>
	<At frame="85"><EditorClick mark="viewport.visualizer.physics_shapes"/></At>
	<At frame="105"><Expect probe="Editor.ColliderHandleCount" equals="6"/></At>
	<At frame="110"><EditorDrag mark="collider.handle.0.x+" dx="60" dy="0"/></At>
	<At frame="160">
		<Expect probe="Editor.ColliderHandleCommitCount" equals="1"/>
		<Expect probe="Editor.UndoCount" atLeast="1"/>
	</At>
	<At frame="170"><EditorKey key="Ctrl+Z"/></At>
	<At frame="190"><Expect probe="Editor.ColliderHalfExtentX" near="0.5" tolerance="0.001"/></At>
	<At frame="200"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
