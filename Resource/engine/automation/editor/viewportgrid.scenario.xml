<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 뷰포트 격자의 굵은 선은 월드에 고정된다. 카메라를 오른쪽 단추 + D 로 날려 옆으로 옮겨도 굵은 선이 월드 5 배수 선에만 있고
  (예전에는 카메라 기준 인덱스라 카메라가 1 m 지날 때마다 다른 월드 선으로 미끄러졌다), Shift + E 로 높이 올라가면 간격이 10 m 로 바뀐다.
  실행: App.exe -EnableEditor -scenario=engine/automation/editor/viewportgrid.scenario.xml -dx12   (AppScenarioTest.EditorScenariosPassOnEveryBackend 가 백엔드마다 돈다)
-->
<Scenario name="editor.viewportgrid" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 위치로 누르는 시나리오 — 앞 시나리오 · 사용자 배치가 패널을 좁혀 두었을 수 있다 -->
	<At frame="5"><DevCommand line="layout.reset"/></At>
	<At frame="60">
		<Expect probe="Editor.GridStep" near="1" tolerance="0.001"/>
		<Expect probe="Editor.GridMajorLines" atLeast="4"/>
		<Expect probe="Editor.GridMisplacedMajorLines" equals="0"/>
	</At>

	<!-- 옆으로 3 m 남짓 — 정수 · 5 의 배수가 아닌 자리에 선다 -->
	<At frame="70">
		<EditorClick mark="gameView.canvas" button="1" state="down"/>
		<EditorKey key="D" state="down"/>
	</At>
	<At frame="112">
		<EditorKey key="D" state="up"/>
		<EditorClick mark="gameView.canvas" button="1" state="up"/>
	</At>
	<At frame="120">
		<Expect probe="Editor.ViewportCameraX" atLeast="3"/>
		<Expect probe="Editor.GridStep" near="1" tolerance="0.001"/>
		<Expect probe="Editor.GridMisplacedMajorLines" equals="0"/>
	</At>

	<!-- 높이 올라가면 간격이 10 m 가 된다 -->
	<At frame="130">
		<EditorClick mark="gameView.canvas" button="1" state="down"/>
		<EditorKey key="Shift+E" state="down"/>
	</At>
	<At frame="590">
		<EditorKey key="Shift+E" state="up"/>
		<EditorClick mark="gameView.canvas" button="1" state="up"/>
	</At>
	<At frame="600">
		<Expect probe="Editor.ViewportCameraY" atLeast="100"/>
		<Expect probe="Editor.GridStep" near="10" tolerance="0.001"/>
		<Expect probe="Editor.GridMisplacedMajorLines" equals="0"/>
	</At>
	<At frame="610"><Pass/></At>
</Scenario>
