<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 에셋 임포트 → 씬에서 쓰기 → 저장 → 다시 열기.
  임포트는 콘텐츠 브라우저 Import 와 같은 길(EditorAssetFileCommands::importFiles — 복사와 .meta)이고 OS 파일 대화상자만 건너뛴다(asset.import).
  가져온 에셋은 리소스 id 가 있어야 씬이 쓴다 — 그래서 대상은 리소스 트리 안의 임시 폴더 editor/automationtemp/ 뿐이다(.gitignore 가 무시).
  시나리오는 처음과 끝에 그 폴더를 지운다(asset.removeImportFolder) — 남은 파일이 있으면 같은 이름이 새 이름을 받아 단계가 어긋난다.
  ① 프리팹 원본 하나를 임시 폴더로 가져온다. ② 가져온 리소스 id 로 스폰한다(점광이 붙은 FlickerLight). ③ 씬을 저장하고 새 씬 → 다시 열기 뒤에도 그 인스턴스가 있다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/flowimport.scenario.xml -dx12
-->
<Scenario name="editor.flowimport" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/><DevCommand line="asset.removeImportFolder editor/automationtemp/editor.flowimport"/></At>

	<!-- ① 임포트 -->
	<At frame="20"><DevCommand line="asset.import common/prefabs/gimmicks/horror/flickerlight.prefab.xml editor/automationtemp/editor.flowimport"/></At>

	<!-- ② 가져온 리소스 id 로 스폰 -->
	<At frame="35"><DevCommand line="prefab.spawn editor/automationtemp/editor.flowimport/flickerlight.prefab.xml"/></At>
	<At frame="50">
		<EditorExpectObject name="FlickerLight" component="PointLightComponent" selected="1"/>
		<Expect probe="Object.Property" target="FlickerLight" key="PointLightComponent._radius" equals="6"/>
	</At>

	<!-- ③ 저장 → 새 씬 → 다시 열기 -->
	<At frame="60"><DevCommand line="scene.saveAs Saved/Automation/editor.flowimport/flowimport.scene.xml"/></At>
	<At frame="75"><DevCommand line="editor scene.new"/></At>
	<At frame="90"><EditorExpectObject name="FlickerLight" count="0"/></At>
	<At frame="95"><DevCommand line="scene.open Saved/Automation/editor.flowimport/flowimport.scene.xml"/></At>
	<At frame="96"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="120">
		<EditorExpectObject name="FlickerLight" component="PointLightComponent" count="1"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
	</At>
	<At frame="125"><DevCommand line="editor scene.new"/></At>
	<At frame="140"><DevCommand line="asset.removeImportFolder editor/automationtemp/editor.flowimport"/></At>
	<At frame="145"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
