<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 애니메이션 그래프 패널 ↔ 저장 배선(D3-5): 임시 에셋을 새 문서로 열고(asset.open), 툴바 "Add Attack" 으로 고쳐 더러워진 것을
  (탐침 Editor.DirtyDocumentCount) 툴바 Save 와 저장 커맨드(asset.save — Ctrl+S 와 같은 길) 두 길로 저장한다. 저장하면 파일이 생기고
  (Editor.TempAssetExists) 더러움이 걷힌다. 대화 그래프 판(dialoguegraphsave)과 같은 모양이다.
  문서: Saved/Automation/editor.animgraphsave/temp.animgraph.xml — 접미사 .animgraph.xml 이 애니메이션 그래프 패널을 고른다
  (EditorAssetTypeRegistry::findPanelKindForPath 는 가장 긴 접미사가 이긴다). 없는 파일이라 기본 문서(노드 Idle · Walk)로 열리고, 여는 길은
  markDocumentLoaded 로 더러움을 걷으므로 연 직후 DirtyDocumentCount 는 0 이다. 끝에서 asset.removeTemp 로 지운다.
  asset.open 의 패널 열기는 처음 여는 창이라 포커스를 못 잡을 수 있어 panel.focus 를 따로 보낸다(다음 프레임에 SetWindowFocus).
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/animgraphsave.scenario.xml -dx12
-->
<Scenario name="editor.animgraphsave" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40"><DevCommand line="asset.open Saved/Automation/editor.animgraphsave/temp.animgraph.xml"/></At>
	<At frame="45"><DevCommand line="panel.focus animation_graph"/></At>
	<At frame="80"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="0"/><Expect probe="Editor.GraphNodeCount" equals="2"/></At>
	<At frame="85"><EditorClick mark="animationGraph.add.Attack"/></At>
	<At frame="105"><Expect probe="Editor.DirtyDocumentCount" equals="1"/></At>
	<At frame="110"><EditorClick mark="animationGraph.save"/></At>
	<At frame="130"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="1"/></At>
	<At frame="135"><DevCommand line="asset.removeTemp Saved/Automation/editor.animgraphsave/temp.animgraph.xml"/></At>
	<At frame="140"><Expect probe="Editor.TempAssetExists" equals="0"/></At>
	<At frame="145"><EditorClick mark="animationGraph.add.Idle"/></At>
	<At frame="165"><Expect probe="Editor.DirtyDocumentCount" equals="1"/></At>
	<At frame="170"><DevCommand line="panel.focus animation_graph"/></At>
	<At frame="190"><DevCommand line="editor asset.save"/></At>
	<At frame="210"><Expect probe="Editor.DirtyDocumentCount" equals="0"/><Expect probe="Editor.TempAssetExists" equals="1"/></At>
	<At frame="215"><DevCommand line="asset.removeTemp Saved/Automation/editor.animgraphsave/temp.animgraph.xml"/></At>
	<At frame="220"><Expect probe="Editor.TempAssetExists" equals="0"/></At>
	<At frame="225"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
