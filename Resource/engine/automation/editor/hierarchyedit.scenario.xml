<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Hierarchy 편집 기본기(N2): 첫 줄(GameCamera)을 누르고 Shift 를 누른 채 셋째 줄(TestSprite)을 누르면 세 줄이 골라진다.
  Ctrl+C · Ctrl+V 로 셋이 붙여 넣어지고(오브젝트 수 +3, 되돌리기 한 줄) Ctrl+Z 한 번에 돌아온다. ↓ 는 다음 줄로 선택을 옮긴다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/hierarchyedit.scenario.xml -dx12
-->
<Scenario name="editor.hierarchyedit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><EditorClick mark="hierarchy.row.GameCamera"/></At>
	<At frame="65"><EditorClick mark="hierarchy.row.TestSprite" mods="shift"/></At>
	<At frame="80">
		<Expect probe="Editor.SelectionCount" equals="3"/>
		<Expect probe="Editor.ObjectCount" equals="9"/>
	</At>
	<At frame="85"><EditorKey key="Ctrl+C"/></At>
	<At frame="95"><EditorKey key="Ctrl+V"/></At>
	<At frame="115">
		<Expect probe="Editor.ObjectCount" equals="12"/>
		<Expect probe="Editor.SelectionCount" equals="3"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="120"><EditorKey key="Ctrl+Z"/></At>
	<At frame="140"><Expect probe="Editor.ObjectCount" equals="9"/></At>
	<At frame="145"><EditorClick mark="hierarchy.row.GameCamera"/></At>
	<At frame="160"><EditorKey key="DownArrow"/></At>
	<At frame="175">
		<Variable name="gv_editorProbeObject" value="TestMesh"/>
		<Expect probe="Editor.SelectionCount" equals="1"/>
		<Expect probe="Editor.SelectedComponentCount" equals="1"/>
	</At>
	<At frame="180"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
