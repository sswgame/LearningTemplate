<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 콘텐츠 브라우저 에셋 관리(N3). 테스트 폴더 engine/automation/editor/assetmanage 에는 probe.material 과 그것을 쓰는 씬이 있고,
  시나리오는 그것을 실행마다 새 사본(scratch/assetmanage)으로 복사해 사본에만 쓴다(<Scratch> — 추적 중인 원본이 바뀌거나 잔여 파일이 남지 않는다).
  1) Add > Material 로 new_material.material 을 만든다.
  2) probe.material 을 F2 로 probe_renamed 로 바꾸면 씬의 참조가 새 이름으로 바뀐다(Editor.ReferenceCount — 역색인이 센 참조 파일 수).
  3) 다시 probe 로 되돌리고, 만든 머티리얼은 Delete 로 휴지통에 보낸다. 사본은 다음 실행이 지운다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/assetmanage.scenario.xml -dx12
-->
<Scenario name="editor.assetmanage" requireForeground="true" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/assetmanage" as="scratch/assetmanage"/>
	<At frame="20">
		<ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/>
		<Variable name="gv_editorProbeAsset" value="scratch/assetmanage/probe.material"/>
	</At>
	<At frame="30"><DevCommand line="panel.focus content_browser"/></At>
	<!-- 역색인은 워커가 Resource/ 를 훑어 만든다. 콘텐츠 브라우저가 보이는 동안 색인이 마지막 변경(사본 복사 · 이름 바꾸기)을 따라오기 전이면
	     시계 잡기 조건 ContentBrowserReferenceIndex 가 시계를 멈춘다 — 아래 고정 프레임의 단언과 이름 바꾸기는 따라온 색인을 쓴다 -->
	<At frame="40"><WaitUntil probe="Editor.ReferenceIndexReady" equals="1"/></At>
	<At frame="50">
		<Expect probe="Editor.ReferenceCount" equals="1"/>
		<DevCommand line="content.open scratch/assetmanage"/>
	</At>
	<!-- 1) 새 머티리얼 -->
	<At frame="70"><EditorClick mark="contentBrowser.add" state="down"/></At>
	<At frame="73"><EditorClick mark="contentBrowser.add" state="up"/></At>
	<At frame="85"><EditorClick mark="contentBrowser.add.material" state="down"/></At>
	<At frame="88"><EditorClick mark="contentBrowser.add.material" state="up"/></At>
	<At frame="110"><ExpectLog contains="Created 'scratch/assetmanage/new_material.material'" count="1"/></At>
	<!-- 2) 이름 바꾸기 — 타일을 고르고 F2, 입력 칸은 확장자를 뺀 이름이다 -->
	<At frame="120"><EditorClick mark="contentBrowser.asset.probe.material" state="down"/></At>
	<At frame="123"><EditorClick mark="contentBrowser.asset.probe.material" state="up"/></At>
	<At frame="135"><EditorKey key="F2"/></At>
	<At frame="150"><EditorText value="probe_renamed"/></At>
	<At frame="160"><EditorKey key="Enter"/></At>
	<At frame="180">
		<ExpectLog contains="to 'scratch/assetmanage/probe_renamed.material' and fixed 1 referencing file(s)" count="1"/>
		<Expect probe="Editor.ReferenceCount" equals="0"/>
		<Variable name="gv_editorProbeAsset" value="scratch/assetmanage/probe_renamed.material"/>
	</At>
	<At frame="185">
		<Expect probe="Editor.ReferenceCount" equals="1"/>
		<CaptureWindow file="renamed.png"/>
	</At>
	<!-- 3) 되돌리기 -->
	<At frame="195"><EditorClick mark="contentBrowser.asset.probe_renamed.material" state="down"/></At>
	<At frame="198"><EditorClick mark="contentBrowser.asset.probe_renamed.material" state="up"/></At>
	<At frame="210"><EditorKey key="F2"/></At>
	<At frame="225"><EditorText value="probe"/></At>
	<At frame="235"><EditorKey key="Enter"/></At>
	<At frame="255">
		<Variable name="gv_editorProbeAsset" value="scratch/assetmanage/probe.material"/>
	</At>
	<At frame="260"><Expect probe="Editor.ReferenceCount" equals="1"/></At>
	<At frame="270"><EditorClick mark="contentBrowser.asset.new_material.material" state="down"/></At>
	<At frame="273"><EditorClick mark="contentBrowser.asset.new_material.material" state="up"/></At>
	<At frame="285"><EditorKey key="Delete"/></At>
	<At frame="300"><EditorClick mark="contentBrowser.delete.confirm" state="down"/></At>
	<At frame="303"><EditorClick mark="contentBrowser.delete.confirm" state="up"/></At>
	<At frame="320"><ExpectLog contains="Moved 'scratch/assetmanage/new_material.material' to the recycle bin" count="1"/></At>
	<At frame="330"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
