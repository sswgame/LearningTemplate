<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 기본 배치(Reset Default Layout)는 가운데 영역의 앞 탭이 Scene 이다. 열린 도구 패널(Prefab Overrides)이 같은 영역에 붙어도 그렇다.
  ImGui 는 새로 붙은 탭 가운데 마지막 것을 고르고 처음 나타난 창에 포커스를 주므로, 붙인 순서로는 Scene 이 앞에 서지 않는다(EditorDockLayout::updateDefaultTabSelection).
  저장된 레이아웃이 없으면(AppScenarioTest 는 늘 빈 상태 폴더로 시작한다) 이 규칙이 Scene 탭을 앞에 둔다.
  실행: py -3 -m Scripts scenario defaultlayout
-->
<Scenario name="editor.defaultlayout" isolated="true" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<!-- Prefab Overrides 를 연다(가운데 영역의 앞 탭이 된다) — 씬 뷰가 가려진 상태에서 시작한다 -->
	<At frame="5"><DevCommand line="layout.reset"/></At>
	<At frame="20"><DevCommand line="panel.focus prefab_editor"/></At>
	<At frame="40"><Expect probe="Editor.SceneViewDrawn" equals="0"/></At>

	<!-- 기본 배치로 되돌리면 Prefab Overrides 가 열린 채여도 Scene 탭이 앞이다 -->
	<At frame="45"><DevCommand line="layout.reset"/></At>
	<At frame="80">
		<Expect probe="Editor.SceneViewDrawn" equals="1"/>
		<Expect probe="Editor.GridStep" near="1" tolerance="0.001"/>
	</At>
	<At frame="85"><EditorClick mark="sceneView.canvas"/></At>

	<!-- 기본 배치의 아래 도크는 글자 높이의 배수라 Output Log 내용 영역에 글자 줄이 8줄 넘게 든다(첫 화면에서 로그가 한두 줄만 보이던 결함) -->
	<At frame="90"><Variable name="gv_editorProbePanel" value="console"/></At>
	<At frame="95"><Expect probe="Editor.PanelContentLines" atLeast="8"/></At>

	<At frame="100"><Pass/></At>
</Scenario>
