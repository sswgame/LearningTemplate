<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 에디터 유휴(FramePacingState::EditorIdle = 6)에서 깨어나는 조건이 빠지지 않았는지 본다(감사 SB P1 후속).
  에디터가 다시 그릴 까닭(EditorRedrawReason: 입력 · 잡은 항목 · 플레이 · 알림 · 패널의 연속 프레임 요청)이 없는 프레임이 이어지면 앱 루프는 창 메시지까지 잔다.
  까닭 하나를 빠뜨리면 그 화면이 멈추므로, 유휴에 든 뒤의 ① 키 입력 ② 마우스 이동이 바로 반영되고 ③ 알림 토스트가 떠 있는 동안 깨어 있다가 시간이 지나 사라지는지 본다.
  시나리오 실행은 보통 전속(Automation = 3)이라 유휴에 들지 않는다 — gv_framePacing=WindowState 로 자동화 중에도 창 · 에디터 상태를 따르게 한다(끝에서 Auto 로 되돌린다).
  탐침: Engine.FramePacingState(앱 루프 상태 번호), Editor.NotificationCount(떠 있는 알림 수). 개발 명령 notify.push <초> <글> 이 토스트를 띄운다.
  실행: py -3 -m Scripts scenario idle
-->
<Scenario name="editor.idle" fixedDelta="0.0166667" timeoutFrames="60000" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/><Variable name="gv_editorProbePanel" value="material"/></At>
	<At frame="15"><Expect probe="Engine.FramePacingState" equals="3"/></At>
	<At frame="20"><Variable name="gv_framePacing" value="WindowState"/></At>
	<!-- 기동 알림이 사라지고 조용한 프레임이 쌓이면 유휴에 든다 -->
	<At frame="25"><WaitUntil probe="Editor.NotificationCount" equals="0" timeoutFrames="20000"/></At>
	<At frame="26"><WaitUntil probe="Engine.FramePacingState" equals="6" timeoutFrames="600"/></At>

	<!-- ① 키 입력: Quick Open 으로 머티리얼을 연다 — 유휴 중에 친 키가 그대로 문서를 연다 -->
	<At frame="30"><Variable name="gv_editorProbeAsset" value="engine/automation/editor/materialpreview/previewred.material"/></At>
	<At frame="35"><EditorKey key="Ctrl+P"/></At>
	<At frame="36"><Expect probe="Engine.FramePacingState" atMost="1"/></At>
	<At frame="50"><EditorText value="previewred.material"/></At>
	<At frame="65"><EditorKey key="Enter"/></At>
	<At frame="70"><WaitUntil probe="Editor.MaterialDocumentIsProbeAsset" equals="1" timeoutFrames="600"/></At>
	<!-- 미리보기 창은 틱하는 씬을 그려 연속 프레임을 청한다 — 닫으면 다시 조용해진다 -->
	<At frame="75"><DevCommand line="panel.close material"/></At>
	<At frame="80"><WaitUntil probe="Engine.FramePacingState" equals="6" timeoutFrames="600"/></At>

	<!-- ② 마우스 이동: 유휴 중의 이동이 바로 깨운다 -->
	<At frame="90"><EditorHover mark="sceneView.canvas" anchor="0.30,0.50"/></At>
	<At frame="91"><Expect probe="Engine.FramePacingState" atMost="1"/></At>
	<At frame="92"><EditorHover mark="sceneView.canvas" anchor="0.60,0.50"/></At>
	<At frame="100"><WaitUntil probe="Engine.FramePacingState" equals="6" timeoutFrames="600"/></At>

	<!-- ③ 알림: 떠 있는 동안은 깨어 있고, 시간이 지나 사라진 뒤 다시 잔다 -->
	<At frame="110"><DevCommand line="notify.push 1 idle scenario toast"/></At>
	<At frame="112">
		<Expect probe="Editor.NotificationCount" equals="1"/>
		<Expect probe="Engine.FramePacingState" atMost="1"/>
	</At>
	<At frame="113"><WaitUntil probe="Editor.NotificationCount" equals="0" timeoutFrames="20000"/></At>
	<At frame="114"><WaitUntil probe="Engine.FramePacingState" equals="6" timeoutFrames="600"/></At>

	<At frame="120"><Variable name="gv_framePacing" value="Auto"/></At>
	<At frame="122"><Expect probe="Engine.FramePacingState" equals="3"/></At>
	<At frame="125"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
