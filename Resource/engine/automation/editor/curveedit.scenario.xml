<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — FloatCurve 편집기(T1): GameCamera 에 시험 컴포넌트(EditorCurveProbeComponent, 키 둘)를 달고, 인스펙터의 커브 미리보기
  (이름표 inspector.curve._curve)를 눌러 편집기를 연다. 빈 곳 오른쪽 클릭 → Add Key 로 키가 셋이 되고 되돌리기가 한 줄 는다.
  키 하나를 끌어 놓으면 되돌리기가 한 줄만 는다(놓을 때 한 번). 편집기를 닫고 Ctrl+Z 두 번이면 키가 다시 둘이다.
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/curveedit.scenario.xml -dx12
-->
<Scenario name="editor.curveedit" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="50"><EditorClick mark="hierarchy.row.GameCamera"/></At>
	<At frame="60">
		<DevCommand line="component.add EditorCurveProbeComponent"/>
		<Variable name="gv_editorProbeProperty" value="EditorCurveProbeComponent._curve"/>
	</At>
	<At frame="75">
		<Expect probe="Editor.SelectedCurveKeyCount" equals="2"/>
		<Expect probe="Editor.UndoCount" equals="1"/>
	</At>
	<At frame="80"><EditorClick mark="inspector.curve._curve"/></At>
	<At frame="100"><EditorClick mark="curve.canvas" button="1"/></At>
	<At frame="115"><EditorClick mark="curve.menu.addKey"/></At>
	<At frame="135">
		<Expect probe="Editor.SelectedCurveKeyCount" equals="3"/>
		<Expect probe="Editor.UndoCount" equals="2"/>
	</At>
	<At frame="140"><EditorDrag mark="curve.key.0" dy="-60"/></At>
	<At frame="165">
		<Expect probe="Editor.SelectedCurveKeyCount" equals="3"/>
		<Expect probe="Editor.UndoCount" equals="3"/>
	</At>
	<At frame="170"><EditorClick mark="hierarchy.row.GameCamera"/></At>
	<At frame="190"><EditorKey key="Ctrl+Z"/></At>
	<At frame="205"><EditorKey key="Ctrl+Z"/></At>
	<At frame="225">
		<Expect probe="Editor.SelectedCurveKeyCount" equals="2"/>
		<Expect probe="Editor.UndoIndex" equals="1"/>
	</At>
	<At frame="230"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
