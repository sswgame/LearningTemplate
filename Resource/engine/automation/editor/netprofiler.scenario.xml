<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 네트워크 프로파일러(서버 디버깅 S5). 전용 서버 + App 클라이언트 1 을 띄우고, 클라이언트가 패킷 하나 크기의 신뢰 메시지 100 개를
  서버에 흘린다(net.traffic). netplay.profile 은 Multiplayer 창 Profiler 탭이 보일 때 하는 일(0.5 초마다 모든 프로세스에 net.stats 를 묻고
  답을 시계열에 쌓기)을 3 초 동안 하며 그 프레임을 붙잡는다. 탐침이 쌓인 표본 수(Editor.NetPlayProfilerSamples)와
  한 프로세스가 보인 가장 큰 초당 보낸 바이트(Editor.NetPlayProfilerPeakSentBytesPerSecond)를 보고한다.
  실행: py -3 -m Scripts scenario netprofiler
-->
<Scenario name="editor.netprofiler" isolated="true" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="20">
		<Expect probe="Editor.NetPlayProcessCount" equals="0"/>
		<Expect probe="Editor.NetPlayProfilerSamples" equals="0"/>
		<DevCommand line="netplay.start dedicated 1"/>
	</At>
	<At frame="21"><DevCommand line="netplay.wait 1 120"/></At>
	<At frame="22">
		<Expect probe="Editor.NetPlayConnectedClients" equals="1"/>
		<DevCommand line="netplay.command clients net.traffic 100 1000"/>
	</At>
	<At frame="23"><DevCommand line="netplay.profile 3"/></At>
	<At frame="24">
		<ExpectLog contains="net traffic queued 100 reliable message(s) to 1 connection(s)" atLeast="1"/>
		<ExpectLog contains="netplay profile has" atLeast="1"/>
		<Expect probe="Editor.NetPlayProfilerSamples" atLeast="4"/>
		<Expect probe="Editor.NetPlayProfilerPeakSentBytesPerSecond" atLeast="1"/>
	</At>
	<At frame="25"><DevCommand line="netplay.stop"/></At>
	<At frame="26">
		<Expect probe="Editor.NetPlayProcessCount" equals="0"/>
		<Pass/>
	</At>
</Scenario>
