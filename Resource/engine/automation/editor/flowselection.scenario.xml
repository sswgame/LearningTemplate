<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 선택 · 포커스 · 되돌리기가 창을 넘어 하나다(언리얼 · 유니티의 전역 선택과 전역 되돌리기).
  ① Hierarchy 에서 고른 오브젝트가 씬 뷰 외곽선과 인스펙터의 대상이 된다. Ctrl+클릭은 선택에 더한다.
  ② 인스펙터로 이름을 바꾼 뒤 포커스를 콘텐츠 브라우저로 옮겨 Ctrl+Z 를 눌러도 씬 편집이 되돌려지고, 씬 뷰에 포커스를 두고 다시 실행해도 같다.
  ③ Hierarchy 에서 Delete 로 지우면 선택이 비고, 되돌리면 같은 id 로 돌아와 다시 골라진다 — 씬 내용 해시가 지우기 전과 같다.
  실행: py -3 -m Scripts scenario flowselection
-->
<Scenario name="editor.flowselection" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="0"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10"><DevCommand line="layout.reset"/></At>
	<At frame="30">
		<Expect probe="Editor.SelectedNames" is="(none)"/>
		<Remember probe="Editor.SceneHash" as="opened"/>
	</At>

	<!-- ① Hierarchy 선택 → 씬 뷰 외곽선 · 인스펙터 -->
	<At frame="40"><EditorClick mark="hierarchy.row.TestMesh"/></At>
	<At frame="60">
		<Expect probe="Editor.SelectedNames" is="TestMesh"/>
		<Expect probe="Editor.SelectionOutlineBoxes" atLeast="1"/>
		<Expect probe="Editor.SelectedComponentCount" atLeast="1"/>
	</At>
	<At frame="70"><EditorClick mark="hierarchy.row.GameCamera" mods="ctrl"/></At>
	<At frame="90"><Expect probe="Editor.SelectedNames" is="GameCamera,TestMesh"/></At>
	<At frame="100"><EditorClick mark="hierarchy.row.TestMesh"/></At>
	<At frame="115"><Expect probe="Editor.SelectedNames" is="TestMesh"/></At>

	<!-- ② 인스펙터로 이름 → 다른 창에 포커스를 두고 되돌리기 · 다시 실행 -->
	<At frame="125"><EditorClick mark="inspector.name"/></At>
	<At frame="135"><EditorKey key="Ctrl+A"/></At>
	<At frame="140"><EditorText value="Renamed"/></At>
	<At frame="145"><EditorKey key="Enter"/></At>
	<At frame="160">
		<Expect probe="Editor.SelectedNames" is="Renamed"/>
		<Expect probe="Editor.UndoState" is="1/1:Rename GameObject"/>
		<Remember probe="Editor.SceneHash" as="renamed"/>
	</At>
	<At frame="170"><DevCommand line="panel.focus content_browser"/></At>
	<At frame="190"><EditorKey key="Ctrl+Z"/></At>
	<At frame="205">
		<Expect probe="Editor.UndoIndex" equals="0"/>
		<Expect probe="Editor.SelectedNames" is="TestMesh"/>
		<Expect probe="Editor.SceneHash" sameAs="opened"/>
	</At>
	<At frame="210"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="230"><EditorKey key="Ctrl+Y"/></At>
	<At frame="245">
		<Expect probe="Editor.UndoIndex" equals="1"/>
		<Expect probe="Editor.SelectedNames" is="Renamed"/>
		<Expect probe="Editor.SceneHash" sameAs="renamed"/>
	</At>

	<!-- ③ 지우기 → 되돌리기: 같은 오브젝트가 돌아와 골라진다 -->
	<At frame="255"><EditorClick mark="hierarchy.row.Renamed"/></At>
	<At frame="265"><EditorKey key="Delete"/></At>
	<At frame="280">
		<EditorExpectObject name="Renamed" count="0"/>
		<Expect probe="Editor.SelectedNames" is="(none)"/>
		<Expect probe="Editor.UndoIndex" equals="2"/>
	</At>
	<At frame="290"><EditorKey key="Ctrl+Z"/></At>
	<At frame="310">
		<EditorExpectObject name="Renamed" selected="1"/>
		<Expect probe="Editor.SceneHash" sameAs="renamed"/>
		<Expect probe="Editor.UndoIndex" equals="1"/>
	</At>
	<At frame="320"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
