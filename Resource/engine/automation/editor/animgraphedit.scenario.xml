<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 애니메이션 그래프 전이 편집(N8): 노드를 하나 찾아 넣고, Walk 를 누른 뒤 Ctrl 로 Attack 을 골라 Link Selected 로 잇는다
  (탐침 Editor.AnimationGraphLinkCount). 오른쪽 인스펙터에서 그 전이를 골라 조건(파라미터 Speed · 비교 >)을 적으면 조건 있는 전이가 하나가 되고
  (Editor.AnimationGraphConditionCount), 저장한 뒤 조건을 지워도 Load 가 저장한 조건을 되읽는다.
  문서: 테스트 그래프(animgraphedit/animgraphedit.animgraph.xml — 노드 Idle · Walk, 전이 둘)의 실행마다 새 사본(scratch/animgraphedit — <Scratch>)을
  `asset.openScratch` 로 열어 거기에 저장한다. 추적 중인 원본에 쓰면 백엔드별 체인이 병렬 조각에서 같은 파일을 동시에 고쳐, 한 프로세스의 Save 와 Load 사이에
  다른 프로세스의 마지막 저장(원래 모양)이 끼어 Load 가 옛 내용을 읽었다(체인에서만 지던 원인). Quick Open 은 파일 이름으로 찾아 원본과 사본 중 하나가 걸리므로 쓰지 않는다.
  경로 없는 기본 문서(상태 폴더의 AnimationGraphData.xml)에 쓰면 체인의 뒤 시나리오(graphaddnode)가 노드 셋으로 시작한다.
  기본 문서는 노드 둘 · 전이 하나라 테스트 그래프는 전이를 둘로 두어 열렸는지 가린다(여는 것은 다음 프레임 이후라 WaitUntil 로 기다린다).
  끝에서 추가한 노드를 지우고 저장하는 것은 지우기 · 저장 확인의 일부다(사본에만 쓰므로 원본은 바뀌지 않는다).
  실행: py -3 -m Scripts scenario animgraphedit
-->
<Scenario name="editor.animgraphedit" fixedDelta="0.0166667" timeoutFrames="1100" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/animgraphedit" as="scratch/animgraphedit"/>
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40"><DevCommand line="panel.focus animation_graph"/></At>
	<At frame="60"><DevCommand line="asset.openScratch scratch/animgraphedit/animgraphedit.animgraph.xml"/></At>
	<At frame="100"><WaitUntil probe="Editor.AnimationGraphLinkCount" equals="2"/></At>
	<At frame="130"><Expect probe="Editor.GraphNodeCount" equals="2"/><Expect probe="Editor.AnimationGraphLinkCount" equals="2"/></At>
	<At frame="135"><EditorClick mark="graph.canvas" button="1" anchor="0.06,0.9"/></At>
	<At frame="155"><EditorText value="att"/></At>
	<At frame="165"><EditorKey key="Enter"/></At>
	<At frame="190"><Expect probe="Editor.GraphNodeCount" equals="3"/></At>
	<At frame="195"><EditorClick mark="animationGraph.node.Walk"/></At>
	<At frame="215"><EditorClick mark="animationGraph.node.Attack" mods="ctrl"/></At>
	<At frame="235"><EditorClick mark="animationGraph.linkSelected"/></At>
	<At frame="255"><Expect probe="Editor.AnimationGraphLinkCount" equals="3"/><Expect probe="Editor.AnimationGraphConditionCount" equals="0"/></At>
	<At frame="260"><EditorClick mark="animationGraph.link.2"/></At>
	<At frame="280"><EditorClick mark="animationGraph.condition.param"/></At>
	<At frame="295"><EditorText value="Speed"/></At>
	<At frame="305"><EditorKey key="Enter"/></At>
	<At frame="320"><EditorClick mark="animationGraph.condition.op"/></At>
	<At frame="340"><EditorClick mark="animationGraph.condition.op.1"/></At>
	<At frame="360"><Expect probe="Editor.AnimationGraphConditionCount" equals="1"/></At>
	<At frame="365"><EditorClick mark="animationGraph.save"/></At>
	<At frame="385"><EditorClick mark="animationGraph.link.2"/></At>
	<At frame="400"><EditorClick mark="animationGraph.condition.op"/></At>
	<At frame="420"><EditorClick mark="animationGraph.condition.op.0"/></At>
	<At frame="440"><Expect probe="Editor.AnimationGraphConditionCount" equals="0"/></At>
	<At frame="445"><EditorClick mark="animationGraph.load"/></At>
	<At frame="470"><Expect probe="Editor.AnimationGraphConditionCount" equals="1"/><Expect probe="Editor.AnimationGraphLinkCount" equals="3"/></At>
	<At frame="475"><EditorClick mark="animationGraph.node.Attack"/></At>
	<At frame="490"><EditorKey key="Delete"/></At>
	<At frame="510"><Expect probe="Editor.GraphNodeCount" equals="2"/><Expect probe="Editor.AnimationGraphLinkCount" equals="2"/></At>
	<At frame="515"><EditorClick mark="animationGraph.save"/></At>
	<At frame="535"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
