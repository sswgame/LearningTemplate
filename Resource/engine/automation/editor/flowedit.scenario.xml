<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 에셋 배치부터 다시 읽기까지 한 줄로: 콘텐츠 브라우저의 메시를 씬 뷰로 끌어 놓고(배치) → 메시 모디파이어로 휘기를 걸고 →
  인스펙터로 이름을 바꾸고 → 다른 이름으로 저장 → 플레이 인 → 플레이 아웃(씬 내용 · 되돌리기 스택 · 모디파이어 미리보기가 그대로) →
  되돌리기 · 다시 실행 → 새 씬 → 저장한 씬 다시 열기(씬 내용 해시가 저장할 때와 같다).
  모디파이어 스택은 메시 옆 사이드카에 저장되므로(리소스 트리) 이 시나리오는 스택을 저장하지 않는다 — 미리보기 메시만 쓴다.
  실행: py -3 -m Scripts scenario flowedit
-->
<Scenario name="editor.flowedit" fixedDelta="0.0166667" timeoutFrames="2000" startAfter="Immediately" input="exclusive">
	<At frame="10"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="15"><DevCommand line="layout.reset"/></At>
	<At frame="20"><DevCommand line="panel.resetOptional"/></At>
	<At frame="30"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="31"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="40"><WaitUntil probe="Editor.UndoCount" equals="0" timeoutFrames="600"/></At>

	<!-- ① 배치 — 콘텐츠 브라우저에서 메시를 찾아 씬 뷰로 끌어 놓는다 -->
	<At frame="50"><DevCommand line="panel.focus content_browser"/></At>
	<At frame="60"><DevCommand line="content.open game/empty/models"/></At>
	<At frame="70"><EditorClick mark="contentBrowser.search"/></At>
	<At frame="75"><EditorText value="crate_medium.mesh"/></At>
	<At frame="95"><EditorDrag mark="contentBrowser.asset.crate_medium.mesh" toMark="sceneView.canvas"/></At>
	<At frame="125">
		<Expect probe="Editor.UndoCount" equals="1"/>
		<Expect probe="Editor.SelectionCount" equals="1"/>
		<Expect probe="Editor.SceneDirty" equals="1"/>
	</At>

	<!-- ② 메시 모디파이어 — 고른 것을 대상으로 휘기 -->
	<At frame="130"><DevCommand line="panel.focus meshmodifiers.stack"/></At>
	<At frame="145"><EditorClick mark="meshmodifiers.useSelection"/></At>
	<At frame="160"><EditorClick mark="meshmodifiers.add"/></At>
	<At frame="170"><EditorClick mark="meshmodifiers.category.Deform"/></At>
	<At frame="180"><EditorClick mark="meshmodifiers.item.bend"/></At>
	<At frame="195"><EditorClick mark="meshmodifiers.param.Angle" mods="ctrl"/></At>
	<At frame="205"><EditorText value="80"/></At>
	<At frame="210"><EditorKey key="Enter"/></At>
	<At frame="230">
		<Expect probe="MeshModifiers.ModifierCount" equals="1"/>
		<Expect probe="MeshModifiers.GPUPreviewActive" equals="1"/>
	</At>
	<At frame="235"><DevCommand line="panel.close meshmodifiers.stack"/></At>

	<!-- ③ 인스펙터로 이름 -->
	<At frame="245"><DevCommand line="panel.focus inspector"/></At>
	<At frame="255"><EditorClick mark="inspector.name"/></At>
	<At frame="265"><EditorKey key="Ctrl+A"/></At>
	<At frame="270"><EditorText value="PlacedCrate"/></At>
	<At frame="275"><EditorKey key="Enter"/></At>
	<At frame="290">
		<EditorExpectObject name="PlacedCrate" component="MeshComponent" selected="1"/>
		<Expect probe="Editor.SelectedNames" is="PlacedCrate"/>
	</At>

	<!-- ④ 저장 -->
	<At frame="300"><DevCommand line="scene.saveAs Saved/Automation/editor.flowedit/flowedit.scene.xml"/></At>
	<At frame="315">
		<Expect probe="Editor.SceneDirty" equals="0"/>
		<Remember probe="Editor.SceneHash" as="saved"/>
		<Remember probe="Editor.UndoState" as="savedUndo"/>
		<Remember probe="Editor.StateHash" as="savedState"/>
	</At>

	<!-- ⑤ 플레이 인 → 플레이 아웃 -->
	<At frame="320"><DevCommand line="play"/></At>
	<At frame="321"><WaitUntil probe="Editor.PlayState" equals="1" timeoutFrames="600"/></At>
	<At frame="360"><DevCommand line="stop"/></At>
	<At frame="361"><WaitUntil probe="Editor.PlayState" equals="0" timeoutFrames="600"/></At>
	<At frame="380">
		<Expect probe="Editor.SceneHash" sameAs="saved"/>
		<Expect probe="Editor.UndoState" sameAs="savedUndo"/>
		<Expect probe="Editor.SelectedNames" is="PlacedCrate"/>
		<Expect probe="Editor.StateHash" sameAs="savedState"/>
		<Expect probe="MeshModifiers.GPUPreviewActive" equals="1"/>
	</At>

	<!-- ⑥ 되돌리기 · 다시 실행 -->
	<At frame="390"><DevCommand line="editor edit.undo"/></At>
	<At frame="405">
		<EditorExpectObject name="PlacedCrate" count="0"/>
		<Expect probe="Editor.SceneHash" differsFrom="saved"/>
		<Expect probe="Editor.SceneDirty" equals="1"/>
	</At>
	<At frame="410"><DevCommand line="editor edit.redo"/></At>
	<At frame="425">
		<Expect probe="Editor.SceneHash" sameAs="saved"/>
		<EditorExpectObject name="PlacedCrate" selected="1"/>
	</At>

	<!-- ⑦ 다른 씬 → 저장한 씬 다시 열기(되돌리기 · 다시 실행으로 변경 표시가 켜져 있어 scene.new 는 확인 상자를 띄운다 — 확인 없이 여는 scene.open 을 쓴다) -->
	<At frame="430"><DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/></At>
	<At frame="431"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="445"><EditorExpectObject name="PlacedCrate" count="0"/></At>
	<At frame="450"><DevCommand line="scene.open Saved/Automation/editor.flowedit/flowedit.scene.xml"/></At>
	<At frame="451"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="480">
		<EditorExpectObject name="PlacedCrate" component="MeshComponent"/>
		<Expect probe="Editor.SceneHash" sameAs="saved"/>
		<Expect probe="Editor.SceneDirty" equals="0"/>
		<Expect probe="Editor.UndoCount" equals="0"/>
	</At>
	<At frame="490"><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
