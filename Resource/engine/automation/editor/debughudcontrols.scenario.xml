<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 디버그 HUD 의 에디터 연결. 게임 뷰 툴바의 HUD 단추가 게임 HUD 를 켜고(Editor.DebugHUDEnabled), 오른쪽 클릭 팝업의
  섹션 체크 상자가 섹션을 켠다(Editor.DebugHUDShownSections — 기본 켜짐 넷 + physics). 씬 뷰 HUD 상자는 같은 섹션을 그리고
  (Editor.SceneViewHUDSections), 툴바 HUD 단추로 뷰마다 끄고 켠다. 환경설정의 Editor/Debug HUD 쪽에서 게임 HUD 를 다시 끈다.
  HUD 상태는 엔진 사용자 설정이라 사용자 파일에 남는다 — 처음과 끝에 기본값(꺼짐 · physics 꺼짐)으로 둔다.
  실행: py -3 -m Scripts scenario debughudcontrols
-->
<Scenario name="editor.debughudcontrols" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<At frame="5"><DevCommand line="hud off"/><DevCommand line="hud physics off"/></At>
	<At frame="20"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="25"><DevCommand line="layout.reset"/></At>
	<At frame="40"><DevCommand line="panel.focus game_view"/></At>
	<At frame="70"><Expect probe="Editor.DebugHUDEnabled" equals="0"/><Expect probe="Editor.DebugHUDShownSections" equals="4"/></At>
	<At frame="75"><EditorClick mark="gameView.hud"/></At>
	<At frame="95"><Expect probe="Editor.DebugHUDEnabled" equals="1"/></At>
	<At frame="100"><EditorClick mark="gameView.hud" button="1"/></At>
	<At frame="120"><EditorClick mark="debugHUD.section.physics"/></At>
	<At frame="140"><Expect probe="Editor.DebugHUDShownSections" equals="5"/><EditorKey key="Escape"/></At>
	<At frame="150"><DevCommand line="panel.focus scene_view"/></At>
	<At frame="170"><Expect probe="Editor.SceneViewHUDSections" equals="0"/><EditorClick mark="viewport.hud"/></At>
	<At frame="200"><Expect probe="Editor.SceneViewHUDSections" atLeast="2"/></At>
	<At frame="205"><EditorClick mark="viewport.hud"/></At>
	<At frame="225"><Expect probe="Editor.SceneViewHUDSections" equals="0"/></At>
	<At frame="230"><EditorClick mark="viewport.hud"/></At>
	<At frame="260"><Expect probe="Editor.SceneViewHUDSections" atLeast="2"/></At>
	<At frame="265"><DevCommand line="editor editor.preferences"/></At>
	<At frame="280"><DevCommand line="panel.focus preferences"/></At>
	<At frame="300"><EditorClick mark="preferences.search"/></At>
	<At frame="310"><EditorText value="Debug HUD"/></At>
	<At frame="340"><EditorClick mark="preferences.debugHUD.shown"/></At>
	<At frame="360"><Expect probe="Editor.DebugHUDEnabled" equals="0"/></At>
	<At frame="365"><DevCommand line="hud off"/><DevCommand line="hud physics off"/></At>
	<At frame="380"><Expect probe="Editor.DebugHUDShownSections" equals="4"/><Variable name="gv_editorUiScale" value="0"/><Pass/></At>
</Scenario>
