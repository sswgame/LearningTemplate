<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 ② 화면 — 뷰 스크린샷이 실제 그림인지, 창을 단계별로 줄여도 도크 칸이 화면 안 · 최소 변을 지키고 창이 에디터 최소 크기(960x540)에서
  멈추는지, UI 배율 1.5 에서도 같은지, 테마를 바꾸고 Classic Dark 의 테마 대화상자에서 스와치를 누르면 액센트가 바뀌는지.
  스크린샷은 에디터 UI 가 아니라 주 출력 그림이다(Present 캡처가 주 출력 렌더 타깃을 복사한다). 기본 배치는 Scene 탭이 앞이라 씬 뷰 그림이다.
  실행: App.exe -EnableEditor -scenario=engine/automation/editor/screen.scenario.xml -dx12   (AppScenarioTest.EditorScenariosPassOnEveryBackend 가 백엔드마다 돈다)
-->
<Scenario name="editor.screen" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 1) 뷰 스크린샷 — 까만 빈 그림이 아니다 -->
	<At frame="90"><Screenshot file="gameview.ppm"/></At>
	<At frame="91"><ExpectImage file="gameview.ppm" metric="meanLuma" atLeast="0.02"/></At>

	<!-- 2) 창을 단계별로 줄인다 — 마지막(640x360)은 에디터 최소 크기보다 작아 거기서 멈춰야 한다 -->
	<At frame="130"><ResizeWindow width="1600" height="900"/></At>
	<At frame="140"><EditorExpectDockLayout/></At>
	<At frame="145"><ResizeWindow width="1280" height="720"/></At>
	<At frame="155"><EditorExpectDockLayout/></At>
	<At frame="160"><ResizeWindow width="1024" height="600"/></At>
	<At frame="170"><EditorExpectDockLayout/></At>
	<At frame="175"><ResizeWindow width="640" height="360"/></At>
	<At frame="185"><EditorExpectDockLayout/></At>

	<!-- 3) UI 배율 1.5 — 큰 창에서 칸이 그대로 화면 안에 들고, 뷰가 그대로 그려진다 -->
	<At frame="190"><ResizeWindow width="1600" height="900"/><Variable name="gv_editorUiScale" value="1.5"/></At>
	<At frame="200">
		<Expect probe="Editor.UiScale" near="1.5" tolerance="0.01"/>
		<EditorExpectDockLayout/>
	</At>
	<At frame="210"><Screenshot file="gameview_scaled.ppm"/></At>
	<At frame="211"><ExpectImage file="gameview_scaled.ppm" metric="meanLuma" atLeast="0.02"/></At>

	<!-- 4) 테마 — 프리셋을 바꾸고, Classic Dark 에서 테마 대화상자를 열어 셋째 스와치(Neon Violet 0xA65AF2)를 누른다 -->
	<At frame="220"><DevCommand line="editor.theme MidnightBlue"/></At>
	<At frame="225"><Expect probe="Editor.ThemePreset" equals="2"/></At>
	<At frame="230"><DevCommand line="editor.theme ClassicDark"/></At>
	<At frame="235">
		<Expect probe="Editor.ThemePreset" equals="3"/>
		<DevCommand line="editor editor.themeSettings"/>
	</At>
	<At frame="250"><EditorClick mark="theme.swatch.violet"/></At>
	<At frame="265">
		<Expect probe="Editor.AccentColor" equals="10902002"/>
		<Expect probe="Editor.ThemePreset" equals="3"/>
		<EditorExpectDockLayout/>
	</At>
	<At frame="270"><Screenshot file="gameview_classicdark.ppm"/></At>
	<At frame="271"><ExpectImage file="gameview_classicdark.ppm" metric="meanLuma" atLeast="0.02"/></At>

	<!-- 되돌리기 — 사용자 에디터 설정 파일은 AppScenarioTest 가 바이트째 되돌린다 -->
	<At frame="280"><DevCommand line="editor.theme ModernDark"/><Variable name="gv_editorUiScale" value="0"/></At>
	<At frame="290"><Pass/></At>
</Scenario>
