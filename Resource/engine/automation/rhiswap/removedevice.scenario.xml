<?xml version="1.0" encoding="utf-8"?>
<!--
  장치 제거 시나리오 — 개발 명령 rhi.removeDevice 가 TDR 처럼 장치를 제거한 뒤에도 프레임이 계속 돌고(대기가 제거를 보고 빠져나온다) 종료가 멈추지 않는다.
  실제 TDR 은 되풀이하면 어댑터가 망가지므로 ID3D12Device5::RemoveDevice 로 흉내 낸다. DirectX 12 만 제거할 수 있어서 AppScenarioTest 가 줍지 않는 이 하위 폴더에 둔다.
  통과는 종료 코드 0 과 제한 시간 안의 종료다(멈추면 바깥 시한이 죽인다). 제거 뒤의 [Error] 로그는 예상된 것이다.
  실행: App.exe -dx12 -scenario=engine/automation/rhiswap/removedevice.scenario.xml (-EnableEditor 를 붙이면 에디터 렌더러도 지난다)
-->
<Scenario name="rhiswap.removedevice" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<At frame="30"><DevCommand line="rhi.removeDevice"/></At>
	<At frame="90"><Pass/></At>
</Scenario>
