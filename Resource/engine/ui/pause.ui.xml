<UiDocument _schemaVersion="1">
	<UiScreenDesc _bPausesGame="true" _defaultFocus="Resume" />
	<SafeZonePanel>
		<CanvasPanel>
			<BorderPanel _name="Window" _styleClass="window">
				<_slot _anchorMin="0.5,0.5"
				       _anchorMax="0.5,0.5"
				       _offsetMax="0,0"
				       _bAutoSize="true"
				       _growHorizontal="Both"
				       _growVertical="Both" />
				<BoxPanel _spacing="12" _orientation="Vertical">
					<TextWidget _name="Title" _styleClass="title" _text="Paused" />
					<ButtonWidget _name="Resume" _styleClass="primary" _command="Resume">
						<TextWidget _text="Resume" />
					</ButtonWidget>
					<ButtonWidget _name="Options" _command="OpenOptions">
						<TextWidget _text="Options" />
					</ButtonWidget>
					<UserWidget _name="Hint" _document="engine/ui/parts/inputhint.ui.xml" />
				</BoxPanel>
			</BorderPanel>
		</CanvasPanel>
	</SafeZonePanel>
</UiDocument>
