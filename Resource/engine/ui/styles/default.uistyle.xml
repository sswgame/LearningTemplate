<UiStyleSheet _schemaVersion="1">
	<Variable _name="accent" _value="0.25,0.5,1,1" />
	<Variable _name="accentHover" _value="0.375,0.625,1,1" />
	<Variable _name="accentPressed" _value="0.125,0.375,0.875,1" />
	<Variable _name="surface" _value="0.125,0.125,0.25,0.875" />
	<Variable _name="text" _value="0.92,0.93,0.95,1" />
	<!-- 색각 안전 팔레트 — 경고 주황 · 성공 파랑(빨강 · 초록을 짝으로 쓰지 않는다). 색만이 아니라 모양으로도 다르다: 경고는 두꺼운 테두리 · 각진 모서리, 성공은 얇은 테두리 · 둥근 모서리. -->
	<Variable _name="warning" _value="1,0.6,0,1" />
	<Variable _name="success" _value="0.35,0.7,1,1" />
	<Rule _selector="BorderPanel.window" _backgroundColor="$surface" _cornerRadius="8,8,8,8" _shadowColor="0,0,0,0.5" _shadowOffset="0,6" _shadowBlur="16" _padding="24,24,24,24" />
	<Rule _selector="ButtonWidget.primary" _backgroundColor="$accent" _transition="_backgroundColor 0.12 EaseOut" />
	<Rule _selector="ButtonWidget.primary:hover" _backgroundColor="$accentHover" />
	<Rule _selector="ButtonWidget.primary:pressed" _backgroundColor="$accentPressed" />
	<Rule _selector="TextWidget.title" _fontSize="32">
		<_font _weight="Bold" />
	</Rule>
	<Rule _selector="BorderPanel.window TextWidget" _textColor="$text" />
	<Rule _selector="BorderPanel.warning" _borderWidth="3" _borderColor="$warning" _cornerRadius="0,0,0,0" />
	<Rule _selector="BorderPanel.success" _borderWidth="1" _borderColor="$success" _cornerRadius="12,12,12,12" />
	<Rule _selector="TextWidget.hud" _fontSize="24" _textOutlineColor="0,0,0,0.85" _textOutlineWidth="2">
		<_font _weight="Bold" />
	</Rule>
	<Rule _selector="TextWidget.damage" _fontSize="28" _textOutlineColor="0,0,0,0.9" _textOutlineWidth="2">
		<_font _weight="Bold" />
	</Rule>
	<Rule _selector="TextWidget.loading" _fontSize="28" _textColor="$text">
		<_font _weight="Bold" />
	</Rule>
	<Rule _selector="TextWidget.tip" _fontSize="20" _textColor="0.7,0.72,0.78,1" />
</UiStyleSheet>
