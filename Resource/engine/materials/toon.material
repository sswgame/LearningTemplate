<?xml version="1.0" encoding="utf-8"?>
<!-- 셀 셰이딩(툰) 머티리얼 — VRM MToon 1.0 의 파라미터 체계(toon.hlsl). 프로퍼티 이름 · 타입은 toon.hlsl 의 SW_MATERIAL 구조체와 같다.
     정적 스위치: Outline(MATERIAL_OUTLINE — 메시 외곽선 패스가 이 머티리얼을 그린다) · AlphaCutoff(MATERIAL_ALPHA_CUTOFF) ·
     TwoSided(MATERIAL_TWO_SIDED — 컬링을 끄고 뒷면 노멀을 뒤집는다). 반투명은 blendMode="Transparent" + _alwaysDefines 의 MATERIAL_BLEND_TRANSLUCENT. -->
<MaterialDesc formatVersion="0" name="Toon" shaderPath="engine/shaders/toon.hlsl" blendMode="Opaque">
	<_properties>
		<item name="baseColor" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Base Color" group="Shading" bHdr="0" bSrgb="1"/>
		<item name="shadeColor" type="Color" shaderType="Float4" defaultValue="0.6 0.55 0.7 1.0" displayName="Shade Color" group="Shading" bHdr="0" bSrgb="1"/>
		<item name="emissiveColor" type="Color" shaderType="Float4" defaultValue="0.0 0.0 0.0 1.0" displayName="Emissive Color" group="Emission" bHdr="1" bSrgb="1"/>
		<item name="rimColor" type="Color" shaderType="Float4" defaultValue="0.0 0.0 0.0 1.0" displayName="Rim Color" group="Rim" bHdr="1" bSrgb="1"/>
		<item name="matcapColor" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="MatCap Color" group="Rim" bHdr="1" bSrgb="1"/>
		<item name="outlineColor" type="Color" shaderType="Float4" defaultValue="0.0 0.0 0.0 1.0" displayName="Outline Color" group="Outline" bHdr="0" bSrgb="1"/>
		<item name="shadingShift" type="Range" shaderType="Float" defaultValue="0.0" min="-1.0" max="1.0" displayName="Shading Shift" group="Shading"/>
		<item name="shadingToony" type="Range" shaderType="Float" defaultValue="0.9" min="0.0" max="1.0" displayName="Shading Toony" group="Shading"/>
		<item name="shadowReceive" type="Range" shaderType="Float" defaultValue="1.0" min="0.0" max="1.0" displayName="Receive Shadow" group="Shading"/>
		<item name="emissiveStrength" type="Range" shaderType="Float" defaultValue="1.0" min="0.0" max="16.0" displayName="Emissive Strength" group="Emission"/>
		<item name="rimFresnelPower" type="Range" shaderType="Float" defaultValue="5.0" min="0.0" max="100.0" displayName="Rim Fresnel Power" group="Rim"/>
		<item name="rimLift" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Rim Lift" group="Rim"/>
		<item name="rimLightingMix" type="Range" shaderType="Float" defaultValue="1.0" min="0.0" max="1.0" displayName="Rim Lighting Mix" group="Rim"/>
		<item name="outlineWidth" type="Range" shaderType="Float" defaultValue="0.004" min="0.0" max="0.1" displayName="Outline Width (m or screen height)" group="Outline"/>
		<item name="outlineWidthMode" type="Range" shaderType="Float" defaultValue="1.0" min="0.0" max="1.0" displayName="Outline Width Mode (0 world, 1 screen)" group="Outline"/>
		<item name="outlineLightingMix" type="Range" shaderType="Float" defaultValue="1.0" min="0.0" max="1.0" displayName="Outline Lighting Mix" group="Outline"/>
		<item name="outlineMaxDistance" type="Range" shaderType="Float" defaultValue="1000.0" min="0.0" max="1000.0" displayName="Outline Max Distance" group="Outline"/>
		<item name="alphaCutoff" type="Range" shaderType="Float" defaultValue="0.5" min="0.0" max="1.0" displayName="Alpha Cutoff" group="Surface"/>
		<item name="baseColorMap" type="Texture2D" displayName="Base Color" group="Shading" bSrgb="1"/>
		<item name="shadeMap" type="Texture2D" displayName="Shade" group="Shading" bSrgb="1"/>
		<item name="emissiveMap" type="Texture2D" displayName="Emissive" group="Emission" bSrgb="1"/>
		<item name="matcapMap" type="Texture2D" displayName="MatCap" group="Rim" bSrgb="1"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_staticSwitches>
			<item name="Outline" keyword="MATERIAL_OUTLINE" bEnabled="0" bShaderFeature="1"/>
			<item name="AlphaCutoff" keyword="MATERIAL_ALPHA_CUTOFF" bEnabled="0" bShaderFeature="1"/>
			<item name="TwoSided" keyword="MATERIAL_TWO_SIDED" bEnabled="0" bShaderFeature="1"/>
		</_staticSwitches>
	</_permutations>
</MaterialDesc>
