<?xml version="1.0" encoding="utf-8"?>
<RenderPassDesc>
	<_name>ForwardPipeline</_name>
	<_attachments>
		<item>
			<_name>SceneColor</_name>
			<_format>R8G8B8A8_UNORM</_format>
			<_clearColor>0.120000,0.150000,0.180000,1.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>SceneDepth</_name>
			<_format>D24_UNORM_S8_UINT</_format>
			<_clearColor>1.000000,0.000000,0.000000,0.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
	</_attachments>
	<_passes>
		<item>
			<_name>Shadow</_name>
			<_type>Shadow</_type>
			<_inputs/>
			<_outputs>
				<item>ShadowMap</item>
			</_outputs>
		</item>
		<item>
			<_name>ForwardOpaque</_name>
			<_type>ForwardOpaque</_type>
			<_inputs>
				<item>ShadowMap</item>
			</_inputs>
			<_outputs>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_outputs>
		</item>
		<item>
			<_name>Lighting</_name>
			<_type>Lighting</_type>
			<_inputs>
				<item>SceneColor</item>
				<item>ShadowMap</item>
			</_inputs>
			<_outputs>
				<item>LitColor</item>
			</_outputs>
		</item>
		<item>
			<_name>Transparent</_name>
			<_type>Transparent</_type>
			<_inputs>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_inputs>
			<_outputs>
				<item>TransparentColor</item>
			</_outputs>
		</item>
		<item>
			<_name>PostBloom</_name>
			<_type>PostBloom</_type>
			<_inputs>
				<item>TransparentColor</item>
			</_inputs>
			<_outputs>
				<item>BloomColor</item>
			</_outputs>
		</item>
		<item>
			<_name>Present</_name>
			<_type>Present</_type>
			<_inputs>
				<item>BloomColor</item>
			</_inputs>
			<_outputs>
				<item>Swapchain</item>
			</_outputs>
		</item>
	</_passes>
</RenderPassDesc>
