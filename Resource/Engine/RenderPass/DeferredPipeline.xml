<?xml version="1.0" encoding="utf-8"?>
<RenderPassDesc>
	<_name>DeferredPipeline</_name>
	<_attachments>
		<item>
			<_name>GBufferAlbedo</_name>
			<_format>R8G8B8A8_UNORM</_format>
			<_clearColor>0.000000,0.000000,0.000000,1.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>GBufferNormal</_name>
			<_format>R16G16B16A16_FLOAT</_format>
			<_clearColor>0.000000,0.000000,0.000000,0.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
		<item>
			<_name>SceneDepth</_name>
			<_format>D24_UNORM_S8_UINT</_format>
			<_clearColor>1.000000,0.000000,0.000000,0.000000</_clearColor>
			<_bClear>1</_bClear>
		</item>
	</_attachments>
	<_passes>
		<item>
			<_name>Shadow</_name>
			<_type>Shadow</_type>
			<_inputs/>
			<_outputs>
				<item>ShadowMap</item>
			</_outputs>
		</item>
		<item>
			<_name>GBuffer</_name>
			<_type>GBuffer</_type>
			<_inputs/>
			<_outputs>
				<item>GBufferAlbedo</item>
				<item>GBufferNormal</item>
				<item>SceneDepth</item>
			</_outputs>
		</item>
		<item>
			<_name>Shading</_name>
			<_type>Shading</_type>
			<_inputs>
				<item>GBufferAlbedo</item>
				<item>GBufferNormal</item>
				<item>SceneDepth</item>
				<item>ShadowMap</item>
			</_inputs>
			<_outputs>
				<item>LitColor</item>
			</_outputs>
		</item>
		<item>
			<_name>Transparent</_name>
			<_type>Transparent</_type>
			<_inputs>
				<item>LitColor</item>
				<item>SceneDepth</item>
			</_inputs>
			<_outputs>
				<item>TransparentColor</item>
			</_outputs>
		</item>
		<item>
			<_name>SSAO</_name>
			<_type>SSAO</_type>
			<_inputs>
				<item>GBufferNormal</item>
				<item>SceneDepth</item>
			</_inputs>
			<_outputs>
				<item>AOColor</item>
			</_outputs>
		</item>
		<item>
			<_name>PostBloom</_name>
			<_type>PostBloom</_type>
			<_inputs>
				<item>TransparentColor</item>
				<item>AOColor</item>
			</_inputs>
			<_outputs>
				<item>BloomColor</item>
			</_outputs>
		</item>
		<item>
			<_name>TAA</_name>
			<_type>TAA</_type>
			<_inputs>
				<item>BloomColor</item>
			</_inputs>
			<_outputs>
				<item>TaaColor</item>
			</_outputs>
		</item>
		<item>
			<_name>Tonemap</_name>
			<_type>Tonemap</_type>
			<_inputs>
				<item>TaaColor</item>
			</_inputs>
			<_outputs>
				<item>TonemapColor</item>
			</_outputs>
		</item>
		<item>
			<_name>Present</_name>
			<_type>Present</_type>
			<_inputs>
				<item>TonemapColor</item>
			</_inputs>
			<_outputs>
				<item>Swapchain</item>
			</_outputs>
		</item>
	</_passes>
</RenderPassDesc>
