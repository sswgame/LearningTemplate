<?xml version="1.0" encoding="utf-8"?>
<!--
  ThemeParkTycoon 의 게임플레이 입력 맵 — 팩의 gamesettings.xml <inputMap> 이 가리키고, GameInstanceBase 가 통합 맵(InputManager::getInputMap)에 읽는다.
  게임 코드는 키를 직접 묻지 않고 액션 이름만 묻는다(키 바꾸기는 이 파일 · 사용자 설정의 키 바인딩). 이름은 게임 접두(Park.) — 섞인 게임에서 디렉터 둘이 같은 이름을 나눠 쓰지 않게.
  Camera.Pan · Camera.Rotate · Camera.Zoom 은 기반 카메라 리그(OrthoCameraRigComponent 의 _panAction · _rotateAction · _zoomAction)가 읽는다.
-->
<InputMap defaultLayer="Gameplay" doubleClickTime="0.35" doubleClickMaxDistance="6" holdThreshold="0.4">
	<layers>
		<layer name="Gameplay" enabled="1" blockLower="0"/>
	</layers>

	<action name="Camera.Pan" layer="Gameplay">
		<vector2d up="W" down="S" left="A" right="D"/>
		<vector2d up="Up" down="Down" left="Left" right="Right"/>
	</action>

	<action name="Camera.Rotate" layer="Gameplay" trigger="Pressed">
		<axis1d negative="Q" positive="E"/>
	</action>

	<action name="Park.NextRide" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Tab"/>
	</action>

	<action name="Park.ToggleOpen" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="O"/>
	</action>

	<action name="Park.PriceDown" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="LeftBracket"/>
	</action>

	<action name="Park.PriceUp" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="RightBracket"/>
	</action>

	<action name="Park.FeeDown" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Minus"/>
	</action>

	<action name="Park.FeeUp" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Equal"/>
	</action>

	<action name="Park.Build" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="B"/>
	</action>

	<action name="Park.Ride" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="V"/>
	</action>

	<action name="Park.Thoughts" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="G"/>
	</action>

	<action name="Park.Status" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="F1"/>
	</action>
	<!-- 확대 — 휠(굴린 칸만큼), 패드 D 패드 위 · 아래(누름 · 반복마다 한 칸). 기반 카메라의 _zoomAction 이 읽는다. -->
	<action name="Camera.Zoom" layer="Gameplay">
		<mouseWheel scale="1"/>
		<axis1d source="gamepad" negative="DPadDown" positive="DPadUp" trigger="Repeat"/>
	</action>
</InputMap>
