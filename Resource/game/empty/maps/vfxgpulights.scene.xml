<Scene formatVersion="2" name="VfxGPULights">
	<!-- 파티클 라이트 시나리오(automation/vfxgpulights)의 무대 — 어두운 방의 바닥 위에서 불똥(engine/vfx/gpusparklights)이 튄다.
	     불똥 그림은 아주 작아 바닥의 밝기 변화가 거의 빛(GPU 구간의 파티클 라이트)이다. 효과 오브젝트의 이름은 Effect — 시나리오가 순간이동으로 멀리 보내 빛을 뺀다. -->
	<WorldSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</WorldSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="0,2.5,-3"
					                 _localRotation="0.5,0,0"
					                 _localScale="1,1,1"
					                 _attachOwner="None"
					                 _attachComponent="None"
					                 _fovY="0.9"
					                 _nearZ="0.1"
					                 _farZ="60"
					                 _orthoHeight="10"
					                 _priority="0"
					                 _role="Game"
					                 _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Sun">
			<GameObject _schemaVersion="0" _name="Sun" _bActive="true">
				<_listComponent>
					<DirectionalLightComponent _localPosition="0,0,0"
					                           _localRotation="0.6,3.6,0"
					                           _localScale="1,1,1"
					                           _attachOwner="None"
					                           _attachComponent="None"
					                           _color="1,0.96,0.9"
					                           _intensity="0.05"
					                           _ambient="0.02"
					                           _shadowExtent="8"
					                           _shadowDistance="20"
					                           _bCastShadow="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Ground">
			<GameObject _schemaVersion="0" _name="Ground" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="0,0,2"
					               _localRotation="0,0,0"
					               _localScale="16,1,16"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="plane"
					               _materialPath="engine/materials/prototypegrid_dark.material"
					               _boundsRadius="12"
					               _blendMode="Opaque" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="4" name="Effect">
			<GameObject _schemaVersion="0" _name="Effect" _bActive="true">
				<_listComponent>
					<VfxComponent _localPosition="0,0.5,2"
					              _localRotation="0,0,0"
					              _localScale="1,1,1"
					              _attachOwner="None"
					              _attachComponent="None"
					              _effectPath="engine/vfx/gpusparklights.vfx.xml"
					              _seed="1"
					              _bPlayOnBegin="true" />
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
