<Scene formatVersion="2" name="FogShowcase">
	<!-- 안개 시나리오(automation/fog)의 무대 — 넓은 바닥 위로 멀어지는 큐브 둘. 바닥은 어둡고 안개는 밝아서, 먼 바닥이 안개색으로 올라가는지 가까운 바닥은 그대로인지 밝기로 본다.
	     애니메이션 · 비동기 메시가 없어 같은 프레임이 실행마다 같은 그림이다. -->
	<WorldSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</WorldSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="0,1.6,-6"
					                 _localRotation="0.15,0,0"
					                 _localScale="1,1,1"
					                 _attachOwner="None"
					                 _attachComponent="None"
					                 _fovY="0.7"
					                 _nearZ="0.1"
					                 _farZ="300"
					                 _orthoHeight="10"
					                 _priority="0"
					                 _role="Game"
					                 _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Sun">
			<GameObject _schemaVersion="0" _name="Sun" _bActive="true">
				<_listComponent>
					<DirectionalLightComponent _localPosition="0,0,0"
					                           _localRotation="0.6,3.6,0"
					                           _localScale="1,1,1"
					                           _attachOwner="None"
					                           _attachComponent="None"
					                           _color="1,0.96,0.9"
					                           _intensity="1.0"
					                           _ambient="0.2"
					                           _shadowExtent="8"
					                           _shadowDistance="20"
					                           _bCastShadow="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Ground">
			<GameObject _schemaVersion="0" _name="Ground" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="0,0,100"
					               _localRotation="0,0,0"
					               _localScale="200,1,200"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="plane"
					               _materialPath="engine/materials/prototypegrid_dark.material"
					               _boundsRadius="150"
					               _blendMode="Opaque" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="4" name="NearCube">
			<GameObject _schemaVersion="0" _name="NearCube" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="-2,0.75,2"
					               _localRotation="0,0.5,0"
					               _localScale="1.5,1.5,1.5"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="cube"
					               _materialPath="engine/materials/prototypegrid_orange.material"
					               _boundsRadius="1.3"
					               _blendMode="Opaque" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="5" name="FarCube">
			<GameObject _schemaVersion="0" _name="FarCube" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="3,3,60"
					               _localRotation="0,0.5,0"
					               _localScale="6,6,6"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="cube"
					               _materialPath="engine/materials/prototypegrid_orange.material"
					               _boundsRadius="6"
					               _blendMode="Opaque" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="6" name="Fog">
			<GameObject _schemaVersion="0" _name="Fog" _bActive="true">
				<_listComponent>
					<FogComponent _color="0.75,0.82,0.9"
					              _density="0.03"
					              _heightFalloff="0.05"
					              _baseHeight="0"
					              _startDistance="0"
					              _maxOpacity="1"
					              _inscatterColor="1,0.9,0.7"
					              _inscatterIntensity="0"
					              _inscatterExponent="8"
					              _bVolumetric="false"
					              _volumeDistance="64"
					              _scattering="1"
					              _anisotropy="0.3" />
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
