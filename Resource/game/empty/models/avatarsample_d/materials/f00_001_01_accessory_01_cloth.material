<MaterialDesc formatVersion="0"
              name="F00_001_01_Accessory_01_CLOTH"
              shaderPath="engine/shaders/toon.hlsl"
              blendMode="Opaque">
	<_properties>
		<item name="baseColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="1 1 1 1"
		      displayName="Base Color"
		      group="Shading"
		      bHdr="0"
		      bSrgb="1" />
		<item name="shadeColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="0.933107 0.620916 0.710567 1"
		      displayName="Shade Color"
		      group="Shading"
		      bHdr="0"
		      bSrgb="1" />
		<item name="emissiveColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="0 0 0 0"
		      displayName="Emissive Color"
		      group="Emission"
		      bHdr="1"
		      bSrgb="1" />
		<item name="rimColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="0 0 0 1"
		      displayName="Rim Color"
		      group="Rim"
		      bHdr="1"
		      bSrgb="1" />
		<item name="matcapColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="1 1 1 1"
		      displayName="MatCap Color"
		      group="Rim"
		      bHdr="1"
		      bSrgb="1" />
		<item name="outlineColor"
		      type="Color"
		      shaderType="Float4"
		      defaultValue="0.0612461 0.00856812 0.0144438 1"
		      displayName="Outline Color"
		      group="Outline"
		      bHdr="0"
		      bSrgb="1" />
		<item name="shadingShift"
		      type="Range"
		      shaderType="Float"
		      defaultValue="-0.35"
		      min="-1.0"
		      max="1.0"
		      displayName="Shading Shift"
		      group="Shading" />
		<item name="shadingToony"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0.35"
		      min="0.0"
		      max="1.0"
		      displayName="Shading Toony"
		      group="Shading" />
		<item name="shadowReceive"
		      type="Range"
		      shaderType="Float"
		      defaultValue="1"
		      min="0.0"
		      max="1.0"
		      displayName="Receive Shadow"
		      group="Shading" />
		<item name="emissiveStrength"
		      type="Range"
		      shaderType="Float"
		      defaultValue="1"
		      min="0.0"
		      max="16.0"
		      displayName="Emissive Strength"
		      group="Emission" />
		<item name="rimFresnelPower"
		      type="Range"
		      shaderType="Float"
		      defaultValue="1"
		      min="0.0"
		      max="100.0"
		      displayName="Rim Fresnel Power"
		      group="Rim" />
		<item name="rimLift"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0"
		      min="0.0"
		      max="1.0"
		      displayName="Rim Lift"
		      group="Rim" />
		<item name="rimLightingMix"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0"
		      min="0.0"
		      max="1.0"
		      displayName="Rim Lighting Mix"
		      group="Rim" />
		<item name="outlineWidth"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0.00075"
		      min="0.0"
		      max="0.1"
		      displayName="Outline Width (m or screen height)"
		      group="Outline" />
		<item name="outlineWidthMode"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0"
		      min="0.0"
		      max="1.0"
		      displayName="Outline Width Mode (0 world, 1 screen)"
		      group="Outline" />
		<item name="outlineLightingMix"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0"
		      min="0.0"
		      max="1.0"
		      displayName="Outline Lighting Mix"
		      group="Outline" />
		<item name="outlineMaxDistance"
		      type="Range"
		      shaderType="Float"
		      defaultValue="1000"
		      min="0.0"
		      max="1000.0"
		      displayName="Outline Max Distance"
		      group="Outline" />
		<item name="alphaCutoff"
		      type="Range"
		      shaderType="Float"
		      defaultValue="0.5"
		      min="0.0"
		      max="1.0"
		      displayName="Alpha Cutoff"
		      group="Surface" />
		<item name="baseColorMap"
		      type="Texture2D"
		      displayName="Base Color"
		      group="Shading"
		      bSrgb="1"
		      assetPath="game/empty/textures/avatarsample_d/f00_001_accessory_01.dds" />
		<item name="shadeMap"
		      type="Texture2D"
		      displayName="Shade"
		      group="Shading"
		      bSrgb="1"
		      assetPath="game/empty/textures/avatarsample_d/f00_001_accessory_01.dds" />
		<item name="emissiveMap"
		      type="Texture2D"
		      displayName="Emissive"
		      group="Emission"
		      bSrgb="1"
		      assetPath="game/empty/textures/avatarsample_d/shader_noneblack.dds" />
		<item name="matcapMap"
		      type="Texture2D"
		      displayName="MatCap"
		      group="Rim"
		      bSrgb="1"
		      assetPath="game/empty/textures/avatarsample_d/matcap_rim.dds" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_staticSwitches>
			<item name="Outline" keyword="MATERIAL_OUTLINE" bEnabled="1" bShaderFeature="1" />
			<item name="AlphaCutoff" keyword="MATERIAL_ALPHA_CUTOFF" bEnabled="1" bShaderFeature="1" />
			<item name="TwoSided" keyword="MATERIAL_TWO_SIDED" bEnabled="1" bShaderFeature="1" />
		</_staticSwitches>
	</_permutations>
</MaterialDesc>
