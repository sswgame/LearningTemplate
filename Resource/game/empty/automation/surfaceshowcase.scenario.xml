<?xml version="1.0" encoding="utf-8"?>
<!--
  표면 셰이더 쇼케이스(계획 CharacterAppearanceIntegration E6) — surfacelit.hlsl 이 표면 상태 이름(_surface<채널>)을 읽어 그리는지 본다.
  구 다섯이 왼쪽부터 기본 · 젖음 · 흙 · 피 · 찢김이다(surfaceshowcase_*.material 이 채널 값 하나씩 1 로 켠다 — 마스크 텍스처를 비워 흰색으로 읽히므로 켠 채널이 구 전체를 덮는다).
  기대: 젖음 구는 기본보다 어둡고 번들거린다 · 흙 구는 갈색 · 피 구는 검붉다 · 찢김 구는 알파 컷으로 전부 사라져 바닥이 보인다(깊이 · 그림자도 사라진다).
  자동 단언은 색 기울기(평균 R − B)뿐이다 — 기본 구는 무채색, 피 · 흙 구는 붉은 쪽이다. 문턱은 어림값(provisional)이라 첫 실행은 UNCONFIRMED 이고, 지표 줄의 잰 값을 measured 로 옮기면 확정이다.
  구 영역은 16:9 창에서 카메라(0,1,-6, fovY 0.8)가 구 중심 가로 0.144 · 0.322 · 0.5 · 0.678 · 0.856 에 놓는 값이다. 사진(surface_showcase.ppm)은 눈으로 본다 — 매니페스트 id surface-shader-check.
  실행: App.exe -game=Empty -dx12 -scenario=game/empty/automation/surfaceshowcase.scenario.xml  (네 백엔드)
-->
<Scenario name="game.empty.surfaceshowcase" fixedDelta="0.0166667" timeoutFrames="120" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/surfaceshowcase.scene.xml"/>
	<At frame="30"><Screenshot file="surface_showcase.ppm"/></At>
	<At frame="31">
		<ExpectImage file="surface_showcase.ppm" region="0.119,0.46,0.169,0.54" metric="meanRedMinusBlue" atMost="0.03" provisional="2026-10-25 기본 구는 무채색 — 첫 측정 전 어림"/>
		<ExpectImage file="surface_showcase.ppm" region="0.475,0.46,0.525,0.54" metric="meanRedMinusBlue" atLeast="0.03" provisional="2026-10-25 흙 구는 갈색 — 첫 측정 전 어림"/>
		<ExpectImage file="surface_showcase.ppm" region="0.653,0.46,0.703,0.54" metric="meanRedMinusBlue" atLeast="0.05" provisional="2026-10-25 피 구는 검붉다 — 첫 측정 전 어림"/>
		<Pass/>
	</At>
</Scenario>
