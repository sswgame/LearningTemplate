<?xml version="1.0" encoding="utf-8"?>
<!--
  천 쇼케이스 — 윗변 고정 커튼이 정적 구에 걸치고, 양 끝 고정 깃발이 처진다(계획 ClothFollowups C1 · C2).
  프레임 30 과 프레임 180 의 그림을 찍어 천이 움직였는지(처짐 · 걸침) 본다. 앞면 · 뒷면 감김, 접힌 곳 음영, 커튼이 구에 걸치는지는 캡처를 눈으로 본다
  (gpu-verifier 의 네 백엔드 캡처 — 매니페스트 id cloth-showcase-capture). 풀 재채움 수(`RT.GPUScene.vertexPool` · `_repackCount`)는 같은 실행의 프로파일 줄에서 읽는다.
  실행: py -3 -m Scripts scenario clothshowcase
        (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다)
-->
<Scenario name="game.empty.clothshowcase" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/clothshowcase.scene.xml"/>
	<At frame="30"><Screenshot file="cloth_early.ppm"/></At>
	<At frame="180"><Screenshot file="cloth_settled.ppm"/></At>

	<!-- 첫 프레임들은 천이 펴진 채 떨어지는 중이고 180 에는 걸리고 처졌다 — 두 그림은 달라야 한다(천이 얼어붙었거나 그려지지 않으면 같다).
	     첫 측정(2026-10-25, Release, 측정 커밋 00a6fc842)은 다른 화소 비율 0.085762 ~ 0.085763 이고 문턱은 그 70 % 아래(0.06)다. -->
	<At frame="181">
		<ExpectImage file="cloth_settled.ppm" metric="differingFraction" reference="cloth_early.ppm" atLeast="0.06" measured="2026-10-25 dx11:0.085763 dx12:0.085762 vk:0.085762 gl:0.085763"/>
		<Pass/>
	</At>
</Scenario>
