<?xml version="1.0" encoding="utf-8"?>
<!--
  실시간 라이트 프로브 갱신(LightProbeVolumeComponent::_bRealtime, RealtimeGlobalIllumination R6) — 직접광이 거의 닿지 않는 큐브 옆면이 바닥에서 튕긴 빛(프로브의 간접광)으로 밝아진다.
  프로브 갱신 컴퓨트(probeupdate.hlsl)가 돌지 않으면 그 면은 앰비언트 0 이라 거의 검다. 무대: maps/realtimegi (갱신 주기 4 프레임 · 섞는 비율 0.25 라 몇 십 프레임이면 수렴한다).
  결정적: 애니메이션 없는 무대, 고정 프레임 시간. 광선 방향은 프로브 · 프레임마다 정해진 해시라 실행마다 같다.
  문턱 근거: 첫 측정(2026-10-25, Release, 측정 커밋 00a6fc842) — 큐브 옆면 영역 평균 휘도 0.1030(네 백엔드 차이 1e-7 이하). 문턱은 그 3분의 2(0.07)다 — 프로브 갱신이 안 돌면 앰비언트 0 이라 거의 검다.
  실행: App.exe -game=Empty -dx12 -gv_firstScene=game/empty/maps/realtimegi.scene.xml -scenario=game/empty/automation/realtimegi.scenario.xml
        (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다. Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.empty.realtimegi" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/realtimegi.scene.xml"/>
	<At frame="120"><Screenshot file="realtimegi.ppm"/></At>
	<At frame="130">
		<ExpectImage file="realtimegi.ppm" region="0.4,0.4,0.6,0.55" metric="meanLuma" atLeast="0.07" measured="2026-10-25 all:0.10303"/>
		<Pass/>
	</At>
</Scenario>
