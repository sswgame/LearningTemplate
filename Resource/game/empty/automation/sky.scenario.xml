<?xml version="1.0" encoding="utf-8"?>
<!--
  대기 산란 하늘과 구름(RealtimeGlobalIllumination R3 · R4) — 해가 높은 낮 하늘은 파랗고(평균 R − B 가 음수) 구름이 얹혀 밝은 흰 덩이가 생긴다. 스카이 패스(sky.hlsl)를 본다.
  결정적: 하늘만 보는 무대(maps/skyshowcase), 고정 프레임 시간. 구름 무늬는 머티리얼 시계로 흐르지만 같은 프레임이 같은 그림이다.
  문턱(atMost · atLeast)은 첫 측정 전의 어림값이다(GPU 확인 대기) — 통합이 네 백엔드에서 처음 돌린 값으로 정한다.
  실행: App.exe -game=Empty -dx12 -gv_firstScene=game/empty/maps/skyshowcase.scene.xml -scenario=game/empty/automation/sky.scenario.xml
        (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다. Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.empty.sky" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/skyshowcase.scene.xml"/>
	<At frame="30"><Screenshot file="sky.ppm"/></At>
	<At frame="40">
		<ExpectImage file="sky.ppm" region="0.0,0.0,1.0,1.0" metric="meanRedMinusBlue" atMost="-0.02" provisional="첫 측정 전 어림값(해 높이를 46도로 올린 뒤, GPU 확인 대기)"/>
		<ExpectImage file="sky.ppm" region="0.0,0.0,1.0,1.0" metric="meanLuma" atLeast="0.05" provisional="첫 측정 전 어림값(해 높이를 46도로 올린 뒤, GPU 확인 대기)"/>
		<Pass/>
	</At>
</Scenario>
