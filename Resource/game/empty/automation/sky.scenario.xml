<?xml version="1.0" encoding="utf-8"?>
<!--
  대기 산란 하늘과 구름(결정 기록 5-5 R3 · R4) — 해가 높은 낮 하늘은 파랗고(평균 R − B 가 음수) 구름이 얹혀 밝은 흰 덩이가 생긴다. 스카이 패스(sky.hlsl)를 본다.
  결정적: 하늘만 보는 무대(maps/skyshowcase), 고정 프레임 시간. 구름 무늬는 머티리얼 시계로 흐르지만 같은 프레임이 같은 그림이다.
  문턱 근거: 첫 측정(2026-10-25, Release, 측정 커밋 00a6fc842, 네 백엔드 차이 1e-6 이하, 해 46° · 구름 포함 전체 화면)은 평균 R − B -0.0086, 평균 휘도 0.5954 다.
  처음 적은 어림값(R − B 가 -0.02 이하)은 흰 구름 덩이가 평균을 0 쪽으로 끌어올려 틀렸다. 지금 문턱은 잰 값의 절반(R − B)과 3분의 2(휘도)다 — 해가 낮은 노을은 R − B 가 양수라 가르고, 하늘이 안 그려지면 휘도가 크게 떨어진다.
  실행: py -3 -m Scripts scenario sky
        (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다. Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.empty.sky" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/skyshowcase.scene.xml"/>
	<At frame="30"><Screenshot file="sky.ppm"/></At>
	<At frame="40">
		<ExpectImage file="sky.ppm" region="0.0,0.0,1.0,1.0" metric="meanRedMinusBlue" atMost="-0.004" measured="2026-10-25 dx11:-0.008603 dx12:-0.008603 vk:-0.008603 gl:-0.008603"/>
		<ExpectImage file="sky.ppm" region="0.0,0.0,1.0,1.0" metric="meanLuma" atLeast="0.40" measured="2026-10-25 dx11:0.59539 dx12:0.59539 vk:0.59539 gl:0.59539"/>
		<Pass/>
	</At>
</Scenario>
