<?xml version="1.0" encoding="utf-8"?>
<!--
  상호작용 강조 — 고른 대상이 외곽선(PickUp)으로, 감각 모드(Hide)는 벽 너머로도 구별되는지 본다(InteractionHighlightAndMontage H3). 강조 패스(highlightoutline.hlsl)를 본다.
  결정적: 무대 maps/interactionhighlight(카메라 고정), 고정 프레임 시간. 하는 쪽(Player 빈 오브젝트)만 순간이동으로 옮겨 같은 그림틀에서 강조만 켜고 끈다 —
  먼 곳(base) → PickCube 1.2 m 앞(outline) → HideCube 앞, 사이에 벽(sense).
  지표는 영역 안에서 기준 사진과 색이 다른 화소의 비율이다. 대상 둘레의 영역은 카메라 (0,1.6,-6)·시야 0.7 rad 로 계산한 값이다 — PickCube 는 화면 (0.34, 0.51), HideCube 는 (0.69, 0.48).
  문턱 0.005 는 영역(전체의 약 4 %) 대비 외곽선 띠(대상 둘레 몇 화소)가 이만큼은 바뀐다는 **측정 전 추정**이다 — 네 백엔드 첫 캡처(GPU 확인 대기)로 정한다.
  실행: App.exe -game=Empty -dx12 -gv_firstScene=game/empty/maps/interactionhighlight.scene.xml -scenario=game/empty/automation/interactionhighlight.scenario.xml
        (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다)
-->
<Scenario name="game.empty.interactionhighlight" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/interactionhighlight.scene.xml"/>
	<At frame="40"><Screenshot file="base.ppm"/></At>

	<!-- PickCube 앞 — 외곽선 -->
	<At frame="50"><DevCommand line="teleport Player -1.5 0.5 -0.2"/></At>
	<At frame="70"><Screenshot file="outline.ppm" waitForSettle="false"/></At>

	<!-- HideCube 앞(벽 너머) — 감각 모드 -->
	<At frame="80"><DevCommand line="teleport Player 2 0.5 0.8"/></At>
	<At frame="100"><Screenshot file="sense.ppm" waitForSettle="false"/></At>

	<At frame="110">
		<ExpectImage file="outline.ppm" region="0.26,0.38,0.42,0.64" metric="differingFraction" reference="base.ppm" atLeast="0.005"/>
		<ExpectImage file="outline.ppm" region="0.62,0.37,0.76,0.60" metric="differingFraction" reference="base.ppm" atMost="0.001"/>
		<ExpectImage file="sense.ppm" region="0.62,0.37,0.76,0.60" metric="differingFraction" reference="base.ppm" atLeast="0.005"/>
		<ExpectImage file="sense.ppm" region="0.26,0.38,0.42,0.64" metric="differingFraction" reference="base.ppm" atMost="0.001"/>
		<Pass/>
	</At>
</Scenario>
