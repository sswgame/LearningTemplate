<?xml version="1.0" encoding="utf-8"?>
<!--
  2D 빛 쿠키 — 쿠키 텍스처(창문 window_01)가 빛 색에 곱해져 창살 무늬가 보이고, 같은 자리의 쿠키 없는 빛과 다르다.
  무대(maps/rendertest2d)는 밝은 격자 벽 앞의 같은 점광 둘이다(왼쪽만 쿠키). 첫 사진 뒤 두 빛을 순간이동으로 맞바꿔 같은 자리의 쿠키 있음 · 없음을 견준다.
  지표: 맞바꾼 두 사진의 차(왼쪽 · 오른쪽 빛 영역), 쿠키 빛 안쪽 영역의 어두운 픽셀 비율(창살이 빛을 막는다 — 쿠키 없는 원광은 0 이다). 빛 세기는 창이 하얗게 넘치지 않을 만큼 낮췄다.
  실행: py -3 -m Scripts scenario light2dcookie   (AppScenarioTest 는 <Launch> 를 읽어 인자를 붙인다. Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.empty.light2dcookie" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/rendertest2d.scene.xml"/>
	<Launch variable="gv_renderPipeline" value="engine/pipeline/forward2dpipeline.xml"/>
	<At frame="40"><Screenshot file="cookie_left.ppm"/></At>
	<At frame="41"><DevCommand line="teleport CookieLight 4.5 0 0"/><DevCommand line="teleport PlainLight -4.5 0 0"/></At>
	<At frame="42"><Screenshot file="cookie_right.ppm"/></At>
	<!-- 첫 측정(2026-10-22, Release, 네 백엔드): 맞바꾼 사진의 평균 차 0.095 · 다른 화소 비율 0.498(양쪽, 문턱 atLeast 0.25 는 비율의 절반, 기존 캡처로 정함 — GPU 확인 대기), 쿠키 빛 안쪽의 어두운 픽셀(중앙값 × 0.7 아래 — 창살) 0.162, 쿠키 없는 원광 0. 문턱은 그 절반 근처. -->
	<At frame="43">
		<ExpectImage file="cookie_left.ppm" region="0.05,0.1,0.45,0.9" metric="differingFraction" reference="cookie_right.ppm" atLeast="0.25" measured="2026-10-22 all:0.498"/>
		<ExpectImage file="cookie_left.ppm" region="0.55,0.1,0.95,0.9" metric="differingFraction" reference="cookie_right.ppm" atLeast="0.25" measured="2026-10-22 all:0.498"/>
		<ExpectImage file="cookie_left.ppm" region="0.15,0.3,0.34,0.7" metric="darkFraction" ratio="0.7" atLeast="0.08" measured="2026-10-22 all:0.162"/>
		<ExpectImage file="cookie_left.ppm" region="0.66,0.3,0.85,0.7" metric="darkFraction" ratio="0.7" atMost="0.01" measured="2026-10-22 all:0"/>
		<ExpectImage file="cookie_right.ppm" region="0.15,0.3,0.34,0.7" metric="darkFraction" ratio="0.7" atMost="0.01" measured="2026-10-22 all:0"/>
		<ExpectImage file="cookie_right.ppm" region="0.66,0.3,0.85,0.7" metric="darkFraction" ratio="0.7" atLeast="0.08" measured="2026-10-22 all:0.162"/>
		<Pass/>
	</At>
</Scenario>
