<?xml version="1.0" encoding="utf-8"?>
<!-- Kenney Mini Dungeon 모델의 팔레트 머티리얼 — albedoMap 이 키트의 색 칸 텍스처다(모델 UV 가 칸을 고른다). 바닥 · 벽 · 소품이 이 하나를 나눠 써 한 배치로 묶인다. -->
<MaterialDesc formatVersion="0" name="ArenaPalette" shaderPath="engine/shaders/forwardlit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="color" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="roughness" type="Range" shaderType="Float" defaultValue="0.5" min="0.0" max="1.0" group="Surface"/>
		<item name="albedoMap" type="Texture2D" assetPath="game/abilityarena/textures/dungeon_colormap.dds" displayName="Albedo" group="Surface" bSrgb="1"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
