<?xml version="1.0" encoding="utf-8"?>
<!--
  HarvestValley 의 게임플레이 입력 맵 — 팩의 gamesettings.xml <inputMap> 이 가리키고, GameInstanceBase 가 통합 맵(InputManager::getInputMap)에 읽는다.
  게임 코드는 키를 직접 묻지 않고 액션 이름만 묻는다(키 바꾸기는 이 파일 · 사용자 설정의 키 바인딩). 이름은 게임 접두(Farm.) — 섞인 게임에서 디렉터 둘이 같은 이름을 나눠 쓰지 않게.
-->
<InputMap defaultLayer="Gameplay" doubleClickTime="0.35" doubleClickMaxDistance="6" holdThreshold="0.4">
	<layers>
		<layer name="Gameplay" enabled="1" blockLower="0"/>
	</layers>

	<action name="Farm.Move" layer="Gameplay">
		<vector2d up="W" down="S" left="A" right="D"/>
		<vector2d up="Up" down="Down" left="Left" right="Right"/>
	</action>

	<action name="Farm.Tool1" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Digit1"/>
	</action>

	<action name="Farm.Tool2" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Digit2"/>
	</action>

	<action name="Farm.Tool3" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Digit3"/>
	</action>

	<action name="Farm.Tool4" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Digit4"/>
	</action>

	<action name="Farm.SeedPrev" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Q"/>
	</action>

	<action name="Farm.SeedNext" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="E"/>
	</action>

	<action name="Farm.Use" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Space"/>
		<bind source="key" code="J"/>
	</action>

	<action name="Farm.Ship" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="F"/>
	</action>

	<action name="Farm.Buy" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="B"/>
	</action>

	<action name="Farm.Sleep" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Z"/>
	</action>

	<action name="Farm.Status" layer="Gameplay" trigger="Pressed">
		<bind source="key" code="Tab"/>
	</action>
</InputMap>
