<?xml version="1.0" encoding="utf-8"?>
<!-- 농부 — 기본 머티리얼에 파란 옷 색을 기본값으로 둔 것이다. -->
<MaterialDesc formatVersion="0" name="HarvestValleyFarmer" shaderPath="engine/shaders/forwardlit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="color" type="Color" shaderType="Float4" defaultValue="0.25 0.45 0.95 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="roughness" type="Range" shaderType="Float" defaultValue="0.5" min="0.0" max="1.0" group="Surface"/>
		<item name="albedoMap" type="Texture2D" displayName="Albedo" group="Surface" bSrgb="1"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
