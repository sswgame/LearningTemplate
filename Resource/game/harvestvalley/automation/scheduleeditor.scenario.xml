<?xml version="1.0" encoding="utf-8"?>
<!--
  HarvestValley 에디터 시나리오 — NPC 일정 디버그 창(npc_schedule). 일정 시스템은 이 게임에만 있어 에디터 체인(Empty)에서는 창이 비어 있다.
  루트의 editor="true" 로 AppScenarioTest 가 이 게임 팩 시나리오를 -EnableEditor 로 돌린다.
  ① 플레이를 시작해 일정 시스템을 띄우고 ② 창을 열어 NPC 목록이 찼는지 본다. ③ pierre 를 골라 오늘 타임라인 줄이 나오는지 보고 에디터 UI 를 찍는다.
  ④ 10 시로 감아도 창이 따라온다(타임라인 줄 수는 그대로). 플레이를 멈춘다.
  실행: py -3 -m Scripts scenario scheduleeditor
-->
<Scenario name="harvestvalley.scheduleeditor" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive" editor="true">
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/><Variable name="gv_farmAutoPlay" value="0"/></At>
	<At frame="10"><DevCommand line="layout.reset"/></At>

	<!-- ① 플레이 -->
	<At frame="30"><DevCommand line="play"/></At>
	<At frame="31"><WaitUntil probe="Editor.PlayState" equals="1" timeoutFrames="600"/></At>

	<!-- ② 창 열기 — NPC 목록 -->
	<At frame="60"><DevCommand line="panel.focus npc_schedule"/></At>
	<At frame="90"><Expect probe="Editor.ScheduleNpcCount" atLeast="2"/></At>

	<!-- ③ pierre 고르기 — 타임라인 · 설명 -->
	<At frame="95"><EditorClick mark="schedule.npc.pierre"/></At>
	<At frame="120">
		<Expect probe="Editor.ScheduleTimelineRowCount" atLeast="3"/>
		<Remember probe="Editor.ScheduleTimelineRowCount" as="pierreRows"/>
		<CaptureEditorUI file="scheduleeditor/npc_schedule.png"/>
	</At>

	<!-- ④ 시계를 감아도 같은 날의 계획 -->
	<At frame="130"><AdvanceGameTime toHour="10"/></At>
	<At frame="150">
		<Expect probe="Schedule.Activity" target="pierre" is="WorkAt"/>
		<Expect probe="Editor.ScheduleTimelineRowCount" sameAs="pierreRows"/>
	</At>
	<At frame="160"><DevCommand line="stop"/></At>
	<At frame="161"><WaitUntil probe="Editor.PlayState" equals="0" timeoutFrames="600"/></At>
	<At frame="170">
		<Variable name="gv_editorUiScale" value="0"/>
		<Pass/>
	</At>
</Scenario>
