<?xml version="1.0" encoding="utf-8"?>
<!--
  MeadowVillage 목표 마커 — 부탁(quest meadow_request)을 받으면 목표 자리(OrchardSite 의 QuestObjectiveMarkerComponent)에 화면 마커가 뜨고,
  과수원이 서서 부탁이 끝나면 사라지는지 본다. day.scenario 와 같은 흐름(날 단위로 시계를 감는다)에서 마커 가시성(UI.MarkerVisible)의 이력이 0 → 1 → 0 인지,
  부탁 상태의 이력이 NotStarted → Active → Completed 인지 단언한다. 마커는 UI 갱신이 놓으므로 프레임마다 읽어 이력으로 본다.
  App -game=MeadowVillage -scenario=game/meadowvillage/automation/questmarker.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="meadowvillage.questmarker" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_meadowAutoPlay" value="0"/></At>
	<At frame="10">
		<Expect probe="Quest.Status" target="meadow_request" is="NotStarted"/>
		<Expect probe="Object.Exists" target="OrchardSite" equals="1"/>
		<Expect probe="UI.MarkerVisible" target="OrchardSite" equals="0"/>
	</At>
	<At frame="11"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="2"><AdvanceGameTime hours="24"/></At>
	<At after="3">
		<Expect probe="Quest.Status" target="meadow_request" is="Completed"/>
		<Expect probe="UI.MarkerVisible" target="OrchardSite" equals="0"/>
		<ExpectVisited probe="Quest.Status" target="meadow_request" sequence="NotStarted, Active, Completed"/>
		<ExpectVisited probe="UI.MarkerVisible" target="OrchardSite" sequence="0, 1, 0"/>
		<Pass/>
	</At>
</Scenario>
