<?xml version="1.0" encoding="utf-8"?>
<!--
  MeadowVillage 자동 플레이 — gv_meadowAutoPlay 를 켜면 밭 디렉터가 공유 시계를 8 배로 흘려 날이 스스로 넘어간다(MeadowFarmDirectorComponent).
  하루는 실제 120 초이고 시계는 아침 6 시에 시작하므로 8 배속이면 첫 날 넘김이 11 초 즈음이다. 1 배속이면 90 초라 시한(40 초)에서 진다 — 스위치가 안 먹은 것을 잡는다.
  day 시나리오는 AdvanceGameTime 으로 시계를 감아 보지만 이 시나리오는 스위치가 만든 시간 흐름만 본다. 고정 프레임으로 기다리지 않는다(조건 대기).
  App -game=MeadowVillage -scenario=game/meadowvillage/automation/autoplayclock.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="meadowvillage.autoplayclock" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_meadowAutoPlay" value="1"/></At>
	<At frame="1"><WaitUntil probe="Clock.Day" atLeast="1" timeoutSeconds="40"/></At>
	<At after="1">
		<Expect probe="Clock.Day" atLeast="1"/>
		<Pass/>
	</At>
</Scenario>
