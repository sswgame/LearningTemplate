<?xml version="1.0" encoding="utf-8"?>
<!--
  FrontierTown 자동 플레이 — gv_frontierAutoPlay 를 켜면 도시 디렉터가 공유 시계를 8 배로 흘려(하루 24 초 → 3 초) 달 결산과 RTS 가 스스로 돈다.
  시계는 아침 6 시에 시작하므로 8 배속이면 이틀째로 넘어가는 것이 5 초 즈음이다. 1 배속이면 42 초라 시한(30 초)에서 진다 — 스위치가 안 먹은 것을 잡는다.
  month 시나리오는 AdvanceGameTime 으로 시계를 감아 보지만 이 시나리오는 스위치가 만든 시간 흐름만 본다.
  배치가 땅과 맞지 않아 거절되면 `[Frontier] ... refused` 가 남는다 — 끝에서 그 줄이 없는지 본다. 고정 프레임으로 기다리지 않는다(조건 대기).
  App -game=FrontierTown -scenario=game/frontiertown/automation/autoplayclock.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="frontiertown.autoplayclock" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_frontierAutoPlay" value="1"/></At>
	<At frame="1"><WaitUntil probe="Clock.Day" atLeast="2" timeoutSeconds="30"/></At>
	<At after="1">
		<Expect probe="Clock.Day" atLeast="2"/>
		<ExpectLog contains="refused" count="0"/>
		<Pass/>
	</At>
</Scenario>
