<?xml version="1.0" encoding="utf-8"?>
<!--
  활 쇼케이스 — 궁수(앵커) · 활 · 메긴 화살이 페어드 애니메이션 하나(data/anim/bow_shoot.pairedanim.xml)로 돈다.
  궁수의 PairedAnimationComponent(_bStartOnPlay)가 플레이 첫 틱 뒤에 세션을 시작하고, 활 · 화살 역할은 외형 부품(아이템 bow_long)의 프리팹이 데이터로 든다.
  0.6 초의 공유 알림 ReleaseArrow 가 활의 알림 표에서 투사체 프리팹(prefabs/props/arrow_projectile.prefab.xml)을 시위 본 자리에 스폰한다.
  씬이 따로라 AppScenarioTest 의 자동 수집(automation/ 바로 아래)에서 빠진다. 활 · 화살 메시는 Scripts/dev/MakeBowProps.py 를 App 으로 임포트해야 있다.
  App.exe -game=Shooter3D -dx12 "-gv_firstScene=game/shooter3d/maps/bowshowcase.scene.xml" -scenario=game/shooter3d/automation/showcase/bowshoot.scenario.xml
-->
<Scenario name="shooter3d.bowshoot" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="0"><Variable name="gv_shooterAutoPlay" value="0"/></At>
	<At frame="5"><Expect probe="Appearance.SlotItem" target="Archer" key="MainHand" is="bow_long"/></At>
	<!-- WaitUntil 은 그 프레임의 유일한 단계여야 한다. -->
	<At frame="6"><WaitUntil probe="PairedAnimation.SessionState" target="Archer" equals="1" timeoutFrames="60"/></At>
	<!-- 놓는 시각(0.6 초) 앞 — 시위를 당긴 자세. -->
	<At afterSeconds="0.4"><Screenshot file="shooter3d/bowshoot_draw.ppm"/></At>
	<!-- 놓은 뒤 — 투사체가 스폰됐다. -->
	<At afterSeconds="0.4">
		<Expect probe="Object.Exists" target="ArrowProjectile" equals="1"/>
		<Screenshot file="shooter3d/bowshoot_release.ppm"/>
	</At>
	<!-- 앵커 클립(1.07 초)이 끝나면 세션이 끝나고 시스템이 거둔다 — 탐침은 세션이 없을 때의 Idle(0)이다(시작은 위의 WaitUntil 이 봤다). -->
	<At afterSeconds="0.5">
		<Expect probe="PairedAnimation.SessionState" target="Archer" equals="0"/>
		<Pass/>
	</At>
</Scenario>
