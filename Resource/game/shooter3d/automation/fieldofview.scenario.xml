<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 기본 시야각 — 팩 설정(data/gamesettings.xml 의 gameplay.fieldOfView 80)이 전역 변수 gv_cameraFieldOfView 로 적용되는지 본다.
  엔진 기본값은 70 이라, 팩 설정이 안 먹으면 70 으로 남아 실패한다.
  실행: py -3 -m Scripts scenario fieldofview
-->
<Scenario name="shooter3d.fieldofview" fixedDelta="0.0166667" timeoutFrames="60" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="1">
		<ExpectVariable name="gv_cameraFieldOfView" value="80" tolerance="0.001"/>
		<Pass/>
	</At>
</Scenario>
