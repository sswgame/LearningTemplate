<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 에디터 흐름 시나리오 — 캐릭터 편집 창에서 만든 외형을 데이터 프리셋으로 내보내고 씬의 캐릭터가 그 id 로 입는다(언리얼 · 유니티의 프리셋 에셋).
  ① 창의 외형 탭에서 데이터를 읽고 기준 프리셋 첫째 · 장비 세트 첫째(Knight)를 입힌다.
  ② "Export data preset" 으로 임시 리소스 폴더(editor/automationtemp/ — .gitignore 가 무시, 처음과 끝에 지운다)에 EditorKnight.appearance.xml 을 쓴다.
     게임 데이터 폴더(game/shooter3d/data/appearance/presets/)는 건드리지 않는다. 내보내기는 실행 중인 게임의 외형 데이터에도 올린다.
  ③ 오브젝트에 스켈레탈 메시 · 외형 컴포넌트를 달고 인스펙터로 프리셋을 EditorKnight 로 적는다.
  ④ 플레이하면 그 프리셋으로 조립한다 — 머리 칸에 세트의 투구(helmet_knight)가 있다(기준 프리셋에는 없다).
  루트의 editor="true" 로 AppScenarioTest 가 -game=Shooter3D -EnableEditor 로 돌린다.
  실행: py -3 -m Scripts scenario charactereditorscene
-->
<Scenario name="shooter3d.charactereditorscene" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive" editor="true">
	<At frame="1"><WaitUntil probe="Scene.Transitioning" equals="0" timeoutFrames="900"/></At>
	<At frame="5"><ResizeWindow width="1920" height="1080"/><Variable name="gv_editorUiScale" value="1"/></At>
	<At frame="10">
		<DevCommand line="layout.reset"/>
		<DevCommand line="asset.removeImportFolder editor/automationtemp/shooter3d.charactereditorscene"/>
	</At>

	<!-- ① 창 — 외형 탭, 데이터, 기준 프리셋, 세트 -->
	<At frame="30"><DevCommand line="panel.focus charactereditor.main"/></At>
	<At frame="60"><EditorClick mark="charactereditor.tab.appearance" state="down"/></At>
	<At frame="61"><EditorClick mark="charactereditor.tab.appearance" state="up"/></At>
	<At frame="80"><EditorClick mark="charactereditor.loadData"/></At>
	<At frame="95"><EditorClick mark="charactereditor.basePreset"/></At>
	<At frame="105"><EditorClick mark="charactereditor.basePreset.first"/></At>
	<At frame="120"><EditorClick mark="charactereditor.equipSet"/></At>
	<At frame="140"><EditorClick mark="charactereditor.equipSet.first"/></At>
	<At frame="165"><Expect probe="Editor.CharacterEditorEquippedSlotCount" atLeast="1"/></At>

	<!-- ② 데이터 프리셋으로 내보내기 -->
	<At frame="170"><EditorClick mark="charactereditor.exportFolder"/></At>
	<At frame="180"><EditorKey key="Ctrl+A"/></At>
	<At frame="185"><EditorText value="editor/automationtemp/shooter3d.charactereditorscene"/></At>
	<At frame="195"><EditorClick mark="charactereditor.exportID"/></At>
	<At frame="205"><EditorKey key="Ctrl+A"/></At>
	<At frame="210"><EditorText value="EditorKnight"/></At>
	<At frame="220"><EditorClick mark="charactereditor.exportPreset"/></At>
	<At frame="240">
		<Expect probe="Editor.CharacterEditorExportCount" equals="1"/>
		<ExpectLog contains="Exported appearance preset 'EditorKnight' to 'editor/automationtemp/shooter3d.charactereditorscene" count="1"/>
		<CaptureEditorUI file="charactereditorscene/export.png"/>
	</At>
	<At frame="250"><DevCommand line="panel.close charactereditor.main"/></At>

	<!-- ③ 씬의 캐릭터 — 외형 컴포넌트가 내보낸 id 를 가리킨다 -->
	<At frame="270"><EditorClick mark="hierarchy.create"/></At>
	<At frame="285"><EditorClick mark="inspector.name"/></At>
	<At frame="295"><EditorKey key="Ctrl+A"/></At>
	<At frame="300"><EditorText value="Dummy"/></At>
	<At frame="305"><EditorKey key="Enter"/></At>
	<At frame="320"><DevCommand line="component.add CharacterAppearanceComponent"/></At>
	<At frame="330"><DevCommand line="component.add SkeletalMeshComponent"/></At>
	<At frame="350"><EditorClick mark="inspector.property.CharacterAppearanceComponent._presetID"/></At>
	<At frame="360"><EditorKey key="Ctrl+A"/></At>
	<At frame="365"><EditorText value="EditorKnight"/></At>
	<At frame="370"><EditorKey key="Enter"/></At>
	<At frame="390"><Expect probe="Object.Property" target="Dummy" key="CharacterAppearanceComponent._presetID" is="EditorKnight"/></At>

	<!-- ④ 플레이 — 조립 결과 -->
	<At frame="400"><DevCommand line="play"/></At>
	<At frame="401"><WaitUntil probe="Editor.PlayState" equals="1" timeoutFrames="600"/></At>
	<At frame="440">
		<Expect probe="Appearance.Preset" target="Dummy" is="EditorKnight"/>
		<Expect probe="Appearance.SlotItem" target="Dummy" key="Head" is="helmet_knight"/>
		<CaptureEditorUI file="charactereditorscene/play.png"/>
	</At>
	<At frame="450"><DevCommand line="stop"/></At>
	<At frame="451"><WaitUntil probe="Editor.PlayState" equals="0" timeoutFrames="600"/></At>
	<At frame="460">
		<DevCommand line="asset.removeImportFolder editor/automationtemp/shooter3d.charactereditorscene"/>
		<Variable name="gv_editorUiScale" value="0"/>
		<Pass/>
	</At>
</Scenario>
