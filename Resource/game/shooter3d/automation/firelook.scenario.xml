<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 사격 — 플레이어의 클릭이 사격으로 이어진다(서브틱 입력: 폰의 `_triggerLookButton`(Fire)이 눌린 틱의 의도가 발동 시선을 싣고 `ShooterPlayerComponent` 가 그 방향으로 쏜다).
  자동 플레이를 끄고 왼쪽 버튼을 한 프레임 눌러 `Shooter3D.ShotCount` 가 늘고, 길게 눌러도(연사 소총) 계속 쏘는지 본다. 방향 계산 자체는 `ControlTest.TriggerLookCarriesTheControlRotationAtTheClick` 가 본다.
  실행: App.exe -game=Shooter3D -scenario=game/shooter3d/automation/firelook.scenario.xml -dx12
-->
<Scenario name="shooter3d.firelook" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="0">
		<Variable name="gv_shooterAutoPlay" value="0"/>
		<Expect probe="Shooter3D.ShotCount" equals="0"/>
	</At>
	<At frame="20"><Tap slot="Mouse.Left" hold="1"/></At>
	<At frame="30"><Expect probe="Shooter3D.ShotCount" equals="1"/></At>
	<At frame="40"><Tap slot="Mouse.Left" hold="30"/></At>
	<At frame="90">
		<Expect probe="Shooter3D.ShotCount" atLeast="3"/>
		<Expect probe="Shooter3D.PlayerAlive" equals="1"/>
		<Pass/>
	</At>
</Scenario>
