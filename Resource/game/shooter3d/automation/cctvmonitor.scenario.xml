<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D CCTV 모니터 — 게임 셰이더(shaders/cctvmonitor.hlsl)로 그린 북쪽 벽 모니터를 가까이서 찍는다(docs/09_Decisions.md 5-5 머티리얼 셰이더 훅의 게임 셰이더).
  자동 플레이를 끄고 엄폐물 사이로 걸어(시작 (0, -16) 에서 +Z 를 본다. x 5.5 로 비켜 Cover_6 을, x 4.2 로 Cover_2 · Cover_3 사이를 지난다)
  모니터 5 m 앞 (0, 15) 에 선 뒤 찍는다. 걸음은 프레임 수가 아니라 위치(Object.X · Object.Z)로 끊는다.
  눈으로 볼 것: 모니터에 CCTV 렌더 텍스처가 빛 없이(그늘과 상관없이 같은 밝기) 보이고 가로 주사선이 겹친다.
  실행: App.exe -game=Shooter3D -scenario=game/shooter3d/automation/cctvmonitor.scenario.xml -dx12
-->
<Scenario name="shooter3d.cctvmonitor" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="0"><Variable name="gv_shooterAutoPlay" value="0"/></At>
	<At frame="10"><Press slot="Key.D"/></At>
	<At frame="11"><WaitUntil probe="Object.X" target="Player" atLeast="5.5" timeoutFrames="300"/></At>
	<At frame="12"><Release slot="Key.D"/><Press slot="Key.W"/></At>
	<At frame="13"><WaitUntil probe="Object.Z" target="Player" atLeast="1.5" timeoutFrames="600"/></At>
	<At frame="14"><Release slot="Key.W"/><Press slot="Key.A"/></At>
	<At frame="15"><WaitUntil probe="Object.X" target="Player" atMost="4.2" timeoutFrames="300"/></At>
	<At frame="16"><Release slot="Key.A"/><Press slot="Key.W"/></At>
	<At frame="17"><WaitUntil probe="Object.Z" target="Player" atLeast="15" timeoutFrames="600"/></At>
	<At frame="18"><Release slot="Key.W"/><Press slot="Key.A"/></At>
	<At frame="19"><WaitUntil probe="Object.X" target="Player" atMost="0.2" timeoutFrames="300"/></At>
	<At frame="20"><Release slot="Key.A"/></At>
	<At frame="40"><Screenshot file="shooter3d/cctvmonitor.ppm"/></At>
	<At frame="45"><Pass/></At>
</Scenario>
