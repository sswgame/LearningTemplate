<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 키 다시 잡기 — 옵션 메뉴와 같은 길(settings.apply → 사용자 설정 → 입력 맵)로 점프 키를 Space 에서 J 로 바꾸면 J 가 점프하고 Space 는 더는 점프하지 않으며,
  같은 액션의 다른 바인딩(패드 A)은 그대로 점프한다(UiOptionsMenuVerification: 패드 실기 입력은 가상 패드 device="gamepad" 로 같은 길을 지난다).
  사용자 폴더를 건드리지 않게 설정 파일을 Saved/Automation 아래로 돌린다. 앞 실행이 J 를 남겼을 수 있어 시작할 때 Space 로 되돌린다(같은 값이면 바뀐 게 없다).
  재시작 뒤 유지(저장 → 새 설정 관리자가 읽기 → 입력 맵 반영)는 UserSettingsTest.KeyBindingSurvivesRestart 가 본다.
  개발 명령이 없는 구성(Shipping)은 건너뛴다.
  실행: py -3 -m Scripts scenario rebind   (AppScenarioTest 가 백엔드마다 돈다)
-->
<Scenario name="shooter3d.rebind" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_userSettingsFile" value="Saved/Automation/shooter3d.rebind/usersettings.json"/>
	<At frame="0">
		<Variable name="gv_shooterAutoPlay" value="0"/>
		<DevCommand line="settings.apply controls.jump=Key.Space"/>
	</At>
	<!-- 기본 키 Space 로 점프한다. -->
	<At frame="12"><Tap slot="Key.Space" hold="1"/></At>
	<At afterSeconds="0.1"><Expect probe="Object.Y" target="Player" atLeast="1.9"/></At>
	<At after="10"><WaitUntil probe="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/></At>

	<!-- Jump 를 J 로 다시 잡는다. 이제 Space 는 점프하지 않는다. -->
	<At after="2"><DevCommand line="settings.apply controls.jump=Key.J"/></At>
	<At after="5"><Tap slot="Key.Space" hold="1"/></At>
	<At afterSeconds="0.2"><Expect probe="Object.Y" target="Player" atMost="1.65"/></At>

	<!-- J 가 점프한다. -->
	<At after="2"><Tap slot="Key.J" hold="1"/></At>
	<At afterSeconds="0.1"><Expect probe="Object.Y" target="Player" atLeast="1.9"/></At>
	<At after="10"><WaitUntil probe="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/></At>

	<!-- 같은 액션의 패드 바인딩(A)은 그대로다. 끝에서 기본 키로 되돌린다. -->
	<At after="2"><Action name="Jump" device="gamepad"/></At>
	<At afterSeconds="0.1"><Expect probe="Object.Y" target="Player" atLeast="1.9"/></At>
	<At after="10"><WaitUntil probe="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/></At>
	<At after="2">
		<DevCommand line="settings.apply controls.jump=Key.Space"/>
		<Pass/>
	</At>
</Scenario>
