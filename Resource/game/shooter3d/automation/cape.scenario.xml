<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 스프링 망토(ShooterCharacterIntegration S7) — 기사의 망토(itemvisuals.xml 의 cape_knight, kind="Skinned" 에 자기 스켈레톤 · 리그 knight_cape.rig.xml)가
  몸이 움직일 때 뒤처져 흔들리는지 3인칭 사진으로 본다. 서 있는 사진 · 달리기 시작 · 달리다 멈춘 직후(관성으로 앞으로 쏠린다)를 찍는다.
  망토가 아직 정적 프리팹(knight_cape.prefab.xml)이면 사진 셋이 같은 모양이다 — S7 의 임포트 · 데이터 전환(MakeSkinnedCape.py → App 의 모델 임포트 → itemvisuals)이 먼저다.
  실행: App.exe -game=Shooter3D -scenario=game/shooter3d/automation/cape.scenario.xml -dx12
-->
<Scenario name="shooter3d.cape" fixedDelta="0.0166667" timeoutFrames="500" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_cameraPreset" value="orbit"/>
	<At frame="0"><Variable name="gv_shooterAutoPlay" value="0"/></At>
	<At frame="60"><Screenshot file="shooter3d/cape_standing.ppm"/></At>
	<At frame="70"><Press slot="Key.W"/><Press slot="Key.LeftShift"/></At>
	<At frame="85"><Screenshot file="shooter3d/cape_start.ppm"/></At>
	<At frame="150"><Screenshot file="shooter3d/cape_running.ppm"/></At>
	<At frame="155"><Release slot="Key.W"/><Release slot="Key.LeftShift"/></At>
	<At frame="162"><Screenshot file="shooter3d/cape_stopped.ppm"/></At>
	<At frame="240"><Screenshot file="shooter3d/cape_settled.ppm"/></At>
	<At frame="245"><Pass/></At>
</Scenario>
