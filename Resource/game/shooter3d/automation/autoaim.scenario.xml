<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 자동 조준 AI — 판단 상태(AI.State: Patrol 적 없음 · Aim 겨눔 · Fire 쏨)와 블랙보드(TargetDistance)를 단언한다.
  자동 플레이를 켜면 디렉터가 ShooterAutoPlay 오브젝트의 자동 조준 조종자를 플레이어 폰에 빙의시킨다. 첫 적은 시작 즈음 이미 일어나 있어 바로 겨눈다.
  App -game=Shooter3D -scenario=game/shooter3d/automation/autoaim.scenario.xml -dx12 (종료 코드 0 = 통과)
-->
<Scenario name="shooter3d.autoaim" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="0"><Variable name="gv_shooterAutoPlay" value="1"/></At>
	<At frame="10"><Expect probe="Pawn.Controller" target="Player" is="ShooterAutoPlay"/></At>
	<!-- 5 초 안에 적을 겨눠 쏘고, 10 초 안에 적을 맞힌다. -->
	<At frame="11"><WaitUntil probe="AI.State" target="ShooterAutoPlay" is="Fire" timeoutSeconds="5"/></At>
	<At after="1"><WaitUntil probe="Shooter3D.EnemyHitCount" atLeast="1" timeoutSeconds="10"/></At>
	<!-- 히트스캔은 쏜 프레임에 맞는다 — 맞음이 쏨에서 겨눔으로 돌아가기보다 먼저 올 수 있어, 다시 겨눌 때까지 기다린 뒤 이력을 본다. -->
	<At after="1"><WaitUntil probe="AI.State" target="ShooterAutoPlay" is="Aim" timeoutSeconds="5"/></At>
	<At after="1">
		<ExpectVisited probe="AI.State" target="ShooterAutoPlay" sequence="Aim, Fire, Aim"/>
		<Expect probe="AI.Blackboard" target="ShooterAutoPlay" key="TargetDistance" atMost="40"/>
		<ExpectVisited probe="AI.MoveStatus" target="ShooterAutoPlay" is="Moving"/>
	</At>
	<!-- 끄면 플레이어 조종자가 되찾는다. -->
	<At after="1"><Variable name="gv_shooterAutoPlay" value="0"/></At>
	<At after="10">
		<Expect probe="Pawn.Controller" target="Player" is="PlayerController"/>
		<Pass/>
	</At>
</Scenario>
