<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 보폭 워핑 — 몸 프리팹의 리그(rigs/player_body.rig.xml 의 노드 Stride)가 몸 메시에 묶인 뒤에만 값이 들어가고(프로브 StrideAppliedCount 가 오르는 때가 isRigReady 이후다),
  서 있으면 배율 1(포즈가 바뀌지 않는다)이다. 이동 중 배율(이동 속도 / 재생한 발 속도)은 노드가 min_scale 0.6 ~ max_scale 1.6 으로 자르므로 프로브 값은 그 범위 밖일 수 있다 —
  값 자체는 클립의 발 속도에 달렸으니 화면으로 본다 — 서 있는 사진과 뒷걸음 달리기 사진을 견줘 발이 덜 미끄러지는지(연속 사진은 -gv_shooterMotionTrace).
  자동 플레이를 끄고 걷는다(시작 (0, -16) 에서 +Z 를 본다. 뒷걸음은 -Z 쪽 한 걸음 거리).
  실행: App.exe -game=Shooter3D -scenario=game/shooter3d/automation/stridewarping.scenario.xml -dx12
-->
<Scenario name="shooter3d.stridewarping" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<At frame="0"><Variable name="gv_shooterAutoPlay" value="0"/></At>
	<!-- 서 있다: 리그가 묶였고(값이 들어간다) 배율은 1 이다. -->
	<At frame="60">
		<Expect probe="Shooter3D.StrideAppliedCount" atLeast="10"/>
		<Expect probe="Shooter3D.StrideScale" near="1" tolerance="0.001"/>
		<Screenshot file="shooter3d/stride_standing.ppm"/>
	</At>
	<!-- 뒷걸음 + 달리기 키: 재생 속도 범위에 막힌 몫이 보폭으로 간다. -->
	<At frame="70"><Press slot="Key.S"/><Press slot="Key.LeftShift"/></At>
	<At frame="110">
		<Expect probe="Shooter3D.StrideAppliedCount" atLeast="100"/>
		<Expect probe="Shooter3D.StrideScale" atLeast="0.1"/>
		<Screenshot file="shooter3d/stride_backward_run.ppm"/>
	</At>
	<At frame="120"><Release slot="Key.S"/><Release slot="Key.LeftShift"/></At>
	<!-- 멈춘 뒤 다시 1 로 돌아온다. -->
	<At frame="200">
		<Expect probe="Shooter3D.StrideScale" near="1" tolerance="0.001"/>
		<Pass/>
	</At>
</Scenario>
