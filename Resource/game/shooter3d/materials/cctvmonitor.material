<?xml version="1.0" encoding="utf-8"?>
<!-- CCTV 모니터 화면 — 알베도가 렌더 텍스처(rendertarget/shooter_cctv)다. CctvCamera 의 캡처 카메라가 그 텍스처에 10 Hz 로 그린다. -->
<MaterialDesc formatVersion="0" name="ShooterCctvMonitor" shaderPath="engine/shaders/forwardlit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="color" type="Color" shaderType="Float4" defaultValue="1.6 1.6 1.6 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="roughness" type="Range" shaderType="Float" defaultValue="0.2" min="0.0" max="1.0" group="Surface"/>
		<item name="albedoMap" type="Texture2D" assetPath="rendertarget/shooter_cctv" displayName="Albedo" group="Surface" bSrgb="1"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
