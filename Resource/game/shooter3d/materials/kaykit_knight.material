<?xml version="1.0" encoding="utf-8"?>
<!-- KayKit 기사 아틀라스 머티리얼 — albedoMap 이 원본 GLB 에 든 텍스처(textures_raw/kaykit_knight.png)다. color 는 외형 꾸미기의 염색(MaterialColor → color)이 곱한다. 캐릭터 몸과 그 장비 프리팹이 나눠 쓴다. -->
<MaterialDesc formatVersion="0" name="KayKitKnight" shaderPath="engine/shaders/forwardlit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="color" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="roughness" type="Range" shaderType="Float" defaultValue="0.5" min="0.0" max="1.0" group="Surface"/>
		<item name="albedoMap" type="Texture2D" assetPath="game/shooter3d/textures/kaykit_knight.dds" displayName="Albedo" group="Surface" bSrgb="1"/>
		<item name="useNormalMap" type="Keyword" defaultValue="0" shaderKeyword="MATERIAL_NORMALMAP" displayName="Normal Map" group="Features"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_staticSwitches>
			<item name="UseNormalMap" keyword="MATERIAL_NORMALMAP" keywordOff="MATERIAL_NORMALMAP_OFF" bEnabled="0" bShaderFeature="1"/>
		</_staticSwitches>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
