<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 외형 프리셋(CharacterAppearance). parent 위에 다른 값만 적는다 — 값은 매개변수별, 칸은 칸별, 소켓은 이름별로 아래가 덮고 세트는 쌓인다.
     쉼표 목록(items · options) · 범위(min/max) · 색 목록(colors, ; 로 나눔)은 씨앗으로 뽑는다(무작위 NPC).
     Equip 는 set 하나 또는 slot 하나 — item="" 은 칸을 비우고, visible 은 보이는 외형만 바꾼다(형상 변경), 안의 Value 는 그 아이템 인스턴스의 꾸미기 값이다.
     플레이어는 ShooterPlayer(기사 세트 + 소총, 푸른 염색), 적은 Skeleton* 셋과 씨앗마다 섞이는 SkeletonRaider 다(ShooterDirectorComponent 의 적 프리셋 목록). -->
<CharacterAppearanceCatalog>
  <CharacterAppearance id="Adventurer" schema="Adventurer" bodyType="Male" bodyShape="Average" body="body_knight" tags="Race.Human"/>

  <CharacterAppearance id="ShooterPlayer" parent="Adventurer" tags="Faction.Player">
    <Value name="OutfitDye" color="0.62 0.78 1 1"/>
    <Equip set="Knight"/>
    <Equip slot="MainHand" item="blaster_rifle"/>
  </CharacterAppearance>

  <CharacterAppearance id="ShooterRogue" parent="Adventurer" body="body_rogue" tags="Faction.Player">
    <Value name="OutfitDye" colors="1 1 1 1; 1 0.85 0.7 1"/>
    <Equip slot="Back" item="cape_rogue"/>
    <Equip slot="MainHand" item="blaster_pistol"/>
  </CharacterAppearance>

  <CharacterAppearance id="SkeletonBase" schema="Skeleton" bodyType="Male" bodyShape="Average" body="body_skeleton_minion" tags="Race.Undead">
    <Value name="BoneTint" colors="1 1 1 1; 0.86 0.95 0.82 1; 1 0.86 0.8 1; 0.85 0.85 1 1"/>
  </CharacterAppearance>

  <CharacterAppearance id="SkeletonMinion" parent="SkeletonBase">
    <Equip slot="MainHand" item="blade_skeleton"/>
  </CharacterAppearance>

  <!-- 전사는 두건을 쓰고 투구를 덮어쓴다 — 규칙(HelmetHidesHood)이 두건을 감춘다. -->
  <CharacterAppearance id="SkeletonWarrior" parent="SkeletonBase" body="body_skeleton_warrior">
    <Value name="Hood" option="Hooded"/>
    <Equip slot="Head" item="helmet_skeleton"/>
    <Equip slot="MainHand" item="axe_skeleton"/>
    <Equip slot="OffHand" item="shield_skeleton"/>
  </CharacterAppearance>

  <CharacterAppearance id="SkeletonRogue" parent="SkeletonBase" body="body_skeleton_rogue">
    <Value name="Hood" option="Hooded"/>
    <Equip slot="Back" item="cape_skeleton"/>
    <Equip slot="MainHand" item="blade_skeleton"/>
  </CharacterAppearance>

  <!-- 씨앗마다 다른 해골 — 몸 · 두건 · 무기를 뽑는다. -->
  <CharacterAppearance id="SkeletonRaider" parent="SkeletonBase" body="body_skeleton_minion,body_skeleton_rogue,body_skeleton_warrior">
    <Value name="Hood" options="Bare,Hooded"/>
    <Equip slot="Back" item="cape_skeleton"/>
    <Equip slot="MainHand" items="blade_skeleton,axe_skeleton"/>
  </CharacterAppearance>
</CharacterAppearanceCatalog>
