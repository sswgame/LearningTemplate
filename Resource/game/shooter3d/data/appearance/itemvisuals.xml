<?xml version="1.0" encoding="utf-8"?>
<!-- 아이템 외형. ItemDef 는 visual id 만 가리키고 한 외형을 여러 아이템이 나눈다(형상 변경은 이 id 를 바꾼다).
     Part kind: Skinned(캐릭터 스켈레톤을 따르는 mesh) · SocketPrefab(prefab 을 socket 에 — 후보는 쉼표, 앞의 것이 있으면 그것) ·
     BodyModification(Morph · Material · HideRegion) · Sprite(2D). sockets 는 부품의 소켓 에셋 — 해석된 외형에서는 "<칸>.<소켓>" 이름이 된다(MainHand.Muzzle).
     몸은 KayKit 캐릭터(41 관절 리그 — 몸 소켓은 data/sockets/kaykit_humanoid.sockets.xml)를 임포트한 models/kaykit/*.mesh, 장비는 원본에서 본에 붙어 있던
     강체 메시를 프리팹(prefabs/kaykit/)으로 감싼 것이다. 블래스터는 Kenney Blaster Kit — offset 은 손잡이를 손에 맞추는 Gun 소켓 기준 자리다. -->
<ItemVisualCatalog>
  <ItemVisual id="body_knight">
    <Part name="Body" kind="Skinned" mesh="game/shooter3d/models/kaykit/knight.mesh" skeleton="game/shooter3d/models/kaykit/knight/knight.skeleton.xml"
          material="game/shooter3d/materials/kaykit_knight.material" sockets="game/shooter3d/data/sockets/kaykit_humanoid.sockets.xml"/>
  </ItemVisual>
