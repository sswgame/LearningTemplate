<?xml version="1.0" encoding="utf-8"?>
<!-- Shooter3D 의 장비 아이템(게임플레이 정의). 외형은 visual 이 가리키는 data/appearance/itemvisuals.xml 의 항목이다 — 아티스트는 이 파일을 건드리지 않는다.
     recon_patch 는 정찰 세트를 모두 입어야 낀다(Requires) — 세트 한 조각을 벗으면 낀 채 숨긴다(breakPolicy="KeepHidden"). -->
<ItemCatalog>
  <Item id="helmet_combat" name="Combat Helmet" category="Armor" slot="Head" visual="helmet_combat" tags="Armor.Light" durability="100"><Stats armor="2"/></Item>
  <Item id="helmet_recon" name="Recon Helmet" category="Armor" slot="Head" visual="helmet_recon" tags="Armor.Light,Set.Recon"><Stats armor="3"/></Item>
  <Item id="fatigues" name="Fatigues" category="Armor" slot="Body" visual="fatigues" tags="Cloth"/>
  <Item id="vest_recon" name="Recon Vest" category="Armor" slot="Body" visual="vest_recon" tags="Armor.Medium,Set.Recon"><Stats armor="5"/></Item>
  <Item id="vest_recon_f" name="Recon Vest" category="Armor" slot="Body" visual="vest_recon_f" tags="Armor.Medium,Set.Recon"><Stats armor="5"/></Item>
  <Item id="boots_recon" name="Recon Boots" category="Armor" slot="Feet" visual="boots_recon" tags="Set.Recon"/>
  <Item id="recon_patch" name="Recon Patch" category="Accessory" slot="Shoulder" visual="recon_patch" breakPolicy="KeepHidden"><Requires set="Recon"/></Item>
  <Item id="backpack" name="Field Pack" category="Gear" slot="Back" visual="backpack"/>
  <Item id="rifle_m4" name="M4 Rifle" category="Weapon" slot="Weapon" visual="rifle_m4" durability="100"/>
  <Item id="pistol_m9" name="M9 Pistol" category="Weapon" slot="Sidearm" visual="pistol_m9"/>
</ItemCatalog>
