<!--
  활 쏘기 페어드 애니메이션 샘플(docs/plans/PairedAnimation.md). 궁수가 앵커이고, 활은 궁수 손 소켓에 붙은 채로 같은 시각을 재생한다.
  궁수 클립은 기사(KayKit)의 2H_Ranged_Shoot 이고 길이(1.0666667 초)가 타임라인 길이다. 활 · 화살 클립은 Scripts/dev/MakeBowProps.py 가 만든다
  (활 Bow_Shoot_Bow 1 초 — 0.6 초에 시위를 놓음, 화살 Arrow_Nock 0.4 초). 메긴 화살은 선택 역할로 0.2 초에 들어와 놓는 시각(0.6 초)에 클립이 끝나 나간다.
  발사는 공유 알림 ReleaseArrow 가 활 오브젝트의 알림 표(SpawnPrefab — 투사체 프리팹, 시위 소켓)로 간다. 시각을 바꾸면 생성기의 kReleaseSeconds 도 바꾼다(TestMakeBowProps 가 대조한다).
-->
<PairedAnimation duration="1.0666667">
  <Role name="Archer" anchor="true" required="true" clip="2H_Ranged_Shoot" enterBlend="0.15" exitState="Idle" exitBlend="0.2"/>
  <Role name="Bow" required="true" clip="Bow_Shoot_Bow" align="none" enterBlend="0" exitState="Bow_Idle" exitBlend="0.1"/>
  <Role name="Arrow" required="false" clip="Arrow_Nock" start="0.2" align="none" enterBlend="0" exitState="Arrow_Hidden" exitBlend="0"/>
  <Notify name="ReleaseArrow" time="0.6" role="Bow"/>
</PairedAnimation>
