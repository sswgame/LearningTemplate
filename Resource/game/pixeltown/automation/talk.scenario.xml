<?xml version="1.0" encoding="utf-8"?>
<!--
  PixelTown 걸음 · 충돌 · 대화 시나리오 — 가상 키 → 플레이어 조종자 → 주인공 폰의 의도 → 오버월드 키트의 한 칸 걸음 → 디렉터의 대화.
  주인공은 스폰 칸 (7,7)에서 시작한다. 위로 두 칸 가면 집 벽(소품 레이어의 solid 브러시)에 막히고, 내려와 오른쪽 다섯 칸 가서
  위를 보면 촌장(대화 러너를 단 오브젝트)이 선 칸이라 막힌다. Space 로 말을 걸고 두 줄을 넘기면 대화가 끝나고 다시 걸을 수 있다.
  App -game=PixelTown -scenario=game/pixeltown/automation/talk.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="pixeltown.talk" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" input="exclusive">
	<At frame="10"><Expect probe="Town.HeroTileX" equals="7"/><Expect probe="Town.HeroTileY" equals="7"/></At>
	<!-- 위로 두 칸(한 칸 0.18 초 = 11 프레임), 셋째 칸은 집 벽이라 서서 위를 본다(3 = 위). -->
	<At frame="11"><Tap slot="Key.W" hold="2"/></At>
	<At frame="30"><Tap slot="Key.W" hold="2"/></At>
	<At frame="49"><Expect probe="Town.HeroTileY" equals="5"/></At>
	<At frame="50"><Tap slot="Key.W" hold="2"/></At>
	<At frame="69"><Expect probe="Town.HeroTileY" equals="5"/><Expect probe="Town.HeroFacing" equals="3"/></At>
	<!-- 길로 내려와 오른쪽 다섯 칸. -->
	<At frame="70"><Tap slot="Key.S" hold="2"/></At>
	<At frame="89"><Tap slot="Key.S" hold="2"/></At>
	<At frame="110"><Tap slot="Key.D" hold="2"/></At>
	<At frame="129"><Tap slot="Key.D" hold="2"/></At>
	<At frame="148"><Tap slot="Key.D" hold="2"/></At>
	<At frame="167"><Tap slot="Key.D" hold="2"/></At>
	<At frame="186"><Tap slot="Key.D" hold="2"/></At>
	<At frame="205"><Expect probe="Town.HeroTileX" equals="12"/><Expect probe="Town.HeroTileY" equals="7"/></At>
	<!-- 위는 촌장이 선 칸이라 막히고 위를 본다. -->
	<At frame="206"><Tap slot="Key.W" hold="2"/></At>
	<At frame="225"><Expect probe="Town.HeroTileY" equals="7"/><Expect probe="Town.HeroFacing" equals="3"/><Expect probe="Town.Talking" equals="0"/></At>
	<!-- 말을 건다 — 첫 줄. -->
	<At frame="226"><Tap slot="Key.Space" hold="1"/></At>
	<At frame="240"><Expect probe="Town.Talking" equals="1"/><Expect probe="Town.ShownLines" equals="1"/></At>
	<!-- 대화 중에는 걷지 않는다. -->
	<At frame="241"><Tap slot="Key.D" hold="2"/></At>
	<At frame="260"><Expect probe="Town.HeroTileX" equals="12"/></At>
	<!-- 둘째 줄, 그리고 끝. -->
	<At frame="261"><Tap slot="Key.Space" hold="1"/></At>
	<At frame="275"><Expect probe="Town.Talking" equals="1"/><Expect probe="Town.ShownLines" equals="2"/></At>
	<At frame="276"><Tap slot="Key.Space" hold="1"/></At>
	<At frame="290"><Expect probe="Town.Talking" equals="0"/><Expect probe="Town.FinishedTalks" equals="1"/></At>
	<!-- 대화가 끝나면 다시 걷는다. -->
	<At frame="291"><Tap slot="Key.D" hold="2"/></At>
	<At frame="310"><Expect probe="Town.HeroTileX" equals="13"/></At>
	<At frame="311"><Pass/></At>
</Scenario>
