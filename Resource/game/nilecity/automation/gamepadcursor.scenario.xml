<?xml version="1.0" encoding="utf-8"?>
<!--
  NileCity 패드 가상 커서 시나리오 — 입력 맵의 virtualCursor="LeftStick"(nile.input.xml)이 켠 가상 커서를 시나리오의 패드 스크립트가 움직인다
  (InputManager 는 배타 가상 입력일 때도 가상 커서를 돌린다). 왼쪽 스틱 X 를 끝까지 밀면 커서가 오른쪽으로 가고(Input.MouseX 가 늘어난다), 놓으면 선다.
  A · B 가 마우스 왼쪽 · 오른쪽 버튼이 되는 규칙과 확대 속도의 프레임률 무관은 EngineTest 의 VirtualCursorTest(PadButtonsBecomeMouseButtons ·
  DistanceDoesNotDependOnFrameRate)가 본다.
  커서 속도 900 px/s(`VirtualCursorSettings::_speed`)라 30 프레임(0.5 초)이면 약 450 px 간다. 시작 위치는 창의 10 %, 문턱 300 px 은 창이 1280 px 보다 좁지 않다는 가정이다.
  App -scenario=game/nilecity/automation/gamepadcursor.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="nilecity.gamepadcursor" fixedDelta="0.0166667" timeoutFrames="200" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_nileAutoPlay" value="0"/></At>
	<At frame="20"><MousePosition x="0.1" y="0.5"/></At>
	<At frame="24"><Expect probe="Input.VirtualCursorEnabled" equals="1"/><Remember probe="Input.MouseX" as="before"/></At>
	<!-- 왼쪽 스틱 X(축 0)를 30 프레임 끝까지 민다 -->
	<At frame="25"><GamepadAxis axis="0" value="1"/></At>
	<At frame="55"><GamepadAxis axis="0" value="0"/></At>
	<At frame="65"><Expect probe="Input.MouseX" differsFrom="before"/></At>
	<At frame="66"><Expect probe="Input.MouseX" atLeast="300"/></At>
	<!-- 스틱을 놓으면 커서가 선다 -->
	<At frame="70"><Remember probe="Input.MouseX" as="stopped"/></At>
	<At frame="90"><Expect probe="Input.MouseX" sameAs="stopped"/></At>
	<At frame="95"><Pass/></At>
</Scenario>
