<?xml version="1.0" encoding="utf-8"?>
<!--
  WildWest 탑승 시나리오 — 기수가 곁의 말(Bessie)에 올라타고(Mount), W + Shift 로 2 초 질주하고, 멈춘 뒤 내린다(Dismount).
  탑승 단계와 탐침 Pawn.Seat · Pawn.Controller 를 실제 게임에서 돌리고, 말 AI 가 탈 때 빙의를 넘기고 내리면 되찾는지 본다.
  App -game=WildWest -scenario=game/wildwest/automation/mount.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="wildwest.mount" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_wildWestAutoPlay" value="0"/></At>
	<!-- 걷는 기수는 플레이어 조종자가 쥐고, 말은 말 AI 가 쥔다. -->
	<At frame="10">
		<Expect probe="Pawn.Seat" target="Player" is="none"/>
		<Expect probe="Pawn.Controller" target="Player" is="PlayerController"/>
		<Expect probe="Pawn.Controller" target="Bessie" is="BessieAI"/>
		<Expect probe="WildWest.Stamina" target="Bessie" near="1" tolerance="0.001"/>
	</At>
	<!-- 타는 거리(2.5 m) 안의 Bessie 에 탄다 — 운전석이라 플레이어 조종자가 말을 쥔다. -->
	<At frame="11"><Mount rider="Player" vehicle="Bessie"/></At>
	<At after="2">
		<Expect probe="Pawn.Seat" target="Player" is="Bessie"/>
		<Expect probe="Pawn.Controller" target="Bessie" is="PlayerController"/>
		<Expect probe="Object.Z" target="Bessie" near="0" tolerance="0.05"/>
	</At>
	<!-- W + Shift 2 초 — 앞으로 질주하며 스태미나를 쓴다. 기수는 좌석에 붙어 함께 간다. -->
	<At frame="15"><Press slot="Key.W"/><Press slot="Key.LeftShift"/></At>
	<At frame="135">
		<Expect probe="WildWest.Gait" target="Bessie" equals="4"/>
		<Expect probe="WildWest.Speed" target="Bessie" atLeast="8"/>
		<Expect probe="WildWest.Stamina" target="Bessie" atMost="0.9"/>
		<Expect probe="Object.Z" target="Bessie" atLeast="6"/>
		<Expect probe="Object.Z" target="Player" atLeast="6"/>
		<Expect probe="Pawn.Seat" target="Player" is="Bessie"/>
		<!-- 눈 확인용(GPU 검증 — Shipping 에서도 같은 그림인지): 질주 중 말과 기수 -->
		<Screenshot file="wildwest/mount_gallop.ppm"/>
	</At>
	<At frame="136"><Release slot="Key.W"/><Release slot="Key.LeftShift"/></At>
	<!-- 감속(8 m/s²)으로 선다. -->
	<At frame="240"><Expect probe="WildWest.Gait" target="Bessie" equals="0"/></At>
	<!-- 내린다 — 플레이어 조종자는 기수를, 말 AI 는 말을 되찾는다. 기수는 말 왼쪽(하차 위치)에 서서 바닥에 닿는다. -->
	<At frame="241"><Dismount rider="Player"/></At>
	<At after="2">
		<Expect probe="Pawn.Seat" target="Player" is="none"/>
		<Expect probe="Pawn.Controller" target="Player" is="PlayerController"/>
		<Expect probe="Pawn.Controller" target="Bessie" is="BessieAI"/>
	</At>
	<At after="30"><Expect probe="Object.Y" target="Player" near="0" tolerance="0.3"/><Pass/></At>
</Scenario>
