<?xml version="1.0" encoding="utf-8"?>
<!--
  StarSkirmish 컴퓨터 상대 — 행동 트리(RTSCommanderAI)가 머문 잎(Skirmish.AITask, key = 플레이어)을 단언한다. 사람(파랑, 0) 대 AI(빨강, 1)로 연다.
  AI 는 0.5 초마다 트리를 한 번 돌며 경제 가지(GatherIdle → TrainWorkers → BuildSupply → BuildProduction → TrainArmy → Attack)를 지난다. 작업이 한 틱에 끝나므로
  탐침은 그 틱에 마지막으로 성공한 작업을 보인다 — 노는 일꾼 보내기는 늘 성공하고, 일꾼 만들기는 광물이 모인 틱에만 성공한다.
  첫 일꾼은 광물 50 이 모이는 13 초 즈음, 보급 건물은 보급이 차는 37 초 즈음에 나온다(DX12 실측). 기록은 백엔드끼리 같아야 한다.
  App -game=StarSkirmish -scenario=game/starskirmish/automation/ai.scenario.xml (종료 코드 0 = 통과)
-->
<Scenario name="starskirmish.ai" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" input="exclusive">
	<At frame="0"><Variable name="gv_skirmishAutoPlay" value="0"/></At>
	<At frame="10"><Expect probe="Skirmish.AITask" key="1" is="GatherIdle"/></At>
	<!-- 20 초 안에 첫 일꾼을 만들고, 그 뒤 40 초 안에 보급 건물을 건설한다. -->
	<At frame="11"><WaitUntil probe="Skirmish.AITask" key="1" is="TrainWorkers" timeoutSeconds="20"/></At>
	<At after="1"><WaitUntil probe="Skirmish.AITask" key="1" is="BuildSupply" timeoutSeconds="40"/></At>
	<At after="1">
		<ExpectVisited probe="Skirmish.AITask" key="1" sequence="GatherIdle, TrainWorkers, GatherIdle, TrainWorkers, BuildSupply"/>
		<Record probe="Skirmish.AITask" key="1"/>
		<Record probe="Scene.TransformHash"/>
		<Pass/>
	</At>
</Scenario>
