/**
 * @file PredefinedAnnotationField.xxx
 * @brief REFLECT / ENUM / PROPERTY / FUNCTION 애노테이션 필드 하나가 파싱에서 코드젠까지 가는 길을 한 줄로 정합니다.
 * @details include 하기 전에 두 매크로를 정의하십시오(`AnnotationFields.cpp` 가 전개합니다).
 *
 *          REGISTER_ANNOTATION_FIELD( Scope, Id, Member, Emit )         값을 멤버에 그대로 넣는다
 *          REGISTER_ANNOTATION_FIELD_FN( Scope, Id, Member, Fn, Emit )  값을 `Fn( 대상, 값 )` 이 넣는다
 *
 *          Scope  : Reflect | Enum | Property | Function   (PredefinedReflectAnnotation.xxx 의 Id)
 *          Id     : AnnotationMeta.txt 의 정규 필드명(`flag.ReadOnly` 의 ReadOnly). 철자(별칭)는 거기서 늘립니다.
 *          Member : 값이 들어가는 ParsedReflection.h 의 멤버입니다. **멤버 타입이 곧 값의 종류입니다.**
 *                     uint8 비트필드   → bool    (단독 토큰 `X` 와 `X = true/false`)
 *                     string · 목록    → 문자열  (`X = "..."`)
 *                     float32          → 실수    (`X = 1.5`)
 *                     FunctionNetRole  → 넷 역할 (단독 토큰 `Server` 등. 토큰 자체가 값입니다)
 *                   그대로 넣는 줄(`REGISTER_ANNOTATION_FIELD`)은 uint8 과 string 만 받습니다. 나머지는 `_FN` 입니다.
 *          Fn     : `void Fn( 대상&, string_view 값 )`. `AnnotationFields.cpp` 에 있습니다.
 *          Emit   : Editor  — 생성 코드의 `#if !defined( SW_SHIPPING )` 블록 안에 `<접두>_metadata.<Member>` 로 씁니다
 *                   Runtime — 같은 꼴로 블록 밖에 씁니다
 *                   Manual  — CodeGenerator 가 손으로 씁니다(템플릿 변수 · 별칭 등록 · 범위처럼 메타데이터 멤버가 아닌 자리)
 *                   Editor · Runtime 은 **엔진 쪽 메타데이터 멤버 이름이 DTO 멤버와 같다**는 약속입니다. 커스텀 메타
 *                   (`_listCustomMeta`) 만 엔진에서 `_mapCustomMeta` 로 씁니다 — 목록 → 맵이라 이름이 다릅니다.
 *
 *          **행 순서 = 같은 Emit 묶음 안의 출력 순서입니다.** 적용은 이름으로 찾으므로 순서와 무관합니다.
 *
 *          새 필드 = 이 파일 한 줄 + ParsedReflection.h 멤버 + (Editor · Runtime 이면) 엔진 메타데이터 멤버
 *          + AnnotationMeta.txt 의 철자. 넷이 어긋나면 파서가 시작할 때 멈춥니다(`AnnotationFields::validateBindings`).
 */

// ── REFLECT (타입) ────────────────────────────────────────────────
REGISTER_ANNOTATION_FIELD( Reflect, Category, _category, Editor )
REGISTER_ANNOTATION_FIELD( Reflect, DisplayName, _displayName, Editor )
REGISTER_ANNOTATION_FIELD( Reflect, Tooltip, _tooltip, Editor )
REGISTER_ANNOTATION_FIELD( Reflect, HideInMenu, _bHideInMenu, Editor )
REGISTER_ANNOTATION_FIELD_FN( Reflect, Meta, _listCustomMeta, appendCustomMeta, Editor )
REGISTER_ANNOTATION_FIELD( Reflect, Abstract, _bAbstract, Manual )
REGISTER_ANNOTATION_FIELD( Reflect, Static, _bStatic, Manual )
REGISTER_ANNOTATION_FIELD_FN( Reflect, Alias, _listAlias, appendAlias, Manual )
REGISTER_ANNOTATION_FIELD( Reflect, Validate, _validate, Manual )

// ── ENUM ─────────────────────────────────────────────────────────
REGISTER_ANNOTATION_FIELD_FN( Enum, Meta, _listCustomMeta, appendCustomMeta, Editor )
REGISTER_ANNOTATION_FIELD( Enum, Invalid, _invalidEnumerator, Manual )
REGISTER_ANNOTATION_FIELD( Enum, Count, _countEnumerator, Manual )
REGISTER_ANNOTATION_FIELD( Enum, Flags, _bIsBitFlag, Manual )
REGISTER_ANNOTATION_FIELD_FN( Enum, Alias, _listAlias, appendAlias, Manual )
REGISTER_ANNOTATION_FIELD_FN( Enum, ValueAlias, _listValueAlias, appendValueAlias, Manual )

// ── PROPERTY ─────────────────────────────────────────────────────
REGISTER_ANNOTATION_FIELD( Property, Category, _category, Editor )
REGISTER_ANNOTATION_FIELD( Property, DisplayName, _displayName, Editor )
REGISTER_ANNOTATION_FIELD( Property, Tooltip, _tooltip, Editor )
REGISTER_ANNOTATION_FIELD( Property, HideInInspector, _bHideInInspector, Editor )
REGISTER_ANNOTATION_FIELD_FN( Property, Meta, _listCustomMeta, appendCustomMeta, Editor )
REGISTER_ANNOTATION_FIELD( Property, EditCondition, _editCondition, Editor )
REGISTER_ANNOTATION_FIELD( Property, EditConditionHides, _bEditConditionHides, Editor )
REGISTER_ANNOTATION_FIELD( Property, ColorHdr, _bColorHdr, Editor )
REGISTER_ANNOTATION_FIELD( Property, Multiline, _bMultiline, Editor )
REGISTER_ANNOTATION_FIELD( Property, FileFilter, _fileFilter, Editor )
REGISTER_ANNOTATION_FIELD( Property, DefaultValue, _defaultValue, Runtime )
REGISTER_ANNOTATION_FIELD_FN( Property, AssetType, _assetType, applyAssetType, Runtime )
REGISTER_ANNOTATION_FIELD( Property, ReadOnly, _bReadOnly, Runtime )
REGISTER_ANNOTATION_FIELD( Property, XMLAttribute, _bXMLAttribute, Runtime )
REGISTER_ANNOTATION_FIELD( Property, AssetPath, _bAssetPath, Runtime )
REGISTER_ANNOTATION_FIELD( Property, Polymorphic, _bPolymorphic, Runtime )
REGISTER_ANNOTATION_FIELD( Property, Transient, _bTransient, Runtime )
REGISTER_ANNOTATION_FIELD( Property, SkipIfEmpty, _bSkipIfEmpty, Runtime )
REGISTER_ANNOTATION_FIELD( Property, Replicated, _bReplicated, Runtime )
REGISTER_ANNOTATION_FIELD_FN( Property, RepNotify, _repNotify, applyRepNotify, Runtime )
REGISTER_ANNOTATION_FIELD( Property, SaveGame, _bSaveGame, Runtime )
REGISTER_ANNOTATION_FIELD( Property, Interp, _bInterp, Runtime )
REGISTER_ANNOTATION_FIELD( Property, Validate, _validate, Runtime )
REGISTER_ANNOTATION_FIELD_FN( Property, MinRange, _minRange, applyMinRange, Manual )
REGISTER_ANNOTATION_FIELD_FN( Property, MaxRange, _maxRange, applyMaxRange, Manual )
REGISTER_ANNOTATION_FIELD_FN( Property, UIMinRange, _uiMinRange, applyUIMinRange, Manual )
REGISTER_ANNOTATION_FIELD_FN( Property, UIMaxRange, _uiMaxRange, applyUIMaxRange, Manual )
REGISTER_ANNOTATION_FIELD( Property, Units, _units, Manual )
REGISTER_ANNOTATION_FIELD_FN( Property, Alias, _listAlias, appendAlias, Manual )
REGISTER_ANNOTATION_FIELD( Property, Name, _name, Manual )

// ── FUNCTION ─────────────────────────────────────────────────────
REGISTER_ANNOTATION_FIELD( Function, Category, _category, Editor )
REGISTER_ANNOTATION_FIELD( Function, DisplayName, _displayName, Editor )
REGISTER_ANNOTATION_FIELD( Function, Tooltip, _tooltip, Editor )
REGISTER_ANNOTATION_FIELD( Function, CallInEditor, _bCallInEditor, Editor )
REGISTER_ANNOTATION_FIELD( Function, EditorPreview, _editorPreview, Editor )
REGISTER_ANNOTATION_FIELD_FN( Function, Meta, _listCustomMeta, appendCustomMeta, Editor )
REGISTER_ANNOTATION_FIELD_FN( Function, NetRole, _netRole, applyNetRole, Runtime )
REGISTER_ANNOTATION_FIELD( Function, Reliable, _bReliable, Runtime )
REGISTER_ANNOTATION_FIELD( Function, Validate, _bValidate, Runtime )
