# ==============================================================================
# @file .clang-tidy
# @brief 버그를 찾는 검사만 켠다. 스타일은 CheckCodeConventions.py 와 clang-format 이 본다.
#
# 실행: py -3 Scripts/lint/RunClangTidy.py
#
# 끈 검사는 **이 코드베이스에서 쓸 수 없다고 실측한 것만** 적는다. 끈 이유를 같이 남긴다 —
# 이유가 없으면 다음 사람이 다시 켜고 같은 오탐을 다시 분류한다. 개별 자리의 예외는 여기가
# 아니라 그 자리의 NOLINTNEXTLINE 으로 두고, 왜 의도된 것인지 주석을 붙인다.
# ==============================================================================
Checks: >
  -*,
  bugprone-*,
  clang-analyzer-*,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-optin.core.EnumCastOutOfRange

# -bugprone-easily-swappable-parameters
#     같은 타입 인자가 인접하면 전부 짚는다(Core/App 43건, Engine/Editor 115건). 수학·그래픽스
#     API 는 (x, y, z) / (width, height) 가 본질이어서 끝이 없고, 바꿀 수도 없다. 설계 취향이지
#     결함이 아니다.
#
# -clang-analyzer-optin.core.EnumCastOutOfRange
#     비트 플래그 조합을 열거형으로 캐스팅하면 "유효 범위 밖" 이라고 짚는다(39건). 조합값이
#     열거자와 일대일로 맞지 않는 것은 플래그의 정의다 — formatString 의 Flags, Win32 의
#     _MINIDUMP_TYPE(4165) 등이 전부 이 경우다. 플래그 enum 을 쓰는 한 영구 오탐이다.

HeaderFilterRegex: 'Source[/\].*\.(h|hpp)$'
WarningsAsErrors: ''
FormatStyle: file
