{
  "mcpServers": {
    "graphify": {
      "command": "py",
      "args": [
        "-3",
        "-m",
        "graphify.serve",
        "graphify-out/graph.json"
      ]
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "chrome-devtools": {
      "command": "py",
      "args": [
        "-3",
        "-m",
        "Scripts",
        "browser-mcp",
        "serve"
      ]
    }
  }
}
