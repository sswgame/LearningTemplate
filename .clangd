# ==============================================================================
# @file .clangd
# @brief clangd 언어 서버(LSP) 전역 설정 파일 (YAML 규격)
# ==============================================================================

CompileFlags:
  # ----------------------------------------------------------------------------
  # 0. 컴파일 데이터베이스(compile_commands.json) 위치 지정
  # ----------------------------------------------------------------------------
  CompilationDatabase: build/Ninja-Debug

  # ----------------------------------------------------------------------------
  # 1. 제거할 컴파일러 플래그 (Remove)
  #    - 빌드 툴체인(clang-cl/MSVC)의 바이너리 PCH 및 컴파일러 전용 플래그는
  #      clangd LSP 파서에서 오류를 일으키므로 파싱 시 제외합니다.
  # ----------------------------------------------------------------------------
  Remove:
    # MSVC / clang-cl 프리컴파일드 헤더(PCH) 사용 플래그 제외 (clangd가 헤더를 직접 파싱하도록 유도)
    - /Yu*
    # PCH 바이너리 파일 경로 플래그 제외
    - /Fp*
    # 강제 인클루드 헤더 플래그 제외 (cmake_pch.hxx 충돌 방지)
    - /FI*
    # 런타임 오류 체크 플래그 제외 (컴파일러 전용 플래그)
    - /RTC*
    # 대용량 오브젝트 파일 플래그 제외
    - /bigobj
    # RTTI 비활성화 플래그 제외
    - /GR-
    # 함수/전역변수 패키징 최적화 플래그 제외
    - /Gw
    # clang-cl 드라이버 전용 내부 매핑 플래그 제외 (-clang:-fmerge-all-constants 등)
    - -clang:*

  # ----------------------------------------------------------------------------
  # 2. 추가할 컴파일러 플래그 (Add)
  #    - clangd 파싱 시 불필요한 경고를 무시하여 에디터 진단 출력을 깔끔하게 유지합니다.
  # ----------------------------------------------------------------------------
  Add:
    # 알 수 없는 컴파일러 경고 옵션에 대한 에러 무시
    - -Wno-unknown-warning-option
    # 사용되지 않는 커맨드라인 인자 경고 무시
    - -Wno-unused-command-line-argument

Diagnostics:
  # ----------------------------------------------------------------------------
  # 3. 진단 설정 (Diagnostics)
  # ----------------------------------------------------------------------------
  # 미사용 include 감지 비활성화 (PCH 및 엔진 공통 헤더의 자동 삭제 방지)
  UnusedIncludes: None

  # Clang-Tidy 규칙 세부 조정
  ClangTidy:
    Remove:
      # 프로젝트 자체 네이밍 컨벤션(_camelCase, kPascalCase 등)과의 충돌 방지
      - readability-identifier-naming
