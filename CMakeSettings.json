{
  "configurations": [
    {
      "name": "Ninja-Debug",
      "generator": "Ninja",
      "configurationType": "Debug",
      "inheritEnvironments": [ "clang_cl_x64" ],
      "buildRoot": "${projectDir}\\build\\${name}",
      "installRoot": "${projectDir}\\install\\${name}",
      "cmakeCommandArgs": "",
      "buildCommandArgs": "-j",
      "ctestCommandArgs": "",
      "cmakeToolchain": "${projectDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "variables": [
        {
          "name": "CMAKE_BUILD_TYPE",
          "value": "Debug",
          "type": "STRING"
        },
        {
          "name": "VCPKG_INSTALLED_DIR",
          "value": "${projectDir}/build/vcpkg_installed",
          "type": "PATH"
        }
      ]
    },
    {
      "name": "Ninja-Release",
      "generator": "Ninja",
      "configurationType": "Release",
      "inheritEnvironments": [ "clang_cl_x64" ],
      "buildRoot": "${projectDir}\\build\\${name}",
      "installRoot": "${projectDir}\\install\\${name}",
      "cmakeCommandArgs": "",
      "buildCommandArgs": "-j",
      "ctestCommandArgs": "",
      "cmakeToolchain": "${projectDir}/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "variables": [
        {
          "name": "CMAKE_BUILD_TYPE",
          "value": "Release",
          "type": "STRING"
        },
        {
          "name": "VCPKG_INSTALLED_DIR",
          "value": "${projectDir}/build/vcpkg_installed",
          "type": "PATH"
        }
      ]
    }
  ]
}
