{
  "name": "sw-engine",
  "version-string": "1.0.0",
  "builtin-baseline": "0699a19d0c6386247ce50d4dedbb8217d484d536",
  "dependencies": [
    {
      "name": "astc-encoder",
      "platform": "windows | linux"
    },
    "box2d",
    "cgltf",
    {
      "name": "d3d12-memory-allocator",
      "platform": "windows & !uwp"
    },
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        {
          "name": "d3d12",
          "platform": "windows"
        },
        {
          "name": "tint-tools",
          "platform": "!emscripten"
        },
        {
          "name": "vulkan",
          "platform": "!emscripten"
        },
        {
          "name": "x11",
          "platform": "linux"
        }
      ],
      "platform": "(windows & !uwp) | linux | emscripten"
    },
    {
      "name": "directx-dxc",
      "platform": "windows | linux"
    },
    {
      "name": "directxtex",
      "default-features": false,
      "platform": "windows | linux"
    },
    {
      "name": "etcpak",
      "platform": "windows | linux"
    },
    "freetype",
    {
      "name": "glad",
      "features": [
        "gl-api-46"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "freetype",
        {
          "name": "win32-binding",
          "platform": "windows & !uwp"
        }
      ]
    },
    "imgui-node-editor",
    "imguizmo",
    "implot",
    "joltphysics",
    {
      "name": "libpq",
      "default-features": false,
      "features": [
        "openssl"
      ],
      "platform": "!emscripten & !android"
    },
    "lz4",
    "meshoptimizer",
    {
      "name": "mimalloc",
      "platform": "!emscripten"
    },
    "nfrechette-acl",
    "nlohmann-json",
    "openssl",
    "pugixml",
    "recastnavigation",
    "sqlite3",
    "stb",
    {
      "name": "tracy",
      "default-features": false
    },
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "features": [
        {
          "name": "wayland",
          "platform": "linux"
        },
        {
          "name": "xcb",
          "platform": "linux"
        },
        {
          "name": "xlib",
          "platform": "linux"
        }
      ],
      "platform": "!android & !emscripten"
    },
    {
      "name": "vulkan-memory-allocator",
      "platform": "!emscripten"
    },
    {
      "name": "vulkan-validationlayers",
      "platform": "!linux & !android & !emscripten"
    },
    "zlib",
    "zstd"
  ],
  "features": {
    "complex-text": {
      "description": "Complex text shaping: HarfBuzz shaper and SheenBidi bidi levels (SW_ENABLE_COMPLEX_TEXT)",
      "dependencies": [
        {
          "name": "harfbuzz",
          "default-features": false
        },
        "sheenbidi"
      ]
    }
  }
}
