{
  "name": "sw-engine",
  "version-string": "1.0.0",
  "builtin-baseline": "0699a19d0c6386247ce50d4dedbb8217d484d536",
  "dependencies": [
    "pugixml",
    "nlohmann-json",
    {
      "name": "directx-dxc",
      "platform": "windows | linux"
    },
    {
      "name": "glad",
      "features": [
        "gl-api-46"
      ]
    },
    "vulkan-headers",
    {
      "name": "vulkan-loader",
      "features": [
        "wayland",
        "xcb",
        "xlib"
      ],
      "platform": "linux"
    },
    {
      "name": "vulkan-loader",
      "platform": "!linux & !android & !emscripten"
    },
    {
      "name": "vulkan-validationlayers",
      "platform": "!linux & !android & !emscripten"
    },
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "freetype"
      ]
    },
    {
      "name": "imgui",
      "features": [
        "win32-binding"
      ],
      "platform": "windows & !uwp"
    },
    "implot",
    "imguizmo",
    "imgui-node-editor",
    {
      "name": "directxtex",
      "default-features": false,
      "platform": "windows | linux"
    },
    "stb",
    "freetype",
    "cgltf",
    "meshoptimizer",
    "joltphysics",
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        "vulkan",
        "d3d12",
        "tint-tools"
      ],
      "platform": "windows & !uwp"
    },
    {
      "name": "dawn",
      "default-features": false,
      "features": [
        "vulkan",
        "x11",
        "tint-tools"
      ],
      "platform": "linux"
    },
    {
      "name": "dawn",
      "default-features": false,
      "platform": "emscripten"
    },
    "box2d",
    "nfrechette-acl",
    "recastnavigation",
    {
      "name": "tracy",
      "default-features": false
    },
    "zlib",
    "lz4",
    "zstd",
    "openssl",
    "sqlite3",
    {
      "name": "libpq",
      "default-features": false,
      "features": [
        "openssl"
      ],
      "platform": "!emscripten & !android"
    }
  ],
  "features": {
    "complex-text": {
      "description": "Complex text shaping: HarfBuzz shaper and SheenBidi bidi levels (SW_ENABLE_COMPLEX_TEXT)",
      "dependencies": [
        {
          "name": "harfbuzz",
          "default-features": false
        },
        "sheenbidi"
      ]
    }
  }
}
