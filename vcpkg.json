{
  "name": "sw-engine",
  "version-string": "1.0.0",
  "dependencies": [
    "rapidxml",
    "directx-dxc",
    {
      "name": "glad",
      "features": [
        "gl-api-46",
        "extensions"
      ]
    },
    "vulkan-headers",
    "vulkan-loader",
    "vulkan-validationlayers",
    {
      "name": "imgui",
      "features": [
        "docking-experimental",
        "opengl3-binding",
        "vulkan-binding"
      ]
    },

    {
      "name": "imgui",
      "features": [
        "win32-binding",
        "dx11-binding",
        "dx12-binding"
      ],
      "platform": "windows & !uwp"
    },
    "implot",
    "imguizmo",
    "imgui-node-editor",
    "mimalloc"
  ]
}