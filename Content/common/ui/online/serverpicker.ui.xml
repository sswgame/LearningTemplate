<UIDocument _schemaVersion="1">
	<!-- 서버 고르기 견본 문서(온라인 키트 U1). C++ 화면은 `ServerPickerScreen` 이다. 줄 단추는 코드가 가상 목록 `Servers` 에 보이는 만큼만 만든다(창 크기가 정해져 목록이 그 안에서 스크롤한다). 문서 경로는 호출하는 게임이 `ServerPickerScreen::open` 에 준다. -->
	<UIScreenDef _bPausesGame="false" _defaultFocus="Refresh" />
	<SafeZonePanel>
		<CanvasPanel>
			<BorderPanel _name="Window" _styleClass="window">
				<_slot _anchorMin="0.5,0.5"
				       _anchorMax="0.5,0.5"
				       _offsetMin="-320,-260"
				       _offsetMax="320,260" />
				<BoxPanel _spacing="12" _orientation="Vertical">
					<TextWidget _name="Title" _styleClass="title" _text="Servers" />
					<TextWidget _name="Status" _text="" />
					<ListViewWidget _name="Servers" _rowHeight="36">
						<_slot _sizeRule="Fill" />
					</ListViewWidget>
					<BoxPanel _spacing="12" _orientation="Horizontal">
						<ButtonWidget _name="Refresh" _styleClass="primary" _command="Refresh">
							<TextWidget _text="Refresh" />
						</ButtonWidget>
						<ButtonWidget _name="Close" _command="Close">
							<TextWidget _text="Close" />
						</ButtonWidget>
					</BoxPanel>
				</BoxPanel>
			</BorderPanel>
		</CanvasPanel>
	</SafeZonePanel>
</UIDocument>
