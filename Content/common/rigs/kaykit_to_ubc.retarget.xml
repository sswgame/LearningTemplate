<!-- KayKit 기사 · 도적 뼈대(hips · spine · chest)의 클립을 Quaternius UBC(언리얼 마네킹 이름)로 옮긴다. 두 손 사격 자세(2h_ranged_*)를 UBC 플레이어에 굽는 데 쓴다
     (--bake-retarget, ual1_standard/retargeted/). UAL1 에는 소총 자세가 없어 소총이 권총 조준 자세로 머리 옆에 들렸다. -->
<RetargetProfile source_skeleton="common/models/kaykit/rogue/rogue.skeleton.xml"
                 target_skeleton="common/models/quaternius/animations/ual1_standard/ual1_standard.skeleton.xml"
                 translation="ScaleByPelvisHeight">
	<root source="root" target="root" />
	<pelvis source="hips" target="pelvis" />
	<chains>
		<item name="Spine">
			<source>
				<item>spine</item>
				<item>chest</item>
			</source>
			<target>
				<item>spine_01</item>
				<item>spine_02</item>
				<item>spine_03</item>
			</target>
		</item>
		<item name="Head">
			<source>
				<item>head</item>
			</source>
			<target>
				<item>neck_01</item>
				<item>Head</item>
			</target>
		</item>
		<item name="LeftArm">
			<source>
				<item>upperarm.l</item>
				<item>lowerarm.l</item>
				<item>wrist.l</item>
				<item>hand.l</item>
			</source>
			<target>
				<item>upperarm_l</item>
				<item>lowerarm_l</item>
				<item>hand_l</item>
			</target>
		</item>
		<item name="RightArm">
			<source>
				<item>upperarm.r</item>
				<item>lowerarm.r</item>
				<item>wrist.r</item>
				<item>hand.r</item>
			</source>
			<target>
				<item>upperarm_r</item>
				<item>lowerarm_r</item>
				<item>hand_r</item>
			</target>
		</item>
		<item name="LeftLeg" ik_goal="true">
			<source>
				<item>upperleg.l</item>
				<item>lowerleg.l</item>
				<item>foot.l</item>
			</source>
			<target>
				<item>thigh_l</item>
				<item>calf_l</item>
				<item>foot_l</item>
			</target>
		</item>
		<item name="RightLeg" ik_goal="true">
			<source>
				<item>upperleg.r</item>
				<item>lowerleg.r</item>
				<item>foot.r</item>
			</source>
			<target>
				<item>thigh_r</item>
				<item>calf_r</item>
				<item>foot_r</item>
			</target>
		</item>
		<item name="LeftToe">
			<source>
				<item>toes.l</item>
			</source>
			<target>
				<item>ball_l</item>
			</target>
		</item>
		<item name="RightToe">
			<source>
				<item>toes.r</item>
			</source>
			<target>
				<item>ball_r</item>
			</target>
		</item>
	</chains>
</RetargetProfile>
