<!-- 몸 동작 무대의 해골 리그 — 몸통 지글(가슴 → 머리 사슬, 묶음 Torso). 물성은 몸 프로필(bodyprofiles.xml 의 <Jiggle group="Torso">)이 정한다 — 리그는 본만 적는다.
     weight_curve 를 적으면 클립 커브가 흔들림을 키운다(달리기 클립의 Jiggle.Scale). 해골에는 가슴 · 배 살이 없어 몸통으로 반응을 보인다. -->
<RigAsset>
	<nodes>
		<!-- 발 디딤 — 굽 높이(몸 입력의 발 들림)를 골반과 발 목표에 함께 올린다. 체형 축은 발목만 굽힌다(skeleton_warrior.bodyshape.xml). -->
		<item type="FootPlacement"
		      name="Feet"
		      pelvis="hips"
		      trace_up="0.5"
		      trace_down="0.6"
		      max_pelvis_drop="0.3"
		      interp_speed="12"
		      max_align_degrees="30">
			<feet>
				<item root="upperleg.l" mid="lowerleg.l" end="foot.l" />
				<item root="upperleg.r" mid="lowerleg.r" end="foot.r" />
			</feet>
		</item>
		<item type="Jiggle" name="TorsoJiggle" group="Torso" use_shared_colliders="false">
			<bones>
				<item>chest</item>
				<item>head</item>
			</bones>
		</item>
	</nodes>
</RigAsset>
