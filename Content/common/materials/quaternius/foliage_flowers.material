<!-- Quaternius Stylized Nature 의 식생(FoliageComponent) 구간 머티리얼 — 꽃 덤불의 꽃(glTF MASK 0.2 · 양면). 부모(foliage.material)에 알베도 · 알파 컷오프(glTF MASK 0.2)만 바꾸고 양면으로 그린다. -->
<MaterialDef formatVersion="0" name="foliage_flowers" _base="engine/materials/foliage.material" alphaMode="Mask" cullMode="None" twoSidedLighting="true">
	<_properties>
		<item name="_alphaCutoff" defaultValue="0.2" />
