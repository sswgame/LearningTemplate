<?xml version="1.0" encoding="utf-8"?>
<!-- Quaternius Stylized Nature 의 식생(FoliageComponent) 구간 머티리얼 — Bush_Common 잎(glTF MASK 0.2 · 양면). 부모(foliage.material)에 알베도 · 알파 컷오프(glTF MASK 0.2)만 바꾸고 양면으로 그린다. -->
<MaterialDef formatVersion="0" name="foliage_leaves_twistedtree" _base="engine/materials/foliage.material" alphaMode="Mask" cullMode="None" twoSidedLighting="true">
	<_properties>
		<item name="_alphaCutoff" defaultValue="0.2" />
		<item name="_albedoMap" assetPath="common/textures/quaternius/nature/leaves_twistedtree_c.dds" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_VERTEX_DEFORM</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
