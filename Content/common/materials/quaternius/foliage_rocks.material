<?xml version="1.0" encoding="utf-8"?>
<!-- Quaternius Stylized Nature 의 식생(FoliageComponent) 구간 머티리얼 — Rock_Medium(glTF OPAQUE · 양면). 부모(foliage.material)에 알베도만 바꾸고 양면으로 그린다. -->
<MaterialDesc formatVersion="0" name="foliage_rocks" parent="engine/materials/foliage.material">
	<_properties>
		<item name="_albedoMap" assetPath="common/textures/quaternius/nature/rocks_diffuse.dds" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_VERTEX_DEFORM</item>
			<item>MATERIAL_TWO_SIDED</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDesc>
