<Prefab formatVersion="0" _base="common/prefabs/gimmicks/adventure/lockeddoor.prefab.xml" name="KeycardDoor">
	<PrefabOverrides>
		<Override key="InteractableComponent#0">
			<InteractableComponent _interactionID="SwipeKeycard" />
		</Override>
		<Override key="GimmickCircuitComponent#0">
			<GimmickCircuitComponent>
				<_listNode>
					<GimmickNodeDesc _id="swipe" _kind="Interaction" _params="" />
					<GimmickNodeDesc _id="hold" _kind="Pulse" _params="seconds=4" />
					<GimmickNodeDesc _id="door" _kind="Door" _params="openTime=0.4; closeTime=0.8; openOffset=0 3 0" />
				</_listNode>
				<_listWire>
					<GimmickWireDesc _from="swipe.OnUsed" _to="hold.In" _bInvert="false" />
					<GimmickWireDesc _from="hold.Out" _to="door.Open" _bInvert="false" />
				</_listWire>
			</GimmickCircuitComponent>
		</Override>
	</PrefabOverrides>
</Prefab>
