<!-- 농부(Quaternius 기본 캐릭터 · UAL 클립) — 마을 사람과 같은 이동 섞기(Speed)에 농사 동작 셋을 더한다. 디렉터가 도구 사용을 끝내면 농부 몸(FarmerComponent)이
     트리거(Sow · Water · Harvest)를 걸고, 동작이 끝나면 이동으로 돌아간다. 클립 이름은 애니메이터의 셋(ubc_farmer.animset.xml — UAL1 위에 UAL2 농사 클립)에서 찾는다. 괭이질 클립이 없어 괭이는 씨앗 심기(Sow)를 쓴다. -->
<AnimationGraphAsset>
	<nodes>
		<node id="1" name="Locomotion" x="40.0" y="40.0" loop="true">
			<blend_space x="Speed" min_x="0" max_x="2.1">
				<samples>
					<sample clip="idle_loop" x="0" />
					<sample clip="walk_loop" x="0.84" />
					<sample clip="jog_fwd_loop" x="2.1" />
				</samples>
			</blend_space>
		</node>
		<node id="2" name="FarmPlantSeed" x="260.0" y="40.0" loop="false">
			<blend_space x="Speed" min_x="0" max_x="1">
				<samples>
					<sample clip="farm_plantseed" x="0" />
				</samples>
			</blend_space>
		</node>
		<node id="3" name="FarmWatering" x="260.0" y="200.0" loop="false">
			<blend_space x="Speed" min_x="0" max_x="1">
				<samples>
					<sample clip="farm_watering" x="0" />
				</samples>
			</blend_space>
		</node>
		<node id="4" name="FarmHarvest" x="260.0" y="360.0" loop="false">
			<blend_space x="Speed" min_x="0" max_x="1">
				<samples>
					<sample clip="farm_harvest" x="0" />
				</samples>
			</blend_space>
		</node>
	</nodes>
	<links>
		<link id="1" from="1" to="2" blend="0.15">
			<condition param="Sow" op="Trigger" value="1.0" />
		</link>
		<link id="2" from="1" to="3" blend="0.15">
			<condition param="Water" op="Trigger" value="1.0" />
		</link>
		<link id="3" from="1" to="4" blend="0.15">
			<condition param="Harvest" op="Trigger" value="1.0" />
		</link>
		<link id="4" from="2" to="1" blend="0.2" />
		<link id="5" from="3" to="1" blend="0.2" />
		<link id="6" from="4" to="1" blend="0.2" />
	</links>
</AnimationGraphAsset>
