<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 외형 프리셋(CharacterAppearance). parent 위에 다른 값만 적는다 — 값은 매개변수별, 칸은 칸별, 소켓은 이름별로 아래가 덮고 세트는 쌓인다.
     쉼표 목록(items · options) · 범위(min/max) · 색 목록(colors, ; 로 나눔)은 씨앗으로 뽑는다(무작위 NPC).
     Equip 는 set 하나 또는 slot 하나 — item="" 은 칸을 비우고, visible 은 보이는 외형만 바꾼다(형상 변경), 안의 Value 는 그 아이템 인스턴스의 꾸미기 값이다.
     플레이어는 ShooterPlayer(Quaternius 기본 캐릭터 UBC · 레인저 옷 — 프리팹이 UAL1 클립 · ubc_shooter 그래프 · UBC 리그를 든다)다. 손에 든 무기는 여기에 적지 않는다 — 무기 표(weapons.xml)의 item 이 정본이라 ShooterPlayerComponent 가 MainHand 칸을 채운다.
     적은 생물(QuadShell · Trilobite)과 해골 미니언(SkeletonMinion — 절단이 붙은 사람형)이다(arena.scene.xml 의 ShooterGameMode 가 _listEnemyKind · _eliteEnemyKind 에 프리팹과 함께 이름을 든다 — 없는 이름이면 디렉터가 시작할 때 오류로 멈춘다). -->
<CharacterAppearanceCatalog>
  <CharacterAppearance id="Adventurer" schema="Adventurer" bodyType="Male" bodyShape="Average" body="body_knight" tags="Race.Human"/>

  <CharacterAppearance id="ShooterPlayer" parent="TownsfolkMale" tags="Faction.Player">
    <Value name="Hair" option="Buzzed"/>
    <Value name="Outfit" option="Ranger"/>
    <Equip slot="Back" item="cape_heraldic"/>
  </CharacterAppearance>

  <!-- 병합 부품 쇼케이스 — 투구 · 방패 · 검이 몸 메시에 합쳐진다(prefabs/kaykit/knight_merged.prefab.xml 이 Merge Parts 를 켠다). 어떤 컴포넌트도 가리키지 않는 외형 전용이다. -->
  <CharacterAppearance id="ShooterKnightMerged" parent="Adventurer" tags="Faction.Player">
    <Equip slot="Head" item="helmet_knight_merged"/>
    <Equip slot="OffHand" item="shield_round_merged"/>
    <Equip slot="MainHand" item="sword_knight_merged"/>
  </CharacterAppearance>

  <CharacterAppearance id="ShooterArcher" parent="Adventurer" tags="Faction.Player">
    <Equip slot="MainHand" item="bow_long"/>
  </CharacterAppearance>

  <!-- 외형 쇼케이스 — 어떤 컴포넌트도 가리키지 않아 무기 표와 이어지지 않는다(플레이어 무기가 아니라 이 외형이 든 장비다). -->
  <CharacterAppearance id="ShooterRogue" parent="Adventurer" body="body_rogue" tags="Faction.Player">
    <Value name="OutfitDye" colors="1 1 1 1; 1 0.85 0.7 1"/>
    <Equip slot="Back" item="cape_rogue"/>
    <Equip slot="MainHand" item="scifi_pistol"/>
  </CharacterAppearance>

  <!-- 아이템 변형 쇼케이스(시나리오 showcase/itemvariant) — 같은 투구 메시를 그대로, 머티리얼만 다른 항목으로, 꾸미기의 머티리얼 변형으로 입는다. -->
  <CharacterAppearance id="VariantShowcasePlain" parent="Adventurer">
    <Equip slot="Head" item="helmet_knight"/>
  </CharacterAppearance>
  <CharacterAppearance id="VariantShowcaseGilded" parent="Adventurer">
    <Equip slot="Head" item="helmet_knight_gilded"/>
  </CharacterAppearance>
  <CharacterAppearance id="VariantShowcaseDyed" parent="Adventurer">
    <Equip slot="Head" item="helmet_knight_dyeable">
      <Value name="Finish" option="Gilded"/>
    </Equip>
  </CharacterAppearance>

  <!-- Shooter3D 적 생물 — 몸 하나뿐이고 장비 칸이 없다(arena.scene.xml 의 ShooterGameMode 가 프리팹과 함께 고른다). -->
  <CharacterAppearance id="QuadShell" body="body_quadshell" tags="Race.Machine"/>
  <CharacterAppearance id="Trilobite" body="body_trilobite" tags="Race.Machine"/>

  <CharacterAppearance id="SkeletonBase" schema="Skeleton" bodyType="Male" bodyShape="Average" body="body_skeleton_minion" tags="Race.Undead">
    <Value name="BoneTint" colors="1 1 1 1; 0.86 0.95 0.82 1; 1 0.86 0.8 1; 0.85 0.85 1 1"/>
  </CharacterAppearance>

  <CharacterAppearance id="SkeletonMinion" parent="SkeletonBase">
    <Equip slot="MainHand" item="blade_skeleton"/>
  </CharacterAppearance>

  <!-- 전사는 두건을 쓰고 투구를 덮어쓴다 — 규칙(HelmetHidesHood)이 두건을 감춘다. -->
  <CharacterAppearance id="SkeletonWarrior" parent="SkeletonBase" body="body_skeleton_warrior">
    <Value name="Hood" option="Hooded"/>
    <Equip slot="Head" item="helmet_skeleton"/>
    <Equip slot="MainHand" item="axe_skeleton"/>
    <Equip slot="OffHand" item="shield_skeleton"/>
  </CharacterAppearance>

  <!-- 몸 동작 무대(maps/bodycustomization · 시나리오 bodydynamics) — 몸 프로필이 굽 높이 · 지글 · 동공 · 눈물을 건다. -->
  <CharacterAppearance id="BodyDemoWarrior" parent="SkeletonWarrior" body="body_skeleton_bodydemo" bodyProfile="BodyDemoWarrior">
    <SkinLayer layer="mascara" color="0.05 0.04 0.04 1" opacity="0.9"/>
    <SkinLayer layer="tattoo_rose" color="0.1 0.2 0.6 1" offset="0.75 0.25" scale="0.15 0.15" rotation="20" mirror="true"/>
  </CharacterAppearance>

  <CharacterAppearance id="SkeletonRogue" parent="SkeletonBase" body="body_skeleton_rogue">
    <Value name="Hood" option="Hooded"/>
    <Equip slot="Back" item="cape_skeleton"/>
    <Equip slot="MainHand" item="blade_skeleton"/>
  </CharacterAppearance>

  <!-- 씨앗마다 다른 해골 — 몸 · 두건 · 무기를 뽑는다. -->
  <CharacterAppearance id="SkeletonRaider" parent="SkeletonBase" body="body_skeleton_minion,body_skeleton_rogue,body_skeleton_warrior">
    <Value name="Hood" options="Bare,Hooded"/>
    <Equip slot="Back" item="cape_skeleton"/>
    <Equip slot="MainHand" items="blade_skeleton,axe_skeleton"/>
  </CharacterAppearance>

  <!-- 마을 사람 — 씨앗마다 머리 모양 · 옷을 뽑는다(HarvestValley 의 villager 프리팹이 NPC 번호를 씨앗으로 준다). 농부는 고정된 차림이다. -->
  <CharacterAppearance id="TownsfolkMale" schema="TownsfolkMale" bodyType="Male" bodyShape="Average" body="body_ubc_male" tags="Race.Human">
    <Value name="Hair" options="SimpleParted,Buzzed,Bearded"/>
    <Value name="Outfit" options="Peasant,Ranger"/>
  </CharacterAppearance>
  <CharacterAppearance id="TownsfolkFemale" schema="TownsfolkFemale" bodyType="Female" bodyShape="Average" body="body_ubc_female" tags="Race.Human">
    <Value name="Hair" options="Long,Buns,Buzzed"/>
    <Value name="Outfit" options="Peasant,Ranger"/>
  </CharacterAppearance>
  <CharacterAppearance id="Farmer" parent="TownsfolkMale" tags="Faction.Player">
    <Value name="Hair" option="Bearded"/>
    <Value name="Outfit" option="Peasant"/>
  </CharacterAppearance>
  <!-- 구간 머티리얼 쇼케이스(시나리오 game/empty/automation/sectionmaterial) — 같은 레인저 옷이다. Gilded 의 태그가 규칙 SectionShowcaseGilded 를 켜 팔의 옷 구간만 바꾼다. -->
  <CharacterAppearance id="SectionShowcase" parent="TownsfolkMale">
    <Value name="Hair" option="Buzzed"/>
    <Value name="Outfit" option="Ranger"/>
  </CharacterAppearance>
  <CharacterAppearance id="SectionShowcaseGilded" parent="SectionShowcase" tags="Showcase.SectionGilded"/></CharacterAppearanceCatalog>
