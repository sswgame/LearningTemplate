<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 규칙. 조건(When — 칸의 보이는 외형 태그 · 아무 외형의 태그 · 캐릭터 태그 · 칸 점유 · 체형 · 몸 종류, not="true" 로 뒤집음)이 모두 맞으면 동작
     (Hide · Variant · SwapMesh · SwapMaterial · Morph · OverrideSocket · MaterialValue)을 건다. Hide 에 part 를 주면 그 주인의 그 부품만 감춘다. SwapMaterial · MaterialValue 에
     section 을 주면 그 메시 구간 하나만 바꾼다(넓은 교체 위에 좁은 교체가 덮는다). 조건은 점유 · 세트 뒤의 요청된 목록만 본다 — 규칙끼리 사슬을 만들지 않는다.
     같은 대상을 다르게 바꾸는 두 규칙은 priority 가 높은 쪽이 이기고, 같으면 로드 오류다. -->
<AppearanceRuleTable>
  <!-- 투구는 두건을 감춘다(꾸미기 고르기 "Hood" 의 외형은 매개변수 이름이 주인이다). 스켈레톤 전사 · 무작위 해골이 둘을 함께 뽑으면 투구만 보인다. -->
  <Rule id="HelmetHidesHood" priority="10">
    <When target="Head" tag="Helmet.Full"/>
    <Hide target="Hood"/>
  </Rule>
  <!-- 레인저 두건은 머리카락 부품만 감춘다(꾸미기 "Hair" 의 "Hair" 부품) — 눈썹 · 수염은 두건 밖이라 남긴다(<Hide part>). -->
  <Rule id="RangerHoodHidesHair" priority="10">
    <When target="Hood" tag="Hood.Ranger"/>
    <Hide target="Hair" part="Hair"/>
  </Rule>
</AppearanceRuleTable>
