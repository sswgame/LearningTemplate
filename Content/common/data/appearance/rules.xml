<?xml version="1.0" encoding="utf-8"?>
<?asset guid="69f9964aee62683459568a8fa8f24153"?>
<!-- 외형 규칙. 조건(When — 칸의 보이는 외형 태그 · 아무 외형의 태그 · 캐릭터 태그 · 칸 점유 · 체형 · 몸 종류, not="true" 로 뒤집음)이 모두 맞으면 동작
     (Hide · Variant · SwapMesh · SwapMaterial · Morph · OverrideSocket · MaterialValue)을 건다. Hide 에 part 를 주면 그 주인의 그 부품만 감춘다. SwapMaterial · MaterialValue 에
     section 을 주면 그 메시 구간 하나만 바꾼다(넓은 교체 위에 좁은 교체가 덮는다). 조건은 점유 · 세트 뒤의 요청된 목록만 본다 — 규칙끼리 사슬을 만들지 않는다.
     같은 대상을 다르게 바꾸는 두 규칙은 priority 가 높은 쪽이 이기고, 같으면 로드 오류다. -->
<AppearanceRuleCatalog>
  <!-- 투구는 두건을 감춘다(꾸미기 고르기 "Hood" 의 외형은 매개변수 이름이 주인이다). 스켈레톤 전사 · 무작위 해골이 둘을 함께 뽑으면 투구만 보인다. -->
  <Rule id="HelmetHidesHood" priority="10">
    <When target="Head" tag="Helmet.Full"/>
    <Hide target="Hood"/>
  </Rule>
  <!-- 투구는 머리카락 부품을 감춘다(눈썹 · 수염은 투구 밖이라 남긴다) — 사람 몸(UBC)에 투구를 씌우면 머리카락이 투구를 뚫고 나왔다(시나리오 showcase/customizeoutfit).
       두건 규칙과 같은 대상을 같게 감춘다 — 우선순위만 다르게 둔다. -->
  <Rule id="HelmetHidesHair" priority="5">
    <When target="Head" tag="Helmet.Full"/>
    <Hide target="Hair" part="Hair"/>
  </Rule>
  <!-- 레인저 두건은 머리카락 부품만 감춘다(꾸미기 "Hair" 의 "Hair" 부품) — 눈썹 · 수염은 두건 밖이라 남긴다(<Hide part>). -->
  <Rule id="RangerHoodHidesHair" priority="10">
    <When target="Hood" tag="Hood.Ranger"/>
    <Hide target="Hair" part="Hair"/>
  </Rule>
  <!-- 장비 조합 · 캐릭터 조건 부품 숨김(시나리오 showcase/customizevisibility) — 셋 모두 레인저 옷의 어깨받이(꾸미기 "Outfit" 의 "Pauldron" 부품)를 감춘다.
       망토는 어깨를 덮고, 방패는 어깨받이와 겹치고, 마른 체형(캐릭터 태그 Build.Slim)은 어깨받이 없는 차림이다. 겹치면 우선순위가 높은 규칙이 숨긴 이유가 된다(망토 > 체형 > 방패). -->
  <Rule id="CapeHidesPauldron" priority="5">
    <When target="Back" tag="Cape"/>
    <Hide target="Outfit" part="Pauldron"/>
  </Rule>
  <Rule id="SlimHidesPauldron" priority="3">
    <When characterTag="Build.Slim"/>
    <Hide target="Outfit" part="Pauldron"/>
  </Rule>
  <Rule id="ShieldHidesPauldron" priority="1">
    <When target="OffHand" tag="Shield"/>
    <Hide target="Outfit" part="Pauldron"/>
  </Rule>
  <!-- 구간 머티리얼 쇼케이스 — 태그를 단 캐릭터만 레인저 팔(꾸미기 "Outfit" 의 "Arms" 부품)의 옷 구간 mi_ranger 를 금빛으로 바꾼다. 피부 구간 mi_regular_male 은 그대로다
       (시나리오 game/playground/automation/sectionmaterial). -->
  <Rule id="SectionShowcaseGilded" priority="0">
    <When characterTag="Showcase.SectionGilded"/>
    <SwapMaterial target="Outfit" part="Arms" section="mi_ranger" material="guid:a9050f74edcf521276954af2d494db12"/>
  </Rule>
</AppearanceRuleCatalog>
