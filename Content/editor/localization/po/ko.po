msgctxt "EditorSequencer.LoadTip"
msgid "Reload the focused .seq file from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 포커스된 .seq 파일을 디스크에서 다시 읽습니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.MoveTrackDown"
