#: Source/Editor/Panels/Inspector/InspectorPropertyManager.cpp
msgctxt "EditorInspector.ShowInContentBrowser"
msgid "Show in the Content Browser"
msgstr "콘텐츠 브라우저에서 보여 줍니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.TransientProperty"
msgid "Transient property: not saved to disk"
msgstr "Transient 프로퍼티: 디스크에 저장하지 않습니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.UnlinkPrefab"
msgid "Break the link to the prefab and turn this into a standalone object"
msgstr "프리팹과의 연결을 끊고 독립된 일반 오브젝트로 변환합니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.Unparent"
msgid "Detach from the parent object and move to the scene root"
msgstr "부모 오브젝트와의 연결을 해제하고 씬 루트로 이동합니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.ViewOptions"
msgid "View options: show only modified properties, expand or collapse all sections"
msgstr "보기 옵션: 바뀐 프로퍼티만 보기, 모든 영역 펼치기 또는 접기"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.CheckMap"
msgid "Validate every object of the active scene again"
msgstr "활성 씬의 모든 오브젝트를 다시 검증합니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.NoIssues"
msgid "No validation issues. Check Map validates every object of the active scene."
msgstr "검증 문제가 없습니다. Check Map 은 활성 씬의 모든 오브젝트를 검증합니다."

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.NotInActiveScene"
msgid "This object is not in the active scene"
msgstr "이 오브젝트는 활성 씬에 없습니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.SceneIssuesToast"
msgid "{errorCount} error(s), {warningCount} warning(s). Open Map Check from the status bar."
msgstr "오류 {errorCount}개, 경고 {warningCount}개가 있습니다. 상태줄에서 Map Check 를 여세요."

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.SearchHint"
msgid "Search"
msgstr "검색"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.ShowErrors"
msgid "Show error rows"
msgstr "오류 줄을 보입니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.ShowWarnings"
msgid "Show warning rows"
msgstr "경고 줄을 보입니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.StatusTooltip"
msgid "Map Check: {errorCount} error(s), {warningCount} warning(s)"
msgstr "Map Check: 오류 {errorCount}개, 경고 {warningCount}개"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ApplyToSelectionTip"
msgid "Show the edited material on the selected object in the viewport without saving, to judge it with the real shader and lighting."
msgstr "저장하지 않고 편집한 머티리얼을 뷰포트의 선택한 오브젝트에 입혀, 실제 셰이더와 라이팅으로 판단할 수 있게 합니다."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.LoadFailedStatus"
msgid "Load failed - saving is disabled so the file is not overwritten"
msgstr "읽기 실패 - 파일을 덮어쓰지 않도록 저장을 막았습니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.LoadedStatus"
msgid "Loaded"
msgstr "읽음"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.NameTip"
msgid "Display name stored in the material file."
msgstr "머티리얼 파일에 저장되는 표시 이름입니다."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.OpenMaterialHint"
msgid "Open a material (Open..., Quick Open or a Content Browser double-click) to edit."
msgstr "편집할 머티리얼을 엽니다(Open..., Quick Open 또는 콘텐츠 브라우저에서 더블클릭)."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.PreviewTip"
msgid "Preview computed from the material values (base color, roughness, metallic, emissive). It does not run the shader code - use Apply to Selection to check it in the scene."
msgstr "머티리얼 값(기본색 · 거칠기 · 금속성 · 방출)으로 셈한 미리보기입니다. 셰이더 코드는 반영하지 않습니다 — Apply to Selection 으로 씬에서 확인합니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ReloadTip"
msgid "Read the material from disk again, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 머티리얼을 다시 읽습니다."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.SaveFailedStatus"
msgid "Save failed"
msgstr "저장하지 못했습니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.SaveTip"
msgid "Write the material file and reload it in the running scene."
msgstr "머티리얼 파일을 쓰고 실행 중인 씬에서 다시 읽습니다."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.SavedStatus"
msgid "Saved"
msgstr "저장했습니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ShaderTip"
msgid "HLSL shader this material renders with. Drop a .hlsl file here or pick one from the Content Browser."
msgstr "이 머티리얼이 렌더링에 쓰는 HLSL 셰이더입니다. .hlsl 파일을 여기에 놓거나 콘텐츠 브라우저에서 고릅니다."

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ArrangeWindows"
msgid "Place the client windows side by side (window size and position per App process) instead of letting them overlap"
msgstr "클라이언트 창을 겹치지 않게 나란히 놓습니다(App 프로세스마다 창 크기와 위치를 줍니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ClientArgumentsHint"
msgid "client arguments (e.g. -vk)"
msgstr "클라이언트 인자 (예: -vk)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsApplyToAll"
msgid "Send each change to every process of the session instead of the selected one"
msgstr "고른 프로세스 대신 세션의 모든 프로세스에 보냅니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsBandwidth"
msgid "Line speed in KB/s (0 = unlimited)"
msgstr "회선 속도(KB/s, 0 = 제한 없음)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsDisconnect"
msgid "Drop every connection of the selected process (a client stays disconnected until Reconnect)"
msgstr "고른 프로세스의 연결을 모두 끊습니다(클라이언트는 Reconnect 까지 끊긴 채로 남습니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsDown"
msgid "Packets this process receives"
msgstr "이 프로세스가 받는 패킷입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsNoSession"
msgid "Start a multiplayer session (Session tab) to change its line conditions."
msgstr "회선 조건을 바꾸려면 멀티플레이 세션을 시작하세요(Session 탭)."

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsNoStats"
msgid "No stats yet - press Refresh stats"
msgstr "아직 수치가 없습니다 - Refresh stats 를 누르세요"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsPreset"
msgid "Set both directions of the selected process to a line preset"
msgstr "고른 프로세스의 두 방향을 회선 프리셋으로 둡니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsReconnect"
msgid "Connect a disconnected client to the server again"
msgstr "끊긴 클라이언트를 서버에 다시 붙입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsRefreshStats"
msgid "Ask the selected process for its line and connection numbers"
msgstr "고른 프로세스에 회선 · 연결 수치를 묻습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsSpike"
msgid "Drop everything the selected process sends and receives for this many seconds"
msgstr "고른 프로세스가 보내고 받는 것을 이 시간(초) 동안 모두 버립니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsUp"
msgid "Packets this process sends (client to server for a client)"
msgstr "이 프로세스가 보내는 패킷입니다(클라이언트면 클라이언트 → 서버)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.DeletePreset"
msgid "Delete the selected preset from your preset file"
msgstr "고른 프리셋을 프리셋 파일에서 지웁니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.FollowLog"
msgid "Keep scrolling to the newest log line"
msgstr "가장 최근 로그 줄을 따라 스크롤합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorAttach"
msgid "Attach to a server that is already running: its debug channel address (127.0.0.1:port) and token, as given with -gv_debugChannelPort and -gv_debugChannelToken"
msgstr "이미 돌고 있는 서버에 붙습니다. -gv_debugChannelPort · -gv_debugChannelToken 으로 준 디버그 채널 주소(127.0.0.1:포트)와 토큰을 넣습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorConsoleHint"
msgid "Dev command for the server (help lists them, Tab completes the name)"
msgstr "서버에 보낼 개발 명령(help 가 목록을 보이고, Tab 이 이름을 채웁니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorNoChannel"
msgid "The Inspector reads a dedicated server through its debug channel. Start a Dedicated Server session, or attach by address"
msgstr "인스펙터는 전용 서버를 디버그 채널로 읽습니다. 전용 서버 세션을 시작하거나 주소로 붙으세요"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorRefresh"
msgid "Read the server's hierarchy again (scene.tree). Click a name to read its component values (object.dump) - this works while the server is paused"
msgstr "서버의 계층을 다시 읽습니다(scene.tree). 이름을 누르면 그 컴포넌트 값을 읽습니다(object.dump) - 서버가 일시 정지 중이어도 됩니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.LogSource"
msgid "Show the log of one process or of every process"
msgstr "한 프로세스 또는 모든 프로세스의 로그를 보입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.NoProcesses"
msgid "No processes - pick a Net Mode and press Play (toolbar or here)."
msgstr "프로세스가 없습니다 - Net Mode 를 고르고 Play 를 누르세요(툴바 또는 여기)."

#: Source/Editor/Panels/Multiplayer/MultiplayerPanel.cpp
msgctxt "EditorMultiplayer.NoTarget"
msgid "No multiplayer session is running. Start one in the Session tab."
msgstr "실행 중인 멀티플레이 세션이 없습니다. Session 탭에서 시작하세요."

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.PauseServer"
msgid "Pause the dedicated server's game tick"
msgstr "전용 서버의 게임 틱을 멈춥니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Play"
msgid "Start the server and clients for the selected Net Mode"
msgstr "고른 Net Mode 로 서버와 클라이언트를 시작합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Preset"
msgid "Saved multiplayer setups (Saved/Editor/NetPlayPresets.json, not committed). Picking one replaces the setup below and is restored when the editor starts"
msgstr "저장한 멀티플레이 구성입니다(Saved/Editor/NetPlayPresets.json, 커밋하지 않음). 고르면 아래 구성을 바꾸고, 에디터를 다시 띄우면 돌아옵니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.PresetNameHint"
msgid "preset name"
msgstr "프리셋 이름"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerClear"
msgid "Forget the collected history"
msgstr "모은 기록을 지웁니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKinds"
msgid "Received messages by kind"
msgstr "받은 메시지 종류별 비중"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKindsAllProcesses"
msgid "Add up the message kinds every process received instead of only the selected one"
msgstr "고른 프로세스 대신 모든 프로세스가 받은 메시지 종류를 합쳐 봅니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKindsSent"
msgid "Show the message kinds the process queued to send instead of the ones it received (one process shows both directions)"
msgstr "받은 메시지 종류 대신 프로세스가 보내려고 쌓은 종류를 보입니다(한 프로세스가 두 방향을 모두 보입니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerLoss"
msgid "Packet loss (highest connection, %)"
msgstr "패킷 손실 (가장 큰 연결, %)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoKinds"
msgid "No messages received yet"
msgstr "아직 받은 메시지가 없습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoReplicas"
msgid "The process reports no replication counters (a replication kit raises them with GameNetSession::setReplicaStats)"
msgstr "프로세스가 복제 셈을 보고하지 않습니다(복제 키트가 GameNetSession::setReplicaStats 로 올립니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoSession"
msgid "Start a multiplayer session (Net Mode on the toolbar) to see its traffic"
msgstr "멀티플레이 세션을 시작하면(툴바의 Net Mode) 트래픽이 보입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReceivedBytes"
msgid "Received bytes per second (last second, all connections)"
msgstr "받은 바이트 / 초 (최근 1 초, 모든 연결)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReceivedPackets"
msgid "Received packets per second"
msgstr "받은 패킷 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReplicas"
msgid "Replication by name (per second)"
msgstr "이름별 복제 (초당)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReplicasHelp"
msgid "Updates and bytes a replication kit counted per second, from the difference of the last two net.stats reports; the share is of the listed bytes"
msgstr "복제 키트가 센 갱신 수와 바이트를 마지막 두 net.stats 보고의 차로 초당 값으로 보입니다. 비율은 표에 나온 바이트에 대한 몫입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerResent"
msgid "Reliable messages resent per second"
msgstr "다시 보낸 신뢰 메시지 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerRtt"
msgid "Round-trip time (highest connection, ms)"
msgstr "RTT (가장 큰 연결, ms)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSentBytes"
msgid "Sent bytes per second (last second, all connections)"
msgstr "보낸 바이트 / 초 (최근 1 초, 모든 연결)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSentPackets"
msgid "Sent packets per second"
msgstr "보낸 패킷 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSource"
msgid "Numbers the process already counts (connection stats, message kinds), asked with net.stats every 0.5 s while this tab is shown"
msgstr "프로세스가 이미 세는 값(연결 통계, 메시지 종류)을 이 탭이 보이는 동안 0.5 초마다 net.stats 로 묻습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerWaiting"
msgid "Waiting for the first net.stats report from this process"
msgstr "이 프로세스의 첫 net.stats 보고를 기다리는 중입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.RecordTraces"
msgid "Record a timeline per process and merge them into one file (merged.trace.json) on Stop - open it with Load Trace in the Profiler window or with Perfetto"
msgstr "프로세스마다 타임라인을 기록해 Stop 때 한 파일(merged.trace.json)로 합칩니다 — Profiler 창 Load Trace · Perfetto 로 엽니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ResumeServer"
msgid "Resume the paused server's game tick"
msgstr "멈춘 서버의 게임 틱을 다시 돌립니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.SavePreset"
msgid "Save the setup below under the typed name (empty: overwrite the selected preset)"
msgstr "아래 구성을 적은 이름으로 저장합니다(비우면 고른 프리셋을 덮습니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.StepServer"
msgid "Run the server game tick as many times as the field on the left says, then pause again (dedicated server Dev command step N)"
msgstr "서버 게임 틱을 왼쪽 칸의 수만큼 돌리고 다시 멈춥니다 (전용 서버 Dev 명령 step N)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.StepTickCount"
msgid "Number of server ticks that Step runs (1 or more)"
msgstr "Step 이 돌릴 서버 틱 수입니다(1 이상)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Stop"
msgid "Stop every process and merge the recorded traces"
msgstr "모든 프로세스를 멈추고 기록한 트레이스를 합칩니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncClient"
msgid "Read this client's state hash history (the latest ticks it recorded under the server tick numbers)"
msgstr "이 클라이언트의 상태 해시 기록을 읽습니다(서버 틱 번호로 기록한 최근 틱)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncCompare"
msgid "Find the earliest tick both histories hold with different state hashes (scene transforms: name, active, world position)"
msgstr "두 기록이 모두 가진 틱 가운데 상태 해시가 다른 가장 이른 틱을 찾습니다(씬 트랜스폼: 이름, 활성, 월드 위치)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncFile"
msgid "Load a saved history, or save this one in the same format (<tick> <hex hash> per line)"
msgstr "저장한 기록을 불러오거나, 이 기록을 같은 형식(줄마다 <틱> <16진 해시>)으로 저장합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncObjects"
msgid "Ask both slots (a server read over a debug channel, or a session client) for their current per-object hashes and list the objects that differ (pause the server near the divergent tick first; the two answers must carry the same tick)"
msgstr "두 칸(디버그 채널로 읽은 서버, 또는 세션 클라이언트)에 지금의 오브젝트별 해시를 물어 다른 오브젝트를 나열합니다(어긋난 틱 가까이에서 서버를 먼저 멈춥니다. 두 답은 같은 틱이어야 합니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncReadServer"
msgid "Read the history of another server through its debug channel (it must run with -gv_stateHashHistory)"
msgstr "다른 서버의 기록을 디버그 채널로 읽습니다(그 서버는 -gv_stateHashHistory 로 돌아야 합니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncSessionServer"
msgid "Read the per-tick state hash history of the dedicated server this session started"
msgstr "이 세션이 시작한 전용 서버의 틱별 상태 해시 기록을 읽습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerPanel.cpp
msgctxt "EditorMultiplayer.Target"
msgid "Process the tabs act on: the server or one client"
msgstr "탭이 다루는 프로세스입니다(서버 또는 클라이언트 하나)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.WindowColumns"
msgid "Windows per row before the next row starts"
msgstr "다음 줄로 넘어가기 전에 한 줄에 놓는 창 수"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.WindowSize"
msgid "Client area size of each App window (pixels)"
msgstr "App 창마다의 클라이언트 영역 크기(픽셀)"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Game"
msgid "Game to package"
msgstr "패키징할 게임입니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.OpenFolder"
msgid "Open the output folder of the last successful package in the file explorer"
msgstr "마지막으로 성공한 패키지의 출력 폴더를 파일 탐색기에서 엽니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.OutputFolder"
msgid "Folder the packaged build is staged into"
msgstr "패키지 빌드를 스테이징할 폴더입니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Package"
msgid "Configure, build, cook and stage the selected game into the output folder"
msgstr "고른 게임을 구성 · 빌드 · 쿠킹해 출력 폴더에 스테이징합니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.RHIBackend"
msgid "Backend that Shipping links statically (client only). The server does not render"
msgstr "Shipping 이 정적으로 링크할 백엔드입니다(클라이언트만). 서버는 그리지 않는다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.SkipBuild"
msgid "Skip configure and build, and stage this editor's Bin"
msgstr "구성 · 빌드를 건너뛰고 이 에디터의 Bin 을 스테이징합니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.SkipCook"
msgid "Skip cooking the resource packs (a build cooks them itself)"
msgstr "리소스 팩 쿠킹을 건너뜁니다(빌드를 하면 빌드가 쿠킹한다)"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Target"
msgid "Package the client (game) or the dedicated server"
msgstr "클라이언트(게임) 또는 전용 서버를 패키징합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.CallTreeRecord"
msgid "The call tree folds the timeline recording (same recording as the Timeline tab)"
msgstr "호출 트리는 타임라인 녹화를 접어 보여 줍니다(Timeline 탭과 같은 녹화)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.FilterScopesHint"
msgid "Filter scopes..."
msgstr "스코프 필터..."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.FindScopeHint"
msgid "Find scope..."
msgstr "스코프 찾기..."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.Fit"
msgid "Reset the zoom so the recorded frames fit the view"
msgstr "확대를 되돌려 기록한 프레임을 화면에 맞춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.Freeze"
msgid "Keep recording but stop updating the view"
msgstr "기록은 계속하고 화면 갱신만 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.LoadCapture"
msgid "Open Saved/Profiler/ProfilerCapture.txt (pauses live capture)"
msgstr "Saved/Profiler/ProfilerCapture.txt 를 엽니다(실시간 캡처를 멈춥니다)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.LoadTrace"
msgid "Load the newest Saved/Traces/*.trace.json under the live threads (first times aligned) - a failing run next to a healthy one"
msgstr "가장 최근 Saved/Traces/*.trace.json 을 실시간 스레드 아래에 불러옵니다(첫 시각 정렬) - 실패한 실행을 정상 실행 옆에 놓고 봅니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.MemoryProfilerInactive"
msgid "MemoryProfiler is not active."
msgstr "MemoryProfiler 가 동작하지 않습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoActiveScene"
msgid "No active scene loaded."
msgstr "불러온 활성 씬이 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoComponents"
msgid "No components in the active scene."
msgstr "활성 씬에 컴포넌트가 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoRHIDevice"
msgid "No RHI device."
msgstr "RHI 디바이스가 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.PauseOnSpike"
msgid "Pause capturing automatically on a frame slower than the threshold on the right"
msgstr "오른쪽 임계값보다 느린 프레임에서 캡처를 자동으로 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocCapture"
msgid "Capture the next frame with RenderDoc"
msgstr "다음 프레임을 RenderDoc 으로 캡처합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocNotAttached"
msgid "RenderDoc is not attached to this process - start with -renderdoc or launch from RenderDoc"
msgstr "RenderDoc 이 이 프로세스에 붙어 있지 않습니다. -renderdoc 으로 시작하거나 RenderDoc 에서 실행하십시오."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocOpenUI"
msgid "Open the RenderDoc replay UI to inspect captures"
msgstr "캡처를 살펴볼 RenderDoc 재생 UI 를 엽니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.ResumeCapture"
msgid "Capturing is paused (a spike or an opened capture) - resume live capture"
msgstr "캡처가 멈춰 있습니다(스파이크 또는 연 캡처) - 실시간 캡처를 다시 시작합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SaveCapture"
msgid "Save the captured window to Saved/Profiler/ProfilerCapture.txt (long captures: Tracy)"
msgstr "캡처한 구간을 Saved/Profiler/ProfilerCapture.txt 로 저장합니다(긴 캡처는 Tracy)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SaveTrace"
msgid "Save the frames shown as Saved/Traces/trace_<time>.trace.json (Chrome Trace Event - open in Perfetto UI or chrome://tracing)"
msgstr "보이는 프레임을 Saved/Traces/trace_<시각>.trace.json 으로 저장합니다(Chrome Trace Event - Perfetto UI 나 chrome://tracing 에서 엽니다)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SpikeThreshold"
msgid "GT.Frame above this pauses capturing (and a running play session) on that frame"
msgstr "GT.Frame 이 이 값을 넘으면 그 프레임에서 캡처(와 실행 중인 플레이 세션)를 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.TaskManagerInactive"
msgid "TaskManager is not active."
msgstr "TaskManager 가 동작하지 않습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.TimelineRecord"
msgid "Record profile scopes per thread into a ring (8192 events per thread) - only while recording"
msgstr "스레드마다 프로파일 스코프를 링 버퍼(스레드당 이벤트 8192 개)에 기록합니다 - 녹화 중에만"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.UnloadTrace"
msgid "Remove the loaded trace from the timeline"
msgstr "불러온 트레이스를 타임라인에서 뺍니다"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.AutoRangeTip"
msgid "Stretch the depth values present in the image to the full black-to-white range."
msgstr "이미지에 있는 깊이 값을 검정에서 흰색까지 전체 범위로 늘립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.AutoRefreshTip"
msgid "Refresh the snapshot every 30 editor frames. Costs a GPU wait each time."
msgstr "에디터 30프레임마다 스냅샷을 새로 읽습니다. 읽을 때마다 GPU 를 기다립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ChannelTip"
msgid "Show all channels, or one channel as grayscale. RGBA shows the live GPU texture; a single channel uses the CPU snapshot."
msgstr "모든 채널을 보거나 한 채널을 회색조로 봅니다. RGBA 는 실시간 GPU 텍스처를, 한 채널은 CPU 스냅샷을 씁니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.DepthLabel"
msgid "depth"
msgstr "깊이"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.FormatNotReadable"
msgid "This format cannot be read back."
msgstr "이 포맷은 다시 읽어 올 수 없습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.LinearLabel"
msgid "linear"
msgstr "선형"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.LinearizeTip"
msgid "Convert stored depth back to view distance using Near/Far. Perspective depth crowds near 1, so the raw image looks almost white."
msgstr "Near/Far 로 저장된 깊이를 뷰 거리로 되돌립니다. 원근 깊이는 1 근처에 몰려 있어 그대로 보면 거의 흰색입니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NearFarTip"
msgid "Near and far clip planes of the camera that rendered the depth, in world units. Match them to that camera for correct distances."
msgstr "깊이를 렌더링한 카메라의 근평면과 원평면(월드 단위)입니다. 정확한 거리를 보려면 그 카메라에 맞춥니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NoFilterMatch"
msgid "No target matches the filter."
msgstr "필터에 맞는 타깃이 없습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NoTargets"
msgid "Renderer has not published any targets yet."
msgstr "렌더러가 아직 타깃을 공개하지 않았습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.PickTargetHint"
msgid "Pick a render target on the left."
msgstr "왼쪽에서 렌더 타깃을 고릅니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ReadingTarget"
msgid "Reading the target..."
msgstr "타깃을 읽는 중..."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.RefreshTip"
msgid "Read the selected target back to the CPU again. Channel views, depth views and pixel values use this snapshot; reading waits for the GPU."
msgstr "선택한 타깃을 CPU 로 다시 읽어 옵니다. 채널 보기, 깊이 보기, 픽셀 값은 이 스냅샷을 쓰며, 읽는 동안 GPU 를 기다립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.RegisterFailed"
msgid "Could not register this target as an ImGui texture."
msgstr "이 타깃을 ImGui 텍스처로 등록하지 못했습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.SearchHint"
msgid "Search render targets..."
msgstr "렌더 타깃 검색..."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ZoomTip"
msgid "Preview scale, 0 to 2. At 0 the image fits the panel; set 1 to inspect pixels at native resolution."
msgstr "미리보기 배율(0~2)입니다. 0이면 패널에 맞추고, 원본 해상도로 픽셀을 보려면 1로 둡니다."

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.BoneMarkersTip"
msgid "Draw the bones written by the selected node in the viewport"
msgstr "고른 노드가 쓰는 본을 뷰포트에 표시합니다"

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.RigNotReady"
msgid "The rig is not bound yet (check the rig asset and skeleton)"
msgstr "리그가 아직 바인딩되지 않았습니다(리그 에셋과 스켈레톤을 확인하세요)"

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.SelectRig"
msgid "Select an object with a Pose Modifier component"
msgstr "Pose Modifier 컴포넌트가 있는 오브젝트를 고르세요"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.ApplyAllOverrides"
msgid "Write every override of this instance back to the prefab template"
msgstr "이 인스턴스의 모든 오버라이드를 프리팹 템플릿에 반영합니다"

#: Source/Editor/Panels/Scene/HistoryPanel.cpp
msgctxt "EditorScene.CommandStackUnavailable"
msgid "CommandStack service is not available."
msgstr "CommandStack 서비스를 쓸 수 없습니다."

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.CreateGameObject"
msgid "Create a new GameObject at the root of the current scene"
msgstr "현재 씬의 루트에 새 게임오브젝트를 생성합니다"

#: Source/Editor/Panels/Scene/SceneViewPanel.cpp
msgctxt "EditorScene.DebugDrawCategories"
msgid "Turn DebugDrawQueue categories on or off"
msgstr "DebugDrawQueue 카테고리를 켜고 끕니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.EditNestedPrefab"
msgid "Open this nested prefab in isolation mode"
msgstr "이 중첩 프리팹을 격리 모드로 엽니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.ExitIsolation"
msgid "Leave isolation mode without saving the prefab"
msgstr "프리팹을 저장하지 않고 격리 모드를 나갑니다"

#: Source/Editor/Panels/Scene/GameViewPanel.cpp
msgctxt "EditorScene.GameViewAspect"
msgid "Game view aspect ratio - Free (whole panel) or 16:9 (letterboxed on the spare side)"
msgstr "게임 뷰 화면 비율 — 자유(패널 전체) · 16:9(남는 쪽은 레터박스)"

#: Source/Editor/Panels/Scene/GameViewPanel.cpp
msgctxt "EditorScene.GameViewScreenshot"
msgid "Save the game view image to Saved/Screenshots/<time>.png (F9 - the focused view)"
msgstr "게임 뷰 그림을 Saved/Screenshots/<시각>.png 로 저장합니다 (F9 — 포커스가 있는 뷰)"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.HiddenInEditor"
msgid "Hidden in the editor - click to show"
msgstr "에디터에서 숨겨져 있습니다 - 클릭하면 보입니다"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.HierarchyNoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.HierarchySearch"
msgid "Search by object name, or filter by component type (t:Mesh) or tag (tag:Player)"
msgstr "오브젝트 이름 검색, 컴포넌트 타입(t:Mesh), 태그(tag:Player) 필터를 지원합니다"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.HierarchySearchHint"
msgid "Search (t:Mesh, tag:Player)..."
msgstr "검색 (t:Mesh, tag:Player)..."

#: Source/Editor/Panels/Scene/HistoryPanel.cpp
msgctxt "EditorScene.HistoryClear"
msgid "Clear the whole undo history. This cannot be undone"
msgstr "실행 취소 기록을 모두 지웁니다. 되돌릴 수 없습니다"

#: Source/Editor/Panels/Scene/HistoryPanel.cpp
msgctxt "EditorScene.HistoryRedo"
msgid "Redo the edit that was undone. Ctrl+Y"
msgstr "되돌린 편집을 다시 실행합니다. Ctrl+Y"

#: Source/Editor/Panels/Scene/HistoryPanel.cpp
msgctxt "EditorScene.HistoryUndo"
msgid "Undo the last edit. Ctrl+Z"
msgstr "마지막 편집을 되돌립니다. Ctrl+Z"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.LockedInViewport"
msgid "Locked - the viewport does not pick it; click to unlock"
msgstr "잠겨 있습니다 - 뷰포트에서 고를 수 없습니다. 클릭하면 잠금을 풉니다"

#: Source/Editor/Panels/Scene/GameViewPanel.cpp
msgctxt "EditorScene.MaximizeOnPlay"
msgid "Maximize On Play - keep only the game view while playing and restore the layout on Stop"
msgstr "Maximize On Play - 플레이하는 동안 게임 뷰만 남기고, Stop 하면 배치를 되돌립니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.OpenPrefabIsolation"
msgid "Edit the selected prefab on its own in isolation mode"
msgstr "고른 프리팹을 격리 모드에서 따로 편집합니다"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.PickableInViewport"
msgid "Pickable in the viewport - click to lock"
msgstr "뷰포트에서 고를 수 있습니다 - 클릭하면 잠급니다"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.PlayModeRunning"
msgid "Play mode is running (scene edits are restricted)"
msgstr "플레이 모드 실행 중 (씬 편집 제한)"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.RefreshOverrides"
msgid "Scan the instance for overrides again"
msgstr "인스턴스의 오버라이드를 다시 검사합니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.RevertAllOverrides"
msgid "Discard every override of this instance and match the prefab template"
msgstr "이 인스턴스의 모든 오버라이드를 버리고 프리팹 템플릿과 맞춥니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.RevertOverride"
msgid "Revert this property to the prefab value"
msgstr "이 프로퍼티를 프리팹 값으로 되돌립니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.SavePrefabExitIsolation"
msgid "Save the prefab and leave isolation mode"
msgstr "프리팹을 저장하고 격리 모드를 나갑니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.SceneEditsLocked"
msgid "Scene edits locked until Stop."
msgstr "Stop 할 때까지 씬 편집이 잠깁니다."

#: Source/Editor/Panels/Scene/SceneViewPanel.cpp
msgctxt "EditorScene.SceneViewScreenshot"
msgid "Save the scene view image (editor camera) to Saved/Screenshots/<time>.png - the grid and gizmos are ImGui overlays and are not included"
msgstr "씬 뷰 그림(에디터 카메라)을 Saved/Screenshots/<시각>.png 로 저장합니다 — 격자 · 기즈모는 ImGui 오버레이라 들지 않습니다"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.ShowModifiedOnly"
msgid "Show only the properties that differ from the prefab"
msgstr "프리팹과 다른 프로퍼티만 보입니다"

#: Source/Editor/Panels/Scene/HierarchyPanel.cpp
msgctxt "EditorScene.VisibleInEditor"
msgid "Visible in the editor - click to hide (not saved)"
msgstr "에디터에서 보입니다 - 클릭하면 숨깁니다(저장하지 않습니다)"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.AddKeyTip"
msgid "Key the target's current values on every channel at this frame."
msgstr "대상의 지금 값을 이 프레임의 키로 모든 채널에 찍습니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.AddPropertyTrackTip"
msgid "Add a track that keys one numeric property of a component on the selected object."
msgstr "고른 오브젝트 컴포넌트의 숫자 프로퍼티 하나를 키로 모는 트랙을 더합니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.AddRigSlotTrackTip"
msgid "Add a track that keys a rig slot weight (PoseModifierComponent)"
msgstr "리그 슬롯 가중치(PoseModifierComponent)에 키를 찍는 트랙을 추가합니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.AddTransformTrackTip"
msgid "Add a track that keys the selected object's position, rotation and scale."
msgstr "고른 오브젝트의 이동 · 회전 · 크기를 키로 모는 트랙을 더합니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.CinematicNoteTip"
msgid "Free-form notes saved with the sequence. It does not affect playback."
msgstr "시퀀스와 함께 저장되는 자유 메모입니다. 재생에는 영향을 주지 않습니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.DeleteKeyTip"
msgid "Remove this track's keys at the current frame on every channel."
msgstr "현재 프레임에 있는 이 트랙의 키를 모든 채널에서 지웁니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.DeleteTrackTip"
msgid "Remove the selected key track and all of its keys."
msgstr "선택한 키 트랙과 그 키를 모두 지웁니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.ItemTargetTip"
msgid "Name of the scene object this clip, event or camera cut acts on."
msgstr "이 클립 · 이벤트 · 카메라 컷이 작용하는 씬 오브젝트의 이름입니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.LoadTip"
msgid "Reload the focused .seq file from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 포커스된 .seq 파일을 디스크에서 다시 읽습니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.NextKeyTip"
msgid "Go to the next key"
msgstr "다음 키로"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.NoKeyTracksHint"
msgid "No key tracks. Select an object and add a transform or property track."
msgstr "키 트랙이 없습니다. 오브젝트를 선택하고 트랜스폼 트랙이나 프로퍼티 트랙을 추가합니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.OpenCurveTip"
msgid "Open this channel in the curve editor to shape the interpolation between keys."
msgstr "이 채널을 커브 편집기에서 열어 키 사이의 보간을 다듬습니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.PauseTip"
msgid "Pause playback at the current frame."
msgstr "현재 프레임에서 재생을 일시정지합니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.PlayTip"
msgid "Play the sequence in the viewport from the current frame, looping at the end."
msgstr "현재 프레임부터 뷰포트에서 시퀀스를 재생하고, 끝에 닿으면 처음부터 반복합니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.PreviousKeyTip"
msgid "Go to the previous key"
msgstr "앞 키로"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.PropertyPathTip"
msgid "<ComponentType>.<Property> - a float32 or int32 property (for example CameraComponent._fov)"
msgstr "<컴포넌트 타입>.<프로퍼티> — float32 · int32 프로퍼티(예: CameraComponent._fov)"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.PropertyTargetNotFound"
msgid "Target or numeric property not found"
msgstr "대상이나 숫자 프로퍼티를 찾을 수 없습니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.RigSlotTargetNotFound"
msgid "Target has no Pose Modifier"
msgstr "대상에 Pose Modifier 가 없습니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.RigSlotTip"
msgid "Rig slot name (weight_slot in the rig asset); value is clamped to 0..1"
msgstr "리그 슬롯 이름(리그 에셋의 weight_slot), 값은 0..1 로 자릅니다"

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.SaveTip"
msgid "Write the sequence to the focused .seq file."
msgstr "시퀀스를 포커스된 .seq 파일에 씁니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.ScrubTip"
msgid "Drag to move the current frame; the viewport follows so you can check any moment of the sequence."
msgstr "끌어서 현재 프레임을 옮깁니다. 뷰포트가 따라오므로 시퀀스의 어느 순간이든 확인할 수 있습니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.SelectItemHint"
msgid "Select a clip, event or camera cut on the timeline to edit it."
msgstr "편집하려면 타임라인에서 클립, 이벤트, 카메라 컷 중 하나를 선택합니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.StopTip"
msgid "Stop playback, return to the first frame and give the camera back from any camera cut."
msgstr "재생을 멈추고 첫 프레임으로 돌아가며, 카메라 컷이 가져간 카메라를 돌려줍니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.TargetNotFound"
msgid "Target object not found"
msgstr "대상 오브젝트를 찾을 수 없습니다"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.BuildModules"
msgid "Compile every module with the changed module set"
msgstr "바뀐 모듈 구성으로 모든 모듈을 컴파일합니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.FilterVariablesHint"
msgid "Filter variables..."
msgstr "변수 필터..."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.GroupByModule"
msgid "Group the variables by the module that defines them"
msgstr "변수를 정의한 모듈별로 묶습니다"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleChangeNoCascade"
msgid "No other modules change."
msgstr "다른 모듈은 바뀌지 않습니다."

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleChangeTarget"
msgid "Module"
msgstr "모듈"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleChangeTurnsOff"
msgid "Also turns off"
msgstr "함께 꺼짐"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleChangeTurnsOn"
msgid "Also turns on"
msgstr "함께 켜짐"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleDefaultState"
msgid "Default"
msgstr "기본값"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleDependencies"
msgid "Depends on"
msgstr "의존 모듈"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleDependents"
msgid "Required by"
msgstr "이 모듈에 의존하는 모듈"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleKindAll"
msgid "All categories"
msgstr "모든 종류"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleKindFilter"
msgid "Show only one module category"
msgstr "한 종류의 모듈만 보입니다"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleLocked"
msgid "Editor and game modules cannot be turned off here"
msgstr "에디터 · 게임 모듈은 여기서 끌 수 없습니다"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleOverride"
msgid "Project override"
msgstr "프로젝트 오버라이드"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleOverrideNone"
msgid "None (uses default)"
msgstr "없음(기본값 사용)"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleResetOverride"
msgid "Reset to default"
msgstr "기본값으로 되돌리기"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleResetOverrideTip"
msgid "Remove this module's line from the project manifest (previews the change first)"
msgstr "프로젝트 매니페스트에서 이 모듈 줄을 지웁니다(먼저 변경을 미리 보여 줍니다)"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleSetChanged"
msgid "Module set changed - build to apply, then restart the editor."
msgstr "모듈 구성이 바뀌었습니다 - 빌드해 적용한 뒤 에디터를 다시 시작하세요."

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleStateAll"
msgid "On and off"
msgstr "켜짐과 꺼짐"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleStateFilter"
msgid "Filter modules by whether they are on"
msgstr "켜짐 여부로 모듈을 거릅니다"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleStateOff"
msgid "Off only"
msgstr "꺼진 것만"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleStateOn"
msgid "On only"
msgstr "켜진 것만"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleToggle"
msgid "Turn this module on or off (the affected modules are shown before it applies)"
msgstr "이 모듈을 켜거나 끕니다(적용하기 전에 영향받는 모듈을 보여 줍니다)"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.ModuleVersion"
msgid "Version"
msgstr "버전"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.NoDescription"
msgid "(no description)"
msgstr "(설명 없음)"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.NoGlobalVariables"
msgid "No global variables registered."
msgstr "등록된 전역 변수가 없습니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.NoPresets"
msgid "No presets found."
msgstr "프리셋이 없습니다."

#: Source/Editor/Panels/Settings/PreferencesPanel.cpp
msgctxt "EditorSettings.NoSectionMatches"
msgid "No section matches the search."
msgstr "검색어에 맞는 섹션이 없습니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.PinVariable"
msgid "Pin to favorites"
msgstr "즐겨찾기에 고정"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.PresetNameHint"
msgid "Preset Name..."
msgstr "프리셋 이름..."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.Presets"
msgid "Save or load named sets of global variable values"
msgstr "이름 붙인 전역 변수 값 묶음을 저장하거나 불러옵니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.PressKeyCombo"
msgid "Press a key combo (Esc cancels, Backspace clears)"
msgstr "키 조합을 누르세요 (Esc 취소, Backspace 지우기)"

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.RefreshModules"
msgid "Read the module catalog from the module folder again"
msgstr "모듈 폴더에서 모듈 카탈로그를 다시 읽습니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.ReplaceShortcut"
msgid "Give this combo to the selected command and remove it from the other command"
msgstr "이 조합을 고른 명령에 주고 다른 명령에서는 지웁니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.ResetAllShortcuts"
msgid "Restore every shortcut to its default binding"
msgstr "모든 단축키를 기본 바인딩으로 되돌립니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.ResetAllVariables"
msgid "Reset every global variable to its default value"
msgstr "모든 전역 변수를 기본값으로 되돌립니다"

#: Source/Editor/Panels/Settings/PreferencesPanel.cpp
msgctxt "EditorSettings.ResetSection"
msgid "Reset every value in this section to its default"
msgstr "이 섹션의 값을 모두 기본값으로 되돌립니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.ResetShortcut"
msgid "Restore this command's default shortcut"
msgstr "이 명령의 기본 단축키로 되돌립니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.ResetVariable"
msgid "Reset this variable to its default value"
msgstr "이 변수를 기본값으로 되돌립니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.SaveSession"
msgid "Save the current values to the session file"
msgstr "지금 값을 세션 파일에 저장합니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.ScanningPresets"
msgid "Scanning presets..."
msgstr "프리셋을 찾는 중..."

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.SearchModulesHint"
msgid "Search modules..."
msgstr "모듈 검색..."

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.SearchShortcutsHint"
msgid "Search commands or keys (Ctrl+S)..."
msgstr "명령 또는 키 검색 (Ctrl+S)..."

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.SetShortcut"
msgid "Record a new shortcut for this command"
msgstr "이 명령의 새 단축키를 입력받습니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.ShortcutInUse"
msgid "This combo is already used. Replace clears it from the other command."
msgstr "이미 쓰이는 조합입니다. Replace 를 누르면 다른 명령에서 지웁니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.UnpinVariable"
msgid "Unpin from favorites"
msgstr "즐겨찾기 고정 해제"

#: Source/Editor/Panels/Settings/UserSettingsPanel.cpp
msgctxt "EditorSettings.UserSettingsNotLoaded"
msgid "User settings are not loaded."
msgstr "사용자 설정을 불러오지 않았습니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.VariableDescription"
msgid "Description: {description}"
msgstr "설명: {description}"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.VariableModule"
msgid "Module: {module}"
msgstr "모듈: {module}"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationFirstFrameTip"
msgid "Index of the frame this animation starts on, counting from 0."
msgstr "이 애니메이션이 시작하는 프레임의 인덱스로, 0부터 셉니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationFrameCountTip"
msgid "How many consecutive frames, from the first frame, this animation plays."
msgstr "첫 프레임부터 이어서 재생할 프레임 수입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationLoopTip"
msgid "Repeat from the first frame after the last one; off stops on the last frame."
msgstr "마지막 프레임 다음에 첫 프레임부터 반복합니다. 끄면 마지막 프레임에서 멈춥니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationNameTip"
msgid "Name game code uses to play this animation."
msgstr "게임 코드가 이 애니메이션을 재생할 때 쓰는 이름입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasCellTip"
msgid "Click a cell to set the selected frame's rectangle to it. Shift+click adds a new frame."
msgstr "칸을 클릭하면 선택한 프레임의 사각형이 그 칸이 됩니다. Shift+클릭하면 새 프레임을 추가합니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasTip"
msgid "Path of the texture the frames are cut from. The UV rectangles below are fractions of this image."
msgstr "프레임을 잘라 낼 텍스처의 경로입니다. 아래 UV 사각형은 이 이미지에 대한 비율입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameDurationTip"
msgid "How long this frame stays on screen, in milliseconds."
msgstr "이 프레임이 화면에 머무는 시간(밀리초)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameHTip"
msgid "Frame height as a fraction of the atlas height (0-1)."
msgstr "아틀라스 높이에 대한 프레임 높이의 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameUTip"
msgid "Left edge of the frame in the atlas, as a fraction of its width (0-1)."
msgstr "아틀라스에서 프레임의 왼쪽 끝 위치로, 너비에 대한 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameVTip"
msgid "Top edge of the frame in the atlas, as a fraction of its height (0-1)."
msgstr "아틀라스에서 프레임의 위쪽 끝 위치로, 높이에 대한 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameWTip"
msgid "Frame width as a fraction of the atlas width (0-1)."
msgstr "아틀라스 너비에 대한 프레임 너비의 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.KeyAngleTip"
msgid "Rotation of the sprite at this key, in degrees."
msgstr "이 키에서 스프라이트의 회전(도)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.KeyTimeTip"
msgid "When this key applies, in seconds from the start of the clip."
msgstr "이 키가 적용되는 시각으로, 클립 시작부터의 초입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.LoadTip"
msgid "Reload the clip from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 클립을 다시 읽습니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.LoadingAtlas"
msgid "Loading atlas..."
msgstr "아틀라스를 읽는 중..."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.NoAtlas"
msgid "No atlas"
msgstr "아틀라스 없음"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SaveTip"
msgid "Write the frames, animations and keys to the clip file."
msgstr "프레임, 애니메이션, 키를 클립 파일에 씁니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SavedStatus"
msgid "Saved {path}"
msgstr "{path} 저장됨"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SliceColumnsTip"
msgid "Number of grid columns the atlas is cut into, 1 to 64."
msgstr "아틀라스를 나눌 격자의 열 수(1~64)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SliceRowsTip"
msgid "Number of grid rows the atlas is cut into, 1 to 64."
msgstr "아틀라스를 나눌 격자의 행 수(1~64)입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.AddDataLayerTip"
msgid "Add a named integer data layer (terrain cost, footstep sound) to this map. The name must be new."
msgstr "이 맵에 이름 붙은 정수 데이터 레이어(지형 비용, 발소리)를 더합니다. 이름은 겹치면 안 됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ApplyEdgeTip"
msgid "Turn every cell on this edge into a walkable warp to the target map."
msgstr "이 가장자리의 모든 칸을 대상 맵으로 가는, 걸을 수 있는 워프로 바꿉니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ApplySizeTip"
msgid "Resize the map to the width and height above. This clears every layer."
msgstr "맵을 위의 너비와 높이로 바꿉니다. 모든 레이어가 지워집니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.AtlasIDTip"
msgid "Atlas cell index to paint, 0 to 255."
msgstr "칠할 아틀라스 칸 인덱스(0~255)입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.BrushTip"
msgid "Paint every cell you press and drag over (B)"
msgstr "누르고 끄는 칸마다 칠합니다 (B)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataLayerDefaultTip"
msgid "Value of every cell of the new layer, and the value Erase paints."
msgstr "새 레이어의 모든 칸 값이자 지우기가 칠하는 값입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataLayerNameTip"
msgid "Name of the new data layer. The game reads the layer by this name."
msgstr "새 데이터 레이어의 이름입니다. 게임은 이 이름으로 레이어를 읽습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataLayerRejectedStatus"
msgid "Data layer not added: the name is empty or already used"
msgstr "데이터 레이어를 더하지 못했습니다: 이름이 비었거나 이미 있습니다"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataValueTip"
msgid "Integer to paint on the selected data layer."
msgstr "고른 데이터 레이어에 칠할 정수입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetTip"
msgid "Map that walking off this edge (north, east, south or west) leads to."
msgstr "이 가장자리(북, 동, 남, 서)를 벗어나면 이어지는 맵입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetXTip"
msgid "Cell column the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 열입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetYTip"
msgid "Cell row the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 행입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EraseTip"
msgid "Make the paint tools clear cells instead of painting them."
msgstr "칠하기 도구가 칸을 칠하는 대신 지우게 합니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.FillTip"
msgid "Paint every connected cell that has the same value as the pressed cell (G)"
msgstr "누른 칸과 같은 값으로 이어진 칸을 모두 칠합니다 (G)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.HeightTip"
msgid "Map height in cells. Takes effect when you press Apply Size."
msgstr "맵 높이(칸)입니다. Apply Size 를 눌러야 적용됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.LayerTip"
msgid "Layer the canvas shows and the tools paint: Visual (height and tint), Warp (exits to other maps), Tile (tile set brushes) or one of the gameplay flag layers."
msgstr "캔버스가 보여 주고 도구가 칠할 레이어입니다. Visual(높이와 틴트), Warp(다른 맵으로 가는 출구), Tile(타일셋 브러시), 또는 게임플레이 플래그 레이어 중 하나입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.LoadTip"
msgid "Read the map at Path, discarding unsaved edits. Nothing changes if no file is there."
msgstr "저장하지 않은 편집을 버리고 Path 의 맵을 읽습니다. 그 자리에 파일이 없으면 아무것도 바뀌지 않습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.NameTip"
msgid "Display name stored in the map file."
msgstr "맵 파일에 저장되는 표시 이름입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.NoTileSet"
msgid "No tile set loaded"
msgstr "읽어 들인 타일셋 없음"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PaintHeightTip"
msgid "Height level to paint, 0 to 255."
msgstr "칠할 높이 단계(0~255)입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PathTip"
msgid "Resource path of the tile map file that Load and Save use."
msgstr "Load 와 Save 가 쓰는 타일맵 파일의 리소스 경로입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PickerTip"
msgid "Take the pressed cell's value as the value to paint (I)"
msgstr "누른 칸의 값을 칠할 값으로 가져옵니다 (I)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.RectTip"
msgid "Paint the rectangle you drag out when you release the mouse (U)"
msgstr "눌러 끈 사각형을 놓을 때 칠합니다 (U)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ResetViewTip"
msgid "Reset zoom and pan to the start (wheel: zoom, middle or right drag: pan)"
msgstr "확대와 이동을 처음으로 되돌립니다 (휠: 확대, 가운데 · 오른쪽 끌기: 이동)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SaveFailedStatus"
msgid "Save failed"
msgstr "저장하지 못했습니다"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SaveTip"
msgid "Write the map to Path."
msgstr "맵을 Path 에 씁니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SavedStatus"
msgid "Saved {path}"
msgstr "{path} 저장됨"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SizeOutOfRange"
msgid "Size is out of range."
msgstr "크기가 범위를 벗어났습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.TileSetReadFailed"
msgid "Tile set could not be read: {path}"
msgstr "타일셋을 읽지 못했습니다: {path}"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.TileSetTip"
msgid "Resource path of the tile set whose brushes this map paints with. Press Use to apply it."
msgstr "이 맵이 칠할 브러시를 담은 타일셋의 리소스 경로입니다. 적용하려면 Use 를 누릅니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.TintTip"
msgid "Color to paint into the cells' tint."
msgstr "칸의 틴트로 칠할 색입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.UseTileSetTip"
msgid "Make this map use the tile set on the left and load its brushes."
msgstr "이 맵이 왼쪽의 타일셋을 쓰게 하고 그 브러시를 읽습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetTip"
msgid "Map a painted warp cell sends the player to. Painted warp cells also become walkable."
msgstr "칠한 워프 칸이 플레이어를 보낼 맵입니다. 칠한 워프 칸은 걸을 수 있는 칸도 됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetXTip"
msgid "Cell column the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 열입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetYTip"
msgid "Cell row the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 행입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WidthTip"
msgid "Map width in cells. Takes effect when you press Apply Size."
msgstr "맵 너비(칸)입니다. Apply Size 를 눌러야 적용됩니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraFar"
msgid "Farthest distance the camera draws. Geometry beyond this is clipped."
msgstr "카메라가 그리는 가장 먼 거리입니다. 이보다 먼 지오메트리는 잘려 나갑니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraFOV"
msgid "Vertical field of view in degrees. Larger values show more of the scene and stretch the edges."
msgstr "세로 시야각(도)입니다. 값이 클수록 장면이 넓게 보이고 가장자리가 늘어나 보입니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraNear"
msgid "Closest distance the camera draws. Geometry nearer than this is clipped; keep it as large as the scene allows to avoid depth fighting."
msgstr "카메라가 그리는 가장 가까운 거리입니다. 이보다 가까운 지오메트리는 잘려 나갑니다. 깊이 충돌(z-fighting)을 피하려면 장면이 허용하는 만큼 크게 두세요."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraOrthoHeight"
msgid "World-space height of the visible area; the width follows the aspect ratio."
msgstr "보이는 영역의 월드 높이입니다. 너비는 화면 비율을 따라갑니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraOrthographic"
msgid "Use a parallel (non-perspective) projection, as for 2D or isometric views. FOV is ignored while on."
msgstr "원근 없는 평행 투영을 씁니다(2D · 아이소메트릭 시점). 켜져 있는 동안 FOV 는 무시됩니다."

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EditorTip.CurveKeyInterpolation"
msgid "How the curve moves from this key to the next: Constant holds the value, Linear is a straight line, Cubic is a smooth spline."
msgstr "이 키에서 다음 키까지 곡선이 움직이는 방식입니다. Constant 는 값을 유지하고, Linear 는 직선, Cubic 은 부드러운 스플라인입니다."

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EditorTip.CurveKeyTime"
msgid "When the key sits on the curve's time axis. It stays between its neighbouring keys."
msgstr "이 키가 곡선의 시간 축에서 놓인 위치입니다. 이웃한 키 사이에만 둘 수 있습니다."

#: Source/Editor/Common/Widgets/EditorCurveEditor.cpp
msgctxt "EditorTip.CurveKeyValue"
msgid "The curve's value at this key."
msgstr "이 키에서 곡선이 가지는 값입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDCorner"
msgid "Which screen corner the Debug HUD is anchored to."
msgstr "디버그 HUD 를 붙여 둘 화면 모서리입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDOpacity"
msgid "Background opacity of the Debug HUD panels."
msgstr "디버그 HUD 패널의 배경 불투명도입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDOpenWindow"
msgid "The same checklist as a runtime UI window (shows in the game view while playing)"
msgstr "같은 체크리스트를 런타임 UI 창으로 엽니다(플레이 중 게임 뷰에 보입니다)."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDSection"
msgid "Show or hide this section of the in-game Debug HUD. The grey text is the section's registration name."
msgstr "게임 안 디버그 HUD 의 이 구역을 보이거나 숨깁니다. 회색 글자는 구역의 등록 이름입니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorBottomCenter"
msgid "Bottom Center"
msgstr "아래 가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorBottomLeft"
msgid "Bottom Left"
msgstr "왼쪽 아래"

