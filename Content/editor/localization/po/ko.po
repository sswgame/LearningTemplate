msgstr "이 명령의 기본 단축키로 되돌립니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.ResetVariable"
msgid "Reset this variable to its default value"
msgstr "이 변수를 기본값으로 되돌립니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.SaveSession"
msgid "Save the current values to the session file"
msgstr "지금 값을 세션 파일에 저장합니다"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.ScanningPresets"
msgid "Scanning presets..."
msgstr "프리셋을 찾는 중..."

#: Source/Editor/Panels/Settings/ModulesPanel.cpp
msgctxt "EditorSettings.SearchModulesHint"
msgid "Search modules..."
msgstr "모듈 검색..."

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.SearchShortcutsHint"
msgid "Search commands or keys (Ctrl+S)..."
msgstr "명령 또는 키 검색 (Ctrl+S)..."

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.SetShortcut"
msgid "Record a new shortcut for this command"
msgstr "이 명령의 새 단축키를 입력받습니다"

#: Source/Editor/Panels/Settings/ShortcutsPanel.cpp
msgctxt "EditorSettings.ShortcutInUse"
msgid "This combo is already used. Replace clears it from the other command."
msgstr "이미 쓰이는 조합입니다. Replace 를 누르면 다른 명령에서 지웁니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.UnpinVariable"
msgid "Unpin from favorites"
msgstr "즐겨찾기 고정 해제"

#: Source/Editor/Panels/Settings/UserSettingsPanel.cpp
msgctxt "EditorSettings.UserSettingsNotLoaded"
msgid "User settings are not loaded."
msgstr "사용자 설정을 불러오지 않았습니다."

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.VariableDescription"
msgid "Description: {description}"
msgstr "설명: {description}"

#: Source/Editor/Panels/Settings/GlobalVariablesPanel.cpp
msgctxt "EditorSettings.VariableModule"
msgid "Module: {module}"
msgstr "모듈: {module}"

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.CannotRevertTooltip"
msgid "Untracked files and conflicts are not reverted here - reverting would delete the file or hide the conflict"
msgstr "추적하지 않는 파일과 충돌은 여기서 되돌리지 않습니다 — 되돌리면 파일이 지워지거나 충돌이 가려집니다"

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.Listing"
msgid "Listing changed files..."
msgstr "바뀐 파일을 나열하는 중..."

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.NoChanges"
msgid "No changed files. Edits you save appear here."
msgstr "바뀐 파일이 없습니다. 저장한 편집이 여기에 나타납니다."

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.NoDetail"
msgid "No diff yet. Press Diff or History."
msgstr "아직 차이가 없습니다. 차이나 기록을 누르세요."

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.NoGit"
msgid "git was not found on PATH, so changes cannot be listed. Install git and restart the editor."
msgstr "PATH 에서 git 을 찾지 못해 변경을 나열할 수 없습니다. git 을 설치하고 에디터를 다시 시작하세요."

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.PickAFile"
msgid "Pick a file to see its diff or history."
msgstr "차이나 기록을 볼 파일을 고르세요."

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.RevertTooltip"
msgid "Put this file back to HEAD (staged and unsaved edits are lost)"
msgstr "이 파일을 HEAD 로 되돌립니다(스테이징한 편집과 저장하지 않은 편집을 잃습니다)"

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.ScopeTooltip"
msgid "Lists changed files, shows a file's diff against HEAD and its last 20 commits, and reverts tracked files. Commit, push and branches stay in your git tool"
msgstr "바뀐 파일을 나열하고, 파일의 HEAD 대비 차이와 최근 커밋 20개를 보이며, 추적하는 파일을 되돌립니다. 커밋 · 푸시 · 브랜치는 git 도구에서 합니다"

#: Source/Editor/Panels/SourceControl/SourceControlChangesPanel.cpp
msgctxt "EditorSourceControl.UntrackedNoDiff"
msgid "This file is not tracked yet, so there is nothing to compare with."
msgstr "이 파일은 아직 추적하지 않아 비교할 것이 없습니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AddAllCells"
msgid "Add All Cells"
msgstr "모든 칸 추가"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AddAllCellsTip"
msgid "Add one frame for every grid cell, from the top left."
msgstr "왼쪽 위부터 격자의 칸마다 프레임을 하나씩 더합니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationFirstFrameTip"
msgid "Index of the frame this animation starts on, counting from 0."
msgstr "이 애니메이션이 시작하는 프레임의 인덱스로, 0부터 셉니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationFrameCountTip"
msgid "How many consecutive frames, from the first frame, this animation plays."
msgstr "첫 프레임부터 이어서 재생할 프레임 수입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationLoopTip"
msgid "Repeat from the first frame after the last one; off stops on the last frame."
msgstr "마지막 프레임 다음에 첫 프레임부터 반복합니다. 끄면 마지막 프레임에서 멈춥니다."

#: Source/Editor/Panels/Animation/Model/SpriteClipModel.cpp
msgctxt "EditorSpriteClip.AnimationNameRejectedStatus"
msgid "Animation name not changed: it is empty or already used"
msgstr "애니메이션 이름을 바꾸지 않았습니다: 비었거나 이미 쓰는 이름입니다"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AnimationNameTip"
msgid "Name game code uses to play this animation."
msgstr "게임 코드가 이 애니메이션을 재생할 때 쓰는 이름입니다."

#: Source/Editor/Panels/Animation/Model/SpriteClipModel.cpp
msgctxt "EditorSpriteClip.AnimationNeedsFrameStatus"
msgid "Animation not added: the clip has no frames"
msgstr "애니메이션을 더하지 않았습니다: 클립에 프레임이 없습니다"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasCellTip"
msgid "Click a cell to set the selected frame's rectangle to it. Shift+click adds a new frame."
msgstr "칸을 클릭하면 선택한 프레임의 사각형이 그 칸이 됩니다. Shift+클릭하면 새 프레임을 추가합니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasDragTip"
msgid "Drag on the sheet to cut a frame of any size, or drag an edge of the selected frame to adjust it. Edges snap to atlas pixels when the atlas size is set."
msgstr "시트 위를 끌면 크기와 상관없이 프레임을 자르고, 고른 프레임의 가장자리를 끌면 고칩니다. 아틀라스 크기를 적었으면 가장자리가 아틀라스 픽셀에 맞습니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasSize"
msgid "Atlas size"
msgstr "아틀라스 크기"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasSizeTip"
msgid "Atlas width and height in pixels. Pixel borders need it."
msgstr "아틀라스의 픽셀 너비와 높이입니다. 픽셀 테두리에 필요합니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.AtlasTip"
msgid "Path of the texture the frames are cut from. The UV rectangles below are fractions of this image."
msgstr "프레임을 잘라 낼 텍스처의 경로입니다. 아래 UV 사각형은 이 이미지에 대한 비율입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.Border"
msgid "Border"
msgstr "테두리"

#: Source/Editor/Panels/Animation/Model/SpriteClipModel.cpp
msgctxt "EditorSpriteClip.BorderNeedsAtlasSizeStatus"
msgid "A frame with a border needs the atlas size in pixels"
msgstr "테두리가 있는 프레임에는 아틀라스 픽셀 크기가 필요합니다"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.BorderTip"
msgid "Nine-slice border of this frame in atlas pixels: left, bottom, right, top."
msgstr "이 프레임의 9-슬라이스 테두리입니다(아틀라스 픽셀): 왼쪽, 아래, 오른쪽, 위."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.DuplicateFrame"
msgid "Duplicate"
msgstr "복제"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.DuplicateFrameTip"
msgid "Insert a copy of the selected frame right after it."
msgstr "고른 프레임의 사본을 바로 뒤에 넣습니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameDurationTip"
msgid "How long this frame stays on screen, in milliseconds."
msgstr "이 프레임이 화면에 머무는 시간(밀리초)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameHTip"
msgid "Frame height as a fraction of the atlas height (0-1)."
msgstr "아틀라스 높이에 대한 프레임 높이의 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameUTip"
msgid "Left edge of the frame in the atlas, as a fraction of its width (0-1)."
msgstr "아틀라스에서 프레임의 왼쪽 끝 위치로, 너비에 대한 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameVTip"
msgid "Top edge of the frame in the atlas, as a fraction of its height (0-1)."
msgstr "아틀라스에서 프레임의 위쪽 끝 위치로, 높이에 대한 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.FrameWTip"
msgid "Frame width as a fraction of the atlas width (0-1)."
msgstr "아틀라스 너비에 대한 프레임 너비의 비율(0~1)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.KeyAngleTip"
msgid "Rotation of the sprite at this key, in degrees."
msgstr "이 키에서 스프라이트의 회전(도)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.KeyTimeTip"
msgid "When this key applies, in seconds from the start of the clip."
msgstr "이 키가 적용되는 시각으로, 클립 시작부터의 초입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.LoadTip"
msgid "Reload the clip from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 클립을 다시 읽습니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.LoadingAtlas"
msgid "Loading atlas..."
msgstr "아틀라스를 읽는 중..."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.MoveFrameEarlier"
msgid "Earlier"
msgstr "앞으로"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.MoveFrameEarlierTip"
msgid "Move the selected frame one place earlier in the play order."
msgstr "고른 프레임을 재생 순서에서 한 칸 앞으로 옮깁니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.MoveFrameLater"
msgid "Later"
msgstr "뒤로"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.MoveFrameLaterTip"
msgid "Move the selected frame one place later in the play order."
msgstr "고른 프레임을 재생 순서에서 한 칸 뒤로 옮깁니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.NoAtlas"
msgid "No atlas"
msgstr "아틀라스 없음"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.PreviewEmpty"
msgid "Nothing to preview: pick an atlas and add a frame."
msgstr "미리 볼 것이 없습니다: 아틀라스를 고르고 프레임을 더하세요."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.PreviewTip"
msgid "Play the selected animation, or every frame when none is selected."
msgstr "고른 애니메이션을 재생합니다. 고른 것이 없으면 모든 프레임을 재생합니다."

#: Source/Editor/Panels/Animation/Model/SpriteClipModel.cpp
msgctxt "EditorSpriteClip.SaveFailedStatus"
msgid "Save failed"
msgstr "저장하지 못했습니다"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SaveTip"
msgid "Write the frames, animations and keys to the clip file."
msgstr "프레임, 애니메이션, 키를 클립 파일에 씁니다."

#: Source/Editor/Panels/Animation/Model/SpriteClipModel.cpp
msgctxt "EditorSpriteClip.SavedStatus"
msgid "Saved {path}"
msgstr "{path} 저장됨"

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SliceColumnsTip"
msgid "Number of grid columns the atlas is cut into, 1 to 64."
msgstr "아틀라스를 나눌 격자의 열 수(1~64)입니다."

#: Source/Editor/Panels/Animation/SpriteClipPanel.cpp
msgctxt "EditorSpriteClip.SliceRowsTip"
msgid "Number of grid rows the atlas is cut into, 1 to 64."
msgstr "아틀라스를 나눌 격자의 행 수(1~64)입니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.AlwaysLoadedTip"
msgid "Select the entities the cook keeps in the base list (always loaded, or without a position)."
msgstr "쿠킹이 기본 목록에 두는 엔티티(늘 올라 있거나 자리가 없는 것)를 고릅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.CookedScene"
msgid "This scene was built from a cooked file and is already split into cells. Open the scene file to preview the split."
msgstr "이 씬은 쿠킹본에서 지어져 이미 셀로 나뉘어 있습니다. 나눔을 미리 보려면 씬 파일을 엽니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoGameCamera"
msgid "No game camera - the load and unload column needs one."
msgstr "게임 카메라가 없습니다 - 올림 · 내림 열은 게임 카메라가 있어야 합니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoPreview"
msgid "Press Preview Split to split the scene into cells as the cook would."
msgstr "Preview Split 을 눌러 쿠킹처럼 씬을 셀로 나눠 봅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NotStreaming"
msgid "The active scene does not stream. Turn on streaming in its World Settings to split it into cells."
msgstr "활성 씬은 스트리밍하지 않습니다. 셀로 나누려면 월드 설정에서 스트리밍을 켭니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.PreviewTip"
msgid "Split the scene into cells exactly as the scene cook does, and list the cells or the references that would fail the cook. Same as 'world.cells'."
msgstr "씬 쿠킹과 똑같이 씬을 셀로 나눠 셀 목록이나 쿠킹을 실패시킬 참조를 보입니다. 'world.cells' 와 같습니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.SplitFailed"
msgid "The scene could not be split - see the log."
msgstr "씬을 나누지 못했습니다 - 로그를 봅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.ViolationHeader"
msgid "Cross-cell references that fail the cook:"
msgstr "쿠킹을 실패시키는 셀을 넘는 참조:"

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.ViolationTip"
msgid "Selects both objects. Mark the target always loaded or move it into the same cell."
msgstr "두 오브젝트를 고릅니다. 대상을 늘 올라 있게 표시하거나 같은 셀로 옮깁니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.AddDataLayerTip"
msgid "Add a named integer data layer (terrain cost, footstep sound) to this map. The name must be new."
msgstr "이 맵에 이름 붙은 정수 데이터 레이어(지형 비용, 발소리)를 더합니다. 이름은 겹치면 안 됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ApplyEdgeTip"
msgid "Turn every cell on this edge into a walkable warp to the target map."
msgstr "이 가장자리의 모든 칸을 대상 맵으로 가는, 걸을 수 있는 워프로 바꿉니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ApplySizeTip"
msgid "Resize the map to the width and height above. Overlapping cells are kept; cells and warps outside the new size are removed."
msgstr "맵을 위의 너비와 높이로 바꿉니다. 겹치는 칸은 남고, 새 크기 밖의 칸과 워프는 지워집니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.AtlasIDTip"
msgid "Atlas cell index to paint, 0 to 255."
msgstr "칠할 아틀라스 칸 인덱스(0~255)입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.BrushTip"
msgid "Paint every cell you press and drag over (B)"
msgstr "누르고 끄는 칸마다 칠합니다 (B)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataLayerDefaultTip"
msgid "Value of every cell of the new layer, and the value Erase paints."
msgstr "새 레이어의 모든 칸 값이자 지우기가 칠하는 값입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataLayerNameTip"
msgid "Name of the new data layer. The game reads the layer by this name."
msgstr "새 데이터 레이어의 이름입니다. 게임은 이 이름으로 레이어를 읽습니다."

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.DataLayerRejectedStatus"
msgid "Data layer not added: the name is empty or already used"
msgstr "데이터 레이어를 더하지 못했습니다: 이름이 비었거나 이미 있습니다"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.DataValueTip"
msgid "Integer to paint on the selected data layer."
msgstr "고른 데이터 레이어에 칠할 정수입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetTip"
msgid "Map that walking off this edge (north, east, south or west) leads to."
msgstr "이 가장자리(북, 동, 남, 서)를 벗어나면 이어지는 맵입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetXTip"
msgid "Cell column the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 열입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EdgeTargetYTip"
msgid "Cell row the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 행입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.EraseTip"
msgid "Make the paint tools clear cells instead of painting them."
msgstr "칠하기 도구가 칸을 칠하는 대신 지우게 합니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.FillTip"
msgid "Paint every connected cell that has the same value as the pressed cell (G)"
msgstr "누른 칸과 같은 값으로 이어진 칸을 모두 칠합니다 (G)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.HeightTip"
msgid "Map height in cells. Takes effect when you press Apply Size."
msgstr "맵 높이(칸)입니다. Apply Size 를 눌러야 적용됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.LayerTip"
msgid "Layer the canvas shows and the tools paint: Visual (height and tint), Warp (exits to other maps), Tile (tile set brushes) or one of the gameplay flag layers."
msgstr "캔버스가 보여 주고 도구가 칠할 레이어입니다. Visual(높이와 틴트), Warp(다른 맵으로 가는 출구), Tile(타일셋 브러시), 또는 게임플레이 플래그 레이어 중 하나입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.LineTip"
msgid "Paint the line you drag out when you release the mouse (L)"
msgstr "끌어서 그린 선을 마우스를 놓을 때 칠합니다 (L)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.LoadTip"
msgid "Read the map at Path, discarding unsaved edits. Nothing changes if no file is there."
msgstr "저장하지 않은 편집을 버리고 Path 의 맵을 읽습니다. 그 자리에 파일이 없으면 아무것도 바뀌지 않습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.NameTip"
msgid "Display name stored in the map file."
msgstr "맵 파일에 저장되는 표시 이름입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.NoTileSet"
msgid "No tile set loaded"
msgstr "읽어 들인 타일셋 없음"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PaintHeightTip"
msgid "Height level to paint, 0 to 255."
msgstr "칠할 높이 단계(0~255)입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PathTip"
msgid "Resource path of the tile map file that Load and Save use."
msgstr "Load 와 Save 가 쓰는 타일맵 파일의 리소스 경로입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.PickerTip"
msgid "Take the pressed cell's value as the value to paint (I)"
msgstr "누른 칸의 값을 칠할 값으로 가져옵니다 (I)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.RectTip"
msgid "Paint the rectangle you drag out when you release the mouse (U)"
msgstr "눌러 끈 사각형을 놓을 때 칠합니다 (U)"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.RemoveDataLayerTip"
msgid "Delete the selected data layer and its values."
msgstr "고른 데이터 레이어와 그 값을 지웁니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.ResetViewTip"
msgid "Reset zoom and pan to the start (wheel: zoom, middle or right drag: pan)"
msgstr "확대와 이동을 처음으로 되돌립니다 (휠: 확대, 가운데 · 오른쪽 끌기: 이동)"

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.SaveFailedStatus"
msgid "Save failed"
msgstr "저장하지 못했습니다"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SaveTip"
msgid "Write the map to Path."
msgstr "맵을 Path 에 씁니다."

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.SavedStatus"
msgid "Saved {path}"
msgstr "{path} 저장됨"

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.SizeOutOfRange"
msgid "Size is out of range."
msgstr "크기가 범위를 벗어났습니다."

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.SpawnOutsideStatus"
msgid "Spawn not changed: the cell is outside the map"
msgstr "스폰을 바꾸지 않았습니다: 맵 밖의 칸입니다"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SpawnXTip"
msgid "Cell column where the player starts on this map."
msgstr "이 맵에서 플레이어가 시작하는 칸의 열입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.SpawnYTip"
msgid "Cell row where the player starts on this map."
msgstr "이 맵에서 플레이어가 시작하는 칸의 행입니다."

#: Source/Editor/Panels/TileMap/Model/TileMapModel.cpp
msgctxt "EditorTileMap.TileSetReadFailed"
msgid "Tile set could not be read: {path}"
msgstr "타일셋을 읽지 못했습니다: {path}"

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.TileSetTip"
msgid "Resource path of the tile set whose brushes this map paints with. Press Use to apply it."
msgstr "이 맵이 칠할 브러시를 담은 타일셋의 리소스 경로입니다. 적용하려면 Use 를 누릅니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.TintTip"
msgid "Color to paint into the cells' tint."
msgstr "칸의 틴트로 칠할 색입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.UseTileSetTip"
msgid "Make this map use the tile set on the left and load its brushes."
msgstr "이 맵이 왼쪽의 타일셋을 쓰게 하고 그 브러시를 읽습니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetTip"
msgid "Map a painted warp cell sends the player to. Painted warp cells also become walkable."
msgstr "칠한 워프 칸이 플레이어를 보낼 맵입니다. 칠한 워프 칸은 걸을 수 있는 칸도 됩니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetXTip"
msgid "Cell column the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 열입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WarpTargetYTip"
msgid "Cell row the player arrives at in the target map."
msgstr "대상 맵에서 플레이어가 도착할 칸의 행입니다."

#: Source/Editor/Panels/TileMap/TileMapPanel.cpp
msgctxt "EditorTileMap.WidthTip"
msgid "Map width in cells. Takes effect when you press Apply Size."
msgstr "맵 너비(칸)입니다. Apply Size 를 눌러야 적용됩니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.AddRule"
msgid "Add rule"
msgstr "규칙 더하기"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.AddRuleTile"
msgid "Add rule tile"
msgstr "규칙 타일 더하기"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.AddTile"
msgid "Add tile"
msgstr "타일 더하기"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.AtlasCellTip"
msgid "Click a cell to use it. Shift-click adds it as an animation frame."
msgstr "셀을 누르면 그 셀을 씁니다. Shift 를 누르고 누르면 애니메이션 프레임으로 더합니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.AtlasCells"
msgid "Atlas"
msgstr "아틀라스"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.BrushNameTip"
msgid "Maps paint brushes by this name. It must be unique."
msgstr "맵은 이 이름으로 브러시를 칠합니다. 겹치면 안 됩니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Brushes"
msgid "Brushes"
msgstr "브러시"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.DefaultLook"
msgid "Default look"
msgstr "기본 모습"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Fps"
msgid "Frames per second"
msgstr "초당 프레임"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Frames"
msgid "Frames"
msgstr "프레임"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.FramesTip"
msgid "Click an atlas cell to set the look. Shift-click adds a frame and makes it animated."
msgstr "아틀라스 셀을 누르면 모습이 됩니다. Shift 를 누르고 누르면 프레임을 더해 애니메이션이 됩니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Grid"
msgid "Columns, rows"
msgstr "열, 행"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.GridTip"
msgid "How many cells the atlas is cut into. Cell numbers stay, so cells that fall outside are shown as problems."
msgstr "아틀라스를 몇 칸으로 나눌지입니다. 셀 번호는 그대로라 밖으로 나간 셀은 문제로 보입니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.KindRule"
msgid "rule tile"
msgstr "규칙 타일"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.KindTile"
msgid "tile"
msgstr "타일"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.LoadingAtlasHint"
msgid "Loading the atlas texture."
msgstr "아틀라스 텍스처를 읽는 중입니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Look"
msgid "Look"
msgstr "모습"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.NavCost"
msgid "Move cost"
msgstr "이동 비용"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.NavCostTip"
msgid "Path finding cost from 1 to 255. 255 blocks the cell."
msgstr "길 찾기 비용입니다(1 ~ 255). 255 는 막힘입니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.NoAtlasHint"
msgid "Enter an atlas texture to pick cells from."
msgstr "셀을 고를 아틀라스 텍스처를 적으세요."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.NoBrushesHint"
msgid "No brushes yet. Add a tile, then pick its cell in the atlas."
msgstr "브러시가 없습니다. 타일을 더한 뒤 아틀라스에서 셀을 고르세요."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.OutsideSame"
msgid "Outside is same"
msgstr "맵 밖은 같음"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.OutsideSameTip"
msgid "Treat cells outside the map as this brush, so map edges draw no border."
msgstr "맵 밖 칸을 이 브러시로 보아 맵 가장자리에 테두리를 그리지 않습니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Pattern"
msgid "Neighbors"
msgstr "이웃"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.PatternTip"
msgid "Click a neighbor to cycle it: . any, o the same brush, x not the same brush. The middle shows the cell this rule picks."
msgstr "이웃을 누르면 바뀝니다: . 상관없음, o 같은 브러시, x 같은 브러시 아님. 가운데는 이 규칙이 고르는 셀입니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.RemoveLastFrame"
msgid "Remove last frame"
msgstr "마지막 프레임 빼기"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.RuleLabel"
msgid "Rule {index}"
msgstr "규칙 {index}"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.RuleOrderTip"
msgid "The first rule that matches its neighbors wins."
msgstr "이웃이 맞는 첫 규칙이 이깁니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.SaveTip"
msgid "Write the tile set. A tile set with problems is not saved, so the game never reads a broken file."
msgstr "타일셋을 씁니다. 문제가 있으면 저장하지 않아 게임이 깨진 파일을 읽지 않습니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.Solid"
msgid "Solid"
msgstr "단단함"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.SolidTip"
msgid "Characters cannot walk through this tile."
msgstr "캐릭터가 이 타일을 지나가지 못합니다."

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.TileSize"
msgid "Tile size"
msgstr "타일 크기"

#: Source/Editor/Panels/TileSet/TileSetPanel.cpp
msgctxt "EditorTileSet.TileSizeTip"
msgid "World size of one cell."
msgstr "셀 한 칸의 월드 크기입니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraFOV"
msgid "Vertical field of view in degrees. Larger values show more of the scene and stretch the edges."
msgstr "세로 시야각(도)입니다. 값이 클수록 장면이 넓게 보이고 가장자리가 늘어나 보입니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraFar"
msgid "Farthest distance the camera draws. Geometry beyond this is clipped."
msgstr "카메라가 그리는 가장 먼 거리입니다. 이보다 먼 지오메트리는 잘려 나갑니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraNear"
msgid "Closest distance the camera draws. Geometry nearer than this is clipped; keep it as large as the scene allows to avoid depth fighting."
msgstr "카메라가 그리는 가장 가까운 거리입니다. 이보다 가까운 지오메트리는 잘려 나갑니다. 깊이 충돌(z-fighting)을 피하려면 장면이 허용하는 만큼 크게 두세요."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraOrthoHeight"
msgid "World-space height of the visible area; the width follows the aspect ratio."
msgstr "보이는 영역의 월드 높이입니다. 너비는 화면 비율을 따라갑니다."

#: Source/Editor/Panels/Inspector/CameraComponentInspector.cpp
msgctxt "EditorTip.CameraOrthographic"
msgid "Use a parallel (non-perspective) projection, as for 2D or isometric views. FOV is ignored while on."
msgstr "원근 없는 평행 투영을 씁니다(2D · 아이소메트릭 시점). 켜져 있는 동안 FOV 는 무시됩니다."

#: Source/Editor/Common/Widgets/EditorCurveEditorState.cpp
msgctxt "EditorTip.CurveKeyInterpolation"
msgid "How the curve moves from this key to the next: Constant holds the value, Linear is a straight line, Cubic is a smooth spline."
msgstr "이 키에서 다음 키까지 곡선이 움직이는 방식입니다. Constant 는 값을 유지하고, Linear 는 직선, Cubic 은 부드러운 스플라인입니다."

#: Source/Editor/Common/Widgets/EditorCurveEditorState.cpp
msgctxt "EditorTip.CurveKeyTime"
msgid "When the key sits on the curve's time axis. It stays between its neighbouring keys."
msgstr "이 키가 곡선의 시간 축에서 놓인 위치입니다. 이웃한 키 사이에만 둘 수 있습니다."

#: Source/Editor/Common/Widgets/EditorCurveEditorState.cpp
msgctxt "EditorTip.CurveKeyValue"
msgid "The curve's value at this key."
msgstr "이 키에서 곡선이 가지는 값입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDCorner"
msgid "Which screen corner the Debug HUD is anchored to."
msgstr "디버그 HUD 를 붙여 둘 화면 모서리입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDOpacity"
msgid "Background opacity of the Debug HUD panels."
msgstr "디버그 HUD 패널의 배경 불투명도입니다."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDOpenWindow"
msgid "The same checklist as a runtime UI window (shows in the game view while playing)"
msgstr "같은 체크리스트를 런타임 UI 창으로 엽니다(플레이 중 게임 뷰에 보입니다)."

#: Source/Editor/Common/Widgets/EditorDebugHUDControls.cpp
msgctxt "EditorTip.DebugHUDSection"
msgid "Show or hide this section of the in-game Debug HUD. The grey text is the section's registration name."
msgstr "게임 안 디버그 HUD 의 이 구역을 보이거나 숨깁니다. 회색 글자는 구역의 등록 이름입니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorBottomCenter"
msgid "Bottom Center"
msgstr "아래 가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorBottomLeft"
msgid "Bottom Left"
msgstr "왼쪽 아래"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorBottomRight"
msgid "Bottom Right"
msgstr "오른쪽 아래"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorCenter"
msgid "Center"
msgstr "가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorCenterLeft"
msgid "Center Left"
msgstr "왼쪽 가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorCenterRight"
msgid "Center Right"
msgstr "오른쪽 가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorStretchAll"
msgid "Stretch All"
msgstr "전체 늘이기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorStretchHorizontal"
msgid "Stretch Horizontal"
msgstr "가로 늘이기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorStretchVertical"
msgid "Stretch Vertical"
msgstr "세로 늘이기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorTopCenter"
msgid "Top Center"
msgstr "위 가운데"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorTopLeft"
msgid "Top Left"
msgstr "왼쪽 위"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.AnchorTopRight"
msgid "Top Right"
msgstr "오른쪽 위"

#: Source/Editor/Panels/UIPreview/Model/UIPreviewModel.cpp
msgctxt "EditorUIPreview.BuildFailed"
msgid "Could not build the document (see the log)."
msgstr "문서를 만들지 못했습니다(로그를 확인합니다)."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.DocumentPathTip"
msgid "Resource path of the UI document (*.ui.xml) to preview. The preview rebuilds when it changes."
msgstr "미리 볼 UI 문서(*.ui.xml)의 리소스 경로입니다. 바꾸면 미리보기를 다시 만듭니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.EnterPathHint"
msgid "Enter a UI document path (*.ui.xml)."
msgstr "UI 문서 경로(*.ui.xml)를 입력합니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.GameLanguage"
msgid "(game language)"
msgstr "(게임 언어)"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.GameTheme"
msgid "(game theme)"
msgstr "(게임 테마)"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.LayoutRectsTip"
msgid "Outline every visible widget's layout rectangle over the preview."
msgstr "보이는 모든 위젯의 레이아웃 사각형을 미리보기 위에 그립니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.MoveEarlierTip"
msgid "Move the selected widget one place earlier among its siblings"
msgstr "고른 위젯을 형제 사이에서 한 칸 앞으로 옮깁니다"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.MoveLaterTip"
msgid "Move the selected widget one place later among its siblings"
msgstr "고른 위젯을 형제 사이에서 한 칸 뒤로 옮깁니다"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.NoAnimations"
msgid "(no animations)"
msgstr "(애니메이션 없음)"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.PseudoLanguage"
msgid "{code} (pseudo)"
msgstr "{code} (의사 문화권)"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.ReloadTip"
msgid "Rebuild the preview from the file, for example after editing the XML outside the editor."
msgstr "파일에서 미리보기를 다시 만듭니다. 에디터 밖에서 XML 을 고친 뒤에 씁니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.ResolutionTip"
msgid "Screen size to lay the document out for. Check layouts at several aspect ratios before shipping."
msgstr "문서를 배치할 화면 크기입니다. 출시 전에 여러 화면비에서 레이아웃을 확인합니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.RotateTip"
msgid "Turn the device 90 degrees: width and height swap and the safe area insets follow the notch."
msgstr "기기를 90 도 돌립니다. 너비와 높이가 바뀌고 안전 여백이 노치를 따라 돕니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SafeZoneTip"
msgid "Fraction of the screen trimmed from each edge, 0 to 0.1, as on TVs that cut off the border. The red frame shows the safe area."
msgstr "가장자리를 잘라 내는 TV 처럼 각 변에서 잘라 낼 화면 비율(0~0.1)입니다. 빨간 테두리가 안전 영역입니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SelectWidgetHint"
msgid "{width} x {height} UI units, scale {scale} - click the image or the tree to select a widget"
msgstr "{width} x {height} UI 단위, 배율 {scale} - 이미지나 트리를 클릭해 위젯을 선택합니다"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotAnchorMax"
msgid "Anchor Max"
msgstr "앵커 최대"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotAnchorMin"
msgid "Anchor Min"
msgstr "앵커 최소"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotAnchorPreset"
msgid "Anchors"
msgstr "앵커"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotAnchorPresetTip"
msgid "Sets the anchors and recomputes the offsets so the widget stays where it is."
