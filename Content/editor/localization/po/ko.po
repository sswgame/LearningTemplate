#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayRunning"
msgid "The game is running. The game view draws the game camera, and the scene view lets you look around with the editor camera."
msgstr "현재 게임 실행 중 — 게임 뷰가 게임 카메라를 그리고, 씬 뷰는 에디터 카메라로 둘러볼 수 있습니다"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStart"
msgid "Start play mode (enables game view input and player control)."
msgstr "게임 플레이 모드를 시작합니다 (게임 뷰 입력 및 플레이어 컨트롤 활성화)"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStartAtCamera"
msgid "Start Play at the editor camera position (moves the object tagged 'Player', or else the object holding the game camera)."
msgstr "Play 를 에디터 카메라 위치에서 시작합니다 ('Player' 태그 오브젝트, 없으면 게임 카메라를 든 오브젝트를 옮깁니다)"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStarting"
msgid "Opening the scene. Play starts when loading finishes (Stop cancels it)."
msgstr "씬을 여는 중 — 로드가 끝나면 플레이를 시작합니다 (Stop 으로 취소)"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStepFrameCount"
msgid "Number of frames 'Step N' advances (1 or more)."
msgstr "'Step N' 이 진행할 프레임 수"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStepFrames"
msgid "Advance by the number of frames in the box on the left, then pause."
msgstr "왼쪽 칸의 프레임 수만큼 진행한 뒤 일시 정지합니다"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStepOnce"
msgid "Advance the game by exactly one frame."
msgstr "게임을 정확히 1프레임 전진시킵니다"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayStop"
msgid "Stop the game and restore the scene to its state before Play."
msgstr "게임을 중지하고 초기 씬 상태로 복원합니다"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.PlayTimeScale"
msgid "Game time scale (gv_timeScale). Drag to change it; right-click to reset it to x1.00."
msgstr "게임 시간 배율 (gv_timeScale) — 끌어서 바꾸고, 오른쪽 클릭으로 x1.00 으로 되돌립니다"

#: Source/Editor/Popups/QuickLauncherPopup.cpp
msgctxt "EdCommon.QuickOpenHint"
msgid "Type to search assets, scenes, game objects (ESC to cancel)..."
msgstr "에셋 · 씬 · 게임 오브젝트를 검색합니다(ESC 로 취소)..."

#: Source/Editor/Popups/QuickLauncherPopup.cpp
msgctxt "EdCommon.QuickOpenIndexing"
msgid "Indexing assets..."
msgstr "에셋을 인덱싱하는 중..."

#: Source/Editor/Popups/QuickLauncherPopup.cpp
msgctxt "EdCommon.QuickOpenNoMatches"
msgid "No matching assets or game objects found."
msgstr "일치하는 에셋이나 게임 오브젝트가 없습니다."

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.RHIBackend"
msgid "Current graphics RHI backend: {backend} ({fps} FPS)"
msgstr "현재 그래픽스 RHI 백엔드: {backend} ({fps} FPS)"

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.RHISwitch"
msgid "Switch the RHI with a command-line argument: -dx11 / -dx12 / -vk / -gl"
msgstr "실행 인수로 RHI 전환: -dx11 / -dx12 / -vk / -gl"

#: Source/Editor/Common/GUI/Panel/EditorDocumentPanel.cpp
msgctxt "EdCommon.RecentDocuments"
msgid "Recently opened documents. Pick one to open it again."
msgstr "최근에 연 문서"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.RenderDocCapture"
msgid "Capture the next frame with RenderDoc (Saved/RenderDoc/, Ctrl+F12)"
msgstr "다음 프레임을 RenderDoc 으로 캡처합니다 (Saved/RenderDoc/, Ctrl+F12)"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.RenderDocUnavailable"
msgid "RenderDoc is not attached to this process. Start with -renderdoc or launch from RenderDoc."
msgstr "RenderDoc 이 이 프로세스에 붙어 있지 않습니다. -renderdoc 으로 시작하거나 RenderDoc 에서 실행하십시오."

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.ResetLayout"
msgid "Reset the docked windows to the default editor layout."
msgstr "도킹 창 배치를 기본 에디터 레이아웃으로 초기화합니다"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.RotationSnap"
msgid "Rotation snap: rotations jump in steps of the angle on the right."
msgstr "회전 스냅: 회전이 오른쪽의 각도 단위로 움직입니다."

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.RotationSnapSize"
msgid "Rotation snap step, in degrees."
msgstr "회전 스냅 간격(도)입니다."

#: Source/Editor/Common/GUI/EditorMenuBar.cpp
msgctxt "EdCommon.SaveLayout"
msgid "Save the current dock layout and panel visibility under this name (Saved/Editor/Layouts; letters, digits, spaces, _ and - only)."
msgstr "지금 도킹 배치와 패널 가시성을 이 이름으로 저장합니다 (Saved/Editor/Layouts, 영숫자 · 공백 · _ · -)"

#: Source/Editor/Common/GUI/Panel/EditorDocumentPanel.cpp
msgctxt "EdCommon.SearchAssetsHint"
msgid "Search assets"
msgstr "에셋 검색"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.SearchClear"
msgid "Clear the search text."
msgstr "검색어를 지웁니다."

#: Source/Editor/Common/Widgets/EditorComponentMenu.cpp
#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.SearchHint"
msgid "Search..."
msgstr "검색..."

#: Source/Editor/Common/Widgets/EditorNodeGraph.cpp
msgctxt "EdCommon.SearchNodesHint"
msgid "Search nodes..."
msgstr "노드 검색..."

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.SimulateRunning"
msgid "Only the world is ticking: no game module update and no game input."
msgstr "월드만 도는 중 — 게임 모듈 업데이트 · 게임 입력 없음"

#: Source/Editor/Common/GUI/EditorPlayToolbar.cpp
msgctxt "EdCommon.SimulateStart"
msgid "Start simulate mode (ticks the scene only: no game module update and no game input)."
msgstr "시뮬레이션 모드를 시작합니다 (씬만 틱 — 게임 모듈 업데이트 · 게임 입력 없음)"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.SurfaceSnap"
msgid "Surface snap: objects you drag land on the surface under the cursor."
msgstr "표면 스냅: 끄는 오브젝트가 커서 아래 표면에 놓입니다."

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeAccentColor"
msgid "The accent color used for buttons, selection highlights, folders and active items."
msgstr "버튼, 선택 하이라이트, 폴더 및 활성 항목에 적용할 대표 액센트 색상"

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeAccentSwatch"
msgid "A recommended accent color. Click to apply it."
msgstr "추천 액센트 색상 팔레트입니다. 클릭하면 적용됩니다."

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeFrameRounding"
msgid "Corner rounding of buttons, input fields and control frames, in pixels (0 to 8)."
msgstr "버튼, 입력 필드 및 컨트롤 프레임의 모서리 둥글기(px, 0 ~ 8)"

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemePreset"
msgid "Choose the editor theme (Dark, Light, High Contrast and more). Themes are token files under Content/editor/theme."
msgstr "에디터 테마(Dark, Light, High Contrast 등)를 선택합니다. 테마는 Content/editor/theme 의 토큰 파일입니다."

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeReset"
msgid "Drop your accent and rounding changes and use the values of the current theme."
msgstr "강조색과 둥글기 변경을 버리고 현재 테마의 값을 씁니다"

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeTabRounding"
msgid "Corner rounding of dock tabs and panel tabs, in pixels (0 to 8)."
msgstr "도킹 탭 및 상단 패널 탭 모서리의 둥글기(px, 0 ~ 8)"

#: Source/Editor/Common/GUI/Theme/EditorThemeUtil.cpp
msgctxt "EdCommon.ThemeWindowRounding"
msgid "Corner rounding of editor windows and popup dialogs, in pixels (0 to 12)."
msgstr "에디터 창 및 팝업 대화상자 모서리의 둥글기(px, 0 ~ 12)"

#: Source/Editor/Common/Widgets/EditorNodeGraph.cpp
msgctxt "EdCommon.UnknownPin"
msgid "Unknown pin"
msgstr "알 수 없는 핀"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.Vec3AxisDrag"
msgid "Drag to change the value, or double-click to type a number."
msgstr "마우스 드래그 또는 더블 클릭으로 값 수정"

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
msgctxt "EdCommon.Vec3AxisReset"
msgid "Click to reset this axis to its default value."
msgstr "클릭하여 기본값으로 초기화합니다"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.View2D"
msgid "2D view (XY plane grid). Click to switch to 3D."
msgstr "2D 뷰(XY 평면 그리드)입니다. 클릭하면 3D 로 바뀝니다."

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.View3D"
msgid "3D view (XZ plane grid). Click to switch to 2D."
msgstr "3D 뷰(XZ 평면 그리드)입니다. 클릭하면 2D 로 바뀝니다."

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.ViewMode"
msgid "Scene view mode: Lit / Unlit / Wireframe / Normals / Depth / Overdraw (the game view always draws Lit)"
msgstr "씬 뷰 보기 모드 — Lit / Unlit / Wireframe / Normals / Depth / Overdraw (게임 뷰는 늘 Lit)"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.ViewModeNoRenderer"
msgid "The renderer is not attached yet."
msgstr "렌더러가 아직 붙지 않았습니다"

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.ViewportGrid"
msgid "Show or hide the ground grid."
msgstr "바닥 그리드를 보이거나 숨깁니다."

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.ViewportHUD"
msgid "Show the Debug HUD box in this view (view size and HUD sections). Right-click to choose sections."
msgstr "이 뷰에 디버그 HUD 상자(뷰 크기 · HUD 섹션)를 보입니다. 오른쪽 클릭으로 섹션을 고릅니다."

#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.ViewportOrientationCube"
msgid "Show or hide the orientation cube that shows which way the camera faces."
msgstr "카메라가 어느 쪽을 보는지 나타내는 방향 큐브를 보이거나 숨깁니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.AddAttackTip"
msgid "Add an Attack state node. Its name is the clip it plays; rename it in the inspector."
msgstr "Attack 상태 노드를 추가합니다. 노드 이름이 재생할 클립이며, 인스펙터에서 바꿀 수 있습니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.AddBoneMaskTip"
msgid "Add a bone mask that starts at the spine. Rename its bones to match your skeleton."
msgstr "spine 에서 시작하는 본 마스크를 더합니다. 본 이름을 스켈레톤에 맞게 고칩니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.AddIdleTip"
msgid "Add an Idle state node. Its name is the clip it plays; rename it in the inspector."
msgstr "Idle 상태 노드를 추가합니다. 노드 이름이 재생할 클립이며, 인스펙터에서 바꿀 수 있습니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.AddLayerTip"
msgid "Add a layer. Layers stack in list order; the last one is on top."
msgstr "레이어를 더합니다. 레이어는 목록 순서대로 얹히고 마지막 것이 맨 위입니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.AddWalkTip"
msgid "Add a Walk state node. Its name is the clip it plays; rename it in the inspector."
msgstr "Walk 상태 노드를 추가합니다. 노드 이름이 재생할 클립이며, 인스펙터에서 바꿀 수 있습니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.AdvanceTip"
msgid "Step the preview to the next state by one transition."
msgstr "미리보기를 전이 하나만큼 다음 상태로 넘깁니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.BoneMaskChildrenTip"
msgid "Checked: the weight spreads to every child bone. Unchecked: only this bone."
msgstr "켜면 가중치가 모든 자식 본에 퍼지고, 끄면 이 본 하나만 바꿉니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.BoneMaskPresetTip"
msgid "Drop a .bonemask.xml preset to use it; its bones are then read-only here. Clear it to keep the bones in this graph."
msgstr ".bonemask.xml 프리셋을 놓으면 그것을 쓰고, 그 본은 여기서 읽기만 합니다. 비우면 본을 이 그래프에 바로 적습니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.ConditionOpTip"
msgid "How the parameter is compared with Value. (on finish) moves on when the clip ends; Trigger fires once when the parameter is set."
msgstr "파라미터를 Value 와 비교하는 방식입니다. (on finish) 는 클립이 끝나면 넘어가고, Trigger 는 파라미터가 설정될 때 한 번 발동합니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.ConditionParamTip"
msgid "Graph parameter the condition reads (set by game code through the player)"
msgstr "조건이 읽는 그래프 파라미터입니다(게임 코드가 플레이어를 통해 설정합니다)."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.ConditionValueTip"
msgid "The threshold the parameter is compared against."
msgstr "파라미터와 비교할 임곗값입니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.ContextCreateFailed"
msgid "Failed to create Animation Graph editor context."
msgstr "애니메이션 그래프 편집기 컨텍스트를 만들지 못했습니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerBlendTip"
msgid "Override replaces the masked bones; Additive adds the clip's difference from its first frame."
msgstr "Override 는 마스크의 본을 바꾸고, Additive 는 클립의 첫 프레임과의 차이를 더합니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerClipTip"
msgid "Clip this layer plays (its name in the clip folder)."
msgstr "이 레이어가 재생할 클립입니다(클립 폴더의 이름)."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerHalfLifeTip"
msgid "When the layer restarts, blend out of the interrupted pose with this half-life. 0 switches at once."
msgstr "레이어가 다시 시작할 때 끊긴 포즈에서 이 반감기로 이어 갑니다. 0 이면 바로 바뀝니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerMaskTip"
msgid "Bones the layer affects. (all bones) applies it to the whole skeleton."
msgstr "레이어가 움직이는 본입니다. (all bones) 면 스켈레톤 전체입니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerOrderTip"
msgid "Move the selected layer up or down. Order changes the result: later layers are applied on top."
msgstr "고른 레이어를 위나 아래로 옮깁니다. 순서가 결과를 바꿉니다. 뒤의 레이어가 위에 얹힙니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerWeightParamTip"
msgid "Animator parameter that drives the weight every frame (clamped to 0..1). Leave empty to use Weight."
msgstr "매 프레임 가중치를 정하는 애니메이터 파라미터입니다(0..1 로 자릅니다). 비우면 Weight 를 씁니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.LayerWeightTip"
msgid "How much of the layer pose is applied. Ignored while Weight Param is set."
msgstr "레이어 포즈를 얼마나 섞을지입니다. Weight Param 이 있으면 쓰지 않습니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.LinkSelectedTip"
msgid "Add a transition between the two selected nodes, from the first selected to the second. Click one node, then Ctrl+click the other."
msgstr "선택한 두 노드 사이에 첫 번째에서 두 번째로 가는 전이를 추가합니다. 노드 하나를 클릭한 뒤 다른 노드를 Ctrl+클릭합니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.LoadTip"
msgid "Reload the graph from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 그래프를 다시 읽습니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.NoBoneMasksHint"
msgid "No bone masks. A mask chooses the bones a layer affects and how strongly."
msgstr "본 마스크가 없습니다. 마스크는 레이어가 움직일 본과 그 세기를 고릅니다."

#: Source/Editor/Panels/Animation/AnimationGraphLayerEditor.cpp
msgctxt "EditorAnimationGraph.NoLayersHint"
msgid "No layers. A layer plays one clip over the state machine pose, on the bones of its mask."
msgstr "레이어가 없습니다. 레이어는 상태 기계 포즈 위에 클립 하나를 마스크의 본에만 얹습니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.PlayTip"
msgid "Preview the graph from the entry state, stepping to the next state every 0.75 seconds. Use it to check the transition order."
msgstr "진입 상태부터 0.75초마다 다음 상태로 넘어가며 그래프를 미리 봅니다. 전이 순서를 확인할 때 씁니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.SaveTip"
msgid "Write the graph and its node layout to the asset file."
msgstr "그래프와 노드 배치를 애셋 파일에 씁니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.StateClipTip"
msgid "The state's clip name - the player plays the clip with this name"
msgstr "상태의 클립 이름입니다. 플레이어는 이 이름의 클립을 재생합니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.StateLoopTip"
msgid "Whether this state's clip repeats. Default keeps the clip's own loop setting."
msgstr "이 상태의 클립을 반복할지 정합니다. Default 는 클립 자체의 루프 설정을 따릅니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.StopTip"
msgid "Stop the preview."
msgstr "미리보기를 멈춥니다."

#: Source/Editor/Panels/Animation/AnimationGraphPanel.cpp
msgctxt "EditorAnimationGraph.TransitionBlendTip"
msgid "Crossfade seconds; below zero uses the player default"
msgstr "크로스페이드 시간(초)입니다. 0보다 작으면 플레이어 기본값을 씁니다."

#: Source/Editor/Panels/Animation/AnimationRewindPanel.cpp
msgctxt "EditorAnimationRewind.AllTracksTip"
msgid "Draw every recorded character's skeleton, not only the selected one."
msgstr "선택한 캐릭터뿐 아니라 기록된 모든 캐릭터의 스켈레톤을 그립니다."

#: Source/Editor/Panels/Animation/AnimationRewindPanel.cpp
msgctxt "EditorAnimationRewind.NoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Animation/AnimationRewindPanel.cpp
msgctxt "EditorAnimationRewind.NothingRecorded"
msgid "Nothing recorded yet. Turn recording on and play (PIE) - or 'anim.rewind on' in the console."
msgstr "아직 기록이 없습니다. 기록을 켜고 플레이(PIE)하거나 콘솔에서 'anim.rewind on' 을 입력합니다."

#: Source/Editor/Panels/Animation/AnimationRewindPanel.cpp
msgctxt "EditorAnimationRewind.RecordTip"
msgid "Record every animated character's pose and state each frame while the game plays, so you can scrub back and inspect them. Same as 'anim.rewind on'."
