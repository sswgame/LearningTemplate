msgctxt "EditorContentBrowser.DeleteCollectionTooltip"
msgid "Delete this collection. The assets stay where they are"
msgstr "이 컬렉션을 지웁니다. 에셋은 제자리에 남습니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.EmptyCollection"
msgid "This collection is empty. Drop assets on its name to add them."
msgstr "이 컬렉션은 비었습니다. 에셋을 이름 위에 놓으면 더해집니다."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.FindSelected"
msgid "Find selected"
msgstr "선택 항목 찾기"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.FindSelectedTip"
msgid "Go to the asset of the object selected in the main scene and select it here. Selections in preview windows are not followed."
msgstr "메인 씬에서 고른 오브젝트의 에셋으로 가서 여기서 고릅니다. 미리보기 창의 선택은 따라가지 않습니다."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.Import"
msgid "Import external files (textures, shaders, sounds, ...) into the current folder"
msgstr "외부 파일(텍스처, 셰이더, 사운드 등)을 현재 폴더로 가져옵니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.ImportNeedsFolder"
msgid "Select a target folder to import assets into first"
msgstr "에셋을 가져올 대상 폴더를 먼저 선택하세요"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.IndexingReferences"
msgid "Indexing references. Try again in a moment."
msgstr "참조를 색인하는 중입니다. 잠시 뒤 다시 시도하세요."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.ListView"
msgid "Show assets as a detailed list of name, type and path"
msgstr "에셋을 이름, 종류, 경로 세부 리스트 목록으로 표시합니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NavigateBack"
msgid "Go to the previous folder (Mouse Back button / Alt+Left / Backspace)"
msgstr "이전 폴더로 이동 (마우스 뒤로가기 버튼 / Alt+Left / Backspace)"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NavigateForward"
msgid "Go to the next folder (Mouse Forward button / Alt+Right)"
msgstr "다음 폴더로 이동 (마우스 앞으로가기 버튼 / Alt+Right)"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NewCollectionTooltip"
msgid "Make a collection - the selected asset goes in. Drop assets on a collection to add them"
msgstr "컬렉션을 만들고 선택한 에셋을 넣습니다. 에셋을 컬렉션 위에 놓으면 더해집니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NoCollections"
msgid "No saved searches or collections yet. Save a search or make a collection below."
msgstr "저장한 검색이나 컬렉션이 아직 없습니다. 아래에서 검색을 저장하거나 컬렉션을 만드세요."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NoDependencies"
msgid "This asset names no other asset."
msgstr "이 에셋은 다른 에셋을 참조하지 않습니다."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NoReferencers"
msgid "No text asset names this asset."
msgstr "이 에셋을 참조하는 텍스트 에셋이 없습니다."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.NoResourceRoots"
msgid "No content roots found."
msgstr "리소스 루트를 찾지 못했습니다."

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.OpenOnDoubleClick"
msgid "Double-click to open"
msgstr "더블클릭하면 엽니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.Refresh"
msgid "Refresh the disk files and the content root list"
msgstr "디스크 파일 및 리소스 루트 목록을 새로고침합니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.SaveSearchTooltip"
msgid "Keep the search text and the type filter under a name"
msgstr "검색어와 종류 필터를 이름을 붙여 남깁니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.SearchHint"
msgid "Search Content"
msgstr "콘텐츠 검색"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.SearchTooltip"
msgid "Filter assets by name or extension"
msgstr "에셋 이름 또는 확장자로 필터링하여 검색합니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.SelectFolder"
msgid "Select a folder"
msgstr "폴더를 선택하세요"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.SharedCollectionTooltip"
msgid "Shared entries are written to Config/Editor/ContentCollections.txt and committed with the project; the others stay on this machine"
msgstr "공유 항목은 Config/Editor/ContentCollections.txt 에 써서 프로젝트와 함께 커밋합니다. 나머지는 이 컴퓨터에만 남습니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.TileSize"
msgid "Adjust the tile thumbnail size (64px to 160px)"
msgstr "타일 썸네일의 크기를 조절합니다 (64px ~ 160px)"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.TilesView"
msgid "Show assets as square thumbnail cards (tiles)"
msgstr "에셋을 사각형 썸네일 카드(타일) 형태로 표시합니다"

#: Source/Editor/Panels/ContentBrowser/ContentBrowserPanel.cpp
msgctxt "EditorContentBrowser.TypeFilter"
msgid "Filter by asset type (texture, scene, prefab, sound, ...)"
msgstr "특정 에셋 종류(텍스처, 씬, 프리팹, 사운드 등)별로 필터링합니다"

#: Source/Editor/Panels/Scene/DataLayersPanel.cpp
msgctxt "EditorDataLayers.InitialTip"
msgid "Turn this layer on when the scene opens. Saved with the scene."
msgstr "씬을 열 때 이 레이어를 켭니다. 씬과 함께 저장됩니다."

#: Source/Editor/Panels/Scene/DataLayersPanel.cpp
msgctxt "EditorDataLayers.NoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Scene/DataLayersPanel.cpp
msgctxt "EditorDataLayers.NoLayers"
msgid "The active scene declares no data layers. Add them to its World Settings."
msgstr "활성 씬에 선언한 데이터 레이어가 없습니다. 월드 설정에서 더합니다."

#: Source/Editor/Panels/Scene/DataLayersPanel.cpp
msgctxt "EditorDataLayers.ShownTip"
msgid "Show or hide the objects of this layer. While editing, off only hides them; during play it unloads them."
msgstr "이 레이어의 오브젝트를 보이거나 감춥니다. 편집 중에는 숨기기만 하고, 플레이 중에는 내립니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.AddKeyTip"
msgid "Add a string with the key typed on the left. Keys already in the table are ignored."
msgstr "왼쪽에 입력한 키로 문자열을 추가합니다. 테이블에 이미 있는 키는 무시합니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.ConfirmTranslation"
msgid "OK"
msgstr "확인"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.ConfirmTranslationTip"
msgid "Keep this text: it becomes the translation of the current source and the stale or review mark goes away when you save."
msgstr "이 글을 그대로 둡니다. 지금 원문의 번역이 되고 저장할 때 낡음 · 검토 표시가 사라집니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.DeleteKeyTip"
msgid "Remove this key from the source table and every translation table when you save."
msgstr "저장할 때 이 키를 원문 테이블과 모든 번역 테이블에서 지웁니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.KeyTip"
msgid "Context: {context}\nComment: {comment}\nMax length: {maxLength}"
msgstr "컨텍스트: {context}\n주석: {comment}\n최대 길이: {maxLength}"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.LoadingLocalization"
msgid "Loading localization..."
msgstr "현지화 데이터를 읽는 중..."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NeedsWorkOnly"
msgid "Needs work"
msgstr "할 일만"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NeedsWorkOnlyTip"
msgid "Show only keys with a missing, stale or review-marked translation."
msgstr "번역이 없거나 낡았거나 검토 표시가 있는 키만 보여 줍니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NewKeyHint"
msgid "New string key..."
msgstr "새 문자열 키..."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NoProject"
msgid "(no project)"
msgstr "(프로젝트 없음)"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NoRecordsHint"
msgid "No localization records. Add a key or run App --gather-text."
msgstr "현지화 항목이 없습니다. 키를 추가하거나 App --gather-text 를 실행합니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.NoWorkLeftHint"
msgid "Every translation is up to date."
msgstr "모든 번역이 최신입니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.OverMaxLength"
msgid " (over the maximum length)"
msgstr " (최대 길이 초과)"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.ProjectTip"
msgid "Localization project whose string tables are shown. Save or reload before switching; a project with unsaved edits stays selected."
msgstr "문자열 테이블을 보여 줄 현지화 프로젝트입니다. 바꾸기 전에 저장하거나 다시 읽습니다. 저장하지 않은 편집이 있으면 프로젝트가 바뀌지 않습니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.RefreshFilesTip"
msgid "Scan the game data folders again for XML tables added or removed outside the editor."
msgstr "에디터 밖에서 추가하거나 지운 XML 테이블을 찾으려고 게임 데이터 폴더를 다시 훑습니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.ReloadTip"
msgid "Read the project's tables from disk again, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 프로젝트의 테이블을 디스크에서 다시 읽습니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.RevertTip"
msgid "Discard the edits and read the file from disk again."
msgstr "편집을 버리고 디스크에서 파일을 다시 읽습니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.SaveBeforeSwitchingTip"
msgid "Save or revert this file before opening another one."
msgstr "다른 파일을 열기 전에 이 파일을 저장하거나 되돌립니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.SaveFileTip"
msgid "Write the edited XML text back to this file. Text that is not valid XML is not saved."
msgstr "고친 XML 글을 이 파일에 씁니다. 올바른 XML 이 아닌 글은 저장하지 않습니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.SaveLocalizationTip"
msgid "Write the source table and every translation table of this project."
msgstr "이 프로젝트의 원문 테이블과 모든 번역 테이블을 씁니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.SearchHint"
msgid "Search keys, source or translations..."
msgstr "키, 원문, 번역 검색..."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.SelectTableHint"
msgid "Select an XML data table from the list on the left."
msgstr "왼쪽 목록에서 XML 데이터 테이블을 선택합니다."

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.StateMissing"
msgid "missing"
msgstr "없음"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.StateReview"
msgid "needs review (translation memory suggestion or fuzzy import)"
msgstr "검토 필요(번역 메모리 제안 또는 퍼지 가져오기)"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.StateStale"
msgid "stale - the source changed after this translation"
msgstr "오래됨 - 이 번역 뒤에 원문이 바뀌었습니다"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.StateTranslated"
msgid "translated"
msgstr "번역됨"

#: Source/Editor/Panels/DataTable/DataTablePanel.cpp
msgctxt "EditorDataTable.TranslationCellTip"
msgid "{context}\nState: {state}\nLength: {length}{overflow}"
msgstr "{context}\n상태: {state}\n길이: {length}{overflow}"

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.AddChoiceTip"
msgid "Add an option the player can pick. Each option gets its own output pin."
msgstr "플레이어가 고를 수 있는 선택지를 추가합니다. 선택지마다 출력 핀이 따로 생깁니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.AddNodeTip"
msgid "Add a node of this type to the graph. You can also right-click empty canvas to search for one."
msgstr "이 종류의 노드를 그래프에 추가합니다. 캔버스 빈 곳을 오른쪽 클릭해 찾아 넣을 수도 있습니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.AddSpeaker"
msgid "+ Add Speaker"
msgstr "+ 화자 추가"

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.AdvancePreviewTip"
msgid "Move the preview to the next node without waiting."
msgstr "기다리지 않고 미리보기를 다음 노드로 넘깁니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.CommandTip"
msgid "Command the game runs when the conversation passes this node, written as name:argument:argument."
msgstr "대화가 이 노드를 지날 때 게임이 실행하는 명령으로, 이름:인자:인자 형식입니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.ConditionExample"
msgid "Ex: boss_defeated && gold >= 10"
msgstr "예: boss_defeated && gold >= 10"

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.ConditionTip"
msgid "Expression the game evaluates when the conversation reaches this node; true follows the True link, false the False link."
msgstr "대화가 이 노드에 닿으면 게임이 평가하는 식입니다. 참이면 True 링크, 거짓이면 False 링크를 따라갑니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.ContextCreateFailed"
msgid "Failed to create Dialogue Node Editor context."
msgstr "대화 노드 편집기 컨텍스트를 만들지 못했습니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.NoSpeaker"
msgid "(No Speaker)"
msgstr "(화자 없음)"

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.PlayPreviewTip"
msgid "Run the conversation from the Start node and show each line in the viewport. Lines advance on their own; choices and conditions wait for the buttons that appear."
msgstr "Start 노드부터 대화를 진행하며 대사를 뷰포트에 보여 줍니다. 대사는 저절로 넘어가고, 선택지와 조건은 나타나는 버튼을 기다립니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.PreviewChoiceTip"
msgid "Pick this choice and follow its link."
msgstr "이 선택지를 골라 그 링크를 따라갑니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.PreviewFalseTip"
msgid "Treat the condition as not met and follow the False link."
msgstr "조건이 거짓인 것으로 보고 False 링크를 따라갑니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.PreviewTrueTip"
msgid "Treat the condition as met and follow the True link."
msgstr "조건이 참인 것으로 보고 True 링크를 따라갑니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.ReloadTip"
msgid "Reload the graph from disk, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 그래프를 다시 읽습니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.RemoveChoiceTip"
msgid "Remove this choice option."
msgstr "이 선택지를 지웁니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.RemoveSpeakerTip"
msgid "Remove this speaker. Lines that used it are left without a speaker."
msgstr "이 화자를 지웁니다. 이 화자를 쓰던 대사는 화자 없음이 됩니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.ResetDefaultTip"
msgid "Replace the whole graph with the sample conversation."
msgstr "그래프 전체를 예제 대화로 바꿉니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.SaveTip"
msgid "Write the dialogue graph and its node layout to the asset file."
msgstr "대화 그래프와 노드 배치를 애셋 파일에 씁니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.SpeakerNameTip"
msgid "Name shown as the speaker, or a localization key."
msgstr "화자로 보이는 이름 또는 현지화 키입니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.SpeakerTip"
msgid "Speaker of this line, picked from the graph's speakers. The scene object that speaks is set in the dialogue runner's Speakers list."
msgstr "이 대사의 화자입니다. 그래프의 화자 목록에서 고릅니다. 말하는 씬 오브젝트는 대화 러너의 Speakers 목록에서 정합니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.Speakers"
msgid "Speakers"
msgstr "화자"

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.SpeakersTip"
msgid "Speakers the lines refer to by id. Renaming one keeps every line linked."
msgstr "대사가 id 로 가리키는 화자입니다. 이름을 바꿔도 대사가 끊기지 않습니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.StopPreviewTip"
msgid "End the preview."
msgstr "미리보기를 끝냅니다."

#: Source/Editor/Panels/Dialogue/DialogueGraphPanel.cpp
msgctxt "EditorDialogueGraph.TextTip"
msgid "The line the player reads. On a Choice node it is the prompt shown above the options."
msgstr "플레이어가 읽는 대사입니다. Choice 노드에서는 선택지 위에 나오는 질문입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ActionConflictTip"
msgid "Shares a key with another action on the same layer - see the details"
msgstr "같은 레이어의 다른 액션과 키가 겹칩니다. 자세한 내용을 확인합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.AddBinding"
msgid "Add Binding"
msgstr "바인딩 추가"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.AddBindingTip"
msgid "Add a binding to this action: the next key, key combination or gamepad button you press becomes it."
msgstr "이 액션에 바인딩을 더합니다. 다음에 누르는 키, 키 조합 또는 게임패드 버튼이 새 바인딩이 됩니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.BindingLayerTip"
msgid "The layer this binding belongs to. It fires only while that layer is active."
msgstr "이 바인딩이 속한 레이어입니다. 그 레이어가 활성일 때만 발화합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.BundleFiles"
msgid "Files in this bundle"
msgstr "이 묶음의 파일"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.BundleFilesTip"
msgid "The maps of this game, in load order: the base map, the shared maps, the kit maps and last the game's own differences. Saving writes each action back to the file that set it, and files you did not change are left alone."
msgstr "이 게임의 맵을 읽는 차례대로 보입니다. 기본 맵, 공통 맵, 키트 맵, 맨 끝이 게임의 차이입니다. 저장하면 액션은 그것을 정한 파일로 돌아가고, 고치지 않은 파일은 쓰지 않습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.CaptureInstruction"
msgid "Press a key, key combination or gamepad button to bind, Esc to cancel, or click a button below..."
msgstr "바인딩할 키, 키 조합 또는 게임패드 버튼을 누르거나 아래 버튼을 클릭합니다. Esc 는 취소입니다..."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ConflictCount"
msgid "{count, plural, one {# conflict} other {# conflicts}}"
msgstr "{count, plural, other {충돌 #개}}"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.CreateActionTip"
msgid "Add the action with no bindings; select it in the list to add keys."
msgstr "바인딩 없이 액션을 추가합니다. 목록에서 선택해 키를 추가합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.CreateLayerTip"
msgid "Add the layer to this map. Bindings can then be moved to it."
msgstr "이 맵에 레이어를 더합니다. 그러면 바인딩을 그 레이어로 옮길 수 있습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.DeleteAction"
msgid "Delete Action"
msgstr "액션 삭제"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.DeleteActionTip"
msgid "Remove this action and its bindings from the map. Reload brings it back until you save."
msgstr "이 액션과 바인딩을 맵에서 지웁니다. 저장하기 전에는 다시 읽기로 되돌릴 수 있습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.FilterActionsHint"
msgid "Filter actions..."
msgstr "액션 필터..."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.InjectKeyDownTip"
msgid "Send a key-press event for the chosen key, as if it were pressed and held. Send KeyUp to release it."
msgstr "고른 키를 눌러서 누르고 있는 것처럼 키 누름 이벤트를 보냅니다. 떼려면 KeyUp 을 보냅니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.InjectKeyUpTip"
msgid "Send a key-release event for the chosen key."
msgstr "고른 키의 키 뗌 이벤트를 보냅니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.InjectStickTip"
msgid "Hold gamepad 0's left stick at the tilt set above until you reset it."
msgstr "게임패드 0의 왼쪽 스틱을 되돌릴 때까지 위에서 정한 기울기로 유지합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.InjectorHint"
msgid "Inject virtual key, mouse, or stick events directly into the engine without physical hardware."
msgstr "실제 장치 없이 가상 키, 마우스, 스틱 이벤트를 엔진에 바로 넣습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.LayerEnabledTip"
msgid "Whether this layer starts enabled. The enabled layer with the highest priority receives input first."
msgstr "이 레이어가 켜진 채 시작할지 정합니다. 켜진 레이어 중 우선순위가 가장 높은 레이어가 입력을 먼저 받습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.LeftMotorTip"
msgid "Strength of the left (low-frequency) motor for the test pulse, 0 to 1."
msgstr "테스트 진동에 쓸 왼쪽(저주파) 모터 세기(0~1)입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.LoadReplayTip"
msgid "Read frames from the replay file, replacing the current recording. Stops any playback first."
msgstr "리플레이 파일에서 프레임을 읽어 지금 기록을 바꿉니다. 재생 중이면 먼저 멈춥니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.MapPathTip"
msgid "Resource path of the input map (*.input.xml) or of a game's data/gamesettings.xml to edit its whole bundle. Press Reload after changing it."
msgstr "편집할 입력 맵(*.input.xml)이나, 묶음 전체를 고칠 게임의 data/gamesettings.xml 의 리소스 경로입니다. 바꾼 뒤에는 Reload 를 누릅니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NewActionNameTip"
msgid "Name game code uses to query the new action, for example Jump or Move."
msgstr "게임 코드가 새 액션을 조회할 때 쓰는 이름입니다(예: Jump, Move)."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NewActionTypeTip"
msgid "Value the action reports: Boolean for buttons, Axis 1D for a trigger or one axis, Vector 2D for a stick or WASD."
msgstr "액션이 보고하는 값입니다. 버튼은 Boolean, 트리거나 축 하나는 Axis 1D, 스틱이나 WASD 는 Vector 2D 입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NewLayerNameTip"
msgid "Name of the new layer. It must not be in use."
msgstr "새 레이어의 이름입니다. 이미 쓰는 이름은 쓸 수 없습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NoActionsHint"
msgid "This map has no actions yet. Create one in the section below."
msgstr "이 맵에는 아직 액션이 없습니다. 아래 절에서 만듭니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NoBindings"
msgid "No bindings"
msgstr "바인딩 없음"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NoGamepad"
msgid "No Gamepad Connected on Port 0."
msgstr "포트 0에 연결된 게임패드가 없습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.NotRebindableTip"
msgid "This binding kind (axis, stick, mouse delta ...) is not one key - edit the XML"
msgstr "이 바인딩 종류(축, 스틱, 마우스 델타 ...)는 키 하나가 아닙니다. XML 을 직접 편집합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.OverlayAnchorTip"
msgid "Viewport corner the overlay is drawn in."
msgstr "오버레이를 그릴 뷰포트 모서리입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.OverlayEnableTip"
msgid "Draw a live controller display over the game viewport. Useful for recording videos or checking input while playing."
msgstr "게임 뷰포트 위에 실시간 컨트롤러 표시를 그립니다. 영상을 녹화하거나 플레이 중 입력을 확인할 때 유용합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.OverlayHistoryTip"
msgid "List the most recent inputs and triggered actions, as in fighting-game training modes."
msgstr "격투 게임 트레이닝 모드처럼 최근 입력과 발동한 액션을 나열합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.OverlayOpacityTip"
msgid "Overlay opacity, 0.1 (faint) to 1 (solid)."
msgstr "오버레이 불투명도로, 0.1(흐림)에서 1(불투명)까지입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.OverlayScaleTip"
msgid "Overlay size multiplier, 0.5 to 2."
msgstr "오버레이 크기 배율(0.5~2)입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.PatternExample"
msgid "236P = down, down-right, right + punch (the map's command history, 0.8 s window)"
msgstr "236P = 아래, 오른쪽 아래, 오른쪽 + 펀치(맵의 커맨드 기록, 0.8초 창)"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.PatternTip"
msgid "Fighting-game command to test, in numpad directions (2 down, 6 right, 3 down-right ...) followed by a button letter. Perform it on the gamepad or keyboard to see it match."
msgstr "테스트할 격투 게임 커맨드로, 숫자 패드 방향(2 아래, 6 오른쪽, 3 오른쪽 아래 ...) 뒤에 버튼 글자를 붙입니다. 게임패드나 키보드로 입력해 일치하는지 봅니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.PauseGraphTip"
msgid "Freeze the graphs so you can read a past spike."
msgstr "그래프를 멈춰 지나간 튐을 읽을 수 있게 합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.PauseReplayTip"
msgid "Stop playback at the current frame, keeping the input state of that frame."
msgstr "그 프레임의 입력 상태를 유지한 채 현재 프레임에서 재생을 멈춥니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.PlayReplayTip"
msgid "Feed the recorded frames to the engine in place of real devices, starting from the current frame."
msgstr "현재 프레임부터 실제 장치 대신 기록된 프레임을 엔진에 넣습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.RebindThisTip"
msgid "Give this action's binding a different key to resolve the conflict."
msgstr "충돌을 풀려고 이 액션의 바인딩에 다른 키를 지정합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.RebindTip"
msgid "Replace this binding's key: press a key or pick one from the list that opens."
msgstr "이 바인딩의 키를 바꿉니다. 키를 누르거나 열리는 목록에서 고릅니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ReloadTip"
msgid "Read the input map from the path on the left, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 왼쪽 경로의 입력 맵을 읽습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.RemoveBindingTip"
msgid "Remove this binding from the action. Reload brings it back until you save."
msgstr "이 바인딩을 액션에서 지웁니다. 저장하기 전에는 다시 읽기로 되돌릴 수 있습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ReplayFileTip"
msgid "Resource path of the .swreplay file that Save and Load use."
msgstr "Save 와 Load 가 쓰는 .swreplay 파일의 리소스 경로입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ReplayHint"
msgid "Playback attaches the replay as exclusive virtual input: recorded frame n is applied on the n-th input frame."
msgstr "재생은 리플레이를 전용 가상 입력으로 붙입니다. 기록된 n번째 프레임은 n번째 입력 프레임에 적용됩니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ResetActionTip"
msgid "Put this action's bindings back to the ones it was loaded with."
msgstr "이 액션의 바인딩을 읽어 들였을 때의 것으로 되돌립니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.ResetStickTip"
msgid "Return the injected stick to the center."
msgstr "넣은 스틱 입력을 가운데로 되돌립니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.RevertAllTip"
msgid "Put every action back to the bindings it was loaded with."
msgstr "모든 액션을 읽어 들였을 때의 바인딩으로 되돌립니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.RightMotorTip"
msgid "Strength of the right (high-frequency) motor for the test pulse, 0 to 1."
msgstr "테스트 진동에 쓸 오른쪽(고주파) 모터 세기(0~1)입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.SaveReplayTip"
msgid "Write the recorded frames to the replay file."
msgstr "기록한 프레임을 리플레이 파일에 씁니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.SaveTip"
msgid "Write the default bindings to the input map file. Player remaps are stored separately in user settings."
msgstr "기본 바인딩을 입력 맵 파일에 씁니다. 플레이어 리매핑은 사용자 설정에 따로 저장됩니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.SelectActionHint"
msgid "Select an action to edit its bindings and triggers."
msgstr "바인딩과 트리거를 편집할 액션을 선택합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.SimStickXTip"
msgid "Horizontal tilt to inject on gamepad 0's left stick, -1 (left) to 1 (right)."
msgstr "게임패드 0의 왼쪽 스틱에 넣을 가로 기울기로, -1(왼쪽)에서 1(오른쪽)까지입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.SimStickYTip"
msgid "Vertical tilt to inject on gamepad 0's left stick, -1 (down) to 1 (up)."
msgstr "게임패드 0의 왼쪽 스틱에 넣을 세로 기울기로, -1(아래)에서 1(위)까지입니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StartRecordingTip"
msgid "Record every input event, frame by frame, to replay later for bug reproduction or QA. Replaces the current recording."
msgstr "버그 재현이나 QA 에 다시 재생할 수 있도록 모든 입력 이벤트를 프레임 단위로 기록합니다. 지금 기록을 바꿉니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StepBackTip"
msgid "Go back one recorded frame."
msgstr "기록된 프레임 하나만큼 뒤로 갑니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StepForwardTip"
msgid "Apply the next recorded frame."
msgstr "다음 기록 프레임을 적용합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StopRecordingTip"
msgid "Stop recording. The frames stay in memory until you save or record again."
msgstr "기록을 멈춥니다. 프레임은 저장하거나 다시 기록할 때까지 메모리에 남습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StopReplayTip"
msgid "Stop playback and rewind to the first frame."
msgstr "재생을 멈추고 첫 프레임으로 되감습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.StopVibrationTip"
msgid "Stop any vibration on gamepad 0."
msgstr "게임패드 0의 진동을 멈춥니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.TapKeyTip"
msgid "Send a press and a release in the same frame, like a quick tap."
msgstr "누름과 뗌을 같은 프레임에 보내 짧게 한 번 누른 것처럼 합니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.TestPulseTip"
msgid "Vibrate gamepad 0 for 0.3 seconds with the motor strengths on the left."
msgstr "왼쪽의 모터 세기로 게임패드 0을 0.3초 진동시킵니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.TimelineFrameTip"
msgid "Drag to jump to any recorded frame; the input state is rebuilt up to that frame."
msgstr "끌어서 기록된 아무 프레임으로나 건너뜁니다. 입력 상태를 그 프레임까지 다시 만듭니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.TriggerTip"
msgid "When the action fires (Pressed, Hold, Tap, Double Tap ...) - Unreal Enhanced Input triggers"
msgstr "액션이 발동하는 시점입니다(Pressed, Hold, Tap, Double Tap ...). 언리얼 Enhanced Input 의 트리거와 같습니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.UnbindOtherTip"
msgid "Remove the other action's binding so this action keeps the input."
msgstr "이 액션이 입력을 갖도록 다른 액션의 바인딩을 지웁니다."

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.UnsavedChanges"
msgid "* Unsaved changes"
msgstr "* 저장하지 않은 변경"

#: Source/Editor/Panels/InputMap/InputMapPanel.cpp
msgctxt "EditorInputMap.WaitingForInput"
msgid "Waiting for input..."
msgstr "입력을 기다리는 중..."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.AddToFavorites"
msgid "Add to Favorites"
msgstr "즐겨찾기에 추가"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.ApplyInstanceOverrides"
msgid "Save the scene: changes to instance members are written to the anchor as differences; the included scene file stays as it is"
msgstr "씬을 저장합니다. 인스턴스 멤버의 변경은 앵커에 차이로 적히고, 넣은 씬 파일은 그대로입니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.ApplyToPrefab"
msgid "Save this object's changes to the source prefab file"
msgstr "현재 오브젝트의 변경사항을 프리팹 원본 파일에 저장합니다"

#: Source/Editor/Panels/Inspector/InspectorPropertyManager.cpp
msgctxt "EditorInspector.ClearAssetReference"
msgid "Clear asset reference"
msgstr "이 에셋 참조를 비웁니다."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.DiagnosticMethodTag"
msgid "Diagnostic"
msgstr "진단"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.FavoriteProperty"
msgid "Favorite property"
msgstr "즐겨찾기한 프로퍼티"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.FavoritesSection"
msgid "Favorites"
msgstr "즐겨찾기"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.FollowingSelection"
msgid "Following the selection - click to lock to this object"
msgstr "선택을 따라가는 중입니다 - 클릭하면 이 오브젝트에 고정합니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.LockedToObject"
msgid "Locked to this object - click to follow the selection"
msgstr "이 오브젝트에 고정되어 있습니다 - 클릭하면 선택을 따라갑니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.MultipleValues"
msgid "Multiple values"
msgstr "값이 여러 개입니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NetRoleMethodRunsLocally"
msgid "The network role is a declaration only: calling it here runs it in this process, not over the network"
msgstr "네트워크 역할은 선언일 뿐입니다. 여기서 부르면 네트워크가 아니라 이 프로세스에서 실행됩니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NetRoleNotRoutedTag"
msgid "RPC not routed"
msgstr "RPC 전달 안 됨"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NewElementHint"
msgid "new element (Enter)"
msgstr "새 요소 (Enter)"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NewKeyHint"
msgid "new key (Enter)"
msgstr "새 키 (Enter)"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.NoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NoCallInEditorMethods"
msgid "No CallInEditor functions. Turn on Show All Functions in the view options to call the others."
msgstr "CallInEditor 함수가 없습니다. 나머지를 부르려면 보기 옵션에서 모든 함수 보기를 켜세요."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.NoFunctionMethods"
msgid "No FUNCTION() methods."
msgstr "FUNCTION() 메서드가 없습니다."

#: Source/Editor/Panels/Inspector/InspectorPropertyManager.cpp
msgctxt "EditorInspector.NoMatchingAssets"
msgid "No matching assets."
msgstr "맞는 에셋이 없습니다."

