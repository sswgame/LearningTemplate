msgstr "열 넓이"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotFillWeight"
msgid "Fill Weight"
msgstr "채우기 비율"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotGrowHorizontal"
msgid "Grow Horizontal"
msgstr "가로로 커지는 쪽"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotGrowVertical"
msgid "Grow Vertical"
msgstr "세로로 커지는 쪽"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotHeader"
msgid "Slot"
msgstr "슬롯"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotHeightOverride"
msgid "Height Override"
msgstr "높이 덮어쓰기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotHorizontalAlignment"
msgid "Horizontal Alignment"
msgstr "가로 정렬"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotMaxSize"
msgid "Max Size"
msgstr "최대 크기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotMaxSizeTip"
msgid "0 means unbounded"
msgstr "0 은 제한 없음"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotMinSize"
msgid "Min Size"
msgstr "최소 크기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotOffsetMax"
msgid "Offset Max"
msgstr "오프셋 최대"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotOffsetMin"
msgid "Offset Min"
msgstr "오프셋 최소"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotOverrideTip"
msgid "0 means none"
msgstr "0 은 덮어쓰지 않음"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotPadding"
msgid "Padding"
msgstr "여백"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotPaddingTip"
msgid "Left, top, right, bottom (UI units)"
msgstr "왼쪽, 위, 오른쪽, 아래(UI 단위)"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotRow"
msgid "Row"
msgstr "행"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotRowSpan"
msgid "Row Span"
msgstr "행 넓이"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotSizeRule"
msgid "Size Rule"
msgstr "크기 규칙"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotSizeRuleTip"
msgid "Auto takes the desired size on the main axis; Fill shares the rest by fill weight."
msgstr "Auto 는 주축에서 원하는 크기를 쓰고, Fill 은 남은 자리를 채우기 비율로 나눕니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotVerticalAlignment"
msgid "Vertical Alignment"
msgstr "세로 정렬"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotWidthOverride"
msgid "Width Override"
msgstr "너비 덮어쓰기"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.SlotZOrder"
msgid "Z Order"
msgstr "Z 순서"

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.TextScaleTip"
msgid "Player text size setting to simulate, 0.75 to 2. Use it to find labels that overflow."
msgstr "흉내 낼 플레이어 글자 크기 설정(0.75~2)입니다. 넘치는 라벨을 찾을 때 씁니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.ThemeTip"
msgid "UI theme to preview with. (game theme) uses the theme the game selects."
msgstr "미리보기에 쓸 UI 테마입니다. (game theme) 은 게임이 고른 테마를 씁니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.UINotRunning"
msgid "Runtime UI is not running."
msgstr "런타임 UI 가 돌고 있지 않습니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.UIScaleTip"
msgid "Player UI scale setting to simulate, 0.5 to 2."
msgstr "흉내 낼 플레이어 UI 배율 설정(0.5~2)입니다."

#: Source/Editor/Panels/UIPreview/UIPreviewPanel.cpp
msgctxt "EditorUIPreview.WaitingForTexture"
msgid "Waiting for the render thread to create the preview texture..."
msgstr "렌더 스레드가 미리보기 텍스처를 만들기를 기다리는 중..."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.AlwaysLoadedTip"
msgid "Select the entities the cook keeps in the base list (always loaded, or without a position)."
msgstr "쿠킹이 기본 목록에 두는 엔티티(늘 올라 있거나 자리가 없는 것)를 고릅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.CookedScene"
msgid "This scene was built from a cooked file and is already split into cells. Open the scene file to preview the split."
msgstr "이 씬은 쿠킹본에서 지어져 이미 셀로 나뉘어 있습니다. 나눔을 미리 보려면 씬 파일을 엽니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoActiveScene"
msgid "No active scene."
msgstr "활성 씬이 없습니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoGameCamera"
msgid "No game camera - the load and unload column needs one."
msgstr "게임 카메라가 없습니다 - 올림 · 내림 열은 게임 카메라가 있어야 합니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NoPreview"
msgid "Press Preview Split to split the scene into cells as the cook would."
msgstr "Preview Split 을 눌러 쿠킹처럼 씬을 셀로 나눠 봅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.NotStreaming"
msgid "The active scene does not stream. Turn on streaming in its World Settings to split it into cells."
msgstr "활성 씬은 스트리밍하지 않습니다. 셀로 나누려면 월드 설정에서 스트리밍을 켭니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.PreviewTip"
msgid "Split the scene into cells exactly as the scene cook does, and list the cells or the references that would fail the cook. Same as 'world.cells'."
msgstr "씬 쿠킹과 똑같이 씬을 셀로 나눠 셀 목록이나 쿠킹을 실패시킬 참조를 보입니다. 'world.cells' 와 같습니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.SplitFailed"
msgid "The scene could not be split - see the log."
msgstr "씬을 나누지 못했습니다 - 로그를 봅니다."

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.ViolationHeader"
msgid "Cross-cell references that fail the cook:"
msgstr "쿠킹을 실패시키는 셀을 넘는 참조:"

#: Source/Editor/Panels/Scene/StreamingCellsPanel.cpp
msgctxt "EditorStreamingCells.ViolationTip"
msgid "Selects both objects. Mark the target always loaded or move it into the same cell."
msgstr "두 오브젝트를 고릅니다. 대상을 늘 올라 있게 표시하거나 같은 셀로 옮깁니다."
