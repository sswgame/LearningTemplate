msgid "Move the selected key track one row down."
msgstr "고른 키 트랙을 한 줄 아래로 옮깁니다."

#: Source/Editor/Panels/Animation/SequencerPanel.cpp
msgctxt "EditorSequencer.MoveTrackUp"
msgid "Move up"
msgstr "위로 옮기기"

