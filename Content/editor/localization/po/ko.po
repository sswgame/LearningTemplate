msgid "Col"
msgstr "충돌"

#: Source/Editor/Viewport/Visualizers/BoxCollider2DVisualizer.cpp
msgctxt "EdVisualizer.BoxCollider2DTip"
msgid "Shows BoxCollider2D rectangles as wireframe"
msgstr "BoxCollider2D 사각형을 와이어프레임으로 표시합니다"

#: Source/Editor/Viewport/Visualizers/CameraFrustumVisualizer.cpp
msgctxt "EdVisualizer.CameraFrustumLabel"
msgid "Cam"
msgstr "카메라"

#: Source/Editor/Viewport/Visualizers/CameraFrustumVisualizer.cpp
