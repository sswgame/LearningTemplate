msgid "Remove from Favorites"
msgstr "즐겨찾기에서 제거"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorInspector.ResetToDefaultTooltip"
msgid "Reset to the default value"
msgstr "기본값으로 되돌립니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.RevertToPrefab"
msgid "Revert this object to the contents of the source prefab file"
msgstr "프리팹 원본 파일의 내용으로 현재 오브젝트를 되돌립니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.SceneInstance"
msgid "This object is part of another scene placed in this one"
msgstr "다른 씬을 이 씬에 넣은 인스턴스의 일부입니다"

#: Source/Editor/Panels/Inspector/InspectorPropertyManager.cpp
msgctxt "EditorInspector.SearchAssetsHint"
msgid "Search assets..."
msgstr "에셋 검색..."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorInspector.SearchPropertiesHint"
msgid "Search properties..."
msgstr "프로퍼티 검색..."

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.SearchTooltip"
msgid "Filter by property and component name"
msgstr "프로퍼티 및 컴포넌트 이름을 검색하여 필터링합니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.SelectionGone"
msgid "Selected object no longer exists."
msgstr "선택한 오브젝트가 더 이상 없습니다."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.ShowAllFunctionsTooltip"
msgid "Diagnostic view: also list FUNCTIONs without CallInEditor. They declare no editor safety, so the default list hides them"
msgstr "진단 보기: CallInEditor 가 없는 FUNCTION 도 보입니다. 에디터 안전을 선언하지 않았으므로 기본 목록에서는 숨깁니다"

#: Source/Editor/Panels/Inspector/InspectorPropertyManager.cpp
msgctxt "EditorInspector.ShowInContentBrowser"
msgid "Show in the Content Browser"
msgstr "콘텐츠 브라우저에서 보여 줍니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.TransientProperty"
msgid "Transient property: not saved to disk"
msgstr "Transient 프로퍼티: 디스크에 저장하지 않습니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.UnlinkPrefab"
msgid "Break the link to the prefab and turn this into a standalone object"
msgstr "프리팹과의 연결을 끊고 독립된 일반 오브젝트로 변환합니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.Unparent"
msgid "Detach from the parent object and move to the scene root"
msgstr "부모 오브젝트와의 연결을 해제하고 씬 루트로 이동합니다"

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
msgctxt "EditorInspector.ViewOptions"
msgid "View options: show only modified properties, expand or collapse all sections"
msgstr "보기 옵션: 바뀐 프로퍼티만 보기, 모든 영역 펼치기 또는 접기"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.CheckMap"
msgid "Validate every object of the active scene again"
msgstr "활성 씬의 모든 오브젝트를 다시 검증합니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.FixAllTooltip"
msgid "Apply every safe fix in the visible rows as one undo step. Rows without a Fix button need a hand fix"
msgstr "보이는 줄의 안전한 고침을 모두 한 번의 실행 취소 단계로 적용합니다. 고치기 버튼이 없는 줄은 손으로 고쳐야 합니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.NoIssues"
msgid "No validation issues. Check Map validates every object of the active scene."
msgstr "검증 문제가 없습니다. Check Map 은 활성 씬의 모든 오브젝트를 검증합니다."

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.NotInActiveScene"
msgid "This object is not in the active scene"
msgstr "이 오브젝트는 활성 씬에 없습니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.SceneIssuesToast"
msgid "{errorCount} error(s), {warningCount} warning(s). Open Map Check from the status bar."
msgstr "오류 {errorCount}개, 경고 {warningCount}개가 있습니다. 상태줄에서 Map Check 를 여세요."

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.SearchHint"
msgid "Search"
msgstr "검색"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.ShowErrors"
msgid "Show error rows"
msgstr "오류 줄을 보입니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.ShowWarnings"
msgid "Show warning rows"
msgstr "경고 줄을 보입니다"

#: Source/Editor/Panels/MapCheck/MapCheckPanel.cpp
msgctxt "EditorMapCheck.StatusTooltip"
msgid "Map Check: {errorCount} error(s), {warningCount} warning(s)"
msgstr "Map Check: 오류 {errorCount}개, 경고 {warningCount}개"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ApplyToSelectionTip"
msgid "Show the edited material on the selected object in the viewport without saving, to judge it with the real shader and lighting."
msgstr "저장하지 않고 편집한 머티리얼을 뷰포트의 선택한 오브젝트에 입혀, 실제 셰이더와 라이팅으로 판단할 수 있게 합니다."

#: Source/Editor/Panels/Material/Model/MaterialModel.cpp
msgctxt "EditorMaterial.LoadFailedStatus"
msgid "Load failed - saving is disabled so the file is not overwritten"
msgstr "읽기 실패 - 파일을 덮어쓰지 않도록 저장을 막았습니다"

#: Source/Editor/Panels/Material/Model/MaterialModel.cpp
msgctxt "EditorMaterial.LoadedStatus"
msgid "Loaded"
msgstr "읽음"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.NameTip"
msgid "Display name stored in the material file."
msgstr "머티리얼 파일에 저장되는 표시 이름입니다."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.OpenMaterialHint"
msgid "Open a material (Open..., Quick Open or a Content Browser double-click) to edit."
msgstr "편집할 머티리얼을 엽니다(Open..., Quick Open 또는 콘텐츠 브라우저에서 더블클릭)."

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.PreviewTip"
msgid "Preview computed from the material values (base color, roughness, metallic, emissive). It does not run the shader code - use Apply to Selection to check it in the scene."
msgstr "머티리얼 값(기본색 · 거칠기 · 금속성 · 방출)으로 셈한 미리보기입니다. 셰이더 코드는 반영하지 않습니다 — Apply to Selection 으로 씬에서 확인합니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ReloadTip"
msgid "Read the material from disk again, discarding unsaved edits."
msgstr "저장하지 않은 편집을 버리고 디스크에서 머티리얼을 다시 읽습니다."

#: Source/Editor/Panels/Material/Model/MaterialModel.cpp
msgctxt "EditorMaterial.SaveFailedStatus"
msgid "Save failed"
msgstr "저장하지 못했습니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.SaveTip"
msgid "Write the material file and reload it in the running scene."
msgstr "머티리얼 파일을 쓰고 실행 중인 씬에서 다시 읽습니다."

#: Source/Editor/Panels/Material/Model/MaterialModel.cpp
msgctxt "EditorMaterial.SavedStatus"
msgid "Saved"
msgstr "저장했습니다"

#: Source/Editor/Panels/Material/MaterialPanel.cpp
msgctxt "EditorMaterial.ShaderTip"
msgid "HLSL shader this material renders with. Drop a .hlsl file here or pick one from the Content Browser."
msgstr "이 머티리얼이 렌더링에 쓰는 HLSL 셰이더입니다. .hlsl 파일을 여기에 놓거나 콘텐츠 브라우저에서 고릅니다."

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.AssetSlot"
msgid "Asset"
msgstr "에셋"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.CanvasFailed"
msgid "The node canvas could not be drawn"
msgstr "노드 캔버스를 그리지 못했습니다"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.CompiledStatus"
msgid "Compiled - no problems"
msgstr "컴파일됨 - 문제 없음"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.NoGraph"
msgid "Open a material graph (.matgraph.xml) to edit it"
msgstr "편집할 머티리얼 그래프(.matgraph.xml)를 여세요"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.ReloadTip"
msgid "Reload the graph from its file, discarding unsaved edits"
msgstr "파일에서 그래프를 다시 읽습니다. 저장하지 않은 편집은 버립니다"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.SaveTip"
msgid "Save the graph if it compiles; the generated shader and material follow"
msgstr "컴파일되면 그래프를 저장합니다. 생성된 셰이더와 머티리얼이 뒤따릅니다"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.SelectNodeHint"
msgid "Select a node to edit its values"
msgstr "값을 고칠 노드를 고르세요"

#: Source/Editor/Panels/MaterialGraph/MaterialGraphPanel.cpp
msgctxt "EditorMaterialGraph.SubgraphStatus"
msgid "Subgraph - it compiles inside the graphs that use it"
msgstr "하위 그래프 - 쓰는 그래프 안에서 컴파일됩니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ArrangeWindows"
msgid "Place the client windows side by side (window size and position per App process) instead of letting them overlap"
msgstr "클라이언트 창을 겹치지 않게 나란히 놓습니다(App 프로세스마다 창 크기와 위치를 줍니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ArrangeWindowsLabel"
msgid "Arrange windows"
msgstr "창 배치"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ClientArgumentsHint"
msgid "client arguments (e.g. -vk)"
msgstr "클라이언트 인자 (예: -vk)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsApplyToAll"
msgid "Send each change to every process of the session instead of the selected one"
msgstr "고른 프로세스 대신 세션의 모든 프로세스에 보냅니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsBandwidth"
msgid "Line speed in KB/s (0 = unlimited)"
msgstr "회선 속도(KB/s, 0 = 제한 없음)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsDisconnect"
msgid "Drop every connection of the selected process (a client stays disconnected until Reconnect)"
msgstr "고른 프로세스의 연결을 모두 끊습니다(클라이언트는 Reconnect 까지 끊긴 채로 남습니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsDown"
msgid "Packets this process receives"
msgstr "이 프로세스가 받는 패킷입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsNoSession"
msgid "Start a multiplayer session (Session tab) to change its line conditions."
msgstr "회선 조건을 바꾸려면 멀티플레이 세션을 시작하세요(Session 탭)."

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsNoStats"
msgid "No stats yet - press Refresh stats"
msgstr "아직 수치가 없습니다 - Refresh stats 를 누르세요"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsPreset"
msgid "Set both directions of the selected process to a line preset"
msgstr "고른 프로세스의 두 방향을 회선 프리셋으로 둡니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsReconnect"
msgid "Connect a disconnected client to the server again"
msgstr "끊긴 클라이언트를 서버에 다시 붙입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsRefreshStats"
msgid "Ask the selected process for its line and connection numbers"
msgstr "고른 프로세스에 회선 · 연결 수치를 묻습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsSpike"
msgid "Drop everything the selected process sends and receives for this many seconds"
msgstr "고른 프로세스가 보내고 받는 것을 이 시간(초) 동안 모두 버립니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerConditionsTab.cpp
msgctxt "EditorMultiplayer.ConditionsUp"
msgid "Packets this process sends (client to server for a client)"
msgstr "이 프로세스가 보내는 패킷입니다(클라이언트면 클라이언트 → 서버)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.DeletePreset"
msgid "Delete the selected preset from your preset file"
msgstr "고른 프리셋을 프리셋 파일에서 지웁니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.FollowLog"
msgid "Keep scrolling to the newest log line"
msgstr "가장 최근 로그 줄을 따라 스크롤합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorAttach"
msgid "Attach to a server that is already running: its debug channel address (127.0.0.1:port) and token, as given with -gv_debugChannelPort and -gv_debugChannelToken"
msgstr "이미 돌고 있는 서버에 붙습니다. -gv_debugChannelPort · -gv_debugChannelToken 으로 준 디버그 채널 주소(127.0.0.1:포트)와 토큰을 넣습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorConsoleHint"
msgid "Dev command for the server (help lists them, Tab completes the name)"
msgstr "서버에 보낼 개발 명령(help 가 목록을 보이고, Tab 이 이름을 채웁니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorNoChannel"
msgid "The Inspector reads a dedicated server through its debug channel. Start a Dedicated Server session, or attach by address"
msgstr "인스펙터는 전용 서버를 디버그 채널로 읽습니다. 전용 서버 세션을 시작하거나 주소로 붙으세요"

#: Source/Editor/Panels/Multiplayer/MultiplayerInspectorTab.cpp
msgctxt "EditorMultiplayer.InspectorRefresh"
msgid "Read the server's hierarchy again (scene.tree). Click a name to read its component values (object.dump) - this works while the server is paused"
msgstr "서버의 계층을 다시 읽습니다(scene.tree). 이름을 누르면 그 컴포넌트 값을 읽습니다(object.dump) - 서버가 일시 정지 중이어도 됩니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.LogSource"
msgid "Show the log of one process or of every process"
msgstr "한 프로세스 또는 모든 프로세스의 로그를 보입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.NoProcesses"
msgid "No processes - pick a Net Mode and press Play (toolbar or here)."
msgstr "프로세스가 없습니다 - Net Mode 를 고르고 Play 를 누르세요(툴바 또는 여기)."

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.PauseServer"
msgid "Pause the dedicated server's game tick"
msgstr "전용 서버의 게임 틱을 멈춥니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Play"
msgid "Start the server and clients for the selected Net Mode"
msgstr "고른 Net Mode 로 서버와 클라이언트를 시작합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Preset"
msgid "Saved multiplayer setups (Saved/Editor/NetPlayPresets.json, not committed). Picking one replaces the setup below and is restored when the editor starts"
msgstr "저장한 멀티플레이 구성입니다(Saved/Editor/NetPlayPresets.json, 커밋하지 않음). 고르면 아래 구성을 바꾸고, 에디터를 다시 띄우면 돌아옵니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.PresetNameHint"
msgid "preset name"
msgstr "프리셋 이름"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerClear"
msgid "Forget the collected history"
msgstr "모은 기록을 지웁니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKinds"
msgid "Received messages by kind"
msgstr "받은 메시지 종류별 비중"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKindsAllProcesses"
msgid "Add up the message kinds every process received instead of only the selected one"
msgstr "고른 프로세스 대신 모든 프로세스가 받은 메시지 종류를 합쳐 봅니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerKindsSent"
msgid "Show the message kinds the process queued to send instead of the ones it received (one process shows both directions)"
msgstr "받은 메시지 종류 대신 프로세스가 보내려고 쌓은 종류를 보입니다(한 프로세스가 두 방향을 모두 보입니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerLoss"
msgid "Packet loss (highest connection, %)"
msgstr "패킷 손실 (가장 큰 연결, %)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoKinds"
msgid "No messages received yet"
msgstr "아직 받은 메시지가 없습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoReplicas"
msgid "The process reports no replication counters (a replication kit raises them with GameNetSession::setReplicaStats)"
msgstr "프로세스가 복제 셈을 보고하지 않습니다(복제 키트가 GameNetSession::setReplicaStats 로 올립니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerNoSession"
msgid "Start a multiplayer session (Net Mode on the toolbar) to see its traffic"
msgstr "멀티플레이 세션을 시작하면(툴바의 Net Mode) 트래픽이 보입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReceivedBytes"
msgid "Received bytes per second (last second, all connections)"
msgstr "받은 바이트 / 초 (최근 1 초, 모든 연결)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReceivedPackets"
msgid "Received packets per second"
msgstr "받은 패킷 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerRecordHidden"
msgid "Keep asking the processes for net.stats while another tab is shown (off by default - every child process logs a line at 2 Hz)"
msgstr "다른 탭을 보는 동안에도 프로세스에 net.stats 를 계속 묻습니다(기본은 꺼짐 — 자식 프로세스마다 2 Hz 로 로그를 한 줄씩 남깁니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReplicas"
msgid "Replication by name (per second)"
msgstr "이름별 복제 (초당)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerReplicasHelp"
msgid "Updates and bytes a replication kit counted per second, from the difference of the last two net.stats reports; the share is of the listed bytes"
msgstr "복제 키트가 센 갱신 수와 바이트를 마지막 두 net.stats 보고의 차로 초당 값으로 보입니다. 비율은 표에 나온 바이트에 대한 몫입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerResent"
msgid "Reliable messages resent per second"
msgstr "다시 보낸 신뢰 메시지 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerRtt"
msgid "Round-trip time (highest connection, ms)"
msgstr "RTT (가장 큰 연결, ms)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSentBytes"
msgid "Sent bytes per second (last second, all connections)"
msgstr "보낸 바이트 / 초 (최근 1 초, 모든 연결)"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSentPackets"
msgid "Sent packets per second"
msgstr "보낸 패킷 / 초"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerSource"
msgid "Numbers the process already counts (connection stats, message kinds), asked with net.stats every 0.5 s while this tab is shown"
msgstr "프로세스가 이미 세는 값(연결 통계, 메시지 종류)을 이 탭이 보이는 동안 0.5 초마다 net.stats 로 묻습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerProfilerTab.cpp
msgctxt "EditorMultiplayer.ProfilerWaiting"
msgid "Waiting for the first net.stats report from this process"
msgstr "이 프로세스의 첫 net.stats 보고를 기다리는 중입니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.RecordTraces"
msgid "Record a timeline per process and merge them into one file (merged.trace.json) on Stop - open it with Load Trace in the Profiler window or with Perfetto"
msgstr "프로세스마다 타임라인을 기록해 Stop 때 한 파일(merged.trace.json)로 합칩니다 — Profiler 창 Load Trace · Perfetto 로 엽니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.ResumeServer"
msgid "Resume the paused server's game tick"
msgstr "멈춘 서버의 게임 틱을 다시 돌립니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.SavePreset"
msgid "Save the setup below under the typed name (empty: overwrite the selected preset)"
msgstr "아래 구성을 적은 이름으로 저장합니다(비우면 고른 프리셋을 덮습니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.StepServer"
msgid "Run the server game tick as many times as the field on the left says, then pause again (dedicated server Dev command step N)"
msgstr "서버 게임 틱을 왼쪽 칸의 수만큼 돌리고 다시 멈춥니다 (전용 서버 Dev 명령 step N)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.StepTickCount"
msgid "Number of server ticks that Step runs (1 or more)"
msgstr "Step 이 돌릴 서버 틱 수입니다(1 이상)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.Stop"
msgid "Stop every process and merge the recorded traces"
msgstr "모든 프로세스를 멈추고 기록한 트레이스를 합칩니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncChannel"
msgid "Which state hash line the buttons read: scene (transforms), or a kit's line - destruction, rollback (state.hashnames lists what the process registered)"
msgstr "단추가 읽을 상태 해시 줄: 씬(변환) 또는 키트의 줄 — 파괴 · 롤백(프로세스가 등록한 것은 state.hashnames 가 보여 줍니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncClient"
msgid "Read this client's state hash history (the latest ticks it recorded under the server tick numbers)"
msgstr "이 클라이언트의 상태 해시 기록을 읽습니다(서버 틱 번호로 기록한 최근 틱)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncCompare"
msgid "Find the earliest tick both histories hold with different state hashes (scene transforms: name, active, world position)"
msgstr "두 기록이 모두 가진 틱 가운데 상태 해시가 다른 가장 이른 틱을 찾습니다(씬 트랜스폼: 이름, 활성, 월드 위치)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncFile"
msgid "Load a saved history, or save this one in the same format (<tick> <hex hash> per line)"
msgstr "저장한 기록을 불러오거나, 이 기록을 같은 형식(줄마다 <틱> <16진 해시>)으로 저장합니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncObjects"
msgid "Ask both slots (a server read over a debug channel, or a session client) for their current per-object hashes and list the objects that differ (pause the server near the divergent tick first; the two answers must carry the same tick)"
msgstr "두 칸(디버그 채널로 읽은 서버, 또는 세션 클라이언트)에 지금의 오브젝트별 해시를 물어 다른 오브젝트를 나열합니다(어긋난 틱 가까이에서 서버를 먼저 멈춥니다. 두 답은 같은 틱이어야 합니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncReadServer"
msgid "Read the history of another server through its debug channel (it must run with -gv_stateHashHistory)"
msgstr "다른 서버의 기록을 디버그 채널로 읽습니다(그 서버는 -gv_stateHashHistory 로 돌아야 합니다)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSyncTab.cpp
msgctxt "EditorMultiplayer.SyncSessionServer"
msgid "Read the per-tick state hash history of the dedicated server this session started"
msgstr "이 세션이 시작한 전용 서버의 틱별 상태 해시 기록을 읽습니다"

#: Source/Editor/Panels/Multiplayer/MultiplayerPanel.cpp
msgctxt "EditorMultiplayer.Target"
msgid "Process the tabs act on: the server or one client"
msgstr "탭이 다루는 프로세스입니다(서버 또는 클라이언트 하나)"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.WindowColumns"
msgid "Windows per row before the next row starts"
msgstr "다음 줄로 넘어가기 전에 한 줄에 놓는 창 수"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.WindowColumnsLabel"
msgid "Columns"
msgstr "열"

#: Source/Editor/Panels/Multiplayer/MultiplayerSessionTab.cpp
msgctxt "EditorMultiplayer.WindowSize"
msgid "Client area size of each App window (pixels)"
msgstr "App 창마다의 클라이언트 영역 크기(픽셀)"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Game"
msgid "Game to package"
msgstr "패키징할 게임입니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.OpenFolder"
msgid "Open the output folder of the last successful package in the file explorer"
msgstr "마지막으로 성공한 패키지의 출력 폴더를 파일 탐색기에서 엽니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.OutputFolder"
msgid "Folder the packaged build is staged into"
msgstr "패키지 빌드를 스테이징할 폴더입니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Package"
msgid "Configure, build, cook and stage the selected game into the output folder"
msgstr "고른 게임을 구성 · 빌드 · 쿠킹해 출력 폴더에 스테이징합니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.RHIBackend"
msgid "Backend that Shipping links statically (client only). The server does not render"
msgstr "Shipping 이 정적으로 링크할 백엔드입니다(클라이언트만). 서버는 그리지 않는다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.SkipBuild"
msgid "Skip configure and build, and stage this editor's Bin"
msgstr "구성 · 빌드를 건너뛰고 이 에디터의 Bin 을 스테이징합니다"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.SkipCook"
msgid "Skip cooking the resource packs (a build cooks them itself)"
msgstr "리소스 팩 쿠킹을 건너뜁니다(빌드를 하면 빌드가 쿠킹한다)"

#: Source/Editor/Panels/Packaging/PackagingPanel.cpp
msgctxt "EditorPackaging.Target"
msgid "Package the client (game) or the dedicated server"
msgstr "클라이언트(게임) 또는 전용 서버를 패키징합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.CallTreeRecord"
msgid "The call tree folds the timeline recording (same recording as the Timeline tab)"
msgstr "호출 트리는 타임라인 녹화를 접어 보여 줍니다(Timeline 탭과 같은 녹화)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.FilterScopesHint"
msgid "Filter scopes..."
msgstr "스코프 필터..."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.FindScopeHint"
msgid "Find scope..."
msgstr "스코프 찾기..."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.Fit"
msgid "Reset the zoom so the recorded frames fit the view"
msgstr "확대를 되돌려 기록한 프레임을 화면에 맞춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.Freeze"
msgid "Keep recording but stop updating the view"
msgstr "기록은 계속하고 화면 갱신만 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.LoadCapture"
msgid "Open Saved/Profiler/ProfilerCapture.txt (pauses live capture)"
msgstr "Saved/Profiler/ProfilerCapture.txt 를 엽니다(실시간 캡처를 멈춥니다)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.LoadTrace"
msgid "Load the newest Saved/Traces/*.trace.json under the live threads (first times aligned) - a failing run next to a healthy one"
msgstr "가장 최근 Saved/Traces/*.trace.json 을 실시간 스레드 아래에 불러옵니다(첫 시각 정렬) - 실패한 실행을 정상 실행 옆에 놓고 봅니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.MemoryProfilerInactive"
msgid "MemoryProfiler is not active."
msgstr "MemoryProfiler 가 동작하지 않습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoActiveScene"
msgid "No active scene loaded."
msgstr "불러온 활성 씬이 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoComponents"
msgid "No components in the active scene."
msgstr "활성 씬에 컴포넌트가 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.NoRHIDevice"
msgid "No RHI device."
msgstr "RHI 디바이스가 없습니다."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.PauseOnSpike"
msgid "Pause capturing automatically on a frame slower than the threshold on the right"
msgstr "오른쪽 임계값보다 느린 프레임에서 캡처를 자동으로 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocCapture"
msgid "Capture the next frame with RenderDoc"
msgstr "다음 프레임을 RenderDoc 으로 캡처합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocNotAttached"
msgid "RenderDoc is not attached to this process - start with -renderdoc or launch from RenderDoc"
msgstr "RenderDoc 이 이 프로세스에 붙어 있지 않습니다. -renderdoc 으로 시작하거나 RenderDoc 에서 실행하십시오."

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.RenderDocOpenUI"
msgid "Open the RenderDoc replay UI to inspect captures"
msgstr "캡처를 살펴볼 RenderDoc 재생 UI 를 엽니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.ResumeCapture"
msgid "Capturing is paused (a spike or an opened capture) - resume live capture"
msgstr "캡처가 멈춰 있습니다(스파이크 또는 연 캡처) - 실시간 캡처를 다시 시작합니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SaveCapture"
msgid "Save the captured window to Saved/Profiler/ProfilerCapture.txt (long captures: Tracy)"
msgstr "캡처한 구간을 Saved/Profiler/ProfilerCapture.txt 로 저장합니다(긴 캡처는 Tracy)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SaveTrace"
msgid "Save the frames shown as Saved/Traces/trace_<time>.trace.json (Chrome Trace Event - open in Perfetto UI or chrome://tracing)"
msgstr "보이는 프레임을 Saved/Traces/trace_<시각>.trace.json 으로 저장합니다(Chrome Trace Event - Perfetto UI 나 chrome://tracing 에서 엽니다)"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.SpikeThreshold"
msgid "GT.Frame above this pauses capturing (and a running play session) on that frame"
msgstr "GT.Frame 이 이 값을 넘으면 그 프레임에서 캡처(와 실행 중인 플레이 세션)를 멈춥니다"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.TimelineRecord"
msgid "Record profile scopes per thread into a ring (8192 events per thread) - only while recording"
msgstr "스레드마다 프로파일 스코프를 링 버퍼(스레드당 이벤트 8192 개)에 기록합니다 - 녹화 중에만"

#: Source/Editor/Panels/Profiler/ProfilerPanel.cpp
msgctxt "EditorProfiler.UnloadTrace"
msgid "Remove the loaded trace from the timeline"
msgstr "불러온 트레이스를 타임라인에서 뺍니다"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.AutoRangeTip"
msgid "Stretch the depth values present in the image to the full black-to-white range."
msgstr "이미지에 있는 깊이 값을 검정에서 흰색까지 전체 범위로 늘립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.AutoRefreshTip"
msgid "Refresh the snapshot every 30 editor frames. Costs a GPU wait each time."
msgstr "에디터 30프레임마다 스냅샷을 새로 읽습니다. 읽을 때마다 GPU 를 기다립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ChannelTip"
msgid "Show all channels, or one channel as grayscale. RGBA shows the live GPU texture; a single channel uses the CPU snapshot."
msgstr "모든 채널을 보거나 한 채널을 회색조로 봅니다. RGBA 는 실시간 GPU 텍스처를, 한 채널은 CPU 스냅샷을 씁니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.Consumers"
msgid "Read by: {passes}"
msgstr "읽는 패스: {passes}"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.DepthLabel"
msgid "depth"
msgstr "깊이"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.FormatNotReadable"
msgid "This format cannot be read back."
msgstr "이 포맷은 다시 읽어 올 수 없습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.Lifetime"
msgid "Used from pass {firstPass} to pass {lastPass} (pipeline order)"
msgstr "패스 {firstPass} 부터 {lastPass} 까지 쓰입니다(파이프라인 순서)"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.LinearLabel"
msgid "linear"
msgstr "선형"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.LinearizeTip"
msgid "Convert stored depth back to view distance using Near/Far. Perspective depth crowds near 1, so the raw image looks almost white."
msgstr "Near/Far 로 저장된 깊이를 뷰 거리로 되돌립니다. 원근 깊이는 1 근처에 몰려 있어 그대로 보면 거의 흰색입니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NearFarTip"
msgid "Near and far clip planes of the camera that rendered the depth, in world units. Match them to that camera for correct distances."
msgstr "깊이를 렌더링한 카메라의 근평면과 원평면(월드 단위)입니다. 정확한 거리를 보려면 그 카메라에 맞춥니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NoFilterMatch"
msgid "No target matches the filter."
msgstr "필터에 맞는 타깃이 없습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.NoTargets"
msgid "Renderer has not published any targets yet."
msgstr "렌더러가 아직 타깃을 공개하지 않았습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.PickTargetHint"
msgid "Pick a render target on the left."
msgstr "왼쪽에서 렌더 타깃을 고릅니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.Producers"
msgid "Written by: {passes}"
msgstr "쓰는 패스: {passes}"

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ReadingTarget"
msgid "Reading the target..."
msgstr "타깃을 읽는 중..."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.RefreshTip"
msgid "Read the selected target back to the CPU again. Channel views, depth views and pixel values use this snapshot; reading waits for the GPU."
msgstr "선택한 타깃을 CPU 로 다시 읽어 옵니다. 채널 보기, 깊이 보기, 픽셀 값은 이 스냅샷을 쓰며, 읽는 동안 GPU 를 기다립니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.RegisterFailed"
msgid "Could not register this target as an ImGui texture."
msgstr "이 타깃을 ImGui 텍스처로 등록하지 못했습니다."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.SearchHint"
msgid "Search render targets..."
msgstr "렌더 타깃 검색..."

#: Source/Editor/Panels/RenderTarget/RenderTargetPanel.cpp
msgctxt "EditorRenderTarget.ZoomTip"
msgid "Preview scale, 0 to 2. At 0 the image fits the panel; set 1 to inspect pixels at native resolution."
msgstr "미리보기 배율(0~2)입니다. 0이면 패널에 맞추고, 원본 해상도로 픽셀을 보려면 1로 둡니다."

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.BoneMarkersTip"
msgid "Draw the bones written by the selected node in the viewport"
msgstr "고른 노드가 쓰는 본을 뷰포트에 표시합니다"

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.RigNotReady"
msgid "The rig is not bound yet (check the rig asset and skeleton)"
msgstr "리그가 아직 바인딩되지 않았습니다(리그 에셋과 스켈레톤을 확인하세요)"

#: Source/Editor/Panels/Animation/RigDebugPanel.cpp
msgctxt "EditorRigDebug.SelectRig"
msgid "Select an object with a Pose Modifier component"
msgstr "Pose Modifier 컴포넌트가 있는 오브젝트를 고르세요"

#: Source/Editor/Panels/Scene/PrefabPanel.cpp
msgctxt "EditorScene.ApplyAllOverrides"
msgid "Write every override of this instance back to the prefab template"
