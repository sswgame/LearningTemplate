#: Source/Editor/Viewport/EditorViewportToolbar.cpp
msgctxt "EdCommon.AlignSelected"
msgid "Align and distribute the selected objects (select two or more)."
msgstr "선택한 오브젝트를 정렬하고 분배합니다(둘 이상 선택)."

#: Source/Editor/Common/Widgets/EditorWidgets.cpp
