msgid "This is a prefab instance"
msgstr "프리팹 인스턴스입니다"

#: Source/Editor/Panels/Inspector/InspectorPanel.cpp
msgctxt "EditorInspector.PresetNameHint"
msgid "Preset Name..."
msgstr "프리셋 이름..."

#: Source/Editor/Panels/Inspector/EditorPropertyGrid.cpp
