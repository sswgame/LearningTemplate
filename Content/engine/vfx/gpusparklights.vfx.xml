<?xml version="1.0" encoding="utf-8"?>
<!-- 엔진 표본 효과 — 바닥에 튀는 빛나는 불똥(GPU 시뮬레이션, 깊이 충돌 + 파티클 라이트). 깊이 충돌(SceneDepth)이 GPU 전용이라 모든 빌드에서 GPU 로 돈다.
     파티클 라이트(_light)는 GPU 방출기의 빛이다 — 시뮬레이션 컴퓨트가 라이트 버퍼의 GPU 구간에 쓰고 GPU 라이트 그리드가 받는다(결정 기록 5-5 L3 · L5).
     불똥 그림 자체는 일부러 아주 작다(0.02) — 시나리오 game/empty/automation/vfxgpulights 가 바닥의 밝기 변화로 빛을 본다. -->
<VFXEffectDef>
	<_listEmitter>
		<VFXEmitterDef _name="LitEmbers" _texturePath="engine/textures/particles/kenney_particle/circle_05.dds" _blendMode="Additive" _bLooping="true"
		               _maxParticles="256" _duration="1" _spawnRate="120" _lifetimeMin="1.5" _lifetimeMax="2"
		               _velocityMin="-1, 1, -1" _velocityMax="1, 3, 1" _gravity="0, -9.8, 0">
			<_sizeOverLife><_listKey><FloatCurveKey _time="0" _value="0.02" _interpolation="Linear"/><FloatCurveKey _time="1" _value="0.02" _interpolation="Linear"/></_listKey></_sizeOverLife>
			<_colorOverLife>
				<_red><_listKey><FloatCurveKey _time="0" _value="1" _interpolation="Linear"/></_listKey></_red>
				<_green><_listKey><FloatCurveKey _time="0" _value="0.5" _interpolation="Linear"/></_listKey></_green>
				<_blue><_listKey><FloatCurveKey _time="0" _value="0.15" _interpolation="Linear"/></_listKey></_blue>
				<_alpha><_listKey><FloatCurveKey _time="0" _value="1" _interpolation="Linear"/><FloatCurveKey _time="1" _value="0" _interpolation="Linear"/></_listKey></_alpha>
			</_colorOverLife>
			<_collision _mode="Bounce" _method="SceneDepth" _depthThickness="0.3" _restitution="0.4" _friction="0.2"/>
			<_light _maxLights="32" _radius="2.5" _intensity="6"/>
		</VFXEmitterDef>
	</_listEmitter>
</VFXEffectDef>
