			<_colorOverLife>
				<_red><_listKey><FloatCurveKey _time="0" _value="0.72" _interpolation="Linear"/></_listKey></_red>
				<_green><_listKey><FloatCurveKey _time="0" _value="0.78" _interpolation="Linear"/></_listKey></_green>
				<_blue><_listKey><FloatCurveKey _time="0" _value="0.86" _interpolation="Linear"/></_listKey></_blue>
				<_alpha><_listKey><FloatCurveKey _time="0" _value="0.45" _interpolation="Linear"/></_listKey></_alpha>
			</_colorOverLife>
		</VFXEmitterDef>
	</_listEmitter>
</VFXEffectDef>
