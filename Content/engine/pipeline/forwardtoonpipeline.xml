<!--
	셀 셰이딩(툰)용 포워드 파이프라인 — forwardpipeline.xml 과 같은 패스(그림자 · 불투명 · 메시 외곽선 · 반투명)이고 Present 가 블룸 · 화면 외곽선 · 톤맵을 하지 않는다.
	툰은 빛 쪽이 기본색 그대로가 목표다 — 톤맵(Reinhard)은 흰색을 0.5 로 누르고, 블룸은 계단 경계를 번지게 한다(forward2dpipeline.xml 과 같은 이유).
	외곽선은 메시 외곽선 패스(MeshOutline, 머티리얼이 켠 것)가 그린다.
	고르는 법: `-gv_renderPipeline=engine/pipeline/forwardtoonpipeline.xml` (FrameRenderer 초기화).
-->
<RenderPipelineDesc _base="engine/pipeline/forwardpipeline.xml" _name="ForwardToonPipeline">
	<_listAttachment>
		<RenderPassAttachment _name="DepthOfFieldColor" _op="Remove" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="DepthOfField" _op="Remove" />
		<!-- 모션 블러(motion_blur.hlsl) — 화면 속도(카메라 + 물체)로 흐린다. 사용자 설정 graphics.motionBlur 를 끄거나 후처리 품질이 medium 아래면 원본을 그대로 넘긴다(같은 포맷).
		     톤맵(Present) 앞이다. 카메라와 물체가 모두 서 있으면 원본 그대로다. -->
		<RenderGraphPassDesc _name="MotionBlur">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
				<item>SceneVelocity</item>
			</_listInput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present">
			<_listPermutation />
		</RenderGraphPassDesc>
	</_listPass>
</RenderPipelineDesc>
