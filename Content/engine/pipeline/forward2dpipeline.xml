<!--
	2D 게임용 포워드 파이프라인 — 그림자 맵 패스가 없고(2D 그림자는 sprite2dlit 의 가림막 토막이 맡는다) Present 가 톤맵 · 블룸 · 외곽선을 하지 않는다.
	톤맵(Reinhard)은 흰색을 0.5 로 누른다 — 픽셀 아트의 색이 그대로 나와야 하는 2D 에는 맞지 않는다(유니티 2D URP 의 기본도 톤맵 없음).
	고르는 법: `-gv_renderPipeline=engine/pipeline/forward2dpipeline.xml` (FrameRenderer 초기화).
-->
<RenderPipelineDesc _base="engine/pipeline/forwardpipeline.xml" _name="Forward2DPipeline">
	<_listAttachment>
		<RenderPassAttachment _name="DepthOfFieldColor" _op="Remove" />
		<RenderPassAttachment _name="SceneColor" _format="R8G8B8A8_UNORM" _clearColor="0.12,0.15,0.18,1" _loadOp="Clear" _role="" _resolutionDivisor="1" />
		<RenderPassAttachment _name="SceneDepth" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _loadOp="Clear" _role="" _resolutionDivisor="1" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="MotionBlur" _op="Remove" />
		<RenderGraphPassDesc _name="DepthOfField" _op="Remove" />
		<RenderGraphPassDesc _name="Fog" _op="Remove" />
		<RenderGraphPassDesc _name="LensFlare" _op="Remove" />
		<RenderGraphPassDesc _name="HighlightSense" _op="Remove" />
		<RenderGraphPassDesc _name="DistortionApply" _op="Remove" />
		<RenderGraphPassDesc _name="Distortion" _op="Remove" />
		<RenderGraphPassDesc _name="SceneDepthCopy" _op="Remove" />
		<RenderGraphPassDesc _name="SceneColorCopy" _op="Remove" />
		<RenderGraphPassDesc _name="Sky" _op="Remove" />
		<RenderGraphPassDesc _name="HighlightOutline" _op="Remove" />
		<RenderGraphPassDesc _name="MeshOutline" _op="Remove" />
		<RenderGraphPassDesc _name="Shadow" _op="Remove" />
		<!-- 모션 블러가 없어 화면 속도를 쓰지 않는다(첨부 묶음 forwardcolorrenderpass 를 가져오지 않는다) — 출력은 색과 깊이뿐이다. -->
		<RenderGraphPassDesc _name="ForwardOpaque">
			<_listInput />
			<_listOutput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Transparent">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listPermutation />
		</RenderGraphPassDesc>
	</_listPass>
	<_listRenderPassRef />
</RenderPipelineDesc>
