<!--
	후처리를 **패스마다 따로** 두는 형태. 지금 기본(forwardpipeline.xml)은 이것을 Present 한 패스로
	합쳐 쓴다 — 중간 타깃 왕복 둘이 사라져 GPU 프레임이 그만큼 싸다.

	이 파일을 남겨 두는 이유는 둘이다.
	  1) 합친 판이 **같은 그림**을 내는지 재는 기준이다 (RenderPassGPUTest.FusedPostChainMatchesStaged).
	  2) 효과를 패스 단위로 끼우고 빼는 조립이 여전히 가능하다는 증거다 — 합치기가 그 길을 막지 않았다.
-->
<RenderPipelineDesc _base="engine/pipeline/forwardpipeline.xml" _name="ForwardPipelineStaged">
	<_listAttachment>
		<RenderPassAttachment _name="BloomColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" _role="" _resolutionDivisor="1" />
		<RenderPassAttachment _name="OutlineColor" _format="R16G16B16A16_FLOAT" _clearColor="0.12,0.15,0.18,1" _bClear="true" _role="" _resolutionDivisor="1" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="PostBloom" _after="MotionBlur" _type="Bloom" _depthAttachment="" _shaderPath="engine/shaders/post_bloom.hlsl" _vertexEntryPoint="VSMain" _pixelEntryPoint="PSMain" _computeEntryPoint="" _geometryEntryPoint="" _hullEntryPoint="" _domainEntryPoint="" _threadGroupSize="8" _cullMode="None" _bEnableDepthTest="false" _bEnableDepthWrite="false" _bEnableBlend="false" _minPostQuality="0">
			<_listInput>
				<item>MotionBlurColor</item>
			</_listInput>
			<_listOutput>
				<item>BloomColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Outline" _after="PostBloom" _type="Outline" _depthAttachment="" _shaderPath="engine/shaders/post_outline.hlsl" _vertexEntryPoint="VSMain" _pixelEntryPoint="PSMain" _computeEntryPoint="" _geometryEntryPoint="" _hullEntryPoint="" _domainEntryPoint="" _threadGroupSize="8" _cullMode="None" _bEnableDepthTest="false" _bEnableDepthWrite="false" _bEnableBlend="false" _minPostQuality="0">
			<_listInput>
				<item>BloomColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>OutlineColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present" _shaderPath="engine/shaders/tonemap.hlsl">
			<_listInput>
				<item>OutlineColor</item>
			</_listInput>
			<_listPermutation />
		</RenderGraphPassDesc>
	</_listPass>
</RenderPipelineDesc>
