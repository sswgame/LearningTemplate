<!--
	후처리를 **패스마다 따로** 두는 형태. 지금 기본(forwardpipeline.xml)은 이것을 Present 한 패스로
	합쳐 쓴다 — 중간 타깃 왕복 둘이 사라져 GPU 프레임이 그만큼 싸다.

	이 파일을 남겨 두는 이유는 둘이다.
	  1) 합친 판이 **같은 그림**을 내는지 재는 기준이다 (RenderPassGPUTest.FusedPostChainMatchesStaged).
	  2) 효과를 패스 단위로 끼우고 빼는 조립이 여전히 가능하다는 증거다 — 합치기가 그 길을 막지 않았다.
-->
<RenderPipelineDesc _name="ForwardPipelineStaged" _shadingModel="Forward">
	<_listAttachment>
		<RenderPassAttachment _name="SceneColor" _format="R16G16B16A16_FLOAT" _clearColor="0.12,0.15,0.18,1" _bClear="true" />
		<!-- 반투명 앞의 장면 색 사본 — 반투명(물의 굴절)이 읽는다. SceneColor 와 같은 형식 · 크기(복사). 복사 패스가 쓰므로 지우지 않는다. -->
		<RenderPassAttachment _name="SceneColorCopy" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="false" />
		<!-- 반투명 앞의 장면 깊이 사본(R32 실수) — 물의 화면 공간 두께가 읽는다. 반투명은 장면 깊이를 깊이 붙임으로 쥐고 있어 직접 읽을 수 없다. 복사 패스가 쓰므로 지우지 않는다. -->
		<RenderPassAttachment _name="SceneDepthCopy" _format="R32_FLOAT" _clearColor="1,0,0,0" _bClear="false" />
		<RenderPassAttachment _name="SceneDepth" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="ShadowMap" _format="D24_UNORM_S8_UINT" _clearColor="1,0,0,0" _bClear="true" />
		<RenderPassAttachment _name="DepthOfFieldColor"
		                      _format="R16G16B16A16_FLOAT"
		                      _clearColor="0.12,0.15,0.18,1"
		                      _bClear="true" />
		<RenderPassAttachment _name="MotionBlurColor"
		                      _format="R16G16B16A16_FLOAT"
		                      _clearColor="0.12,0.15,0.18,1"
		                      _bClear="true" />
		<RenderPassAttachment _name="BloomColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _bClear="true" />
		<RenderPassAttachment _name="OutlineColor"
		                      _format="R16G16B16A16_FLOAT"
		                      _clearColor="0.12,0.15,0.18,1"
		                      _bClear="true" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="Shadow"
		                     _type="Shadow"
		                     _depthAttachment="ShadowMap"
		                     _shaderPath="engine/shaders/shadow_depth.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput />
			<_listOutput>
				<item>ShadowMap</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="ForwardOpaque"
		                     _type="ForwardOpaque"
		                     _depthAttachment="SceneDepth"
		                     _shaderPath="engine/shaders/forward_lit.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>ShadowMap</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_FORWARD=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 뒤집은 껍질 외곽선(toon.hlsl 의 외곽선 퍼뮤테이션) — 외곽선을 켠 머티리얼(MATERIAL_OUTLINE)의 배치만 앞면을 컬링해 그린다.
		     불투명 깊이를 읽는 패스보다 뒤, 반투명보다 앞이다(외곽선이 깊이를 써서 뒤의 반투명을 가린다). -->
		<RenderGraphPassDesc _name="MeshOutline"
		                     _type="MeshOutline"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="true"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 강조 외곽선(highlight_outline.hlsl) — 강조 방식이 Outline 인 인스턴스만 뒤집은 껍질로 깊이 테스트해 그린다(상호작용 대상). 두께는 화면 높이 비율. -->
		<RenderGraphPassDesc _name="HighlightOutline"
		                     _type="HighlightOutline"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_HIGHLIGHT_WIDTH=0.004</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 하늘(SkyComponent) — 불투명 · 외곽선 뒤, 반투명 앞. 깊이 1 의 풀스크린 삼각형을 깊이 테스트로 그려 빈 곳만 칠한다(쓰기 없음). 씬에 하늘이 없으면 돌지 않는다. -->
		<RenderGraphPassDesc _name="Sky"
		                     _type="Sky"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 장면 색 사본 — 하늘까지 칠한 장면 색을 반투명이 읽을 수 있게 떠 둔다(반투명은 장면 색에 섞으며 써서 그 색을 읽을 수 없다). 셰이더 없는 복사 패스다. -->
		<RenderGraphPassDesc _name="SceneColorCopy"
		                     _type="SceneColorCopy"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
			</_listInput>
			<_listOutput>
				<item>SceneColorCopy</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 장면 깊이 사본 — 장면 깊이를 R32 실수로 옮긴다(scene_depth_copy.hlsl). 반투명이 읽는다. -->
		<RenderGraphPassDesc _name="SceneDepthCopy"
		                     _type="SceneDepthCopy"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneDepthCopy</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Transparent"
		                     _type="Transparent"
		                     _depthAttachment="SceneDepth"
		                     _shaderPath="engine/shaders/forward_lit.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="true"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneColorCopy</item>
				<item>SceneDepthCopy</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_TRANSPARENT=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 감각 모드 외곽선 — 강조 방식이 Sense 인 인스턴스만 깊이 테스트 없이 그려 벽 너머에서도 보인다. 반투명 뒤. -->
		<RenderGraphPassDesc _name="HighlightSense"
		                     _type="HighlightSense"
		                     _depthAttachment="SceneDepth"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Front"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation>
				<item>SW_HIGHLIGHT_WIDTH=0.004</item>
			</_listPermutation>
		</RenderGraphPassDesc>
		<!-- 높이 · 거리 지수 안개(FogComponent · 물속) — 장면 깊이로 시선 위 광학 두께를 구해 이미 칠한 색 위에 프리멀티플라이로 블렌드한다(색을 읽지 않는다). 씬에 안개가 없으면 돌지 않는다. 하늘 픽셀은 건드리지 않는다. -->
		<RenderGraphPassDesc _name="Fog"
		                     _type="Fog"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="Back"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>SceneColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 피사계 심도 — 합친 판(forwardpipeline.xml)과 같은 자리(블룸 앞)다. -->
		<RenderGraphPassDesc _name="DepthOfField"
		                     _type="DepthOfField"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>DepthOfFieldColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 카메라 모션 블러(motion_blur.hlsl) — 사용자 설정 graphics.motionBlur 를 끄거나 후처리 품질이 medium 아래면 원본을 그대로 복사한다(같은 포맷).
		     디퍼드와 같은 자리(피사계 심도 뒤, 톤맵 앞)다. 서 있으면 원본 그대로다. -->
		<RenderGraphPassDesc _name="MotionBlur"
		                     _type="MotionBlur"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false"
		                     _minPostQuality="1">
			<_listInput>
				<item>DepthOfFieldColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>MotionBlurColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="PostBloom"
		                     _type="Bloom"
		                     _shaderPath="engine/shaders/post_bloom.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>MotionBlurColor</item>
			</_listInput>
			<_listOutput>
				<item>BloomColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Outline"
		                     _type="Outline"
		                     _shaderPath="engine/shaders/post_outline.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>BloomColor</item>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>OutlineColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present"
		                     _type="Present"
		                     _shaderPath="engine/shaders/tonemap.hlsl"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="false">
			<_listInput>
				<item>OutlineColor</item>
			</_listInput>
			<_listOutput>
				<item>Swapchain</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 화면 2D(UI · 월드 글자) — Present(톤맵) 뒤 같은 출력에 불러온 채 그린다. Swapchain 을 쓰는 마지막 패스여야 한다(스크린샷 캡처 복사도 이 뒤). -->
		<RenderGraphPassDesc _name="Canvas"
		                     _type="Canvas"
		                     _vertexEntryPoint="VSMain"
		                     _pixelEntryPoint="PSMain"
		                     _cullMode="None"
		                     _bEnableDepthTest="false"
		                     _bEnableDepthWrite="false"
		                     _bEnableBlend="true">
			<_listInput />
			<_listOutput>
				<item>Swapchain</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
	</_listPass>
	<_listRenderPassRef>
		<item>engine/renderpass/defaultrenderpass.xml</item>
	</_listRenderPassRef>
</RenderPipelineDesc>
