<!--
	깊이 프리패스(Depth Priming)를 앞에 둔 포워드 파이프라인. 나머지는 `forwardpipeline.xml` 과 같다.

	무엇을 사나: 불투명 지오메트리를 먼저 **깊이만** 그려 두면, 기본 패스는 보이는 픽셀만 셰이딩한다(겹친 면의 조명 · 텍스처
	계산을 건너뛴다). 언리얼의 EarlyZ 패스(r.EarlyZPass) · 유니티 URP 의 Depth Priming 자리다. 픽셀 셰이딩이 비싼 장면에서 이득이고,
	깊이만 그리는 비용이 하나 더 든다.

	맞물림: 프리패스는 shadow_depth.hlsl 을 **카메라** 행렬로 그리고(패스 define `SW_PASS_DEPTH_PREPASS`), 기본 패스는 같은 위치 함수
	(binding.hlsli `Transform::computeWorldPosition` · `Transform::computeClipPosition`, precise)로 같은 깊이를 내 LessEqual 을 통과한다 — 언리얼이 depth-only 와
	base pass 에 같은 정점 팩토리 코드를 쓰는 것과 같은 이유다. 프리패스가 돈 프레임의 ForwardOpaque 는 깊이 쓰기를 끈 PSO 로 그린다.
	같은 그림을 내는지 테스트가 프리패스 없는 판과 대조한다(`RenderPassGPUTest.DepthPrepassRendersTheSameImage`).
-->
<RenderPipelineDesc _base="engine/pipeline/forwardpipeline.xml" _name="ForwardPrepassPipeline">
	<_listAttachment>
		<!-- 접촉 그림자 마스크 — 채널 넷이 접촉 그림자를 켠 빛 넷이다. 깊이 프리패스가 장면 깊이를 먼저 써 두므로 포워드도 조명 앞에 걸을 수 있다. -->
		<RenderPassAttachment _name="ContactShadowMask" _format="R8G8B8A8_UNORM" _clearColor="1,1,1,1" _loadOp="Clear" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="DepthPrepass" _after="Shadow" _type="DepthPrepass" _depthAttachment="SceneDepth" _shaderPath="engine/shaders/shadow_depth.hlsl" _vertexEntryPoint="VSMain" _pixelEntryPoint="PSMain" _computeEntryPoint="" _geometryEntryPoint="" _hullEntryPoint="" _domainEntryPoint="" _threadGroupSize="8" _cullMode="Back" _bEnableDepthTest="true" _bEnableDepthWrite="true" _minPostQuality="0">
			<_listInput />
			<_listOutput>
				<item>SceneDepth</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<!-- 접촉 그림자(contact_shadow.hlsl) — 깊이 프리패스 뒤, 포워드 불투명 앞. 켠 빛이 없거나 후처리를 끈 뷰는 돌지 않는다(포워드 불투명은 1 을 읽는다). -->
		<RenderGraphPassDesc _name="ContactShadow" _after="DepthPrepass" _type="ContactShadow" _vertexEntryPoint="VSMain" _pixelEntryPoint="PSMain" _cullMode="None" _bEnableDepthTest="false" _bEnableDepthWrite="false">
			<_listInput>
				<item>SceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>ContactShadowMask</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="ForwardOpaque">
			<_listInput>
				<item>ShadowMap</item>
				<item>ContactShadowMask</item>
			</_listInput>
		</RenderGraphPassDesc>
	</_listPass>
</RenderPipelineDesc>
