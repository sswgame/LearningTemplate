<!--
	해 · 밝은 빛의 렌즈 플레어(LensFlareAsset) — 빛 자리의 빛무리 · 가로 줄과, 화면 가운데 너머 축 위의 고스트 셋 · 헤일로 하나. 빛 컴포넌트의 _lensFlarePath 가 가리킨다.
	칸: _axisPosition(빛 0 → 화면 가운데 1, 1 너머는 반대쪽) · _size(반지름, 화면 높이 비율) · _color(HDR, 빛 색 × 세기에 곱한다) · _shape(Glow · Disc · Ring · Streak).
	_edgeFade 는 화면 끝에서 줄어드는 폭(NDC 비율), _occlusionRadius 는 가림을 볼 깊이 표본 반지름(화면 높이 비율)이다.
-->
<LensFlareAsset _edgeFade="0.25" _occlusionRadius="0.01">
	<_listElement>
		<LensFlareElement _shape="Glow" _axisPosition="0" _size="0.18" _color="0.35,0.3,0.25" />
		<LensFlareElement _shape="Streak" _axisPosition="0" _size="0.45" _color="0.12,0.14,0.2" />
		<LensFlareElement _shape="Disc" _axisPosition="0.6" _size="0.035" _color="0.05,0.08,0.12" />
		<LensFlareElement _shape="Disc" _axisPosition="1.3" _size="0.06" _color="0.1,0.06,0.03" />
		<LensFlareElement _shape="Ring" _axisPosition="1.0" _size="0.25" _color="0.03,0.04,0.05" />
		<LensFlareElement _shape="Disc" _axisPosition="1.8" _size="0.09" _color="0.04,0.07,0.05" />
	</_listElement>
</LensFlareAsset>
