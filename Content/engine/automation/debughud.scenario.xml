<?xml version="1.0" encoding="utf-8"?>
<!--
  엔진 시나리오 — 디버그 HUD(Dev 전용): 마스터 단축키 Ctrl+F3 로 켜고, 개발 명령 hud 로 섹션 · 모서리를 바꾸고, 설정 창을 열어 B(UI.Back)로 닫고, 다시 Ctrl+F3 로 끈다.
  감시 값은 HUD 화면이 실제로 그린 것을 본다 — DebugHUD.SectionShown(gv_debugHUDWatchSection 의 섹션 상자) · DebugHUD.Corner(패널이 놓인 4 분면).
  HUD 상태는 사용자 설정이라 사용자 파일에 남는다 — 끝에서 기본값(꺼짐 · 기본 섹션 · 왼위 · 0.85)으로 되돌려 파일에 남는 값이 없게 한다.
  실행: App -scenario=engine/automation/debughud.scenario.xml -unattended
-->
<Scenario name="engine.debughud" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<DevCommand line="hud off"/>
	<DevCommand line="hud physics off"/>
	<DevCommand line="hud corner topLeft"/>
	<Variable name="gv_debugHUDWatchSection" value="physics"/>
	<WaitUntil watch="DebugHUD.Shown" equals="0" timeoutFrames="60"/>
	<!-- 마스터 단축키 — Ctrl 을 누른 채 F3 -->
	<Wait frames="2"/>
	<Press slot="Key.LeftControl"/>
	<Wait frames="1"/>
	<Tap slot="Key.F3"/>
	<Wait frames="3"/>
	<Release slot="Key.LeftControl"/>
	<WaitUntil watch="DebugHUD.Shown" equals="1" timeoutFrames="84"/>
	<Expect watch="DebugHUD.SectionCount" atLeast="1"/>
	<Expect watch="DebugHUD.SectionShown" equals="0"/>
	<Expect watch="DebugHUD.Corner" equals="0"/>
	<!-- 섹션 켜기 · 모서리 -->
	<Wait frames="2"/>
	<DevCommand line="hud physics on"/>
	<WaitUntil watch="DebugHUD.SectionShown" equals="1" timeoutFrames="60"/>
	<Wait frames="1"/>
	<DevCommand line="hud corner bottomRight"/>
	<WaitUntil watch="DebugHUD.Corner" equals="3" timeoutFrames="60"/>
	<Wait frames="1"/>
	<DevCommand line="hud corner topRight"/>
	<WaitUntil watch="DebugHUD.Corner" equals="1" timeoutFrames="60"/>
	<!-- 섹션 끄기 -->
	<Wait frames="1"/>
	<DevCommand line="hud physics off"/>
	<WaitUntil watch="DebugHUD.SectionShown" equals="0" timeoutFrames="60"/>
	<!-- 설정 창(모달) — 열린 동안 활성 화면, B 로 닫는다 -->
	<Wait frames="1"/>
	<DevCommand line="hud window"/>
	<WaitUntil watch="DebugHUD.WindowOpen" equals="1" timeoutFrames="60"/>
	<ExpectUI screen="engine/ui/debughud.ui.xml"/>
	<Wait frames="2"/>
	<Tap slot="Gamepad.B"/>
	<WaitUntil watch="DebugHUD.WindowOpen" equals="0" timeoutFrames="60"/>
	<!-- 마스터 단축키로 끈다 -->
	<Wait frames="5"/>
	<Press slot="Key.LeftControl"/>
	<Wait frames="1"/>
	<Tap slot="Key.F3"/>
	<Wait frames="3"/>
	<Release slot="Key.LeftControl"/>
	<WaitUntil watch="DebugHUD.Shown" equals="0" timeoutFrames="60"/>
	<Wait frames="1"/>
	<DevCommand line="hud corner topLeft"/>
	<DevCommand line="hud opacity 0.85"/>
	<Wait frames="4"/>
	<Pass/>
</Scenario>
