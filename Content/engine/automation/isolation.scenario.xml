<?xml version="1.0" encoding="utf-8"?>
<!--
  엔진 시나리오 — 자동화 격리: 이 실행의 사용자 데이터 뿌리(SW_USER_DATA_ROOT)가 자동화 폴더(Saved/Automation/UserData) 아래이고,
  기동 뒤로 사람의 OS 사용자 데이터 폴더(활성 게임 — Windows %LOCALAPPDATA%/SWEngine/<게임>)가 바뀌지 않았는지 본다(AutomationUserDataRoot).
  체인 안에서 돌므로 앞 단계(세이브를 쓰는 게임 시나리오)와 같은 기계에서 함께 도는 다른 백엔드 프로세스의 쓰기까지 잡는다. 어느 게임 프리셋에서나 돈다.
  같은 기계에서 사람이 그 게임을 동시에 플레이하면 사람 폴더가 바뀌어 진다 — 통합 실행 중에는 그 게임을 켜지 않는다.
  실행: App -scenario=engine/automation/isolation.scenario.xml -unattended
-->
<Scenario name="engine.isolation" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Wait frames="1"/>
	<Expect watch="UserData.Isolated" equals="1"/>
	<Expect watch="UserData.PlatformFolderChanged" equals="0"/>
	<Pass/>
</Scenario>
