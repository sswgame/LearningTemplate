<?xml version="1.0" encoding="utf-8"?>
<!--
  백엔드 교체 시나리오 — 한 프로세스에서 네 백엔드를 차례로 건너고(DX11 → DX12 → Vulkan → OpenGL → DX12), 교체마다 디바이스가 정말 그 백엔드이고 교체가 실패하지 않았으며
  모듈이 의존 라이브러리에 묶여 있고(Module.BindingsOk) 씬이 사라지지 않았는지(Scene.ObjectCount) 본다. 단계 `SwapBackend` 는 교체를 요청만 하므로(메뉴 · 콘솔과 같은 길)
  끝은 `RHI.SwapPending` 이 0 이 되는 것으로 기다린다. 어느 백엔드로 시작해도 된다.
  네 백엔드가 모두 있는 PC 에서만 통과한다 — 그래서 CTest 가 줍는 폴더(engine/automation 바로 아래)가 아니라 이 하위 폴더에 둔다.
  실행: App -scenario=engine/automation/rhiswap/swapbackends.scenario.xml -unattended
-->
<Scenario name="rhiswap.swapbackends" fixedDelta="0.0166667" timeoutFrames="3000" startAfter="Immediately" input="exclusive">
	<At frame="30"><SwapBackend backend="dx11"/></At>
	<At frame="32"><WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/></At>
	<At frame="40">
		<Expect watch="RHI.Backend" equals="0"/>
		<Expect watch="RHI.SwapFailedCount" equals="0"/>
		<Expect watch="Scene.ObjectCount" atLeast="1"/>
	</At>
	<At frame="60"><SwapBackend backend="dx12"/></At>
	<At frame="62"><WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/></At>
	<At frame="70">
		<Expect watch="RHI.Backend" equals="1"/>
		<Expect watch="RHI.SwapFailedCount" equals="0"/>
		<Expect watch="Scene.ObjectCount" atLeast="1"/>
	</At>
	<At frame="90"><SwapBackend backend="vk"/></At>
	<At frame="92"><WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/></At>
	<At frame="100">
		<Expect watch="RHI.Backend" equals="2"/>
		<Expect watch="RHI.SwapFailedCount" equals="0"/>
		<Expect watch="Scene.ObjectCount" atLeast="1"/>
	</At>
	<At frame="120"><SwapBackend backend="gl"/></At>
	<At frame="122"><WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/></At>
	<At frame="130">
		<Expect watch="RHI.Backend" equals="3"/>
		<Expect watch="RHI.SwapFailedCount" equals="0"/>
		<Expect watch="Scene.ObjectCount" atLeast="1"/>
	</At>
	<At frame="150"><SwapBackend backend="dx12"/></At>
	<At frame="152"><WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/></At>
	<At frame="160">
		<Expect watch="RHI.Backend" equals="1"/>
		<Expect watch="RHI.SwapFailedCount" equals="0"/>
		<Expect watch="Scene.ObjectCount" atLeast="1"/>
		<Pass/>
	</At>
</Scenario>
