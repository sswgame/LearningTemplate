<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰(에디터 카메라)와 게임 뷰(게임 카메라)는 다른 패널 · 다른 그림이다(V1).
  ① 기본 배치는 Scene 탭이 앞이라 게임 뷰를 그리지 않는다(RT 요청 0). ② 씬 뷰 캔버스로 에디터 카메라를 옮긴 뒤 두 뷰를 찍으면 그림이 다르다.
  ③ Play 중에도 씬 뷰는 에디터 카메라 그대로이고 그 카메라로 둘러볼 수 있다 — 게임 뷰만 게임 카메라를 따른다. ④ Stop 뒤 정지로 돌아온다.
  ⑤ 게임 뷰 패널을 닫으면 게임 뷰 RT 요청이 0 이다.
  스크린샷은 주 출력이다 — 게임 뷰가 보이면 게임 뷰, 씬 뷰만 보이면 씬 뷰(격자 · 기즈모는 ImGui 오버레이라 어느 쪽 그림에도 없다).
  실행: App -EnableEditor -scenario=engine/automation/editor/sceneviewgameview.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.sceneviewgameview" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 그림 판정의 크기는 UI 배율에 달렸다 — 모니터 DPI 와 상관없이 같게 둔다 -->
	<Variable name="gv_editorUiScale" value="1.5"/>
	<!-- 위치로 누르는 시나리오 — 앞 시나리오 · 사용자 배치가 패널을 좁혀 두었을 수 있다 -->
	<DevCommand line="layout.reset"/>
	<!-- 두 뷰 RT 를 같은 배치에서 새로 짓게 창 크기를 크게 두 번 바꾼다 — RT 는 1 픽셀 떨림을 무시하므로(EditorViewTargetUtil::needsResize) 앞 배치의 RT 가
	     1 픽셀 다른 채 남으면 두 스크린샷 크기가 달라 화소 비교(differingFraction)를 하지 못한다 -->
	<ResizeWindow width="1440" height="810"/>
	<ResizeWindow width="1600" height="900"/>
	<!-- ① 기본은 씬 뷰만 보인다 -->
	<EditorWaitSettled/>
	<!-- 무인 실행: 사람의 마우스 · 키보드는 창 메시지 단계에서 버린다 — 커서가 창 위 · 밖 어디 있든 비행 결과가 같다 -->
	<Expect watch="Input.OSDeviceInputBlocked" equals="1"/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<Expect watch="Editor.SceneViewRequested" equals="1"/>
	<Expect watch="Editor.GameViewRequested" equals="0"/>
	<Store watch="Editor.GameViewCameraX" as="gameCameraX"/>
	<Store watch="Editor.GameViewCameraY" as="gameCameraY"/>
	<Wait frames="1"/>
	<!-- ② 에디터 카메라를 옆으로 3 m 남짓 옮긴다(오른쪽 단추 + D) -->
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorKey key="D" state="Down"/>
	<Wait frames="42"/>
	<EditorKey key="D" state="Up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<!-- 게임 카메라는 씬 뷰 비행을 따르지 않는다 -->
	<Expect watch="Editor.GameViewCameraX" sameAs="gameCameraX"/>
	<Expect watch="Editor.GameViewCameraY" sameAs="gameCameraY"/>
	<Screenshot file="sceneview.ppm"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus game_view"/>
	<WaitUntil watch="Editor.GameViewRequested" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.SceneViewRequested" equals="0"/>
	<Screenshot file="gameview.ppm"/>
	<EditorWaitSettled/>
	<ExpectImage file="gameview.ppm" golden="gameview"/>
	<!-- ③ Play — 게임 뷰는 게임 카메라, 씬 뷰는 에디터 카메라 그대로 -->
	<EditorWaitSettled/>
	<EditorClick mark="toolbar.play"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="120"/>
	<Expect watch="Editor.GameViewRequested" equals="1"/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SceneViewRequested" equals="1"/>
	<Expect watch="Editor.GameViewRequested" equals="0"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorKey key="D" state="Down"/>
	<Wait frames="42"/>
	<EditorKey key="D" state="Up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.PlayState" equals="1"/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="6"/>
	<!-- ④ Stop — 정지로 돌아오고 씬 뷰는 계속 씬 뷰다 -->
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="90"/>
	<Expect watch="Editor.SceneViewRequested" equals="1"/>
	<!-- ⑤ 게임 뷰를 닫아도 요청은 0, 다시 열면 1 -->
	<EditorWaitSettled/>
	<DevCommand line="panel.close game_view"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.GameViewRequested" equals="0"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus game_view"/>
	<WaitUntil watch="Editor.GameViewRequested" equals="1" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
