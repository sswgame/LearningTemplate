<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 콘텐츠 브라우저 에셋 관리(N3). 테스트 폴더 engine/automation/editor/assetmanage 에는 probe.material 과 그것을 쓰는 씬이 있고,
  시나리오는 그것을 실행마다 새 사본(scratch/assetmanage)으로 복사해 사본에만 쓴다(<Scratch> — 추적 중인 원본이 바뀌거나 잔여 파일이 남지 않는다).
  1) Add > Material 로 new_material.material 을 만든다.
  2) probe.material 을 F2 로 probe_renamed 로 바꾸면 씬의 참조가 새 이름으로 바뀐다(Editor.ReferenceCount — 역색인이 센 참조 파일 수).
  3) 다시 probe 로 되돌리고, 만든 머티리얼은 Delete 로 휴지통에 보낸다. 사본은 다음 실행이 지운다.
  실행: App -EnableEditor -scenario=engine/automation/editor/assetmanage.scenario.xml -unattended
-->
<Scenario name="editor.assetmanage" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/assetmanage" as="scratch/assetmanage"/>
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchAsset" value="scratch/assetmanage/probe.material"/>
	<Wait frames="10"/>
	<DevCommand line="panel.focus content_browser"/>
	<!-- 역색인은 워커가 Resource/ 를 훑어 만든다. 콘텐츠 브라우저가 보이는 동안 색인이 마지막 변경(사본 복사 · 이름 바꾸기)을 따라오기 전이면
	     시계 잡기 조건 ContentBrowserReferenceIndex 가 시계를 멈춘다 — 아래 고정 프레임의 단언과 이름 바꾸기는 따라온 색인을 쓴다 -->
	<Wait frames="10"/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1"/>
	<WaitUntil watch="Editor.ReferenceCount" equals="1" timeoutFrames="60"/>
	<DevCommand line="content.open scratch/assetmanage"/>
	<!-- 1) 새 머티리얼 -->
	<Wait frames="20"/>
	<EditorClick mark="contentBrowser.add" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.add" state="up"/>
	<EditorClick mark="contentBrowser.add.material" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.add.material" state="up"/>
	<Wait frames="22"/>
	<ExpectLog contains="Created 'scratch/assetmanage/new_material.material'" count="1"/>
	<!-- 2) 이름 바꾸기 — 타일을 고르고 F2, 입력 칸은 확장자를 뺀 이름이다 -->
	<EditorClick mark="contentBrowser.asset.probe.material" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.asset.probe.material" state="up"/>
	<EditorKey key="F2"/>
	<EditorText value="probe_renamed"/>
	<!-- 새 머티리얼을 만든 변경을 색인이 따라오기 전에 이름을 바꾸면 거절된다(아무것도 안 옮김) — 느린 백엔드(GL)에서 일어났다 -->
	<Wait frames="7"/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1"/>
	<Wait frames="3"/>
	<EditorKey key="Enter"/>
	<!-- 이름 바꾸기가 고친 파일을 색인이 따라왔는지 기다린다. 시계 잡기(ContentBrowserReferenceIndex)는 콘텐츠가 보일 때만 잡아, 느린 백엔드(GL)에서는
	     따라오기 전에 아래 단언이 "no value" 를 읽었다 -->
	<Wait frames="15"/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1"/>
	<Wait frames="5"/>
	<ExpectLog contains="to 'scratch/assetmanage/probe_renamed.material' and fixed 1 referencing file(s)" count="1"/>
	<Expect watch="Editor.ReferenceCount" equals="0"/>
	<Variable name="gv_editorWatchAsset" value="scratch/assetmanage/probe_renamed.material"/>
	<WaitUntil watch="Editor.ReferenceCount" equals="1" timeoutFrames="60"/>
	<CaptureEditorUI file="renamed.png"/>
	<!-- 3) 되돌리기 -->
	<EditorClick mark="contentBrowser.asset.probe_renamed.material" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.asset.probe_renamed.material" state="up"/>
	<EditorKey key="F2"/>
	<EditorText value="probe"/>
	<!-- 첫 이름 바꾸기가 남긴 파일 변경 알림이 느린 백엔드(GL)에서 뒤늦게 닿아 색인이 다시 낡을 수 있다 — 낡은 색인에서는 이름 바꾸기가 거절된다(아무것도 안 옮김) -->
	<Wait frames="7"/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1"/>
	<Wait frames="3"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<Variable name="gv_editorWatchAsset" value="scratch/assetmanage/probe.material"/>
	<Wait frames="3"/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1"/>
	<Wait frames="2"/>
	<Expect watch="Editor.ReferenceCount" equals="1"/>
	<EditorClick mark="contentBrowser.asset.new_material.material" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.asset.new_material.material" state="up"/>
	<EditorKey key="Delete"/>
	<EditorClick mark="contentBrowser.delete.confirm" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.delete.confirm" state="up"/>
	<Wait frames="17"/>
	<ExpectLog contains="Moved 'scratch/assetmanage/new_material.material' to the recycle bin" count="1"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
