<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 애니메이션 그래프 전이 편집(N8): 노드를 하나 찾아 넣고, Walk 를 누른 뒤 Ctrl 로 Attack 을 골라 Link Selected 로 잇는다
  (감시 값 Editor.AnimationGraphLinkCount). 오른쪽 인스펙터에서 그 전이를 골라 조건(파라미터 Speed · 비교 >)을 적으면 조건 있는 전이가 하나가 되고
  (Editor.AnimationGraphConditionCount), 저장한 뒤 조건을 지워도 Load 가 저장한 조건을 되읽는다.
  문서: 테스트 그래프(animgraphedit/animgraphedit.animgraph.xml — 노드 Idle · Walk, 전이 둘)의 실행마다 새 사본(scratch/animgraphedit — <Scratch>)을
  `asset.openScratch` 로 열어 거기에 저장한다. 추적 중인 원본에 쓰면 백엔드별 체인이 병렬 조각에서 같은 파일을 동시에 고쳐, 한 프로세스의 Save 와 Load 사이에
  다른 프로세스의 마지막 저장(원래 모양)이 끼어 Load 가 옛 내용을 읽었다(체인에서만 지던 원인). Quick Open 은 파일 이름으로 찾아 원본과 사본 중 하나가 걸리므로 쓰지 않는다.
  경로 없는 기본 문서(상태 폴더의 AnimationGraphData.xml)에 쓰면 체인의 뒤 시나리오(graphaddnode)가 노드 셋으로 시작한다.
  기본 문서는 노드 둘 · 전이 하나라 테스트 그래프는 전이를 둘로 두어 열렸는지 가린다(여는 것은 다음 프레임 이후라 WaitUntil 로 기다린다).
  끝에서 추가한 노드를 지우고 저장하는 것은 지우기 · 저장 확인의 일부다(사본에만 쓰므로 원본은 바뀌지 않는다).
  실행: App -EnableEditor -scenario=engine/automation/editor/animgraphedit.scenario.xml -unattended
-->
<Scenario name="editor.animgraphedit" fixedDelta="0.0166667" timeoutFrames="1100" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/animgraphedit" as="scratch/animgraphedit"/>
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus animation_graph"/>
	<Wait frames="20"/>
	<DevCommand line="asset.openScratch scratch/animgraphedit/animgraphedit.animgraph.xml"/>
	<Wait frames="40"/>
	<WaitUntil watch="Editor.AnimationGraphLinkCount" equals="2"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="2" timeoutFrames="90"/>
	<Expect watch="Editor.AnimationGraphLinkCount" equals="2"/>
	<Wait frames="5"/>
	<EditorClick mark="graph.canvas" button="1" anchor="0.06,0.9"/>
	<Wait frames="20"/>
	<EditorText value="att"/>
	<Wait frames="10"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="3" timeoutFrames="75"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.node.Walk"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.node.Attack" mods="ctrl"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.linkSelected"/>
	<WaitUntil watch="Editor.AnimationGraphLinkCount" equals="3" timeoutFrames="60"/>
	<Expect watch="Editor.AnimationGraphConditionCount" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.link.2"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.condition.param"/>
	<Wait frames="15"/>
	<EditorText value="Speed"/>
	<Wait frames="10"/>
	<EditorKey key="Enter"/>
	<Wait frames="15"/>
	<EditorClick mark="animationGraph.condition.op"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.condition.op.1"/>
	<WaitUntil watch="Editor.AnimationGraphConditionCount" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.save"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.link.2"/>
	<Wait frames="15"/>
	<EditorClick mark="animationGraph.condition.op"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.condition.op.0"/>
	<WaitUntil watch="Editor.AnimationGraphConditionCount" equals="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.load"/>
	<WaitUntil watch="Editor.AnimationGraphConditionCount" equals="1" timeoutFrames="75"/>
	<Expect watch="Editor.AnimationGraphLinkCount" equals="3"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.node.Attack"/>
	<Wait frames="15"/>
	<EditorKey key="Delete"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.AnimationGraphLinkCount" equals="2"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.save"/>
	<Wait frames="20"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
