<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터(EditorPropertyGrid)로 컴포넌트 값을 고치면 Undo 에 하나 쌓이고, Ctrl+Z 로 값이 돌아온다.
  테스트 씬의 GameCamera 를 Hierarchy 에서 고르고 CameraComponent 의 _priority 칸(이름표 inspector.property.CameraComponent._priority)에 7 을 친다(드래그 칸은 Ctrl+클릭이 글 입력이다).
  실행: App -EnableEditor -scenario=engine/automation/editor/inspectoredit.scenario.xml -unattended
-->
<Scenario name="editor.inspectoredit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<Variable name="gv_editorWatchProperty" value="CameraComponent._priority"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectedProperty" equals="0"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<EditorWaitSettled/>
	<!-- 같은 선택을 그리는 동안 배치 묶음을 다시 짓지 않는다 -->
	<Store watch="Editor.InspectorLayoutRebuildCount" as="layout"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.InspectorLayoutRebuildCount" sameAs="layout"/>
	<EditorWaitSettled/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="7"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="7" timeoutFrames="60"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<EditorWaitSettled/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
