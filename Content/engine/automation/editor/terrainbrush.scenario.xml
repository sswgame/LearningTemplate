<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 지형 칠하기 도구: envshowcase 를 열고(비동기 로드를 Scene.Transitioning 으로 기다린다) 씬 뷰 카메라를 지형 위로 옮긴 뒤 Terrain 토글(viewport.visualizer.terrainbrush)을 켠다.
  ① 칠하기 전을 찍는다. ② 레이어 3(모래)을 반경 20 m 로 씬 뷰 가운데에서 끌어 칠하면 드래그 하나가 되돌리기 하나로 남고(Editor.TerrainBrushStrokeCount),
  GPU 스플랫이 바뀐 구간만 올라가 그림이 달라진다. ③ Ctrl+Z 면 같은 사각형이 편집 전 값으로 다시 써져 ①과 거의 같다(브러시 원 · 마우스 위치만 다르다).
  ④ 높이 올리기로 끌면 청크 메시가 다시 만들어져 그림이 다시 달라진다. ⑤ 스무드(세기 60 — 프레임마다 이웃 평균 쪽으로 거의 다 간다)로 같은 자리를 끌면 솟은 곳이 눅는다. ⑥ 구멍 내기로 끌면 지형이 뚫려 그림이 달라진다. ⑦ 크기 바꾸기(terrain.resize 129)는 해상도를 257 에서 129 로 줄이고(Editor.TerrainResolution), Ctrl+Z 가 257 로 되돌린다.
  저장 단추는 누르지 않는다 — 에셋 파일은 그대로다.
  실행: App -EnableEditor -scenario=engine/automation/editor/terrainbrush.scenario.xml -unattended
-->
<Scenario name="editor.terrainbrush" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Wait frames="1"/>
	<Variable name="gv_environmentAnimate" value="0"/>
	<Wait frames="19"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="panel.resetOptional"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="5"/>
	<DevCommand line="scene.open game/empty/maps/envshowcase.scene.xml"/>
	<Wait frames="1"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutFrames="900"/>
	<Wait frames="9"/>
	<DevCommand line="panel.focus scene_view"/>
	<Wait frames="10"/>
	<DevCommand line="camera.reset"/>
	<Wait frames="5"/>
	<DevCommand line="camera.set 0 70 -100 35 0"/>
	<EditorClick mark="viewport.visualizer.terrainbrush"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.TerrainBrushToolActive" equals="1" timeoutFrames="60"/>
	<Wait frames="9"/>
	<DevCommand line="terrain.brush paint 20 60 3"/>
	<!-- 브러시 원: 마우스를 씬 뷰 가운데에 두면 레이가 지형에 닿고 원이 그려진다(카메라는 지형 위) — 에디터 화면으로 찍는다 -->
	<Wait frames="15"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.55"/>
	<Wait frames="7"/>
	<Expect watch="Editor.TerrainBrushHit" equals="1"/>
	<CaptureEditorUI file="terrainbrush/circle.png"/>
	<!-- ① 칠하기 전 -->
	<Wait frames="8"/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<Expect watch="Editor.SceneViewCameraY" near="70" tolerance="0.5"/>
	<Expect watch="Editor.GameViewRequested" equals="0"/>
	<Expect watch="Editor.TerrainBrushStrokeCount" equals="0"/>
	<Screenshot file="terrain_before.ppm"/>
	<!-- ② 레이어 칠하기 -->
	<EditorDrag mark="sceneView.canvas" dx="160" dy="0"/>
	<Wait frames="2"/>
	<Expect watch="Editor.TerrainBrushHit" equals="1"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="1" timeoutFrames="144"/>
	<Expect watch="Editor.UndoCount" atLeast="1"/>
	<Screenshot file="terrain_painted.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="terrain_painted.ppm" golden="terrain_painted"/>
	<!-- ③ 되돌리기 -->
	<Wait frames="9"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="30"/>
	<Screenshot file="terrain_undone.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="terrain_undone.ppm" golden="terrain_undone"/>
	<!-- ④ 높이 올리기 -->
	<Wait frames="9"/>
	<DevCommand line="terrain.brush raise 15 120"/>
	<Wait frames="10"/>
	<EditorDrag mark="sceneView.canvas" dx="0" dy="60"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="2" timeoutFrames="150"/>
	<Screenshot file="terrain_raised.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="terrain_raised.ppm" golden="terrain_raised"/>
	<!-- ⑤ 스무드 -->
	<Wait frames="9"/>
	<DevCommand line="terrain.brush smooth 25 60"/>
	<Wait frames="10"/>
	<EditorDrag mark="sceneView.canvas" dx="20" dy="0"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="3" timeoutFrames="150"/>
	<Screenshot file="terrain_smoothed.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="terrain_smoothed.ppm" golden="terrain_smoothed"/>
	<!-- ⑥ 구멍 내기 -->
	<Wait frames="9"/>
	<DevCommand line="terrain.brush hole 18 1"/>
	<Wait frames="10"/>
	<EditorDrag mark="sceneView.canvas" dx="40" dy="0"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="4" timeoutFrames="150"/>
	<Screenshot file="terrain_holes.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="terrain_holes.ppm" golden="terrain_holes"/>
	<!-- ⑦ 크기 바꾸기 -->
	<Wait frames="9"/>
	<Expect watch="Editor.TerrainResolution" equals="257"/>
	<DevCommand line="terrain.resize 129"/>
	<Wait frames="10"/>
	<Expect watch="Editor.TerrainResolution" equals="129"/>
	<Expect watch="Editor.TerrainBrushStrokeCount" equals="4"/>
	<Screenshot file="terrain_resized.ppm"/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.TerrainResolution" equals="257" timeoutFrames="60"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
