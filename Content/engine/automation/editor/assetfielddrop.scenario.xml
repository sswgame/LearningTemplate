<!--
  에디터 시나리오 — 에셋을 인스펙터 칸에 끌어 놓기(EditorUI R11). 콘텐츠 브라우저에서 assetmove/pack 폴더를 열고 probe.material 타일을 TestMesh 의
  머티리얼 칸(MeshComponent._materialPath, AssetRef<Material>)에 놓으면 값이 기본과 달라지고(Editor.SelectedPropertyModified 0 → 1) 되돌리기 한 단계가 쌓인다.
  Undo 로 비워진다. 받지 않는 것(폴더 detail)을 같은 칸에 놓으면 놓을 자리가 열리지 않아 아무것도 바뀌지 않는다. 끄는 동안 계층 선택은 그대로다(타일은 뗄 때 고른다 — R12).
  실행: App -EnableEditor -scenario=engine/automation/editor/assetfielddrop.scenario.xml -unattended
-->
<Scenario name="editor.assetfielddrop" fixedDelta="0.0166667" timeoutFrames="800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitStable/>
	<DevCommand line="content.open engine/automation/editor/assetmove/pack"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestMesh"/>
	<WaitUntil watch="Editor.SelectedNames" is="TestMesh" timeoutFrames="60"/>
	<Variable name="gv_editorWatchProperty" value="MeshComponent._materialPath"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedPropertyModified" equals="0"/>
	<Store watch="Editor.UndoIndex" as="undoBefore"/>
	<!-- ① 머티리얼 에셋을 머티리얼 칸에 놓는다 -->
	<EditorDrag mark="contentBrowser.asset.probe.material" toMark="inspector.property.MeshComponent._materialPath"/>
	<WaitUntil watch="Editor.SelectedPropertyModified" equals="1" timeoutFrames="120"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedNames" is="TestMesh"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoBefore"/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.SelectedPropertyModified" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<!-- ② 받지 않는 것(폴더)은 놓아도 바뀌지 않는다 -->
	<EditorDrag mark="contentBrowser.asset.detail" toMark="inspector.property.MeshComponent._materialPath"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedPropertyModified" equals="0"/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<Expect watch="Editor.SelectedNames" is="TestMesh"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
