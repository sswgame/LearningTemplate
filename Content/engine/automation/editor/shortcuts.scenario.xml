<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 단축키 편집기(P3): Undo 줄의 Set 을 누르고 Ctrl+U 를 보내면 Undo 가 Ctrl+U 가 된다. 오브젝트를 만들고 Ctrl+U 로 되돌린다.
  Redo 에 같은 Ctrl+U 를 받으면 충돌을 묻는다(Cancel). 끝에 Reset All 로 재배치를 지운다. 저장 파일은 빈 상태 폴더의 editorbindings.xml(입력 맵 재배치 형식)이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/shortcuts.scenario.xml -unattended
-->
<Scenario name="editor.shortcuts" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus shortcuts"/>
	<EditorWaitStable/>
	<EditorClick mark="shortcuts.set.edit.undo"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+U"/>
	<WaitUntil watch="Editor.ShortcutOverrideCount" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus hierarchy"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.create"/>
	<WaitUntil watch="Editor.UndoIndex" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+U"/>
	<WaitUntil watch="Editor.UndoIndex" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus shortcuts"/>
	<EditorWaitStable/>
	<EditorClick mark="shortcuts.set.edit.redo"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+U"/>
	<WaitUntil watch="Editor.ShortcutConflictCount" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="shortcuts.cancel"/>
	<WaitUntil watch="Editor.ShortcutConflictCount" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.ShortcutOverrideCount" equals="1"/>
	<EditorWaitStable/>
	<EditorClick mark="shortcuts.resetAll"/>
	<WaitUntil watch="Editor.ShortcutOverrideCount" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- 받는 중에 창을 닫아도 명령 실행이 멈춘 채 남지 않는다(예전에는 에디터 단축키가 모두 죽었다). -->
	<EditorClick mark="shortcuts.set.edit.redo"/>
	<EditorWaitStable/>
	<DevCommand line="panel.close shortcuts"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus hierarchy"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.create"/>
	<WaitUntil watch="Editor.UndoIndex" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.UndoIndex" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
