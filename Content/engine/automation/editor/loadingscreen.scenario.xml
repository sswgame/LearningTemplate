<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 에디터가 멈춰 있는 동안(첫 Play 전) 게임이 연 로딩 화면이 게임 뷰를 덮지 않는다(panel-audit D3).
  로딩 화면은 게임 update 가 닫는데, 멈춘 에디터는 그 update 를 부르지 않는다 — 그 동안은 화면 UI 를 그리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/loadingscreen.scenario.xml -unattended
-->
<Scenario name="editor.loadingscreen" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<!-- 그림 판정의 크기는 UI 배율에 달렸다 — 모니터 DPI 와 상관없이 같게 둔다 -->
	<Variable name="gv_editorUiScale" value="1.5"/>
	<EditorWaitStable/>
	<Screenshot file="stopped.ppm"/>
	<EditorWaitStable/>
	<ExpectImage file="stopped.ppm" golden="stopped" region="0.3,0.3,0.9,0.9"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
