<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 체인 사이의 초기화 — 새 에디터 세션과 같은 출발점으로 되돌린다: 플레이 중지 · 시작 씬 다시 열기(되돌리기 스택 · 선택 · 변경 표시가 씬 교체와 함께 비워진다) · 창 크기(엔진 기본 1280x720 — 새 에디터의 시작 크기) · 배율 · 선택 패널(도구 · 확장)을 닫고 새 인스턴스로 바꾼다(연 문서 · 그래프 · 맵 같은 패널 상태가 새 세션 값이 된다) · 도크 레이아웃 · 씬 뷰 카메라(씬을 다시 열어도 이어지므로 `camera.reset`).
  `engine/automation/editor/*.scenario.xml` 을 한 프로세스로 묶을 때(`-scenario=reset,a,reset,b…`) 시나리오 사이에 끼운다. 혼자 돌려도 통과한다.
  초기화는 워크스페이스의 포커스 문서를 비우지 않는다 — 같은 시나리오를 한 체인에서 두 번 돌리면 둘째는 문서가 이미 열린 채 시작해 진다(체인은 시나리오마다 한 번). 엔진 서비스(예: 프로파일러 타임라인)도 비우지 않으므로 그 상태에 기대는 시나리오는 시작 단계에서 스스로 비운다.
  씬이 다시 열렸는지는 고정 프레임이 아니라 감시 값으로 기다린다 — 비동기 씬 로드가 끝나고(Scene.Transitioning) 오브젝트 수가 시작 씬의 값이며 되돌리기 · 변경 표시 · 선택이 비면 바로 다음 단계로 간다.
  창 크기 · 도크는 창이 자리 잡을 시간이 필요해 짧은 고정 간격을 둔다.
  실행: App -EnableEditor -scenario=engine/automation/editor/reset.scenario.xml -unattended
-->
<Scenario name="editor.chainreset" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<DevCommand line="stop"/>
	<Wait frames="2"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="600"/>
	<Wait frames="1"/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<Wait frames="1"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutFrames="900"/>
	<!-- 도크 레이아웃을 먼저 되돌린다 — 앞 시나리오가 Game 탭을 앞에 두었으면 씬 뷰가 그려지지 않아 에디터 카메라(오브젝트 수의 아홉째)가 생기지 않는다 -->
	<Wait frames="1"/>
	<ResizeWindow width="1280" height="720"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="panel.resetOptional"/>
	<DevCommand line="layout.reset"/>
	<DevCommand line="camera.reset"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.ObjectCount" equals="9" timeoutFrames="600"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.SceneDirty" equals="0" timeoutFrames="600"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.UndoCount" equals="0" timeoutFrames="600"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.SelectionCount" equals="0" timeoutFrames="600"/>
	<Wait frames="12"/>
	<EditorExpectObject name="TestParent" count="1"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<Expect watch="Editor.SceneDirty" equals="0"/>
	<Expect watch="Editor.SelectionCount" equals="0"/>
	<Expect watch="Editor.PlayState" equals="0"/>
	<Pass/>
</Scenario>
