<!--
  되돌리기 전수 — 거래를 받는 씬 명령(EditorCommandEdit::Scene · SceneDuringPlay)을 모두 실행하고 되돌린 뒤 씬 해시(Editor.SceneHash)가 처음과 같은지 본다.
  명령 동작은 형식으로 거래를 받는다(EditorSceneCommandActionFn — 레지스트리가 FScopedTransaction 처럼 연다). 형식이 막지 못하는 틈을 여기서 잡는다:
  ① 씬을 바꾸고 기록이 없음(Editor.UndoCoverageUnrecorded) ② 한 번 실행이 두 단계 이상(Editor.UndoCoverageSteps) ③ 되돌려도 해시가 다름(Editor.UndoCoverageMismatch).
  선택은 씬의 모든 씬 컴포넌트 오브젝트다 — 정렬 · 분산(둘 이상) · 복제 · 지우기 · 부모 풀기가 켜진다. 선택이 맞지 않아 꺼진 명령은 건너뛰고 로그(Editor.UndoCoverageSkipped)로 남긴다.
  건너뛰는 것은 이유와 함께 목록에 적은 둘뿐이다: prefab.applyOverrides(프리팹 파일을 쓰므로 씬 되돌리기가 파일까지 돌리지 않는다 — 언리얼도 에셋 저장은 트랜잭션 밖),
  play.keepChanges(재생 중에만 켜진다 — 재생 되돌리기는 playedit 시나리오가 본다). 그 밖에 켜지는 대상이 없는 명령은 실패다(Editor.UndoCoverageNoTarget) —
  명령마다 선택 전체 · 하나씩 · 컴포넌트마다를 대상으로 시도하고, 붙여넣기는 먼저 복사해 둔다. 부모 풀기 대상이 되게 메시 오브젝트에 자식 하나를 만들고, 컴포넌트 위아래 옮기기가 켜지게 그 자식에 컴포넌트 둘을 단다.
  실패 줄의 명령 id 로 그 명령을 고친다. 어느 오브젝트가 달라졌는지는 -gv_automationHashDump=1 로 오브젝트별 해시 로그를 본다.
  그 뒤 인스펙터 프로퍼티 전수(editor.undoCoverageProperties — 프로퍼티 단위 기록이 결합된 상태까지 되돌리는지)를 본다.
  둘째 단계는 문서 패널 전수(감사 E-16)다: 글 되돌리기를 가진 문서 패널마다 사본 문서를 열고 panel.expectUndoRoundTrip 이 문서 글을 되돌리기와 같은 길로
  다시 적용 → 다시 직렬화해 같은 글인지 본다(다르면 Ctrl+Z 가 문서를 다른 상태로 돌린다). 문서는 저장 왕복 시나리오(saveroundtrip*)와 같은 원본의 실행마다 새 사본이다.
  문서 글이 아니라 창 안 기록(카탈로그 · 어빌리티 카탈로그)이나 모델 명령(UI 미리보기)으로 되돌리는 패널은 글 왕복이 없어 이 단계가 아니다.
  실행: App -EnableEditor -scenario=engine/automation/editor/undocoverage.scenario.xml -unattended
-->
<Scenario name="editor.undocoverage" fixedDelta="0.0166667" timeoutFrames="5400" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/materialpreview" as="scratch/undocoveragematerial"/>
	<Scratch from="engine/automation/editor/sequencerkeys" as="scratch/undocoveragesequencer"/>
	<Scratch from="engine/automation/editor/spriteclipregion" as="scratch/undocoveragespriteclip"/>
	<Scratch from="engine/automation/editor/audiograph" as="scratch/undocoverageaudiograph"/>
	<Scratch from="game/playground/data/vocabulary" as="scratch/undocoveragebehaviortree"/>
	<Scratch from="game/playground/audio" as="scratch/undocoverageaudioevents"/>
	<Scratch from="engine/input" as="scratch/undocoverageinputmap"/>
	<Scratch from="engine/environment" as="scratch/undocoveragedatatable"/>
	<Scratch from="engine/physics" as="scratch/undocoveragephysics"/>
	<Scratch from="engine/physics/samples" as="scratch/undocoveragephysicsasset"/>
	<Scratch from="engine/automation/editor/tilesetedit" as="scratch/tilesetedit"/>
	<Scratch from="game/playground/materials/matgraph" as="scratch/materials/undocoveragematgraph"/>
	<Scratch from="common/rigs" as="scratch/undocoverageretarget"/>
	<Scratch from="engine/automation/editor/vfxautoreload" as="scratch/undocoveragevfx"/>
	<DevCommand line="scene.open game/playground/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<!-- 되돌리기 감시 값은 포커스 창의 스택이다 — 씬 뷰에 두어 메인(씬) 스택을 읽는다(배치를 되돌린 뒤 문서 창이 포커스일 수 있다) -->
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.UndoCount" equals="0" timeoutFrames="600"/>
	<DevCommand line="select.type MeshComponent"/>
	<WaitUntil watch="Editor.SelectionCount" atLeast="1" timeoutFrames="30"/>
	<DevCommand line="editor scene.object.createChild"/>
	<EditorWaitStable/>
	<!-- 새 자식이 고른 것이 된다 — 주 씬 컴포넌트 밖 컴포넌트 둘을 달아 컴포넌트 위아래 옮기기가 켜지게 한다 -->
	<DevCommand line="component.add PointLightComponent"/>
	<DevCommand line="component.add TypedHandleTestComponent"/>
	<EditorWaitStable/>
	<DevCommand line="select.type SceneComponent"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectionCount" atLeast="2"/>
	<Store watch="Editor.SceneHash" as="start"/>
	<DevCommand line="editor.undoCoverage prefab.applyOverrides play.keepChanges"/>
	<EditorWaitStable/>
	<ExpectLog id="Editor.UndoCoverageResult" count="1"/>
	<ExpectLog id="Editor.UndoCoverageUnrecorded" count="0"/>
	<ExpectLog id="Editor.UndoCoverageSteps" count="0"/>
	<ExpectLog id="Editor.UndoCoverageMismatch" count="0"/>
	<ExpectLog id="Editor.UndoCoverageNoTarget" count="0"/>
	<ExpectLog id="Editor.UndoCoverageSkipped" count="2"/>
	<Expect watch="Editor.SceneHash" sameAs="start"/>
	<!-- 인스펙터 프로퍼티 전수(설계 E-7) — 고른 오브젝트 · 컴포넌트의 프로퍼티마다 인스펙터 편집 모델로 한 번 고치고 되돌려 씬 해시를 맞댄다.
	     값 글 하나로 되돌리는 기록이 한 쓰기가 고친 다른 상태(onPropertyChanged)를 놓치면 PropertyMismatch 로 그 프로퍼티 이름이 나온다 -->
	<DevCommand line="editor.undoCoverageProperties"/>
	<EditorWaitStable/>
	<ExpectLog id="Editor.UndoCoveragePropertyResult" count="1"/>
	<ExpectLog id="Editor.UndoCoveragePropertyUnrecorded" count="0"/>
	<ExpectLog id="Editor.UndoCoveragePropertySteps" count="0"/>
	<ExpectLog id="Editor.UndoCoveragePropertyMismatch" count="0"/>
	<Expect watch="Editor.SceneHash" sameAs="start"/>
	<!-- 문서 패널 전수 — 패널마다 사본을 열고 되돌리기 왕복을 본다 -->
	<DevCommand line="panel.focus material"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragematerial/previewblue.material"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip material"/>
	<DevCommand line="panel.focus sequencer"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragesequencer/sequencerkeys.seq.xml"/>
	<WaitUntil watch="Editor.SequencerBindingCount" equals="1" timeoutFrames="120"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip sequencer"/>
	<DevCommand line="panel.focus sprite_clip"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragespriteclip/hero.sprite.xml"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="2" timeoutFrames="120"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip sprite_clip"/>
	<DevCommand line="panel.focus audiograph"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoverageaudiograph/tone.audiograph.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip audiograph"/>
	<DevCommand line="panel.focus behavior_tree"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragebehaviortree/guard.bt.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip behavior_tree"/>
	<DevCommand line="panel.focus audioevents"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoverageaudioevents/playground.audioevents.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.AudioEventEditCount" atLeast="1" timeoutFrames="60"/>
	<DevCommand line="panel.expectUndoRoundTrip audioevents"/>
	<DevCommand line="panel.focus input_map"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoverageinputmap/default.input.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip input_map"/>
	<DevCommand line="panel.focus data_table"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragedatatable/default.surfacekinds.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.DataTableGameDataRowCount" atLeast="1" timeoutWallSeconds="10"/>
	<DevCommand line="panel.expectUndoRoundTrip data_table"/>
	<DevCommand line="panel.focus collision_responses"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragephysics/physicssettings.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip collision_responses"/>
	<DevCommand line="panel.focus tileset_editor"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/tilesetedit/town.tileset.xml"/>
	<WaitUntil watch="Editor.TileSetBrushCount" equals="3" timeoutFrames="120"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip tileset_editor"/>
	<!-- 맵이 가리키는 타일셋이 scratch/tilesetedit 의 것이라 사본 폴더 이름이 정해져 있다 -->
	<DevCommand line="panel.focus tile_map"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/tilesetedit/town.tilemap.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip tile_map"/>
	<DevCommand line="panel.focus materialgraph"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/materials/undocoveragematgraph/rim_glow.matgraph.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip materialgraph"/>
	<DevCommand line="panel.focus charactereditor.retarget"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoverageretarget/knight_to_minion.retarget.xml"/>
	<WaitUntil watch="Editor.RetargetChainCount" atLeast="6" timeoutFrames="195"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip charactereditor.retarget"/>
	<DevCommand line="panel.focus vfx_preview"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragevfx/autoreload.vfx.xml"/>
	<WaitUntil watch="Editor.VFXEmitterCount" equals="2" timeoutFrames="120"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip vfx_preview"/>
	<DevCommand line="panel.focus ragdoll_preview"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/undocoveragephysicsasset/chain.physics.xml"/>
	<WaitUntil watch="Editor.RagdollPreviewDocumentBodies" equals="3" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="panel.expectUndoRoundTrip ragdoll_preview"/>
	<Expect watch="Editor.DirtyDocumentCount" equals="0"/>
	<Pass/>
</Scenario>
