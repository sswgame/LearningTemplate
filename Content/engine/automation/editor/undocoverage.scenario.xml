<?xml version="1.0" encoding="utf-8"?>
<!--
  되돌리기 전수 — 거래를 받는 씬 명령(EditorCommandEdit::Scene · SceneDuringPlay)을 모두 실행하고 되돌린 뒤 씬 해시(Editor.SceneHash)가 처음과 같은지 본다.
  명령 동작은 형식으로 거래를 받는다(EditorSceneCommandActionFn — 레지스트리가 FScopedTransaction 처럼 연다). 형식이 막지 못하는 틈을 여기서 잡는다:
  ① 씬을 바꾸고 기록이 없음(Editor.UndoCoverageUnrecorded) ② 한 번 실행이 두 단계 이상(Editor.UndoCoverageSteps) ③ 되돌려도 해시가 다름(Editor.UndoCoverageMismatch).
  선택은 씬의 모든 씬 컴포넌트 오브젝트다 — 정렬 · 분산(둘 이상) · 복제 · 지우기 · 부모 풀기가 켜진다. 선택이 맞지 않아 꺼진 명령은 건너뛰고 로그(Editor.UndoCoverageSkipped)로 남긴다.
  실패 줄의 명령 id 로 그 명령을 고친다. 어느 오브젝트가 달라졌는지는 -gv_automationHashDump=1 로 오브젝트별 해시 로그를 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/undocoverage.scenario.xml -unattended
-->
<Scenario name="editor.undocoverage" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitSettled/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.UndoCount" equals="0" timeoutFrames="600"/>
	<DevCommand line="select.type SceneComponent"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectionCount" atLeast="2"/>
	<Remember watch="Editor.SceneHash" as="start"/>
	<DevCommand line="editor.undoCoverage"/>
	<EditorWaitSettled/>
	<ExpectLog id="Editor.UndoCoverageResult" count="1"/>
	<ExpectLog id="Editor.UndoCoverageUnrecorded" count="0"/>
	<ExpectLog id="Editor.UndoCoverageSteps" count="0"/>
	<ExpectLog id="Editor.UndoCoverageMismatch" count="0"/>
	<Expect watch="Editor.SceneHash" sameAs="start"/>
</Scenario>
