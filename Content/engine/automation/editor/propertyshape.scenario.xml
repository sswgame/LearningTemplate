<?asset guid="371505d8d8a54d73b51dec72e96ba7cf"?>
<!--
  에디터 시나리오 — 선언형 모양 손잡이: TestMesh 에 PointLightComponent 를 붙이면 반경 프로퍼티의 메타(`Shape=Sphere`)만으로 Shapes(property_shapes, 기본 켜짐)가
  반경 구와 손잡이 여섯 개를 세운다(표식 propertyshape.handle.<프로퍼티>.<축><부호>). +X 손잡이를 끌면 반경이 바뀌고 되돌리기 하나가 남으며
  (Editor.PropertyShapeCommitCount), Ctrl+Z 로 반경이 처음 값으로 돌아온다. 끈 방향은 카메라에 따라 달라 늘었는지 줄었는지는 보지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/propertyshape.scenario.xml -unattended
-->
<Scenario name="editor.propertyshape" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestMesh"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PropertyShapeHandleCount" equals="0"/>
	<DevCommand line="component.add PointLightComponent"/>
	<WaitUntil watch="Editor.PropertyShapeHandleCount" equals="6" timeoutFrames="60"/>
	<Store watch="Editor.PropertyShapeNumber" as="radiusBefore"/>
	<EditorWaitStable/>
	<EditorDrag mark="propertyshape.handle._radius.x+" dx="60" dy="0"/>
	<WaitUntil watch="Editor.PropertyShapeCommitCount" equals="1" timeoutFrames="150"/>
	<Expect watch="Editor.PropertyShapeNumber" differsFrom="radiusBefore"/>
	<Expect watch="Editor.UndoCount" atLeast="1"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.PropertyShapeNumber" sameAs="radiusBefore" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
