<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰를 눌러도 화면을 그리는 에디터 카메라가 골라지지 않는다. 에디터 카메라는 씬 오브젝트라
  기본 반지름 구가 레이 시작점을 감싸 늘 가장 가까웠다(panel-audit D1).
  테스트 씬(editortest)의 큐브(TestMesh)를 눌러 바로 그 큐브가 골라지는지 본다 — "에디터 카메라가 아니다"만으로는
  아무것도 안 골라져도 통과했다. 큐브 자리(1920x1080 · 배율 1 · 기본 배치에서 캔버스 0.5,0.68)는 viewporthover 와 같다.
  이어서 피킹이 경계 구가 아니라 메시로 고르는지 본다(감사 E-10). 두 씬 모두 같은 기본 카메라(camera.reset)에서 원점이 캔버스 0.5,0.68 이다.
  (1) pickpillar — 원점의 긴 기둥(0.1 x 6 x 0.1, 경계 구 반지름 약 5 m). 옆 빈 곳(0.56,0.68 — 기둥에서 0.5 m 넘게 떨어짐)은 아무것도 고르지 않고, 기둥은 고른다.
  (2) pickfloor — 바닥(8 m, 경계 구가 카메라 앞에서 먼저 맞는다)과 원점의 작은 큐브. 큐브 자리는 큐브, 그 앞의 바닥 자리(0.5,0.9)는 바닥이다.
  끝에 editortest 와 기본 카메라로 돌려놓는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/viewportpick.scenario.xml -unattended
-->
<Scenario name="editor.viewportpick" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectionCount" equals="0"/>
	<EditorClick mark="sceneView.canvas" anchor="0.5,0.68"/>
	<WaitUntil watch="Editor.SelectedNames" is="TestMesh" timeoutFrames="60"/>
	<Expect watch="Editor.SelectedIsEditorCamera" equals="0"/>
	<EditorWaitSettled/>
	<!-- 선택을 풀면 기즈모를 그리지 않는다. 그 자리를 다시 누르면 다시 집힌다 - 그리지 않은 기즈모가 클릭을 가로채면 안 된다 -->
	<EditorClick mark="sceneView.canvas" anchor="0.02,0.4"/>
	<WaitUntil watch="Editor.SelectionCount" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="sceneView.canvas" anchor="0.5,0.68"/>
	<WaitUntil watch="Editor.SelectedNames" is="TestMesh" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open game/empty/maps/pickpillar.scene.xml"/>
	<EditorWaitSettled/>
	<DevCommand line="camera.reset"/>
	<EditorWaitSettled/>
	<EditorClick mark="sceneView.canvas" anchor="0.56,0.68"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectionCount" equals="0"/>
	<EditorClick mark="sceneView.canvas" anchor="0.5,0.68"/>
	<WaitUntil watch="Editor.SelectedNames" is="Pillar" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open game/empty/maps/pickfloor.scene.xml"/>
	<EditorWaitSettled/>
	<DevCommand line="camera.reset"/>
	<EditorWaitSettled/>
	<EditorClick mark="sceneView.canvas" anchor="0.5,0.68"/>
	<WaitUntil watch="Editor.SelectedNames" is="SmallCube" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="sceneView.canvas" anchor="0.5,0.9"/>
	<WaitUntil watch="Editor.SelectedNames" is="Floor" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<DevCommand line="camera.reset"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
