<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 미리보기 창을 연 채 백엔드를 건넌다(다중 월드 6절 6번). 교체(메뉴 · 콘솔 · 단계 SwapBackend 가 같은 길 — gv_rhiBackend 변경 → 프레임 끝의 RHIBackendSwitcher::applyIfPending)는
  렌더 워커를 비우고 모듈 인스턴스(에디터 포함)를 내린 뒤 디바이스를 다시 만들고 모듈을 다시 세운다. 미리보기 창이 쥔 씬 · 렌더 타깃 · 씬별 렌더러(FrameRenderer 의 미리보기 렌더러 목록)가 이 길을 지난다.
  이 시나리오는 같은 길을 단계 `SwapBackend` 로 창이 열린 프레임에 요청한다.
  ① 머티리얼 창에 빨간 테스트 머티리얼을 열어 구 미리보기가 그려지게 한다(렌더러 시작 줄 하나, 미리보기 타깃을 gv_editorPreviewScreenshot 으로 before 에 저장).
  ② 창이 열린 채 다른 백엔드로 건넌다(SwapBackend other). 교체가 실패하지 않았고(RHI.SwapFailedCount) 모듈이 묶여 있어야 한다.
  ③ 교체 뒤 같은 문서를 다시 연다 — 에디터 인스턴스가 다시 서서 창이 닫혀 있거나 문서가 없어도, 그대로여도 같은 단계가 통과한다(Quick Open 은 이미 연 문서를 다시 열어도 같다). 프레임 수 감시 값이 다시 오르고, 새 디바이스 위에 새 렌더러가 선다.
  타깃을 after1 에 저장한다. ④ 창이 열린 채 시작 백엔드로 돌아와 같은 확인을 한 번 더 한다(after2).
  "렌더러가 새 디바이스에 섰다" 는 로그 id Renderer.OffscreenStarted 줄의 수(교체마다 하나씩 는다)로, "타깃이 있고 요청이 갔다" 는 PreviewViewport.Screenshot 줄의 수로 본다.
  교체 뒤 살아 있는 미리보기 렌더러 수(감시 값 Editor.ScenePreviewRenderers)가 교체 앞과 같아야 한다 - 옛 디바이스의 렌더러가 남거나 창 하나에 둘이 서면 수가 다르다.
  그림이 맞는지(빨간 구 + 바닥, 빈 타깃이 아님)는 저장한 PPM 을 눈으로 본다 — 평균 색의 문턱값은 GPU 로 돌려 보기 전에는 맞출 수 없어 자동 단언을 두지 않았다. 파일: {out}/previewswap_<before|after1|after2>.ppm.
  어느 백엔드로 시작해도 된다(other 는 그 플랫폼의 다른 백엔드 — Windows 는 DX12 ↔ DX11, Linux 는 Vulkan ↔ OpenGL). 백엔드 교체가 없는 환경에서는 SwapBackend 가 준비 단계에서 거절해 진다.
  실행: App -EnableEditor -scenario=engine/automation/editor/previewswap.scenario.xml -unattended (백엔드 vk · gl 로 시작해도 같다)
-->
<Scenario name="editor.previewswap" fixedDelta="0.0166667" timeoutFrames="4000" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchPanel" value="material"/>
	<!-- ① 문서를 열어 구 미리보기가 그려지게 한 뒤 교체 앞의 타깃을 저장한다 -->
	<EditorWaitStable/>
	<Variable name="gv_editorWatchAsset" value="engine/automation/editor/materialpreview/previewred.material"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="previewred.material"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus material"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" atLeast="40" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Variable name="gv_editorPreviewScreenshot" value="{out}/previewswap_before.ppm"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<ExpectLog id="Renderer.OffscreenStarted" atLeast="1"/>
	<ExpectLog id="PreviewViewport.Screenshot" atLeast="1"/>
	<Store watch="Editor.ScenePreviewRenderers" as="renderers"/>
	<!-- ② 창이 열린 채 다른 백엔드로 건넌다 -->
	<EditorWaitStable/>
	<SwapBackend backend="other"/>
	<EditorWaitStable/>
	<WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/>
	<EditorWaitStable/>
	<Expect watch="RHI.SwapFailedCount" equals="0"/>
	<Expect watch="Module.BindingsOk" equals="1"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<!-- ③ 교체 뒤 같은 문서를 다시 열고 창을 앞으로 가져온다. 새 렌더러가 서서 프레임이 다시 오르고 타깃이 그려진다 -->
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="previewred.material"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus material"/>
	<EditorWaitStable/>
	<Store watch="Editor.MaterialPreviewSceneFrames" as="frames"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" differsFrom="frames" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Variable name="gv_editorPreviewScreenshot" value="{out}/previewswap_after1.ppm"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" atLeast="30" timeoutFrames="300"/>
	<ExpectLog id="Renderer.OffscreenStarted" atLeast="2"/>
	<Expect watch="Editor.ScenePreviewRenderers" sameAs="renderers"/>
	<ExpectLog id="PreviewViewport.Screenshot" atLeast="2"/>
	<!-- ④ 창이 열린 채 시작 백엔드로 돌아온다 -->
	<EditorWaitStable/>
	<SwapBackend backend="start"/>
	<EditorWaitStable/>
	<WaitUntil watch="RHI.SwapPending" equals="0" timeoutFrames="900"/>
	<EditorWaitStable/>
	<Expect watch="RHI.SwapFailedCount" equals="0"/>
	<Expect watch="Module.BindingsOk" equals="1"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="previewred.material"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus material"/>
	<EditorWaitStable/>
	<Store watch="Editor.MaterialPreviewSceneFrames" as="frames"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" differsFrom="frames" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Variable name="gv_editorPreviewScreenshot" value="{out}/previewswap_after2.ppm"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" atLeast="30" timeoutFrames="300"/>
	<ExpectLog id="Renderer.OffscreenStarted" atLeast="3"/>
	<Expect watch="Editor.ScenePreviewRenderers" sameAs="renderers"/>
	<ExpectLog id="PreviewViewport.Screenshot" atLeast="3"/>
	<!-- ⑤ 마지막: 다른 패널도 정상으로 그려진다 -->
	<EditorWaitStable/>
	<DevCommand line="panel.close material"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitStable/>
	<Expect watch="RHI.SwapFailedCount" equals="0"/>
	<EditorClick mark="hierarchy.filter"/>
	<CaptureEditorUI file="previewswap/final.png"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
