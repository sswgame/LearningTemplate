<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터 이름 칸은 Enter 없이 떠나도(다른 곳을 누름) 친 이름을 적용한다(panel-audit D10, 유니티 · 언리얼과 같다).
  실행: App -EnableEditor -scenario=engine/automation/editor/inspectorrename.scenario.xml -unattended
-->
<Scenario name="editor.inspectorrename" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="60"/>
	<DevCommand line="editor scene.new"/>
	<EditorClick mark="hierarchy.create"/>
	<EditorClick mark="inspector.name"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="Blurred"/>
	<!-- Enter 없이 다른 칸(Hierarchy 검색)을 눌러 떠난다 -->
	<EditorClick mark="hierarchy.filter"/>
	<Wait frames="15"/>
	<EditorExpectObject name="Blurred"/>
	<Expect watch="Editor.UndoCount" equals="2"/>
	<Pass/>
</Scenario>
