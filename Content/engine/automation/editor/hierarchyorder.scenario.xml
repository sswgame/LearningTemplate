<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Hierarchy 형제 순서와 폴더: TestSprite(셋째 줄)를 고르고 scene.moveSiblingUp 으로 한 칸 올리면 둘째 줄이 되고, 되돌리면 셋째 줄로 돌아온다.
  scene.moveSiblingDown 은 한 칸 내려 간다. scene.createFolder 는 빈 폴더 오브젝트를 하나 만들고(오브젝트 수 +1) 되돌리기 한 줄로 사라진다.
  (끌어 놓기는 ImGui 끌기 · 놓기라 EditorTest 의 EditorSiblingOrderTest 가 놓는 자리 판정과 옮기기를 본다.)
  실행: App -EnableEditor -scenario=engine/automation/editor/hierarchyorder.scenario.xml -unattended
-->
<Scenario name="editor.hierarchyorder" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="25"/>
	<EditorClick mark="hierarchy.row.TestSprite"/>
	<Wait frames="15"/>
	<Variable name="gv_editorWatchHierarchyObject" value="TestSprite"/>
	<Expect watch="Editor.HierarchyRowIndex" equals="2"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<Wait frames="5"/>
	<DevCommand line="editor scene.moveSiblingUp"/>
	<Wait frames="20"/>
	<Expect watch="Editor.HierarchyRowIndex" equals="1"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="20"/>
	<Expect watch="Editor.HierarchyRowIndex" equals="2"/>
	<Expect watch="Editor.UndoIndex" equals="0"/>
	<Wait frames="5"/>
	<DevCommand line="editor scene.moveSiblingDown"/>
	<Wait frames="20"/>
	<Expect watch="Editor.HierarchyRowIndex" equals="3"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="20"/>
	<Expect watch="Editor.HierarchyRowIndex" equals="2"/>
	<Wait frames="5"/>
	<Expect watch="Editor.ObjectCount" equals="9"/>
	<Wait frames="5"/>
	<DevCommand line="editor scene.createFolder"/>
	<Wait frames="20"/>
	<Expect watch="Editor.ObjectCount" equals="10"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="20"/>
	<Expect watch="Editor.ObjectCount" equals="9"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
