<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — RenderDoc 단추(EditorPlus G3): -renderdoc 없이 띄우면 RenderDoc 이 붙지 않고, 상단 툴바의 회색 단추를 눌러도 아무 일이 없다.
  좁힌 창(900x720)에 UI 배율 1.5 면 단추가 툴바 줄에 들지 않아 ">>" 넘침 펼침에 있다 — 펼침을 열고 누른다(넘침이 없으면 표식이 없어 진다).
  배율을 적어 두는 까닭: 기본 배율(0)은 모니터 DPI 를 따라 기계마다 넘침 여부가 달라진다.
  실제 캡처는 RenderDoc 이 설치된 기계에서만 되므로 시나리오에 넣지 않는다(App.exe -dx12 -renderdoc -EnableEditor → 단추 → Saved/RenderDoc/*.rdc).
  실행: App -EnableEditor -scenario=engine/automation/editor/renderdocbutton.scenario.xml -unattended
-->
<Scenario name="editor.renderdocbutton" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<EditorWaitStable/>
	<!-- 넘침을 툴바 길이에 맡기지 않는다 — 툴바 단추가 줄면(예: Cam 체크 상자 → 아이콘) 1280 폭에 다 들어가 넘침이 사라졌다. 좁은 창이면 늘 넘친다. -->
	<ResizeWindow width="900" height="720"/>
	<Variable name="gv_editorUiScale" value="1.5"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<Expect watch="Editor.RenderDocAvailable" equals="0"/>
	<EditorClick mark="toolbar.overflow"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.renderDoc"/>
	<EditorWaitStable/>
	<ExpectLog id="RenderDoc.CaptureRequested" count="0"/>
	<Expect watch="Editor.RenderDocAvailable" equals="0"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
