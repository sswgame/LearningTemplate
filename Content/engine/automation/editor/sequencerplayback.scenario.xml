<!--
  에디터 시나리오 — Sequencer 재생 단추: 테스트 씬(sequencerkeys/sequencerkeys.scene.xml — Director 의 플레이어가 바인딩 1 을 Mover 에 묶는다)에서 테스트 시퀀스를 열고
  Mover 의 위치 X 를 프레임 0 에 0, 100 에 10 으로 키 찍은 뒤(sequencerkeys 와 같은 손놀림) 단추마다 시간 표시(Editor.SequencerFrame)와 뷰포트(Editor.ObjectPositionX)가 바뀌는지 본다.
  ① 스크럽: 시간 막대 가운데를 누르면 그 프레임이고 Mover 가 두 키 사이다. ② 재생: 프레임이 나아간다. ③ 일시정지: 프레임이 서 있다.
  ④ 거꾸로 재생: 거꾸로 표시가 서고 프레임이 바뀐다. ⑤ 정지: 처음 프레임이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/sequencerplayback.scenario.xml -unattended (체인: ctest -R Scenario.editor)
-->
<Scenario name="editor.sequencerplayback" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open engine/automation/editor/sequencerkeys/sequencerkeys.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchObject" value="Mover"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="sequencerkeys.seq.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="0"/>
	<Expect watch="Editor.SequencerFrame" equals="0"/>
	<Expect watch="Editor.SequencerPlaying" equals="0"/>
	<!-- 키 둘: 0 프레임 X 0, 100 프레임 X 10 -->
	<EditorClick mark="sequencer.addKey"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="0"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.ObjectPositionX" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="100"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SequencerFrame" equals="100" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="10"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="2" timeoutFrames="60"/>

	<!-- ① 스크럽 -->
	<EditorClick mark="sequencer.scrub"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SequencerFrame" atLeast="35"/>
	<Expect watch="Editor.SequencerFrame" atMost="65"/>
	<Expect watch="Editor.ObjectPositionX" atLeast="2"/>
	<Expect watch="Editor.ObjectPositionX" atMost="8"/>
	<Store watch="Editor.SequencerFrame" as="scrubFrame"/>
	<Store watch="Editor.ObjectPositionX" as="scrubX"/>

	<!-- ② 재생 -->
	<EditorClick mark="sequencer.play"/>
	<WaitUntil watch="Editor.SequencerPlaying" equals="1" timeoutFrames="10"/>
	<Expect watch="Editor.SequencerReversed" equals="0"/>
	<WaitUntil watch="Editor.SequencerFrame" differsFrom="scrubFrame" timeoutFrames="30"/>
	<WaitUntil watch="Editor.ObjectPositionX" differsFrom="scrubX" timeoutFrames="30"/>

	<!-- ③ 일시정지 — 정지 상태에서 본 값이 그 답이다 -->
	<EditorClick mark="sequencer.pause"/>
	<WaitUntil watch="Editor.SequencerPlaying" equals="0" timeoutFrames="10"/>
	<Store watch="Editor.SequencerFrame" as="pausedFrame"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SequencerFrame" sameAs="pausedFrame"/>

	<!-- ④ 거꾸로 재생 -->
	<EditorClick mark="sequencer.playReverse"/>
	<WaitUntil watch="Editor.SequencerReversed" equals="1" timeoutFrames="10"/>
	<Expect watch="Editor.SequencerPlaying" equals="1"/>
	<WaitUntil watch="Editor.SequencerFrame" differsFrom="pausedFrame" timeoutFrames="30"/>
	<EditorClick mark="sequencer.pause"/>
	<WaitUntil watch="Editor.SequencerPlaying" equals="0" timeoutFrames="10"/>

	<!-- ⑤ 정지 -->
	<EditorClick mark="sequencer.stop"/>
	<WaitUntil watch="Editor.SequencerFrame" equals="0" timeoutFrames="10"/>
	<Expect watch="Editor.SequencerPlaying" equals="0"/>
	<Expect watch="Editor.SequencerReversed" equals="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
