<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 뷰포트 조작 기본기(N1): 메시 오브젝트를 고르면 씬 뷰에 선택 상자가 그려지고(Editor.SelectionOutlineBoxes), 씬 뷰 위에서 E · R · W · Q 로
  기즈모 모드가 바뀐다. 키패드 7 은 위에서 보는 직교 보기, 5 는 원근으로 되돌린다. Shift+Space 는 씬 뷰를 최대화하고(다른 패널이 닫힘) 다시 누르면 되살린다.
  키 입력은 씬 뷰의 호버를 보므로 가운데 단추를 씬 뷰 빈 곳에 누른 채 둔다(state="down" 이 커서를 그 자리에 붙잡는다 — 가운데 단추는 뷰포트가 쓰지 않는다).
  실행: App -EnableEditor -scenario=engine/automation/editor/viewportbasics.scenario.xml -unattended
-->
<Scenario name="editor.viewportbasics" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="25"/>
	<DevCommand line="select.type MeshComponent"/>
	<Wait frames="10"/>
	<EditorClick mark="sceneView.canvas" button="2" anchor="0.05,0.95" state="down"/>
	<WaitUntil watch="Editor.SelectionOutlineBoxes" atLeast="1" timeoutFrames="60"/>
	<Variable name="gv_editorWatchPanel" value="hierarchy"/>
	<Wait frames="5"/>
	<EditorKey key="E"/>
	<WaitUntil watch="Editor.GizmoOperation" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorKey key="R"/>
	<WaitUntil watch="Editor.GizmoOperation" equals="2" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorKey key="Q"/>
	<WaitUntil watch="Editor.GizmoOperation" equals="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorKey key="Keypad7"/>
	<WaitUntil watch="Editor.SceneViewOrthographic" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorKey key="Keypad5"/>
	<WaitUntil watch="Editor.SceneViewOrthographic" equals="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorKey key="Shift+Space"/>
	<WaitUntil watch="Editor.SceneViewMaximized" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="2" state="up"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="2" anchor="0.05,0.95" state="down"/>
	<Wait frames="10"/>
	<EditorKey key="Shift+Space"/>
	<Wait frames="5"/>
	<EditorClick mark="toolbar.play" button="2" state="up"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SceneViewMaximized" equals="0"/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
