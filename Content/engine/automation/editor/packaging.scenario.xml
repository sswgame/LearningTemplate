<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 패키징 창(T4): Skip build 와 Skip cook 을 켜고 Package 를 누르면 Scripts/dev/MakePackage.py 가 새 프로세스로 돌아
  이 에디터의 Bin 을 Saved/Packages/<게임>-Client 에 스테이징하고 검사한다(빌드 · 쿠킹이 없어 수 초). 끝나면 Editor.PackagingState 가 2(성공)다.
  실제 Shipping 패키징은 PythonTest_TestMakePackage 와 손 실행(Scripts/dev/MakePackage.py 를 Client 타깃으로)으로 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/packaging.scenario.xml -unattended
-->
<Scenario name="editor.packaging" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="10"/>
	<DevCommand line="panel.focus packaging"/>
	<Wait frames="30"/>
	<Expect watch="Editor.PackagingState" equals="0"/>
	<!-- 체크 · 단추는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<Wait frames="5"/>
	<EditorClick mark="packaging.skipBuild" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="packaging.skipBuild" state="up"/>
	<Wait frames="7"/>
	<EditorClick mark="packaging.skipCook" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="packaging.skipCook" state="up"/>
	<Wait frames="7"/>
	<EditorClick mark="packaging.package" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="packaging.package" state="up"/>
	<Wait frames="12"/>
	<Expect watch="Editor.PackagingState" equals="1"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.PackagingState" equals="2" timeoutFrames="1400"/>
	<Wait frames="10"/>
	<Expect watch="Editor.PackagingState" equals="2"/>
	<ExpectLog contains="Packaging done:" count="1"/>
	<CaptureEditorUI file="packaging.png"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
