<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 ③ Hierarchy 검색 — 검색 칸을 눌러 치면 `tag:` 필터가 부모 태그로 자식 태그를 찾고(대소문자 무시), 없는 태그는 0 건 안내를 그린다.
  태그는 개발 명령 tag.add 로 단다(태그 편집 위젯은 이 시나리오의 대상이 아니다).
  실행: App -EnableEditor -scenario=engine/automation/editor/hierarchyfilter.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.hierarchyfilter" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<Wait frames="60"/>
	<DevCommand line="editor scene.new"/>
	<Wait frames="20"/>
	<EditorClick mark="hierarchy.create"/>
	<Wait frames="10"/>
	<DevCommand line="tag.add GameObject Scenario.Probe.Child"/>
	<!-- 부모 태그로 자식 태그를 찾는다 -->
	<Wait frames="10"/>
	<EditorClick mark="hierarchy.filter"/>
	<Wait frames="10"/>
	<EditorText value="tag:Scenario.Probe"/>
	<WaitUntil watch="Editor.HierarchyVisibleRoots" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="0"/>
	<!-- 지우고 소문자로 — 대소문자를 가리지 않는다 -->
	<Wait frames="5"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorKey key="Backspace"/>
	<Wait frames="5"/>
	<EditorText value="tag:scenario.probe.child"/>
	<WaitUntil watch="Editor.HierarchyVisibleRoots" equals="1" timeoutFrames="60"/>
	<!-- 없는 태그 — 루트가 없고 0 건 안내를 그린다 -->
	<Wait frames="5"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorKey key="Backspace"/>
	<Wait frames="5"/>
	<EditorText value="tag:Scenario.Missing"/>
	<WaitUntil watch="Editor.HierarchyVisibleRoots" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="1"/>
	<!-- 칸을 비우면 다시 보인다 -->
	<Wait frames="5"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorKey key="Backspace"/>
	<WaitUntil watch="Editor.HierarchyVisibleRoots" atLeast="1" timeoutFrames="60"/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="0"/>
	<Pass/>
</Scenario>
