<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 월드 셀 패널(world_cells): 패널을 열면 그려지고(에디터 UI 캡처에 마젠타 자리표시가 없다) 닫으면 닫힌다. 셀이 없는 씬(기본 에디터 씬)에서도 빈 표로 그려져야 한다.
  열기 · 닫기만 본다 — 셀 행(worldCells.cell.N)과 미리보기(worldCells.preview)는 월드 파티션 씬이 필요해 이 시나리오는 누르지 않는다.
  연 뒤 그려지는 것은 조건 대기(Editor.PanelOpen)로 기다린다. 이 패널은 열기만 해서는 로그를 남기지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/worldcellspanel.scenario.xml -unattended
-->
<Scenario name="editor.worldcellspanel" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchPanel" value="world_cells"/>
	<Wait frames="1"/>
	<DevCommand line="panel.focus world_cells"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutSeconds="10"/>
	<!-- 눈 확인용(GPU 검증): 열린 월드 셀 패널 -->
	<Wait frames="1"/>
	<CaptureEditorUI file="worldcellspanel/open.png" maxMagentaFraction="0"/>
	<Wait frames="1"/>
	<DevCommand line="panel.close world_cells"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.PanelOpen" equals="0" timeoutSeconds="10"/>
	<Wait frames="1"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
