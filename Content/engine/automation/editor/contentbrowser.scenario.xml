<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 콘텐츠 브라우저(A1): 게임 루트는 활성 팩 하나이고, All packs 를 켜면 game/ 의 팩이 모두 루트가 된다.
  참조 역색인이 다 만들어지면 활성 팩의 crate_medium.mesh 를 오른쪽 클릭해 Find References 를 누르고, 그 메시를 쓰는 씬이 결과에 나오는지 본다.
  CaptureEditorUI 의 PNG({out}/)는 결과 창까지 든 화면이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/contentbrowser.scenario.xml -unattended
-->
<Scenario name="editor.contentbrowser" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitStable/>
	<Expect watch="Editor.ContentGameRootCount" equals="1"/>
	<!-- 체크박스는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.allPacks" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.allPacks" state="Up"/>
	<WaitUntil watch="Editor.ContentGameRootCount" atLeast="2" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.allPacks" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.allPacks" state="Up"/>
	<WaitUntil watch="Editor.ContentGameRootCount" equals="1" timeoutFrames="60"/>
	<!-- 역색인은 워커가 Resource/ 를 훑어 만든다 -->
	<EditorWaitStable/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1" timeoutWallSeconds="60"/>
	<!-- 폴더로 가서 검색으로 그 메시만 남긴다(도킹 칸이 낮아 타일 한 줄만 보인다) -->
	<EditorWaitStable/>
	<DevCommand line="content.open game/empty/models"/>
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.search"/>
	<EditorWaitStable/>
	<!-- 칸이 글자를 받아 거르는지 본다 - 누를 타일은 거르지 않아도 보일 수 있어 클릭만으로는 글자를 잃어도 통과한다 -->
	<EditorText value="zzz"/>
	<EditorWaitStable/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="1"/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="crate_medium.mesh"/>
	<EditorWaitStable/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="0"/>
	<EditorClick mark="contentBrowser.asset.crate_medium.mesh" button="1" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="contentBrowser.asset.crate_medium.mesh" button="1" state="Up"/>
	<EditorWaitStable/>
	<EditorClick mark="menu.asset.findReferences" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="menu.asset.findReferences" state="Up"/>
	<WaitUntil watch="Editor.ReferenceResultCount" atLeast="1" timeoutFrames="60"/>
	<CaptureEditorUI file="references.png"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
