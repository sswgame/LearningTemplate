<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 카메라 프리셋 창(GF_EditorPlugin_CameraPresets 확장): 창을 열고 Quick Open 으로 엔진 기본 프리셋 파일(default.cameras.xml, 프리셋 넷)을 고르면 창이 목록을 읽고,
  행을 누르면 그 프리셋이 골라져 미리보기 뷰가 그 카메라로 그린다.
  감시 값: Editor.CameraPresetCount(파일을 읽었다) → Editor.CameraPresetSelected(누른 행이 골라졌다).
  실행: App -EnableEditor -scenario=engine/automation/editor/camerapresets.scenario.xml -unattended
-->
<Scenario name="editor.camerapresets" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive" requiresModule="GF_EditorPlugin_CameraPresets">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus camerapreset_preview"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="default.cameras.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.CameraPresetCount" equals="4" timeoutFrames="600"/>
	<EditorClick mark="camerapreset.row.follow"/>
	<WaitUntil watch="Editor.CameraPresetSelected" equals="2" timeoutFrames="60"/>
	<EditorClick mark="camerapreset.row.topdown"/>
	<WaitUntil watch="Editor.CameraPresetSelected" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
