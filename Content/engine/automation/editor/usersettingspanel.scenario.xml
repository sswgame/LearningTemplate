<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 사용자 설정 창(user_settings): debug 탭의 debug.hud(즉시 적용 · 대상 gv_debugHUD) 체크 상자를 누르면 보류 값이 생기고 변수가 미리 켜진다.
  Revert 는 보류를 버려 변수를 되돌리고, 다시 눌러 Apply 하면 보류 없이 켜진 채 남는다. Reset Tab 은 탭을 기본값으로 보류하고 Apply 로 확정한다.
  무인 실행이라 사용자 설정 파일은 실행별 파일이다(사용자의 설정을 건드리지 않는다).
  감시 값: Editor.UserSettingsPending(보류 값 있음) · ExpectVariable gv_debugHUD(설정이 닿는 대상).
  실행: App -EnableEditor -scenario=engine/automation/editor/usersettingspanel.scenario.xml -unattended
-->
<Scenario name="editor.usersettingspanel" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus user_settings"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.UserSettingsPending" equals="0"/>
	<ExpectVariable name="gv_debugHUD" value="false"/>
	<EditorClick mark="userSettings.tab.debug"/>
	<EditorWaitSettled/>
	<!-- 바꾸면 보류 — 즉시 적용 설정이라 대상이 미리 바뀐다 -->
	<EditorClick mark="userSettings.value.debug.hud"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="1" timeoutFrames="60"/>
	<ExpectVariable name="gv_debugHUD" value="true"/>
	<!-- 되돌리기 — 보류를 버린다 -->
	<EditorWaitSettled/>
	<EditorClick mark="userSettings.revert"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="0" timeoutFrames="60"/>
	<ExpectVariable name="gv_debugHUD" value="false"/>
	<!-- 적용 — 보류 없이 남는다 -->
	<EditorWaitSettled/>
	<EditorClick mark="userSettings.value.debug.hud"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="1" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="userSettings.apply"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="0" timeoutFrames="60"/>
	<ExpectVariable name="gv_debugHUD" value="true"/>
	<!-- 탭 기본값 — 보류로 기본값을 걸고 적용한다 -->
	<EditorWaitSettled/>
	<EditorClick mark="userSettings.resetTab"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="1" timeoutFrames="60"/>
	<ExpectVariable name="gv_debugHUD" value="false"/>
	<EditorWaitSettled/>
	<EditorClick mark="userSettings.apply"/>
	<WaitUntil watch="Editor.UserSettingsPending" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
