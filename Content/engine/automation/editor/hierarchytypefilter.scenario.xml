<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Hierarchy 형식 필터: 검색 칸 앞의 깔때기 단추가 씬에 있는 컴포넌트 종류를 늘어놓고, 고르면 검색어가 `t:<종류>` 가 된다
  (언리얼 아웃라이너의 필터 단추 · 유니티 계층 창의 형식 검색). 테스트 씬(editortest)에서 DirectionalLightComponent 는 TestKeyLight 하나뿐이다.
  "모든 종류" 를 고르면 필터가 풀린다.
  실행: App -EnableEditor -scenario=engine/automation/editor/hierarchytypefilter.scenario.xml -unattended
-->
<Scenario name="editor.hierarchytypefilter" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<Store watch="Editor.HierarchyVisibleRoots" as="allRoots"/>
	<EditorClick mark="hierarchy.typeFilter"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.typeFilter.DirectionalLightComponent"/>
	<WaitUntil watch="Editor.HierarchyVisibleRoots" equals="1" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.typeFilter"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.typeFilter.all"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.HierarchyVisibleRoots" sameAs="allRoots"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
