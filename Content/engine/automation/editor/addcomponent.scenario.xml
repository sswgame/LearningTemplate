<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터의 Add Component 단추(N4): 오브젝트를 고르고 컴포넌트 목록 끝의 Add Component(inspector.addComponent)를 눌러 검색 팝업에
  PointLight 를 치고 Enter 를 보내면 그 오브젝트에 컴포넌트가 하나 늘고 되돌리기가 한 줄 는다. 인스펙터를 잠그면 다른 오브젝트를 골라도 잠근 오브젝트를 보인다.
  실행: App -EnableEditor -scenario=engine/automation/editor/addcomponent.scenario.xml -unattended
-->
<Scenario name="editor.addcomponent" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="25"/>
	<EditorClick mark="hierarchy.row.TestParent"/>
	<Wait frames="15"/>
	<Expect watch="Editor.SelectedComponentCount" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="inspector.addComponent"/>
	<Wait frames="20"/>
	<EditorText value="PointLight"/>
	<Wait frames="10"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedComponentCount" equals="2"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedComponentCount" equals="1"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
