<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 뷰포트 격자의 굵은 선은 월드에 고정된다. 카메라를 오른쪽 단추 + D 로 날려 옆으로 옮겨도 굵은 선이 월드 5 배수 선에만 있고
  (예전에는 카메라 기준 인덱스라 카메라가 1 m 지날 때마다 다른 월드 선으로 미끄러졌다), Shift + E 로 높이 올라가면 간격이 10 m 로 바뀐다.
  실행: App -EnableEditor -scenario=engine/automation/editor/viewportgrid.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.viewportgrid" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 위치로 누르는 시나리오 — 앞 시나리오 · 사용자 배치가 패널을 좁혀 두었을 수 있다 -->
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<Expect watch="Editor.GridStep" near="1" tolerance="0.001"/>
	<Expect watch="Editor.GridMajorLines" atLeast="4"/>
	<Expect watch="Editor.GridMisplacedMajorLines" equals="0"/>
	<!-- 옆으로 3 m 남짓 — 정수 · 5 의 배수가 아닌 자리에 선다 -->
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorKey key="D" state="Down"/>
	<Wait frames="42"/>
	<EditorKey key="D" state="Up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<Expect watch="Editor.GridStep" near="1" tolerance="0.001"/>
	<Expect watch="Editor.GridMisplacedMajorLines" equals="0"/>
	<!-- 높이 올라가면 간격이 10 m 가 된다 -->
	<!-- 오른쪽 단추를 쥔 채 휠 네 눈금으로 비행 속도를 1.2^4 ≈ 2.07 배로 올리고(viewportnavigation 이 올려 둔 속도여도 상한 20 m/s 아래), 높이 110 m(간격 10 m 구간 100 ~ 1000 m 안)에 닿을 때까지 오른다.
	     고정 460 프레임은 속도 5 m/s 를 가정했다 — 앞 시나리오가 속도를 바꾸면 높이가 달라졌다. 끝나면 같은 눈금만큼 내려 속도(에디터 설정에 남는다)를 되돌린다. -->
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorWheel dy="4"/>
	<EditorKey key="Shift+E" state="Down"/>
	<WaitUntil watch="Editor.SceneViewCameraY" atLeast="110" timeoutFrames="600"/>
	<EditorKey key="Shift+E" state="Up"/>
	<EditorWheel dy="-4"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewCameraY" atLeast="100"/>
	<Expect watch="Editor.GridStep" near="10" tolerance="0.001"/>
	<Expect watch="Editor.GridMisplacedMajorLines" equals="0"/>
	<EditorWaitStable/>
	<Pass/>
</Scenario>
