<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 리그 디버그 창(rig_debug) 저장 왕복: 시험 기사 프리팹 · 리그(knight/ — rigdebugpanel 과 같은 데이터)의 실행마다 새 사본(scratch/saveroundtriprig — <Scratch>)을 쓴다.
  사본을 만들 때 글 안의 원본 id 가 사본 id 로 바뀌어 사본 프리팹이 사본 리그를 가리킨다 — 리그 창의 문서는 고른 오브젝트의 리그라 따로 여는 입구가 없다(경로는 씬 · 프리팹이 정한다).
  플레이로 리그를 묶고 고치지 않고 "Save to rig"(rigdebug.save — 리그 파일을 읽어 노드 weight · enabled 를 되써 넣는다, RigSaveParams::rewriteSettings) → 글 붙잡기 →
  다시 저장(저장한 파일을 다시 읽어 되쓴다) → 같은 바이트. 저장 뒤 핫 리로드가 다시 묶어도 가중치 합은 그대로다(1.5). 원본은 건드리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/saveroundtriprig.scenario.xml -unattended
-->
<Scenario name="editor.saveroundtriprig" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/knight" as="scratch/saveroundtriprig"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitStable/>
	<DevCommand line="prefab.spawn scratch/saveroundtriprig/knight.prefab.xml"/>
	<EditorWaitStable/>
	<EditorExpectObject name="TestKnight" component="PoseModifierComponent" selected="1"/>
	<DevCommand line="panel.focus rig_debug"/>
	<EditorWaitStable/>
	<!-- 새 씬은 저장하지 않았다 — 툴바 Play 가 묻고 Play Anyway 로 띄운다(rigdebugpanel 과 같다) -->
	<EditorClick mark="toolbar.play"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.playAnyway"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="90"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.RigDebugNodeCount" equals="2" timeoutFrames="120"/>
	<Expect watch="Editor.RigDebugWeightSum" near="1.5" tolerance="0.001"/>
	<EditorWaitStable/>
	<EditorClick mark="rigdebug.save"/>
	<EditorWaitStable/>
	<DevCommand line="asset.snapshotScratch scratch/saveroundtriprig/knight.rig.xml"/>
	<WaitUntil watch="Editor.RigDebugNodeCount" equals="2" timeoutFrames="120"/>
	<Expect watch="Editor.RigDebugWeightSum" near="1.5" tolerance="0.001"/>
	<EditorWaitStable/>
	<EditorClick mark="rigdebug.save"/>
	<EditorWaitStable/>
	<DevCommand line="asset.expectScratchUnchanged scratch/saveroundtriprig/knight.rig.xml"/>
	<ExpectLog id="RigDebugPanel.RigSettingsSaved" count="2"/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
