<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 회선 조절(서버 디버깅 S4). 전용 서버 + App 클라이언트 1 을 띄운 뒤, Multiplayer 창 Conditions 탭이 보내는 것과 같은 개발 명령을
  netplay.command 로 클라이언트 표준 입력에 보낸다: 두 방향 손실 30 %, 그리고 패킷 하나 크기의 신뢰 메시지 100 개(net.traffic — 재전송할 거리).
  netplay.waitResent 1 30 은 모든 프로세스에 net.emulation stats 를 거듭 물으며, 재전송 합이 1 이상이 되거나 30 초가 지날 때까지 그 프레임을 붙잡는다.
  재전송은 연결의 벽시계 시한으로 일어나므로 프레임 수로 기다리지 않는다(Release 는 수십 프레임이 1 초도 걸리지 않는다). 감시 값이 그 답을 읽어
  흉내가 버린 패킷(Editor.NetPlayEmulationDroppedPackets)과 연결이 다시 보낸 신뢰 메시지(Editor.NetPlayResentMessages)를 보고한다.
  실행: App -EnableEditor -scenario=engine/automation/editor/netconditions.scenario.xml -unattended
-->
<Scenario name="editor.netconditions" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<AllowLog id="Server.ServerBehindDroppedTicks" reason="전용 서버는 백엔드 넷 · 클라이언트와 함께 같은 기계에서 돌아 부하가 걸린 틱이 늦을 수 있다 — 중계가 자식 경고를 경고 그대로 옮기므로(예전에는 Info 로 숨겼다) 나와도 된다고 적는다"/>
	<WaitUntil watch="Editor.NetPlayProcessCount" equals="0" timeoutFrames="60"/>
	<DevCommand line="netplay.start dedicated 1"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.wait 1 120"/>
	<WaitUntil watch="Editor.NetPlayConnectedClients" equals="1" timeoutFrames="60"/>
	<DevCommand line="netplay.command clients net.emulation both lossPercent=30"/>
	<DevCommand line="netplay.command clients net.traffic 100 1000"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.waitResent 1 30"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="net emulation up [latencyMs=0 jitterMs=0 lossPercent=30" atLeast="1"/>
	<ExpectLog id="DevCommand.Reply" contains="net traffic queued 100 reliable message(s) to 1 connection(s)" atLeast="1"/>
	<ExpectLog id="DevCommand.Reply" contains="netplay stats from 2 of 2 process(es)" atLeast="1"/>
	<Expect watch="Editor.NetPlayEmulationDroppedPackets" atLeast="1"/>
	<Expect watch="Editor.NetPlayResentMessages" atLeast="1"/>
	<!-- 서버 콘솔로 한 줄 보내기 -->
	<DevCommand line="netplay.server state.objects"/>
	<ExpectLog id="DevCommand.Reply" contains="sent to the server: state.objects" atLeast="1"/>
	<DevCommand line="netplay.server state.hashnames"/>
	<DevCommand line="netplay.stats 5"/>
	<ExpectLog id="DevCommand.Reply" contains="process(es)" atLeast="2"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.stop"/>
	<WaitUntil watch="Editor.NetPlayStopping" equals="0" timeoutWallSeconds="20"/>
	<Expect watch="Editor.NetPlayProcessCount" equals="0"/>
	<Pass/>
</Scenario>
