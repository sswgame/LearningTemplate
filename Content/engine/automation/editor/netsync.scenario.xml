<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 어긋남 찾기(서버 디버깅 S7). 전용 서버 + App 클라이언트 1 을 띄우면 세션이 서버에 -gv_stateHashHistory 를 켠다.
  netplay.sync save 는 Multiplayer 창 Sync 탭의 "Session server" + "Save" 를, netplay.sync compare 는 세션 서버를 A · 저장한 파일을 B 로 담아 "Compare" 를 한다.
  같은 서버의 이력을 견주므로 겹친 틱(Editor.NetPlaySyncCommonTicks)이 있고 어긋남(Editor.NetPlaySyncDiverged)은 없어야 한다.
  실행: App -EnableEditor -scenario=engine/automation/editor/netsync.scenario.xml -unattended
-->
<Scenario name="editor.netsync" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<AllowLog id="Server.ServerBehindDroppedTicks" reason="전용 서버는 백엔드 넷 · 클라이언트와 함께 같은 기계에서 돌아 부하가 걸린 틱이 늦을 수 있다 — 중계가 자식 경고를 경고 그대로 옮기므로(예전에는 Info 로 숨겼다) 나와도 된다고 적는다"/>
	<WaitUntil watch="Editor.NetPlaySyncCommonTicks" equals="0" timeoutFrames="60"/>
	<DevCommand line="netplay.start dedicated 1"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.wait 1 120"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.sync save {out}/netsync.txt"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="netplay sync saved" atLeast="1"/>
	<DevCommand line="netplay.sync compare {out}/netsync.txt"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="netplay sync no divergence over" atLeast="1"/>
	<Expect watch="Editor.NetPlaySyncCommonTicks" atLeast="1"/>
	<Expect watch="Editor.NetPlaySyncDiverged" equals="0"/>
	<DevCommand line="netplay.stop"/>
	<WaitUntil watch="Editor.NetPlayStopping" equals="0" timeoutWallSeconds="20"/>
	<Expect watch="Editor.NetPlayProcessCount" equals="0"/>
	<Pass/>
</Scenario>
