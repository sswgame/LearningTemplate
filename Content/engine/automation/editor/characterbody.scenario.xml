<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 캐릭터 편집 창의 몸 탭: 외형 데이터를 읽고 몸 탭에서 피부 층(화장 · 문신) 하나를 더한다. 탭 화면을 찍는다(사람 · 에이전트가 EditorUI.md 체크리스트로 본다).
  ① 외형 탭에서 데이터 읽기. ② 몸 탭 — 빈 층 목록은 안내 글을 보이고, 층 더하기 콤보의 첫 종류를 고르면 층이 하나다(되돌리기 기록은 단위 테스트 BodyCustomizationEditTest 가 본다).
  ③ 몸 데이터 편집 줄(채널 매핑 · 지글 · 주름 · 체액 경로 · 구간 별칭 — 저장 · 되돌리기)은 열기만으로 미저장이 되지 않는다(편집 · 되돌리기 · 주석 보존은 단위 테스트 BodyDataEditTest).
  실행: App -EnableEditor -scenario=engine/automation/editor/characterbody.scenario.xml -unattended
-->
<Scenario name="editor.characterbody" fixedDelta="0.0166667" timeoutFrames="1300" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<ResizeWindow width="1900" height="1200"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchPanel" value="charactereditor.main"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus charactereditor.main"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.tab.appearance" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.appearance" state="Up"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.loadData"/>
	<EditorWaitSettled/>

	<EditorClick mark="charactereditor.tab.body" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.body" state="Up"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.CharacterEditorBodyLayerCount" equals="0"/>
	<Expect watch="Editor.CharacterEditorBodyHiddenSlots" equals="0"/>
	<CaptureEditorUI file="charactereditor/body_empty.png"/>
	<EditorClick mark="charactereditor.body.addLayer"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.body.addLayer.first"/>
	<WaitUntil watch="Editor.CharacterEditorBodyLayerCount" equals="1" timeoutFrames="30"/>
	<EditorWaitSettled/>
	<CaptureEditorUI file="charactereditor/body_layer.png"/>
	<Expect watch="Editor.CharacterEditorStatusSet" equals="0"/>
	<Expect watch="Editor.CharacterEditorBodyDataDirty" equals="0"/>
	<Pass/>
</Scenario>
