<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 클립 미리보기 창: 창을 열고 Quick Open 으로 기사의 환호 클립(cheer.animclip, 1.67 초)을 고른 뒤 몸 프리팹 칸에 기사(knight_merged)를 적고 Spawn 하면
  창의 미리보기 씬에 몸이 서서 그 클립을 재생하고, 렌더러가 그 씬을 그린다.
  감시 값: Editor.ClipPreviewDuration(몸이 그 클립을 재생한다 — 클립 길이) → Editor.ClipPreviewSceneFrames(그렸다).
  실행: App -EnableEditor -scenario=engine/automation/editor/clippreview.scenario.xml -unattended
-->
<Scenario name="editor.clippreview" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus animation_clip_preview"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="cheer_"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorClick mark="clip.bodyField"/>
	<EditorText value="common/prefabs/kaykit/knight_merged.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="clip.spawn"/>
	<WaitUntil watch="Editor.ClipPreviewDuration" near="1.6667" tolerance="0.05" timeoutFrames="600"/>
	<WaitUntil watch="Editor.ClipPreviewSceneFrames" atLeast="60" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
