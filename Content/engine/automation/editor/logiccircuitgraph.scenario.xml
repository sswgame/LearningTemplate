<?asset guid="dbcef82eba6dce870a3a9737f6f0d14a"?>
<!--
  에디터 시나리오 — 논리 회로 그래프 편집 창(GF_EditorPlugIn_Base): 장치 쇼케이스 씬을 열고 회로가 있는 오브젝트들을 고르면 Logic Circuit Graph 창이 그 회로를 노드 그래프로 그린다(감시 값 Editor.GraphNodeCount).
  도구 모음으로 Signal · Not 노드를 더하고, 옆 패널의 폼으로 signal_1.Active -> not_1.In 배선을 이으면 편집마다 Undo 에 한 줄씩 오른다(Editor.UndoCount).
  편집은 컴포넌트에 쓰이고 회로가 다시 지어지므로 로그 줄 "Logic circuit graph <편집 이름>" 로 센다. 씬은 저장하지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/logiccircuitgraph.scenario.xml -unattended
-->
<Scenario name="editor.logiccircuitgraph" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open game/playground/maps/mechanismshowcase.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.ObjectCount" atLeast="5" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="select.type LogicCircuitComponent"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus logic_circuit_graph"/>
	<WaitUntil watch="Editor.GraphNodeCount" atLeast="1" timeoutFrames="120"/>
	<!-- 노드 둘 -->
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.addnode"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.kind.Signal"/>
	<EditorWaitStable/>
	<ExpectLog id="LogicCircuitGraph.Edited" contains="Add Logic Circuit Node" count="1"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.addnode"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.kind.Not"/>
	<EditorWaitStable/>
	<ExpectLog id="LogicCircuitGraph.Edited" contains="Add Logic Circuit Node" count="2"/>
	<!-- 배선: 폼의 From · To 를 고르고 Connect -->
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.wire.from"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.wire.from.signal_1.Active"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.wire.to"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.wire.to.not_1.In"/>
	<EditorWaitStable/>
	<EditorClick mark="logicCircuit.wire.connect"/>
	<EditorWaitStable/>
	<ExpectLog id="LogicCircuitGraph.Edited" contains="Add Logic Circuit Wire" count="1"/>
	<Expect watch="Editor.UndoCount" atLeast="3"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
