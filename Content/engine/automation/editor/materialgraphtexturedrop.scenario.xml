<!--
  에디터 시나리오 — 에셋 → 노드 그래프(EditorUI R11 · 에셋 → 노드 종류 표 EditorGraphAssetNodeRule). 머티리얼 그래프 패널을 열고 콘텐츠 브라우저의 텍스처(.png) 타일을
  캔버스(materialGraph.canvas)에 놓으면 텍스처 샘플 노드가 하나 생기고(Editor.GraphNodeCount 가 바뀐다) Undo 한 번에 사라진다. 표에 없는 에셋(머티리얼)은 놓아도 노드가 생기지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/materialgraphtexturedrop.scenario.xml -unattended
-->
<Scenario name="editor.materialgraphtexturedrop" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchPanel" value="materialgraph"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<Scratch from="game/empty/materials/matgraph" as="scratch/materials/texturedrop"/> <!-- 캔버스는 열린 그래프가 있어야 그린다 — 원본을 고치지 않게 사본을 연다 -->
	<DevCommand line="asset.openScratch scratch/materials/texturedrop/rim_glow.matgraph.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus materialgraph"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutSeconds="10"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus content_browser"/> <!-- 출력 로그와 같은 탭 묶음이라 앞으로 꺼내야 타일이 그려진다 -->
	<EditorWaitStable/>
	<DevCommand line="content.open engine/textures_raw/particles/kenney_particle"/>
	<EditorWaitStable/>
	<Store watch="Editor.GraphNodeCount" as="nodesBefore"/>
	<!-- ① 텍스처를 캔버스에 놓으면 샘플 노드가 생긴다 -->
	<EditorDrag mark="contentBrowser.asset.circle_01.png" toMark="materialGraph.canvas"/>
	<WaitUntil watch="Editor.GraphNodeCount" differsFrom="nodesBefore" timeoutFrames="120"/>
	<EditorWaitStable/>
	<!-- ② 한 단계 되돌리기 — 되돌리기는 포커스 문서(그래프)의 것이다 -->
	<DevCommand line="panel.focus materialgraph"/>
	<EditorWaitStable/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.GraphNodeCount" sameAs="nodesBefore" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- ③ 표에 없는 에셋은 놓을 자리가 열리지 않는다 -->
	<DevCommand line="content.open engine/automation/editor/assetmove/pack"/>
	<EditorWaitStable/>
	<EditorDrag mark="contentBrowser.asset.probe.material" toMark="materialGraph.canvas"/>
	<EditorWaitStable/>
	<Expect watch="Editor.GraphNodeCount" sameAs="nodesBefore"/>
	<DevCommand line="panel.close materialgraph"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
