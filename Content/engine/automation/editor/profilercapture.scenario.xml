<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 프로파일러 패널의 캡처 다루기(에디터 보강 "그 밖에": 프로파일러).
  1) 프레임 그래프(GT.Frame)를 누르면 표가 그 프레임을 보인다(Editor.ProfilerSelectedFrame 이 0 보다 크다).
  2) Pause 로 담기를 멈추고 Save, Clear 뒤 Load 하면 저장한 창이 다시 보이고 담기는 멈춰 있다(Saved/Profiler/ProfilerCapture.txt).
  3) Pause on spike 의 문턱을 250 ms 로 두고 개발 명령 profile.stall 로 한 프레임을 400 ms 붙잡으면 그 프레임에서 담기가 멈춘다.
     스파이크는 명령이 만든다. 에디터 프레임 비용에 기대면 구성마다 달라진다(Release 의 GT.Frame 은 0.1 ms 안팎이다).
  4) Call Tree 탭에서 Record 를 누르면 녹화가 호출 트리로 접힌다(Editor.ProfilerCallTreeNodes).
  실행: App -EnableEditor -scenario=engine/automation/editor/profilercapture.scenario.xml -unattended
-->
<Scenario name="editor.profilercapture" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="5"/>
	<ResizeWindow width="1600" height="900"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="20"/>
	<DevCommand line="panel.focus profiler"/>
	<Wait frames="80"/>
	<Expect watch="Editor.ProfilerCapturedFrames" atLeast="30"/>
	<Expect watch="Editor.ProfilerSelectedFrame" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="profiler.graph.GT.Frame" anchor="0.5,0.5"/>
	<Wait frames="15"/>
	<Expect watch="Editor.ProfilerSelectedFrame" atLeast="1"/>
	<!-- 2) Pause · Save · Clear · Load -->
	<Wait frames="5"/>
	<EditorClick mark="profiler.capture.pause"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.ProfilerCapturePaused" equals="1" timeoutFrames="300"/>
	<Wait frames="14"/>
	<Expect watch="Editor.ProfilerCapturePaused" equals="1"/>
	<EditorClick mark="profiler.capture.save"/>
	<Wait frames="15"/>
	<EditorClick mark="profiler.capture.clear"/>
	<Wait frames="15"/>
	<Expect watch="Editor.ProfilerCapturedFrames" equals="0"/>
	<EditorClick mark="profiler.capture.load"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.ProfilerCapturedFrames" atLeast="30" timeoutFrames="300"/>
	<Wait frames="19"/>
	<Expect watch="Editor.ProfilerCapturedFrames" atLeast="30"/>
	<Expect watch="Editor.ProfilerCapturePaused" equals="1"/>
	<ExpectLog contains="Profiler capture loaded" atLeast="1"/>
	<!-- 3) Pause on spike -->
	<Wait frames="5"/>
	<EditorClick mark="profiler.capture.pauseOnSpike"/>
	<Wait frames="10"/>
	<EditorClick mark="profiler.capture.spikeMs" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="250"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="10"/>
	<EditorClick mark="profiler.capture.pause"/>
	<Wait frames="15"/>
	<Expect watch="Editor.ProfilerCapturePaused" equals="0"/>
	<DevCommand line="profile.stall 400"/>
	<Wait frames="40"/>
	<Expect watch="Editor.ProfilerCapturePaused" equals="1"/>
	<ExpectLog contains="Profiler paused on a spike" atLeast="1"/>
	<!-- 4) Call Tree -->
	<Wait frames="10"/>
	<EditorClick mark="profiler.callTree.tab" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="profiler.callTree.tab" state="up"/>
	<Wait frames="12"/>
	<EditorClick mark="profiler.callTree.record"/>
	<Wait frames="75"/>
	<Expect watch="Editor.ProfilerCallTreeNodes" atLeast="3"/>
	<Wait frames="5"/>
	<EditorClick mark="profiler.callTree.record"/>
	<Wait frames="15"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
