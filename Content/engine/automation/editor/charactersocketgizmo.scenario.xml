<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 캐릭터 편집 창의 소켓 뷰포트 기즈모: 소켓 탭에서 첫 소켓을 고르고 미리보기 탭으로 가면 기즈모가 그 소켓(마지막에 고른 것)에 놓인다
  (Editor.CharacterEditorSocketGizmoPlaced = 1, 본 기즈모는 0). 기즈모 가운데(화면 평면 이동)를 끌면 소켓 파일의 로컬 위치가 바뀌고(Editor.CharacterEditorSelectedSocketX 가 달라진다),
  되돌리기 한 번이 끌기 전체를 되돌린다(칸마다 · 프레임마다 쌓지 않는다). 프리뷰 오브젝트가 아니라 소켓 데이터를 고친다 — 미리보기 축이 같은 자리를 따라온다(그림 socketgizmo/*.png).
  파일은 저장하지 않는다(팩 데이터의 소켓 파일을 건드리지 않는다). 끝에서 되돌려 dirty 가 남지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/charactersocketgizmo.scenario.xml -unattended
-->
<Scenario name="editor.charactersocketgizmo" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<ResizeWindow width="1900" height="1200"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus charactereditor.main"/>
	<WaitUntil watch="Editor.CharacterEditorSocketCount" atLeast="3" timeoutFrames="135"/>
	<EditorWaitSettled/>
	<!-- 스켈레톤을 읽어 소켓 부모 본이 몸에 맞는다 -->
	<EditorClick mark="charactereditor.tab.skeleton" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.skeleton" state="Up"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.loadSkeleton"/>
	<WaitUntil watch="Editor.CharacterEditorBoneCount" atLeast="30" timeoutFrames="90"/>
	<EditorWaitSettled/>
	<!-- 미리보기 몸은 외형 데이터를 읽어야 선다 -->
	<EditorClick mark="charactereditor.tab.appearance" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.appearance" state="Up"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.loadData"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.basePreset"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.basePreset.first"/>
	<EditorWaitSettled/>
	<!-- 소켓을 마지막에 고른다 — 기즈모의 주인이 된다 -->
	<EditorClick mark="charactereditor.tab.sockets" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.sockets" state="Up"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.socket.first"/>
	<EditorWaitSettled/>
	<EditorClick mark="charactereditor.tab.preview" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.preview" state="Up"/>
	<WaitUntil watch="Editor.CharacterEditorPreviewAssembleCount" atLeast="1" timeoutFrames="177"/>
	<WaitUntil watch="Editor.CharacterEditorSocketGizmoPlaced" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.CharacterEditorBoneGizmoPlaced" equals="0"/>
	<Expect watch="Editor.CharacterEditorStatusSet" near="0" tolerance="0.5"/>
	<EditorWaitSettled/>
	<CaptureEditorUI file="socketgizmo/before.png" maxMagentaFraction="0"/>
	<EditorWaitSettled/>
	<Store watch="Editor.CharacterEditorSelectedSocketX" as="socketX"/>
	<EditorDrag mark="charactereditor.gizmoCenter" dx="60" dy="0"/>
	<WaitUntil watch="Editor.CharacterEditorSelectedSocketX" differsFrom="socketX" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<CaptureEditorUI file="socketgizmo/dragged.png" maxMagentaFraction="0"/>
	<EditorWaitSettled/>
	<!-- 되돌리기 한 번이 끌기 전체다 -->
	<EditorClick mark="charactereditor.socketUndo"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.CharacterEditorSelectedSocketX" sameAs="socketX" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
