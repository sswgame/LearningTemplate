<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 타일셋 편집 창(Tile Set Editor): PixelTown 의 실제 타일셋 구성(town.tileset.xml — puny_world 아틀라스 27 × 65, grass · path · water)을 테스트 사본
  (scratch/tilesetedit, <Scratch>)에서 연다. 원본은 건드리지 않는다.
  path(브러시 1)의 첫 규칙을 고르면 모습 셀이 4 이고(Editor.TileSetFirstCell), 아틀라스 격자에서 셀 31(열 4 · 행 1)을 누르면 31 이 된다. 이웃 단추 0(왼위)을 누르면 패턴이 바뀐다.
  새 타일 브러시를 더해 4 개가 되고 위반이 없으므로(Editor.TileSetIssueCount = 0) 저장 · 다시 읽기 뒤에도 4 개이며 규칙의 셀이 31 로 남는다.
  저장한 타일셋을 쓰는 테스트 맵(town.tilemap.xml 사본)을 타일맵 도구로 열어 칠한 길이 새 셀로 그려지는지 그림으로 본다(tileset/map.png).
  실행: App -EnableEditor -scenario=engine/automation/editor/tilesetedit.scenario.xml -unattended
-->
<Scenario name="editor.tilesetedit" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/tilesetedit" as="scratch/tilesetedit"/>
	<EditorWaitStable/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus tileset_editor"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/tilesetedit/town.tileset.xml"/>
	<WaitUntil watch="Editor.TileSetBrushCount" equals="3" timeoutFrames="120"/>
	<Expect watch="Editor.TileSetIssueCount" equals="0"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.brush.1"/>
	<WaitUntil watch="Editor.TileSetRuleCount" equals="8" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.rule.0"/>
	<WaitUntil watch="Editor.TileSetFirstCell" equals="4" timeoutFrames="60"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="tileset/rule.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<!-- 셀 31 = 열 4 · 행 1 — 칸 가운데를 누른다(27 열 · 65 행) -->
	<EditorClick mark="tileSet.atlas" anchor="0.1667,0.0231"/>
	<WaitUntil watch="Editor.TileSetFirstCell" equals="31" timeoutFrames="60"/>
	<Expect watch="Editor.TileSetFrameCount" equals="1"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.neighbor.0"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.DirtyDocumentCount" atLeast="1" timeoutFrames="60"/>
	<EditorClick mark="tileSet.addTile"/>
	<WaitUntil watch="Editor.TileSetBrushCount" equals="4" timeoutFrames="60"/>
	<Expect watch="Editor.TileSetIssueCount" equals="0"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="tileset/edited.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.save"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="90"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.reload"/>
	<WaitUntil watch="Editor.TileSetBrushCount" equals="4" timeoutFrames="90"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.brush.1"/>
	<EditorWaitStable/>
	<EditorClick mark="tileSet.rule.0"/>
	<WaitUntil watch="Editor.TileSetFirstCell" equals="31" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- 저장한 타일셋을 쓰는 맵을 타일맵 도구로 연다 — 길의 왼쪽 위 모서리 칸이 새 셀로 그려진다(눈으로 본다) -->
	<DevCommand line="panel.focus tile_map"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/tilesetedit/town.tilemap.xml"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="tileset/map.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
