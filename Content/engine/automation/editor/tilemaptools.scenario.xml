<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 타일맵 도구(N11): 새 8 x 8 맵은 Walkable 플래그가 모두 켜져 있다. Erase 를 켠 Fill 로 한 번 누르면 64 칸이 모두 꺼지고,
  Brush 로 왼쪽 위 칸 하나를 칠한 뒤 Fill 로 빈 칸 하나를 누르면 이어진 빈 칸 63 개가 한 번에 칠해져 다시 64 칸이다.
  Picker 로 칸을 집으면 Brush 로 돌아간다.
  실행: App -EnableEditor -scenario=engine/automation/editor/tilemaptools.scenario.xml -unattended
-->
<Scenario name="editor.tilemaptools" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="20"/>
	<DevCommand line="panel.focus tile_map"/>
	<Wait frames="25"/>
	<Expect watch="Editor.TileMapFlagCells" equals="64"/>
	<Wait frames="5"/>
	<EditorClick mark="tileMap.tool.fill"/>
	<Wait frames="10"/>
	<EditorClick mark="tileMap.erase"/>
	<Wait frames="10"/>
	<EditorClick mark="tileMap.canvas" anchor="0.12,0.12"/>
	<Wait frames="15"/>
	<Expect watch="Editor.TileMapFlagCells" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="tileMap.erase"/>
	<Wait frames="10"/>
	<EditorClick mark="tileMap.tool.brush"/>
	<!-- 캔버스 왼쪽 위 여백 4 px 뒤가 칸 (0,0) 이다 -->
	<Wait frames="10"/>
	<EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/>
	<Wait frames="15"/>
	<Expect watch="Editor.TileMapFlagCells" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="tileMap.tool.fill"/>
	<Wait frames="10"/>
	<EditorClick mark="tileMap.canvas" anchor="0.12,0.12"/>
	<Wait frames="15"/>
	<Expect watch="Editor.TileMapFlagCells" equals="64"/>
	<Wait frames="5"/>
	<EditorClick mark="tileMap.tool.picker"/>
	<WaitUntil watch="Editor.TileMapTool" equals="3" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/>
	<Wait frames="15"/>
	<Expect watch="Editor.TileMapTool" equals="0"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
