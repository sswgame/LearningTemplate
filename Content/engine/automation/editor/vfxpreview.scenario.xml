<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — VFX 미리보기 창(결정 기록 5-5 V3): 창을 열고 Quick Open 으로 엔진 표본 효과(engine/vfx/sparks.vfx.xml)를 고르면 창이 그 효과를 문서로 받아
  미리보기 씬의 VfxComponent 로 재생하고, 렌더러가 그 씬을 창의 렌더 타깃에 그린다(투명 패스의 입자 빌보드 — particle.hlsl).
  감시 값: Editor.VFXPreviewDocumentIsWatchAsset(문서 교체) → Editor.VFXPreviewParticleCount(일정이 입자를 만든다 — 표본의 두 방출기는 기본 GPU 시뮬레이션이라 살아 있는 수는 GPU 에만 있다) → Editor.VFXPreviewSceneFrames(그렸다).
  눈 확인: -gv_editorPreviewScreenshot=<경로>.ppm 를 주면 미리보기 타깃을 찍는다(바닥 위 원점에서 주황 불꽃이 솟고 회색 연기가 오른다).
  실행: App -EnableEditor -scenario=engine/automation/editor/vfxpreview.scenario.xml -unattended (백엔드 vk · dx11 · opengl 도 같다)
-->
<Scenario name="editor.vfxpreview" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchAsset" value="engine/vfx/sparks.vfx.xml"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus vfx_preview"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="sparks.vfx.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.VFXPreviewDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<EditorWaitStable/>
	<ExpectLog id="VFXPreview.Playing" contains="'engine/vfx/sparks.vfx.xml' (2 emitters)" count="1"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.VFXPreviewParticleCount" atLeast="20" timeoutFrames="600"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.VFXPreviewSceneFrames" atLeast="60" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Expect watch="Editor.VFXPreviewParticleCount" atLeast="20"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="vfxpreview/panel.png"/>
	<!-- 방출기 격리: 첫 방출기의 Solo 를 켜면 켜진 방출기가 하나, 다시 누르면 둘(모델 테스트 SoloTogglesOneEmitter). 효과 파일은 바뀌지 않는다 -->
	<Expect watch="Editor.VFXPreviewEnabledEmitterCount" equals="2"/>
	<EditorClick mark="vfx.solo.0"/>
	<WaitUntil watch="Editor.VFXPreviewEnabledEmitterCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.VFXPreviewSoloEmitter" equals="0"/>
	<EditorClick mark="vfx.solo.0"/>
	<WaitUntil watch="Editor.VFXPreviewEnabledEmitterCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.VFXPreviewSoloEmitter" equals="-1"/>
	<!-- 한 프레임 걸음: 공통 재생 막대(Data.preview)의 멈춤 · 한 프레임이 씬 시간 배율로 효과에 걸린다 -->
	<EditorClick mark="Data.preview.pause"/>
	<WaitUntil watch="Editor.PreviewTimeScale" equals="0" timeoutFrames="30"/>
	<EditorClick mark="Data.preview.step"/>
	<EditorWaitStable/>
	<EditorClick mark="Data.preview.pause"/>
	<WaitUntil watch="Editor.PreviewTimeScale" equals="1" timeoutFrames="30"/>
	<!-- 캐릭터 타깃: 기사 프리팹을 놓으면 효과가 몸에 붙어 원을 돈다 -->
	<EditorClick mark="vfx.targetField"/>
	<EditorText value="common/prefabs/kaykit/knight_merged.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="vfx.targetSpawn"/>
	<WaitUntil watch="Editor.VFXPreviewHasTarget" equals="1" timeoutFrames="600"/>
	<ExpectLog id="VFXPreview.TargetAttached" contains="knight_merged" count="1"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="vfxpreview/target.png"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
