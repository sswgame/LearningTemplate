<?asset guid="9a6c0e52cf7d4a7c8f10b1b9be4f3d68"?>
<!--
  에디터 시나리오 — 폴리지 칠하기: 폴리지 배치는 지형 레이어 가중치(밀도 레이어)를 따르므로 지형 브러시로 칠하고 지운다.
  풀의 밀도 레이어는 바탕(0)이다 — 다른 레이어(3)를 칠하면 풀이 줄고(Editor.TerrainFoliageInstances), 그 레이어를 지우개(erase)로 지우면 다시 늘며,
  Ctrl+Z 두 번이면 처음 수로 돌아온다. 배치는 붓질이 가라앉은 뒤 다시 계산된다(FoliageTerrainFollower). 저장하지 않는다 — 에셋 파일은 그대로다.
  실행: App -EnableEditor -scenario=engine/automation/editor/foliagepaint.scenario.xml -unattended
-->
<Scenario name="editor.foliagepaint" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<Variable name="gv_environmentAnimate" value="0"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="panel.resetOptional"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open game/playground/maps/envshowcase.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitStable/>
	<DevCommand line="camera.reset"/>
	<EditorWaitStable/>
	<DevCommand line="camera.set 0 70 -100 35 0"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.TerrainFoliageInstances" atLeast="1" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<EditorClick mark="viewport.visualizer.terrainbrush"/>
	<WaitUntil watch="Editor.TerrainBrushToolActive" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Store watch="Editor.TerrainFoliageInstances" as="instancesBefore"/>
	<DevCommand line="terrain.brush paint 20 60 3"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="foliagepaint/brush.png" maxMagentaFraction="0"/>
	<EditorDrag mark="sceneView.canvas" dx="160" dy="0"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="1" timeoutFrames="150"/>
	<WaitUntil watch="Editor.TerrainFoliageInstances" differsFrom="instancesBefore" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Store watch="Editor.TerrainFoliageInstances" as="instancesPainted"/>
	<DevCommand line="terrain.brush erase 20 60 3"/>
	<EditorWaitStable/>
	<EditorDrag mark="sceneView.canvas" dx="160" dy="0"/>
	<WaitUntil watch="Editor.TerrainBrushStrokeCount" equals="2" timeoutFrames="150"/>
	<WaitUntil watch="Editor.TerrainFoliageInstances" differsFrom="instancesPainted" timeoutFrames="300"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.TerrainFoliageInstances" sameAs="instancesBefore" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
