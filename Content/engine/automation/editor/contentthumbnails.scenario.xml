<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 콘텐츠 브라우저 썸네일(R9): engine/textures 를 열면 DDS 가 썸네일 캐시에 올라가 실제 텍스처로 그려지고(Editor.ThumbnailCacheCount),
  그림 썸네일이 없는 종류(engine/data 의 Data)는 종류 아이콘을 가운데에 그린다(Editor.ThumbnailFallbackGlyphCount).
  CaptureEditorUI 의 PNG({out}/)로 두 화면을 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/contentthumbnails.scenario.xml -unattended
-->
<Scenario name="editor.contentthumbnails" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus content_browser"/>
	<!-- 검색 칸을 비운다 — 콘텐츠 브라우저는 핵심 패널이라 체인 초기화가 다시 만들지 않으므로, 앞 시나리오(contentbrowser)가 남긴 검색어가 타일을 거른다 -->
	<Wait frames="5"/>
	<EditorClick mark="contentBrowser.search"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="3"/>
	<EditorKey key="Backspace"/>
	<Wait frames="7"/>
	<DevCommand line="content.open engine/textures"/>
	<!-- 폴더 목록은 워커 잡이고 썸네일은 프레임마다 하나씩 읽으므로, 고정 프레임이 아니라 캐시가 찰 때까지 기다린다 -->
	<Wait frames="1"/>
	<WaitUntil watch="Editor.ThumbnailCacheCount" atLeast="1" timeoutFrames="800"/>
	<Wait frames="1"/>
	<!-- engine/textures 에는 빠진 텍스처 그림 자체(missing.dds — 마젠타 체크무늬)가 있어 그 썸네일 한 칸(약 0.07 %)만 허용한다 -->
	<CaptureEditorUI file="textures.png" maxMagentaFraction="0.001"/>
	<Wait frames="3"/>
	<DevCommand line="content.open engine/data"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.ThumbnailFallbackGlyphCount" atLeast="1" timeoutFrames="800"/>
	<Wait frames="1"/>
	<CaptureEditorUI file="data.png"/>
	<Wait frames="3"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
