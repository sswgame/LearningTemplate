<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 행동 트리 패널(behavior_tree, GameFramework 에디터 확장) 저장 왕복: Empty 의 경비 트리(game/empty/data/vocabulary/guard.bt.xml)의 실행마다 새 사본(scratch/saveroundtripbehaviortree — <Scratch>)을 연다.
  고치지 않고 저장(panel.saveDocument) → 글 붙잡기(asset.snapshotScratch) → 디스크에서 다시 읽기(panel.reloadDocument) → 다시 저장 → 같은 바이트(asset.expectScratchUnchanged).
  저장이 실패하면(문서를 읽지 못했다) panel.saveDocument 가 진다. 원본은 건드리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/saveroundtripbehaviortree.scenario.xml -unattended
-->
<Scenario name="editor.saveroundtripbehaviortree" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<Scratch from="game/empty/data/vocabulary" as="scratch/saveroundtripbehaviortree"/>
	<Variable name="gv_editorWatchPanel" value="behavior_tree"/>
	<EditorWaitSettled/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus behavior_tree"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutSeconds="10"/>
	<DevCommand line="asset.openScratch scratch/saveroundtripbehaviortree/guard.bt.xml"/>
	<EditorWaitSettled/>
	<Wait frames="5"/>
	<DevCommand line="panel.saveDocument behavior_tree"/>
	<DevCommand line="asset.snapshotScratch scratch/saveroundtripbehaviortree/guard.bt.xml"/>
	<DevCommand line="panel.reloadDocument behavior_tree"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.saveDocument behavior_tree"/>
	<DevCommand line="asset.expectScratchUnchanged scratch/saveroundtripbehaviortree/guard.bt.xml"/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<EditorWaitSettled/>
	<Pass/>
</Scenario>
