<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 연쇄 리로드: 조부모 머티리얼(grand)을 바깥에서 고치면 그것을 로드할 때 펼쳐 넣은 부모 · 자식 머티리얼(_base=)이 감시를 따라 다시 읽힌다.
  테스트 폴더 engine/automation/editor/assetcascade 의 씬은 parent.material · child.material 을 쓰는 메시 둘이다(grand 는 아무 메시도 직접 쓰지 않는다 — 그래도 연쇄는 돈다).
  사본(scratch/assetcascade)의 grand.material 을 grand_edited.material(거칠기만 다르다)의 글로 덮어쓰면(바깥 편집기의 저장과 같은 원자적 쓰기) 파일 감시가 알리고,
  핫 리로드가 역색인으로 grand 를 펼쳐 넣은 로드된 머티리얼 둘을 의존 순서로 다시 읽는다(Editor.AssetCascadeReloadCount — 파일 감시를 따르는 감시 값이라 벽시계로 기다린다).
  실행: App -EnableEditor -scenario=engine/automation/editor/assetcascade.scenario.xml -unattended
-->
<Scenario name="editor.assetcascade" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/assetcascade" as="scratch/assetcascade"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open scratch/assetcascade/assetcascade.scene.xml"/>
	<EditorWaitStable/>
	<!-- 역색인이 사본 복사를 따라와야 grand 의 참조자를 안다. 콘텐츠 브라우저를 앞에 두면 따라오기 전에는 시계가 멈춘다(ContentBrowserReferenceIndex) -->
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1" timeoutWallSeconds="60"/>
	<Store watch="Editor.AssetCascadeReloadCount" as="beforeEdit"/>
	<Store watch="RHI.GPUIdleWaits" as="idleBeforeEdit"/>
	<DevCommand line="asset.overwriteScratch scratch/assetcascade/grand_edited.material scratch/assetcascade/grand.material"/>
	<!-- 연쇄 둘(parent · child)은 감시 사건 하나를 처리하는 같은 프레임에 돈다 — 값이 바뀌었으면 둘 다 끝났다 -->
	<WaitUntil watch="Editor.AssetCascadeReloadCount" differsFrom="beforeEdit" timeoutWallSeconds="30"/>
	<EditorWaitStable/>
	<!-- 머티리얼 핫 리로드는 렌더 스레드만 비우고 GPU 를 기다리지 않는다(옛 자원은 지연 해제) -->
	<Expect watch="RHI.GPUIdleWaits" sameAs="idleBeforeEdit"/>
	<ExpectLog id="AssetHotReload.CascadeReload" contains="scratch/assetcascade/parent.material (inlines scratch/assetcascade/grand.material)" count="1"/>
	<ExpectLog id="AssetHotReload.CascadeReload" contains="scratch/assetcascade/child.material (inlines scratch/assetcascade/grand.material)" count="1"/>
	<!-- 리로드 결과 집계(reload.status): 연쇄 둘이 성공으로 적혔고 낡은(이전 값으로 도는) 경로가 없다 -->
	<Expect watch="DevTools.ReloadAssetCount" atLeast="2"/>
	<Expect watch="DevTools.ReloadStaleCount" equals="0"/>
	<DevCommand line="reload.status"/>
	<Pass/>
</Scenario>
