<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 체인 사이의 게임 모듈 리로드 — 편집 중에 SWGame 을 다시 올린 뒤 에디터가 멀쩡한지 본다: 그래프가 막히지 않았고, 의존 모듈이 지금 이미지에 묶였고, 씬 · 도크가 그대로다.
  편집기 체인(`Scenario.editor`)의 맨 뒤에서 돈다(이름이 `*modulereload` 인 시나리오는 CMake 가 뒤로 보낸다 — 코드 이미지를 갈아 끼운 것이 다른 단계에 닿지 않게)(실제 개발 중 리로드와 같은 조건). 혼자 돌려도 통과한다.
  실행: App -EnableEditor -scenario=engine/automation/editor/gamemodulereload.scenario.xml -unattended
-->
<Scenario name="editor.gamemodulereload" fixedDelta="0.0166667" timeoutFrames="9000" startAfter="Immediately" input="exclusive">
	<DevCommand line="module.reload SWGame"/>
	<Wait frames="1"/>
	<WaitUntil watch="Module.ReloadPending" equals="0" timeoutFrames="6000"/>
	<Wait frames="29"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<Expect watch="Module.BindingsOk" equals="1"/>
	<Expect watch="Editor.ObjectCount" atLeast="1"/>
	<EditorExpectDockLayout/>
	<ExpectLog contains="Manual Live Reload queued for SWGame" atLeast="1"/>
	<Pass/>
</Scenario>
