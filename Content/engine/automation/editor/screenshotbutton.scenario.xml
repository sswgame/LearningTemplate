<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 스크린샷 단추(EditorPlus G2): 게임 뷰 툴바의 카메라 단추 → 씬 뷰 툴바의 카메라 단추 → 개발 명령 screenshot <파일>.
  단추마다 렌더 스레드가 "Screenshot saved: <경로>" 를 남긴다. 파일 크기와 PNG 머리는 RenderPassGPUTest.ScreenshotDumpWritesPngAndPpm 이 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/screenshotbutton.scenario.xml -unattended
-->
<Scenario name="editor.screenshotbutton" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus game_view"/>
	<EditorWaitStable/>
	<EditorClick mark="gameView.screenshot"/>
	<EditorWaitStable/>
	<ExpectLog id="Screenshot.Saved" count="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitStable/>
	<EditorClick mark="sceneView.screenshot"/>
	<EditorWaitStable/>
	<ExpectLog id="Screenshot.Saved" count="2"/>
	<EditorWaitStable/>
	<DevCommand line="screenshot {out}/devcommand.png"/>
	<EditorWaitStable/>
	<ExpectLog id="Screenshot.Saved" contains="{out}/devcommand.png" count="1"/>
	<ExpectLog id="Screenshot.NotWritten" count="0"/>
	<Pass/>
</Scenario>
