<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 본 마스크 계층 칠하기(AnimationGraphLayerEditor 의 Skeleton view): 테스트 그래프(animgraphmaskpaint/maskpaint.animgraph.xml, 마스크 Upper = spine 자손 1 · 스켈레톤에 없는 tail)의
  새 사본(scratch/animgraphmaskpaint)을 열고, 레이어 탭에서 마스크를 고른 뒤 검증 스켈레톤(maskpaint.skeleton.xml, 본 다섯)을 친다.
  계층 보기가 본 다섯 줄을 펼치고(Editor.AnimationGraphMaskBoneRowCount = 5) 없는 본 tail 을 빨간 줄로 알린다(그림 maskpaint/hierarchy.png).
  arm 을 골라 "이 본만" 칠하면 항목이 하나 늘고(2 → 3), 초기화하면 줄어든다(3 → 2). 다시 칠해 저장한 뒤 Load 가 항목 셋을 되읽는다 — 칠하기가 그래프 파일에 남는다.
  스켈레톤은 검증 문맥이라 그래프에 적히지 않는다. 사본에만 쓰므로 추적 중인 원본은 바뀌지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/animgraphmaskpaint.scenario.xml -unattended
-->
<Scenario name="editor.animgraphmaskpaint" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/animgraphmaskpaint" as="scratch/animgraphmaskpaint"/>
	<EditorWaitStable/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus animation_graph"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/animgraphmaskpaint/maskpaint.animgraph.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.AnimationGraphBoneMaskCount" equals="1" timeoutFrames="90"/>
	<Expect watch="Editor.AnimationGraphMaskEntryCount" equals="2"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.tab.layers" state="Down"/>
	<Wait frames="1"/>
	<EditorClick mark="animationGraph.tab.layers" state="Up"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.mask.0"/>
	<EditorWaitStable/>
	<Expect watch="Editor.AnimationGraphMaskBoneRowCount" equals="0"/>
	<EditorClick mark="animationGraph.mask.skeleton"/>
	<EditorWaitStable/>
	<EditorText value="scratch/animgraphmaskpaint/maskpaint.skeleton.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.AnimationGraphMaskBoneRowCount" equals="5" timeoutFrames="120"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="maskpaint/hierarchy.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<!-- arm(줄 2)을 고르고 이 본만 칠한다 — "bones" 항목이 하나 는다 -->
	<EditorClick mark="animationGraph.mask.bone.2"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.mask.paintBone"/>
	<WaitUntil watch="Editor.AnimationGraphMaskEntryCount" equals="3" timeoutFrames="60"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="maskpaint/painted.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.mask.resetBone"/>
	<WaitUntil watch="Editor.AnimationGraphMaskEntryCount" equals="2" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- head(줄 4)에 자손까지 칠하고 저장 — 다시 읽어도 항목 셋 -->
	<EditorClick mark="animationGraph.mask.bone.4"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.mask.paintSubtree"/>
	<WaitUntil watch="Editor.AnimationGraphMaskEntryCount" equals="3" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.save"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.load"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.AnimationGraphMaskEntryCount" equals="3" timeoutFrames="75"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
