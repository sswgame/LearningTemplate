<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 자동 저장 · 비정상 종료 복구(S3). 사본은 원본을 덮지 않고 에디터 상태 폴더(시나리오마다 빈 폴더)의 Autosave/ 에만 쓴다.
  ① 씬을 고치고(오브젝트 AutosaveProbe) autosave.now 로 사본 하나를 쓴다(주기 대신 — 기본 주기는 300 초).
  ② autosave.rescan 은 남은 사본을 비정상 종료가 남긴 것처럼 복구 후보로 읽는다(실제로는 기동 때 pid 가 죽은 세션 폴더 Autosave/<pid>-<시각>/ 을 넘겨받아 같은 일을 한다).
     Recovered Work 창이 후보 한 줄(씬 id · 저장 시각 · 사본 수 · "Ready to restore")을 보인다.
  ③ 원본 씬을 다시 열면 AutosaveProbe 가 없다(원본은 그대로). Restore 를 누르면 사본이 열리고 소스는 원래 id, 씬은 dirty 이며 AutosaveProbe 가 있다.
  ④ 다시 사본을 쓰고 후보로 읽은 뒤 Discard 를 누르면 후보가 0 이다. 정상 저장은 그 씬의 사본을, 편집기 종료는 자기 세션 폴더를 지운다(EditorAutosaveCommands::onSceneSaved · endSession).
  볼 그림: autosave/recovered.png(후보 한 줄, Restore · Discard 단추). 볼 값: Editor.AutosaveSnapshotCount 1 → 2, Editor.AutosaveRestoredCount 1.
  실행: App -EnableEditor -scenario=engine/automation/editor/autosave.scenario.xml -unattended
-->
<Scenario name="editor.autosave" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveRecoverableCount" equals="0"/>
	<!-- ① 고치고 사본 하나 -->
	<EditorClick mark="hierarchy.create"/>
	<EditorWaitSettled/>
	<EditorClick mark="inspector.name"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="AutosaveProbe"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<DevCommand line="autosave.now"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveSnapshotCount" equals="1"/>
	<ExpectLog id="EditorAutosaveCommands.Written" contains="game/empty/maps/editortest.scene.xml" count="1"/>
	<!-- ② 후보로 읽기 -->
	<DevCommand line="autosave.rescan"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveRecoverableCount" equals="1"/>
	<DevCommand line="panel.focus recovered_work"/>
	<EditorWaitSettled/>
	<CaptureEditorUI file="autosave/recovered.png" maxMagentaFraction="0"/>
	<!-- ③ 원본은 그대로, 복원은 사본을 dirty 로 연다 -->
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="AutosaveProbe" count="0"/>
	<DevCommand line="panel.focus recovered_work"/>
	<EditorWaitSettled/>
	<EditorClick mark="recoveredWork.restore.0" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="recoveredWork.restore.0" state="Up"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Editor.AutosaveRestoredCount" equals="1" timeoutFrames="120"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="AutosaveProbe"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<Expect watch="Editor.AutosaveRecoverableCount" equals="0"/>
	<ExpectLog id="EditorAutosaveCommands.Restored" contains="game/empty/maps/editortest.scene.xml" count="1"/>
	<!-- ④ 폐기 -->
	<DevCommand line="autosave.now"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveSnapshotCount" equals="2"/>
	<DevCommand line="autosave.rescan"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveRecoverableCount" equals="1"/>
	<DevCommand line="panel.focus recovered_work"/>
	<EditorWaitSettled/>
	<EditorClick mark="recoveredWork.discard.0" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="recoveredWork.discard.0" state="Up"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.AutosaveRecoverableCount" equals="0"/>
	<!-- 고친 씬을 열어 둔 채 끝내지 않는다 -->
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
