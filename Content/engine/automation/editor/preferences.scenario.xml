<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 환경설정 창(P2): 커맨드 팔레트로 열고, 검색 칸에 snap 을 치면 Viewport 섹션만 남는다.
  이동 스냅 간격(_gridSnapValue)을 2 로 바꾸면 0.5 초 뒤 저장되고, 파일에는 기본과 다른 그 키 하나만 있다(빈 에디터 상태 폴더라 처음엔 0 개).
  실행: App -EnableEditor -scenario=engine/automation/editor/preferences.scenario.xml -unattended
-->
<Scenario name="editor.preferences" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PreferencesSavedKeyCount" equals="0"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Shift+P"/>
	<EditorWaitStable/>
	<EditorText value="Open editor preferences"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus preferences"/>
	<WaitUntil watch="Editor.PreferencesVisibleSections" equals="9" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="preferences.search"/>
	<EditorWaitStable/>
	<EditorText value="snap"/>
	<WaitUntil watch="Editor.PreferencesVisibleSections" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.EditorViewportPreferences._gridSnapValue" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="2"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PreferencesSavedKeyCount" equals="1"/>
	<EditorWaitStable/>
	<ExpectLog id="EditorSettings.Saved" contains="1 key(s)" atLeast="1"/>
	<Expect watch="Editor.PreferencesSavedKeyCount" equals="1"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
