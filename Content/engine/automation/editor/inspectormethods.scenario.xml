<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터의 FUNCTION 노출 경계(S3). 기본 목록은 CallInEditor 만이다(언리얼 Details 의 CallInEditor 단추).
  Empty 게임의 테스트 무대 컴포넌트 TypedHandleTestComponent 는 CallInEditor 인 Assign Target 과 CallInEditor 가 없는 Clear Target 을 둔다.
  ① 컴포넌트를 달면 메서드 행은 하나(Assign Target), 숨긴 것은 하나(Clear Target)다.
  ② CallInEditor 호출은 오브젝트 편집 하나다 — 값이 바뀌면 되돌리기 한 단계가 쌓이고 Ctrl+Z 로 돌아간다.
  ③ 보기 옵션의 진단 보기(Show All Functions)를 켜면 두 행이 다 그려지고 숨긴 수는 0 이다. Clear Target 을 부르면 값이 비고 되돌리기가 쌓인다.
  볼 그림: inspectormethods/default.png(Assign Target 한 행, Run 단추 색은 중립), inspectormethods/diagnostic.png(Clear Target 줄 끝의 회색 Diagnostic 표시).
  실행: App -EnableEditor -scenario=engine/automation/editor/inspectormethods.scenario.xml -unattended
-->
<Scenario name="editor.inspectormethods" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<ResizeWindow width="2300" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchProperty" value="TypedHandleTestComponent._target"/>
	<EditorWaitStable/>
	<DevCommand line="panel.close prefab_editor"/>
	<!-- ① 기본 목록 -->
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.create"/>
	<EditorWaitStable/>
	<DevCommand line="component.add TypedHandleTestComponent"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<WaitUntil watch="Editor.InspectorMethodRows" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.InspectorHiddenMethods" equals="1"/>
	<Expect watch="Editor.InspectorFilledRows" atLeast="1"/>
	<CaptureEditorUI file="inspectormethods/default.png" maxMagentaFraction="0"/>
	<!-- ② CallInEditor 호출은 되돌리기 한 단계 -->
	<Store watch="Editor.UndoIndex" as="undoBefore"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.method.arg.assignTarget.0"/>
	<EditorWaitStable/>
	<EditorHover mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.method.invoke.assignTarget"/>
	<WaitUntil watch="Editor.SelectedHandle" is="TestMesh / MeshComponent#0" timeoutFrames="75"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoBefore"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.SelectedHandle" is="(none)" timeoutFrames="60"/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<!-- ③ 진단 보기 -->
	<EditorWaitStable/>
	<EditorClick mark="inspector.viewOptions"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.viewOptions.allFunctions"/>
	<WaitUntil watch="Editor.InspectorMethodRows" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.InspectorHiddenMethods" equals="0"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.method.invoke.assignTarget"/>
	<WaitUntil watch="Editor.SelectedHandle" is="TestMesh / MeshComponent#0" timeoutFrames="75"/>
	<CaptureEditorUI file="inspectormethods/diagnostic.png" maxMagentaFraction="0"/>
	<Store watch="Editor.UndoIndex" as="undoAssigned"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.method.invoke.clearTarget"/>
	<WaitUntil watch="Editor.SelectedHandle" is="(none)" timeoutFrames="75"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoAssigned"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.viewOptions"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.viewOptions.allFunctions"/>
	<WaitUntil watch="Editor.InspectorHiddenMethods" equals="1" timeoutFrames="60"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
