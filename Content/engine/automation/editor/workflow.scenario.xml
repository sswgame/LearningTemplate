<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 ① 기본 작업 흐름 — 새 씬 → Hierarchy "+ Create" → 오른쪽 클릭 메뉴로 컴포넌트 붙이기 → 인스펙터에서 이름 고치기 → 되돌리기 · 다시 실행 →
  다른 이름으로 저장 → 새 씬 → 다시 열어 값 확인 → 에디터 안 플레이 시작 · 정지(편집 씬이 그대로).
  패널 입력은 ImGui 사건(EditorClick · EditorText · EditorKey), 메뉴 · 대화상자가 필요한 명령은 개발 명령(DevCommand — 저장 대화상자 대신 scene.saveAs).
  실행: App -EnableEditor -scenario=engine/automation/editor/workflow.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.workflow" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 에디터가 첫 씬을 다 열고 패널을 한 번씩 그릴 때까지 기다린 뒤 빈 씬에서 시작한다 -->
	<EditorWaitSettled/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="GameObject" count="0"/>
	<Expect watch="Editor.PlayState" equals="0"/>
	<!-- 1) 오브젝트 만들기 — 만든 오브젝트가 선택된다 -->
	<EditorClick mark="hierarchy.create"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="GameObject" selected="1"/>
	<!-- 2) 컴포넌트 붙이기 — 선택한 줄을 오른쪽 클릭 → Add Component → 검색 → 항목 -->
	<EditorClick mark="hierarchy.selectedRow" button="1"/>
	<EditorWaitSettled/>
	<EditorHover mark="menu.scene.object.addComponent"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.addComponent.search"/>
	<EditorWaitSettled/>
	<EditorText value="PointLight"/>
	<EditorWaitSettled/>
	<EditorClick mark="hierarchy.addComponent.PointLightComponent"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="GameObject" component="PointLightComponent"/>
	<!-- 3) 인스펙터에서 값 고치기 — 이름 칸을 눌러 전부 고르고 새 이름 + Enter -->
	<EditorClick mark="inspector.name"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="Lamp"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="Lamp" component="PointLightComponent"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<!-- 4) 되돌리기(단축키) · 다시 실행(커맨드) -->
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+Z"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="Lamp" count="0"/>
	<EditorExpectObject name="GameObject" component="PointLightComponent"/>
	<EditorWaitSettled/>
	<DevCommand line="editor edit.redo"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="Lamp" component="PointLightComponent"/>
	<!-- 5) 저장 → 새 씬 → 다시 열기 -->
	<EditorWaitSettled/>
	<DevCommand line="scene.saveAs {out}/workflow.scene.xml"/>
	<WaitUntil watch="Editor.SceneDirty" equals="0" timeoutFrames="60"/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="Lamp" count="0"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open {out}/workflow.scene.xml"/>
	<EditorWaitSettled/>
	<EditorExpectObject name="Lamp" component="PointLightComponent"/>
	<Expect watch="Editor.SceneDirty" equals="0"/>
	<!-- 6) 에디터 안 플레이 시작 · 정지 — 정지하면 편집 씬이 그대로다 -->
	<EditorWaitSettled/>
	<DevCommand line="play"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="150"/>
	<EditorWaitSettled/>
	<DevCommand line="stop"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.PlayState" equals="0"/>
	<EditorExpectObject name="Lamp" component="PointLightComponent"/>
	<Expect watch="Editor.SceneDirty" equals="0"/>
	<Pass/>
</Scenario>
