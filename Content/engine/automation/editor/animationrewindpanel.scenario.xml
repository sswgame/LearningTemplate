<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 애니메이션 되감기 창(animation_rewind): 걷는 기사(knight/knight.prefab.xml — 애니메이터 + 리그)를 놓고 플레이한 뒤 Record 를 켜면
  기사의 트랙이 생기고 기록이 1 초 넘게 쌓인다. 타임라인(Ctrl+클릭으로 값 입력)을 0(가장 이른 기록)으로 옮기면 되감는 중이 되고 PIE 가 멈춘다(언리얼 Rewind Debugger 와 같다).
  Resume 은 되감기를 풀고 PIE 를 다시 돌린다. Record 를 끄면 기록을 비운다.
  감시 값: Editor.AnimationRewindTrackCount · Editor.AnimationRewindHistorySeconds · Editor.AnimationRewindScrubbing(활성 씬의 기록기) · Editor.PlayState.
  실행: App -EnableEditor -scenario=engine/automation/editor/animationrewindpanel.scenario.xml -unattended
-->
<Scenario name="editor.animationrewindpanel" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitStable/>
	<DevCommand line="prefab.spawn engine/automation/editor/knight/knight.prefab.xml"/>
	<EditorWaitStable/>
	<EditorExpectObject name="TestKnight" component="SkeletalAnimatorComponent" selected="1"/>
	<DevCommand line="panel.focus animation_rewind"/>
	<EditorWaitStable/>
	<!-- 새 씬은 저장하지 않았다 — 툴바 Play 가 묻고 Play Anyway 로 띄운다(undosurvivesplay 와 같다) -->
	<EditorClick mark="toolbar.play"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.playAnyway"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="90"/>
	<EditorWaitStable/>
	<Expect watch="Editor.AnimationRewindTrackCount" equals="0"/>
	<!-- Record — 트랙이 생기고 기록이 쌓인다 -->
	<EditorClick mark="animationRewind.record"/>
	<WaitUntil watch="Editor.AnimationRewindTrackCount" atLeast="1" timeoutFrames="60"/>
	<WaitUntil watch="Editor.AnimationRewindHistorySeconds" atLeast="1" timeoutFrames="180"/>
	<Expect watch="Editor.AnimationRewindScrubbing" equals="0"/>
	<EditorWaitStable/>
	<!-- 타임라인 — 가장 이른 기록으로 되감으면 PIE 가 멈춘다 -->
	<EditorClick mark="animationRewind.timeline" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="0"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.AnimationRewindScrubbing" equals="1" timeoutFrames="30"/>
	<Expect watch="Editor.PlayState" equals="2"/>
	<EditorWaitStable/>
	<!-- Resume — 되감기를 풀고 다시 돈다 -->
	<EditorClick mark="animationRewind.resume"/>
	<WaitUntil watch="Editor.AnimationRewindScrubbing" equals="0" timeoutFrames="30"/>
	<Expect watch="Editor.PlayState" equals="1"/>
	<EditorWaitStable/>
	<!-- Record 끄기 — 기록을 비운다 -->
	<EditorClick mark="animationRewind.record"/>
	<WaitUntil watch="Editor.AnimationRewindTrackCount" equals="0" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
