<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 미리보기 창의 하늘(다중 월드 6절 3번). 미리보기 조명 환경은 하늘(SkyComponent)을 스폰하고(EditorPreviewEnvironment::_bSky 기본 켬),
  스카이 패스가 불투명 · 외곽선 뒤에 깊이 1 의 풀스크린 삼각형으로 빈 곳만 칠한다. 그래서 구 둘레의 배경은 SceneColor 클리어 색이 아니라 천정 → 지평선 그러데이션이어야 한다.
  ① 머티리얼 창에 빨간 테스트 머티리얼을 열어 구 미리보기가 그려지게 하고 타깃을 PPM 으로 저장한다(gv_editorPreviewScreenshot).
  ② 창을 닫고 다시 열어(새 미리보기 렌더러) 한 장 더 저장한다 — 스카이 패스가 다시 선 렌더러에서도 도는지 본다.
  그림이 맞는지(위가 천정색, 지평선 쪽이 밝고, 구 뒤는 하늘, 구 위는 하늘에 덮이지 않음)는 저장한 PPM 을 눈으로 본다. 평균 색 문턱값은 GPU 로 돌려 보기 전에는 맞출 수 없어 자동 단언을 두지 않았다.
  파일: {out}/previewsky_<first|reopen>.ppm. 디퍼드에서도 빈 곳만 칠하는지는 같은 시나리오를 -gv_deferred=1 로 돌려 본다(미리보기 렌더러는 창을 열 때 파이프라인을 고른다).
  실행: App -EnableEditor -scenario=engine/automation/editor/previewsky.scenario.xml -unattended (백엔드 vk · dx11 · gl 도 같다. 각 백엔드마다 -gv_deferred=1 을 더한 변형은 app-arg 옵션(이름 앞에 하이픈 둘)에 그 인자를 준다)
-->
<Scenario name="editor.previewsky" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<Wait frames="1"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutFrames="900"/>
	<Wait frames="4"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchPanel" value="material"/>
	<!-- ① 문서를 열어 구 미리보기가 그려지게 한 뒤 타깃을 저장한다 -->
	<Wait frames="20"/>
	<Variable name="gv_editorWatchAsset" value="engine/automation/editor/materialpreview/previewred.material"/>
	<Wait frames="30"/>
	<EditorKey key="Ctrl+P"/>
	<EditorText value="previewred.material"/>
	<EditorKey key="Enter"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<Wait frames="5"/>
	<DevCommand line="panel.focus material"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" atLeast="40" timeoutFrames="600"/>
	<Wait frames="9"/>
	<Variable name="gv_editorPreviewScreenshot" value="{out}/previewsky_first.ppm"/>
	<Wait frames="30"/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<ExpectLog contains="Scene preview renderer started for scene key" atLeast="1"/>
	<ExpectLog contains="Preview viewport screenshot" atLeast="1"/>
	<!-- ② 닫고 다시 연다 — 새 미리보기 렌더러에서도 하늘이 칠해진다 -->
	<Wait frames="10"/>
	<DevCommand line="panel.close material"/>
	<Wait frames="20"/>
	<EditorKey key="Ctrl+P"/>
	<EditorText value="previewred.material"/>
	<EditorKey key="Enter"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<Wait frames="5"/>
	<DevCommand line="panel.focus material"/>
	<Wait frames="1"/>
	<Remember watch="Editor.MaterialPreviewSceneFrames" as="frames"/>
	<Wait frames="1"/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" differsFrom="frames" timeoutFrames="300"/>
	<Wait frames="48"/>
	<Variable name="gv_editorPreviewScreenshot" value="{out}/previewsky_reopen.ppm"/>
	<Wait frames="30"/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<ExpectLog contains="Scene preview renderer started for scene key" atLeast="2"/>
	<ExpectLog contains="Preview viewport screenshot" atLeast="2"/>
	<Wait frames="5"/>
	<DevCommand line="panel.close material"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
