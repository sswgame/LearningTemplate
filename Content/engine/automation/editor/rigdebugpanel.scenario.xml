<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 리그 디버그 창(rig_debug): 기사 몸 + 애니메이터 + 리그(노드 둘 — ForearmTwist 가중치 1, ShrinkHead 가중치 0.5) 프리팹을 놓고 고른 채 플레이하면
  리그가 묶여 창에 노드 표가 뜬다(리그는 플레이 시작에서 묶는다 — 언리얼 Control Rig 디버그도 PIE 인스턴스를 본다).
  On 칸을 누르면 노드가 꺼지고 다시 누르면 켜진다. Weight 칸(Ctrl+클릭으로 값 입력)에 1 을 넣으면 가중치 합이 2 가 된다. Stop 이 플레이 값을 버린다.
  데이터: knight/knight.prefab.xml · knight/knight.rig.xml(저장소 리그를 건드리지 않는 시험용 — Save To Rig 는 누르지 않는다).
  감시 값: Editor.RigDebugNodeCount · Editor.RigDebugEnabledNodeCount · Editor.RigDebugWeightSum(고른 오브젝트의 묶인 리그).
  실행: App -EnableEditor -scenario=engine/automation/editor/rigdebugpanel.scenario.xml -unattended
-->
<Scenario name="editor.rigdebugpanel" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitStable/>
	<DevCommand line="prefab.spawn engine/automation/editor/knight/knight.prefab.xml"/>
	<EditorWaitStable/>
	<EditorExpectObject name="TestKnight" component="PoseModifierComponent" selected="1"/>
	<DevCommand line="panel.focus rig_debug"/>
	<EditorWaitStable/>
	<!-- 새 씬은 저장하지 않았다 — 툴바 Play 가 묻고 Play Anyway 로 띄운다(undosurvivesplay 와 같다) -->
	<EditorClick mark="toolbar.play"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.playAnyway"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="90"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.RigDebugNodeCount" equals="2" timeoutFrames="120"/>
	<Expect watch="Editor.RigDebugEnabledNodeCount" equals="2"/>
	<Expect watch="Editor.RigDebugWeightSum" near="1.5" tolerance="0.001"/>
	<EditorWaitStable/>
	<!-- On 칸 — 끄고 다시 켠다 -->
	<EditorClick mark="rigdebug.node.0.on"/>
	<WaitUntil watch="Editor.RigDebugEnabledNodeCount" equals="1" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="rigdebug.node.0.on"/>
	<WaitUntil watch="Editor.RigDebugEnabledNodeCount" equals="2" timeoutFrames="30"/>
	<EditorWaitStable/>
	<!-- Weight 칸 — ShrinkHead 를 1 로 -->
	<EditorClick mark="rigdebug.node.1.weight" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="1"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.RigDebugWeightSum" near="2" tolerance="0.001" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
