<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 한 프로세스 재생(서버 디버깅 S8). Multiplayer 창의 In process 탭에서 본보기 게임(`Sample: avatars`)을 클라이언트 둘로 시작하고,
  월드 셋(서버 · 클라이언트 1 · 클라이언트 2)이 각자 씬에 아바타를 그리는지 본다. 입력은 초점이 있는 월드 하나만 받는다 — 클라이언트 1 에 초점을 두고 D 를 누르면
  아바타 1(먼저 붙은 클라이언트의 연결 id 0 + 1)만 서버에서 오른쪽으로 가고, 두 클라이언트 월드가 같은 위치를 보인다. 클라이언트 2 의 뷰포트를 눌러 초점을 옮기고 W 를 누르면 아바타 2 가 앞으로 간다.
  위치는 감시 값 `Editor.NetSimObjectX` · `Editor.NetSimObjectZ`(target = 월드 번호, key = 오브젝트 이름 `Avatar<엔티티 id>`)로, 월드 · 틱 수는 `Editor.NetSim*` 로 본다. 서버와 클라이언트의 위치는 멈춘 뒤 `sameAs` 로 같은지 견준다
  (멈추면 받은 위치로 붙어 값이 정확히 같다). 모양(월드마다 상자, 바닥, 하늘)은 `CaptureEditorUI` 가 `{out}/` 에 남기는 이미지를 눈으로 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/netsim.scenario.xml -unattended
-->
<Scenario name="editor.netsim" requiresModule="GF_EditorPlugin_NetSimulation" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus multiplayer"/>
	<Wait frames="20"/>
	<EditorClick mark="multiplayer.tab.inprocess" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="multiplayer.tab.inprocess" state="up"/>
	<!-- 시작: 게임 목록의 첫 게임(본보기)이 클라이언트 둘로 선다. 첫 클라이언트가 입력 초점을 받는다 -->
	<Wait frames="12"/>
	<Expect watch="Editor.NetSimRunning" equals="0"/>
	<EditorClick mark="multiplayer.inprocess.start" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="multiplayer.inprocess.start" state="up"/>
	<Wait frames="12"/>
	<WaitUntil watch="Editor.NetSimTick" atLeast="120"/>
	<Wait frames="5"/>
	<ExpectLog contains="In-process play started: Sample: avatars with 2 client(s)" count="1"/>
	<Expect watch="Editor.NetSimRunning" equals="1"/>
	<Expect watch="Editor.NetSimWorldCount" equals="3"/>
	<Expect watch="Editor.NetSimViewportCount" equals="3"/>
	<Expect watch="Editor.NetSimInputFocus" equals="1"/>
	<!-- 시작 위치: 아바타 1 · 2 가 가로로 -3 · -1, 세 월드가 모두 둘을 본다 -->
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar1" near="-3" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar2" near="-1" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="1" key="Avatar1" near="-3" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="1" key="Avatar2" near="-1" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="2" key="Avatar1" near="-3" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="2" key="Avatar2" near="-1" tolerance="0.01"/>
	<CaptureEditorUI file="netsim/start.png"/>
	<!-- 클라이언트 1 에 초점 — D 를 누르면 아바타 1 만 오른쪽으로 간다 -->
	<Wait frames="15"/>
	<Tap slot="Key.D" hold="20"/>
	<Wait frames="30"/>
	<WaitUntil watch="Editor.NetSimTick" atLeast="400"/>
	<Wait frames="5"/>
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar1" atLeast="-2"/>
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar1" atMost="7"/>
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar2" near="-1" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectZ" target="0" key="Avatar1" near="0" tolerance="0.01"/>
	<Remember watch="Editor.NetSimObjectX" target="0" key="Avatar1" as="avatar1X"/>
	<Expect watch="Editor.NetSimObjectX" target="1" key="Avatar1" sameAs="avatar1X"/>
	<Expect watch="Editor.NetSimObjectX" target="2" key="Avatar1" sameAs="avatar1X"/>
	<Expect watch="Editor.NetSimObjectX" target="1" key="Avatar2" near="-1" tolerance="0.01"/>
	<CaptureEditorUI file="netsim/moved.png"/>
	<!-- 클라이언트 2 의 뷰포트를 눌러 초점을 옮긴다 — W 를 누르면 아바타 2 만 앞으로 간다 -->
	<EditorClick mark="multiplayer.inprocess.world2" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="multiplayer.inprocess.world2" state="up"/>
	<WaitUntil watch="Editor.NetSimInputFocus" equals="2" timeoutFrames="60"/>
	<Tap slot="Key.W" hold="20"/>
	<Wait frames="25"/>
	<WaitUntil watch="Editor.NetSimTick" atLeast="700"/>
	<Wait frames="5"/>
	<Expect watch="Editor.NetSimObjectZ" target="0" key="Avatar2" atLeast="1"/>
	<Expect watch="Editor.NetSimObjectZ" target="0" key="Avatar1" near="0" tolerance="0.01"/>
	<Expect watch="Editor.NetSimObjectX" target="0" key="Avatar1" sameAs="avatar1X"/>
	<Remember watch="Editor.NetSimObjectZ" target="0" key="Avatar2" as="avatar2Z"/>
	<Expect watch="Editor.NetSimObjectZ" target="1" key="Avatar2" sameAs="avatar2Z"/>
	<Expect watch="Editor.NetSimObjectZ" target="2" key="Avatar2" sameAs="avatar2Z"/>
	<CaptureEditorUI file="netsim/focus2.png"/>
	<!-- 멈춤: 세션이 내려가고 감시 값이 값을 내지 않는다 -->
	<EditorClick mark="multiplayer.inprocess.stop" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="multiplayer.inprocess.stop" state="up"/>
	<WaitUntil watch="Editor.NetSimRunning" equals="0" timeoutFrames="60"/>
	<Pass/>
</Scenario>
