<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 묶음 viewportoverlay(2/2) — 1/2 가 남긴 오버레이 상태가 다시 켜도 그대로다(보기 바는 왼쪽 3, 트랜스폼 바는 접힘, 도구 바는 숨김).
  overlay.reset 이면 모두 기본 자리 · 보임으로 돌아온다.
  실행: 1/2 와 같은 -gv_editorStateDir 로 이어서.
-->
<Scenario name="editor.viewportoverlay.2" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<Wait frames="40"/>
	<Variable name="gv_editorWatchOverlay" value="view"/>
	<Expect watch="Editor.OverlayDock" equals="3"/>
	<Expect watch="Editor.OverlayVertical" equals="1"/>
	<Variable name="gv_editorWatchOverlay" value="transform"/>
	<Wait frames="2"/>
	<Expect watch="Editor.OverlayFlags" equals="11"/>
	<Variable name="gv_editorWatchOverlay" value="tools"/>
	<Wait frames="2"/>
	<Expect watch="Editor.OverlayFlags" equals="0"/>
	<Wait frames="6"/>
	<DevCommand line="overlay.reset"/>
	<Wait frames="15"/>
	<Expect watch="Editor.OverlayFlags" equals="1"/>
	<Variable name="gv_editorWatchOverlay" value="view"/>
	<Wait frames="2"/>
	<Expect watch="Editor.OverlayDock" equals="1"/>
	<Wait frames="3"/>
	<Pass/>
</Scenario>
