<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 저장된 상태 ①: 빈 에디터 상태 폴더로 시작하면 기본 배치(Scene 탭이 앞)이다. Prefab Overrides 탭을 앞으로 가져오고,
  테마 대화상자에서 액센트 스와치를 누른 뒤 끝낸다. 끝낼 때 도킹 배치(imgui.ini · windows.ini)와 EditorConfig.json 이 그 폴더에 저장된다.
  CTest Scenario.editor.statedir.savedstate 가 savedstate.1 과 savedstate.2 를 같은 상태 폴더로 이어 돌린다(Test/Scenario/RunStateDirPair.cmake).
  실행: App.exe -EnableEditor -gv_editorStateDir=<빈 폴더> -scenario=engine/automation/editor/savedstate.1.scenario.xml -dx12
-->
<Scenario name="editor.savedstate.1" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<Wait frames="40"/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<Wait frames="5"/>
	<DevCommand line="panel.focus prefab_editor"/>
	<WaitUntil watch="Editor.SceneViewDrawn" equals="0" timeoutFrames="75"/>
	<DevCommand line="editor editor.themeSettings"/>
	<Wait frames="15"/>
	<EditorClick mark="theme.swatch.violet"/>
	<WaitUntil watch="Editor.AccentColor" equals="10902002" timeoutFrames="60"/>
	<Wait frames="10"/>
	<Pass/>
</Scenario>
