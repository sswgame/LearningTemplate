<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 미리보기 창 수명(감사 E-14): 미리보기 창을 닫으면 그 창의 미리보기 씬 · 렌더 타깃을 놓고, 다시 열면 씬을 새로 만든다
  (언리얼은 에셋 편집기를 닫으면 FPreviewScene 을 파괴한다). 해제는 기반 EditorPreviewPanel::onPanelClosed 한 곳이라 클립 미리보기 창 하나로 본다.
  도구 패널을 새 세션 상태로 돌린 뒤(panel.resetOptional) 열기 → 1, 닫기 → 0, 다시 열기 → 1(다시 그린다), 닫기 → 0.
  창은 문서가 없으면 뷰포트를 그리지 않는다 — 처음 열 때 Quick Open 으로 기사의 환호 클립(cheer.animclip)을 연다. 문서는 닫아도 패널에 남아 다시 열면 새 씬을 그린다.
  감시 값: Editor.PreviewSceneCount(씬 매니저가 가진 미리보기 씬 수), Editor.ClipPreviewSceneFrames(새 뷰포트가 렌더러에 그리기를 낸 수 — 닫으면 0 으로 돌아간다).
  실행: App -EnableEditor -scenario=engine/automation/editor/previewrelease.scenario.xml -unattended
-->
<Scenario name="editor.previewrelease" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.resetOptional"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewSceneCount" equals="0" timeoutFrames="120"/>
	<DevCommand line="panel.focus animation_clip_preview"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewSceneCount" equals="1" timeoutFrames="300"/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitSettled/>
	<EditorText value="cheer_"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.ClipPreviewSceneFrames" atLeast="10" timeoutFrames="300"/>
	<DevCommand line="panel.close animation_clip_preview"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewSceneCount" equals="0" timeoutFrames="120"/>
	<DevCommand line="panel.focus animation_clip_preview"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewSceneCount" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Editor.ClipPreviewSceneFrames" atLeast="10" timeoutFrames="300"/>
	<DevCommand line="panel.close animation_clip_preview"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewSceneCount" equals="0" timeoutFrames="120"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
