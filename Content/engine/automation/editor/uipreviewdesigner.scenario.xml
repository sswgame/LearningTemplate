<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — UI Preview 디자이너(runtime-ui 8-5 뒤의 (6)): 팔레트 → 끌어 놓기 · 지우기 · 슬롯 손잡이. 문서를 저장하지 않으므로 저장소 파일은 바뀌지 않는다.
  1) 슬롯 손잡이 — pause 문서의 Window(캔버스의 자식)를 고르고 가운데 손잡이를 끌면 슬롯의 _offsetMin._x 가 늘고(Editor.UIPreviewSelectedOffsetMinX) 되돌리기 하나가 쌓이며 Undo 로 돌아온다.
  2) 팔레트 — 작은 문서(uipreview/save_probe.ui.xml 의 실행별 사본 scratch/uipreviewdesigner, 위젯 하나)에서 팔레트를 TextWidget 으로 거르고 그 항목을 트리의 루트 줄에 끌어 놓으면 위젯이 하나 늘고, Delete 가 지우고,
     Undo 가 지운 위젯을 같은 자리에 되돌리고, Undo 가 추가를 되돌린다.
  실행: App -EnableEditor -scenario=engine/automation/editor/uipreviewdesigner.scenario.xml -unattended
-->
<Scenario name="editor.uipreviewdesigner" fixedDelta="0.0166667" timeoutFrames="3000" startAfter="Immediately" input="exclusive">
	<AllowLog id="UIPreview.UnsavedEditsDiscarded" reason="체인에서는 앞 시나리오(uipreview)가 고친 채 둔 문서를 이 시나리오가 다른 문서를 열며 버린다 — 그 경고는 체인에서만 난다"/>
	<Scratch from="engine/automation/editor/uipreview" as="scratch/uipreviewdesigner"/>
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="1"/>
	<!-- 1) 슬롯 손잡이 -->
	<Wait frames="34"/>
	<EditorKey key="Ctrl+P"/>
	<Wait frames="15"/>
	<EditorText value="pause.ui.xml"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" atLeast="9" timeoutFrames="900"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewTextureReady" equals="1" timeoutFrames="900"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.widget.Window"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewSlotEditable" equals="1"/>
	<Expect watch="Editor.UIPreviewPaletteCount" atLeast="10"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<Wait frames="5"/>
	<EditorDrag mark="uipreview.handle.move" dx="40" dy="0"/>
	<Wait frames="30"/>
	<Expect watch="Editor.UIPreviewSelectedOffsetMinX" atLeast="20"/>
	<Expect watch="Editor.UIPreviewDirty" equals="1"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewSelectedOffsetMinX" near="0" tolerance="0.5"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.redo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewSelectedOffsetMinX" atLeast="20"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewSelectedOffsetMinX" near="0" tolerance="0.5"/>
	<!-- 2) 팔레트 · 끌어 놓기 · 지우기 -->
	<Wait frames="10"/>
	<DevCommand line="asset.openScratch scratch/uipreviewdesigner/save_probe.ui.xml"/>
	<Wait frames="40"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" equals="1" timeoutFrames="900"/>
	<!-- 1) 에서 고치고 되돌린 문서는 되돌려도 고친 표시(dirty)가 남는다 — 다른 문서를 열면 버린다고 알리는 경고가 의도한 출력이다 -->
	<Wait frames="1"/>
	<ExpectLog id="UIPreview.UnsavedEditsDiscarded" atLeast="1"/>
	<Wait frames="9"/>
	<EditorClick mark="uipreview.palette.filter"/>
	<Wait frames="10"/>
	<EditorText value="TextWidget"/>
	<Wait frames="15"/>
	<EditorDrag mark="uipreview.palette.TextWidget" toMark="uipreview.row.0"/>
	<Wait frames="25"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" equals="2" timeoutFrames="180"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewDirty" equals="1"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.delete"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewWidgetCount" equals="1"/>
	<Expect watch="Editor.UndoCount" equals="2"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewWidgetCount" equals="2"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewWidgetCount" equals="1"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.redo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewWidgetCount" equals="2"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.UIPreviewWidgetCount" equals="1"/>
	<!-- 정리: 거름 칸을 비우고 문서 값을 되찾는다 -->
	<Wait frames="5"/>
	<EditorClick mark="uipreview.palette.filter"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorKey key="Backspace"/>
	<Wait frames="10"/>
	<EditorClick mark="uipreview.reload"/>
	<Wait frames="25"/>
	<Expect watch="Editor.UIPreviewDirty" equals="0"/>
	<Wait frames="5"/>
	<DevCommand line="panel.close ui_preview"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
