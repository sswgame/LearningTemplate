<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 서버 검사기(서버 디버깅 S3). 전용 서버 + App 클라이언트 1 을 띄우면 세션이 서버에 디버그 채널 포트 · 토큰을 준다.
  netplay.inspect 는 Multiplayer 창 Inspector 탭이 Connect 에서 하는 일(채널에 붙어 help 로 이름을 받고 scene.tree 로 하이어라키 읽기)을 한다.
  감시 값 Editor.NetPlayInspectorObjects 가 읽은 오브젝트 수를 보고하고, 같은 채널로 보낸 pause 의 답(paused tick N)이 멈춘 서버도 답하는지 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/netinspector.scenario.xml -unattended
-->
<Scenario name="editor.netinspector" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<AllowLog id="Server.ServerBehindDroppedTicks" reason="전용 서버는 백엔드 넷 · 클라이언트와 함께 같은 기계에서 돌아 부하가 걸린 틱이 늦을 수 있다 — 중계가 자식 경고를 경고 그대로 옮기므로(예전에는 Info 로 숨겼다) 나와도 된다고 적는다"/>
	<WaitUntil watch="Editor.NetPlayProcessCount" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.NetPlayInspectorObjects" equals="0"/>
	<DevCommand line="netplay.start dedicated 1"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.wait 1 120"/>
	<WaitUntil watch="Editor.NetPlayConnectedClients" equals="1" timeoutFrames="60"/>
	<DevCommand line="netplay.inspect"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="inspector read" atLeast="1"/>
	<Expect watch="Editor.NetPlayInspectorObjects" atLeast="1"/>
	<DevCommand line="netplay.inspect pause"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.inspect scene.tree 1"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="paused tick" atLeast="1"/>
	<DevCommand line="netplay.inspect resume"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.stop"/>
	<WaitUntil watch="Editor.NetPlayStopping" equals="0" timeoutWallSeconds="20"/>
	<Expect watch="Editor.NetPlayProcessCount" equals="0"/>
	<Pass/>
</Scenario>
