<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰 툴바의 보기 모드(Unlit · Wireframe · Normals · Depth · Overdraw)는 씬 뷰에만 걸린다(뷰마다의 설정, 언리얼 뷰포트 View Mode).
  ① 게임 뷰를 앞에 두고 Lit 기준을 찍는다. ② 씬 뷰를 앞에 두고 Lit 을 찍은 뒤, 툴바 콤보(viewport.viewMode)로 모드를 하나씩 골라 찍는다 —
  모두 씬 뷰 Lit 과 다르다. ③ Normals 로 둔 채 게임 뷰를 앞에 두고 찍으면 ①과 같다(게임 뷰는 Lit 그대로, Editor.GameViewMode 0).
  스크린샷은 주 출력이다 — 게임 뷰가 보이면 게임 뷰, 씬 뷰만 보이면 씬 뷰.
  실행: App -EnableEditor -scenario=engine/automation/editor/viewmodes.scenario.xml -unattended   (AppScenarioTest 가 백엔드마다 돈다)
-->
<Scenario name="editor.viewmodes" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="5"/>
	<ResizeWindow width="1440" height="810"/>
	<Wait frames="10"/>
	<ResizeWindow width="1600" height="900"/>
	<!-- ① 게임 뷰 Lit 기준 -->
	<Wait frames="20"/>
	<DevCommand line="panel.focus game_view"/>
	<Wait frames="30"/>
	<Expect watch="Editor.GameViewRequested" equals="1"/>
	<Expect watch="Editor.GameViewMode" equals="0"/>
	<Screenshot file="viewmodes_game_lit.ppm"/>
	<!-- ② 씬 뷰 Lit 과 보기 모드마다 -->
	<Wait frames="10"/>
	<DevCommand line="panel.focus scene_view"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<Expect watch="Editor.SceneViewMode" equals="0"/>
	<Screenshot file="viewmodes_scene_lit.ppm"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode.unlit"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewMode" equals="1"/>
	<Screenshot file="viewmodes_scene_unlit.ppm"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode.wireframe"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewMode" equals="2"/>
	<Screenshot file="viewmodes_scene_wireframe.ppm"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode.depth"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewMode" equals="4"/>
	<Screenshot file="viewmodes_scene_depth.ppm"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode.overdraw"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewMode" equals="5"/>
	<Screenshot file="viewmodes_scene_overdraw.ppm"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode"/>
	<Wait frames="10"/>
	<EditorClick mark="viewport.viewMode.normals"/>
	<Wait frames="30"/>
	<Expect watch="Editor.SceneViewMode" equals="3"/>
	<Expect watch="Editor.GameViewMode" equals="0"/>
	<Screenshot file="viewmodes_scene_normals.ppm"/>
	<Wait frames="5"/>
	<ExpectImage file="viewmodes_scene_unlit.ppm" golden="viewmodes_scene_unlit"/>
	<ExpectImage file="viewmodes_scene_wireframe.ppm" golden="viewmodes_scene_wireframe"/>
	<ExpectImage file="viewmodes_scene_depth.ppm" golden="viewmodes_scene_depth"/>
	<ExpectImage file="viewmodes_scene_overdraw.ppm" golden="viewmodes_scene_overdraw"/>
	<ExpectImage file="viewmodes_scene_normals.ppm" golden="viewmodes_scene_normals"/>
	<!-- ③ 씬 뷰가 Normals 여도 게임 뷰는 Lit 그대로 -->
	<Wait frames="5"/>
	<DevCommand line="panel.focus game_view"/>
	<Wait frames="30"/>
	<Expect watch="Editor.GameViewRequested" equals="1"/>
	<Expect watch="Editor.SceneViewMode" equals="3"/>
	<Expect watch="Editor.GameViewMode" equals="0"/>
	<Screenshot file="viewmodes_game_after.ppm"/>
	<Wait frames="5"/>
	<ExpectImage file="viewmodes_game_after.ppm" golden="viewmodes_game_after"/>
	<Wait frames="5"/>
	<DevCommand line="panel.focus scene_view"/>
	<Wait frames="10"/>
	<Pass/>
</Scenario>
