<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Sequencer 키 트랙(N9): Quick Open 으로 테스트 시퀀스(sequencerkeys/, GameCamera 를 모는 빈 트랜스폼 트랙)를 열고,
  프레임 0 에서 Key 단추로 키를 찍은 뒤 Location X 칸에 2 를 친다. 시간 막대에 100 을 쳐서 옮기고 Location X 칸에 12 를 치면
  그 채널에 둘째 키가 생긴다(자동 키). 시간 막대 가운데를 누르면 미리보기가 GameCamera 를 두 키 사이(2 와 12 사이)로 옮긴다.
  드래그 칸 · 슬라이더는 Ctrl+클릭이 글 입력이다. Quick Open 은 파일 목록이 온 뒤에 열므로 시퀀서 대상이 생길 때까지 WaitUntil 로 기다린다.
  실행: App -EnableEditor -scenario=engine/automation/editor/sequencerkeys.scenario.xml -unattended
-->
<Scenario name="editor.sequencerkeys" fixedDelta="0.0166667" timeoutFrames="800" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<Variable name="gv_editorWatchObject" value="GameCamera"/>
	<Wait frames="20"/>
	<EditorKey key="Ctrl+P"/>
	<Wait frames="15"/>
	<EditorText value="sequencerkeys.seq.xml"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="0"/>
	<Wait frames="10"/>
	<EditorClick mark="sequencer.addKey"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SequencerKeyFrameCount" equals="1"/>
	<Wait frames="10"/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="2"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<Expect watch="Editor.ObjectPositionX" equals="2"/>
	<Wait frames="10"/>
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="100"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="12"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SequencerKeyFrameCount" equals="2"/>
	<Expect watch="Editor.ObjectPositionX" equals="12"/>
	<Wait frames="10"/>
	<EditorClick mark="sequencer.scrub"/>
	<Wait frames="20"/>
	<Expect watch="Editor.ObjectPositionX" atLeast="4"/>
	<Expect watch="Editor.ObjectPositionX" atMost="10"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
