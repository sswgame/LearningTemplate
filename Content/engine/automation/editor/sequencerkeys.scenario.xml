<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Sequencer 키 트랙(N9)과 바인딩: 테스트 씬(sequencerkeys/sequencerkeys.scene.xml — Director 의 플레이어가 바인딩 1 을 Mover 에 묶는다)을 열고
  Quick Open 으로 테스트 시퀀스(바인딩 Mover 를 모는 빈 트랜스폼 트랙)를 연다. 바인딩이 하나이고 묶이지 않은 바인딩이 없다(패널이 씬 플레이어를 바인딩 문맥으로 찾았다).
  프레임 0 에서 Key 단추로 키를 찍은 뒤 Location X 칸에 2 를 친다. 시간 막대에 100 을 쳐서 옮기고 Location X 칸에 12 를 치면
  그 채널에 둘째 키가 생긴다(자동 키). 시간 막대 가운데를 누르면 미리보기가 Mover 를 두 키 사이(2 와 12 사이)로 옮긴다 — 이름이 아니라 바인딩으로 찾았다.
  키 띠 가운데(키 없음)를 누르면 고른 키가 없다. 드래그 칸 · 슬라이더는 Ctrl+클릭이 글 입력이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/sequencerkeys.scenario.xml -unattended
-->
<Scenario name="editor.sequencerkeys" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open engine/automation/editor/sequencerkeys/sequencerkeys.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchObject" value="Mover"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitSettled/>
	<EditorText value="sequencerkeys.seq.xml"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="0"/>
	<Expect watch="Editor.SequencerBindingCount" equals="1"/>
	<Expect watch="Editor.SequencerUnboundCount" equals="0"/>
	<EditorWaitSettled/>
	<EditorClick mark="sequencer.addKey"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="1" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="2"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.ObjectPositionX" equals="2" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="100"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<EditorClick mark="sequencer.channel.0" mods="ctrl"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="12"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.ObjectPositionX" equals="12"/>
	<EditorClick mark="sequencer.scrub"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.ObjectPositionX" atLeast="4"/>
	<Expect watch="Editor.ObjectPositionX" atMost="10"/>
	<EditorWaitSettled/>
	<!-- 키 띠 가운데(프레임 50)에는 키가 없다 — 누르면 고른 키를 비우고 그 프레임으로 간다(키 고르기 · 끌기는 모델 테스트 KeySelectionTogglesAndKeeps · MoveSelectedKeysKeepsEveryKey) -->
	<EditorClick mark="sequencer.keyStrip.0"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SequencerSelectedKeyCount" equals="0"/>
	<!-- 보기: 확대는 지금 프레임(50)을 두고 폭을 반으로, 맞추기는 타임라인 전체(모델 테스트 ZoomKeepsTheAnchorFrameAndStaysInside) -->
	<EditorClick mark="sequencer.zoomIn"/>
	<WaitUntil watch="Editor.SequencerViewFrameSpan" equals="50" timeoutFrames="60"/>
	<EditorClick mark="sequencer.zoomFit"/>
	<WaitUntil watch="Editor.SequencerViewFrameSpan" equals="100" timeoutFrames="60"/>
	<!-- 키 복사 · 붙여넣기: 키 띠 왼쪽 끝(프레임 0)의 키를 골라 지금 프레임(50)에 붙이면 키 프레임이 셋이다(모델 테스트 PasteKeysKeepsTrackAndFrameOffsets) -->
	<EditorClick mark="sequencer.keyStrip.0" anchor="0.002,0.5"/>
	<WaitUntil watch="Editor.SequencerSelectedKeyCount" equals="1" timeoutFrames="60"/>
	<EditorClick mark="sequencer.copyKeys"/>
	<EditorWaitSettled/>
	<EditorClick mark="sequencer.pasteKeys"/>
	<WaitUntil watch="Editor.SequencerKeyFrameCount" equals="3" timeoutFrames="60"/>
	<!-- 오류 배지 · 재정렬: 프로퍼티 트랙은 대상 경로가 비어 배지가 붙고(종류 표 줄의 _bUsesPropertyPath), 위로 옮기면 고른 트랙이 0 번이 된다 -->
	<EditorClick mark="sequencer.addTrack.Property"/>
	<WaitUntil watch="Editor.SequencerTrackIssueCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.SequencerSelectedTrack" equals="1"/>
	<EditorClick mark="sequencer.moveTrackUp"/>
	<WaitUntil watch="Editor.SequencerSelectedTrack" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.SequencerTrackIssueCount" equals="1"/>
	<EditorWaitSettled/>
	<CaptureEditorUI file="sequencerkeys/sequencer.png" maxMagentaFraction="0"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
