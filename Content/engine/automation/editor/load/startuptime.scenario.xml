<!--
  편집기 부하 시나리오 — 첫 패널 멈춤: 편집기가 뜬 뒤 첫 그리기에서 패널이 동기로 준비하는 시간(약 1 초로 보고됨)을 잰다(DesignBacklog "에디터 첫 패널 · Hierarchy 8000 측정 계획").
  느린 프레임(100 ms 넘는 것)은 트레이스로 남고(gv_traceSlowTickMs), 측정 창(<Load>)이 프레임 시간을 남긴다. 판정은 기능만이다 — 시간 문턱은 흔들려 넣지 않고 통합이 표를 채운다.
  `Saved/Editor` 를 지운 실행과 둔 실행을 Release 로 세 번씩 돌려 견준다(지우기는 부르는 쪽 몫 — 시나리오는 추적 밖 상태를 지우지 않는다).
  측정 창이 끝내므로 <Pass/> 가 없다. 하위 폴더라 편집기 체인(Scenario.editor)이 줍지 않고 따로 혼자 도는 항목이다.
  실행: ctest -L load (항목 Scenario.engine.editor.load.startuptime) · App -EnableEditor -gv_traceSlowTickMs=100 -scenario=engine/automation/editor/load/startuptime.scenario.xml -unattended
-->
<Scenario name="editor.load.startuptime" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="Immediately" input="exclusive">
	<Launch variable="gv_traceSlowTickMs" value="100"/>
	<AllowLog id="ProfilerTraceExport.SlowTickUsBudget" reason="이 측정은 100 ms 넘는 프레임을 트레이스로 남기려고 느린 틱 추적을 켠다 — 그 알림은 측정 산출물이라 나와도 된다(시간 문턱은 판정하지 않는다)"/>
	<Load durationSeconds="10"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus hierarchy"/>
	<EditorWaitStable/>
	<!-- 첫 씬이 실렸고 계층이 그 행을 그렸다 -->
	<Expect watch="Editor.ObjectCount" atLeast="1"/>
	<Expect watch="Editor.HierarchyVisibleRoots" atLeast="1"/>
	<Record watch="Editor.ObjectCount"/>
	<Record watch="Editor.HierarchyRowRebuildCount"/>
</Scenario>
