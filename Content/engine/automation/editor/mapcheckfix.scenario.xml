<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 맵 검사의 안전한 고침(S3): 반경 0 인 점광(engine/automation/editor/mapcheck/mapcheck_expect_error.scene.xml)의 오류는 고침
  "Set Radius to the default 6 m" 을 데이터로 들고 온다(PointLightComponent::validateRadius → ValidationFix). 고칠 수 없는 결과에는 단추가 없다.
  ① Map Check 창의 줄 끝 Fix 를 누르면 반경이 6 이 되고 결과가 사라진다(되돌리기 한 단계, 씬 dirty).
  ② 되돌리기 → Check Map 을 누르면 결과가 돌아오고, 다시 실행 → Check Map 이면 다시 사라진다. Fix All 은 보이는 줄의 고침을 한 단계로 묶는다.
  볼 그림: mapcheckfix/before.png(줄 끝 Fix 단추, Fix All (1)), mapcheckfix/after.png(빈 상태 글 "No issues").
  실행: App -EnableEditor -scenario=engine/automation/editor/mapcheckfix.scenario.xml -unattended
-->
<Scenario name="editor.mapcheckfix" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchPanel" value="map_check"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open engine/automation/editor/mapcheck/mapcheck_expect_error.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus map_check"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="66"/>
	<EditorWaitStable/>
	<Expect watch="Editor.MapCheckIssueCount" equals="1"/>
	<WaitUntil watch="Editor.MapCheckFixableRows" equals="1" timeoutFrames="60"/>
	<Store watch="Editor.UndoIndex" as="undoBefore"/>
	<CaptureEditorUI file="mapcheckfix/before.png" maxMagentaFraction="0"/>
	<!-- ① 줄 고침 -->
	<EditorClick mark="mapCheck.fix.0" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="mapCheck.fix.0" state="Up"/>
	<WaitUntil watch="Editor.MapCheckIssueCount" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoBefore"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<ExpectLog id="MapCheckFixCommands.Applied" contains="applied 1 fix(es)" count="1"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="mapcheckfix/after.png" maxMagentaFraction="0"/>
	<!-- ② 되돌리기 · 다시 실행 -->
	<DevCommand line="editor edit.undo"/>
	<EditorWaitStable/>
	<EditorClick mark="mapCheck.checkMap" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="mapCheck.checkMap" state="Up"/>
	<WaitUntil watch="Editor.MapCheckIssueCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<DevCommand line="editor edit.redo"/>
	<EditorWaitStable/>
	<EditorClick mark="mapCheck.checkMap" state="Down"/>
	<Wait frames="3"/>
	<EditorClick mark="mapCheck.checkMap" state="Up"/>
	<WaitUntil watch="Editor.MapCheckIssueCount" equals="0" timeoutFrames="60"/>
	<!-- 오류를 심은 씬을 열어 둔 채 끝내지 않는다 -->
	<EditorWaitStable/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<!-- 심은 오류는 씬을 열 때 · 되돌린 뒤 · Check Map 이 다시 검증할 때 한 줄씩 알린다 -->
	<ExpectLog id="ObjectValidation.Issue" contains="ZeroRadiusLight" count="3"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
