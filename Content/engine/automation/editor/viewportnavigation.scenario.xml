<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰 카메라 조작이 상용 엔진 표준을 따르는지 본다(UX 검토 U1).
  ① 휠: 원근 보기에서 궤도 거리가 줄어든다(dolly). ② 가운데 단추 끌기: 카메라가 옆으로 옮겨진다(팬).
  ③ 오른쪽 단추를 누른 채 D 로 옆으로 난 뒤 Alt 만 누르고 마우스를 움직이지 않으면 위치가 그대로다(비행 뒤 궤도 중심이 시선 앞으로 이어져 튀지 않는다).
  ④ 오른쪽 단추 비행 중 휠은 궤도 거리가 아니라 비행 속도를 바꾼다.
  커서는 EditorHover 가 씬 뷰 가운데에 붙잡아 둔다(키와 휠은 씬 뷰 호버를 본다). 가운데 단추는 button="2", 오른쪽은 button="1".
  실행: App -EnableEditor -scenario=engine/automation/editor/viewportnavigation.scenario.xml -unattended
-->
<Scenario name="editor.viewportnavigation" fixedDelta="0.0166667" timeoutFrames="700" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="10"/>
	<DevCommand line="camera.reset"/>
	<Wait frames="10"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/>
	<Wait frames="10"/>
	<Expect watch="Editor.SceneViewOrthographic" equals="0"/>
	<Expect watch="Editor.SceneViewOrbitDistance" near="8" tolerance="0.01"/>
	<Remember watch="Editor.SceneViewCameraX" as="xStart"/>
	<!-- ① 휠 세 눈금: 8 * 0.85^3 = 약 4.9 -->
	<Wait frames="5"/>
	<EditorWheel dy="3"/>
	<Wait frames="15"/>
	<Expect watch="Editor.SceneViewOrbitDistance" atMost="6"/>
	<Expect watch="Editor.SceneViewOrbitDistance" atLeast="0.5"/>
	<Expect watch="Editor.SceneViewCameraX" sameAs="xStart"/>
	<!-- ② 가운데 단추 끌기: 카메라 X 가 바뀐다 -->
	<Wait frames="5"/>
	<EditorDrag mark="sceneView.canvas" button="2" dx="120" dy="0"/>
	<WaitUntil watch="Editor.SceneViewCameraX" differsFrom="xStart" timeoutFrames="60"/>
	<!-- ③ 오른쪽 단추 비행으로 옆으로 난 뒤 Alt 궤도 -->
	<Wait frames="10"/>
	<DevCommand line="camera.reset"/>
	<Wait frames="10"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/>
	<Wait frames="5"/>
	<Remember watch="Editor.SceneViewCameraX" as="xBeforeFly"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.5" state="down"/>
	<Wait frames="10"/>
	<EditorKey key="D" state="down"/>
	<Wait frames="30"/>
	<EditorKey key="D" state="up"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="1" state="up"/>
	<Wait frames="10"/>
	<Expect watch="Editor.SceneViewCameraX" differsFrom="xBeforeFly"/>
	<Remember watch="Editor.SceneViewCameraX" as="xFlown"/>
	<Remember watch="Editor.SceneViewOrbitDistance" as="distFlown"/>
	<Wait frames="5"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/>
	<Wait frames="5"/>
	<EditorKey key="Alt" state="down"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SceneViewCameraX" sameAs="xFlown"/>
	<Expect watch="Editor.SceneViewOrbitDistance" sameAs="distFlown"/>
	<Wait frames="5"/>
	<EditorKey key="Alt" state="up"/>
	<!-- 북마크(Ctrl+1 저장 → 키패드 7 직교 → 키패드 5 원근 → 1 불러오기) 뒤에도 위치가 그대로고, 직교 전환 뒤에도 Alt 만 누르면 위치가 그대로다 -->
	<Wait frames="2"/>
	<EditorKey key="Ctrl+1"/>
	<Wait frames="3"/>
	<EditorKey key="Keypad7"/>
	<Wait frames="5"/>
	<Remember watch="Editor.SceneViewCameraX" as="xOrtho"/>
	<Wait frames="2"/>
	<EditorKey key="Alt" state="down"/>
	<Wait frames="8"/>
	<Expect watch="Editor.SceneViewCameraX" sameAs="xOrtho"/>
	<Wait frames="1"/>
	<EditorKey key="Alt" state="up"/>
	<Wait frames="2"/>
	<EditorKey key="Keypad5"/>
	<Wait frames="2"/>
	<EditorKey key="1"/>
	<Wait frames="3"/>
	<Expect watch="Editor.SceneViewCameraX" sameAs="xFlown"/>
	<!-- ④ 비행 중 휠은 속도다: 궤도 거리는 그대로 -->
	<Wait frames="2"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.5"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.5" state="down"/>
	<Wait frames="10"/>
	<Remember watch="Editor.SceneViewOrbitDistance" as="distBeforeFlyWheel"/>
	<Wait frames="5"/>
	<EditorWheel dy="3"/>
	<Wait frames="15"/>
	<Expect watch="Editor.SceneViewOrbitDistance" sameAs="distBeforeFlyWheel"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="1" state="up"/>
	<Wait frames="15"/>
	<Pass/>
</Scenario>
