<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 카탈로그 곡선 그래프(VFX 저작 UX): 카탈로그 편집기에서 엔진 표본 효과(sparks.vfx.xml)를 열고 첫 방출기의 Curves 창을 연다.
  곡선 미리보기를 누르면 위 그래프가 그 곡선을 열고, 키 하나를 끌어 놓으면 키 값이 문서에 한 번 적힌다(편집 한 줄 — 모델 테스트 ApplyEditedCurveMatchesTheGraph).
  파일은 저장하지 않는다(Revert 로 저장된 글로 돌린다 — 저장소의 데이터를 건드리지 않는다).
  실행: App -EnableEditor -scenario=engine/automation/editor/catalogcurvegraph.scenario.xml -unattended
-->
<Scenario name="editor.catalogcurvegraph" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus catalog_editor"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.CatalogFileCount" atLeast="1" timeoutFrames="800"/>
	<EditorClick mark="catalog.filter"/>
	<EditorText value="sparks"/>
	<EditorWaitStable/>
	<EditorClick mark="catalog.file.first"/>
	<WaitUntil watch="Editor.CatalogRowCount" atLeast="1" timeoutFrames="300"/>
	<ExpectLog id="Catalog.Opened" contains="sparks" count="1"/>
	<EditorWaitStable/>
	<EditorClick mark="catalog.curves.open"/>
	<EditorWaitStable/>
	<EditorClick mark="catalog.curves.preview"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="catalogcurvegraph/graph.png" maxMagentaFraction="0"/>
	<EditorDrag mark="catalog.curves.graph.key.0" dy="-40"/>
	<EditorWaitStable/>
	<ExpectLog id="Catalog.TableEdited" contains="Edited the keys of" count="1"/>
	<EditorWaitStable/>
	<EditorClick mark="catalog.curves.close"/>
	<EditorWaitStable/>
	<EditorClick mark="catalog.revert"/>
	<EditorWaitStable/>
	<ExpectLog id="Catalog.Reverted" count="1"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
