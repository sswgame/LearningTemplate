<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 잠그지 않은(읽기 전용) 파일 앞에서 문서 패널 저장이 거절되는지(감사 E-11). 버전 관리가 잠그지 않은 파일(git LFS lockable = 읽기 전용)을 흉내 낸다.
  패널 셋이 저장 확인 하나(IEditorDocumentPanel::saveDocumentAndClearDirty → collectFilesToSave → EditorContentWrite::warnIfReadOnly)를 지나는지 본다:
  ① 에셋 문서 하나(머티리얼 — 연 파일), ② 여러 파일을 쓰는 패널(데이터 테이블 — 게임 데이터 표, 고친 현지화 표가 있으면 그것도), ③ 연 경로가 없는 상태 문서(프로젝트 설정 — 고친 페이지 파일).
  패널마다 panel.lockSaveFiles(패널이 내놓는 쓸 파일의 글을 붙잡고 읽기 전용으로) → panel.expectSaveRefused(저장이 false) → 알림이 떴는지 → panel.unlockSaveFiles(쓰기를 풀고 글이 그대로인지 견준다).
  ①② 는 실행마다 새 사본(<Scratch>)이다. ③ 은 저장소의 설정 파일을 잠갔다가 푼다 — 프로젝트 설정 페이지는 설정 색인이 정한 원본 파일만 가리켜 사본으로 돌릴 수 없다.
  저장이 거절되므로 글은 바뀌지 않고(자동화 쓰기 게이트도 Config/ 쓰기를 막는다), 끝에 Revert 로 편집을 버린다. 잠금은 EditorSaveFileLock 가 쥐어 시나리오가
  unlock 전에 끊겨도(실패 · 시간 초과 · 창 닫힘 — 상태 소멸, 체인 다음 단계 — EditorStateStore::resetAll, 죽은 프로세스 — 장부 releaseStaleLocks) 쓰기 가능으로 돌아온다.
  실행: App -EnableEditor -scenario=engine/automation/editor/saverefusedreadonly.scenario.xml -unattended
-->
<Scenario name="editor.saverefusedreadonly" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/materialpreview" as="scratch/saverefusedmaterial"/>
	<Scratch from="engine/environment" as="scratch/saverefuseddatatable"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitSettled/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>

	<!-- ① 에셋 문서 하나: 머티리얼 -->
	<DevCommand line="panel.focus material"/>
	<EditorWaitSettled/>
	<DevCommand line="asset.openScratch scratch/saverefusedmaterial/previewblue.material"/>
	<EditorWaitSettled/>
	<Wait frames="5"/>
	<DevCommand line="panel.lockSaveFiles material"/>
	<DevCommand line="panel.expectSaveRefused material"/>
	<Expect watch="Editor.NotificationCount" atLeast="1"/>
	<DevCommand line="panel.unlockSaveFiles"/>
	<EditorWaitSettled/>

	<!-- ② 여러 파일을 쓰는 패널: 데이터 테이블(게임 데이터 표) -->
	<DevCommand line="panel.focus data_table"/>
	<EditorWaitSettled/>
	<DevCommand line="asset.openScratch scratch/saverefuseddatatable/default.surfacekinds.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.DataTableGameDataRowCount" atLeast="1" timeoutWallSeconds="10"/>
	<DevCommand line="panel.lockSaveFiles data_table"/>
	<DevCommand line="panel.expectSaveRefused data_table"/>
	<Expect watch="Editor.NotificationCount" atLeast="1"/>
	<DevCommand line="panel.unlockSaveFiles"/>
	<EditorWaitSettled/>

	<!-- ③ 연 경로가 없는 상태 문서: 프로젝트 설정(EngineConfig 페이지 하나를 고쳐 쓸 파일을 만든다) -->
	<DevCommand line="panel.focus projectsettings"/>
	<WaitUntil watch="Editor.ProjectSettingsPageCount" atLeast="3" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="projectsettings.page.EngineConfig"/>
	<WaitUntil watch="Editor.ProjectSettingsKeyCount" atLeast="7" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="inspector.property.EngineConfig._maxFrameDeltaTime" mods="ctrl"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitSettled/>
	<EditorText value="0.2"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.ProjectSettingsDirtyPageCount" equals="1"/>
	<DevCommand line="panel.lockSaveFiles projectsettings"/>
	<DevCommand line="panel.expectSaveRefused projectsettings"/>
	<Expect watch="Editor.NotificationCount" atLeast="1"/>
	<Expect watch="Editor.ProjectSettingsDirtyPageCount" equals="1"/>
	<DevCommand line="panel.unlockSaveFiles"/>
	<EditorWaitSettled/>
	<EditorClick mark="projectsettings.revert"/>
	<WaitUntil watch="Editor.ProjectSettingsDirtyPageCount" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<!-- 거절 셋(패널마다 하나): ExpectLog 는 그 자리까지 쌓인 로그를 세므로 끝에 둔다 -->
	<ExpectLog id="EditorContentWrite.ReadOnly" count="3"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
