<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 미리보기 창 공통 재생 막대(EditorPreviewPanel): 클립 미리보기에 몸을 놓고(clippreview 와 같은 길)
  멈춤 → 시간 배율 0(Editor.PreviewTimeScale) → 문지르기(끌면 멈춘 채) → 다시 재생(1) → 바닥 끄기(Editor.PreviewFloorShown)
  → 축 표시 끄기(Editor.PreviewAxesShown) → 맞춤. 마지막 화면은 CaptureEditorUI 로 찍어 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/previewbar.scenario.xml -unattended
-->
<Scenario name="editor.previewbar" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus animation_clip_preview"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="cheer_"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorClick mark="clip.bodyField"/>
	<EditorText value="common/prefabs/kaykit/knight_merged.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="clip.spawn"/>
	<WaitUntil watch="Editor.ClipPreviewDuration" near="1.6667" tolerance="0.05" timeoutFrames="600"/>
	<WaitUntil watch="Editor.ClipPreviewSceneFrames" atLeast="60" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PreviewTimeScale" equals="1"/>
	<Expect watch="Editor.PreviewFloorShown" equals="1"/>
	<Expect watch="Editor.PreviewAxesShown" equals="1"/>
	<EditorClick mark="AnimationClip.preview.pause"/>
	<WaitUntil watch="Editor.PreviewTimeScale" equals="0" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="AnimationClip.preview.step"/>
	<EditorWaitStable/>
	<EditorDrag mark="AnimationClip.preview.scrub" dx="60" dy="0"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PreviewTimeScale" equals="0"/>
	<EditorClick mark="AnimationClip.preview.pause"/>
	<WaitUntil watch="Editor.PreviewTimeScale" equals="1" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="AnimationClip.preview.floor"/>
	<WaitUntil watch="Editor.PreviewFloorShown" equals="0" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="AnimationClip.preview.axes"/>
	<WaitUntil watch="Editor.PreviewAxesShown" equals="0" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="AnimationClip.preview.axes"/>
	<WaitUntil watch="Editor.PreviewAxesShown" equals="1" timeoutFrames="30"/>
	<EditorClick mark="AnimationClip.preview.frame"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="previewbar.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
