<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 플레이 옵션(N6).
  1) 플레이 중 인스펙터로 GameCamera 의 _priority 를 7 로 바꾸면 바로 들어가고(감시 값 Editor.SelectedProperty), Stop 이 0 으로 되돌린다.
  2) (3 · 4 뒤에) 다시 플레이해 7 로 바꾸고 Play > Keep Simulation Changes 를 쓰면 Stop 뒤에도 7 이고, 그 남김은 되돌리기 하나다(Ctrl+Z 로 0).
  1-1) 플레이 중 여러 오브젝트를 골라도 편집이 막히지 않는다.
  3) F8 은 조종을 놓고(Simulate, 씬 뷰) 다시 F8 이 조종으로 돌아온다(Editor.PlaySimulating).
  4) 게임 뷰 툴바의 Max(Maximize On Play)를 켜고 플레이하면 인스펙터가 닫히고(Editor.PanelOpen), Stop 하면 배치가 돌아온다.
  실행: App -EnableEditor -scenario=engine/automation/editor/playedit.scenario.xml -unattended
-->
<Scenario name="editor.playedit" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<Variable name="gv_editorWatchProperty" value="CameraComponent._priority"/>
	<Variable name="gv_editorWatchPanel" value="inspector"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedProperty" equals="0"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<!-- 1) 플레이 중 편집은 Stop 이 되돌린다 -->
	<EditorWaitStable/>
	<DevCommand line="editor play.start"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PlayState" equals="1"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="7"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="7" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<Expect watch="Editor.SelectedProperty" equals="0"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<!-- 1-1) 플레이 중 여러 오브젝트를 골라도 편집이 막히지 않는다(예전에는 단일 선택만 풀려 있었다). 값은 Stop 이 되돌린다. -->
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestGameCamera" mods="ctrl"/>
	<WaitUntil watch="Editor.SelectionCount" equals="2" timeoutFrames="60"/>
	<EditorWaitStable/>
	<DevCommand line="editor play.start"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="120"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="5"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SelectedPropertySum" equals="10" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<EditorWaitStable/>
	<!-- 3) F8 Eject / Possess -->
	<EditorWaitStable/>
	<DevCommand line="editor play.start"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PlaySimulating" equals="0"/>
	<EditorWaitStable/>
	<EditorKey key="F8"/>
	<WaitUntil watch="Editor.PlaySimulating" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorKey key="F8"/>
	<WaitUntil watch="Editor.PlaySimulating" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<!-- 4) Maximize On Play -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus game_view"/>
	<EditorWaitStable/>
	<EditorClick mark="gameView.maximizeOnPlay"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<DevCommand line="editor play.start"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PlayState" equals="1"/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="135"/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus game_view"/>
	<EditorWaitStable/>
	<EditorClick mark="gameView.maximizeOnPlay"/>
	<!-- 2) Keep Simulation Changes 는 남기고, 그것은 되돌리기 하나다 -->
	<EditorWaitStable/>
	<DevCommand line="editor play.start"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="7"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="7" timeoutFrames="60"/>
	<DevCommand line="editor play.keepChanges"/>
	<EditorWaitStable/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<Expect watch="Editor.SelectedProperty" equals="7"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<EditorWaitStable/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
