<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 창 제목이 미저장 표시(*)를 따라간다(EditorPlus E5). 새 씬을 임시 경로로 저장해 두고 시작하므로 Ctrl+S 가 저장소의 씬을 바꾸지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/windowtitle.scenario.xml -unattended
-->
<Scenario name="editor.windowtitle" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="editor scene.new"/>
	<EditorWaitStable/>
	<DevCommand line="scene.saveAs {out}/windowtitle.scene.xml"/>
	<EditorWaitStable/>
	<Expect watch="Editor.WindowTitleDirty" equals="0"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.create"/>
	<WaitUntil watch="Editor.WindowTitleDirty" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+S"/>
	<WaitUntil watch="Editor.WindowTitleDirty" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.SceneDirty" equals="0"/>
	<Pass/>
</Scenario>
