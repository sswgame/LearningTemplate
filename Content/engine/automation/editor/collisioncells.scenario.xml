<!--
  에디터 시나리오 — 충돌 응답 칸의 마우스 · 키 공통 규칙(R10 · R13): 칸을 누르면 다음 응답으로 돌고(문서 dirty), Ctrl+Z 로 되돌아온다.
  복사 · 붙여넣기의 글 왕복은 CollisionResponseEditModelTest 가 본다. 저장하지 않는다 — 프로젝트 물리 설정은 그대로다.
  실행: App -EnableEditor -scenario=engine/automation/editor/collisioncells.scenario.xml -unattended
-->
<Scenario name="editor.collisioncells" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus collision_responses"/>
	<EditorWaitStable/>
	<Expect watch="Editor.DirtyDocumentCount" equals="0"/>
	<EditorClick mark="collisionResponses.cell.0.0" state="Down"/>
	<AdvanceSimulation frames="3"/> <!-- 누름 · 뗌을 다른 프레임에 둔다(프레임 경계) -->
	<EditorClick mark="collisionResponses.cell.0.0" state="Up"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="collisioncells/edited.png" maxMagentaFraction="0"/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
