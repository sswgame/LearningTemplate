<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 애니메이션 그래프 레이어 탭(AnimationGraphLayers): 레이어 하나 · 본 마스크 하나를 가진 테스트 그래프
  (animgraphlayers/animgraphlayers.animgraph.xml)의 실행마다 새 사본(scratch/animgraphlayers — <Scratch>)을 `asset.openScratch` 로 열고, 인스펙터의 Layers 탭에서 레이어와 마스크를 하나씩 더한다
  (감시 값 Editor.AnimationGraphLayerCount · Editor.AnimationGraphBoneMaskCount). 저장한 뒤 레이어를 지워도 Load 가 저장한 레이어 둘 · 마스크 둘을 되읽는다 —
  패널이 노드와 링크만 들고 있던 때는 저장이 레이어와 마스크를 버렸다.
  사본에만 쓰므로 추적 중인 원본은 바뀌지 않는다(끝에서 더한 레이어와 마스크를 지우고 저장하는 것은 저장 왕복 확인의 일부다).
  실행: App -EnableEditor -scenario=engine/automation/editor/animgraphlayers.scenario.xml -unattended
-->
<Scenario name="editor.animgraphlayers" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/animgraphlayers" as="scratch/animgraphlayers"/>
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus animation_graph"/>
	<Wait frames="20"/>
	<DevCommand line="asset.openScratch scratch/animgraphlayers/animgraphlayers.animgraph.xml"/>
	<Wait frames="40"/>
	<WaitUntil watch="Editor.AnimationGraphLayerCount" equals="1"/>
	<Wait frames="30"/>
	<Expect watch="Editor.AnimationGraphBoneMaskCount" equals="1"/>
	<Expect watch="Editor.AnimationGraphLinkCount" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.tab.layers" state="down"/>
	<Wait frames="1"/>
	<EditorClick mark="animationGraph.tab.layers" state="up"/>
	<Wait frames="19"/>
	<EditorClick mark="animationGraph.layer.add"/>
	<WaitUntil watch="Editor.AnimationGraphLayerCount" equals="2" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.mask.add"/>
	<WaitUntil watch="Editor.AnimationGraphBoneMaskCount" equals="2" timeoutFrames="60"/>
	<CaptureEditorUI file="animgraphlayers/layers.png"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.save"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.layer.remove"/>
	<Wait frames="20"/>
	<Expect watch="Editor.AnimationGraphLayerCount" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.load"/>
	<WaitUntil watch="Editor.AnimationGraphLayerCount" equals="2" timeoutFrames="75"/>
	<Expect watch="Editor.AnimationGraphBoneMaskCount" equals="2"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.layer.1"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.layer.remove"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.mask.1"/>
	<Wait frames="20"/>
	<EditorClick mark="animationGraph.mask.remove"/>
	<WaitUntil watch="Editor.AnimationGraphLayerCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.AnimationGraphBoneMaskCount" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="animationGraph.save"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
