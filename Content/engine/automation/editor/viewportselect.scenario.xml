<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰 선택의 수정 키와 상자 선택(언리얼 · 유니티 · Godot 뷰포트와 같은 조작).
  (1) Ctrl+누름은 넣고 빼기다 — 큐브(TestMesh)를 Ctrl 로 누르면 들고, Ctrl+빈 곳 누름은 선택을 비우지 않으며, 그냥 빈 곳을 누르면 비운다.
  (2) 빈 곳에서 캔버스를 가로질러 끌면 상자에 걸친 오브젝트(크기가 없으면 원점이 든 것)가 모두 골라지고, 화면을 그리는 에디터 카메라는 들지 않는다.
      같은 상자를 Ctrl 로 끌면 넣고 빼기라 모두 빠진다.
  (3) 변환 막대의 크기 스냅 단추가 기즈모 크기 스냅을 켜고 끈다(설정 값 0.1 이 기본). 변환 막대는 고른 것이 있을 때만 쓸 수 있어 상자 선택 뒤에 본다.
  자리(1920x1080 · 배율 1 · 기본 배치): 캔버스 0.475,0.75 는 큐브 앞면의 왼쪽 아래 — 기즈모 손잡이를 피하고 실루엣 안이다(피킹이 메시 삼각형이라 실루엣 밖은 빈 곳이다). 0.02,0.4 는 왼쪽 가장자리의 빈 곳(위 · 아래 막대 밖)이고,
  그 자리에서 (900, 330) 끈 상자는 스프라이트 · 큐브 · 콜라이더 원점을 덮고 아래 막대에 닿지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/viewportselect.scenario.xml -unattended
-->
<Scenario name="editor.viewportselect" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectionCount" equals="0"/>
	<EditorClick mark="sceneView.canvas" anchor="0.475,0.75" mods="ctrl"/>
	<WaitUntil watch="Editor.SelectedNames" is="TestMesh" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="sceneView.canvas" anchor="0.02,0.4" mods="ctrl"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.SelectedNames" is="TestMesh"/>
	<EditorClick mark="sceneView.canvas" anchor="0.02,0.4"/>
	<WaitUntil watch="Editor.SelectionCount" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorDrag mark="sceneView.canvas" anchor="0.02,0.4" dx="900" dy="330"/>
	<WaitUntil watch="Editor.SelectionCount" atLeast="3" timeoutFrames="60"/>
	<Expect watch="Editor.SelectedIsEditorCamera" equals="0"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.ScaleSnapStep" equals="0"/>
	<EditorClick mark="viewport.scaleSnap"/>
	<WaitUntil watch="Editor.ScaleSnapStep" atLeast="0.05" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="viewport.scaleSnap"/>
	<WaitUntil watch="Editor.ScaleSnapStep" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorDrag mark="sceneView.canvas" anchor="0.02,0.4" dx="900" dy="330" mods="ctrl"/>
	<WaitUntil watch="Editor.SelectionCount" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
