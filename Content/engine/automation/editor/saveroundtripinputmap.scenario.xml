<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Input Map Editor 저장 왕복: 엔진 기본 입력 맵(engine/input/default.input.xml)의 실행마다 새 사본(scratch/saveroundtripinputmap — <Scratch>)을 연다.
  입력 맵 편집기는 문서 기반(EditorDocumentPanel)이라 열면 데이터의 디버그 키 맵을 읽고, asset.openScratch 가 경로 칸 · 콘텐츠 브라우저와 같은 길(워크스페이스 포커스)로 사본으로 바꾼다.
  Confirm 액션을 고르면 바인딩이 둘이다(inputmapedit 와 같은 맵). 고치지 않고 저장 → 글 붙잡기 → 디스크에서 다시 읽기(고른 액션과 바인딩 수가 남는다) → 다시 저장 → 같은 바이트.
  녹화 파일(.swreplay)의 저장 · 읽기 왕복은 패널 상태 없는 형식이라 단위 테스트(InputReplayTest.SaveLoadSaveKeepsBytes)가 본다. 원본은 건드리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/saveroundtripinputmap.scenario.xml -unattended
-->
<Scenario name="editor.saveroundtripinputmap" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/input" as="scratch/saveroundtripinputmap"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus input_map"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/saveroundtripinputmap/default.input.xml"/>
	<EditorWaitStable/>
	<Wait frames="5"/>
	<EditorClick mark="inputMap.action.Confirm"/>
	<WaitUntil watch="Editor.InputMapBindingCount" equals="2" timeoutFrames="60"/>
	<EditorWaitStable/>
	<DevCommand line="panel.saveDocument input_map"/>
	<DevCommand line="asset.snapshotScratch scratch/saveroundtripinputmap/default.input.xml"/>
	<DevCommand line="panel.reloadDocument input_map"/>
	<EditorWaitStable/>
	<Expect watch="Editor.InputMapBindingCount" equals="2"/>
	<Expect watch="Editor.InputMapConflicts" equals="0"/>
	<DevCommand line="panel.saveDocument input_map"/>
	<DevCommand line="asset.expectScratchUnchanged scratch/saveroundtripinputmap/default.input.xml"/>
	<Expect watch="Editor.DirtyDocumentCount" equals="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
