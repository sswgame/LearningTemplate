<?xml version="1.0" encoding="utf-8"?>
<?asset guid="e21593da447abe404e63a82400463bba"?>
<!--
  에디터 시나리오 — 프로퍼티 칸 복사 · 붙여넣기(EditorUI R13). GameCamera 의 _priority 를 4 로 바꾸고 이름 칸 우클릭 행 메뉴의 Copy Value 로 복사한 뒤,
  TestGameCamera 를 골라 행 메뉴의 Paste Value 로 붙이면 4 가 되고 되돌리기 한 단계가 쌓인다. Undo 로 0 으로 돌아온 뒤 칸 위에서 Ctrl+V(입력 맵 Editor.Global 의 property.pasteValue — 그리드 창이 포커스일 때만)로
  붙여도 같다. 붙여넣기는 클립보드 글이 그 칸 타입으로 읽힐 때만 켜진다(단위 테스트 PropertyGridViewModelTest.PasteTextIsCheckedAgainstTheFieldType).
  실행: App -EnableEditor -scenario=engine/automation/editor/propertycopypaste.scenario.xml -unattended
-->
<Scenario name="editor.propertycopypaste" fixedDelta="0.0166667" timeoutFrames="800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<Variable name="gv_editorWatchProperty" value="CameraComponent._priority"/>
	<Store watch="Editor.UndoIndex" as="undoBefore"/>
	<!-- ① GameCamera 의 값을 4 로 바꾸고 행 메뉴로 복사한다 -->
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<WaitUntil watch="Editor.SelectedNames" is="GameCamera" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="4"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="4" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.label.CameraComponent._priority" button="1" state="Down"/>
	<AdvanceSimulation frames="3"/> <!-- 누름 · 뗌을 다른 프레임에 둔다(프레임 경계) -->
	<EditorClick mark="inspector.label.CameraComponent._priority" button="1" state="Up"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.menu.copyValue"/>
	<EditorWaitStable/>
	<!-- ② 다른 카메라에 행 메뉴로 붙인다 — 값 하나, 되돌리기 한 단계 -->
	<EditorClick mark="hierarchy.row.TestGameCamera"/>
	<WaitUntil watch="Editor.SelectedNames" is="TestGameCamera" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedProperty" equals="0"/>
	<Store watch="Editor.UndoIndex" as="undoCopied"/>
	<EditorClick mark="inspector.label.CameraComponent._priority" button="1" state="Down"/>
	<AdvanceSimulation frames="3"/> <!-- 누름 · 뗌을 다른 프레임에 둔다(프레임 경계) -->
	<EditorClick mark="inspector.label.CameraComponent._priority" button="1" state="Up"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.menu.pasteValue"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="4" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoCopied"/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.UndoIndex" sameAs="undoCopied"/>
	<!-- ③ 칸 위 Ctrl+V 도 같은 붙여넣기다(인스펙터에 포커스를 두고 칸 위에서) -->
	<EditorClick mark="inspector.label.CameraComponent._priority"/>
	<EditorWaitStable/>
	<EditorHover mark="inspector.property.CameraComponent._priority"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+V"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="4" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorHover release="true"/>
	<!-- 씬을 처음으로 돌린다 -->
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<DevCommand line="editor edit.undo"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<WaitUntil watch="Editor.SelectedNames" is="GameCamera" timeoutFrames="60"/>
	<WaitUntil watch="Editor.SelectedProperty" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
