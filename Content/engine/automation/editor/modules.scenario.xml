<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 모듈 창(P4): GF_ThemePark 의 체크를 끄면 미리보기가 키트와 그 에디터 확장(GF_EditorPlugin_ThemePark) 둘을 새로 꺼진다고 보인다. Cancel 로 매니페스트를 쓰지 않는다. 키트와 그 확장이 함께 실린 빌드에서만 돈다(requiresModule).
  실제 끄기 · 빌드 · 다시 시작은 소스 파일을 바꾸고 빌드가 길어 시나리오로 돌리지 않는다(EditorModuleOverridesTest 가 쓰기 · 미리보기를 본다).
  실행: App -EnableEditor -scenario=engine/automation/editor/modules.scenario.xml -unattended
-->
<Scenario name="editor.modules" requiresModule="GF_ThemePark,GF_EditorPlugin_ThemePark" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus modules"/>
	<EditorWaitStable/>
	<EditorClick mark="modules.search"/>
	<EditorWaitStable/>
	<!-- 칸이 글자를 받아 거르는지 본다 - 아래 줄은 거르지 않아도 보여 토글만으로는 글자를 잃어도 통과한다 -->
	<EditorText value="zzz"/>
	<EditorWaitStable/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="1"/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="ThemePark"/>
	<EditorWaitStable/>
	<Expect watch="Editor.NoSearchResultHintShown" equals="0"/>
	<EditorClick mark="modules.toggle.GF_ThemePark"/>
	<WaitUntil watch="Editor.ModulePreviewNewlyInactive" equals="2" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="modules.cancel"/>
	<WaitUntil watch="Editor.ModulePreviewNewlyInactive" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
