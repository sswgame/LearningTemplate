<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 재생 · 기즈모 · 뷰포트 툴바 아이콘(R5): 창을 960 px 로 줄여도 상단 툴바의 Play(toolbar.play)가 보이고 눌리며(Editor.PlayState 1),
  멈춘 뒤 오브젝트를 고르면 떠 있는 변환 막대의 기즈모 아이콘 단추(gizmo.rotate · gizmo.scale)가 보이고 눌린다(Editor.GizmoOperation).
  버튼이 잘려 숨겨지면 이름표가 없어 시나리오가 진다.
  실행: App -EnableEditor -scenario=engine/automation/editor/toolbaricons.scenario.xml -unattended
-->
<Scenario name="editor.toolbaricons" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="960" height="720"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="35"/>
	<EditorClick mark="toolbar.play"/>
	<Wait frames="60"/>
	<Expect watch="Editor.PlayState" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="toolbar.stop"/>
	<Wait frames="45"/>
	<Expect watch="Editor.PlayState" equals="0"/>
	<EditorClick mark="hierarchy.row.TestMesh"/>
	<Wait frames="20"/>
	<EditorClick mark="gizmo.rotate"/>
	<Wait frames="15"/>
	<Expect watch="Editor.GizmoOperation" equals="1"/>
	<Wait frames="5"/>
	<EditorClick mark="gizmo.scale"/>
	<Wait frames="15"/>
	<Expect watch="Editor.GizmoOperation" equals="2"/>
	<Wait frames="5"/>
	<EditorClick mark="gizmo.translate"/>
	<Wait frames="15"/>
	<Expect watch="Editor.GizmoOperation" equals="0"/>
	<CaptureEditorUI file="toolbar.png"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
