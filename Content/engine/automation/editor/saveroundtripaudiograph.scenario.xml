<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 오디오 그래프 패널(audiograph) 저장 왕복: 시험 그래프(audiograph/tone.audiograph.xml — 노드 위치 없음)의 실행마다 새 사본(scratch/saveroundtripaudiograph — <Scratch>)을 연다.
  소리 종류는 썸네일 동작만 있어 예전에는 asset.openScratch(EditorAssetCommands::openPath)가 "열 곳 없음" 으로 졌다 — 이제 동작이 열지 않으면 포커스 길로 간다.
  고치지 않고 저장(첫 저장이 처음 배치한 노드 위치를 적는다) → 글 붙잡기 → 디스크에서 다시 읽기(위치가 있어 다시 놓지 않는다) → 다시 저장 → 같은 바이트.
  저장은 검사를 통과할 때만 쓴다(AudioGraphDef::saveToAsset) — 지면 panel.saveDocument 가 진다. 원본은 건드리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/saveroundtripaudiograph.scenario.xml -unattended
-->
<Scenario name="editor.saveroundtripaudiograph" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/audiograph" as="scratch/saveroundtripaudiograph"/>
	<Variable name="gv_editorWatchPanel" value="audiograph"/>
	<EditorWaitStable/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus audiograph"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutSeconds="10"/>
	<DevCommand line="asset.openScratch scratch/saveroundtripaudiograph/tone.audiograph.xml"/>
	<EditorWaitStable/>
	<Wait frames="5"/>
	<DevCommand line="panel.saveDocument audiograph"/>
	<DevCommand line="asset.snapshotScratch scratch/saveroundtripaudiograph/tone.audiograph.xml"/>
	<DevCommand line="panel.reloadDocument audiograph"/>
	<EditorWaitStable/>
	<DevCommand line="panel.saveDocument audiograph"/>
	<DevCommand line="asset.expectScratchUnchanged scratch/saveroundtripaudiograph/tone.audiograph.xml"/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<EditorWaitStable/>
	<Pass/>
</Scenario>
