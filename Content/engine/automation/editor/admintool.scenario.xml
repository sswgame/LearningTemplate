<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — GM 도구 확장(GF_EditorPlugIn_Admin): 서버 없이 메모리 제공자로 조회 · 지급 · 회수 · 제재 · 감사 열람이 돈다.
  팔레트로 커맨드(admin.openToolPanel)를 실행해 GM Tool 패널을 열고, 계정을 조회한다. 메모 없는 지급은 거절되고(InvalidRequest), 메모를 적으면 들어가며 잔액을 다시 조회한다.
  잔액보다 큰 회수는 거절되고(InsufficientFunds), 제재와 감사 열람은 성공한다. 명령 결과는 패널이 남기는 로그 줄 "Admin command <명령>: <결과>" 로 센다.
  실행: App -EnableEditor -scenario=engine/automation/editor/admintool.scenario.xml -unattended
-->
<Scenario name="editor.admintool" requiresModule="GF_EditorPlugin_Admin" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<Variable name="gv_editorWatchPanel" value="admin.tool"/>
	<Wait frames="5"/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<Wait frames="15"/>
	<EditorKey key="Ctrl+Shift+P"/>
	<Wait frames="15"/>
	<EditorText value="Open the GM"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="60"/>
	<ExpectLog contains="GM Tool panel opened" count="1"/>
	<Wait frames="5"/>
	<DevCommand line="panel.focus admin.tool"/>
	<Wait frames="20"/>
	<EditorClick mark="admin.lookup"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command LookupAccount: Ok" count="1"/>
	<!-- 메모 없는 지급은 거절된다 -->
	<EditorClick mark="admin.grant"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command AdjustAsset: InvalidRequest" count="1"/>
	<!-- 메모를 적으면 들어가고, 성공한 뒤 같은 계정을 다시 조회한다 -->
	<Wait frames="5"/>
	<EditorClick mark="admin.memo"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="ticket-42"/>
	<Wait frames="15"/>
	<EditorClick mark="admin.grant"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command AdjustAsset: Ok" count="1"/>
	<ExpectLog contains="Admin command LookupAccount: Ok" count="2"/>
	<!-- 잔액(200)보다 큰 회수는 거절된다 -->
	<Wait frames="5"/>
	<EditorClick mark="admin.amount"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="1000"/>
	<Wait frames="15"/>
	<EditorClick mark="admin.revoke"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command AdjustAsset: InsufficientFunds" count="1"/>
	<EditorClick mark="admin.sanction.apply"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command SetSanction: Ok" count="1"/>
	<EditorClick mark="admin.audit.list"/>
	<Wait frames="15"/>
	<ExpectLog contains="Admin command ListAudit: Ok" count="1"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
