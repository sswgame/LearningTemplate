<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 프리팹 창(PrefabEditorPanel): 콘텐츠 브라우저에서 프리팹을 더블클릭하면 새 프리팹 창("Prefab Window", 패널 id prefab_window)이 뜨고,
  미저장 편집이 있을 때 제목 표시줄 X 로 닫으면 Save / Don't Save / Cancel 확인이 뜬다.
  ① 프리팹을 더블클릭해 연다(창이 닫혀 있다가 열린다). 편집이 없으니 아직 깨끗하다. ② 자식 행을 골라 인스펙터에서 경계 반경을 고치면 문서가 더러워진다.
  ③ X 를 누르면 창이 닫히지 않고 확인이 뜬다. Cancel 은 열어 둔다. ④ 다시 X 후 Don't Save 는 편집을 버리고 닫는다.
  ⑤ 다시 열면 디스크의 프리팹이라 깨끗하고, 이때의 X 는 묻지 않고 닫는다.
  X 단추 이름표(panel.close.<제목>)는 창이 떠 있든 도킹됐든 보이는 창에 있다.
  실행: App -EnableEditor -scenario=engine/automation/editor/prefabwindow.scenario.xml -unattended
-->
<Scenario name="editor.prefabwindow" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchPanel" value="prefab_window"/>
	<!-- 열린 채 시작하는 오버라이드 도구(prefab_editor)는 이 시나리오가 보지 않는다 — 닫아 프리팹 창이 가려지지 않게 한다 -->
	<EditorWaitStable/>
	<DevCommand line="panel.close prefab_editor"/>
	<!-- ① 콘텐츠 브라우저에서 더블클릭 -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitStable/>
	<DevCommand line="content.open game/empty/prefabs"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<EditorClick mark="contentBrowser.asset.testprop.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.asset.testprop.prefab.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<CaptureEditorUI file="prefabwindow/open.png"/>
	<!-- ② 편집 -->
	<EditorClick mark="prefabwindow.child.TestProp"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.property.SpriteComponent._boundsRadius" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="2"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.PanelDirty" equals="1" timeoutFrames="60"/>
	<CaptureEditorUI file="prefabwindow/edited.png"/>
	<!-- ③ X → 확인 → Cancel -->
	<EditorClick mark="panel.close.Prefab Window"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<CaptureEditorUI file="prefabwindow/confirm.png"/>
	<EditorWaitStable/>
	<EditorClick mark="unsaved.cancel"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Expect watch="Editor.PanelDirty" equals="1"/>
	<!-- ④ X → Don't Save -->
	<EditorWaitStable/>
	<EditorClick mark="panel.close.Prefab Window"/>
	<EditorWaitStable/>
	<EditorClick mark="unsaved.discard"/>
	<WaitUntil watch="Editor.PanelOpen" equals="0" timeoutFrames="60"/>
	<!-- ⑤ 다시 열면 깨끗하고 X 가 묻지 않는다 -->
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.asset.testprop.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.asset.testprop.prefab.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<CaptureEditorUI file="prefabwindow/reopened.png"/>
	<EditorWaitStable/>
	<EditorClick mark="panel.close.Prefab Window"/>
	<WaitUntil watch="Editor.PanelOpen" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
