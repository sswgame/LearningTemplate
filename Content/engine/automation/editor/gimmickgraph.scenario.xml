<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 기믹 회로 그래프 편집 창(GF_EditorPlugIn_Base): 기믹 쇼케이스 씬을 열고 회로가 있는 오브젝트들을 고르면 Gimmick Graph 창이 그 회로를 노드 그래프로 그린다(감시 값 Editor.GraphNodeCount).
  도구 모음으로 Signal · Not 노드를 더하고, 옆 패널의 폼으로 signal_1.Active -> not_1.In 배선을 이으면 편집마다 Undo 에 한 줄씩 오른다(Editor.UndoCount).
  편집은 컴포넌트에 쓰이고 회로가 다시 지어지므로 로그 줄 "Gimmick graph <편집 이름>" 로 센다. 씬은 저장하지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/gimmickgraph.scenario.xml -unattended
-->
<Scenario name="editor.gimmickgraph" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<DevCommand line="scene.open game/empty/maps/gimmickshowcase.scene.xml"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.ObjectCount" atLeast="5" timeoutFrames="600"/>
	<Wait frames="20"/>
	<DevCommand line="select.type GimmickCircuitComponent"/>
	<Wait frames="10"/>
	<DevCommand line="panel.focus gimmick_graph"/>
	<WaitUntil watch="Editor.GraphNodeCount" atLeast="1" timeoutFrames="120"/>
	<!-- 노드 둘 -->
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.addnode"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.kind.Signal"/>
	<Wait frames="20"/>
	<ExpectLog id="GimmickGraph.Edited" contains="Add Gimmick Node" count="1"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.addnode"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.kind.Not"/>
	<Wait frames="20"/>
	<ExpectLog id="GimmickGraph.Edited" contains="Add Gimmick Node" count="2"/>
	<!-- 배선: 폼의 From · To 를 고르고 Connect -->
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.wire.from"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.wire.from.signal_1.Active"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.wire.to"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.wire.to.not_1.In"/>
	<EditorWaitSettled/>
	<EditorClick mark="gimmick.wire.connect"/>
	<Wait frames="20"/>
	<ExpectLog id="GimmickGraph.Edited" contains="Add Gimmick Wire" count="1"/>
	<Expect watch="Editor.UndoCount" atLeast="3"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
