<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 흐름 시나리오 — 에셋 배치부터 다시 읽기까지 한 줄로: 콘텐츠 브라우저의 메시를 씬 뷰로 끌어 놓고(배치) → 메시 모디파이어로 휘기를 걸고 →
  인스펙터로 이름을 바꾸고 → 다른 이름으로 저장 → 플레이 인 → 플레이 아웃(씬 내용 · 되돌리기 스택 · 모디파이어 미리보기가 그대로) →
  되돌리기 · 다시 실행 → 새 씬 → 저장한 씬 다시 열기(씬 내용 해시가 저장할 때와 같다).
  모디파이어 스택은 메시 옆 사이드카에 저장되므로(리소스 트리) 이 시나리오는 스택을 저장하지 않는다 — 미리보기 메시만 쓴다.
  실행: App -EnableEditor -scenario=engine/automation/editor/flowedit.scenario.xml -unattended
-->
<Scenario name="editor.flowedit" fixedDelta="0.0166667" timeoutFrames="2000" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.resetOptional"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.UndoCount" equals="0" timeoutFrames="600"/>
	<!-- ① 배치 — 콘텐츠 브라우저에서 메시를 찾아 씬 뷰로 끌어 놓는다 -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitStable/>
	<DevCommand line="content.open game/empty/models"/>
	<EditorWaitStable/>
	<EditorClick mark="contentBrowser.search"/>
	<EditorWaitStable/>
	<EditorText value="crate_medium.mesh"/>
	<EditorWaitStable/>
	<EditorDrag mark="contentBrowser.asset.crate_medium.mesh" toMark="sceneView.canvas"/>
	<WaitUntil watch="Editor.UndoCount" equals="1" timeoutFrames="90"/>
	<Expect watch="Editor.SelectionCount" equals="1"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<!-- ② 메시 모디파이어 — 고른 것을 대상으로 휘기 -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus meshmodifiers.stack"/>
	<EditorWaitStable/>
	<EditorClick mark="meshmodifiers.useSelection"/>
	<EditorWaitStable/>
	<EditorClick mark="meshmodifiers.add"/>
	<EditorWaitStable/>
	<EditorClick mark="meshmodifiers.category.Deform"/>
	<EditorWaitStable/>
	<EditorClick mark="meshmodifiers.item.bend"/>
	<EditorWaitStable/>
	<EditorClick mark="meshmodifiers.param.Angle" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorText value="80"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<Expect watch="MeshModifiers.ModifierCount" equals="1"/>
	<Expect watch="MeshModifiers.GPUPreviewActive" equals="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.close meshmodifiers.stack"/>
	<!-- ③ 인스펙터로 이름 -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus inspector"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.name"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="PlacedCrate"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorExpectObject name="PlacedCrate" component="MeshComponent" selected="1"/>
	<Expect watch="Editor.SelectedNames" is="PlacedCrate"/>
	<!-- ④ 저장 -->
	<EditorWaitStable/>
	<DevCommand line="scene.saveAs {out}/flowedit.scene.xml"/>
	<WaitUntil watch="Editor.SceneDirty" equals="0" timeoutFrames="60"/>
	<Store watch="Editor.SceneHash" as="saved"/>
	<Store watch="Editor.UndoState" as="savedUndo"/>
	<Store watch="Editor.StateHash" as="savedState"/>
	<!-- ⑤ 플레이 인 → 플레이 아웃 -->
	<EditorWaitStable/>
	<DevCommand line="play"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="600"/>
	<EditorWaitStable/>
	<DevCommand line="stop"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneHash" sameAs="saved"/>
	<Expect watch="Editor.UndoState" sameAs="savedUndo"/>
	<Expect watch="Editor.SelectedNames" is="PlacedCrate"/>
	<Expect watch="Editor.StateHash" sameAs="savedState"/>
	<Expect watch="MeshModifiers.GPUPreviewActive" equals="1"/>
	<!-- ⑥ 되돌리기 · 다시 실행 -->
	<EditorWaitStable/>
	<DevCommand line="editor edit.undo"/>
	<EditorWaitStable/>
	<EditorExpectObject name="PlacedCrate" count="0"/>
	<Expect watch="Editor.SceneHash" differsFrom="saved"/>
	<Expect watch="Editor.SceneDirty" equals="1"/>
	<EditorWaitStable/>
	<DevCommand line="editor edit.redo"/>
	<WaitUntil watch="Editor.SceneHash" sameAs="saved" timeoutFrames="60"/>
	<EditorExpectObject name="PlacedCrate" selected="1"/>
	<!-- ⑦ 다른 씬 → 저장한 씬 다시 열기(되돌리기 · 다시 실행으로 변경 표시가 켜져 있어 scene.new 는 확인 상자를 띄운다 — 확인 없이 여는 scene.open 을 쓴다) -->
	<EditorWaitStable/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<EditorExpectObject name="PlacedCrate" count="0"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open {out}/flowedit.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitStable/>
	<EditorExpectObject name="PlacedCrate" component="MeshComponent"/>
	<Expect watch="Editor.SceneHash" sameAs="saved"/>
	<Expect watch="Editor.SceneDirty" equals="0"/>
	<Expect watch="Editor.UndoCount" equals="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
