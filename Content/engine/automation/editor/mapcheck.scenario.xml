<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 맵 검사(T2): **일부러 오류를 심은** 테스트 씬(반경 0 인 점광, engine/automation/editor/mapcheck/mapcheck_expect_error.scene.xml)을 열면 로드 검증이 오류 하나를 남긴다.
  상태줄의 경고 수(statusBar.mapCheck)를 누르면 Map Check 창이 열리고, 첫 줄(mapCheck.row.0 — 오류가 먼저다)을 누르면 그 점광 오브젝트가 골라진다.
  실행: App -EnableEditor -scenario=engine/automation/editor/mapcheck.scenario.xml -unattended
-->
<Scenario name="editor.mapcheck" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_editorWatchPanel" value="map_check"/>
	<Wait frames="10"/>
	<DevCommand line="scene.open engine/automation/editor/mapcheck/mapcheck_expect_error.scene.xml"/>
	<Wait frames="120"/>
	<EditorExpectObject name="ZeroRadiusLight"/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<ExpectLog id="ObjectValidation.Issue" atLeast="1"/>
	<!-- 단추는 누름과 뗌을 다른 프레임에 나눠야 눌린다 -->
	<Wait frames="5"/>
	<EditorClick mark="statusBar.mapCheck" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="statusBar.mapCheck" state="up"/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="66"/>
	<Wait frames="5"/>
	<EditorClick mark="mapCheck.row.0" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="mapCheck.row.0" state="up"/>
	<WaitUntil watch="Editor.SelectionCount" equals="1" timeoutFrames="60"/>
	<EditorExpectObject name="ZeroRadiusLight" selected="1"/>
	<CaptureEditorUI file="mapcheck.png"/>
	<!-- 오류를 심은 씬을 열어 둔 채 끝내면 상태줄의 검사 수와 토스트가 다음 시나리오까지 남는다 — 깨끗한 씬으로 돌아가고 끝낸다 -->
	<Wait frames="10"/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<Wait frames="25"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
