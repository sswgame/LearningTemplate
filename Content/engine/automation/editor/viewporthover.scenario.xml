<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 씬 뷰 호버 강조: 커서를 큐브(TestMesh) 위에 두면 호버 오브젝트가 그것이고(Editor.HoveredObject 1), 빈 곳이면 없다(0).
  큐브를 고르면 그 위(기즈모 손잡이 포함)는 호버가 아니다(고른 오브젝트는 선택 상자 · 기즈모가 이미 있다). 오른쪽 단추를 누른 채(비행)도 꺼진다. 고른 오브젝트에는 호버 상자를 그리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/viewporthover.scenario.xml -unattended
-->
<Scenario name="editor.viewporthover" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchObject" value="TestMesh"/>
	<EditorHover mark="sceneView.canvas" anchor="0.5,0.68"/>
	<WaitUntil watch="Editor.HoveredObject" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorHover mark="sceneView.canvas" anchor="0.05,0.95"/>
	<WaitUntil watch="Editor.HoveredObject" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorHover release="true"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestMesh"/>
	<EditorWaitStable/>
	<EditorHover mark="sceneView.canvas" anchor="0.551,0.756"/>
	<EditorWaitStable/>
	<Expect watch="Editor.HoveredObject" equals="0"/>
	<EditorWaitStable/>
	<EditorHover release="true"/>
	<EditorWaitStable/>
	<EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.68" state="Down"/>
	<Wait frames="15"/>
	<Expect watch="Editor.HoveredObject" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="sceneView.canvas" button="1" anchor="0.5,0.68" state="Up"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
