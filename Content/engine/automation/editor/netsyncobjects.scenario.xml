<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 어긋난 오브젝트 짚기(서버 디버깅 S7). 전용 서버 + App 클라이언트 1 을 띄우고, Multiplayer 창 Sync 탭의 "Which objects differ" 와 같은 비교를 한다.
  netplay.sync objects server 는 서버 칸(두 칸이 모두 채널에서 읽은 세션 서버의 state.objects)을, netplay.sync objects client 는 클라이언트 칸(A 는 서버 채널,
  B 는 첫 클라이언트의 표준 입력 답 state.objectline)을 비교한다. 두 쪽의 틱이 같아야 하므로 서버를 pause 하고 클라이언트가 마지막 틱을 받을 때까지 프레임을 둔다.
  같은 서버를 두 번 읽은 서버 칸은 다른 오브젝트가 없어야 한다. 클라이언트 칸은 클라이언트만 가진 오브젝트가 있을 수 있어 비교가 끝까지 갔는지(목록이 떴는지)만 본다.
  실행: App -EnableEditor -scenario=engine/automation/editor/netsyncobjects.scenario.xml -unattended
-->
<Scenario name="editor.netsyncobjects" fixedDelta="0.0166667" timeoutFrames="2100" startAfter="Immediately" input="exclusive">
	<AllowLog id="Server.ServerBehindDroppedTicks" reason="전용 서버는 백엔드 넷 · 클라이언트와 함께 같은 기계에서 돌아 부하가 걸린 틱이 늦을 수 있다 — 중계가 자식 경고를 경고 그대로 옮기므로(예전에는 Info 로 숨겼다) 나와도 된다고 적는다"/>
	<WaitUntil watch="Editor.NetPlaySyncObjectsCompared" equals="0" timeoutFrames="60"/>
	<DevCommand line="netplay.start dedicated 1"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.wait 1 120"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.command server pause"/>
	<EditorWaitStable/>
	<DevCommand line="netplay.sync objects server"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="netplay sync objects tick" atLeast="1"/>
	<Expect watch="Editor.NetPlaySyncObjectsCompared" equals="1"/>
	<Expect watch="Editor.NetPlaySyncDifferingObjects" equals="0"/>
	<!-- 클라이언트 답은 다른 프로세스에서 비동기로 온다. 첫 부름은 서버 틱의 답을 묻고(세션이 그보다 이른 답 — 멈춘 서버를 아직 따라오는 중 — 은 거르고 다시 묻는다),
	     받은 답 수가 바뀔 때까지 벽시계로 기다린 뒤 다시 불러 비교한다. 예전에는 첫 답을 그대로 받아 부하 걸린 기계에서 틱이 57 대 61 로 달라 비교가 거절됐다 -->
	<Store watch="Editor.NetPlayObjectHashReports" as="objectReports"/>
	<DevCommand line="netplay.sync objects client"/>
	<ExpectLog id="DevCommand.Reply" contains="for its object hashes at tick" atLeast="1"/>
	<WaitUntil watch="Editor.NetPlayObjectHashReports" differsFrom="objectReports" timeoutWallSeconds="20"/>
	<DevCommand line="netplay.sync objects client"/>
	<EditorWaitStable/>
	<ExpectLog id="DevCommand.Reply" contains="differing object(s)" atLeast="2"/>
	<Expect watch="Editor.NetPlaySyncObjectsCompared" equals="1"/>
	<DevCommand line="netplay.stop"/>
	<WaitUntil watch="Editor.NetPlayStopping" equals="0" timeoutWallSeconds="20"/>
	<Expect watch="Editor.NetPlayProcessCount" equals="0"/>
	<Pass/>
</Scenario>
