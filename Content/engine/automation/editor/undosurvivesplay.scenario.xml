<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Play 전의 편집 내역이 Stop 뒤에도 남아 되돌릴 수 있다(panel-audit D4). 저장 안 된 씬이라 Play 를 누르면 확인 상자가 뜬다.
  실행: App -EnableEditor -scenario=engine/automation/editor/undosurvivesplay.scenario.xml -unattended
-->
<Scenario name="editor.undosurvivesplay" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<Wait frames="30"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="30"/>
	<DevCommand line="editor scene.new"/>
	<EditorClick mark="hierarchy.create"/>
	<WaitUntil watch="Editor.UndoCount" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="toolbar.play"/>
	<EditorClick mark="toolbar.playAnyway"/>
	<WaitUntil watch="Editor.PlayState" equals="1" timeoutFrames="90"/>
	<Wait frames="5"/>
	<EditorClick mark="toolbar.stop"/>
	<WaitUntil watch="Editor.PlayState" equals="0" timeoutFrames="75"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Expect watch="Editor.UndoIndex" equals="1"/>
	<EditorExpectObject name="GameObject"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.UndoIndex" equals="0" timeoutFrames="60"/>
	<EditorExpectObject name="GameObject" count="0"/>
	<Pass/>
</Scenario>
