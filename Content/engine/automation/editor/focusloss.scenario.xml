<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 무인 실행 중 창이 포커스를 잃어도(다른 프로세스의 창이 전경을 가져가는 것과 같은 WM_KILLFOCUS) 누르고 있는 자동화 입력이 끊기지 않는다.
  오른쪽 단추 + D 로 날리는 도중에 포커스를 잃었다가 얻어도 카메라가 끝까지 3 m 넘게 간다(배타 시나리오는 사람의 장치 입력과 같이 포커스 사건도 ImGui 에 넣지 않는다 —
  넣으면 ImGui 가 눌린 단추 · 키를 모두 놓은 것으로 처리해 비행이 1.5 m 에서 멈췄다. GL 체인에서 `bugreport` · `viewportgrid` 가 간헐적으로 졌던 원인).
  실행: App -EnableEditor -scenario=engine/automation/editor/focusloss.scenario.xml -unattended
-->
<Scenario name="editor.focusloss" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="5"/>
	<ResizeWindow width="1600" height="900"/>
	<Wait frames="50"/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<!-- 오른쪽 단추 + D 로 날아가는 한가운데서 포커스를 잃었다가 얻는다 -->
	<Wait frames="10"/>
	<EditorClick mark="sceneView.canvas" button="1" state="down"/>
	<EditorKey key="D" state="down"/>
	<Wait frames="20"/>
	<PostWindowMessage message="WM_KILLFOCUS"/>
	<Wait frames="2"/>
	<PostWindowMessage message="WM_SETFOCUS"/>
	<Wait frames="20"/>
	<EditorKey key="D" state="up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="up"/>
	<Wait frames="8"/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<Wait frames="10"/>
	<Pass/>
</Scenario>
