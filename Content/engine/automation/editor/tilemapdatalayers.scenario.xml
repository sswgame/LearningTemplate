<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 타일맵 데이터 레이어(TilemapCellDataLayers T3): 새 맵에 데이터 레이어 "Cost"(기본값 0)를 더하고, 값 7 로 칸 하나를 칠한 뒤 임시 경로에 저장한다.
  저장 뒤 같은 칸을 지워(Erase) 메모리에서 0 칸으로 만들고 Load 로 파일을 다시 읽으면 레이어(1)와 칠한 칸(1)이 돌아와 있어야 한다 — 저장 왕복.
  감시 값: Editor.TileMapDataLayers(레이어 수) · Editor.TileMapDataCells(모든 데이터 레이어에서 기본값과 다른 칸 수).
  문서: {out}/temp.tilemap.xml — 에디터 저장은 없는 폴더를 만들지 않아(이 시나리오는 캡처가 없어 폴더도 없다) 처음에 asset.makeTempFolder 로 만들고, 끝에서 asset.removeTemp 로 지운다.
  실행: App -EnableEditor -scenario=engine/automation/editor/tilemapdatalayers.scenario.xml -unattended
-->
<Scenario name="editor.tilemapdatalayers" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<DevCommand line="asset.makeTempFolder {out}/editor.tilemapdatalayers"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus tile_map"/>
	<EditorWaitStable/>
	<Expect watch="Editor.TileMapDataLayers" equals="0"/>
	<Expect watch="Editor.TileMapDataCells" equals="0"/>
	<!-- 레이어 더하기 -->
	<EditorWaitStable/>
	<EditorClick mark="tileMap.dataLayer.name"/>
	<EditorWaitStable/>
	<EditorText value="Cost"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.dataLayer.add"/>
	<WaitUntil watch="Editor.TileMapDataLayers" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.TileMapDataCells" equals="0"/>
	<!-- 값 7 로 왼쪽 위 칸 하나 칠하기 -->
	<EditorWaitStable/>
	<EditorClick mark="tileMap.dataLayer.value"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="7"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.tool.brush"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/>
	<WaitUntil watch="Editor.TileMapDataCells" equals="1" timeoutFrames="60"/>
	<!-- 저장 -->
	<EditorWaitStable/>
	<EditorClick mark="tileMap.path"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="{out}/temp.tilemap.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.save"/>
	<!-- 메모리에서만 지우기 → 다시 읽기 -->
	<EditorWaitStable/>
	<EditorClick mark="tileMap.erase"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.canvas" anchor="0.02,0.02"/>
	<WaitUntil watch="Editor.TileMapDataCells" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.erase"/>
	<EditorWaitStable/>
	<EditorClick mark="tileMap.load"/>
	<EditorWaitStable/>
	<Expect watch="Editor.TileMapDataLayers" equals="1"/>
	<Expect watch="Editor.TileMapDataCells" equals="1"/>
	<EditorWaitStable/>
	<DevCommand line="asset.removeTemp {out}/temp.tilemap.xml"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
