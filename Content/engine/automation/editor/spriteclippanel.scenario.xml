<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 스프라이트 클립 창(sprite_clip): 임시 에셋을 새 문서로 열고(asset.open) Add Frame 두 번 · Add Animation 한 번으로 고친 뒤 Save 로 저장한다.
  저장하면 파일이 생기고(Editor.TempAssetExists) 더러움이 걷힌다. Remove Frame 으로 하나 지운 뒤 Load 로 다시 읽으면 저장한 두 프레임 · 한 구간이 돌아온다(저장한 글이 맞다).
  문서: {out}/temp.sprite.xml — 작업 폴더 아래 임시 경로라 저장소 리소스를 바꾸지 않는다. 끝에서 asset.removeTemp 로 지운다.
  감시 값: Editor.SpriteClipFrameCount · Editor.SpriteClipAnimationCount(문서의 프레임 · 구간 수) · Editor.DirtyDocumentCount · Editor.TempAssetExists.
  실행: App -EnableEditor -scenario=engine/automation/editor/spriteclippanel.scenario.xml -unattended
-->
<Scenario name="editor.spriteclippanel" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitSettled/>
	<DevCommand line="asset.open {out}/temp.sprite.xml"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus sprite_clip"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="0" timeoutFrames="120"/>
	<Expect watch="Editor.SpriteClipAnimationCount" equals="0"/>
	<Expect watch="Editor.DirtyDocumentCount" equals="0"/>
	<Expect watch="Editor.TempAssetExists" equals="0"/>
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.addFrame"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.DirtyDocumentCount" equals="1"/>
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.addFrame"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="2" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.addAnimation"/>
	<WaitUntil watch="Editor.SpriteClipAnimationCount" equals="1" timeoutFrames="60"/>
	<!-- 저장 — 파일이 생기고 더러움이 걷힌다 -->
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.save"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="60"/>
	<Expect watch="Editor.TempAssetExists" equals="1"/>
	<!-- 프레임 하나를 골라 지운 뒤 다시 읽으면 저장한 문서로 돌아온다 -->
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.frame.1"/>
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.removeFrame"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Editor.DirtyDocumentCount" equals="1"/>
	<EditorWaitSettled/>
	<EditorClick mark="spriteClip.load"/>
	<WaitUntil watch="Editor.SpriteClipFrameCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.SpriteClipAnimationCount" equals="1"/>
	<EditorWaitSettled/>
	<DevCommand line="asset.removeTemp {out}/temp.sprite.xml"/>
	<WaitUntil watch="Editor.TempAssetExists" equals="0" timeoutFrames="60"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
