<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 문서 패널이 아닌 패널(Input Map Editor, IEditorPanel 직접 상속)의 닫기 확인. 닫는 길이 하나(IEditorPanel::requestClose)라서
  패널 메뉴 토글(= panel.close, 같은 setOpen(false))도 X 도 편집이 남았으면 닫지 않고 Save / Don't Save / Cancel 을 묻는다.
  ① 바인딩의 발화 규칙을 고쳐 문서를 더럽힌다. ② 메뉴 토글 경로(panel.close)는 닫지 않고 확인을 띄운다. Cancel 은 열어 두고 편집도 남는다.
  ③ X 도 같은 확인을 띄운다. Don't Save 는 파일을 다시 읽어 편집을 버리고 닫는다. ④ 다시 열면 깨끗하고, 깨끗한 패널은 panel.close 로 바로 닫힌다.
  실행: App -EnableEditor -scenario=engine/automation/editor/panelclose.scenario.xml -unattended
-->
<Scenario name="editor.panelclose" fixedDelta="0.0166667" timeoutFrames="800" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchPanel" value="input_map"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus input_map"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<!-- ① 편집 -->
	<EditorClick mark="inputMap.filter"/>
	<EditorWaitStable/>
	<EditorText value="Confirm"/>
	<EditorWaitStable/>
	<EditorClick mark="inputMap.action.Confirm"/>
	<EditorWaitStable/>
	<EditorClick mark="inputMap.binding.0.trigger"/>
	<EditorWaitStable/>
	<EditorClick mark="inputMap.trigger.4"/>
	<WaitUntil watch="Editor.InputMapSelectedTrigger" equals="4" timeoutFrames="60"/>
	<Expect watch="Editor.PanelDirty" equals="1"/>
	<CaptureEditorUI file="panelclose/edited.png"/>
	<!-- ② 메뉴 토글 경로 → 확인 → Cancel -->
	<EditorWaitStable/>
	<DevCommand line="panel.close input_map"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<CaptureEditorUI file="panelclose/confirm.png"/>
	<EditorWaitStable/>
	<EditorClick mark="unsaved.cancel"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Expect watch="Editor.PanelDirty" equals="1"/>
	<Expect watch="Editor.InputMapSelectedTrigger" equals="4"/>
	<!-- ③ 창을 줄인 뒤 X → 확인 → Don't Save. 확인은 창 크기가 바뀌어도 그때의 가운데에 뜬다(처음 위치를 붙들고 있지 않는다). -->
	<EditorWaitStable/>
	<ResizeWindow width="1600" height="900"/>
	<EditorWaitStable/>
	<EditorClick mark="panel.close.Input Map Editor"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<CaptureEditorUI file="panelclose/confirmX.png"/>
	<EditorWaitStable/>
	<EditorClick mark="unsaved.discard"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="0" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<!-- ④ 다시 열면 깨끗하다 -->
	<EditorWaitStable/>
	<DevCommand line="panel.focus input_map"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="1" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Expect watch="Editor.PanelDirty" equals="0"/>
	<CaptureEditorUI file="panelclose/reopened.png"/>
	<EditorWaitStable/>
	<DevCommand line="panel.close input_map"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.PanelOpen" equals="0" timeoutFrames="300"/>
	<EditorWaitStable/>
	<Expect watch="Editor.PanelOpen" equals="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
