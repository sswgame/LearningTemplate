<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 페어드 애니메이션 창(GF_EditorPlugin_CharacterEditor 확장): 창을 열고 Quick Open 으로 Empty 게임의 환호 짝(cheer_pair.pairedanim.xml, 역할 둘)을 고르면
  창이 파일을 읽어 두 역할을 한 시계로 미리보기 씬에 세우고, 렌더러가 그 씬을 그린다. 편집 없이 연 파일은 저장할 것이 없다(창을 닫아도 확인을 묻지 않는다).
  감시 값: Editor.PairedAnimationRoleCount(파일을 읽었다) → Editor.PairedAnimationSceneFrames(그렸다).
  실행: App -EnableEditor -scenario=engine/automation/editor/pairedanimation.scenario.xml -unattended
-->
<Scenario name="editor.pairedanimation" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="Immediately" input="exclusive" requiresModule="GF_EditorPlugin_CharacterEditor">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus charactereditor.pairedanimation"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="cheer_pair.pairedanim.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.PairedAnimationRoleCount" equals="2" timeoutFrames="600"/>
	<WaitUntil watch="Editor.PairedAnimationSceneFrames" atLeast="60" timeoutFrames="600"/>
	<DevCommand line="panel.close charactereditor.pairedanimation"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
