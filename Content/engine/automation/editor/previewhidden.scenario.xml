<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 숨은 미리보기 창은 씬을 틱하지 않는다(감사 SB E5)와, 자동화 실행은 포커스와 상관없이 전속이다(P1).
  미리보기 씬의 틱 여부는 "이번 프레임에 그려지는가"(호스트의 미리보기 뷰 요청, ScenePreviewTick::WhenDrawn)다. 창을 다른 탭 뒤로 가리면 뷰 요청이 사라지고 씬은 남는다(닫으면 씬까지 놓으므로 — 감사 E-14 — 닫기로는 이 판정을 볼 수 없다).
  감시 값 Editor.PreviewTickCount 는 씬 매니저가 미리보기 씬들을 틱한 횟수의 합이다 — 가려 둔 동안 그대로(sameAs)이고 다시 앞에 두면 오른다(differsFrom).
  Engine.FramePacingState 는 앱 루프의 페이싱 상태 번호다 — 시나리오 실행은 3(Automation)이라 창이 포커스를 잃어도 배경 상한 · 최소화 대기에 걸리지 않는다.
  실행: App -EnableEditor -scenario=engine/automation/editor/previewhidden.scenario.xml -unattended
-->
<Scenario name="editor.previewhidden" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<EditorWaitSettled/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchPanel" value="material"/>
	<EditorWaitSettled/>
	<Expect watch="Engine.FramePacingState" equals="3"/>
	<!-- 머티리얼 창을 열어 미리보기가 그려지고 틱하게 한다 -->
	<EditorWaitSettled/>
	<Variable name="gv_editorWatchAsset" value="engine/automation/editor/materialpreview/previewred.material"/>
	<EditorWaitSettled/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitSettled/>
	<EditorText value="previewred.material"/>
	<EditorWaitSettled/>
	<EditorKey key="Enter"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.focus material"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.MaterialPreviewSceneFrames" atLeast="40" timeoutFrames="600"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewTickCount" atLeast="1" timeoutFrames="60"/>
	<!-- 같은 도킹 노드의 씬 뷰 탭을 앞에 두어 가린 동안 틱 수가 그대로다 — 창은 열려 있고(씬이 남는다) 그리지 않는다(프레임 수 그대로) -->
	<EditorWaitSettled/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.PanelOpen" equals="1"/>
	<Store watch="Editor.PreviewTickCount" as="hiddenTicks"/>
	<Store watch="Editor.MaterialPreviewSceneFrames" as="hiddenFrames"/>
	<EditorWaitSettled/>
	<Expect watch="Editor.PreviewTickCount" sameAs="hiddenTicks"/>
	<Expect watch="Editor.MaterialPreviewSceneFrames" sameAs="hiddenFrames"/>
	<!-- 다시 앞에 두면 다시 틱한다 -->
	<EditorWaitSettled/>
	<DevCommand line="panel.focus material"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.PreviewTickCount" differsFrom="hiddenTicks" timeoutFrames="300"/>
	<EditorWaitSettled/>
	<Expect watch="Engine.FramePacingState" equals="3"/>
	<EditorWaitSettled/>
	<DevCommand line="panel.close material"/>
	<EditorWaitSettled/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
