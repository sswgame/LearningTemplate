<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Sequencer 바인딩 · 카메라 컷 차선: 테스트 씬(sequencerkeys/sequencerkeys.scene.xml)과 시퀀스를 연다.
  ① 계층에서 CamA 를 고르고 "선택에서 바인딩 더하기" → 바인딩 2, 묶이지 않은 바인딩 0(Director 의 플레이어에 묶였다 — 되돌리기 한 단계).
  ② 프레임 0 에서 컷 더하기 → 컷 1. ③ CamB 를 고르고 바인딩을 더한 뒤 프레임 50 에서 컷 더하기 → 컷 2(앞 컷은 49 에서 끝난다 — 모델 테스트 AddCameraCutSplitsTheLane).
  ④ 컷 차선 · 바인딩 목록 화면을 찍는다(카메라 이름이 컷 띠에 보이고, 묶이지 않음 빨간 글이 없다).
  실행: App -EnableEditor -scenario=engine/automation/editor/sequencercuts.scenario.xml -unattended
-->
<Scenario name="editor.sequencercuts" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open engine/automation/editor/sequencerkeys/sequencerkeys.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="sequencerkeys.seq.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.SequencerBindingCount" equals="1" timeoutFrames="120"/>
	<Expect watch="Editor.SequencerCutCount" equals="0"/>
	<!-- ① CamA 바인딩 -->
	<EditorClick mark="hierarchy.row.CamA"/>
	<EditorWaitStable/>
	<!-- 되돌리기 감시 값은 포커스 창의 스택이다 — 계층을 누른 뒤라 시퀀서에 포커스를 돌려 그 문서의 스택에서 앞 값을 읽는다 -->
	<DevCommand line="panel.focus sequencer"/>
	<EditorWaitStable/>
	<Store watch="Editor.UndoIndex" as="undoBefore"/>
	<EditorClick mark="sequencer.addBindingFromSelection"/>
	<WaitUntil watch="Editor.SequencerBindingCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.SequencerUnboundCount" equals="0"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoBefore"/>
	<!-- ② 프레임 0 에서 컷 -->
	<EditorClick mark="sequencer.addCut"/>
	<WaitUntil watch="Editor.SequencerCutCount" equals="1" timeoutFrames="60"/>
	<!-- ③ CamB 바인딩 · 프레임 50 컷 -->
	<EditorClick mark="hierarchy.row.CamB"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.addBindingFromSelection"/>
	<WaitUntil watch="Editor.SequencerBindingCount" equals="3" timeoutFrames="60"/>
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="50"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.addCut"/>
	<WaitUntil watch="Editor.SequencerCutCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.SequencerUnboundCount" equals="0"/>
	<EditorWaitStable/>
	<!-- ⑤ 쇼트 도구: 프레임 75 에서 컷을 나누면 컷 3(뒤 조각을 고른다), 고른 컷의 카메라를 CamA 로 바꾸면 되돌리기가 쌓이고, 지우면 앞 컷이 그 자리를 덮어 컷 2(모델 테스트 ShotToolsSplitRemoveAndRebindCuts) -->
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="75"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.splitCut"/>
	<WaitUntil watch="Editor.SequencerCutCount" equals="3" timeoutFrames="60"/>
	<EditorClick mark="sequencer.binding.1"/>
	<EditorWaitStable/>
	<Store watch="Editor.UndoIndex" as="undoBeforeCamera"/>
	<EditorClick mark="sequencer.cutCamera"/>
	<WaitUntil watch="Editor.UndoIndex" differsFrom="undoBeforeCamera" timeoutFrames="60"/>
	<EditorClick mark="sequencer.deleteCut"/>
	<WaitUntil watch="Editor.SequencerCutCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.SequencerItemCount" equals="2"/>
	<!-- 쇼트 목록의 첫 줄을 누르면 그 컷을 고른다 -->
	<EditorClick mark="sequencer.shot.0"/>
	<EditorWaitStable/>
	<!-- ⑥ 항목 복사 · 붙여넣기: 고른 컷을 프레임 75 에 붙이면 항목이 셋이다 -->
	<EditorClick mark="sequencer.copyItem"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.scrub" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+A"/>
	<EditorWaitStable/>
	<EditorText value="75"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<EditorWaitStable/>
	<EditorClick mark="sequencer.pasteItem"/>
	<WaitUntil watch="Editor.SequencerItemCount" equals="3" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- ④ 화면 -->
	<CaptureEditorUI file="sequencercuts/cutlane.png" maxMagentaFraction="0"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
