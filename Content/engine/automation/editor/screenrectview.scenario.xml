<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 화면 사각형 뷰(PiP)가 에디터 게임 뷰(ImGui 이미지로 보이는 게임 뷰 RT) 안의 자기 사각형에 그려진다.
  테스트 씬(engine/automation/editor/screenrectview/screenrectview.scene.xml): 주 카메라는 빈 곳을 보고, PiP 카메라(사각형 0.55,0.55,0.4,0.4)는 30 m 옆의 큐브를 본다.
  게임 뷰를 앞으로 내고 주 출력(게임 뷰 RT)을 찍어, PiP 사각형 안만 큐브로 밝고 왼쪽 위는 배경 그대로인지 본다. 씬 뷰가 주 출력이면 PiP 는 빠진다(RenderPacketBuilder).
  실행: App -EnableEditor -scenario=engine/automation/editor/screenrectview.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.screenrectview" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="5"/>
	<ResizeWindow width="1600" height="900"/>
	<Wait frames="10"/>
	<DevCommand line="scene.open engine/automation/editor/screenrectview/screenrectview.scene.xml"/>
	<Wait frames="40"/>
	<DevCommand line="panel.close prefab_editor"/>
	<DevCommand line="panel.focus game_view"/>
	<Wait frames="40"/>
	<EditorExpectObject name="PipCamera"/>
	<Expect watch="Editor.GameViewRequested" equals="1"/>
	<Screenshot file="screenrectview.ppm"/>
	<CaptureEditorUI file="screenrectview_editor.png"/>
	<!-- PiP 카메라만 뺀 같은 씬(screenrectview_nopip.scene.xml)의 게임 뷰를 기준으로 찍는다 — 평균 휘도는 서로 다른 그림이 같은 평균을 내면 통과하므로 화소를 견준다 -->
	<Wait frames="5"/>
	<DevCommand line="scene.open engine/automation/editor/screenrectview/screenrectview_nopip.scene.xml"/>
	<Wait frames="1"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutFrames="300"/>
	<Wait frames="34"/>
	<Expect watch="Editor.GameViewRequested" equals="1"/>
	<Screenshot file="screenrectview_nopip.ppm"/>
	<Wait frames="5"/>
	<!-- PiP 사각형(0.55,0.55,0.4,0.4) 안쪽은 큐브가 든 칸이라 기준과 화소가 많이 다르고(배경과 다른 화소 비율 약 0.65 — Release 캡처로 어림, 문턱은 그 절반 아래), 왼쪽 위와 PiP 바로 위는 PiP 가 없는 기준과 같다.
		     사각형이 게임 뷰 RT 가 아닌 곳(백버퍼)에 그려지면 안쪽이 기준과 같고, 위아래가 뒤집히면(GL 원점) 오른쪽 위가 다르다. 문턱은 GPU 확인 대기 -->
	<ExpectImage file="screenrectview.ppm" golden="screenrectview" region="0.6,0.6,0.9,0.9"/>
	<!-- 다음 시나리오가 깨끗한 씬에서 시작하게 되돌린다 -->
	<Wait frames="5"/>
	<DevCommand line="panel.focus scene_view"/>
	<Wait frames="5"/>
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<Wait frames="25"/>
	<Pass/>
</Scenario>
