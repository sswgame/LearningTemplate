<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — UI Preview 패널(runtime-ui 8-5 뒤의 남은 것):
  1) 콘텐츠 열기 — Quick Open 이 `*.ui.xml` 을 열면(콘텐츠 브라우저 더블클릭과 같은 EditorAssetCommands::openPath) 에셋 종류 UIDocument 의 패널 UI Preview 가 열려 그 문서를 짓는다.
  2) 언어 — 영어 · 의사 문화권 qps-ploc(글이 늘어난다) · qps-plocm(오른쪽에서 왼쪽 배치)을 이 화면에만 건다. 게임 언어로 되돌린다.
  3) 속성 편집 — 고른 위젯의 _opacity 를 인스펙터로 고치면 되돌리기 하나가 쌓이고, Undo · Redo 가 값을 오간다.
  4) 입력 흉내 — 포인터를 그림 위에 두면 위젯이 호버되고, 탐색 방향 단추가 포커스를 옮기며, Accept 가 버튼을 누른다(명령은 로그에만 남는다).
  5) 애니메이션 — Play 가 Open 을 틀어 끝 값에 닿고, 시간 막대를 끌면 그 시각의 값에서 멈춘다. Reload 가 문서 값을 되찾는다.
  6) 저장 — 작은 문서(uipreview/save_probe.ui.xml)의 실행마다 새 사본(scratch/uipreview — <Scratch>)을 `asset.openScratch` 로 열어 _opacity 를 고쳐 저장하면
     핫 리로드가 파일에서 다시 짓고(값이 파일에서 돌아온다), 되돌려 저장한다. 추적 중인 원본에 쓰면 병렬 조각의 다른 백엔드 체인이 같은 파일을 동시에 고친다.
  실행: App -EnableEditor -scenario=engine/automation/editor/uipreview.scenario.xml -unattended (백엔드 dx11 · vulkan · opengl 도 같다)
-->
<Scenario name="editor.uipreview" fixedDelta="0.0166667" timeoutFrames="4000" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/uipreview" as="scratch/uipreview"/>
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<!-- 1) 에셋 열기: 기본 문서(pause)가 아닌 문서를 열어 작업공간 포커스가 패널에 전해지는지 본다 -->
	<Wait frames="35"/>
	<EditorKey key="Ctrl+P"/>
	<Wait frames="15"/>
	<EditorText value="confirm_unsaved.ui.xml"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" atLeast="11" timeoutFrames="900"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewWidgetCount" atMost="11"/>
	<Wait frames="5"/>
	<EditorKey key="Ctrl+P"/>
	<Wait frames="15"/>
	<EditorText value="pause.ui.xml"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<!-- pause 는 위젯 16 개, 앞 문서(confirm_unsaved)는 11 개다 — 글 감시 값만 기다리면 앞 문서의 글로 지나가 버린다 -->
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" atLeast="12" timeoutFrames="900"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewFirstTextBytes" atLeast="1" timeoutFrames="900"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewWidgetCount" atLeast="9"/>
	<!-- 2) 언어 -->
	<EditorClick mark="uipreview.language"/>
	<EditorClick mark="uipreview.language.en"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewFirstTextBytes" equals="6" timeoutFrames="600"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewRightToLeft" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.language"/>
	<EditorClick mark="uipreview.language.qps_ploc"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewFirstTextBytes" atLeast="9" timeoutFrames="600"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewRightToLeft" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.language"/>
	<EditorClick mark="uipreview.language.qps_plocm"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewRightToLeft" equals="1" timeoutFrames="600"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewFirstTextBytes" atLeast="9"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.language"/>
	<EditorClick mark="uipreview.language.game"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewRightToLeft" equals="0" timeoutFrames="600"/>
	<WaitUntil watch="Editor.UIPreviewLanguageIndex" equals="0" timeoutFrames="60"/>
	<!-- 3) 속성 편집: Window 의 _opacity 를 0.5 로 — 되돌리기 항목 하나, Undo 로 1, Redo 로 0.5 -->
	<Wait frames="15"/>
	<EditorClick mark="uipreview.widget.Window"/>
	<Wait frames="10"/>
	<Expect watch="Editor.UIPreviewSelectedOpacity" near="1" tolerance="0.001"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.inspector.search"/>
	<Wait frames="10"/>
	<EditorText value="opacity"/>
	<EditorClick mark="inspector.property.BorderPanel._opacity" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="0.5"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" near="0.5" tolerance="0.001" timeoutFrames="60"/>
	<Expect watch="Editor.UIPreviewDirty" equals="1"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" near="1" tolerance="0.001" timeoutFrames="60"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.redo"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" near="0.5" tolerance="0.001" timeoutFrames="60"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" near="1" tolerance="0.001" timeoutFrames="60"/>
	<!-- 4) 입력 흉내 -->
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewHoveredOrdinal" equals="-1"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.interact"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewTextureReady" equals="1" timeoutFrames="600"/>
	<Wait frames="10"/>
	<EditorHover mark="uipreview.image" anchor="0.5,0.5"/>
	<WaitUntil watch="Editor.UIPreviewHoveredOrdinal" atLeast="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorHover release="true"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.nav.down"/>
	<WaitUntil watch="Editor.UIPreviewFocusedOrdinal" atLeast="0" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.nav.accept"/>
	<Wait frames="15"/>
	<ExpectLog contains="is not wired in this preview" atLeast="1"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.interact"/>
	<!-- 5) 애니메이션: Play 가 Open 을 끝까지 틀고, 시간 막대는 그 시각에서 멈춘다 -->
	<EditorClick mark="uipreview.widget.Window"/>
	<EditorClick mark="uipreview.animation.play"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewAnimationPlaying" equals="1" timeoutFrames="120"/>
	<Wait frames="2"/>
	<Expect watch="Editor.UIPreviewSelectedOpacity" atMost="0.95"/>
	<Wait frames="3"/>
	<WaitUntil watch="Editor.UIPreviewAnimationPlaying" equals="0" timeoutFrames="300"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewSelectedOpacity" near="1" tolerance="0.01"/>
	<Wait frames="5"/>
	<EditorDrag mark="uipreview.animationtime" dx="-3000" dy="0"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" atMost="0.01" timeoutFrames="75"/>
	<Wait frames="5"/>
	<EditorDrag mark="uipreview.animationtime" dx="3000" dy="0"/>
	<WaitUntil watch="Editor.UIPreviewSelectedOpacity" atLeast="0.99" timeoutFrames="75"/>
	<Expect watch="Editor.UIPreviewAnimationTime" atLeast="0.1"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.reload"/>
	<Wait frames="25"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" atLeast="9" timeoutFrames="600"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewDirty" equals="0"/>
	<!-- 6) 저장: 작은 문서의 _opacity 를 0.5 로 저장하고 핫 리로드가 파일에서 읽어 오면, 1 로 되돌려 저장한다(사본이라 원본은 바뀌지 않는다) -->
	<Wait frames="5"/>
	<DevCommand line="asset.openScratch scratch/uipreview/save_probe.ui.xml"/>
	<Wait frames="40"/>
	<WaitUntil watch="Editor.UIPreviewWidgetCount" equals="1" timeoutFrames="900"/>
	<Wait frames="10"/>
	<EditorClick mark="uipreview.widget.Card"/>
	<EditorClick mark="inspector.property.BorderPanel._opacity" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="0.5"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.UIPreviewDirty" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.save"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewDirty" equals="0" timeoutFrames="300"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewReloadedAfterSave" equals="1" timeoutFrames="900"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewSelectedOpacity" near="0.5" tolerance="0.001"/>
	<EditorClick mark="inspector.property.BorderPanel._opacity" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="1"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.UIPreviewDirty" equals="1" timeoutFrames="60"/>
	<Wait frames="5"/>
	<EditorClick mark="uipreview.save"/>
	<Wait frames="10"/>
	<WaitUntil watch="Editor.UIPreviewDirty" equals="0" timeoutFrames="300"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.UIPreviewReloadedAfterSave" equals="1" timeoutFrames="900"/>
	<Wait frames="5"/>
	<Expect watch="Editor.UIPreviewSelectedOpacity" near="1" tolerance="0.001"/>
	<Wait frames="10"/>
	<DevCommand line="panel.close ui_preview"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
