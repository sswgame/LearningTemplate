<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 보기 모드 ShadingPath(셰이딩 경로): 씬 뷰 툴바 콤보로 고르면 표면이 그려진 경로의 색으로 바뀐다
  (디퍼드 G버퍼 조명 파랑 · G버퍼 조명 없음 청회색 · 포워드 전용 주황 · 반투명 보라 · 포워드 초록 · 포워드 조명 없음 짙은 초록 — RenderViewSettings.h).
  Lit · Unlit 과 다른 그림이어야 한다(셰이더 define SW_VIEWMODE_SHADINGPATH 이 이름이 어긋나면 컴파일은 되고 그림만 Lit 으로 남는다).
  기본 파이프라인(포워드)에서는 대부분 초록이다 — 디퍼드에서의 색은 -gv_renderPipeline=engine/pipeline/deferredpipeline.xml 로 띄워 눈으로 본다(그림 shadingpath.ppm).
  G버퍼 칸의 값은 Render Targets 창의 픽셀 툴팁이 명세(GBufferLayout v1)의 뜻으로 풀어 보인다.
  실행: App -EnableEditor -scenario=engine/automation/editor/shadingpathview.scenario.xml -unattended
-->
<Scenario name="editor.shadingpathview" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<Variable name="gv_editorUiScale" value="1.5"/>
	<ResizeWindow width="1600" height="900"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus scene_view"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<Expect watch="Editor.SceneViewMode" equals="0"/>
	<Screenshot file="shadingpath_lit.ppm"/>
	<EditorClick mark="viewport.viewMode"/>
	<EditorWaitStable/>
	<EditorClick mark="viewport.viewMode.unlit"/>
	<WaitUntil watch="Editor.SceneViewMode" equals="1" timeoutFrames="90"/>
	<Screenshot file="shadingpath_unlit.ppm"/>
	<EditorClick mark="viewport.viewMode"/>
	<EditorWaitStable/>
	<EditorClick mark="viewport.viewMode.shadingpath"/>
	<WaitUntil watch="Editor.SceneViewMode" equals="15" timeoutFrames="90"/>
	<Screenshot file="shadingpath.ppm"/>
	<EditorWaitStable/>
	<ExpectImagesDiffer first="shadingpath_lit.ppm" second="shadingpath.ppm" region="0.1,0.1,0.9,0.9" minDiffering="0.05"/>
	<ExpectImagesDiffer first="shadingpath_unlit.ppm" second="shadingpath.ppm" region="0.1,0.1,0.9,0.9" minDiffering="0.05"/>
	<EditorClick mark="viewport.viewMode"/>
	<EditorWaitStable/>
	<EditorClick mark="viewport.viewMode.lit"/>
	<WaitUntil watch="Editor.SceneViewMode" equals="0" timeoutFrames="90"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
