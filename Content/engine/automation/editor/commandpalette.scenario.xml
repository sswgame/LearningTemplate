<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 등록 줄 커맨드(SW_EDITOR_COMMAND, 확장 지점 C3)가 커맨드 팔레트에 나오고 실행된다.
  Ctrl+Shift+P 로 팔레트를 열고 "Self Test Ping" 을 쳐서 Enter — 그 커맨드가 남기는 로그 한 줄을 본다(EditorSelfTestDevTools.cpp 의 selftest.ping).
  실행: App -EnableEditor -scenario=engine/automation/editor/commandpalette.scenario.xml -unattended
-->
<Scenario name="editor.commandpalette" fixedDelta="0.0166667" timeoutFrames="300" startAfter="Immediately" input="exclusive">
	<Wait frames="60"/>
	<EditorKey key="Ctrl+Shift+P"/>
	<EditorText value="Self Test Ping"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<ExpectLog contains="Self-test registration command ran" count="1"/>
	<Wait frames="10"/>
	<Pass/>
</Scenario>
