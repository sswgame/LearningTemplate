<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 캐릭터 편집 창: 커맨드로 열고 탭마다 눈으로 볼 화면을 찍는다.
  소켓 탭: 창을 열면 팩 데이터의 소켓 파일이 문서로 읽힌다(Load 는 다시 읽기) — 목록 · 상세. 스켈레톤 탭: 스켈레톤을 읽어 본 트리 · 포즈 편집(읽은 본 이름이 소켓 부모 검증에 연결된다).
  외형 탭: 아이템 · 외형 데이터를 읽고 세트를 입혀 칸 · 규칙 설명이 나오는지 본다. 미리보기 탭: 그 선택을 입은 몸이 미리보기 씬에 조립된다(메인 씬은 그대로). 클립을 골라 Play 하면 몸이 그 클립으로 움직인다(팩 데이터의 clipFolder).
  실행: App -EnableEditor -scenario=engine/automation/editor/charactereditor.scenario.xml -unattended
-->
<Scenario name="editor.charactereditor" fixedDelta="0.0166667" timeoutFrames="1300" startAfter="Immediately" input="exclusive">
	<Wait frames="10"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="10"/>
	<ResizeWindow width="1900" height="1200"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="40"/>
	<EditorKey key="Ctrl+Shift+P"/>
	<Wait frames="15"/>
	<EditorText value="Character Editor"/>
	<Wait frames="15"/>
	<EditorKey key="Enter"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus charactereditor.main"/>
	<WaitUntil watch="Editor.CharacterEditorSocketCount" atLeast="3" timeoutFrames="135"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.loadSockets"/>
	<Wait frames="30"/>
	<Expect watch="Editor.CharacterEditorSocketCount" atLeast="3"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.socket.first"/>
	<Wait frames="30"/>
	<CaptureEditorUI file="charactereditor/sockets.png"/>
	<EditorClick mark="charactereditor.tab.skeleton" state="down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.skeleton" state="up"/>
	<EditorClick mark="charactereditor.loadSkeleton"/>
	<WaitUntil watch="Editor.CharacterEditorBoneCount" atLeast="30" timeoutFrames="90"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.bone.root"/>
	<Wait frames="35"/>
	<CaptureEditorUI file="charactereditor/skeleton.png"/>
	<EditorClick mark="charactereditor.tab.appearance" state="down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.appearance" state="up"/>
	<EditorClick mark="charactereditor.loadData"/>
	<EditorClick mark="charactereditor.basePreset"/>
	<EditorClick mark="charactereditor.basePreset.first"/>
	<EditorClick mark="charactereditor.equipSet"/>
	<EditorClick mark="charactereditor.equipSet.first"/>
	<WaitUntil watch="Editor.CharacterEditorEquippedSlotCount" atLeast="1" timeoutFrames="90"/>
	<Wait frames="10"/>
	<CaptureEditorUI file="charactereditor/appearance.png"/>
	<EditorClick mark="charactereditor.tab.preview" state="down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.preview" state="up"/>
	<WaitUntil watch="Editor.CharacterEditorPreviewAssembleCount" atLeast="1" timeoutFrames="177"/>
	<!-- 스켈레톤 탭에서 고른 본(root)에 기즈모 표식이 놓인다 — 뷰포트에서 끌면 포즈 편집이 된다(눈으로 본다). 관통 점은 피팅 데이터가 겹치는 차림에서만 찍힌다(감시 값 Editor.CharacterEditorPenetrationMarks) -->
	<Wait frames="5"/>
	<Expect watch="Editor.CharacterEditorBoneGizmoPlaced" atLeast="1"/>
	<Wait frames="15"/>
	<CaptureEditorUI file="charactereditor/preview.png"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.clip"/>
	<EditorClick mark="charactereditor.clip.first"/>
	<EditorClick mark="charactereditor.playClip"/>
	<WaitUntil watch="Editor.CharacterEditorPreviewClipPlaying" atLeast="1" timeoutFrames="135"/>
	<Wait frames="40"/>
	<CaptureEditorUI file="charactereditor/clip.png"/>
	<!-- 꾸미기 슬라이더(스키마가 있는 프리셋이면 뷰포트 아래에 나온다): 눌러 값을 바꾸고 놓으면 몸이 다시 입혀진다 — 눈으로 본다 -->
	<!-- 슬라이더 칸은 창 아래로 넘친다 — 창 위쪽(클립 고르기)에 커서를 두고 휠로 창을 내린다 -->
	<EditorHover mark="charactereditor.clip" anchor="0.5,0.5"/>
	<Wait frames="2"/>
	<EditorWheel dy="-10"/>
	<Wait frames="5"/>
	<EditorHover release="true"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.slider.first"/>
	<Wait frames="60"/>
	<CaptureEditorUI file="charactereditor/slider.png"/>
	<!-- 제약 리그 미리보기(팩 데이터의 rig): 켜면 몸에 후처리 리그가 걸린다 — 눈으로 본다 -->
	<EditorClick mark="charactereditor.rigPreview"/>
	<Wait frames="50"/>
	<CaptureEditorUI file="charactereditor/rig.png"/>
	<!-- 미리보기 뷰포트의 휠 줌: 씬 뷰와 같은 dolly 라 거리가 바뀐다(EditorOrbitMath) -->
	<Wait frames="5"/>
	<EditorHover mark="charactereditor.previewScene" anchor="0.5,0.5"/>
	<Wait frames="5"/>
	<Remember watch="Editor.PreviewViewportOrbitDistance" as="previewDistance"/>
	<Wait frames="2"/>
	<EditorWheel dy="2"/>
	<WaitUntil watch="Editor.PreviewViewportOrbitDistance" differsFrom="previewDistance" timeoutFrames="60"/>
	<Wait frames="2"/>
	<EditorHover release="true"/>
	<!-- 사용자 프리셋 · 썸네일: 에디터 쪽 로컬 저장소(CharacterEditorLocalStore - 사용자 데이터 폴더 editor/)의 슬롯에 쓴다. 콘텐츠 트리에는 쓰지 않는다.
	     썸네일은 위에서 그린 미리보기 렌더 타깃을 캡처한다. 프리셋 줄은 외형 탭 맨 아래라 휠로 내린다 -->
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.tab.appearance" state="down"/>
	<Wait frames="1"/>
	<EditorClick mark="charactereditor.tab.appearance" state="up"/>
	<Wait frames="19"/>
	<EditorHover mark="charactereditor.loadData" anchor="0.5,0.5"/>
	<Wait frames="2"/>
	<EditorWheel dy="-80"/>
	<Wait frames="5"/>
	<EditorHover release="true"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.savePreset"/>
	<WaitUntil watch="Editor.CharacterEditorPresetCount" atLeast="1" timeoutFrames="120"/>
	<ExpectLog contains="Character Editor: presets saved to slot charactereditor/presets" count="1"/>
	<Wait frames="5"/>
	<EditorClick mark="charactereditor.saveThumbnail"/>
	<Wait frames="90"/>
	<ExpectLog contains="Character Editor: thumbnail of preset 'MyLook' stored in slot charactereditor/thumb.mylook" count="1"/>
	<ExpectLog contains="Character Editor: presets saved to slot charactereditor/presets" count="2"/>
	<Wait frames="2"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
