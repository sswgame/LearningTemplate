<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 입력 맵 패널의 바인딩 줄: HoldThreshold 를 고르면 시간 칸이, MultiTap 을 고르면 횟수(taps) 칸이 같은 바인딩 줄 아래에 나온다.
  패널 기본 크기(960 x 640)에서 콤보 · 시간 · Negate 가 잘리지 않는 것은 캡처로 확인했다(후보 EditorCaptureFollowUps). 여기서는 트리거가 실제로 바뀌는 것만 본다.
  콤보는 항목을 여덟 개까지만 보이므로 마지막 항목(MultiTap)은 키보드(아래 화살표 열 번)로 고른다.
  실행: App -EnableEditor -scenario=engine/automation/editor/inputmaptaps.scenario.xml -unattended
-->
<Scenario name="editor.inputmaptaps" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="15"/>
	<DevCommand line="panel.focus input_map"/>
	<EditorClick mark="inputMap.filter"/>
	<Wait frames="5"/>
	<EditorText value="Confirm"/>
	<EditorClick mark="inputMap.action.Confirm"/>
	<EditorClick mark="inputMap.binding.0.trigger"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="3"/>
	<EditorKey key="DownArrow"/>
	<Wait frames="8"/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.InputMapSelectedTrigger" equals="10" timeoutFrames="60"/>
	<Wait frames="5"/>
	<DevCommand line="panel.close input_map"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
