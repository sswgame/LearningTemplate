<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터의 타입 컴포넌트 핸들 선택기(TComponentHandle<T>). 엔진 컴포넌트에는 이 모양의 PROPERTY 가 없어서 Empty 게임의 테스트 무대 컴포넌트
  TypedHandleTestComponent(_target: TComponentHandle<MeshComponent>)로 본다. 값은 감시 값 Editor.SelectedHandle 이 선택기와 같은 글로 읽는다.
  ① 오브젝트 Prober 에 그 컴포넌트를 달면 값이 (none) 이다. ② 콤보를 열어 TestMesh 의 메시 컴포넌트를 고르면 값이 바뀌고 되돌리기 하나가 쌓인다.
  ③ Ctrl+Z 로 비운다. ④ 다시 고른 뒤 `(none)` 을 고르면 비워진다. ⑤ 이름 글을 오른쪽 클릭한 행 메뉴에서 Paste Value 는 비활성이다(글로 붙이면 타입 확인이 빠진다).
  ⑥ CallInEditor 메서드 Assign Target 의 인자 콤보(프로퍼티와 같은 선택기)로 고르고 Invoke 하면 같은 값이 들어간다.
  실행: App -EnableEditor -scenario=engine/automation/editor/inspectorhandle.scenario.xml -unattended
-->
<Scenario name="editor.inspectorhandle" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<DevCommand line="scene.open game/empty/maps/editortest.scene.xml"/>
	<Wait frames="1"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutFrames="900"/>
	<Wait frames="4"/>
	<ResizeWindow width="2300" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Variable name="gv_editorWatchProperty" value="TypedHandleTestComponent._target"/>
	<!-- 열린 채 시작하는 오버라이드 도구(prefab_editor)는 이 시나리오가 보지 않는다 — 닫아 화면이 가려지지 않게 한다 -->
	<Wait frames="5"/>
	<DevCommand line="panel.close prefab_editor"/>
	<!-- ① 오브젝트에 컴포넌트를 단다 -->
	<Wait frames="15"/>
	<EditorClick mark="hierarchy.create"/>
	<Wait frames="15"/>
	<EditorClick mark="inspector.name"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="Prober"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="15"/>
	<DevCommand line="component.add TypedHandleTestComponent"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedNames" is="Prober"/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<Remember watch="Editor.UndoIndex" as="undoBefore"/>
	<CaptureEditorUI file="inspectorhandle/inspector.png"/>
	<!-- ② 콤보로 고른다 -->
	<Wait frames="10"/>
	<EditorClick mark="inspector.property.TypedHandleTestComponent._target"/>
	<Wait frames="20"/>
	<CaptureEditorUI file="inspectorhandle/combo.png"/>
	<Wait frames="10"/>
	<EditorHover mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="10"/>
	<EditorClick mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="TestMesh / MeshComponent#0"/>
	<Expect watch="Editor.UndoIndex" differsFrom="undoBefore"/>
	<CaptureEditorUI file="inspectorhandle/picked.png"/>
	<!-- ③ 되돌리기 -->
	<Wait frames="10"/>
	<EditorKey key="Ctrl+Z"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<Expect watch="Editor.UndoIndex" sameAs="undoBefore"/>
	<!-- ④ 다시 고르고 (none) -->
	<Wait frames="10"/>
	<EditorClick mark="inspector.property.TypedHandleTestComponent._target"/>
	<Wait frames="20"/>
	<EditorHover mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="10"/>
	<EditorClick mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="TestMesh / MeshComponent#0"/>
	<Wait frames="10"/>
	<EditorClick mark="inspector.property.TypedHandleTestComponent._target"/>
	<Wait frames="20"/>
	<EditorHover mark="inspector.handle.none"/>
	<Wait frames="10"/>
	<EditorClick mark="inspector.handle.none"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<!-- ⑤ 행 메뉴의 Paste Value 는 비활성 -->
	<Wait frames="10"/>
	<EditorClick mark="inspector.label.TypedHandleTestComponent._target" button="1" state="down"/>
	<Wait frames="3"/>
	<EditorClick mark="inspector.label.TypedHandleTestComponent._target" button="1" state="up"/>
	<Wait frames="17"/>
	<CaptureEditorUI file="inspectorhandle/menu.png"/>
	<Wait frames="5"/>
	<EditorClick mark="inspector.menu.pasteValue"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<!-- 비활성 항목을 눌러도 메뉴는 닫히지 않고, 열린 메뉴가 아래 인자 콤보를 덮어 다음 클릭이 메뉴 항목에 떨어진다 — 먼저 닫는다 -->
	<Wait frames="5"/>
	<EditorKey key="Escape"/>
	<!-- ⑥ CallInEditor 인자 선택기: 메서드 Assign Target 의 인자 콤보가 프로퍼티와 같은 선택기다 — 고르고 Invoke 하면 _target 에 들어간다 -->
	<Wait frames="5"/>
	<EditorClick mark="inspector.method.arg.assignTarget.0"/>
	<Wait frames="20"/>
	<CaptureEditorUI file="inspectorhandle/methodarg.png"/>
	<Wait frames="5"/>
	<EditorHover mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="10"/>
	<EditorClick mark="inspector.handle.choice.TestMesh / MeshComponent#0"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedHandle" is="(none)"/>
	<Wait frames="5"/>
	<EditorClick mark="inspector.method.invoke.assignTarget"/>
	<Wait frames="25"/>
	<Expect watch="Editor.SelectedHandle" is="TestMesh / MeshComponent#0"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
