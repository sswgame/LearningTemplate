<?asset guid="3761759e66e64e1918dcf7768f674ce1"?>
<!--
  에디터 시나리오 — 렌더 디버거 창의 버퍼 탭(그래프 밖 구조 버퍼 FrameBufferTable 을 CPU 로 읽어 표로 본다).
  가림 판정을 켜면 프레임 그래프가 HZB 피라미드 · 가림 타일 버퍼를 크기와 함께 등록한다(HZBOcclusion::registerFrameResources). 목록이 서면 첫 버퍼를 골라 읽고
  표의 행 수가 0 보다 크다(Editor.RenderDebuggerBufferRows). GPU 컬링이 없는 백엔드(DX11)는 가림 판정이 없어 건너뛴다.
  실행: App -EnableEditor -scenario=engine/automation/editor/renderdebuggerbuffers.scenario.xml -unattended
-->
<Scenario name="editor.renderdebuggerbuffers" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<ResizeWindow width="1600" height="900"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Variable name="gv_occlusionCulling" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="scene.open game/playground/maps/fogshowcase.scene.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="panel.focus game_view"/>
	<EditorWaitStable/>
	<SkipUnless watch="Render.OcclusionTilesBuilt" reason="가림 판정은 GPU 컬링이 있는 백엔드만 돈다 — 그 밖은 FrameBufferTable 에 HZB 를 등록하지 않는다"/>
	<DevCommand line="panel.focus render_debugger"/>
	<EditorWaitStable/>
	<EditorClick mark="renderDebugger.tab.buffers"/>
	<WaitUntil watch="Editor.RenderDebuggerTab" equals="2" timeoutFrames="60"/>
	<WaitUntil watch="Editor.RenderDebuggerBuffers" atLeast="1" timeoutWallSeconds="10"/>
	<EditorWaitStable/>
	<EditorClick mark="renderDebugger.buffer.HZB.0"/>
	<WaitUntil watch="Editor.RenderDebuggerBufferRows" atLeast="1" timeoutWallSeconds="10"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="renderdebugger/buffers.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<Variable name="gv_occlusionCulling" value="0"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
