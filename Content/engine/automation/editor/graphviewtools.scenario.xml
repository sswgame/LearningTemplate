<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 노드 그래프 캔버스 공통 도구(EditorNodeGraph · EditorGraphDocumentPanel): 애니메이션 그래프 사본에서
  미니맵 켜고 끄기(Editor.GraphMinimapShown) → 두 노드를 골라 정렬(Editor.GraphAlignedNodeCount) → 핀을 빈 곳에 놓아 노드를 고르면 그 핀과 이어진다
  (Editor.GraphAutoLinkCount · Editor.AnimationGraphLinkCount) → Ctrl+D 복제 · Ctrl+C / Ctrl+V 붙여 넣기(Editor.GraphNodeCount) → 주석 상자(Editor.GraphCommentCount)
  → 저장한 뒤 다시 읽어도 노드 · 주석이 남는다. 마지막 화면은 CaptureEditorUI 로 찍어 사람이(또는 에이전트가) 본다.
  문서는 animgraphedit 의 테스트 그래프(노드 Idle · Walk, 전이 둘)를 실행마다 새 사본(scratch/graphviewtools)으로 연다 — 원본에 쓰지 않는다(animgraphedit 머리말).
  실행: App -EnableEditor -scenario=engine/automation/editor/graphviewtools.scenario.xml -unattended
-->
<Scenario name="editor.graphviewtools" fixedDelta="0.0166667" timeoutFrames="1400" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/animgraphedit" as="scratch/graphviewtools"/>
	<EditorWaitStable/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus animation_graph"/>
	<EditorWaitStable/>
	<DevCommand line="asset.openScratch scratch/graphviewtools/animgraphedit.animgraph.xml"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.AnimationGraphLinkCount" equals="2"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="2" timeoutFrames="90"/>
	<EditorWaitStable/>
	<!-- 미니맵: 처음엔 보이고, 단추로 감추고 다시 보인다 -->
	<Expect watch="Editor.GraphMinimapShown" equals="1"/>
	<EditorClick mark="animGraph.view.minimap"/>
	<WaitUntil watch="Editor.GraphMinimapShown" equals="0" timeoutFrames="30"/>
	<EditorWaitStable/>
	<EditorClick mark="animGraph.view.minimap"/>
	<WaitUntil watch="Editor.GraphMinimapShown" equals="1" timeoutFrames="30"/>
	<EditorWaitStable/>
	<!-- 정렬: 노드 둘을 고르고 위 맞춤 -->
	<EditorClick mark="animationGraph.node.Idle"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.node.Walk" mods="ctrl"/>
	<EditorWaitStable/>
	<EditorClick mark="animGraph.view.align"/>
	<EditorWaitStable/>
	<EditorClick mark="animGraph.view.align.top"/>
	<WaitUntil watch="Editor.GraphAlignedNodeCount" equals="2" timeoutFrames="30"/>
	<EditorWaitStable/>
	<!-- 핀 끌어 노드 만들기: Walk 의 출력 핀(노드 2 → 핀 22)을 아래 빈 곳에 놓고 Attack 을 고른다 -->
	<EditorDrag mark="animGraph.pin.22" dx="0" dy="220"/>
	<EditorWaitStable/>
	<EditorText value="att"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="3" timeoutFrames="60"/>
	<WaitUntil watch="Editor.GraphAutoLinkCount" atLeast="1" timeoutFrames="60"/>
	<WaitUntil watch="Editor.AnimationGraphLinkCount" equals="3" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- 복제 · 복사 · 붙여 넣기 -->
	<EditorClick mark="animationGraph.node.Idle"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+D"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="4" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+C"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+V"/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="5" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- 주석 상자: 고른 노드를 감싼다 -->
	<EditorClick mark="animGraph.view.comment"/>
	<WaitUntil watch="Editor.GraphCommentCount" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- 저장 → 다시 읽기: 노드 · 주석이 파일에 남았다 -->
	<EditorClick mark="animationGraph.save"/>
	<WaitUntil watch="Editor.DirtyDocumentCount" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="animationGraph.load"/>
	<EditorWaitStable/>
	<WaitUntil watch="Editor.GraphNodeCount" equals="5" timeoutFrames="90"/>
	<WaitUntil watch="Editor.GraphCommentCount" equals="1" timeoutFrames="90"/>
	<EditorWaitStable/>
	<CaptureEditorUI file="graphviewtools.png" maxMagentaFraction="0"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
