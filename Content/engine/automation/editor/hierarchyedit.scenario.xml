<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Hierarchy 편집 기본기(N2): 첫 줄(GameCamera)을 누르고 Shift 를 누른 채 셋째 줄(TestSprite)을 누르면 세 줄이 골라진다.
  Ctrl+C · Ctrl+V 로 셋이 붙여 넣어지고(오브젝트 수 +3, 되돌리기 한 줄) Ctrl+Z 한 번에 돌아온다. ↓ 는 다음 줄로 선택을 옮긴다.
  실행: App -EnableEditor -scenario=engine/automation/editor/hierarchyedit.scenario.xml -unattended
-->
<Scenario name="editor.hierarchyedit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestSprite" mods="shift"/>
	<WaitUntil watch="Editor.SelectionCount" equals="3" timeoutFrames="60"/>
	<Expect watch="Editor.ObjectCount" equals="9"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+C"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+V"/>
	<WaitUntil watch="Editor.ObjectCount" equals="12" timeoutFrames="60"/>
	<Expect watch="Editor.SelectionCount" equals="3"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.ObjectCount" equals="9" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<EditorWaitStable/>
	<EditorKey key="DownArrow"/>
	<EditorWaitStable/>
	<Variable name="gv_editorWatchObject" value="TestMesh"/>
	<Expect watch="Editor.SelectionCount" equals="1"/>
	<Expect watch="Editor.SelectedComponentCount" equals="1"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
