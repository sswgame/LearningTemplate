<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 래그돌 미리보기 창: 창을 열고 Quick Open 으로 해골 전사의 물리 에셋(skeleton_warrior.physics.xml)을 고르면 창이 그 문서를 받아 바디 표를 읽고,
  몸 프리팹 칸에 해골 전사(common/prefabs/kaykit/skeleton_warrior)를 적어 Spawn 하면 그 몸에 래그돌을 세우고(문서의 바디가 모두 선다), Ragdoll 이 쓰러뜨리고, Reset 이 애니메이션 상태로 되돌린다. 미리보기 씬은 렌더러가 그린다.
  감시 값: Editor.RagdollPreviewDocumentBodies(문서를 읽었다) → Editor.RagdollPreviewBuiltBodies(래그돌이 섰다) → Editor.RagdollPreviewState(0 Animated · 1 Ragdoll)
  → Editor.RagdollPreviewSceneFrames(그렸다).
  실행: App -EnableEditor -scenario=engine/automation/editor/ragdollpreview.scenario.xml -unattended
-->
<Scenario name="editor.ragdollpreview" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus ragdoll_preview"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+P"/>
	<EditorWaitStable/>
	<EditorText value="skeleton_warrior.physics.xml"/>
	<EditorWaitStable/>
	<EditorKey key="Enter"/>
	<WaitUntil watch="Editor.RagdollPreviewDocumentBodies" atLeast="2" timeoutFrames="600"/>
	<EditorClick mark="ragdoll.bodyField"/>
	<EditorText value="common/prefabs/kaykit/skeleton_warrior.prefab.xml"/>
	<EditorWaitStable/>
	<EditorClick mark="ragdoll.spawn"/>
	<WaitUntil watch="Editor.RagdollPreviewBuiltBodies" atLeast="2" timeoutFrames="600"/>
	<Expect watch="Editor.RagdollPreviewState" equals="0"/>
	<EditorClick mark="ragdoll.drop"/>
	<WaitUntil watch="Editor.RagdollPreviewState" equals="1" timeoutFrames="120"/>
	<EditorWaitStable/>
	<EditorClick mark="ragdoll.reset"/>
	<WaitUntil watch="Editor.RagdollPreviewState" equals="0" timeoutFrames="300"/>
	<WaitUntil watch="Editor.RagdollPreviewSceneFrames" atLeast="60" timeoutFrames="600"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
