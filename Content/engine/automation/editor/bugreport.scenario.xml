<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 버그 리포트 한 방: 개발 명령 bugreport 가 Saved/BugReports/<시각>/ 에 info · 로그 · 씬 사본 · 재현 명령(다음 프레임 스크린샷)을 모으고,
  카메라를 옮긴 뒤 bugreport.goto(폴더를 주지 않으면 가장 최근)가 씬 뷰 카메라를 기록한 자리로 되돌린다(씬 뷰가 바깥에서 옮긴 에디터 카메라를 이어받는다).
  실행: App -EnableEditor -scenario=engine/automation/editor/bugreport.scenario.xml -unattended
-->
<Scenario name="editor.bugreport" fixedDelta="0.0166667" timeoutFrames="600" startAfter="Immediately" input="exclusive">
	<DevCommand line="layout.reset"/>
	<ResizeWindow width="1600" height="900"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewDrawn" equals="1"/>
	<!-- 세션 입력 기록: 카메라를 옮기는 입력을 담는다(고정 용량 600 프레임) -->
	<DevCommand line="bugreport.input.start 600"/>
	<!-- 에디터 카메라를 오른쪽으로 3 m 남짓(오른쪽 단추 + D) -->
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorKey key="D" state="Down"/>
	<Wait frames="42"/>
	<EditorKey key="D" state="Up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<DevCommand line="bugreport.input.stop"/>
	<DevCommand line="bugreport scenario check"/>
	<EditorWaitStable/>
	<ExpectLog id="BugReport.Saved" atLeast="1"/>
	<!-- 입력 기록이 input.swreplay 로 담겼다(info.txt 의 input_frames · scene_hash · config_hash 와 함께) -->
	<ExpectLog id="BugReport.InputSaved" atLeast="1"/>
	<!-- 다시 왼쪽으로 옮긴다(A) — 기록과 다른 자리 -->
	<EditorWaitStable/>
	<EditorClick mark="sceneView.canvas" button="1" state="Down"/>
	<EditorKey key="A" state="Down"/>
	<Wait frames="70"/>
	<EditorKey key="A" state="Up"/>
	<EditorClick mark="sceneView.canvas" button="1" state="Up"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SceneViewCameraX" atMost="1"/>
	<!-- bugreport.goto — 가장 최근 폴더의 자리로 -->
	<EditorWaitStable/>
	<DevCommand line="bugreport.goto"/>
	<EditorWaitStable/>
	<ExpectLog id="BugReport.GotoMoved" atLeast="1"/>
	<Expect watch="Editor.SceneViewCameraX" atLeast="3"/>
	<EditorWaitStable/>
	<!-- bugreport.replay — 같은 폴더의 입력을 배타 가상 입력으로 다시 붙인다(시나리오 입력을 대신하므로 마지막 단계다). 같은 빌드 · 설정이라 환경 경고가 없어야 한다 -->
	<DevCommand line="bugreport.replay"/>
	<ExpectLog id="BugReport.ReplayStarted" atLeast="1"/>
	<ExpectLog id="BugReport.ReplayEnvironmentDiffers" count="0"/>
	<Pass/>
</Scenario>
