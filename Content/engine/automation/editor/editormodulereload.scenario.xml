<?xml version="1.0" encoding="utf-8"?>
<!--
  편집기 모듈 핫 리로드: EditorModule(과 편집기 확장)을 두 번 갈아 끼우고, 그래프가 막히지 않았는지 · 묶임이 맞는지 본다. 편집기 인스턴스는 내려가며 되돌리기 기록 ·
  선택 · 복사 버퍼를 호스트의 맡김 칸에 맡기고 새 인스턴스가 되찾는다(로그 "Resumed the undo history").
  편집기를 켜야 하므로 CTest 가 줍는 폴더(engine/automation 바로 아래)가 아니라 이 하위 폴더에 둔다.
  실행: App -EnableEditor -scenario=engine/automation/editor/editormodulereload.scenario.xml -unattended
-->
<Scenario name="engine.editormodulereload" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Wait frames="60"/>
	<DevCommand line="module.reload EditorModule"/>
	<WaitUntil watch="Module.ReloadPending" equals="0" timeoutFrames="600"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<Expect watch="Module.BindingsOk" equals="1"/>
	<Expect watch="Module.ReloadCount" atLeast="1"/>
	<Wait frames="10"/>
	<DevCommand line="module.reload EditorModule"/>
	<WaitUntil watch="Module.ReloadPending" equals="0" timeoutFrames="600"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<Expect watch="Module.BindingsOk" equals="1"/>
	<Expect watch="Module.ReloadCount" atLeast="2"/>
	<Pass/>
</Scenario>
