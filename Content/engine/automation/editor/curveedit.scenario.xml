<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — FloatCurve 편집기(T1): TestParent(트랜스폼만 있어 인스펙터가 짧다 — 카메라는 렌더 출력 · 후처리 · 렌즈 칸이 늘어 커브 칸이 화면 밖으로 밀렸다)에 테스트 컴포넌트(EditorCurveTestComponent, 키 둘)를 달고, 인스펙터의 커브 미리보기
  (이름표 inspector.curve._curve)를 눌러 편집기를 연다. 빈 곳 오른쪽 클릭 → Add Key 로 키가 셋이 되고 되돌리기가 한 줄 는다.
  키 하나를 끌어 놓으면 되돌리기가 한 줄만 는다(놓을 때 한 번). 편집기를 닫고 Ctrl+Z 두 번이면 키가 다시 둘이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/curveedit.scenario.xml -unattended
-->
<Scenario name="editor.curveedit" fixedDelta="0.0166667" timeoutFrames="500" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestParent"/>
	<EditorWaitStable/>
	<DevCommand line="component.add EditorCurveTestComponent"/>
	<Variable name="gv_editorWatchProperty" value="EditorCurveTestComponent._curve"/>
	<WaitUntil watch="Editor.SelectedCurveKeyCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.curve._curve"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.curveEditor.canvas" button="1"/>
	<EditorWaitStable/>
	<EditorClick mark="inspector.curveEditor.menu.addKey"/>
	<WaitUntil watch="Editor.SelectedCurveKeyCount" equals="3" timeoutFrames="60"/>
	<Expect watch="Editor.UndoCount" equals="2"/>
	<EditorWaitStable/>
	<EditorDrag mark="inspector.curveEditor.key.0" dy="-60"/>
	<EditorWaitStable/>
	<Expect watch="Editor.SelectedCurveKeyCount" equals="3"/>
	<Expect watch="Editor.UndoCount" equals="3"/>
	<EditorWaitStable/>
	<EditorClick mark="hierarchy.row.TestParent"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<EditorWaitStable/>
	<EditorKey key="Ctrl+Z"/>
	<WaitUntil watch="Editor.SelectedCurveKeyCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Editor.UndoIndex" equals="1"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
