<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 머티리얼 미리보기(N10): Quick Open 으로 빨간 테스트 머티리얼을 열면 Material 패널의 구 미리보기 평균 (R - B) 가 크게 양수이고,
  파란 테스트 머티리얼로 바꾸면 크게 음수다 — 미리보기가 머티리얼 색을 따른다. 테스트 머티리얼은 materialpreview/ 폴더에 있다.
  미리보기는 렌더 타깃이 아니라 패널이 머티리얼 값으로 CPU 에서 셰이딩해 ImGui 그리기 목록에 그린다(MaterialPreviewShading) — 그래서 "값이 안 따라온다" 의 가능한 까닭은 둘이다.
  (1) 문서가 바뀌지 않았다(Quick Open 의 Enter 가 목록 도착 전에 눌렸거나, 미저장 확인이 새 문서를 막았다) (2) 문서는 바뀌었는데 미리보기 계산이 따라오지 않았다.
  두 까닭을 시나리오가 나눠 보도록 문서 교체를 먼저 기다린다(Editor.MaterialDocumentIsWatchAsset) — 졌을 때 어느 쪽인지 보고서의 실패 줄이 말한다.
  실행: App -EnableEditor -scenario=engine/automation/editor/materialpreview.scenario.xml -unattended (백엔드 gl 도 같다)
-->
<Scenario name="editor.materialpreview" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="10"/>
	<Variable name="gv_editorWatchAsset" value="engine/automation/editor/materialpreview/previewred.material"/>
	<Wait frames="30"/>
	<EditorKey key="Ctrl+P"/>
	<EditorText value="previewred.material"/>
	<EditorKey key="Enter"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<Wait frames="3"/>
	<Expect watch="Editor.MaterialSwitchPending" equals="0"/>
	<Wait frames="2"/>
	<WaitUntil watch="Editor.MaterialPreviewRedMinusBlue" atLeast="40"/>
	<Wait frames="8"/>
	<Variable name="gv_editorWatchAsset" value="engine/automation/editor/materialpreview/previewblue.material"/>
	<Wait frames="2"/>
	<EditorKey key="Ctrl+P"/>
	<EditorText value="previewblue.material"/>
	<EditorKey key="Enter"/>
	<Wait frames="5"/>
	<WaitUntil watch="Editor.MaterialDocumentIsWatchAsset" equals="1" timeoutFrames="600"/>
	<Wait frames="3"/>
	<Expect watch="Editor.MaterialSwitchPending" equals="0"/>
	<Wait frames="2"/>
	<WaitUntil watch="Editor.MaterialPreviewRedMinusBlue" atMost="-40"/>
	<Wait frames="10"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
