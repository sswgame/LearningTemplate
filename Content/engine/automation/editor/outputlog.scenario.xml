<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — Output Log(N5): 같은 경고 줄을 열 번 남기는 개발 명령(log.repeat)을 넣고, 검색 칸으로 그 줄만 남긴다(Info 를 꺼서 명령 메아리 줄도 숨긴다).
  접기 전에는 열 줄, Collapse 를 켜면 한 줄, Clear 를 누르면 0 줄이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/outputlog.scenario.xml -unattended
-->
<Scenario name="editor.outputlog" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<DevCommand line="panel.focus console"/>
	<EditorWaitStable/>
	<EditorClick mark="console.level.info"/>
	<EditorWaitStable/>
	<EditorClick mark="console.filter"/>
	<EditorWaitStable/>
	<EditorText value="outputlog-collapse-probe"/>
	<EditorWaitStable/>
	<DevCommand line="log.repeat 10 warning outputlog-collapse-probe"/>
	<WaitUntil watch="Editor.OutputLogVisibleRows" equals="10" timeoutFrames="60"/>
	<ExpectLog id="Console.LogRepeat" contains="outputlog-collapse-probe" atLeast="10"/>
	<EditorWaitStable/>
	<EditorClick mark="console.collapse"/>
	<WaitUntil watch="Editor.OutputLogVisibleRows" equals="1" timeoutFrames="60"/>
	<EditorWaitStable/>
	<EditorClick mark="console.clear"/>
	<WaitUntil watch="Editor.OutputLogVisibleRows" equals="0" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
