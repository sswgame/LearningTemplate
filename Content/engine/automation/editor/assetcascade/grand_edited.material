<?xml version="1.0" encoding="utf-8"?>
<!-- 연쇄 리로드 시나리오(assetcascade)의 조부모 머티리얼. grand_edited.material 이 거칠기만 다른 같은 머티리얼이다(asset.overwriteScratch 가 덮어쓴다). -->
<MaterialDesc formatVersion="0" name="CascadeGrand" shaderPath="engine/shaders/forward_lit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="_color" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="_roughness" type="Range" shaderType="Float" defaultValue="0.8" min="0.0" max="1.0" group="Surface"/>
		<item name="_metallic" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" group="Surface"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDesc>
