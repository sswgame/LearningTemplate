<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 ② 화면 — 뷰 스크린샷이 실제 그림인지, 창을 단계별로 줄여도 도크 칸이 화면 안 · 최소 변을 지키고 창이 에디터 최소 크기(960x540)에서
  멈추는지, UI 배율 1.5 에서도 같은지, 테마를 바꾸고 라이트 테마의 테마 대화상자에서 스와치를 누르면 액센트가 바뀌는지.
  스크린샷은 에디터 UI 가 아니라 주 출력 그림이다(Present 캡처가 주 출력 렌더 타깃을 복사한다). 기본 배치는 Scene 탭이 앞이라 씬 뷰 그림이다.
  실행: App -EnableEditor -scenario=engine/automation/editor/screen.scenario.xml -unattended   (CTest Scenario.editor 가 백엔드마다 돈다 — 그린 화소를 판정한다)
-->
<Scenario name="editor.screen" fixedDelta="0.0166667" timeoutFrames="900" startAfter="Immediately" input="exclusive">
	<!-- 1) 뷰 스크린샷 — 까만 빈 그림이 아니다 -->
	<Wait frames="90"/>
	<Screenshot file="gameview.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="gameview.ppm" golden="gameview"/>
	<!-- 2) 창을 단계별로 줄인다 — 마지막(640x360)은 에디터 최소 크기보다 작아 거기서 멈춰야 한다 -->
	<Wait frames="39"/>
	<ResizeWindow width="1600" height="900"/>
	<Wait frames="10"/>
	<EditorExpectDockLayout/>
	<Wait frames="5"/>
	<ResizeWindow width="1280" height="720"/>
	<Wait frames="10"/>
	<EditorExpectDockLayout/>
	<Wait frames="5"/>
	<ResizeWindow width="1024" height="600"/>
	<Wait frames="10"/>
	<EditorExpectDockLayout/>
	<Wait frames="5"/>
	<ResizeWindow width="640" height="360"/>
	<Wait frames="10"/>
	<EditorExpectDockLayout/>
	<!-- 3) UI 배율 1.5 — 큰 창에서 칸이 그대로 화면 안에 들고, 뷰가 그대로 그려진다 -->
	<Wait frames="5"/>
	<ResizeWindow width="1600" height="900"/>
	<Variable name="gv_editorUiScale" value="1.5"/>
	<Wait frames="10"/>
	<Expect watch="Editor.UIScale" near="1.5" tolerance="0.01"/>
	<EditorExpectDockLayout/>
	<Wait frames="10"/>
	<Screenshot file="gameview_scaled.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="gameview_scaled.ppm" golden="gameview_scaled"/>
	<!-- 4) 테마 — 토큰 벌을 바꾸고, 라이트에서 테마 대화상자를 열어 셋째 스와치(Neon Violet 0xA65AF2)를 누른다 -->
	<Wait frames="9"/>
	<DevCommand line="editor.theme midnight"/>
	<WaitUntil watch="Editor.ThemeName" is="midnight" timeoutFrames="60"/>
	<Wait frames="5"/>
	<DevCommand line="editor.theme light"/>
	<WaitUntil watch="Editor.ThemeName" is="light" timeoutFrames="60"/>
	<DevCommand line="editor editor.themeSettings"/>
	<Wait frames="15"/>
	<EditorClick mark="theme.swatch.violet"/>
	<WaitUntil watch="Editor.AccentColor" equals="10902002" timeoutFrames="60"/>
	<Expect watch="Editor.ThemeName" is="light"/>
	<EditorExpectDockLayout/>
	<Wait frames="5"/>
	<Screenshot file="gameview_light.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="gameview_light.ppm" golden="gameview_light"/>
	<!-- 되돌리기 — 같은 상태 폴더를 이어 쓰는 묶음이 아니어도 배율 · 테마를 기본으로 둔다 -->
	<Wait frames="9"/>
	<DevCommand line="editor.theme dark"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Wait frames="10"/>
	<Pass/>
</Scenario>
