<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 인스펙터 다중 선택 편집(I1): 테스트 씬의 카메라 둘(GameCamera · TestGameCamera)을 Ctrl+클릭으로 함께 고르고
  공통 컴포넌트 CameraComponent 의 _priority 에 5 를 치면 둘 다 5 가 되고(합 10), Ctrl+Z 한 번에 둘 다 0 으로 돌아온다.
  실행: App -EnableEditor -scenario=engine/automation/editor/multiedit.scenario.xml -unattended
-->
<Scenario name="editor.multiedit" fixedDelta="0.0166667" timeoutFrames="400" startAfter="Immediately" input="exclusive">
	<Wait frames="20"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<Wait frames="5"/>
	<DevCommand line="layout.reset"/>
	<Wait frames="25"/>
	<EditorClick mark="hierarchy.row.GameCamera"/>
	<Wait frames="10"/>
	<EditorClick mark="hierarchy.row.TestGameCamera" mods="ctrl"/>
	<Wait frames="15"/>
	<Expect watch="Editor.SelectionCount" equals="2"/>
	<Variable name="gv_editorWatchProperty" value="CameraComponent._priority"/>
	<Wait frames="5"/>
	<Expect watch="Editor.SelectedPropertySum" equals="0"/>
	<Wait frames="5"/>
	<EditorClick mark="inspector.property.CameraComponent._priority" mods="ctrl"/>
	<Wait frames="10"/>
	<EditorKey key="Ctrl+A"/>
	<Wait frames="5"/>
	<EditorText value="5"/>
	<Wait frames="5"/>
	<EditorKey key="Enter"/>
	<Wait frames="20"/>
	<Expect watch="Editor.SelectedPropertySum" equals="10"/>
	<Expect watch="Editor.UndoCount" equals="1"/>
	<Wait frames="5"/>
	<DevCommand line="editor edit.undo"/>
	<Wait frames="15"/>
	<Expect watch="Editor.SelectedPropertySum" equals="0"/>
	<Wait frames="5"/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
