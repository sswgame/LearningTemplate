<?xml version="1.0" encoding="utf-8"?>
<!--
  에디터 시나리오 — 카탈로그 연쇄 리로드: 부모 표를 바깥에서 고치면 항목 _base · 루트 _base 로 물려받은 표가 감시를 따라 다시 읽히고 적지 않은 칸의 값이 바뀐다. 적은 칸은 그대로다.
  표는 공유 캐시(GameDataCache)에 든다. 부모는 아무도 읽지 않았다 — 그래도 부모의 저장을 감시가 알려 연쇄가 돈다. 판정은 값이다(골든 없음).
  실행: App -EnableEditor -scenario=engine/automation/editor/catalogcascade.scenario.xml -unattended
-->
<Scenario name="editor.catalogcascade" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="Immediately" input="exclusive">
	<Scratch from="engine/automation/editor/catalogcascade" as="scratch/catalogcascade"/>
	<EditorWaitSettled/>
	<!-- 역색인이 사본 복사를 따라와야 부모의 참조자를 안다. 콘텐츠 브라우저를 앞에 두면 따라오기 전에는 시계가 멈춘다(ContentBrowserReferenceIndex) -->
	<DevCommand line="panel.focus content_browser"/>
	<EditorWaitSettled/>
	<WaitUntil watch="Editor.ReferenceIndexReady" equals="1" timeoutWallSeconds="60"/>
	<!-- 읽으면 공유 캐시에 든다 -->
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/entrychild.xml" key="Child" equals="3"/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/entrychild.xml" key="Fixed" equals="2"/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/filechild.xml" key="Base" equals="3"/>
	<Remember watch="Editor.AssetCascadeReloadCount" as="beforeEdit"/>
	<DevCommand line="asset.overwriteScratch scratch/catalogcascade/parent_edited.xml scratch/catalogcascade/parent.xml"/>
	<WaitUntil watch="Editor.AssetCascadeReloadCount" differsFrom="beforeEdit" timeoutWallSeconds="30"/>
	<EditorWaitSettled/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/entrychild.xml" key="Child" equals="7"/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/entrychild.xml" key="Fixed" equals="2"/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/filechild.xml" key="Base" equals="7"/>
	<Expect watch="Interaction.MaxDistance" target="scratch/catalogcascade/filechild.xml" key="Extra" equals="1"/>
	<ExpectLog id="AssetHotReload.CascadeReload" contains="scratch/catalogcascade/entrychild.xml (inlines scratch/catalogcascade/parent.xml)" count="1"/>
	<ExpectLog id="AssetHotReload.CascadeReload" contains="scratch/catalogcascade/filechild.xml (inlines scratch/catalogcascade/parent.xml)" count="1"/>
	<Pass/>
</Scenario>
