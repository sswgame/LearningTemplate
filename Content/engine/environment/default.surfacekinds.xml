<!--
	표면 종류 표 — SurfaceKindTable 이 읽는다(엔진 기본 에셋 표 _surfaceKinds). 종류 이름은 물리 재질 이름(physicssettings.xml _listMaterial)과 같고,
	모든 물리 재질이 여기에 종류를 가져야 한다(테스트 SurfaceKindTest.ShippedTableCoversPhysicsMaterials). 물 속에 선 발은 _waterKind 를 낸다(SurfaceQuery).
	_footstep 은 발소리 경로의 {surface} 자리, _moveScale 은 걷는 속도 배율(물리 마찰이 아니다), _footprintPrefab 이 있는 종류만 발자국을 남기고
	_footprintCapacity 개를 넘으면 가장 오래된 것을 다시 쓴다(씬마다 고정 용량 — 발걸음마다 높이장이나 충돌을 고치지 않는다).
-->
<SurfaceKindTable _waterKind="Water" _footprintCapacity="96">
	<_listKind>
		<SurfaceKindDef _name="Default" _footstep="default" />
		<SurfaceKindDef _name="Stone" _footstep="stone" />
		<SurfaceKindDef _name="Wood" _footstep="wood" />
		<SurfaceKindDef _name="Metal" _footstep="metal" />
		<SurfaceKindDef _name="Ice" _footstep="ice" />
		<SurfaceKindDef _name="Rubber" _footstep="rubber" />
		<SurfaceKindDef _name="Flesh" _footstep="flesh" />
		<SurfaceKindDef _name="Snow" _footstep="snow" _moveScale="0.8" _footprintPrefab="engine/prefabs/surface/footprint_snow.prefab.xml" _footprintLifetime="30" />
		<SurfaceKindDef _name="Sand" _footstep="sand" _moveScale="0.85" />
		<SurfaceKindDef _name="Mud" _footstep="mud" _moveScale="0.7" />
		<SurfaceKindDef _name="Water" _footstep="water" _moveScale="0.6" />
	</_listKind>
</SurfaceKindTable>
