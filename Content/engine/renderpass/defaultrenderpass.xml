<?asset guid="57bd09488b11feda78cbced691b416fe"?>
<!-- 장면 깊이와 그림자 맵 둘(방향광 · 점광 스폿) — 파이프라인이 `_listRenderPassRef` 로 가져오는 첨부 묶음이다. 여기를 고치면 가져오는 모든 파이프라인의 첨부가 바뀐다. -->
<RenderPassDesc _name="DefaultMainPass">
	<_listAttachment>
		<RenderPassAttachment _name="SceneDepth" _format="D24_UNORM_S8_UINT" _clearDepth="1" _loadOp="Clear" />
		<!-- 그림자 첨부는 역할을 적는다 — 그림자 패스가 그릴 타일(방향광 캐스케이드 · 점광 스폿)과 아틀라스 크기를 이름이 아니라 이 칸이 정한다. -->
		<RenderPassAttachment _name="ShadowMap" _format="D24_UNORM_S8_UINT" _clearDepth="1" _loadOp="Clear" _role="ShadowMap" />
		<!-- 점광 · 스폿 그림자 아틀라스 — 방향광 ShadowMap 과 다른 텍스처다(유니티 URP 주광 · 추가 광 아틀라스 분리, 감사 RN-4). 한 변은 ShadowMap 과 같다. -->
		<RenderPassAttachment _name="LocalShadowMap" _format="D24_UNORM_S8_UINT" _clearDepth="1" _loadOp="Clear" _role="LocalShadowMap" />
	</_listAttachment>
</RenderPassDesc>
