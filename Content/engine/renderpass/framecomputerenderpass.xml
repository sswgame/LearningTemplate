<!--
	프레임 패스 한 벌 — 포워드 · 디퍼드 파이프라인이 `_listRenderPassRef` 로 가져온다(셰이딩 방식과 무관한 일이라 한 벌을 나눈다).
	프레임에 한 번, 뷰 그래프(`_listPass`)보다 먼저 돌며 이번 프레임에 그리는 모든 뷰의 몫을 기록한다(FrameGraphExecutor).
	순서는 아래 자원 이름의 읽기 · 쓰기가 정한다 — 뷰 그래프와 같은 규칙(같은 자원을 쓰는 패스는 선언 순서, 읽는 패스는 앞선 쓰기 뒤).
	  · 애니메이션 · 모프 · 스킨이 컬링보다 앞이다(컬링이 이번 프레임 바운드로 판정한다) — InstanceBuffer · DeformVertices 를 쓰고 컬링이 읽는다.
	  · 입자가 인스턴스 칸(메시 입자)과 라이트 버퍼 GPU 구간(입자 라이트)을 쓰므로 애니메이션 · 라이트 그리드보다 앞이다.
	선언하지 않은 종류는 PSO 도 없고 돌지 않는다. 셰이더는 패스 종류의 표가 정한다(셰이더 칸은 비워 둔다 — 검증).
	`_queue="AsyncCompute"` 는 비동기 컴퓨트 큐 후보다(가림 타일 · 입자 · 라이트 그리드 · 프로브). DX12 · 큐가 둘인 Vulkan 장치는 컴퓨트 큐에서 그래픽스와 겹쳐 돌고,
	DX11 · GL · WebGPU 는 그래픽스 큐에서 같은 순서로 돈다(능력 `_bAsyncCompute`). 끄고 켠 비교는 `-gv_asyncCompute=0`. 이득이 없으면 이 속성 한 줄을 지운다.
-->
<RenderPassDesc _name="FrameComputePass">
	<_listResource>
		<!-- 뷰마다 지난 프레임의 장면 깊이 — 뷰 그래프가 쓰고 프레임 사이에 남은 첨부다(이번 프레임 뷰 그래프 전에 읽는다). -->
		<RenderGraphResourceDesc _name="PreviousSceneDepth" _kind="External" />
		<RenderGraphResourceDesc _name="DepthHistory" _kind="Persistent" />
		<RenderGraphResourceDesc _name="OcclusionTiles" _kind="Persistent" />
		<RenderGraphResourceDesc _name="ParticleState" _kind="Persistent" />
		<RenderGraphResourceDesc _name="InstanceBuffer" _kind="External" />
		<RenderGraphResourceDesc _name="LightBuffer" _kind="External" />
		<RenderGraphResourceDesc _name="DeformVertices" _kind="External" />
		<RenderGraphResourceDesc _name="CullResults" _kind="External" />
		<RenderGraphResourceDesc _name="LightGrid" _kind="External" />
		<RenderGraphResourceDesc _name="VolumetricFogVolume" _kind="External" />
		<RenderGraphResourceDesc _name="ProbeIrradiance" _kind="Persistent" />
		<RenderGraphResourceDesc _name="CanvasMarkers" _kind="External" />
	</_listResource>
	<_listFramePass>
		<!-- 지난 장면 깊이를 R32 실수 히스토리로 옮기는 풀스크린(depth_history.hlsl). 그래픽스 드로우라 그래픽스 큐다. -->
		<RenderGraphPassDesc _name="DepthHistory" _type="DepthHistory" _cullMode="None">
			<_listInput>
				<item>PreviousSceneDepth</item>
			</_listInput>
			<_listOutput>
				<item>DepthHistory</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<!-- 깊이 히스토리 → 16 px 타일마다 최대 깊이(occlusion_tiles.hlsl). 컬링이 읽고, 주 시점 타일은 게임 스레드가 몇 프레임 늦게 되읽는다. -->
		<RenderGraphPassDesc _name="OcclusionTiles" _type="OcclusionTiles" _cullMode="None" _queue="AsyncCompute">
			<_listInput>
				<item>DepthHistory</item>
			</_listInput>
			<_listOutput>
				<item>OcclusionTiles</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<!-- GPU 방출기의 입자 시뮬레이션(vfx_simulate.hlsl) + 메시 입자의 인스턴스 칸 쓰기(vfx_mesh_instance.hlsl). 깊이 충돌은 주 시점 깊이 히스토리를 읽는다. -->
		<RenderGraphPassDesc _name="ParticleSimulation" _type="VFXSimulation" _cullMode="None" _queue="AsyncCompute">
			<_listInput>
				<item>DepthHistory</item>
			</_listInput>
			<_listOutput>
				<item>ParticleState</item>
				<item>InstanceBuffer</item>
				<item>LightBuffer</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="InstanceAnimation" _type="InstanceAnimation" _cullMode="None">
			<_listOutput>
				<item>InstanceBuffer</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="MeshMorph" _type="MeshMorph" _cullMode="None">
			<_listOutput>
				<item>DeformVertices</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="MeshSkin" _type="MeshSkin" _cullMode="None">
			<_listOutput>
				<item>DeformVertices</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<!-- 뷰마다(주 시점 · 그림자 · 캐스케이드 · 추가 뷰) 컬링하고 투명 목록을 정렬한다(gpu_cull.hlsl + instance_sort.hlsl). 뷰 그래프의 간접 드로우가 결과를 읽는다. -->
		<RenderGraphPassDesc _name="GPUCull" _type="GPUCull" _cullMode="None">
			<_listInput>
				<item>InstanceBuffer</item>
				<item>DeformVertices</item>
				<item>OcclusionTiles</item>
			</_listInput>
			<_listOutput>
				<item>CullResults</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<!-- 뷰마다의 클러스터드 라이트 그리드(light_grid.hlsl). 뷰 그래프의 조명 패스(포워드 · 디퍼드 · 투명)가 읽는다. -->
		<RenderGraphPassDesc _name="LightGrid" _type="LightGrid" _cullMode="None" _queue="AsyncCompute">
			<_listInput>
				<item>LightBuffer</item>
			</_listInput>
			<_listOutput>
				<item>LightGrid</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="VolumetricFog" _type="VolumetricFog" _cullMode="None">
			<_listInput>
				<item>LightBuffer</item>
				<item>LightGrid</item>
			</_listInput>
			<_listOutput>
				<item>VolumetricFogVolume</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="ProbeUpdate" _type="ProbeUpdate" _cullMode="None" _queue="AsyncCompute">
			<_listInput>
				<item>LightBuffer</item>
				<item>LightGrid</item>
			</_listInput>
			<_listOutput>
				<item>ProbeIrradiance</item>
			</_listOutput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="CanvasMarker" _type="CanvasMarker" _cullMode="None">
			<_listInput>
				<item>InstanceBuffer</item>
			</_listInput>
			<_listOutput>
				<item>CanvasMarkers</item>
			</_listOutput>
		</RenderGraphPassDesc>
	</_listFramePass>
</RenderPassDesc>
