<!--
	내비게이션 표 — 에이전트 종류(종류마다 내비메시를 따로 베이크한다) · 영역(순서가 번호 0..15, 0 은 보통 땅) · 군중 · 재베이크 예산.
	코드는 이름으로만 고른다(NavMeshSettings::findAgentType · findAreaIndex). 모르는 이름 · 겹친 이름 · 범위 밖 값은 읽을 때 오류다.
	베이크 값(반지름 · 높이 · 계단 · 경사 · 셀 · 타일 · 영역 크기 · 디테일)이 바뀌면 쿠킹한 .navmesh 가 낡아 런타임이 다시 베이크한다.
	영역 비용은 1 이상이다(경로 찾기의 거리 추정이 1 을 가정한다 — 1 보다 싼 영역은 최단 경로를 놓친다).
	Humanoid 군중은 목표 규모(에이전트 1 천 — 부하 시나리오 load/navcrowd)를 담는다. 군중 칸 수는 베이크 값이 아니라 쿠킹본을 낡게 하지 않는다.
	Lava 의 비용 · 통행은 지역 프로필의 내비 비용 모듈(NavArea)이 에이전트 종류마다 정한다 — Humanoid 는 막고 Spirit(화염 정령, 몸 크기는 Humanoid 와 같다)은 지난다.
-->
<NavMeshSettings _defaultAgentType="Humanoid" _maxConcurrentTileBakeCount="4" _obstacleMoveThreshold="0.25">
	<_listAgentType>
		<NavAgentTypeDef _name="Humanoid"
		                 _radius="0.4"
		                 _height="1.9"
		                 _maxClimb="0.45"
		                 _maxSlope="0.785398"
		                 _cellSize="0.2"
		                 _cellHeight="0.1"
		                 _tileSize="48"
		                 _minRegionSize="4"
		                 _mergeRegionSize="16"
		                 _maxEdgeLength="12"
		                 _maxEdgeError="1.3"
		                 _detailSampleDistance="6"
		                 _detailSampleMaxError="1"
		                 _maxCrowdAgentCount="1024" />
		<NavAgentTypeDef _name="Spirit"
		                 _radius="0.4"
		                 _height="1.9"
		                 _maxClimb="0.45"
		                 _maxSlope="0.785398"
		                 _cellSize="0.2"
		                 _cellHeight="0.1"
		                 _tileSize="48"
		                 _minRegionSize="4"
		                 _mergeRegionSize="16"
		                 _maxEdgeLength="12"
		                 _maxEdgeError="1.3"
		                 _detailSampleDistance="6"
		                 _detailSampleMaxError="1"
		                 _maxCrowdAgentCount="64" />
		<NavAgentTypeDef _name="Large"
		                 _radius="1.2"
		                 _height="3"
		                 _maxClimb="0.6"
		                 _maxSlope="0.610865"
		                 _cellSize="0.3"
		                 _cellHeight="0.15"
		                 _tileSize="48"
		                 _minRegionSize="4"
		                 _mergeRegionSize="16"
		                 _maxEdgeLength="12"
		                 _maxEdgeError="1.3"
		                 _detailSampleDistance="6"
		                 _detailSampleMaxError="1"
		                 _maxCrowdAgentCount="64" />
	</_listAgentType>
	<_listArea>
		<NavAreaDef _name="Default" _cost="1" />
		<NavAreaDef _name="Grass" _cost="1.5" />
		<NavAreaDef _name="Mud" _cost="4" />
		<NavAreaDef _name="Water" _cost="10" />
		<NavAreaDef _name="Lava" _cost="1" />
	</_listArea>
</NavMeshSettings>
