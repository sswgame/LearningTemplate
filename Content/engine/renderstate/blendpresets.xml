<!--
	블렌드 프리셋 — 파이프라인 XML 의 _blendPreset 과 머티리얼 XML 의 blendPreset 이 이름으로 고른다. 코드 없이 이 파일에 줄을 더하면 새 프리셋이다.
	칸: `BlendTargetState`. 계수를 적지 않으면 기본값(One · Zero · Add, 쓰기 RGBA, 블렌드 꺼짐)이다.
	Transparent · Premultiplied 는 코드가 짓는 PSO 의 값(BlendTargetState::makeStraightAlpha · makePremultipliedAlpha)과 같아야 한다 — TestRenderState 가 대조한다.
-->
<RenderBlendPresetTable>
	<_listPreset>
		<RenderBlendPreset _name="Opaque" />
		<!-- 곧은 알파: 셰이더가 알파를 곱하지 않은 색을 낸다. 언리얼 BLEND_Translucent, 유니티 Blend SrcAlpha OneMinusSrcAlpha. 알파 채널은 합성이 다시 읽을 수 있게 One / InvSrcAlpha 다. -->
		<RenderBlendPreset _name="Transparent" _bEnableBlend="true" _srcColor="SrcAlpha" _dstColor="InvSrcAlpha" _srcAlpha="One" _dstAlpha="InvSrcAlpha" />
		<!-- 프리멀티플라이: 셰이더가 알파를 곱한 색을 낸다. UI · 캔버스 · 안개. 언리얼 BF_One BF_InverseSourceAlpha, 유니티 Blend One OneMinusSrcAlpha. -->
		<RenderBlendPreset _name="Premultiplied" _bEnableBlend="true" _srcColor="One" _dstColor="InvSrcAlpha" _srcAlpha="One" _dstAlpha="InvSrcAlpha" />
		<!-- 가산: 유니티 Blend SrcAlpha One 과 같다(알파로 세기를 조절한다). 대상 알파는 그대로 둔다. -->
		<RenderBlendPreset _name="Additive" _bEnableBlend="true" _srcColor="SrcAlpha" _dstColor="One" _srcAlpha="Zero" _dstAlpha="One" />
		<!-- 곱: 유니티 Blend DstColor Zero 와 같다. 대상 알파는 그대로 둔다. -->
		<RenderBlendPreset _name="Multiply" _bEnableBlend="true" _srcColor="DstColor" _dstColor="Zero" _srcAlpha="Zero" _dstAlpha="One" />
	</_listPreset>
</RenderBlendPresetTable>
