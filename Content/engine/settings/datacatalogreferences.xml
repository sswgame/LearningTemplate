		<Reference owner="Event" attribute="archetypes" target="Archetype"/>
		<Reference owner="Event" attribute="npcs" target="NPC"/>
		<Reference owner="NPC/Routine/Block" attribute="place" target="Place"/>
		<Reference owner="NPC/Routine/Block" attribute="appointment" target="Appointment"/>
		<Reference owner="Archetype/Routine/Block" attribute="place" target="Place"/>
		<Reference owner="Archetype/Routine/Block" attribute="appointment" target="Appointment"/>
		<Reference owner="Event/Block" attribute="place" target="Place"/>
