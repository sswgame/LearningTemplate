	<!-- 적 패턴의 시작 · 이어지는 상태는 같은 패턴 안의 상태다. 한 패턴 안의 같은 상태 id 는 읽는 코드(ActionPlatformerCatalog::loadPattern)가 본다 — 패턴마다 이름 공간이 따로라 <Unique> 로 적을 수 없다. -->
	<Catalog root="ActionPlatformer">
		<Reference owner="Pattern" attribute="start" target="State" inEntry="true"/>
		<Reference owner="Pattern/State" attribute="next" target="State" inEntry="true"/>
		<Reference owner="Pattern/State" attribute="onNear" target="State" inEntry="true"/>
		<Reference owner="Pattern/State" attribute="onHit" target="State" inEntry="true"/>
	</Catalog>
	<!-- 격투 캐릭터의 기술은 루트 moves 가 가리키는 기술 카탈로그(MoveCatalog)의 프레임 데이터다 — frames 를 적지 않으면 자기 id. -->
