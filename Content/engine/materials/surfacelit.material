<?xml version="1.0" encoding="utf-8"?>
<!-- 몸 표면 상태 머티리얼(surface_lit.hlsl) — forward_lit 의 PBR 에 젖음 · 흙 · 피 · 상처 · 찢김을 얹는다. _surface* 프로퍼티는 외형 컴포넌트의 CharacterSurfaceBinding 이 인스턴스에 올리는 이름과 같다
     (_surface<채널> 스칼라 · _surface<채널>Mask 마스크 — CharacterSurfaceBinding.h). 채널 이름은 engine/character/default.surfacechannels.xml 의 Wet · Dirt · Blood · Wound · Tear 다.
     MATERIAL_ALPHA_CUTOFF 는 찢김(Tear) 구멍을 내려고 늘 켠다. 마스크 텍스처는 R 채널만 읽으므로 sRGB 가 아니다. -->
<MaterialDesc formatVersion="0" name="SurfaceLit" shaderPath="engine/shaders/surface_lit.hlsl" blendMode="Opaque">
	<_properties>
		<item name="_color" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="_roughness" type="Range" shaderType="Float" defaultValue="0.5" min="0.0" max="1.0" group="Surface"/>
		<item name="_metallic" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" group="Surface"/>
		<item name="_albedoMap" type="Texture2D" displayName="Albedo" group="Surface" bSrgb="1"/>
		<item name="_surfaceWet" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Wet" group="Surface State"/>
		<item name="_surfaceDirt" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Dirt" group="Surface State"/>
		<item name="_surfaceBlood" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Blood" group="Surface State"/>
		<item name="_surfaceWound" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Wound" group="Surface State"/>
		<item name="_surfaceTear" type="Range" shaderType="Float" defaultValue="0.0" min="0.0" max="1.0" displayName="Tear" group="Surface State"/>
		<item name="_surfaceDirtMask" type="Texture2D" displayName="Dirt Mask" group="Surface State" bSrgb="0"/>
		<item name="_surfaceBloodMask" type="Texture2D" displayName="Blood Mask" group="Surface State" bSrgb="0"/>
		<item name="_surfaceWoundMask" type="Texture2D" displayName="Wound Mask" group="Surface State" bSrgb="0"/>
		<item name="_surfaceTearMask" type="Texture2D" displayName="Tear Mask" group="Surface State" bSrgb="0"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_ALPHA_CUTOFF</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
