<?xml version="1.0" encoding="utf-8"?>
<MaterialDef formatVersion="0" name="Sprite2D" shaderPath="engine/shaders/sprite_2d.hlsl" alphaMode="Blend">
	<_properties>
		<item name="_color" type="Color" defaultValue="1.0 1.0 1.0 1.0" displayName="Tint Color" group="Sprite"/>
		<item name="_uvRect" type="Vector4" defaultValue="0.0 0.0 1.0 1.0" displayName="UV Rect" group="Sprite"/>
		<item name="_albedoMap" type="Texture2D" displayName="Sprite Texture" group="Sprite"/>
		<item name="_pointFilter" type="Bool" defaultValue="0" displayName="Point Filter (pixel art)" group="Sprite"/>
		<item name="_premultipliedTexture" type="Bool" defaultValue="0" displayName="Premultiplied Texture (world UI render target)" group="Sprite"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_BLEND_TRANSLUCENT</item>
			<item>MATERIAL_VERTEX_DEFORM</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
