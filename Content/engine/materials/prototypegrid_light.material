<?asset guid="8c9750760f544d393d0405c50debad00"?>
<!-- 블록아웃용 격자 머티리얼(언리얼 WorldGridMaterial 에 해당). MATERIAL_WORLD_UV 로 월드 좌표에서 읽어 메시 크기와 상관없이 한 칸이 1 m 다(forward_lit.hlsl 트라이플래너). -->
<MaterialDef formatVersion="0" name="PrototypeGridLight" _base="guid:0e23c2ee4018be638b51655cf03239d2">
	<_properties>
		<item name="_roughness" defaultValue="0.8" />
		<item name="_albedoMap" assetPath="guid:3ef33cfa2122b8bed4be86682dbed8b2" />
	</_properties>
	<_permutations>
		<_alwaysDefines>
			<item>MATERIAL_WORLD_UV</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
