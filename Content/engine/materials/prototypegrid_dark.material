<!-- 블록아웃용 격자 머티리얼(언리얼 WorldGridMaterial 에 해당). MATERIAL_WORLD_UV 로 월드 좌표에서 읽어 메시 크기와 상관없이 한 칸이 1 m 다(forward_lit.hlsl 트라이플래너). -->
<MaterialDef formatVersion="0" name="PrototypeGridDark" _base="guid:0e23c2ee4018be638b51655cf03239d2">
	<_properties>
		<item name="_roughness" defaultValue="0.8" />
		<item name="_albedoMap" assetPath="guid:4b84344e72f162199c17c32c1fc51dbe" />
	</_properties>
	<_permutations>
		<_alwaysDefines>
			<item>MATERIAL_WORLD_UV</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
