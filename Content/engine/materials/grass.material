<?xml version="1.0" encoding="utf-8"?>
<!-- 식생(FoliageComponent) 풀 — 그림자를 드리우지 않는다(수만 포기의 흔들리지 않는 그림자는 비용만 크고 틀린 그림이다).
     바람 · 카메라 · 휘게 하는 구 · 페이드는 컴포넌트가 틱마다 인스턴스에 싣는다. 프로퍼티 이름 · 타입은 foliage.hlsl 의 SW_MATERIAL 구조체와 같다.
     MATERIAL_VERTEX_DEFORM 은 깊이 프리패스에서 빠지게 한다(shadow_depth.hlsl) — 흔들린 정점이 프리패스 깊이와 어긋나지 않게. -->
<MaterialDesc formatVersion="0" name="Grass" _base="engine/materials/foliage.material">
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_VERTEX_DEFORM</item>
			<item>MATERIAL_SHADOW_CAST_OFF</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDesc>
