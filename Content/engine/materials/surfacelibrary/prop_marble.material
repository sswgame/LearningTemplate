<?xml version="1.0" encoding="utf-8"?>
<?asset guid="46374bdd8e0b4cde5daa31d0d1e8bde2"?>
<!-- 대리석 — 노이즈로 휜 결, 연마 코트. 부모(environmentsurface.material)의 값을 바꾸고 Clear Coat 셰이딩 모델(MATERIAL_LOBE_COAT)을 고른 프리셋이다. -->
<MaterialDef formatVersion="0" name="Marble" _base="guid:2de2ddc37fa7786ba07716ca4e1c5ded">
	<_properties>
		<item name="_baseColor" defaultValue="0.92 0.91 0.88 1"/>
		<item name="_roughness" defaultValue="0.12"/>
		<item name="_secondaryColor" defaultValue="0.25 0.25 0.27 1"/>
		<item name="_secondaryRoughness" defaultValue="0.15"/>
		<item name="_patternScale" defaultValue="0.4 8 0 0"/>
		<item name="_patternShape" defaultValue="3 0 0 1"/>
		<item name="_clearCoat" defaultValue="0.6"/>
		<item name="_porosity" defaultValue="0.1"/>
	</_properties>
	<_permutations>
		<_alwaysDefines>
			<item>MATERIAL_LOBE_COAT</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
