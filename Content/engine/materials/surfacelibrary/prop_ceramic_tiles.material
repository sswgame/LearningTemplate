<?xml version="1.0" encoding="utf-8"?>
<!-- 세라믹 타일 — 20 cm 정사각 타일(줄 어긋남 0), 유약 코트, 거친 줄눈. 부모(environmentsurface.material)의 값만 바꾼 프리셋이다. -->
<MaterialDef formatVersion="0" name="CeramicTiles" _base="engine/materials/environmentsurface.material">
	<_properties>
		<item name="_baseColor" defaultValue="0.90 0.90 0.88 1"/>
		<item name="_roughness" defaultValue="0.12"/>
		<item name="_secondaryColor" defaultValue="0.55 0.53 0.50 1"/>
		<item name="_secondaryRoughness" defaultValue="0.9"/>
		<item name="_patternScale" defaultValue="0.2 0.2 0.008 0"/>
		<item name="_patternShape" defaultValue="1 0.03 0.002 1"/>
		<item name="_clearCoat" defaultValue="0.5"/>
		<item name="_porosity" defaultValue="0.1"/>
	</_properties>
</MaterialDef>
