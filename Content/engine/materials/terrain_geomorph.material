<?xml version="1.0" encoding="utf-8"?>
<!-- 지형(TerrainComponent) 지오모프판 - terrain.material 과 같되 MATERIAL_VERTEX_DEFORM 을 가져 정점 셰이더가 LOD 교체 때의 튐을 거친 LOD 높이로 섞어 없앤다(terrain.hlsl 의 computeWorldPositionOffset). 깊이 프리패스에서 빠지고 그림자는 지오모프 없이 그려진다(FrameRendererUtil::drawsDepthWithMaterialShader). 컴포넌트가 지오모프를 켜면 이 머티리얼을 쓴다(TerrainComponent::_bGeomorph). 레이어 색 · 디테일 · 3 축 투영 · 스플랫 · 디테일 맵은 컴포넌트가 인스턴스에 싣는다 — 여기 값은 기본값이다.
     프로퍼티 이름 · 타입은 terrain.hlsl 의 SW_MATERIAL 구조체와 같다. -->
<MaterialDesc formatVersion="0" name="TerrainGeomorph" shaderPath="engine/shaders/terrain.hlsl" blendMode="Opaque">
	<_properties>
		<item name="_layer0Color" type="Vector4" shaderType="Float4" defaultValue="0.30 0.45 0.18 1.0" displayName="Layer 0 Color" group="Layers"/>
		<item name="_layer1Color" type="Vector4" shaderType="Float4" defaultValue="0.42 0.33 0.22 1.0" displayName="Layer 1 Color" group="Layers"/>
		<item name="_layer2Color" type="Vector4" shaderType="Float4" defaultValue="0.45 0.44 0.42 1.0" displayName="Layer 2 Color" group="Layers"/>
		<item name="_layer3Color" type="Vector4" shaderType="Float4" defaultValue="0.76 0.70 0.52 1.0" displayName="Layer 3 Color" group="Layers"/>
		<item name="_layer4Color" type="Vector4" shaderType="Float4" defaultValue="0.55 0.55 0.58 1.0" displayName="Layer 4 Color" group="Layers"/>
		<item name="_layer5Color" type="Vector4" shaderType="Float4" defaultValue="0.30 0.22 0.15 1.0" displayName="Layer 5 Color" group="Layers"/>
		<item name="_layer6Color" type="Vector4" shaderType="Float4" defaultValue="0.85 0.88 0.92 1.0" displayName="Layer 6 Color" group="Layers"/>
		<item name="_layer7Color" type="Vector4" shaderType="Float4" defaultValue="0.20 0.30 0.14 1.0" displayName="Layer 7 Color" group="Layers"/>
		<item name="_layerDetail" type="Vector4" shaderType="Float4" defaultValue="0.5 0.5 0.5 0.5" displayName="Layer Detail Strength" group="Layers"/>
		<item name="_layerTriplanar" type="Vector4" shaderType="Float4" defaultValue="0.0 0.0 1.0 0.0" displayName="Layer Triplanar" group="Layers"/>
		<item name="_layerDetail1" type="Vector4" shaderType="Float4" defaultValue="0.5 0.5 0.5 0.5" displayName="Layer 4-7 Detail Strength" group="Layers"/>
		<item name="_layerTriplanar1" type="Vector4" shaderType="Float4" defaultValue="0.0 0.0 0.0 0.0" displayName="Layer 4-7 Triplanar" group="Layers"/>
		<item name="_terrainParams" type="Vector4" shaderType="Float4" defaultValue="0.0 0.25 0.7 -1.0" displayName="Splat Width, Detail Tiling, Cliff Start, Cliff Layer" group="Terrain"/>
		<item name="_splatMap" type="Texture2D" displayName="Splat Map (layers 0-3)" group="Terrain" bSrgb="0"/>
		<item name="_splatMap1" type="Texture2D" displayName="Splat Map (layers 4-7)" group="Terrain" bSrgb="0"/>
		<item name="_detailMap" type="Texture2D" displayName="Detail Map" group="Terrain" bSrgb="0"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_VERTEX_DEFORM</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDesc>
