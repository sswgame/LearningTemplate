<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(lace): 검은 망사(꽃 없이). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="FishnetBlack" _base="engine/materials/library/lace/base.material">
	<_properties>
		<item name="_color" defaultValue="0.03 0.03 0.03 1" />
		<item name="_patternAmount" defaultValue="0" />
		<item name="_patternScale" defaultValue="16" />
		<item name="_patternWidth" defaultValue="0.06" />
	</_properties>
</MaterialDef>
