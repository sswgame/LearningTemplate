<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 머티리얼 라이브러리의 뿌리(appearance_lit.hlsl) — 프로퍼티 이름 · 순서 · 형식은 셰이더의 SW_MATERIAL 구조체와 1:1 이다. 엽 · 무늬가 없는 PBR + 코트(기름 · 젖음) 바탕이다.
     갈래 바탕(<갈래>/base.material)이 _permutations 를 통째로 바꿔 엽 · 무늬 define 을 고르고, 프리셋은 _base 로 값만 바꾼다(같은 셰이더 변형 · PSO).
     칸의 뜻은 appearance_lit.hlsl · appearance_pattern.hlsli · appearance_eye.hlsli · appearance_fur.hlsli 머리말, 고른 까닭은 appearance_lit.hlsl 머리말의 결정 표. -->
<MaterialDef formatVersion="0" name="Appearance" shaderPath="engine/shaders/appearance_lit.hlsl" alphaMode="Opaque">
	<_properties>
		<item name="_color" type="Color" defaultValue="0.8 0.8 0.8 1" displayName="Base Color" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="_secondaryColor" type="Color" defaultValue="0.3 0.3 0.3 1" displayName="Secondary Color" group="Pattern" bHdr="0" bSrgb="1"/>
		<item name="_layerColor" type="Color" defaultValue="0.5 0.5 0.5 1" displayName="Layer Color (paint, rust, underlayer, iris)" group="Pattern" bHdr="0" bSrgb="1"/>
		<item name="_sheenColor" type="Color" defaultValue="0 0 0 1" displayName="Sheen Color" group="Cloth" bHdr="0" bSrgb="1"/>
		<item name="_subsurfaceColor" type="Color" defaultValue="1 0.4 0.25 1" displayName="Subsurface / Transmission Color" group="Subsurface" bHdr="0" bSrgb="1"/>
		<item name="_glowColor" type="Color" defaultValue="0 0 0 1" displayName="Eye Shine Color" group="Eye" bHdr="1" bSrgb="1"/>
		<item name="_roughness" type="Range" defaultValue="0.5" min="0.0" max="1.0" group="Surface"/>
		<item name="_metallic" type="Range" defaultValue="0" min="0.0" max="1.0" group="Surface"/>
		<item name="_specular" type="Range" defaultValue="0.5" min="0.0" max="1.0" displayName="Specular (0.5 = F0 0.04)" group="Surface"/>
		<item name="_normalScale" type="Range" defaultValue="1" min="0.0" max="2.0" group="Surface"/>
		<item name="_coatWeight" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Coat / Oil Weight" group="Coat"/>
		<item name="_coatRoughness" type="Range" defaultValue="0.1" min="0.0" max="1.0" displayName="Coat Roughness" group="Coat"/>
		<item name="_sheenRoughness" type="Range" defaultValue="0.5" min="0.0" max="1.0" group="Cloth"/>
		<item name="_sheenWeight" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Cloth (GGX to Sheen)" group="Cloth"/>
		<item name="_subsurfaceRadius" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Wrap (light bleed into shade)" group="Subsurface"/>
		<item name="_transmission" type="Range" defaultValue="0" min="0.0" max="2.0" displayName="Back Light Transmission" group="Subsurface"/>
		<item name="_anisotropy" type="Range" defaultValue="0" min="-1.0" max="1.0" group="Surface"/>
		<item name="_strandShift" type="Range" defaultValue="0" min="-0.2" max="0.2" displayName="Fur Cuticle Shift (rad)" group="Fur"/>
		<item name="_filmThickness" type="Range" defaultValue="0" min="0.0" max="1200.0" displayName="Thin Film Thickness (nm)" group="Thin Film"/>
		<item name="_filmIor" type="Range" defaultValue="1.33" min="1.0" max="2.5" displayName="Thin Film IOR" group="Thin Film"/>
		<item name="_filmWeight" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Thin Film Weight" group="Thin Film"/>
		<item name="_ior" type="Range" defaultValue="1.5" min="1.0" max="2.5" displayName="IOR (glass, cornea, film base)" group="Refraction"/>
		<item name="_thickness" type="Range" defaultValue="0" min="0.0" max="0.2" displayName="Glass Thickness (m, 0 = thin)" group="Refraction"/>
		<item name="_refractionBlur" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Frosted Blur" group="Refraction"/>
		<item name="_patternScale" type="Range" defaultValue="8" min="0.0" max="512.0" displayName="Pattern Scale (cells per UV)" group="Pattern"/>
		<item name="_patternWidth" type="Range" defaultValue="0.05" min="0.0" max="0.5" displayName="Pattern Line Half Width" group="Pattern"/>
		<item name="_patternAmount" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Pattern Amount" group="Pattern"/>
		<item name="_layerRoughness" type="Range" defaultValue="0.5" min="0.0" max="1.0" displayName="Layer Roughness" group="Pattern"/>
		<item name="_alphaCutoff" type="Range" defaultValue="0.5" min="0.0" max="1.0" displayName="Alpha Cutoff" group="Surface"/>
		<item name="_wetness" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Wetness (gates Wet Mask)" group="Wet"/>
		<item name="_residue" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Dried Residue (gates Residue Mask)" group="Wet"/>
		<item name="_wetMeniscus" type="Range" defaultValue="0" min="0.0" max="1.0" displayName="Wet Edge / Tear Line Highlight" group="Wet"/>
		<item name="_pupilShape" type="Range" defaultValue="0" min="0.0" max="3.0" displayName="Pupil Shape (0 round, 1 slit, 2 bar, 3 W)" group="Eye"/>
		<item name="_pupilMinRadius" type="Range" defaultValue="0.2" min="0.0" max="1.0" displayName="Pupil Size Constricted" group="Eye"/>
		<item name="_pupilMaxRadius" type="Range" defaultValue="0.6" min="0.0" max="1.0" displayName="Pupil Size Dilated" group="Eye"/>
		<item name="_irisRadius" type="Range" defaultValue="0.45" min="0.05" max="1.0" displayName="Iris Radius" group="Eye"/>
		<item name="_corneaHeight" type="Range" defaultValue="0.12" min="0.0" max="0.5" displayName="Cornea Height (iris depth)" group="Eye"/>
		<item name="_limbalWidth" type="Range" defaultValue="0.08" min="0.0" max="0.5" displayName="Limbal Ring Width" group="Eye"/>
		<item name="_tearLineHeight" type="Range" defaultValue="-0.6" min="-1.0" max="1.0" displayName="Tear Line Height" group="Eye"/>
		<item name="_albedoMap" type="Texture2D" displayName="Albedo (eye: iris pattern in iris space)" group="Textures" bSrgb="1"/>
		<item name="_normalMap" type="Texture2D" displayName="Normal" group="Textures" bSrgb="0"/>
		<item name="_ormMap" type="Texture2D" displayName="Occlusion Roughness Metallic" group="Textures" bSrgb="0"/>
		<item name="_maskMap" type="Texture2D" displayName="Mask (R coat, G pattern, B thickness)" group="Textures" bSrgb="0"/>
		<item name="_wetMask" type="Texture2D" displayName="Wet Mask (runtime)" group="Textures" bSrgb="0"/>
		<item name="_residueMask" type="Texture2D" displayName="Residue Mask (runtime)" group="Textures" bSrgb="0"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
