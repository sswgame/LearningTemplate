<!-- 외형 라이브러리 프리셋(brushedmetal): 칼날(갈린 강철). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="BladeSteel" _base="engine/materials/library/brushedmetal/base.material">
	<_properties>
		<item name="_roughness" defaultValue="0.25" />
	</_properties>
</MaterialDef>
