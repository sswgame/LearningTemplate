<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(coated): 마른 눈물 · 침 자국(마스크 없이 전체 — 스칼라 문만). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="DriedTearTrail" _base="engine/materials/library/coated/base.material">
	<_properties>
		<item name="_color" defaultValue="0.85 0.62 0.5 1" />
		<item name="_coatWeight" defaultValue="0" />
		<item name="_residue" defaultValue="1" />
	</_properties>
</MaterialDef>
