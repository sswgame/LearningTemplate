<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(coated): 젖은 면(마스크 없이 전체 젖음 — 스칼라 문만). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="WetSurface" _base="engine/materials/library/coated/base.material">
	<_properties>
		<item name="_color" defaultValue="0.5 0.48 0.45 1" />
		<item name="_roughness" defaultValue="0.8" />
		<item name="_coatWeight" defaultValue="0" />
		<item name="_wetness" defaultValue="1" />
		<item name="_wetMeniscus" defaultValue="0.5" />
	</_properties>
</MaterialDef>
