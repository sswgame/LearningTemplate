<!-- 외형 라이브러리 프리셋(glass): 색유리(녹색). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="GlassTinted" _base="engine/materials/library/glass/base.material">
	<_properties>
		<item name="_color" defaultValue="0.55 0.8 0.6 0" />
	</_properties>
</MaterialDef>
