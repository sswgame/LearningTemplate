<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(glass): 간유리(흐린 굴절). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="GlassFrosted" _base="engine/materials/library/glass/base.material">
	<_properties>
		<item name="_roughness" defaultValue="0.4" />
		<item name="_refractionBlur" defaultValue="0.7" />
		<item name="_color" defaultValue="0.92 0.94 0.95 0.1" />
	</_properties>
</MaterialDef>
