<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(fur): 긴 털(성기고 굵다). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="FurLong" _base="engine/materials/library/fur/base.material">
	<_properties>
		<item name="_color" defaultValue="0.85 0.82 0.78 1" />
		<item name="_sheenColor" defaultValue="0.5 0.5 0.5 1" />
		<item name="_patternScale" defaultValue="140" />
		<item name="_patternWidth" defaultValue="0.38" />
		<item name="_strandShift" defaultValue="0.25" />
	</_properties>
</MaterialDef>
