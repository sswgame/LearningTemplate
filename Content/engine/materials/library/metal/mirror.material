<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(metal): 거울 — 반사는 SSR(W11) + 반사 프로브. 평면 반사 패스는 두지 않았다(appearance_lit.hlsl 머리말). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="Mirror" _base="engine/materials/library/metal/base.material">
	<_properties>
		<item name="_color" defaultValue="0.96 0.96 0.97 1" />
		<item name="_roughness" defaultValue="0.02" />
	</_properties>
</MaterialDef>
