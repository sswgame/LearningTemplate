<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(metal): 금. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="Gold" _base="engine/materials/library/metal/base.material">
	<_properties>
		<item name="_color" defaultValue="1 0.77 0.34 1" />
		<item name="_roughness" defaultValue="0.2" />
	</_properties>
</MaterialDef>
