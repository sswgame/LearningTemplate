<?xml version="1.0" encoding="utf-8"?>
<!-- 광낸 마루 — 판자(줄마다 이음 어긋남) · 나뭇결 · 판자마다 색, 니스 클리어 코트. 부모(environmentsurface.material)의 값만 바꾼 프리셋이다. -->
<MaterialDef formatVersion="0" name="WoodFloorPolished" _base="engine/materials/environmentsurface.material">
	<_properties>
		<item name="_baseColor" defaultValue="0.55 0.33 0.17 1"/>
		<item name="_roughness" defaultValue="0.5"/>
		<item name="_secondaryColor" defaultValue="0.36 0.20 0.09 1"/>
		<item name="_secondaryRoughness" defaultValue="0.55"/>
		<item name="_patternScale" defaultValue="1.2 0.15 0.003 0"/>
		<item name="_patternShape" defaultValue="2 0.15 0.001 1"/>
		<item name="_clearCoat" defaultValue="1"/>
		<item name="_clearCoatRoughness" defaultValue="0.08"/>
		<item name="_porosity" defaultValue="0.2"/>
	</_properties>
</MaterialDef>
