<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(skin): 번들거리는 피부(피지 막 강하게). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="SkinOily" _base="engine/materials/library/skin/base.material">
	<_properties>
		<item name="_coatWeight" defaultValue="0.7" />
		<item name="_coatRoughness" defaultValue="0.18" />
	</_properties>
</MaterialDef>
