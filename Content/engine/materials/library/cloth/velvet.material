<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(cloth): 벨벳(스치는 각에서 밝은 잔털). 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="Velvet" _base="engine/materials/library/cloth/base.material">
	<_properties>
		<item name="_color" defaultValue="0.18 0.02 0.12 1" />
		<item name="_secondaryColor" defaultValue="0.18 0.02 0.12 1" />
		<item name="_sheenColor" defaultValue="0.75 0.4 0.6 1" />
		<item name="_sheenWeight" defaultValue="1" />
		<item name="_sheenRoughness" defaultValue="0.3" />
		<item name="_patternScale" defaultValue="0" />
	</_properties>
</MaterialDef>
