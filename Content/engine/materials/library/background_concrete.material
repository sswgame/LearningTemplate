<?xml version="1.0" encoding="utf-8"?>
<!-- 콘크리트 — 거친 잔무늬와 얼룩(큰 무늬), 비에 어두워진다. 부모(environmentsurface.material)의 값만 바꾼 프리셋이다. -->
<MaterialDef formatVersion="0" name="Concrete" _base="engine/materials/environmentsurface.material">
	<_properties>
		<item name="_baseColor" defaultValue="0.55 0.55 0.53 1"/>
		<item name="_roughness" defaultValue="0.9"/>
		<item name="_noiseStrength" defaultValue="0.25"/>
		<item name="_noiseScale" defaultValue="0.02"/>
		<item name="_macroVariation" defaultValue="0.4"/>
		<item name="_macroScale" defaultValue="3"/>
		<item name="_patternShape" defaultValue="0 0 0.002 1"/>
		<item name="_porosity" defaultValue="0.8"/>
	</_properties>
</MaterialDef>
