<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(thin): 종이 · 한지. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="Paper" _base="engine/materials/library/thin/base.material">
	<_properties>
		<item name="_color" defaultValue="0.88 0.86 0.8 1" />
		<item name="_subsurfaceColor" defaultValue="1 0.9 0.75 1" />
		<item name="_transmission" defaultValue="0.6" />
	</_properties>
</MaterialDef>
