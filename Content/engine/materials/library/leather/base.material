<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 갈래 바탕: 가죽 — 천이 아니다: 거친 유전체 + 세포 결 노멀, 광택은 코트(_coatWeight). -->
<MaterialDef formatVersion="0" name="AppearanceLeather" _base="engine/materials/library/appearance.material">
	<_properties>
		<item name="_color" defaultValue="0.32 0.18 0.1 1" />
		<item name="_secondaryColor" defaultValue="0.15 0.08 0.04 1" />
		<item name="_roughness" defaultValue="0.65" />
		<item name="_patternScale" defaultValue="60" />
		<item name="_patternAmount" defaultValue="0.6" />
		<item name="_specular" defaultValue="0.45" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_PATTERN_LEATHER</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
