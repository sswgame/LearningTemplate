<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 갈래 바탕: 눈 — 공막(얕은 산란) · 각막 굴절 시차 홍채 · 윤부 · 동공 모양 · 각막 젖음 · 홍채 집광 · 반사판 · 눈물 띠. 동공 확장은 인스턴스 값 _customData0.x(런타임). -->
<MaterialDef formatVersion="0" name="AppearanceEye" _base="engine/materials/library/appearance.material">
	<_properties>
		<item name="_color" defaultValue="0.92 0.9 0.88 1" />
		<item name="_secondaryColor" defaultValue="0.06 0.05 0.05 1" />
		<item name="_subsurfaceColor" defaultValue="1 0.55 0.5 1" />
		<item name="_subsurfaceRadius" defaultValue="0.3" />
		<item name="_roughness" defaultValue="0.35" />
		<item name="_coatWeight" defaultValue="1" />
		<item name="_coatRoughness" defaultValue="0.02" />
		<item name="_ior" defaultValue="1.376" />
		<item name="_patternAmount" defaultValue="0.6" />
		<item name="_wetMeniscus" defaultValue="0.8" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_EYE</item>
			<item>MATERIAL_LOBE_SUBSURFACE</item>
		</_alwaysDefines>
	</_permutations>
</MaterialDef>
