<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(eye): 고양이 — 세로 틈 · 큰 홍채 · 초록 금빛 반사판. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="EyeCat" _base="engine/materials/library/eye/base.material">
	<_properties>
		<item name="_layerColor" defaultValue="0.7 0.6 0.15 1" />
		<item name="_pupilShape" defaultValue="1" />
		<item name="_pupilMinRadius" defaultValue="0.1" />
		<item name="_pupilMaxRadius" defaultValue="0.8" />
		<item name="_irisRadius" defaultValue="0.75" />
		<item name="_corneaHeight" defaultValue="0.2" />
		<item name="_glowColor" defaultValue="0.4 1.2 0.6 1" />
	</_properties>
</MaterialDef>
