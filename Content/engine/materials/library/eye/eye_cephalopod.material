<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(eye): 갑오징어 · 문어 — W 자 동공. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="EyeCephalopod" _base="engine/materials/library/eye/base.material">
	<_properties>
		<item name="_layerColor" defaultValue="0.6 0.55 0.4 1" />
		<item name="_pupilShape" defaultValue="3" />
		<item name="_pupilMinRadius" defaultValue="0.1" />
		<item name="_pupilMaxRadius" defaultValue="0.6" />
		<item name="_irisRadius" defaultValue="0.85" />
		<item name="_coatWeight" defaultValue="0.3" />
		<item name="_wetMeniscus" defaultValue="0" />
	</_properties>
</MaterialDef>
