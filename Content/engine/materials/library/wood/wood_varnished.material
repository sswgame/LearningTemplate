<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(wood): 니스 칠한 나무. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="WoodVarnished" _base="engine/materials/library/wood/base.material">
	<_properties>
		<item name="_coatWeight" defaultValue="0.8" />
		<item name="_coatRoughness" defaultValue="0.06" />
	</_properties>
</MaterialDef>
