<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(stone): 광낸 대리석. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="MarblePolished" _base="engine/materials/library/stone/base.material">
	<_properties>
		<item name="_color" defaultValue="0.9 0.89 0.86 1" />
		<item name="_secondaryColor" defaultValue="0.55 0.55 0.58 1" />
		<item name="_roughness" defaultValue="0.3" />
		<item name="_coatWeight" defaultValue="0.6" />
		<item name="_coatRoughness" defaultValue="0.05" />
		<item name="_patternAmount" defaultValue="0.3" />
	</_properties>
</MaterialDef>
