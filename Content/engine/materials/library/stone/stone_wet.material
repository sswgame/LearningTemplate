<?xml version="1.0" encoding="utf-8"?>
<!-- 외형 라이브러리 프리셋(stone): 비에 젖은 돌. 값만 바꾼다 — 셰이더 변형은 갈래 바탕과 같다. -->
<MaterialDef formatVersion="0" name="StoneWet" _base="engine/materials/library/stone/base.material">
	<_properties>
		<item name="_wetness" defaultValue="1" />
		<item name="_wetMeniscus" defaultValue="0.3" />
	</_properties>
</MaterialDef>
