<?xml version="1.0" encoding="utf-8"?>
<!-- 블록아웃용 격자 머티리얼(언리얼 WorldGridMaterial 에 해당). MATERIAL_WORLD_UV 로 월드 좌표에서 읽어 메시 크기와 상관없이 한 칸이 1 m 다(forward_lit.hlsl 트라이플래너). -->
<MaterialDef formatVersion="0" name="PrototypeGridOrange" _base="engine/materials/defaultmaterial.material">
	<_properties>
		<item name="_roughness" defaultValue="0.8" />
		<item name="_albedoMap" assetPath="engine/textures/prototype/grid_orange.dds" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_WORLD_UV</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDef>
