<!--
  Cutscene InputMap (EngineDefaultAssets::_cutsceneInputMap) - SequencePlayerComponent appends it to the player's map the first time a cutscene needs it,
  then turns the Cutscene layer on for the playback - an always-on overlay, so skip and fast forward work without switching the layer stack. Only a cutscene that blocks player
  movement also pushes it with blockLower, so move, look and game actions stop; free and confined playback leave the game layers live. Pause and menus live in the UI map.
  The action names are a contract with SequencePlayerComponent (Cutscene.Skip / Cutscene.FastForward). Keys are data; every game gets the same cutscene controls.
-->
<InputMap>
	<layers>
		<layer name="Cutscene" enabled="0" blockLower="0" alwaysOn="1"/>
	</layers>
	<!-- Jump to the end of the cutscene (UE GoToEndAndStop). -->
	<action name="Cutscene.Skip" layer="Cutscene" trigger="Pressed">
		<bind source="Key" code="Backspace"/>
		<bind source="Gamepad" code="Back"/>
	</action>
	<!-- Held: play faster (EngineConfig _sequencer._fastForwardRate); released: back to the cutscene's rate. -->
	<action name="Cutscene.FastForward" layer="Cutscene" trigger="Down">
		<bind source="Key" code="Period"/>
		<bind source="Gamepad" code="RightThumb"/>
	</action>
</InputMap>
