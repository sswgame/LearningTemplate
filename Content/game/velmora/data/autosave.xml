<?xml version="1.0" encoding="utf-8"?>
<!-- Velmora 자동 저장 정책(AutosaveSettings) — 지역 이동 · 보스 앞 · 야영지 체크포인트에 저장한다. 시나리오가 끝날 때마다 사용자 슬롯을 쓰지 않게 종료 저장은 끈다(불러오기 화면이 아직 없다). -->
<Autosave interval="300" minimumGap="5" slots="3" group="velmora" prefix="slot" areaChange="true" checkpoint="true" beforeBoss="true" quit="false"/>
