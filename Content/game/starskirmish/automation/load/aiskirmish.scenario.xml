<!--
  부하 시나리오 — AI 가 많은 씬: StarSkirmish 의 두 진영을 모두 AI 가 돌린다(일꾼 · 건물 · 군대가 시간이 지날수록 늘어 게임 스레드가 무거워진다).
  측정 창(<Load>)이 끝내므로 <Pass/> 가 없다. 하위 폴더라 게임 체인(Scenario.starskirmish)이 줍지 않고 따로 혼자 도는 항목이다.
  실행: ctest -L load (항목 Scenario.starskirmish.load.aiskirmish) · App -scenario=game/starskirmish/automation/load/aiskirmish.scenario.xml -unattended -gv_skirmishAutoPlay=1 (SW_ACTIVE_GAME=StarSkirmish)
-->
<Scenario name="game.starskirmish.load.aiskirmish" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<!-- 자동 플레이는 판을 열 때 한 번 읽는다 — 시나리오 중간의 <Variable> 은 이미 열린 사람 대 컴퓨터 판을 바꾸지 못했다. 기동 값으로 건다. -->
	<Launch variable="gv_skirmishAutoPlay" value="1"/>
	<Load durationSeconds="30"/>
	<!-- 측정 경로를 탔는지 스스로 본다 — 두 진영 모두 컴퓨터이고, 시간이 지나며 유닛이 늘어난다. -->
	<WaitUntil watch="Skirmish.AIPlayerCount" equals="2" timeoutFrames="120"/>
	<Store watch="Skirmish.UnitCount" as="start"/>
	<AdvanceSimulation frames="1200"/> <!-- AI 가 일꾼 · 건물을 늘릴 시간(시간이 내용) -->
	<Expect watch="Skirmish.UnitCount" differsFrom="start"/>
</Scenario>
