<?xml version="1.0" encoding="utf-8"?>
<!--
  장르 수직 슬라이스(G1) — 시작 → 목표(control.scenario.xml 의 단계 그대로) → 결과 → 저장 · 복원 해시 동일.
  목표 단계는 그 시나리오가 정본이다 — 거기를 고치면 이 파일도 맞춘다. 저장 슬롯은 starskirmish/slice.
-->
<Scenario name="game.starskirmish.slice" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_skirmishAutoPlay" value="0"/>
	<WaitUntil watch="Input.VirtualCursorEnabled" equals="1" timeoutFrames="60"/>
	<Expect watch="Skirmish.SelectedCount" equals="0"/>
	<!-- 본진(10, 10)을 덮는 사각형 — 리그 초점 (14, 14) · 직교 높이 30 에서 화면 왼쪽 가운데 아래. 끌기는 누른 채 프레임이 지나야 한다. -->
	<Wait frames="1"/>
	<MousePosition x="0.3" y="0.45"/>
	<Press slot="Mouse.Left"/>
	<Wait frames="5"/>
	<MousePosition x="0.6" y="0.85"/>
	<Wait frames="4"/>
	<Release slot="Mouse.Left"/>
	<WaitUntil watch="Skirmish.SelectedCount" atLeast="1" timeoutFrames="30"/>
	<!-- 빈 땅으로 명령 — 고른 일꾼이 그 자리로 무리 이동한다. -->
	<MousePosition x="0.7" y="0.3"/>
	<Wait frames="2"/>
	<Tap slot="Mouse.Right" hold="1"/>
	<WaitUntil watch="Skirmish.SelectedMovingCount" atLeast="1" timeoutFrames="30"/>
	<!-- 저장 → 세계를 더 돌림 → 두 번 복원: 같은 슬롯을 두 번 불러온 직후의 씬 상태 해시가 같아야 한다(복원이 세계를 다 되살린다 — 저장 순간의 해시와 견주면 명령이 도는 프레임만큼 흔들린다) -->
	<Wait frames="1"/>
	<DevCommand line="game.save starskirmish/slice"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load starskirmish/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="10"/>
	<RecordStateHash key="restored"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load starskirmish/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="2" timeoutWallSeconds="10"/>
	<ExpectStateHash key="restored"/>
	<Pass/>
</Scenario>
