<?xml version="1.0" encoding="utf-8"?>
<!-- HarvestValley 팩의 설정 — 시작 맵은 농장 씬이다(게임마다 팩의 data/gamesettings.xml 하나다). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Harvest Valley" _userSettingsSchema="game/harvestvalley/data/farm.settings.xml" _bUIPauseMenu="true" />
  <startMap>game/harvestvalley/maps/farm.scene.xml</startMap>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/move.input.xml"/>
  <inputMap path="common/input/menu.input.xml"/>
  <inputMap path="game/harvestvalley/data/farm.input.xml"/>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/harvestvalley/audio/harvestvalley.audioevents.xml</audioEvents>
  <!-- 마을 사람 · 농부 외형(Quaternius 기본 캐릭터 · 옷)은 공용 팩(common)의 외형 데이터다 — 외형이 장비 아이템을 참조하므로 아이템도 함께. 바탕(GameInstance)이 읽어 건다 -->
  <RequiredData kind="items" pack="common"/>
  <RequiredData kind="appearance" pack="common"/>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
