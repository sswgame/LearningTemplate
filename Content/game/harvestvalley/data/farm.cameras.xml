<!-- HarvestValley 카메라 프리셋 — 카메라 오브젝트의 CameraDirectorComponent 가 읽는다. 각은 라디안, 거리 · 높이는 m 다.
     비스듬히 내려다보는 직교 시점이고 입력은 받지 않는다. 초점은 농장 디렉터가 밭 가운데와 농부 사이로 넣는다(setFocusPoint). -->
<CameraPresets>
    <Preset id="farm">
        <View mode="OrthoTopDown" pitch="0.9273" yaw="0" distance="20"/>
        <Lens orthographic="true" orthoHeight="15" nearPlane="0.1" farPlane="80"/>
    </Preset>
</CameraPresets>
