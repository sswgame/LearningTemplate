<?xml version="1.0" encoding="utf-8"?>
<!--
  HarvestValley 자동 농부(FarmAutoFarmerAIComponent)의 판단. 감각이 농부 · 가방 · 밭을 블랙보드에 적고(헤더 참고), 이 트리가 할 일을 고른다.
  - 가게 앞에서 사는 중이면 다 살 때까지 선다(판단마다 하나씩 산다). 지난 누름이 못 샀으면(돈 · 가방) 그만 산다. 한 번에 6 개까지 산다.
  - 고른 씨앗이 이번 계절 씨앗이 아니면 다음 씨앗을 누른다(판단마다 한 칸).
  - 할 일: 늦었거나 지쳤으면(또는 수확물이 6 개 이상이면) 출하, 거둘 것 → 물 → 심기 → 씨앗 사기 → 갈기, 남은 수확물 출하, 할 일이 없으면 잔다.
  - 칸 일은 칸 아래로 갔다가 위를 보며 걸어 들어가(farm.walkUpTo) 0.25 초마다 한 번 쓴다(ActionTimer). 도구가 다르면 같은 판단에 도구를 먼저 바꾼다.
  상태 이름(ai.state, 감시 값 AI.State)은 시나리오 automation/autofarmer.scenario.xml 의 데이터다(Till, Sow, Water).
-->
<BehaviorTree>
	<Selector id="root" name="AutoFarmer">
		<Sequence id="notReady" name="NotReady">
			<Condition test="!blackboard(FarmReady)"/>
			<Action name="Wait" task="ai.stop"/>
		</Sequence>
		<Sequence id="buy" name="Buy">
			<Condition test="blackboard(BuyRemaining) > 0 &amp;&amp; !(blackboard(BuyRemaining) &lt; 6 &amp;&amp; blackboard(SelectedSeedCount) &lt;= blackboard(SeedCountAtBuy)) &amp;&amp; blackboard(NearShop)"/>
			<Action name="Buy" task="ai.state" state="Buy"/>
			<Action task="ai.stop"/>
			<Action task="ai.press" button="Farm.Buy"/>
			<Action task="blackboard.copy" from="SelectedSeedCount" to="SeedCountAtBuy"/>
			<Action task="blackboard.add" key="BuyRemaining" value="-1"/>
		</Sequence>
		<Sequence id="work" name="Work">
			<Action task="blackboard.set" key="BuyRemaining" value="0"/>
			<ForceSuccess>
				<Sequence id="selectSeed" name="SelectSeed">
					<Condition test="!blackboard(SeedSelected)"/>
					<Action name="NextSeed" task="ai.press" button="Farm.SeedNext"/>
				</Sequence>
			</ForceSuccess>
			<Selector id="task" name="Task">
				<Sequence id="shipNow" name="ShipNow">
					<Condition test="blackboard(ProduceCount) > 0 &amp;&amp; (blackboard(Tired) || blackboard(ProduceCount) >= 6)"/>
					<SubTree tree="game/harvestvalley/data/ai/autofarmer_ship.bt.xml"/>
				</Sequence>
				<Sequence id="harvest" name="Harvest">
					<Condition test="!blackboard(Tired) &amp;&amp; hasBlackboard(HarvestTile)"/>
					<Action name="Harvest" task="ai.state" state="Harvest"/>
					<Action task="blackboard.copy" from="HarvestTile" to="StandPosition"/>
					<ForceSuccess>
						<Sequence name="UseHand">
							<Action task="farm.walkUpTo" key="HarvestTile" tolerance="0.2" approachBack="0.4"/>
							<Condition test="blackboard(ActionTimer) &lt;= 0"/>
							<Action task="blackboard.set" key="ActionTimer" value="0.25"/>
							<ForceSuccess>
								<Sequence>
									<Condition test="!blackboard(HoldingHand)"/>
									<Action task="ai.press" button="Farm.Tool4"/>
								</Sequence>
							</ForceSuccess>
							<Action name="UseTool" task="ai.press" button="Farm.Use"/>
						</Sequence>
					</ForceSuccess>
				</Sequence>
				<Sequence id="water" name="Water">
					<Condition test="!blackboard(Tired) &amp;&amp; hasBlackboard(WaterTile)"/>
					<Action name="Water" task="ai.state" state="Water"/>
					<Action task="blackboard.copy" from="WaterTile" to="StandPosition"/>
					<ForceSuccess>
						<Sequence name="UseWateringCan">
							<Action task="farm.walkUpTo" key="WaterTile" tolerance="0.2" approachBack="0.4"/>
							<Condition test="blackboard(ActionTimer) &lt;= 0"/>
							<Action task="blackboard.set" key="ActionTimer" value="0.25"/>
							<ForceSuccess>
								<Sequence>
									<Condition test="!blackboard(HoldingWateringCan)"/>
									<Action task="ai.press" button="Farm.Tool2"/>
								</Sequence>
							</ForceSuccess>
							<Action name="UseTool" task="ai.press" button="Farm.Use"/>
						</Sequence>
					</ForceSuccess>
				</Sequence>
				<Sequence id="sow" name="Sow">
					<Condition test="!blackboard(Tired) &amp;&amp; hasBlackboard(SowTile)"/>
					<Action name="Sow" task="ai.state" state="Sow"/>
					<Action task="blackboard.copy" from="SowTile" to="StandPosition"/>
					<ForceSuccess>
						<Sequence name="UseSeeds">
							<Action task="farm.walkUpTo" key="SowTile" tolerance="0.2" approachBack="0.4"/>
							<Condition test="blackboard(ActionTimer) &lt;= 0 &amp;&amp; blackboard(SeedSelected)"/>
							<Action task="blackboard.set" key="ActionTimer" value="0.25"/>
							<ForceSuccess>
								<Sequence>
									<Condition test="!blackboard(HoldingSeeds)"/>
									<Action task="ai.press" button="Farm.Tool3"/>
								</Sequence>
							</ForceSuccess>
							<Action name="UseTool" task="ai.press" button="Farm.Use"/>
						</Sequence>
					</ForceSuccess>
				</Sequence>
				<Sequence id="shop" name="Shop">
					<Condition test="!blackboard(Tired) &amp;&amp; !blackboard(HasSeed) &amp;&amp; blackboard(CanAffordSeed)"/>
					<Action name="Shop" task="ai.state" state="Shop"/>
					<Action task="blackboard.copy" from="ShopSpot" to="StandPosition"/>
					<ForceSuccess>
						<Sequence name="StartBuying">
							<Action task="ai.arrive" key="ShopSpot" self="PlayerPosition" tolerance="0.2"/>
							<Condition test="blackboard(ActionTimer) &lt;= 0 &amp;&amp; blackboard(SeedSelected)"/>
							<Action task="blackboard.set" key="BuyRemaining" value="6"/>
						</Sequence>
					</ForceSuccess>
				</Sequence>
				<Sequence id="till" name="Till">
					<Condition test="!blackboard(Tired) &amp;&amp; hasBlackboard(TillTile)"/>
					<Action name="Till" task="ai.state" state="Till"/>
					<Action task="blackboard.copy" from="TillTile" to="StandPosition"/>
					<ForceSuccess>
						<Sequence name="UseHoe">
							<Action task="farm.walkUpTo" key="TillTile" tolerance="0.2" approachBack="0.4"/>
							<Condition test="blackboard(ActionTimer) &lt;= 0"/>
							<Action task="blackboard.set" key="ActionTimer" value="0.25"/>
							<ForceSuccess>
								<Sequence>
									<Condition test="!blackboard(HoldingHoe)"/>
									<Action task="ai.press" button="Farm.Tool1"/>
								</Sequence>
							</ForceSuccess>
							<Action name="UseTool" task="ai.press" button="Farm.Use"/>
						</Sequence>
					</ForceSuccess>
				</Sequence>
				<Sequence id="shipRest" name="ShipRest">
					<Condition test="blackboard(ProduceCount) > 0"/>
					<SubTree tree="game/harvestvalley/data/ai/autofarmer_ship.bt.xml"/>
				</Sequence>
				<Sequence id="sleep" name="Sleep">
					<Action name="Sleep" task="ai.state" state="Sleep"/>
					<Action task="blackboard.clear" key="StandPosition"/>
					<Action task="ai.stop"/>
					<Action task="ai.press" button="Farm.Sleep"/>
				</Sequence>
			</Selector>
		</Sequence>
	</Selector>
</BehaviorTree>
