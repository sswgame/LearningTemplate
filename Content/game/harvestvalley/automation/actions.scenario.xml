<?xml version="1.0" encoding="utf-8"?>
<!--
  HarvestValley 액션 단계 — 키 대신 입력 맵 액션 이름(data/farm.input.xml)으로 조작한다: Farm.Move 축으로 걷고, Farm.Tool1 로 괭이를 들고,
  위로 걸어 밭 앞에 서서 Farm.Use 로 간다. 키 배치를 바꿔도 이 시나리오는 그대로다. 농부는 X 6, Z -1.2 에서 시작하고 걷는 빠르기는 4 m/s 이다.
  끝 상태(농부 위치, 간 타일 수)를 보고의 records 에 남긴다.
  실행: ctest -R Scenario.harvestvalley (SW_ACTIVE_GAME=HarvestValley) · App -scenario=game/harvestvalley/automation/actions.scenario.xml -unattended
-->
<Scenario name="game.harvestvalley.actions" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_farmAutoPlay" value="0"/>
	<WaitUntil watch="Farm.FarmerControllerKind" equals="0" timeoutFrames="60"/>
	<Expect watch="Farm.FarmerX" near="6" tolerance="0.01"/>
	<Expect watch="Farm.FarmerTool" equals="0"/>
	<!-- 오른쪽으로 0.5 초(2 m) 걷고 선 뒤에 잰다. -->
	<Wait frames="1"/>
	<ActionAxis name="Farm.Move" x="1" seconds="0.5"/>
	<Wait seconds="0.6"/>
	<Expect watch="Farm.FarmerX" near="8" tolerance="0.2"/>
	<!-- 물뿌리개를 들었다가 괭이로 돌아온다(연속 액션). -->
	<Wait frames="1"/>
	<Action name="Farm.Tool2"/>
	<WaitUntil watch="Farm.FarmerTool" equals="1" timeoutFrames="30"/>
	<Action name="Farm.Tool1"/>
	<WaitUntil watch="Farm.FarmerTool" equals="0" timeoutFrames="30"/>
	<!-- 위로 0.45 초 걸어 밭(Z 0 부터) 앞 타일을 바라보고 선다 — 그리고 사용(괭이로 갈기, 체력 4). -->
	<ActionAxis name="Farm.Move" y="1" seconds="0.45"/>
	<Wait seconds="0.6"/>
	<Action name="Farm.Use"/>
	<WaitUntil watch="Farm.TilledCount" equals="1" timeoutFrames="60"/>
	<Record watch="Farm.FarmerX"/>
	<Record watch="Object.Z" target="Farmer"/>
	<Record watch="Farm.TilledCount"/>
	<Pass/>
</Scenario>
