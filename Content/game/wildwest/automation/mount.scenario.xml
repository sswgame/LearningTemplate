<?xml version="1.0" encoding="utf-8"?>
<!--
  WildWest 탑승 시나리오 — 기수가 곁의 말(Bessie)에 올라타고(Mount), W + Shift 로 2 초 질주하고, 멈춘 뒤 내린다(Dismount).
  탑승 단계와 감시 값 Pawn.Seat · Pawn.Controller 를 실제 게임에서 돌리고, 말 AI 가 탈 때 빙의를 넘기고 내리면 되찾는지 본다.
  사진 둘(안장에 앉은 기수 · 질주하는 말과 기수)은 백엔드별 골든과 견준다. 질주 사진은 그 프레임을 바로 찍는다(자리 잡기를 기다리면 질주가 흘러간다).
  실행: ctest -R Scenario.wildwest (SW_ACTIVE_GAME=WildWest) · App -scenario=game/wildwest/automation/mount.scenario.xml -unattended
-->
<Scenario name="game.wildwest.mount" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_wildWestAutoPlay" value="0"/>
	<!-- 걷는 기수는 플레이어 조종자가 쥐고, 말은 말 AI 가 쥔다. -->
	<WaitUntil watch="Pawn.Controller" target="Bessie" is="BessieAI" timeoutFrames="60"/>
	<Expect watch="Pawn.Seat" target="Player" is="none"/>
	<Expect watch="Pawn.Controller" target="Player" is="PlayerController"/>
	<Expect watch="WildWest.Stamina" target="Bessie" near="1" tolerance="0.001"/>
	<!-- 타는 거리(2.5 m) 안의 Bessie 에 탄다 — 운전석이라 플레이어 조종자가 말을 쥔다. -->
	<Mount rider="Player" vehicle="Bessie"/>
	<WaitUntil watch="Pawn.Seat" target="Player" is="Bessie" timeoutFrames="30"/>
	<Expect watch="Pawn.Controller" target="Bessie" is="PlayerController"/>
	<Expect watch="Object.Z" target="Bessie" near="0" tolerance="0.05"/>
	<!-- 안장 자리에 앉은 기수 — 말은 스킨드 말(horse, 등 높이에 좌석 오프셋)이고 걸음새 클립이 돈다 -->
	<Screenshot file="wildwest/mount_seated.ppm"/>
	<!-- W + Shift 2 초 — 앞으로 질주하며 스태미나를 쓴다. 기수는 좌석에 붙어 함께 간다. 누른 채 시간이 흘러야 한다. -->
	<Wait frames="2"/>
	<Press slot="Key.W"/>
	<Press slot="Key.LeftShift"/>
	<Wait frames="120"/>
	<Expect watch="WildWest.Gait" target="Bessie" equals="4"/>
	<Expect watch="WildWest.Speed" target="Bessie" atLeast="8"/>
	<Expect watch="WildWest.Stamina" target="Bessie" atMost="0.9"/>
	<Expect watch="Object.Z" target="Bessie" atLeast="6"/>
	<Expect watch="Object.Z" target="Player" atLeast="6"/>
	<Expect watch="Pawn.Seat" target="Player" is="Bessie"/>
	<Screenshot file="wildwest/mount_gallop.ppm" waitForSettle="false"/>
	<Wait frames="1"/>
	<Release slot="Key.W"/>
	<Release slot="Key.LeftShift"/>
	<!-- 감속(8 m/s²)으로 선다. -->
	<WaitUntil watch="WildWest.Gait" target="Bessie" equals="0" timeoutFrames="180"/>
	<!-- 내린다 — 플레이어 조종자는 기수를, 말 AI 는 말을 되찾는다. 기수는 말 왼쪽(하차 위치)에 서서 바닥에 닿는다. -->
	<Dismount rider="Player"/>
	<WaitUntil watch="Pawn.Seat" target="Player" is="none" timeoutFrames="30"/>
	<Expect watch="Pawn.Controller" target="Player" is="PlayerController"/>
	<Expect watch="Pawn.Controller" target="Bessie" is="BessieAI"/>
	<WaitUntil watch="Object.Y" target="Player" near="0" tolerance="0.3" timeoutFrames="60"/>
	<ExpectImage file="wildwest/mount_seated.ppm" golden="mount_seated"/>
	<ExpectImage file="wildwest/mount_gallop.ppm" golden="mount_gallop"/>
	<Pass/>
</Scenario>
