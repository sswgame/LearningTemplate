<?xml version="1.0" encoding="utf-8"?>
<!--
  WildWest 의 입력 차이 — 공통 묶음(gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다.
  기수 폰과 말 폰이 같은 액션 이름을 의도 버튼으로 쓴다 — 걸을 때는 Interact 가 타기, 탔을 때는 내리기다. Sprint 는 말의 질주다. 점프는 없다.
-->
<InputMap>
	<action name="West.Whistle" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="F"/>
	</action>
	<action name="West.Use" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="G"/>
	</action>
	<!-- 들기 · 내려놓기(기수의 GrabberComponent). E 는 공통 Interact(타기)라 겹치지 않게 따로 둔다 — 하프라이프 2 처럼 한 키로 들고 다시 눌러 놓는다. -->
	<action name="West.Carry" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="R"/>
	</action>
	<remove name="Jump"/>
</InputMap>
