<!-- 시나리오 automation/displacement — 체커 높이 맵으로 칸마다 0.35 m 솟는 판. 헐 · 도메인 변형으로 그려져 윤곽(먼 가장자리)이 계단이 된다(material_displacement.hlsli). -->
<MaterialDef formatVersion="0" name="displacement_checker" _base="guid:c3c9cc416ee4371f50758714f94977c8">
	<_permutations>
		<_alwaysDefines>
			<item>MATERIAL_DISPLACEMENT</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" _op="Remove"/>
		</_multiCompiles>
	</_permutations>
</MaterialDef>
