			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="RTSUnitDied"
		                _bus="sfx"
		                _attenuation="RTSBattlefield"
		                _priority="50"
		                _maxInstances="4"
		                _steal="Quietest"
		                _volumeDbMin="-3"
		                _volumeDbMax="0"
		                _pitchMin="-2"
		                _pitchMax="1"
		                _virtual="Stop">
			<_listClip>
				<AudioClipEntry _path="game/playground/starskirmish/sounds/impact_metal_heavy_000.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="ParkSelect" _bus="ui" _priority="70" _cooldownSeconds="0.05" _maxInstances="1" _steal="Oldest">
			<_listClip>
				<AudioClipEntry _path="game/playground/themepark/sounds/select_001.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="ParkBuilt" _bus="ui" _priority="70" _maxInstances="2">
			<_listClip>
				<AudioClipEntry _path="game/playground/themepark/sounds/confirmation_001.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="ParkBlocked" _bus="ui" _priority="70" _cooldownSeconds="0.5" _maxInstances="1" _steal="Reject">
			<_listClip>
				<AudioClipEntry _path="game/playground/themepark/sounds/error_001.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="ArenaWaveStart" _bus="sfx" _priority="70" _maxInstances="1" _steal="Oldest">
			<_listClip>
				<AudioClipEntry _path="game/playground/abilityarena/sounds/maximize_001.ogg" />
