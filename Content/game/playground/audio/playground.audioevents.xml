		</AudioEventDef>
		<AudioEventDef _name="VoxelBlockBreak"
		                _bus="sfx"
		                _priority="55"
		                _cooldownSeconds="0.05"
		                _maxInstances="3"
		                _steal="Oldest"
		                _volumeDbMin="-3"
