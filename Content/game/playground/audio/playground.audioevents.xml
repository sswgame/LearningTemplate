				<AudioClipEntry _path="game/playground/sounds/click.ogg" _subtitleKey="Subtitle.GuideLine" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="SubtitleScoutLine" _bus="sfx" _priority="70" _cooldownSeconds="0" _maxInstances="1" _steal="Oldest" _subtitleSpeakerKey="Subtitle.Scout">
