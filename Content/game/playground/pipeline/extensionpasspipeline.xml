<!--
	모듈 렌더 확장 시연 파이프라인(ExtensionRenderPass M3 · M4) — 포워드 파이프라인(`engine/pipeline/forwardpipeline.xml`)과 같은 패스 목록이다. 모듈 패스는 이 XML 에 적지 않는다:
	게임 모듈(PlaygroundGame)이 `IRenderExtension` 을 등록하고, 렌더러가 프레임마다 그 확장이 선언한 패스(`Playground.DrawDemo` · `Playground.TintDemo`)를 같은 RenderGraph 에 끼운다
	(PrePostProcess 자리 = 피사계 심도 앞). 이 파일이 하는 일은 모듈이 쓸 셰이더를 `_listExtensionShader` 로 선언하는 것뿐이다.
	시나리오 `game/playground/automation/extensionpass.scenario.xml` 이 `gv_renderPipeline` 로 고른다.
-->
<RenderPipelineDesc _base="guid:a75d4f411b530b43612e42001606bcec" _name="ModulePassPipeline">
	<_listPass>
		<RenderGraphPassDesc _name="Fog" _op="Remove" />
		<RenderGraphPassDesc _name="DistortionApply" _op="Remove" />
		<RenderGraphPassDesc _name="Distortion" _op="Remove" />
		<RenderGraphPassDesc _name="SceneDepthCopy" _op="Remove" />
		<RenderGraphPassDesc _name="SceneColorCopy" _op="Remove" />
		<RenderGraphPassDesc _name="VolumetricClouds" _op="Remove" />
		<RenderGraphPassDesc _name="Sky">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Transparent">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
		</RenderGraphPassDesc>
	</_listPass>
	<!-- 장면 색 · 깊이 사본 패스를 지웠으니 그 첨부 묶음(scenecopyrenderpass)도 뺀다. -->
	<_listRenderPassRef>
		<item _op="Remove">guid:85dda27761602296f8342aa3e0fda17e</item>
	</_listRenderPassRef>
	<_listExtensionShader>
		<item>guid:d065c7e080a5fd21566ce30f25a0be89</item>
		<item>guid:3b25ef0271c9987617ccbb6daa3a64d4</item>
	</_listExtensionShader>
</RenderPipelineDesc>
