<!--
  아레나 미니게임(minigames/abilityarena)의 입력 차이 — Playground 공통 묶음(data/gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다. 게임 코드는 키를 묻지 않고 액션 이름만 묻는다.
  한 게임만 쓰는 이름은 게임 접두(Arena.)다. 레이어 Arena 는 꺼져 있고 미니게임의 inputContexts 가 들어가 있는 동안만 켠다 — 허브 · 다른 미니게임의 같은 키와 겹치지 않는다.
-->
<InputMap>
	<layers>
		<layer name="Arena" enabled="0" blockLower="0"/>
	</layers>
	<action name="Arena.Melee" layer="Arena" trigger="Pressed">
		<bind source="Key" code="J"/>
		<bind source="Key" code="Space"/>
	</action>

	<action name="Arena.Fireball" layer="Arena" trigger="Pressed">
		<bind source="Key" code="K"/>
		<bind source="Key" code="Digit2"/>
	</action>

	<action name="Arena.Heal" layer="Arena" trigger="Pressed">
		<bind source="Key" code="L"/>
		<bind source="Key" code="Digit3"/>
	</action>

	<action name="Arena.Dash" layer="Arena" trigger="Pressed">
		<bind source="Key" code="LeftShift"/>
		<bind source="Key" code="Digit4"/>
	</action>
</InputMap>
