<!--
  생존 공포 미니게임(minigames/survivalhorror)의 입력 차이 — Playground 공통 묶음(data/gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다. 게임 코드는 키를 묻지 않고 액션 이름만 묻는다. 걷기는 공통 `Move` 축이다.
  레이어 SurvivalHorror 는 꺼져 있고 미니게임의 inputContexts 가 들어가 있는 동안만 켠다.
-->
<InputMap>
	<layers>
		<layer name="SurvivalHorror" enabled="0" blockLower="0"/>
	</layers>
	<action name="SurvivalHorror.Use" layer="SurvivalHorror" trigger="Pressed">
		<bind source="Key" code="E"/>
		<bind source="Gamepad" code="A"/>
	</action>
	<action name="SurvivalHorror.Light" layer="SurvivalHorror" trigger="Pressed">
		<bind source="Key" code="F"/>
		<bind source="Gamepad" code="Y"/>
	</action>
	<action name="SurvivalHorror.Heal" layer="SurvivalHorror" trigger="Pressed">
		<bind source="Key" code="Q"/>
		<bind source="Gamepad" code="X"/>
	</action>
</InputMap>
