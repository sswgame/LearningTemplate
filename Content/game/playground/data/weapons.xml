<?xml version="1.0" encoding="utf-8"?>
<?asset guid="72f8317370557bb03bf4e6c52e0590c3"?>
<!-- 사격장 의 무기 — 쏘는 법만 적는다. 속성 이름은 WeaponDef 의 필드 이름이다(빠진 것은 기본값). 각도는 도, 시간은 초.
     날아가는 것(피해 · 사거리 · 궤적)은 탄 표(projectiles.xml)다. projectile 은 기본으로 장전하는 탄이고, accepts 는 받는 탄의 태그 조건이다(그냥 이름은 태그).
     item 은 무기를 나타내는 장비 아이템(items.xml)의 id 다. 표시 이름과 외형은 그 아이템이 정하므로 여기에는 name 을 적지 않는다(원본이 하나다).
     fireSound · reloadSound · emptySound 는 audio/playground.audioevents.xml 의 이벤트다(비면 소리가 없다).
     퍼짐은 쏠 때마다 spreadPerShot 만큼 커져 maxSpread 에서 멈추고 초당 spreadRecovery 만큼 minSpread 로 돌아온다. -->
<WeaponCatalog>
  <Weapon id="rifle" fireSound="WeaponRifleFire" reloadSound="WeaponRifleReload" emptySound="WeaponEmpty" item="scifi_rifle" projectile="rifle_round" accepts="Ammo.Rifle" fireInterval="0.095" reloadTime="1.9" minSpread="0.4" maxSpread="3.5"
          spreadPerShot="0.45" spreadRecovery="7" recoilPitch="0.55" magazineSize="30" maxReserveAmmo="240" pelletCount="1" automatic="true" twoHanded="true"/>
  <Weapon id="shotgun" fireSound="WeaponShotgunFire" reloadSound="WeaponShotgunReload" emptySound="WeaponEmpty" item="scifi_shotgun" projectile="buckshot" accepts="Ammo.Shell" fireInterval="0.85" reloadTime="2.4" minSpread="5" maxSpread="6.5"
          spreadPerShot="1.5" spreadRecovery="4" recoilPitch="3.2" magazineSize="6" maxReserveAmmo="36" pelletCount="9" automatic="false" twoHanded="true"/>
  <Weapon id="pistol" fireSound="WeaponPistolFire" reloadSound="WeaponPistolReload" emptySound="WeaponEmpty" item="scifi_pistol" projectile="pistol_round" accepts="Ammo.Pistol" fireInterval="0.16" reloadTime="1.3" minSpread="0.2" maxSpread="2.2"
          spreadPerShot="0.8" spreadRecovery="6" recoilPitch="1.1" magazineSize="12" maxReserveAmmo="96" pelletCount="1" automatic="false"/>
  <!-- 기체 대전 미니게임(minigames/mecharena)의 주무기 — 기체(data/mechs.xml)의 Shot 슬롯이 가리킨다. 사격장은 이 탄을 받지 않는다. -->
  <Weapon id="mech_rifle" fireSound="WeaponMechFire" reloadSound="WeaponMechReload" emptySound="WeaponEmpty" projectile="mech_beam" accepts="Ammo.MechBeam" fireInterval="0.35" reloadTime="1.6" minSpread="0.5" maxSpread="2" spreadPerShot="0.4" spreadRecovery="4" magazineSize="8" maxReserveAmmo="400" pelletCount="1" automatic="true"/>
  <!-- 배틀로얄 미니게임(minigames/battleroyale)의 총 — 디렉터의 _listWeaponID 가 나쁜 것부터 든다. ammo 는 바닥에서 줍는 탄 아이템이다. 사격장은 이 탄을 받지 않는다. -->
  <Weapon id="br_pistol" fireSound="WeaponPistolFire" reloadSound="WeaponPistolReload" emptySound="WeaponEmpty" item="scifi_pistol" ammo="ammo_light" projectile="br_light_round" accepts="Ammo.RoyaleLight" fireInterval="0.4" reloadTime="1.4" minSpread="0.5" maxSpread="2" spreadPerShot="0.4" spreadRecovery="6" magazineSize="12" maxReserveAmmo="60" pelletCount="1" automatic="false"/>
  <Weapon id="br_shotgun" fireSound="WeaponShotgunFire" reloadSound="WeaponShotgunReload" emptySound="WeaponEmpty" item="scifi_shotgun" ammo="ammo_shell" projectile="br_shell" accepts="Ammo.RoyaleShell" fireInterval="0.9" reloadTime="2.2" minSpread="5" maxSpread="6.5" spreadPerShot="1.5" spreadRecovery="4" magazineSize="5" maxReserveAmmo="25" pelletCount="5" automatic="false" twoHanded="true"/>
  <Weapon id="br_rifle" fireSound="WeaponRifleFire" reloadSound="WeaponRifleReload" emptySound="WeaponEmpty" item="scifi_rifle" ammo="ammo_rifle" projectile="br_rifle_round" accepts="Ammo.RoyaleRifle" fireInterval="0.2" reloadTime="1.9" minSpread="0.4" maxSpread="3" spreadPerShot="0.4" spreadRecovery="7" magazineSize="24" maxReserveAmmo="120" pelletCount="1" automatic="true" twoHanded="true"/>
</WeaponCatalog>
