<!-- Playground 자동 저장 정책(AutosaveSettings) — 마을 문 체크포인트(prairie 씬의 AutosaveTriggerComponent), 미니게임에 들어가기 직전(지역 이동), 액션 어드벤처 미니게임의 지역 이동 · 보스 앞 · 야영지(체크포인트), 5 분 간격. 시나리오가 끝날 때마다 사용자 슬롯을 쓰지 않게 종료 저장은 끈다(불러오기 화면이 아직 없다). -->
<Autosave interval="300" minimumGap="30" slots="3" group="playground" prefix="slot" areaChange="true" checkpoint="true" beforeBoss="true" quit="false"/>
