<!-- Playground 의 사용자 설정 — 엔진 스키마(engine/settings/engine.settings.xml) 위에 덧붙는다(data/gamesettings.xml 의 _userSettingsSchema). 미니게임마다 제 접두의 줄을 더한다.
     조작 탭의 키 바인딩: 입력 맵 묶음(data/gamesettings.xml 의 inputMap 줄)의 액션마다 첫 바인딩을 다시 잡을 수 있다. 빈 default 는 "입력 맵의 기본 바인딩"이다. -->
<UserSettingsSchema owner="game" version="1">
	<Setting id="controls.frontierFastForward" category="controls" type="KeyBinding" action="FastForward" bindIndex="0" default=""/>
