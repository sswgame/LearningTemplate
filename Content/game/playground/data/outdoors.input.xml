<!-- 야외 활동 장소(maps/outdoors)의 입력 — 걷기 · 점프 · 상호작용은 공용 액션이고, 위아래(헤엄 · 사다리)와 이모트만 여기 있다. -->
<InputMap>
	<action name="Playground.MoveUp" layer="Gameplay">
		<axis1d negative="F" positive="R"/>
	</action>
	<action name="Playground.Cheer" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="G"/>
	</action>
	<action name="Playground.Greet" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="H"/>
	</action>
</InputMap>
