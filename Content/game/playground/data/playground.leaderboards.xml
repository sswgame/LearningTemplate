<!-- Playground 순위표(LeaderboardCatalog) — 서버 온라인 설정(Config/Server/Online/Playground.online.json 의 leaderboard 키트)이 읽는다.
     arena_kills 는 온라인 매치(minigames/shooter3d_match)의 처치 수, 가장 좋은 기록을 남긴다. 판을 도는 매치 서버가 점수를 내고(ILeaderboardScoreSender)
     클라이언트 제출은 받지 않는다(키트 정책 - 클라이언트 점수는 믿지 않는다). -->
<LeaderboardCatalog>
	<Board id="arena_kills" order="Descending" update="Best" reset="None" clientSubmit="false"/>
</LeaderboardCatalog>
