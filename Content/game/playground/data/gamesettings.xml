<?xml version="1.0" encoding="utf-8"?>
<?asset guid="b9afa91390ec667bb009d86bc1e26c97"?>
<!-- Playground 팩의 설정 — 기본 실기동은 마을(maps/hub — 서부 평원 maps/prairie 를 바탕으로 물려받아 말을 타고 돌며 장소 · 사물로 장르 미니게임에 들어간다)을 연다(배포본도 씬 로드 경로 SCN1 · 프리팹 GUID 해석을 거치게). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <!-- 덮어쓰기 층 layers/zones: 엔진 표면 종류 표에 지역 프로필(빙판 · 바다 · 용암 · 가시덩굴)을 얹는다 — 프로필이 이 게임의 이펙트를 부른다. -->
  <!-- _bUIPauseMenu: Esc · 패드 Start 가 엔진 일시정지 메뉴를 연다(런타임 UI 시나리오 frontend · pausemenu) -->
  <!-- 컷씬 입력 레이어가 이동을 막는 동안에도 메뉴 · 옵션이 열리는지 automation/cutscenetrigger 가 본다. -->
  <!-- 사용자 설정 스키마(키 바인딩)는 미니게임들의 몫을 한 파일에 모은다(data/playground.settings.xml). -->
  <Engine _windowTitle="SWEngine" _userSettingsSchema="game/playground/data/playground.settings.xml" _bUIPauseMenu="true">
    <_listResourceLayer>
      <item>game/playground/layers/zones</item>
    </_listResourceLayer>
  </Engine>
  <startMap>game/playground/maps/hub.scene.xml</startMap>
  <autosaveSettings>game/playground/data/autosave.xml</autosaveSettings>
  <!-- 게임 범위 기능 — 첫 씬 전에 켜 인스턴스 내내 둔다. 지역 효과 시연 · 마을의 어빌리티 카탈로그(data/abilities.xml) · 클래스를 PlaygroundAbilities 가 건다. -->
  <gameFeatures>
    <item>PlaygroundAbilities</item>
  </gameFeatures>
  <!-- 장르 키트 시연(maps/kitdemo_*)의 입력 — 기본 맵 · 걷기 축 · 시연 액션(docs/agents/DataInheritance.md "입력 맵 묶음" 절). 다른 씬은 이 액션을 묻지 않는다. -->
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/move.input.xml"/>
  <inputMap path="game/playground/data/kitdemo.input.xml"/>
  <!-- 타일 걸음 마을 미니게임(minigames/pixeltown)의 말 걸기 — 공통 상호작용 액션 Interact 에 Space 를 더한다(Interaction 레이어라 시연 점프 Space 와 겹치지 않는다). -->
  <inputMap path="common/input/interact.input.xml"/>
  <inputMap path="game/playground/pixeltown/data/town.input.xml"/>
  <!-- 몸 이동(점프 · 달리기) — 서부 평원의 질주와 야외 활동 장소(maps/outdoors)의 점프가 함께 쓴다. Traversal 레이어라 시연 점프(Gameplay) · 상호작용(Interaction)의 Space 와 겹치지 않는다. -->
  <inputMap path="common/input/traversal.input.xml"/>
  <!-- 야외 활동 장소의 위아래(헤엄 · 사다리) · 이모트. -->
  <inputMap path="game/playground/data/outdoors.input.xml"/>
  <!-- 서부 평원(maps/prairie · 마을 maps/hub)의 조작 — 휘파람 · 행동 · 들기와 말의 질주(공통 Sprint). -->
  <inputMap path="game/playground/wildwest/data/wildwest.input.xml"/>
  <!-- 허브 농장 미니게임(minigames/harvestvalley) — 현황(Status)은 공통 메뉴, 농사 키는 꺼진 레이어 Farming(미니게임이 켠다). -->
  <inputMap path="common/input/menu.input.xml"/>
  <inputMap path="game/playground/harvestvalley/data/farm.input.xml"/>
  <!-- 초원 마을 미니게임(minigames/meadowvillage)의 대화 — 꺼진 레이어 CreatureTown(미니게임이 켠다) -->
  <inputMap path="game/playground/meadowvillage/data/town.input.xml"/>
  <!-- 복셀 광산 미니게임(minigames/voxelcraft) — 달리기 · 시선은 공통, 부수기 · 놓기 · 핫바는 Voxel 레이어(미니게임이 켠다) -->
  <inputMap path="common/input/look.input.xml"/>
  <inputMap path="game/playground/voxelcraft/data/voxel.input.xml"/>
  <!-- 도시 건설 미니게임(minigames/frontiertown)의 빨리 감기 — 제 레이어(FastForward)라 시연 점프 · 말 걸기의 Space 와 겹치지 않는다. -->
  <inputMap path="common/input/fastforward.input.xml"/>
  <!-- 테마파크 미니게임(minigames/themepark) — 내려다보는 카메라는 공통, 공원 액션은 ThemePark 레이어(미니게임이 켠다) -->
  <inputMap path="common/input/camera.input.xml"/>
  <inputMap path="common/input/camerapan.input.xml"/>
  <inputMap path="game/playground/themepark/data/park.input.xml"/>
  <!-- 아레나 미니게임(minigames/abilityarena)의 근접 · 화염구 · 회복 · 대시 — 꺼진 레이어 Arena(미니게임이 켠다). -->
  <inputMap path="game/playground/abilityarena/data/arena.input.xml"/>
  <localizationProject>game/playground/data/localization/playground.locproject.xml</localizationProject>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <!-- 시네마틱 시퀀스의 소리 구간 · 허브 농장의 도구 · 미니게임(광산 · 아레나)이 내는 이벤트 -->
  <audioEvents>game/playground/audio/playground.audioevents.xml</audioEvents>
  <!-- 벤치 캐릭터 프리팹(-gv_stressTestCharacterPrefab — 부하 시나리오 load/townsfolk)의 외형은 공용 팩(common)의 외형 데이터다. 외형이 장비 아이템을 참조하므로 아이템도 함께 -->
  <RequiredData kind="items" pack="common"/>
  <RequiredData kind="appearance" pack="common"/>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
