<?xml version="1.0" encoding="utf-8"?>
<?asset guid="d1495cf4de26154a73324b6311e51dd0"?>
<!--
  Playground 의 어빌리티 카탈로그 — 지역 효과 시연(maps/zoneshowcase · surfaceinteraction)과 마을(maps/hub) 주민, 아레나 미니게임(minigames/abilityarena)의 이펙트 · 어빌리티 · 세트.
  지역 프로필(zones/*.zone.xml)은 이펙트를 정본으로 쓴다: 가라앉음은 머문 시간만큼 쌓이는 스택(SinkDepth · MoveSpeedScale 를 스택 수만큼 바꾼다),
  감속은 MovementConstraint 가 읽는 속성(MoveSpeedScale), 상태는 태그(삼켜짐 · 끌려감 · 화상 · 중독). 저항 · 면역은 대상 쪽이다 —
  화염 면역은 이펙트의 BlockedTag(State.Fireproof), 저항은 지역의 식이 대상 속성(FireResist)을 읽는다.
  "ApplyEffects" 는 프레임워크 기본 클래스라 코드 없이 돈다(스킬 영역의 노바).
-->
<AbilityCatalog>

  <!-- 가라앉음: 스택 하나에 0.1 m · 걷는 속도 −10%, 아홉 번까지(0.9 m · 10%). 탈출(RemoveStacksOnJumpComponent)이 스택을 줄인다. -->
  <AbilityEffect id="GE_Sink" duration="Infinite" stacking="AggregateByTarget" stackLimit="9" refreshOnStack="true">
    <Modifier attribute="SinkDepth" op="Add" magnitude="0.1"/>
    <Modifier attribute="MoveSpeedScale" op="Multiply" magnitude="0.9"/>
    <GrantedTag tag="State.Sinking"/>
  </AbilityEffect>

  <!-- 삼켜짐 — 움직이지 못하고 뛰어도 오르지 못한다. -->
  <AbilityEffect id="GE_Engulfed" duration="Infinite">
    <GrantedTag tag="State.Engulfed"/>
    <GrantedTag tag="State.MoveBlocked"/>
  </AbilityEffect>

  <!-- 끌려감 — 사구 안쪽으로 넘은 동안(경고 · 당김은 지역의 다른 모듈). -->
  <AbilityEffect id="GE_Dragged" duration="Infinite">
    <GrantedTag tag="State.Dragged"/>
  </AbilityEffect>

  <!-- 늪의 감속 — 안에 있는 동안 걷는 속도 절반. -->
  <AbilityEffect id="GE_SwampSlow" duration="Infinite">
    <Modifier attribute="MoveSpeedScale" op="Multiply" magnitude="0.5"/>
    <GrantedTag tag="State.Slowed"/>
  </AbilityEffect>

  <!-- 용암 화상 — 피해는 지역이 계산한 값(SetByCaller Data.Damage, 저항을 반영한 식). 화염 면역은 걸리지 않는다. -->
  <AbilityEffect id="GE_LavaBurn" duration="Instant">
    <Modifier attribute="IncomingDamage" op="Add" source="SetByCaller" name="Data.Damage"/>
    <AssetTag tag="Effect.Damage.Fire"/>
    <BlockedTag tag="State.Fireproof"/>
  </AbilityEffect>

  <!-- 불붙음 — 3 초 동안 1 초마다 2. 나와도 남는다. -->
  <AbilityEffect id="GE_Burning" duration="HasDuration" seconds="3" period="1" executeOnApplication="false" stacking="AggregateByTarget" stackLimit="1" refreshOnStack="true">
    <Modifier attribute="IncomingDamage" op="Add" magnitude="2"/>
    <GrantedTag tag="State.Burning"/>
    <BlockedTag tag="State.Fireproof"/>
  </AbilityEffect>

  <!-- 유황 중독 — 4 초 동안 1 초마다 3. 가스를 나와도 묻어 나간다(지역은 지우지 않는다). -->
  <AbilityEffect id="GE_SulfurPoison" duration="HasDuration" seconds="4" period="1" executeOnApplication="false" stacking="AggregateByTarget" stackLimit="1" refreshOnStack="true">
    <Modifier attribute="IncomingDamage" op="Add" magnitude="3"/>
    <GrantedTag tag="State.Poisoned"/>
  </AbilityEffect>

  <!-- 가시 — 찔림 한 번(피해는 지역이 충격 세기로 계산한다). -->
  <AbilityEffect id="GE_ThornPrick" duration="Instant">
    <Modifier attribute="IncomingDamage" op="Add" source="SetByCaller" name="Data.Damage"/>
    <AssetTag tag="Effect.Damage.Physical"/>
  </AbilityEffect>

  <!-- 버프 샘 — 안에 있는 동안 0.5 초마다 회복 5(나오면 지역이 지운다), 들어오면 10 초 가속(나와도 남는다). -->
  <AbilityEffect id="GE_SpringRegen" duration="Infinite" period="0.5" executeOnApplication="false">
    <Modifier attribute="IncomingHealing" op="Add" magnitude="5"/>
    <GrantedTag tag="State.Regenerating"/>
  </AbilityEffect>
  <AbilityEffect id="GE_SpringHaste" duration="HasDuration" seconds="10">
    <Modifier attribute="MoveSpeedScale" op="Multiply" magnitude="1.5"/>
    <GrantedTag tag="State.Hasted"/>
  </AbilityEffect>

  <!-- 스킬 영역 — 영역이 노바를 주고 바로 발동한다. 노바는 5 초 강화 표식을 자기에게 건다. -->
  <AbilityEffect id="GE_NovaMark" duration="HasDuration" seconds="5">
    <GrantedTag tag="State.Empowered"/>
  </AbilityEffect>
  <Ability id="GA_ZoneNova" class="ApplyEffects">
    <AbilityTag tag="Ability.Skill.Nova"/>
    <BlockedTag tag="State.Dead"/>
    <Param name="selfEffect" text="GE_NovaMark"/>
  </Ability>

  <!-- 화염 면역 — 시연 시나리오가 ability.apply 로 건다(화염 정령은 세트의 태그로 가진다). -->
  <AbilityEffect id="GE_Fireproof" duration="Infinite">
    <GrantedTag tag="State.Fireproof"/>
  </AbilityEffect>

  <!-- ===================================================================== -->
  <!-- 세트 — 지역 효과가 읽는 속성(SinkDepth · MoveSpeedScale · FireResist)을 Generic 세트로 둔다 -->
  <!-- ===================================================================== -->

  <AbilitySet id="ZoneWalker">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="100"/>
      <Attribute name="MaxHealth" base="100"/>
      <Attribute name="MoveSpeed" base="4"/>
    </AttributeSet>
    <AttributeSet class="Generic">
      <Attribute name="SinkDepth" base="0"/>
      <Attribute name="MoveSpeedScale" base="1"/>
      <Attribute name="FireResist" base="0"/>
    </AttributeSet>
  </AbilitySet>

  <!-- 화염 저항 절반 — 같은 용암이 반만 데운다(지역의 식 20 * (1 - target.FireResist)). -->
  <AbilitySet id="ZoneResistant">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="100"/>
      <Attribute name="MaxHealth" base="100"/>
      <Attribute name="MoveSpeed" base="4"/>
    </AttributeSet>
    <AttributeSet class="Generic">
      <Attribute name="SinkDepth" base="0"/>
      <Attribute name="MoveSpeedScale" base="1"/>
      <Attribute name="FireResist" base="0.5"/>
    </AttributeSet>
  </AbilitySet>

  <!-- 화염 정령 — 화염 면역(태그)이라 용암 화상이 걸리지 않고, 내비 종류 Spirit 은 용암을 지난다. -->
  <AbilitySet id="FireSpirit">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="100"/>
      <Attribute name="MaxHealth" base="100"/>
      <Attribute name="MoveSpeed" base="4"/>
    </AttributeSet>
    <AttributeSet class="Generic">
      <Attribute name="SinkDepth" base="0"/>
      <Attribute name="MoveSpeedScale" base="1"/>
      <Attribute name="FireResist" base="1"/>
    </AttributeSet>
    <Tag tag="State.Fireproof"/>
  </AbilitySet>

  <!-- ===================================================================== -->
  <!-- 마을 주민(maps/hub 의 Player) — 미니게임 보상은 결과 값 → 이펙트 표(MinigameRewardComponent)로 걸린다 -->
  <!-- ===================================================================== -->

  <!-- 미니게임 보상 회복 — 값의 수(SetByCaller Data.Amount)만큼 체력을 채운다. -->
  <AbilityEffect id="GE_HubRewardHeal" duration="Instant">
    <Modifier attribute="IncomingHealing" op="Add" source="SetByCaller" name="Data.Amount"/>
    <AssetTag tag="Effect.Heal"/>
  </AbilityEffect>

  <!-- 미니게임 보상 버프 아이템 — 60 초 걷는 속도 +20%. -->
  <AbilityEffect id="GE_HubRewardHaste" duration="HasDuration" seconds="60">
    <Modifier attribute="MoveSpeedScale" op="Multiply" magnitude="1.2"/>
    <GrantedTag tag="State.Hasted"/>
  </AbilityEffect>

  <!-- 넘어짐 — 시나리오 automation/hub 가 ability.apply 로 체력을 깎아 보상 회복을 본다. -->
  <AbilityEffect id="GE_HubStumble" duration="Instant">
    <Modifier attribute="IncomingDamage" op="Add" magnitude="50"/>
    <AssetTag tag="Effect.Damage.Physical"/>
  </AbilityEffect>

  <AbilitySet id="HubResident">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="100"/>
      <Attribute name="MaxHealth" base="100"/>
      <Attribute name="MoveSpeed" base="3.5"/>
    </AttributeSet>
    <AttributeSet class="Generic">
      <Attribute name="MoveSpeedScale" base="1"/>
    </AttributeSet>
  </AbilitySet>

  <!-- ===================================================================== -->
  <!-- 아레나 미니게임(minigames/abilityarena) — AbilityArena 키트 유닛의 이펙트 · 어빌리티 · 세트(ArenaPlayer · ArenaGrunt · ArenaCaster).
       클래스 ArenaMeleeStrike · ArenaProjectile · ArenaDash 는 게임 기능 AbilityArena 가 미니게임에 있는 동안 등록한다.
       _base 는 다른 칸만 적는 부모 항목이다(docs/agents/DataInheritance.md). 태그 · 매개변수는 이름으로 합치고 _op="Remove" 로 뺀다. -->
  <!-- ===================================================================== -->

  <!-- ===================================================================== -->
  <!-- 이펙트                                                                 -->
  <!-- ===================================================================== -->

  <!-- 피해 — 원피해는 SetByCaller "Damage"(어빌리티의 damage 매개변수) + 공격력. 방어로 감쇠한다. 무적 중이면 걸리지 않는다. -->
  <AbilityEffect id="GE_Damage_Melee" duration="Instant">
    <Execution class="Damage" setByCaller="Damage" attackPowerCoefficient="1" base="0"/>
    <AssetTag tag="Effect.Damage.Physical"/>
    <BlockedTag tag="State.Invulnerable"/>
    <Cue tag="AbilityPresentation.Hit.Physical"/>
  </AbilityEffect>

  <AbilityEffect id="GE_Damage_Fireball" duration="Instant">
    <Execution class="Damage" setByCaller="Damage" attackPowerCoefficient="0.5" base="0"/>
    <AssetTag tag="Effect.Damage.Fire"/>
    <BlockedTag tag="State.Invulnerable"/>
    <Cue tag="AbilityPresentation.Hit.Fire"/>
  </AbilityEffect>

  <!-- 화상 — 맞은 뒤 3 초 동안 1 초마다 체력 −3, 세 번까지 쌓인다(쌓일 때 시간을 다시 채운다). -->
  <AbilityEffect id="GE_Burn" duration="HasDuration" seconds="3" period="1" executeOnApplication="false"
                  stacking="AggregateByTarget" stackLimit="3" refreshOnStack="true">
    <Modifier attribute="IncomingDamage" op="Add" magnitude="3"/>
    <GrantedTag tag="State.Burning"/>
    <BlockedTag tag="State.Invulnerable"/>
    <Cue tag="AbilityPresentation.Burning"/>
  </AbilityEffect>

  <!-- 가시 — 맞으면 때린 쪽에 고정 피해 2(방어 무시: 메타 어트리뷰트에 바로 더한다). -->
  <AbilityEffect id="GE_Thorns" duration="Instant">
    <Modifier attribute="IncomingDamage" op="Add" magnitude="2"/>
    <BlockedTag tag="State.Invulnerable"/>
  </AbilityEffect>

  <!-- 회복 — 레벨 1 에 25, 레벨마다 +5. 화상을 지운다(정화). -->
  <AbilityEffect id="GE_Heal" duration="Instant">
    <Modifier attribute="IncomingHealing" op="Add" magnitude="25" perLevel="5"/>
    <RemoveEffectsWithTag tag="State.Burning"/>
    <Cue tag="AbilityPresentation.Heal"/>
  </AbilityEffect>

  <!-- 대시 — 0.25 초 동안 이동 속도 ×3, 그동안 무적(피해 이펙트의 BlockedTag). -->
  <AbilityEffect id="GE_Dash" duration="HasDuration" seconds="0.25">
    <Modifier attribute="MoveSpeed" op="Multiply" magnitude="3"/>
    <GrantedTag tag="State.Invulnerable"/>
    <GrantedTag tag="State.Dashing"/>
  </AbilityEffect>

  <!-- 마나 재생 — 지울 때까지 1 초마다 마나 +4. -->
  <AbilityEffect id="GE_ManaRegen" duration="Infinite" period="1" executeOnApplication="false">
    <Modifier attribute="Mana" op="Add" magnitude="4"/>
    <AssetTag tag="Effect.Regen.Mana"/>
  </AbilityEffect>

  <!-- 비용 · 쿨다운 -->
  <AbilityEffect id="GE_Cost_Fireball" duration="Instant">
    <Modifier attribute="Mana" op="Add" magnitude="-15"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cost_Heal" duration="Instant">
    <Modifier attribute="Mana" op="Add" magnitude="-30"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cooldown_Melee" duration="HasDuration" seconds="0.45">
    <GrantedTag tag="Cooldown.Melee"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cooldown_Fireball" duration="HasDuration" seconds="0.8">
    <GrantedTag tag="Cooldown.Skill.Fireball"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cooldown_Heal" duration="HasDuration" seconds="6">
    <GrantedTag tag="Cooldown.Skill.Heal"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cooldown_Dash" duration="HasDuration" seconds="1.5">
    <GrantedTag tag="Cooldown.Skill.Dash"/>
  </AbilityEffect>
  <AbilityEffect id="GE_Cooldown_EnemyMelee" _base="GE_Cooldown_Melee" seconds="1.2"/>
  <AbilityEffect id="GE_Cooldown_EnemyBolt" _base="GE_Cooldown_Fireball" seconds="2.5"/>

  <!-- ===================================================================== -->
  <!-- 어빌리티                                                               -->
  <!-- ===================================================================== -->

  <!-- 근접 — 사거리 안의 가장 가까운 적 하나. 대시 중에는 쓰지 않는다. -->
  <Ability id="GA_Melee" class="ArenaMeleeStrike" cooldown="GE_Cooldown_Melee">
    <AbilityTag tag="Ability.Attack.Melee"/>
    <BlockedTag tag="State.Dead"/>
    <BlockedTag tag="State.Dashing"/>
    <Param name="range" value="2.2"/>
    <Param name="damage" value="12"/>
    <Param name="damageEffect" text="GE_Damage_Melee"/>
  </Ability>

  <!-- 화염구 — 바라보는 쪽으로 날아가 처음 맞은 적에게 피해 + 화상. -->
  <Ability id="GA_Fireball" class="ArenaProjectile" cost="GE_Cost_Fireball" cooldown="GE_Cooldown_Fireball">
    <AbilityTag tag="Ability.Skill.Fireball"/>
    <BlockedTag tag="State.Dead"/>
    <Param name="projectile" text="arena_fireball"/>
    <Param name="damageEffect" text="GE_Damage_Fireball"/>
    <Param name="extraEffect" text="GE_Burn"/>
  </Ability>

  <!-- 회복 — 코드 없이 데이터만(ApplyEffects). -->
  <Ability id="GA_Heal" class="ApplyEffects" cost="GE_Cost_Heal" cooldown="GE_Cooldown_Heal">
    <AbilityTag tag="Ability.Skill.Heal"/>
    <BlockedTag tag="State.Dead"/>
    <Param name="selfEffect" text="GE_Heal"/>
  </Ability>

  <!-- 대시 — 도는 동안 공격을 막는다(BlockTag). -->
  <Ability id="GA_Dash" class="ArenaDash" cooldown="GE_Cooldown_Dash">
    <AbilityTag tag="Ability.Movement.Dash"/>
    <BlockTag tag="Ability.Attack"/>
    <BlockedTag tag="State.Dead"/>
    <Param name="duration" value="0.25"/>
    <Param name="dashEffect" text="GE_Dash"/>
  </Ability>

  <!-- 가시 — 맞으면(Event.Hit) 스스로 발동해 때린 쪽에 GE_Thorns. 데이터만(ApplyEffects). -->
  <Ability id="GA_Thorns" class="ApplyEffects">
    <AbilityTag tag="Ability.Passive.Thorns"/>
    <TriggerTag tag="Event.Hit"/>
    <BlockedTag tag="State.Dead"/>
    <Param name="targetEffect" text="GE_Thorns"/>
  </Ability>

  <!-- 적 근접 · 적 화염탄 — 같은 클래스, 다른 데이터. -->
  <Ability id="GA_EnemyMelee" _base="GA_Melee" cooldown="GE_Cooldown_EnemyMelee">
    <BlockedTag tag="State.Dashing" _op="Remove"/>
    <Param name="range" value="1.8"/>
    <Param name="damage" value="6"/>
  </Ability>

  <Ability id="GA_EnemyBolt" _base="GA_Fireball" cost="" cooldown="GE_Cooldown_EnemyBolt">
    <Param name="projectile" text="arena_bolt"/>
    <Param name="extraEffect" _op="Remove"/>
  </Ability>

  <!-- ===================================================================== -->
  <!-- 어빌리티 세트 — 입력 번호: 1 근접 · 2 화염구 · 3 회복 · 4 대시           -->
  <!-- ===================================================================== -->

  <AbilitySet id="ArenaPlayer">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="120"/>
      <Attribute name="MaxHealth" base="120"/>
      <Attribute name="Mana" base="100"/>
      <Attribute name="MaxMana" base="100"/>
      <Attribute name="AttackPower" base="8"/>
      <Attribute name="Armor" base="10"/>
      <Attribute name="MoveSpeed" base="6"/>
    </AttributeSet>
    <Ability id="GA_Melee" input="1"/>
    <Ability id="GA_Fireball" input="2"/>
    <Ability id="GA_Heal" input="3"/>
    <Ability id="GA_Dash" input="4"/>
    <Effect id="GE_ManaRegen"/>
    <Tag tag="Team.Player"/>
  </AbilitySet>

  <AbilitySet id="ArenaGrunt">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="40"/>
      <Attribute name="MaxHealth" base="40"/>
      <Attribute name="AttackPower" base="4"/>
      <Attribute name="Armor" base="20"/>
      <Attribute name="MoveSpeed" base="3"/>
    </AttributeSet>
    <Ability id="GA_EnemyMelee" input="1"/>
    <Ability id="GA_Thorns"/>
    <Tag tag="Team.Enemy"/>
  </AbilitySet>

  <AbilitySet id="ArenaCaster">
    <AttributeSet class="Combat">
      <Attribute name="Health" base="25"/>
      <Attribute name="MaxHealth" base="25"/>
      <Attribute name="AttackPower" base="6"/>
      <Attribute name="Armor" base="0"/>
      <Attribute name="MoveSpeed" base="2.2"/>
    </AttributeSet>
    <Ability id="GA_EnemyBolt" input="2"/>
    <Tag tag="Team.Enemy"/>
  </AbilitySet>

  <!-- ===================================================================== -->
  <!-- 큐 — 큐 태그(또는 가장 가까운 조상)가 낼 연출. 아레나의 소리는 모두 2D 다    -->
  <!-- ===================================================================== -->
  <AbilityPresentation tag="AbilityPresentation.Hit" sound="ArenaProjectileHit" positional="false"/>

</AbilityCatalog>
