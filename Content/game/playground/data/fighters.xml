<!--
  격투 미니게임(minigames/fighting)의 캐릭터 — 게임 기능 Fighting 이 미니게임 범위에 건다. 프레임 데이터는 fighting/data/ring.moves.xml.
  버튼 이름 1, 2, 3, 4 가 비트 0 .. 3 이고 입력 액션(FightingViewComponent 의 _listButtonAction)과 같은 순서다: 1 손, 2 발, 3 하단, 4 잡기.
  하단(3)은 서서 막지 못하고 잡기(4)는 앉아 피하거나 버튼 4 로 푼다.
-->
<FighterCatalog moves="guid:bd7c9ebd094f49a69f17b16a1664225f" buttons="1,2,3,4">
	<Fighter id="boxer" name="Boxer" health="120" walkSpeed="0.035" sidestep="u" sidestepDown="d,n" jump="u/f">
		<Move id="straight" command="1"/>
		<Move id="hook" command="2"/>
		<Move id="low" command="3"/>
		<Move id="clinch" command="4" breakButtons="4"/>
	</Fighter>
	<Fighter id="wrestler" name="Wrestler" health="150" walkSpeed="0.028" sidestep="u" sidestepDown="d,n" jump="u/f">
		<Move id="straight" command="1"/>
		<Move id="uppercut" command="2"/>
		<Move id="low" command="3"/>
		<Move id="clinch" command="4" breakButtons="4"/>
	</Fighter>
</FighterCatalog>
