<?asset guid="90c3f7d15e2a4b6c8d417fa2b6e05391"?>
<!-- 환경 마당(maps/weathergarden)의 날씨 — 시나리오가 cheat.weather 로 바꾸므로 맑음만 고를 무게를 갖고 나머지는 무게 0 이다(저절로 오지 않는다).
     MaterialBinding: 지면 묶음의 젖음 · 웅덩이 · 눈, 빗방울 링. SceneBinding: skyLight(맑음 1 .. 폭풍 0)가 해 · 하늘을 어둡게, fog 가 안개를 짙게, wind 가 풀 · 천 · 돛의 바람을 세게 한다.
     SoundBinding: 빗소리 · 바람 소리(audio/playground.audioevents.xml). rain · snowfall 은 떨어지는 입자의 세기이기도 하다(PrecipitationComponent). -->
<WeatherCatalog transition="3" materialCollection="engine/materials/weather.matparams.xml">
	<MaterialBinding parameter="Weather" valueX="wetness" valueY="puddle" valueZ="snowfall"/>
	<MaterialBinding parameter="Rain" valueX="rain"/>
	<SceneBinding target="SunIntensity" value="skyLight" atZero="0.25" atOne="1"/>
	<SceneBinding target="SkyIntensity" value="skyLight" atZero="0.35" atOne="1"/>
	<SceneBinding target="FogDensity" value="fog" atZero="1" atOne="5"/>
	<SceneBinding target="WindStrength" value="wind" atZero="1" atOne="2.5"/>
	<SceneBinding target="WindSpeed" value="wind" atZero="1" atOne="8"/>
	<SoundBinding event="Weather.Rain" value="rain" parameter="WeatherRain" opennessParameter="WeatherOpenness"/>
	<SoundBinding event="Weather.Wind" value="wind" parameter="WeatherWind" opennessParameter="WeatherOpenness"/>
	<Weather id="clear" weight="1" minDuration="100000" maxDuration="100000">
		<Values skyLight="1" wetness="0" puddle="0" rain="0" snowfall="0" wind="0" fog="0"/>
	</Weather>
	<Weather id="rain" weight="0" minDuration="100000" maxDuration="100000">
		<Values skyLight="0.4" wetness="1" puddle="0.7" rain="0.7" snowfall="0" wind="0.3" fog="0.3"/>
	</Weather>
	<Weather id="storm" weight="0" minDuration="100000" maxDuration="100000">
		<Values skyLight="0" wetness="1" puddle="0.9" rain="1" snowfall="0" wind="1" fog="1"/>
	</Weather>
	<Weather id="snow" weight="0" minDuration="100000" maxDuration="100000">
		<Values skyLight="0.7" wetness="0.1" puddle="0" rain="0" snowfall="1" wind="0" fog="0.4"/>
	</Weather>
</WeatherCatalog>
