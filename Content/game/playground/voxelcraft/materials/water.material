<?xml version="1.0" encoding="utf-8"?>
<?asset guid="a0e03ba1f37f11fd6d6d9f2b6077d26d"?>
<!-- 블록 청크의 물(반투명) 머티리얼 — 불투명 블록 머티리얼(셰이더 · 아틀라스 · _atlasGrid)을 물려받고 유리 머티리얼과 같은 블렌드를 쓴다. 알파는 메셔의 정점 색이 준다. -->
<MaterialDef formatVersion="0" name="VoxelWater" _base="game/playground/voxelcraft/materials/blocks.material" alphaMode="Blend">
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_BLEND_TRANSLUCENT</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDef>
