<!-- 사격장 팩의 설정 — 시작 맵은 아레나 씬이다(게임마다 팩의 data/gamesettings.xml 하나다).
     inputMap 줄들은 입력 맵 묶음이다 — 기본 맵, 공통 파일들, 맨 끝이 게임 차이다(docs/agents/DataInheritance.md "입력 맵 묶음" 절). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <!-- 덮어쓰기 층 layers/footsteps: 엔진 표면 종류 표의 발걸음 반응에 이 게임의 소리 이벤트(audio/shooter3d.audioevents.xml)를 얹는다. -->
  <Engine _windowTitle="Shooter 3D" _userSettingsSchema="game/playground/data/playground.settings.xml" _telemetrySchema="game/playground/data/playground.telemetry.xml" _bUIPauseMenu="true">
    <_mapUserSettingDefault>
      <entry key="gameplay.fieldOfView">80</entry>
    </_mapUserSettingDefault>
    <_listResourceLayer>
      <item>game/playground/shooter3d/layers/footsteps</item>
    </_listResourceLayer>
  </Engine>
  <startMap>game/playground/shooter3d/maps/arena.scene.xml</startMap>
  <!-- 온라인 세션(OnlineSession) — 연결은 게임이 connect 로 연다. 서버 설정은 Config/Server/Online/Playground.json -->
  <onlineServerAddress>127.0.0.1:17793</onlineServerAddress>
  <onlineGameBuild>1.0.0</onlineGameBuild>
  <onlineRequestRetryLimit>3</onlineRequestRetryLimit>
  <!-- 플레이어 통계 · 업적(PlayerStatsSubsystem) — 업적은 로컬 플랫폼 서비스(SDK 없음)까지 간다 -->
  <statCatalog>game/playground/data/playground.stats.xml</statCatalog>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/move.input.xml"/>
  <inputMap path="common/input/traversal.input.xml"/>
  <inputMap path="common/input/look.input.xml"/>
  <inputMap path="common/input/camera.input.xml"/>
  <inputMap path="common/input/cameraorbit.input.xml"/>
  <inputMap path="game/playground/shooter3d/data/shooter.input.xml"/>
  <localizationProject>game/playground/data/localization/playground.locproject.xml</localizationProject>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/playground/audio/playground.audioevents.xml</audioEvents>
  <!-- 아이템 · 외형은 캐릭터 키트와 함께 공용 팩(common)에 있다 — 자리는 등록 줄의 팩 안 규칙(common/data/items.xml · common/data/appearance) -->
  <RequiredData kind="items" pack="common"/>
  <RequiredData kind="appearance" pack="common"/>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
