<?asset guid="1733b889dcd67cbe0006cf21af50e437"?>
<!-- 허브 카드 탁자 HUD — HubCardHUDViewModel. 앉기 전에는 통째로 접힌다. 카드 글(R5 · W+4)은 문자열 표 HubCard 의 메시지라 그릴 때 풀린다. -->
<UIDocument _schemaVersion="0">
	<UIScreenDef _layer="HUD" _bTakesFocus="false" _bShowCursor="false" />
	<SafeZonePanel _visibility="SelfHitTestInvisible">
		<CanvasPanel _name="Table" _visibility="{bind:_tableVisibility}">
			<BoxPanel _spacing="12" _orientation="Horizontal" _visibility="HitTestInvisible">
				<_slot _anchorMin="0,1" _anchorMax="0,1" _offsetMin="48,-128" _offsetMax="0,-92" _bAutoSize="true" />
				<TextWidget _name="OpponentCount" _text="{bind:_opponentCount}" _styleClass="hud" _bLocalized="false" />
				<TextWidget _text="/" _styleClass="hud" _bLocalized="false" />
				<TextWidget _name="TopCard" _text="{bind:_topCard}" _styleClass="hud" />
			</BoxPanel>
			<BoxPanel _spacing="12" _orientation="Horizontal" _visibility="HitTestInvisible">
				<_slot _anchorMin="0,1" _anchorMax="0,1" _offsetMin="48,-84" _offsetMax="0,-48" _bAutoSize="true" />
				<TextWidget _name="MyTurn" _text="&gt;" _styleClass="hud" _visibility="{bind:_turnVisibility}" _bLocalized="false" />
				<TextWidget _name="Hand" _text="{bind:_hand}" _styleClass="hud" />
			</BoxPanel>
		</CanvasPanel>
	</SafeZonePanel>
</UIDocument>
