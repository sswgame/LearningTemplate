<!--
  정복 미니게임(minigames/sidescrollconquest)의 입력 차이. 지휘관 이동은 공통 Move 축의 좌우다 — Playground 공통 묶음(data/gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다. 게임 코드는 키를 묻지 않고 액션 이름만 묻는다. 한 게임만 쓰는 이름은 게임 접두다.
  레이어 SideScrollConquest 는 꺼져 있고 미니게임의 inputContexts 가 들어가 있는 동안만 켠다 — 허브 · 다른 미니게임의 같은 키와 겹치지 않는다.
-->
<InputMap>
	<layers>
		<layer name="SideScrollConquest" enabled="0" blockLower="0"/>
	</layers>
	<action name="Conquest.Follow" layer="SideScrollConquest" trigger="Pressed">
		<bind source="Key" code="Digit1"/>
		<bind source="Gamepad" code="X"/>
	</action>
	<action name="Conquest.Hold" layer="SideScrollConquest" trigger="Pressed">
		<bind source="Key" code="Digit2"/>
		<bind source="Gamepad" code="Y"/>
	</action>
	<action name="Conquest.Charge" layer="SideScrollConquest" trigger="Pressed">
		<bind source="Key" code="Digit3"/>
		<bind source="Gamepad" code="B"/>
	</action>
	<action name="Conquest.Train" layer="SideScrollConquest" trigger="Pressed">
		<bind source="Key" code="T"/>
		<bind source="Gamepad" code="A"/>
	</action>
</InputMap>
