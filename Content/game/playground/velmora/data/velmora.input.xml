<!--
  액션 어드벤처 미니게임(minigames/velmora)의 입력 차이 — Playground 공통 묶음(data/gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다. 게임 코드는 키를 묻지 않고 액션 이름만 묻는다. 걷기는 공통 `Move` 축이다.
  레이어 Velmora 는 꺼져 있고 미니게임의 inputContexts 가 들어가 있는 동안만 켠다 — 허브 · 다른 미니게임의 같은 키(E · J · Shift)와 겹치지 않는다.
-->
<InputMap>
	<layers>
		<layer name="Velmora" enabled="0" blockLower="0"/>
	</layers>
	<!-- 지역 전투: 공격 · 대시 -->
	<action name="Velmora.Attack" layer="Velmora" trigger="Pressed">
		<bind source="Key" code="J"/>
		<bind source="Gamepad" code="X"/>
	</action>
	<action name="Velmora.Dash" layer="Velmora" trigger="Pressed">
		<bind source="Key" code="LeftShift"/>
		<bind source="Gamepad" code="B"/>
	</action>
	<!-- 곁의 봉화를 켜거나 야영지에서 쉰다 -->
	<action name="Velmora.Use" layer="Velmora" trigger="Pressed">
		<bind source="Key" code="E"/>
		<bind source="Gamepad" code="A"/>
	</action>
</InputMap>
