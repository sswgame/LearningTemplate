<!--
  게임 중 꾸미기 ⑤ 굽 신발 · 다리 길이 — 무대 maps/bodycustomization 의 Dancer(해골 전사, 애니메이터 · 발 디딤 리그 skeleton_bodydemo · 몸 동작).
  시작에 외형을 CustomizeDancer 로 바꾼다(굽 기본층이 없는 몸 프로필 — 굽은 신발 칸 Feet 만 올린다, 체형 슬라이더 스키마 SkeletonBody).
  ⑴ 굽 신발(heels_high — 몸 채널 Heel.Height 0.1, 섞기 Max)을 신으면 발 들림이 0.1 이 되고(체형 축 footLiftAxis → 발 디딤 IK 입력) 두 발이 땅에 닿는다(ground_hits 2),
  ⑵ 낮은 장화(boots_low 0.03)로 바꾸면 0.03 — 앞 신발의 층이 남지 않는다, ⑶ 벗으면 0, ⑷ 굽 + 다리 길이 극값(LegLength ±1)에서도 두 발이 닿는다,
  ⑸ 게임 세이브 · 불러오기 뒤에도 신발 · 다리 길이가 같다(외형 상태 — 슬롯 덮어쓰기 · 게임 선택이 세이브에 실린다).
  대기 중 애니메이션(Idle_Combat)이 돌아 사진은 프레임마다 다르다 — 값으로 판정한다(bodydynamics 와 같다). 실행: App -scenario=game/playground/automation/customizeheels.scenario.xml -unattended
-->
<Scenario name="game.playground.customizeheels" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/bodycustomization.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="exec Dancer setPreset CustomizeDancer 0"/>
	<WaitUntil watch="Appearance.Preset" target="Dancer" is="CustomizeDancer" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>

	<!-- ⑴ 굽 신발 -->
	<DevCommand line="exec Dancer setSlotItem Feet heels_high"/>
	<WaitUntil watch="Appearance.SlotItem" target="Dancer" key="Feet" is="heels_high" timeoutFrames="10"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0.1" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.foot_lift" near="0.1" tolerance="0.001" timeoutFrames="60"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>

	<!-- ⑵ 낮은 장화로 바꾼다 — 높은 굽 층이 남으면 Max 가 0.1 을 지킨다 -->
	<DevCommand line="exec Dancer setSlotItem Feet boots_low"/>
	<WaitUntil watch="Appearance.SlotItem" target="Dancer" key="Feet" is="boots_low" timeoutFrames="10"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0.03" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.foot_lift" near="0.03" tolerance="0.001" timeoutFrames="60"/>

	<!-- ⑶ 벗는다 -->
	<DevCommand line="exec Dancer setSlotItem Feet"/>
	<WaitUntil watch="Appearance.SlotItem" target="Dancer" key="Feet" is="(empty)" timeoutFrames="10"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>

	<!-- ⑷ 굽 + 다리 길이 극값 — 늘인 다리 · 줄인 다리 모두 두 발이 땅에 닿는다 -->
	<DevCommand line="exec Dancer setSlotItem Feet heels_high"/>
	<DevCommand line="exec Dancer applySliderValue LegLength 1"/>
	<WaitUntil watch="Appearance.Value" target="Dancer" key="LegLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0.1" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>
	<Store watch="Appearance.SocketOffset" target="Dancer" key="Eyes.y" as="eyesLong"/>
	<DevCommand line="exec Dancer applySliderValue LegLength -1"/>
	<WaitUntil watch="Appearance.Value" target="Dancer" key="LegLength" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.SocketOffset" target="Dancer" key="Eyes.y" differsFrom="eyesLong" timeoutFrames="10"/> <!-- 다리 길이가 눈높이를 바꿨다 -->
	<Screenshot file="customizeheels_short.ppm"/>

	<!-- ⑸ 세이브 · 불러오기 — 세이브 뒤 신발 · 다리를 바꿔 두고 불러오면 되돌아온다 -->
	<Store watch="Save.Written" as="writtenBefore"/>
	<DevCommand line="game.save customize/heels"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<DevCommand line="exec Dancer setSlotItem Feet boots_low"/>
	<DevCommand line="exec Dancer applySliderValue LegLength 0"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0.03" tolerance="0.001" timeoutFrames="30"/>
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.load customize/heels"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Preset" target="Dancer" is="CustomizeDancer"/>
	<Expect watch="Appearance.SlotItem" target="Dancer" key="Feet" is="heels_high"/>
	<Expect watch="Appearance.Value" target="Dancer" key="LegLength" near="-1"/>
	<WaitUntil watch="Body.FootLift" target="Dancer" near="0.1" tolerance="0.001" timeoutFrames="30"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01" timeoutFrames="300"/>
	<Pass/>
</Scenario>
