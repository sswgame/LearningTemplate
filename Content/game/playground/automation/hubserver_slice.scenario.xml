<?asset guid="bad0fd52a6863c00ebb40cc8f2dbcbe9"?>
<!--
  장르 수직 슬라이스(G1, 허브 서버 — 옛 게임 LanternVale) — 시작 → 목표(hubserver_rules.scenario.xml 의 단계 그대로) → 결과 → 저장 · 복원 해시 동일.
  목표 단계는 그 시나리오가 정본이다 — 거기를 고치면 이 파일도 맞춘다. 저장 슬롯은 hubserver/slice.
-->
<Scenario name="game.playground.hubserver_slice" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/hub.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Hub.RulesValid" equals="1" timeoutFrames="30"/> <!-- 규칙 표를 읽었다 -->
	<Expect watch="Hub.NetRole" equals="0"/>
	<!-- 저장 → 세계를 더 돌림 → 두 번 복원: 같은 슬롯을 두 번 불러온 직후의 씬 상태 해시가 같아야 한다(복원이 세계를 다 되살린다 — 저장 순간의 해시와 견주면 명령이 도는 프레임만큼 흔들린다) -->
	<DevCommand line="game.save hubserver/slice"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<AdvanceSimulation frames="60"/> <!-- 저장 · 복원 사이 세계를 더 돌린다(시간이 내용) -->
	<DevCommand line="game.load hubserver/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="10"/>
	<RecordStateHash key="restored"/>
	<AdvanceSimulation frames="60"/> <!-- 저장 · 복원 사이 세계를 더 돌린다(시간이 내용) -->
	<DevCommand line="game.load hubserver/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="2" timeoutWallSeconds="10"/>
	<ExpectStateHash key="restored"/>
	<Pass/>
</Scenario>
