<!--
  일시정지 → 옵션 → 뒤로 → 재개 — 정지 메뉴가 떠 있는 동안 게임 시간이 멈추고(Time.Paused — UIScreenDef _bPausesGame 의 정지 요청), 옵션 화면이 위에 쌓였다가
  뒤로 가기로 빠지면 정지 메뉴의 포커스(Options)가 돌아오며(화면 스택의 포커스 기억), 재개하면 시간이 다시 간다. 키보드 한 바퀴, 패드(Start · B) 한 바퀴.
  Playground 팩은 gamesettings 의 _bUIPauseMenu 로 정지 메뉴를 켠다. 무대는 애니메이션 없는 rendertest3d.
  실행: ctest -R Scenario.playground (체인)
-->
<Scenario name="game.playground.pausemenu" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/rendertest3d.scene.xml"/>
	<ExpectUI screen="none"/>
	<Expect watch="Time.Paused" equals="0"/>

	<!-- 키보드: Esc 는 사람의 누름처럼 여러 프레임 — 같은 누름의 뒤로 가기가 막 연 메뉴를 닫지 않는다 -->
	<Tap slot="Key.Escape" hold="6"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/pause.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="Time.Paused" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="UI.FocusedWidget" is="Resume" timeoutFrames="10"/> <!-- 키보드로 열었다 — 탐색 방식이라 기본 포커스가 선다 -->
	<Tap slot="Key.Down" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Options" timeoutFrames="10"/>
	<Tap slot="Key.Enter" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/options.ui.xml" timeoutFrames="30"/>
	<Expect watch="Time.Paused" equals="1"/>
	<ExpectUI screens="2"/>
	<Tap slot="Key.Escape" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/pause.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="UI.FocusedWidget" is="Options" timeoutFrames="10"/> <!-- 덮였던 화면의 포커스가 돌아온다 -->
	<Expect watch="Time.Paused" equals="1"/>
	<Tap slot="Key.Up" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Resume" timeoutFrames="10"/>
	<Tap slot="Key.Enter" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="none" timeoutFrames="30"/>
	<WaitUntil watch="Time.Paused" equals="0" timeoutFrames="30"/> <!-- 닫기 애니메이션이 끝나면 정지 요청을 푼다 -->

	<!-- 패드: Start 로 열고 B(뒤로)로 닫는다 -->
	<Tap slot="Gamepad.Start" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/pause.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="Time.Paused" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="UI.FocusedWidget" is="Resume" timeoutFrames="10"/>
	<Tap slot="Gamepad.B" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="none" timeoutFrames="30"/>
	<WaitUntil watch="Time.Paused" equals="0" timeoutFrames="30"/>
	<Pass/>
</Scenario>
