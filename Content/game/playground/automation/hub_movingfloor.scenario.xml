<?asset guid="9c1f3d6a7b5e48d2a0c4e7f18b2d6053"?>
<!--
  허브의 움직이는 바닥 셋 — 혼자(접속 없음). 바닥은 틱의 함수(InterpToMovement)이고 위의 플레이어는 물리가 실어 나른다.
  ① 왕복 발판(FloorShuttle): 바닥 X 가 끝(9) 가까이 갈 때 플레이어가 함께 가 있고 떨어지지 않는다.
  ② 승강기(FloorLift): 바닥이 끝(Y 3.1) 가까이 오르면 플레이어도 그 윗면에 있고, 내려오면 함께 내려온다.
  ③ 회전판(FloorRotating): 가운데에서 1 m 벗어나 선 플레이어가 돈 뒤에도 판 위에 있다.
  실행: App -scenario=game/playground/automation/hub_movingfloor.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.hub_movingfloor" fixedDelta="0.0166667" timeoutFrames="4000" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/hub.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<!-- ① 왕복 발판 — 시작 쪽에 있을 때 올라선다 -->
	<WaitUntil watch="Object.X" target="FloorShuttle" atMost="5.3" timeoutFrames="600"/>
	<DevCommand line="teleport Player 5.3 0.3 -12"/>
	<WaitUntil watch="Object.X" target="FloorShuttle" atLeast="8.5" timeoutFrames="600"/>
	<Expect watch="Object.X" target="Player" atLeast="7.5"/>
	<Expect watch="Object.Y" target="Player" near="0.2" tolerance="0.15"/>
	<!-- ② 승강기 — 바닥에 있을 때 올라선다 -->
	<WaitUntil watch="Object.Y" target="FloorLift" atMost="0.3" timeoutFrames="600"/>
	<DevCommand line="teleport Player 5 0.5 -20"/>
	<WaitUntil watch="Object.Y" target="FloorLift" atLeast="2.9" timeoutFrames="600"/>
	<Expect watch="Object.Y" target="Player" atLeast="2.8"/>
	<Expect watch="Object.X" target="Player" near="5" tolerance="0.3"/>
	<WaitUntil watch="Object.Y" target="FloorLift" atMost="0.4" timeoutFrames="600"/>
	<Expect watch="Object.Y" target="Player" atMost="1"/>
	<!-- ③ 회전판 — 가운데에서 1 m 벗어나 선다. 판은 초당 30 도 돈다 — 반 바퀴(6 초)쯤이면 반대쪽에 와 있다 -->
	<DevCommand line="teleport Player 6 0.3 -28"/>
	<WaitUntil watch="Object.X" target="Player" atMost="4.6" timeoutFrames="480"/>
	<Expect watch="Object.Y" target="Player" near="0.2" tolerance="0.15"/>
	<Expect watch="Object.X" target="Player" near="5" tolerance="1.6"/>
	<Expect watch="Object.Z" target="Player" near="-28" tolerance="1.6"/>
	<Pass/>
</Scenario>
