<!--
  근접 판정 · 체력(MeleeHitboxComponent · AbilitySystemComponent 의 전투 세트, maps/meleeduel) — 값으로 판정한다(골든 없음).
  ① 휘두르기(개발 명령 exec … beginAttack — 게임의 공격 입력 · AI 가 부르는 beginAttack 과 같은 함수)가 칼날 안의 Dummy 를 한 번 맞혀 HP 30 → 20(방어 0).
  ② 한 창 안에서는 같은 대상을 다시 맞히지 않는다. ③ 다음 휘두르기(25)로 쓰러진다. 휘두른 쪽(공격자 계층)은 맞지 않는다.
  ④ 기믹 피해(폭발 통의 반경 피해)도 같은 맞음 길로 어빌리티 시스템의 체력을 깎는다 — 도화선 0.5 초 FuseBarrel 이 거리 2 의 BlastDummy 를 HP 100 → 60.
  실행: App -scenario=game/playground/automation/meleeduel.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.meleeduel" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/meleeduel.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Ability.Attribute" target="Dummy" key="Health" equals="30"/>

	<DevCommand line="exec Fighter beginAttack 10 0.2"/>
	<WaitUntil watch="Ability.Attribute" target="Dummy" key="Health" equals="20" timeoutFrames="5"/>
	<AdvanceSimulation frames="20"/> <!-- 한 번 휘두름은 한 번 맞힌다 — 20 프레임 동안 더 깎이지 않는다(일어나지 않음 — 시간이 내용) -->
	<Expect watch="Ability.Attribute" target="Dummy" key="Health" equals="20"/>
	<Expect watch="Ability.Attribute" target="Fighter" key="Health" equals="50"/>

	<DevCommand line="exec Fighter beginAttack 25 0.2"/>
	<WaitUntil watch="Ability.Attribute" target="Dummy" key="Health" atMost="0" timeoutFrames="5"/>
	<Expect watch="Ability.HasTag" target="Dummy" key="State.Dead" equals="1"/>
	<WaitUntil watch="Ability.Attribute" target="BlastDummy" key="Health" equals="60" timeoutFrames="120"/>
	<Expect watch="Ability.Attribute" target="BlastDummy" key="Health" equals="60"/>
	<Expect watch="Object.Property" target="FuseBarrel" key="ExplosiveBarrelComponent._bExploded" equals="1"/>
	<Pass/>
</Scenario>
