<?xml version="1.0" encoding="utf-8"?>
<?asset guid="75fbd32bbdbddc1f880216e2fd3cc32d"?>
<!--
  표정(FacialAnimationComponent · FacialRig) — 무대 maps/facial. 그리는 메시의 모프 가중치로 판정한다(골든 없음).
  ① 쉬는 얼굴은 모든 모프가 0 ② Happy 0.5 → 리그 데이터대로 smile 0.5 · mouthWide 0.15 ③ Surprised 1 을 더하면 타깃마다 더해진다 ④ 표정을 0 으로 되돌리면 모프도 0 ⑤ 리그에 없는 표정은 거절한다.
  실행: App -scenario=game/playground/automation/facial.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.facial" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/facial.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Animation.MorphWeight" target="Head" key="smile" equals="0" timeoutFrames="60"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="jawOpen" equals="0"/>
	<!-- ② -->
	<DevCommand line="face.expression Head Happy 0.5"/>
	<WaitUntil watch="Animation.MorphWeight" target="Head" key="smile" near="0.5" tolerance="0.001" timeoutFrames="10"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="mouthWide" near="0.15" tolerance="0.001"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="jawOpen" equals="0"/>
	<!-- ③ -->
	<DevCommand line="face.expression Head Surprised 1"/>
	<WaitUntil watch="Animation.MorphWeight" target="Head" key="jawOpen" near="0.6" tolerance="0.001" timeoutFrames="10"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="mouthRound" near="0.4" tolerance="0.001"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="smile" near="0.5" tolerance="0.001"/>
	<!-- ④ -->
	<DevCommand line="face.expression Head Happy 0"/>
	<DevCommand line="face.expression Head Surprised 0"/>
	<WaitUntil watch="Animation.MorphWeight" target="Head" key="smile" equals="0" timeoutFrames="10"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="jawOpen" equals="0"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="mouthWide" equals="0"/>
	<!-- ⑤ -->
	<DevCommand line="face.expression Head Sleepy 1"/>
	<ExpectLog id="DevCommand.Reply" contains="has no expression 'Sleepy'" atLeast="1"/>
	<Expect watch="Animation.MorphWeight" target="Head" key="smile" equals="0"/>
	<Pass/>
</Scenario>
