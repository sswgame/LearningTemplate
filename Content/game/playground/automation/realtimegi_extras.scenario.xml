<?xml version="1.0" encoding="utf-8"?>
<?asset guid="8ca28bcb0e14cc1e67125afe66aa0eb9"?>
<!--
  실시간 프로브의 하늘 가림 · 발광(LightProbeVolumeComponent::_realtimeSkyOcclusion · _realtimeEmissiveIntensity) — 두 값이 0 인 무대(이전 그림)와 1 인 무대를 같은 실행에서 견준다.
  켜면 발광 큐브(머티리얼 _emissiveColor)의 빛이 프로브를 거쳐 큰 큐브 옆면 · 바닥을 물들이고(probe_update.hlsl 의 발광 칸), 반사 앰비언트가 프로브의 하늘 보임만큼 가려진다(lighting.hlsli).
  음성 대조(ExpectImagesDiffer) — 두 설정이 그림을 바꾸지 않으면 진다. 켠 그림은 골든으로도 지킨다(통합에서 기록).
  실행: ctest -R Scenario.game.playground.realtimegi_extras
-->
<Scenario name="game.playground.realtimegi_extras" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/realtimegi_extras_off.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Render.GIError" atMost="1" timeoutFrames="300"/> <!-- 실시간 프로브가 돌기 시작했다(그 전에는 값이 없다 — 정착 조건이 해당 없음으로 지나가지 않게) -->
	<Screenshot file="realtimegi_extras_off.ppm" stability="Render"/>
	<Expect watch="Render.GIError" atMost="0.0002"/> <!-- 사진이 실시간 GI 정착(RenderRealtimeGI — 30 번 갱신, 주기 4 · 섞기 0.25 의 남은 몫 0.75^30)을 기다렸다 -->
	<LoadScene path="guid:07c42e3304836cc68a6cba3eec9d7495" timeoutFrames="600"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Render.GIError" atMost="1" timeoutFrames="300"/> <!-- 실시간 프로브가 돌기 시작했다(그 전에는 값이 없다 — 정착 조건이 해당 없음으로 지나가지 않게) -->
	<Screenshot file="realtimegi_extras_on.ppm" stability="Render"/>
	<Expect watch="Render.GIError" atMost="0.0002"/> <!-- 사진이 실시간 GI 정착(RenderRealtimeGI — 30 번 갱신, 주기 4 · 섞기 0.25 의 남은 몫 0.75^30)을 기다렸다 -->
	<!-- 발광이 물들이는 자리는 발광 큐브 둘레 바닥(화면 아래 y 0.6~0.95)이다 — 위쪽 띠(0.3~0.7)는 그 끝만 걸쳐 0.5% 였다. -->
	<ExpectImagesDiffer first="realtimegi_extras_off.ppm" second="realtimegi_extras_on.ppm" region="0,0.6,1,0.95" minDiffering="0.05"/>
	<ExpectImage file="realtimegi_extras_on.ppm" golden="realtimegi_extras"/>
	<Pass/>
</Scenario>
