<!--
  충돌 채널 · 응답 · 프로필 — 무대 maps/collisionprofiles.
  ① 투사체(Bolt, 프로필 Projectile)를 켜면 날아가 트리거(Gate, Trigger)는 겹침만 내며 지나가고(Physics.OverlapCount 1 → 0), Pawn(Guard, Character)에 막혀 선다.
  ② 눈(Eye)에서 +X 로 쏜 Camera 트레이스는 Pawn(Watcher)을 무시하고 벽(Wall)에 맞고(7.5 m), Visibility 트레이스는 Watcher 에 맞는다(2.5 m).
  값으로 판정한다(골든 없음). 실행: App -scenario=game/playground/automation/collisionprofiles.scenario.xml -unattended
-->
<Scenario name="game.playground.collisionprofiles" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/collisionprofiles.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Physics.TraceDistance" target="Eye" key="Camera" near="7.5" tolerance="0.05"/>
	<Expect watch="Physics.TraceDistance" target="Eye" key="Visibility" near="2.5" tolerance="0.05"/>
	<Expect watch="Physics.OverlapCount" target="Gate" equals="0"/>

	<DevCommand line="object.active Bolt 1"/> <!-- 켜면 다음 틱에 +X 10 m/s 로 날아간다 -->
	<WaitUntil watch="Physics.OverlapCount" target="Gate" equals="1" timeoutFrames="60"/> <!-- 트리거를 지나는 동안 겹침 -->
	<WaitUntil watch="Physics.OverlapCount" target="Gate" equals="0" timeoutFrames="30"/>
	<WaitUntil watch="Object.Speed" target="Bolt" atMost="0.5" timeoutFrames="120"/> <!-- Pawn 에 막혀 섰다 -->
	<Expect watch="Object.X" target="Bolt" atMost="-0.5"/>
	<Expect watch="Object.X" target="Bolt" atLeast="-1.5"/>
	<Pass/>
</Scenario>
