<?xml version="1.0" encoding="utf-8"?>
<?asset guid="43d0e68b5ae4e92d87b62696bcb55d9a"?>
<!--
  액션 어드벤처 미니게임(velmora — 옛 게임 Velmora)의 확장 팩 세이브 승계 두 번 기동 ① — 확장 팩 없이 기본 퀘스트(ember_oath)를 끝내고 슬롯 velmora/carry 에 저장하고 끝낸다.
  ② velmora_carry.2 가 확장 팩(velmora_tidecaves)을 켜고 다시 기동해 이 세이브를 불러 잇는다. 혼자 돌면 ② 의 전제를 만들 뿐이라 게임 체인은 이 폴더(sequence/)를 줍지 않는다.
  CTest 항목 Scenario.playground.sequence.velmora_carry 가 ① → ② 를 잇는다(Test/Scenario/RunStateDirPair.cmake). 세이브 슬롯은 사용자 데이터 폴더의 velmora/ 그룹이다.
  길은 automation/velmora_vale 과 같다(자리 · 공격 수는 그 머리말).
-->
<Scenario name="game.playground.velmora_carry.1" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="velmora"/>
	<WaitUntil watch="Adventure.Region" is="hearth" timeoutFrames="120"/>
	<Expect watch="Mods.ActiveCount" equals="0"/>
	<ActionAxis name="Move" x="1" seconds="3.3333"/>
	<WaitUntil watch="Adventure.PlayerX" near="20" tolerance="0.05" timeoutSeconds="4.5"/> <!-- 누른 이동이 끝나 그 자리에 섰다 -->
	<ActionAxis name="Move" y="1" seconds="0.6667"/>
	<WaitUntil watch="Adventure.PlayerZ" near="4" tolerance="0.05" timeoutSeconds="1.5"/> <!-- 누른 이동이 끝나 그 자리에 섰다 -->
	<Action name="Velmora.Use"/>
	<WaitUntil watch="Session.Flag" key="velmora.beacon.fernwood" atLeast="1" timeoutFrames="10"/> <!-- 봉화가 켜졌다 -->
	<ExpectLog id="Adventure.BeaconLit" count="1"/>
	<ActionAxis name="Move" y="-1" seconds="0.6667"/>
	<WaitUntil watch="Adventure.PlayerZ" near="0" tolerance="0.05" timeoutSeconds="1.5"/> <!-- 누른 이동이 끝나 그 자리에 섰다 -->
	<ActionAxis name="Move" x="1" seconds="1.75"/>
	<WaitUntil watch="Adventure.PlayerX" near="30.5" tolerance="0.05" timeoutSeconds="3"/> <!-- 누른 이동이 끝나 그 자리에 섰다 -->
	<Expect watch="Velmora.Phase" equals="1"/>
	<Expect watch="Adventure.PlayerX" near="30.5" tolerance="0.2"/>
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Velmora.AttackReady" equals="1" timeoutSeconds="1"/> <!-- 공격 쿨다운이 끝났다 -->
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Velmora.Phase" equals="3" timeoutFrames="180"/>
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Velmora.AttackReady" equals="1" timeoutSeconds="1"/> <!-- 공격 쿨다운이 끝났다 -->
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Velmora.AttackReady" equals="1" timeoutSeconds="1"/> <!-- 공격 쿨다운이 끝났다 -->
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Velmora.AttackReady" equals="1" timeoutSeconds="1"/> <!-- 공격 쿨다운이 끝났다 -->
	<Action name="Velmora.Attack"/>
	<WaitUntil watch="Quest.Status" target="ember_oath" is="Completed" timeoutFrames="60"/>
	<Expect watch="Session.Money" equals="50"/>
	<DevCommand line="game.save velmora/carry"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<Pass/>
</Scenario>
