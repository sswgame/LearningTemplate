<!--
  사격장 키 다시 잡기 두 번 기동 ① — 점프 키를 J 로 바꿔 사용자 설정 파일에 남기고 끝낸다(설정을 되돌리지 않는다).
  ② rebind.2 가 같은 설정 파일로 다시 기동해 J 가 남았는지 본다. 혼자 돌면 ② 의 전제를 만들 뿐이라 게임 체인은 이 폴더(sequence/)를 줍지 않는다.
  CTest 항목 Scenario.playground.sequence.shooter3d_rebind 가 빈 폴더의 설정 파일(-gv_userSettingsFile)로 ① → ② 를 잇는다(IntegrationTests/Scenario/RunStateDirPair.cmake).
  (예전 이름 rebindsave — 쌍 규칙 <묶음>.1 · .2 에 맞춰 바꿨다)
-->
<Scenario name="game.playground.shooter3d_rebind.1" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="shooter3d"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<DevCommand line="settings.apply controls.shooterJump=Key.J"/>
	<AdvanceSimulation frames="12"/> <!-- 바인딩 적용 · 자동 플레이를 끈 뒤 간격(볼 상태가 없다) -->
	<Tap slot="Key.J" hold="1"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.70" timeoutSeconds="1.2"/> <!-- 내려앉았다 -->
	<WaitUntil watch="Shooter.OnGround" equals="1" timeoutFrames="30"/> <!-- 서 있다 -->
	<Pass/>
</Scenario>
