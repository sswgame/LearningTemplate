<!--
  사격장 키 다시 잡기 — 옵션 메뉴와 같은 길(settings.apply → 사용자 설정 → 입력 맵)로 점프 키를 Space 에서 J 로 바꾸면 J 가 점프하고 Space 는 더는 점프하지 않으며,
  같은 액션의 다른 바인딩(패드 A)은 그대로 점프한다(패드 실기 입력은 가상 패드 device="Gamepad" 로 같은 길을 지난다).
  무인 실행은 실행마다 새 사용자 설정 파일을 쓴다(UserSettingsManager) — 예전의 -gv_userSettingsFile 돌리기는 필요 없다. 앞뒤 단계로 새는 바꾼 키는 단계 되돌리기(UserSettingsManager::restoreStageBaseline)가 막는다.
  재시작 뒤 유지(저장 → 새 프로세스가 읽기 → 입력 맵 반영)는 sequence/rebind.1 · rebind.2 쌍이 본다. 개발 명령이 없는 구성(Shipping)은 건너뛴다.
  "Space 는 점프하지 않는다" 는 일어나지 않음을 보는 단언이라 고정 대기 뒤에 본다.
  실행: App -scenario=game/playground/automation/shooter3d_rebind.scenario.xml -unattended (체인: ctest -R Scenario.playground.shooter3d)
-->
<Scenario name="game.playground.shooter3d_rebind" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="shooter3d"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<!-- 기본 키 Space 로 점프한다. -->
	<AdvanceSimulation frames="12"/> <!-- 바인딩 적용 · 자동 플레이를 끈 뒤 간격(볼 상태가 없다) -->
	<Tap slot="Key.Space" hold="1"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.70" timeoutSeconds="1.2"/> <!-- 내려앉았다 -->

	<!-- Jump 를 J 로 다시 잡는다. 이제 Space 는 점프하지 않는다. -->
	<WaitUntil watch="Shooter.OnGround" equals="1" timeoutFrames="30"/> <!-- 서 있다 -->
	<DevCommand line="settings.apply controls.shooterJump=Key.J"/>
	<AdvanceSimulation frames="5"/> <!-- 바인딩 적용 간격(볼 상태가 없다) -->
	<Tap slot="Key.Space" hold="1"/>
	<AdvanceSimulation frames="12"/> <!-- 0.2 초 동안 점프하지 않는지 본다 -->
	<Expect watch="Object.Y" target="Player" atMost="1.74"/>

	<!-- J 가 점프한다. -->
	<WaitUntil watch="Shooter.OnGround" equals="1" timeoutFrames="30"/> <!-- 서 있다 -->
	<Tap slot="Key.J" hold="1"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.70" timeoutSeconds="1.2"/> <!-- 내려앉았다 -->

	<!-- 같은 액션의 패드 바인딩(A)은 그대로다. -->
	<WaitUntil watch="Shooter.OnGround" equals="1" timeoutFrames="30"/> <!-- 서 있다 -->
	<Action name="Jump" device="Gamepad"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.70" timeoutSeconds="1.2"/> <!-- 내려앉았다 -->
	<WaitUntil watch="Shooter.OnGround" equals="1" timeoutFrames="30"/> <!-- 서 있다 -->
	<Pass/>
</Scenario>
