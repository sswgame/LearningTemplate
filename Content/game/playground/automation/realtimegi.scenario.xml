<!--
  실시간 라이트 프로브 갱신(LightProbeVolumeComponent::_bRealtime, 결정 기록 5-5 R6) — 직접광이 거의 닿지 않는 큐브 옆면이 바닥에서 튕긴 빛(프로브의 간접광)으로 밝아진다.
  프로브 갱신 컴퓨트(probe_update.hlsl)가 돌지 않으면 그 면은 앰비언트 0 이라 거의 검다. 무대: maps/realtimegi (갱신 주기 4 프레임 · 섞는 비율 0.25 라 몇 십 프레임이면 수렴한다).
  결정적: 애니메이션 없는 무대, 고정 프레임 시간. 광선 방향은 프로브 · 프레임마다 정해진 해시라 실행마다 같다.
  실행: ctest -R Scenario.game.playground.realtimegi
        (ctest 가 <Launch> 를 명령줄로 옮긴다. Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.playground.realtimegi" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/realtimegi.scene.xml"/>
	<WaitUntil watch="Render.GIError" atMost="1" timeoutFrames="300"/> <!-- 실시간 프로브가 돌기 시작했다(그 전에는 값이 없다 — 정착 조건이 해당 없음으로 지나가지 않게) -->
	<Screenshot file="realtimegi.ppm" stability="render"/>
	<Expect watch="Render.GIError" atMost="0.0002"/> <!-- 사진이 실시간 GI 정착(RenderRealtimeGI — 30 번 갱신, 주기 4 · 섞기 0.25 의 남은 몫 0.75^30)을 기다렸다 -->
	<ExpectImage file="realtimegi.ppm" golden="realtimegi" region="0.4,0.4,0.6,0.55"/>
	<Pass/>
</Scenario>
