<?xml version="1.0" encoding="utf-8"?>
<?asset guid="568ac94dcbee401eb56bc01fec12dcb8"?>
<!--
  그리지 않는 진행(AdvanceSimulation)이 그리며 진행한 것과 같은 게임 상태를 내는지 — 2D 물리 묶음(캐릭터 낙하 · 힌지 판 · 시한 폭탄 상자)을 두 번 연다.
  첫 길은 <AdvanceSimulation render="true"> 로 120 프레임을 모두 그리며 흘리고 씬 변환 해시를 담는다. 둘째 길은 같은 씬을 다시 열어 <AdvanceSimulation> 으로 같은 120 프레임을 흘리고 해시가 같은지 본다.
  두 길은 같은 단계 · 같은 프레임 수다(씬 열기는 설 때까지 붙잡는다 — 붙잡은 프레임은 두 길이 같다). 둘째 길도 마지막 몇 프레임(GoldenImage.json 의 _advanceDrawnFrames)은 그린다 — 그래도 해시는 같아야 한다.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/advancesimulation.scenario.xml -unattended
-->
<Scenario name="game.playground.advancesimulation" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/twodphysics.scene.xml"/>
	<Launch variable="gv_renderPipeline" value="engine/pipeline/forward2dpipeline.xml"/>
	<!-- 첫 길: 그리며 진행 -->
	<LoadScene path="guid:5cad7c59138b3cc560e7632ebc7ef34b" timeoutFrames="600"/>
	<AdvanceSimulation frames="120" render="true"/>
	<Store watch="Scene.TransformHash" as="drawn"/>
	<!-- 둘째 길: 같은 씬을 다시 열어 그리지 않고 진행 -->
	<LoadScene path="guid:5cad7c59138b3cc560e7632ebc7ef34b" timeoutFrames="600"/>
	<AdvanceSimulation frames="120"/>
	<Expect watch="Scene.TransformHash" sameAs="drawn"/>
	<Pass/>
</Scenario>
