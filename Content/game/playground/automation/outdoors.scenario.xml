<!--
  이동 방식 · 텔레포트 · 이모트 · 미니맵(maps/outdoors). 플레이어를 키로 움직인다(Move W/A/S/D · Jump Space · 위아래 R/F · 이모트 G/H).
  ① 사다리: 벽 쪽으로 밀면 이동 방식 Climbing 으로 오르고, 놓으면 매달려 있으며(떨어지지 않음), 다시 밀면 3 m 발판에 선다(Walking).
  ② 등반 벽: 오르면서 옆으로도 간다. 점프하면 벽을 차고 떨어진다(뒤 -Z 로).
  ③ 밧줄: 매달려 점프하면 가는 쪽으로 뛴다.
  ④ 물: 이동 방식 Swimming — R 로 떠오르고 F 로 가라앉는다(키를 놓으면 그 높이 둘레에 머문다).
  ⑤ 짝 텔레포트: PortalA 에 들면 PortalB 로 옮기고 되돌아오지 않는다. 나갔다 다시 들면 돌아온다.
  ⑥ 이모트: 환호(되풀이)를 틀고 걸으면 그친다, 인사(한 번)는 끝나면 돌아간다.
  ⑦ 미니맵: 표시 넷의 자리(보는 쪽이 위, 범위 밖 포털은 가장자리).
  값으로 판정한다(골든 없음). 실행: App -scenario=game/playground/automation/outdoors.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.outdoors" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/outdoors.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Character.MovementMode" target="Player" is="Walking" timeoutFrames="60"/>

	<!-- ⑦ 미니맵 — 움직이기 전에 -->
	<WaitUntil watch="Minimap.ShownCount" target="Player" equals="4" timeoutFrames="60"/>
	<Expect watch="Minimap.MarkerX" target="Player" key="Chest" near="0" tolerance="0.01"/>
	<Expect watch="Minimap.MarkerY" target="Player" key="Chest" near="0.3" tolerance="0.01"/>
	<Expect watch="Minimap.MarkerX" target="Player" key="PortalA" near="-1" tolerance="0.01"/>
	<Expect watch="Minimap.MarkerX" target="Player" key="Tree" near="0.6" tolerance="0.01"/>

	<!-- ⑥ 이모트 -->
	<Tap slot="Key.G" hold="2"/>
	<WaitUntil watch="Object.Property" target="Player" key="EmoteComponent._activeState" is="Cheer" timeoutFrames="10"/>
	<WaitUntil watch="Animation.State" target="Player" is="Cheer" timeoutFrames="30"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Animation.State" target="Player" is="Idle" timeoutFrames="30"/>
	<Release slot="Key.W"/>
	<AdvanceSimulation frames="10"/>
	<Tap slot="Key.H" hold="2"/>
	<WaitUntil watch="Animation.State" target="Player" is="Interact" timeoutFrames="30"/>
	<WaitUntil watch="Animation.State" target="Player" is="Idle" timeoutSeconds="5"/> <!-- 한 번짜리 동작이 끝나 돌아왔다 -->

	<!-- ① 사다리 -->
	<DevCommand line="object.place Player 0 0.05 4"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Character.MovementMode" target="Player" is="Climbing" timeoutFrames="120"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1" timeoutFrames="120"/>
	<Release slot="Key.W"/>
	<AdvanceSimulation frames="5"/>
	<Store watch="Object.Y" target="Player" as="heldY"/>
	<AdvanceSimulation frames="60"/> <!-- 매달려 있다 — 떨어지지 않음은 시간이 내용 -->
	<Expect watch="Object.Y" target="Player" sameAs="heldY" tolerance="0.01"/>
	<Expect watch="Character.MovementMode" target="Player" is="Climbing"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Character.MovementMode" target="Player" is="Walking" timeoutFrames="240"/>
	<Release slot="Key.W"/>
	<Expect watch="Object.Y" target="Player" near="3" tolerance="0.1"/>

	<!-- ② 등반 벽 — 옆으로, 차고 떨어지기 -->
	<DevCommand line="object.place Player 10 0.05 4"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.5" timeoutFrames="180"/>
	<Press slot="Key.D"/>
	<WaitUntil watch="Object.X" target="Player" atLeast="10.8" timeoutFrames="180"/>
	<Expect watch="Character.MovementMode" target="Player" is="Climbing"/>
	<Release slot="Key.D"/>
	<Release slot="Key.W"/>
	<Tap slot="Key.Space" hold="2"/>
	<WaitUntil watch="Object.Z" target="Player" atMost="5" timeoutFrames="60"/> <!-- 벽(z 6.25)에서 뒤로 -->
	<WaitUntil watch="Character.MovementMode" target="Player" is="Walking" timeoutFrames="180"/>

	<!-- ③ 밧줄 — 가는 쪽(+X)으로 뛰어내린다 -->
	<DevCommand line="object.place Player -10 0.05 5.2"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.5" timeoutFrames="180"/>
	<Release slot="Key.W"/>
	<Press slot="Key.D"/>
	<AdvanceSimulation frames="3"/>
	<Tap slot="Key.Space" hold="2"/>
	<WaitUntil watch="Object.X" target="Player" atLeast="-9" timeoutFrames="60"/>
	<Release slot="Key.D"/>
	<WaitUntil watch="Character.MovementMode" target="Player" is="Walking" timeoutFrames="180"/>

	<!-- ④ 헤엄 -->
	<DevCommand line="object.place Player 30 1 0"/>
	<WaitUntil watch="Character.MovementMode" target="Player" is="Swimming" timeoutFrames="60"/>
	<Press slot="Key.R"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="2" timeoutFrames="180"/>
	<Release slot="Key.R"/>
	<Press slot="Key.F"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1" timeoutFrames="180"/>
	<Release slot="Key.F"/>
	<Expect watch="Character.MovementMode" target="Player" is="Swimming"/>
	<Press slot="Key.D"/>
	<WaitUntil watch="Object.X" target="Player" atLeast="31" timeoutFrames="120"/> <!-- 헤엄 속도로 옆으로 -->
	<Release slot="Key.D"/>

	<!-- ⑤ 짝 텔레포트 -->
	<DevCommand line="object.place Player -30 0.05 0"/>
	<WaitUntil watch="Object.Property" target="PortalA" key="TeleportTriggerComponent._fireCount" equals="1" timeoutFrames="20"/>
	<WaitUntil watch="Object.Z" target="Player" near="20" tolerance="0.2" timeoutFrames="20"/>
	<AdvanceSimulation frames="30"/> <!-- 도착 진입으로 되돌아가지 않음은 시간이 내용 -->
	<Expect watch="Object.Z" target="Player" near="20" tolerance="0.2"/>
	<Expect watch="Object.Property" target="PortalB" key="TeleportTriggerComponent._fireCount" equals="0"/>
	<DevCommand line="object.place Player -30 0.05 25"/>
	<WaitUntil watch="Physics.OverlapCount" target="PortalB" equals="0" timeoutFrames="20"/>
	<DevCommand line="object.place Player -30 0.05 20"/>
	<WaitUntil watch="Object.Property" target="PortalB" key="TeleportTriggerComponent._fireCount" equals="1" timeoutFrames="20"/>
	<WaitUntil watch="Object.Z" target="Player" near="0" tolerance="0.2" timeoutFrames="20"/>
	<Pass/>
</Scenario>
