<?xml version="1.0" encoding="utf-8"?>
<?asset guid="fa1b455909910966769516e7cbb69b41"?>
<!--
  KayKit 캐릭터 벤치의 아틀라스 색 — 벤치 기사(-gv_stressTestCharacters)가 흰 기본 머티리얼이 아니라 KayKit 머티리얼(data/benchscene.xml 의 _knightMaterial)로 그려지는지 눈으로 본다.
  벤치 카메라는 캐릭터 수에 맞춰 스스로 잡힌다(frameCharacterCameras). 사진은 걷기 · 서기가 자리 잡은 뒤(60 프레임) 한 장이다.
  텍스처 샘플이 늘어 벤치 수치가 바뀔 수 있다 — 이 시나리오를 통과시킨 뒤 같은 인자로 GT.Animation 측정 기준을 다시 잡는다(KayKitMaterials K2).
  실행: ctest -R Scenario.game.playground.kaykitcharacters (Shipping 은 벤치 변수가 없어 건너뛴다)
-->
<Scenario name="game.playground.kaykitcharacters" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_stressTestCharacters" value="6"/>
	<AdvanceSimulation frames="60"/> <!-- 캐릭터가 서고 60 프레임 장면(결정적 애니메이션 시각이 사진 내용) -->
	<Screenshot file="empty/kaykit_characters.ppm" stability="Assets"/>
	<!-- 그림을 골든과 견준다 — 사진만 남기면 화면이 틀려도 통과다(시점이 경사면에 막힌 view2 가 그렇게 지나갔다). -->
	<ExpectImage file="empty/kaykit_characters.ppm" golden="kaykit_characters"/>
	<Pass/>
</Scenario>
