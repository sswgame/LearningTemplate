<!--
  자동 렌더 배율의 단계 전환(감사 RN-8 · RS-4) — 배율은 첨부 풀을 다시 만들지 않고 그리는 사각형만 줄인다.
  배율은 gv_autoRenderScaleForce 로 고정한다(GPU 시간과 무관하게 결정적인 단계 — 조정기 자체는 단위 테스트 RenderScaleAdjusterTest 가 본다).
  ① 배율 1 → 0.5: 사각형 너비가 바뀌고, 풀 너비 · 풀 재생성 횟수는 그대로다(할당 0, 히스토리 유지).
  ② 배율 0.5 에서도 가림 타일이 배율 1 때와 같이 지어진다(Render.OcclusionTilesBuilt — 깊이 히스토리를 지난 사각형으로 읽는다). 컬링이 없는 백엔드는 둘 다 0 이다.
  ③ 0.5 의 그림을 골든(통합이 기록)과 견준다 — 사각형이 화면 전체로 펴졌는지(GL 원점 · 업스케일 입력), 가장자리에 사각형 밖이 번지지 않는지 본다.
  ④ 배율 고정을 끄면 사각형이 풀 전체로 돌아오고 풀은 여전히 다시 만들지 않았다.
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.renderscalestep" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/vfxgpulights.scene.xml"/>
	<Launch variable="gv_occlusionCulling" value="true"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Render.ViewPoolWidth" atLeast="1" timeoutFrames="120"/>
	<Expect watch="Render.AutoRenderScale" equals="1"/>
	<Store watch="Render.ViewPoolWidth" as="pool"/>
	<Expect watch="Render.ViewRectWidth" sameAs="pool"/>
	<Store watch="Render.ViewRectWidth" as="fullRect"/>
	<Store watch="Render.ViewRectHeight" as="fullRectHeight"/>
	<Store watch="Render.ViewTransientRebuildCount" as="rebuilds"/>
	<Screenshot file="renderscale_full.ppm" stability="Assets"/>
	<Store watch="Render.OcclusionTilesBuilt" as="occlusion"/>
	<!-- ① 단계 1 → 0.5 -->
	<Variable name="gv_autoRenderScaleForce" value="0.5"/>
	<WaitUntil watch="Render.ViewRectWidth" differsFrom="fullRect" timeoutFrames="10"/>
	<Expect watch="Render.AutoRenderScale" equals="0.5"/>
	<Expect watch="Render.ViewRectHeight" differsFrom="fullRectHeight"/>
	<Expect watch="Render.ViewPoolWidth" sameAs="pool"/>
	<Expect watch="Render.ViewTransientRebuildCount" sameAs="rebuilds"/>
	<!-- ② 가림 타일은 단계 뒤에도 지어진다(지난 프레임 사각형을 읽는다) -->
	<WaitUntil watch="Render.OcclusionTilesBuilt" sameAs="occlusion" timeoutFrames="10"/>
	<!-- ③ 배율 0.5 의 그림 -->
	<Screenshot file="renderscale_half.ppm" stability="Assets"/>
	<Expect watch="Render.OcclusionTilesBuilt" sameAs="occlusion"/>
	<ExpectImage file="renderscale_half.ppm" golden="renderscale_half"/>
	<!-- ④ 고정을 끄면 사각형이 풀 전체로 돌아온다 -->
	<Variable name="gv_autoRenderScaleForce" value="0"/>
	<WaitUntil watch="Render.ViewRectWidth" sameAs="fullRect" timeoutFrames="10"/>
	<Expect watch="Render.ViewRectHeight" sameAs="fullRectHeight"/>
	<Expect watch="Render.ViewPoolWidth" sameAs="pool"/>
	<Expect watch="Render.ViewTransientRebuildCount" sameAs="rebuilds"/>
	<Pass/>
</Scenario>
