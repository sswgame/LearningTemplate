<?xml version="1.0" encoding="utf-8"?>
<?asset guid="98edf51d68a740d5b09e860e7d46ac22"?>
<!--
  월드 원점 이동 — 데이터 레이어 무대(datalayer.scene.xml)에서 `world.origin` 으로 원점을 절대 (100, 40) 으로 옮긴다(언리얼 World Origin Rebasing · 유니티 floating origin).
  ① 모든 루트(카메라 포함)가 -100 만큼 옮아 화면은 그대로이고 자리 감시 값은 로컬이다. ② 원점을 옮긴 뒤 켠 레이어 · 더한 하위 레벨은 절대 자리에 선다(Snow · Shop/Box 의 로컬 X -100).
  ③ 저장 → 원점을 되돌림 → 불러오기면 원점도 저장 때(100, 40)로 돌아오고 자리가 맞는다. 값으로 판정한다(골든 없음). 내비메시가 있는 씬은 원점을 옮기지 않는다(단위 · 설계 참고).
  실행: ctest -R Scenario.game.playground.worldorigin
-->
<Scenario name="game.playground.worldorigin" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/datalayer.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Scene.WorldOriginX" equals="0"/>
	<Expect watch="Object.X" target="HouseLeft" equals="-3"/>

	<!-- ① 원점을 옮긴다 — 루트가 모두 같은 만큼 옮는다 -->
	<DevCommand line="world.origin 100 40"/>
	<Expect watch="Scene.WorldOriginX" equals="100"/>
	<Expect watch="Scene.WorldOriginZ" equals="40"/>
	<Expect watch="Object.Z" target="HouseLeft" equals="-40"/>
	<Expect watch="Object.X" target="HouseLeft" equals="-103"/>
	<Expect watch="Object.X" target="Ground" equals="-100"/>
	<Expect watch="Object.X" target="HouseLeft/Box" equals="-103"/> <!-- 앵커에 붙은 멤버는 로컬 그대로 따라온다 -->

	<!-- ② 옮긴 뒤 오른 것은 절대 자리에 선다 -->
	<DevCommand line="scene.layer Winter on"/>
	<WaitUntil watch="Object.Exists" target="Snow" equals="1" timeoutFrames="30"/>
	<Expect watch="Object.X" target="Snow" equals="-100"/>
	<DevCommand line="scene.sublevel add Shop game/playground/maps/datalayer_house.scene.xml 0 0 4"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.X" target="Shop/Box" equals="-100"/>
	<Expect watch="Object.Z" target="Shop/Box" equals="-36"/> <!-- 절대 Z 4 − 원점 40 -->

	<!-- ③ 저장 → 원점을 되돌림 → 불러오기 -->
	<Store watch="Save.Written" as="writtenBefore"/>
	<DevCommand line="game.save empty/worldorigin"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<DevCommand line="world.origin 0 0"/>
	<Expect watch="Object.X" target="HouseLeft" equals="-3"/>
	<Expect watch="Object.X" target="Shop/Box" equals="0"/>
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.load empty/worldorigin"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Scene.WorldOriginX" equals="100"/>
	<Expect watch="Scene.WorldOriginZ" equals="40"/>
	<Expect watch="Object.X" target="HouseLeft" equals="-103"/>
	<Expect watch="Object.X" target="Shop/Box" equals="-100"/>
	<WaitUntil watch="Object.Exists" target="Snow" equals="1" timeoutFrames="30"/>
	<Expect watch="Object.X" target="Snow" equals="-100"/>

	<DevCommand line="world.origin 0 0"/>
	<Expect watch="Object.X" target="Shop/Box" equals="0"/>
	<Expect watch="Object.X" target="Snow" equals="0"/>
	<Pass/>
</Scenario>
