<!--
  GPU 진단 — 셰이더 메시지 채널 · 픽셀 검사 · 패스별 GPU 시간.
  `gpu.inspect 16 16` 이 픽셀을 고르면 (1) 렌더 스레드가 공개된 첨부의 그 픽셀 값을 GPUInspect.Pixel 로 내고, (2) Present 의 fullscreen_blit 이 그 픽셀에서만
  SW_GPU_PRINT 를 적어 몇 프레임 뒤 GPUMessage.Print("present pixel color …")가 나온다(-gv_gpuMessages=1 의 메시지 변형 PSO). 고르지 않은 동안에는 출력이 없다.
  `gpu.timings on` 뒤 패스별 GPU 시간 줄(GPUTiming.Pass)과 감시 값 GPU.FrameMs · GPU.PassMs 를 본다(값은 통합이 측정에 쓴다 — 여기서는 있는지만 본다).
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.gpumessages" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/rendertest3d.scene.xml"/>
	<Launch variable="gv_gpuMessages" value="1"/>
	<Launch variable="gv_renderScale" value="1"/>
	<ExpectLog id="GPUMessage.Print" count="0"/>
	<DevCommand line="gpu.inspect 16 16"/>
	<WaitUntil watch="Log.Count" key="GPUInspect.Pixel" atLeast="1" timeoutFrames="60"/> <!-- 렌더 스레드가 고른 픽셀 값을 냈다 -->
	<WaitUntil watch="Log.Count" key="GPUMessage.Print" atLeast="1" timeoutFrames="60"/> <!-- 셰이더 메시지가 되읽혀 왔다(몇 프레임 늦다) -->
	<ExpectLog id="GPUInspect.Pixel" contains="pixel 16,16" atLeast="1"/>
	<ExpectLog id="GPUMessage.Print" contains="present pixel color" atLeast="1"/>
	<ExpectLog id="GPUMessage.UnknownID" count="0"/>
	<ExpectLog id="GPUMessage.Error" count="0"/>
	<!-- 파이프라인을 바꾸면 링을 프레임 밖(프레임 앞 렌더 명령)에서 다시 만들고 그 프레임이 곧 다시 올린다 — 두 업로드의 실행 순서가 뒤집히면 DX12 디버그 레이어가 상태 어긋남(527)을 낸다.
	     뒤집히는지는 링 칸(셋)에 달려 있었다. 사이에 진행하는 프레임 수를 달리해(1 · 2) 서로 다른 칸에서 바꾼다. -->
	<Store watch="Log.Count" key="GPUMessage.RingReady" as="rings1"/>
	<Variable name="gv_deferredShading" value="1"/>
	<WaitUntil watch="Log.Count" key="GPUMessage.RingReady" differsFrom="rings1" timeoutFrames="120"/>
	<AdvanceSimulation frames="1"/>
	<Store watch="Log.Count" key="GPUMessage.RingReady" as="rings2"/>
	<Variable name="gv_deferredShading" value="0"/>
	<WaitUntil watch="Log.Count" key="GPUMessage.RingReady" differsFrom="rings2" timeoutFrames="120"/>
	<AdvanceSimulation frames="2"/>
	<Store watch="Log.Count" key="GPUMessage.RingReady" as="rings3"/>
	<Variable name="gv_deferredShading" value="1"/>
	<WaitUntil watch="Log.Count" key="GPUMessage.RingReady" differsFrom="rings3" timeoutFrames="120"/>
	<AdvanceSimulation frames="1"/>
	<Store watch="Log.Count" key="GPUMessage.RingReady" as="rings4"/>
	<Variable name="gv_deferredShading" value="0"/>
	<WaitUntil watch="Log.Count" key="GPUMessage.RingReady" differsFrom="rings4" timeoutFrames="120"/>
	<Store watch="Log.Count" key="GPUMessage.Print" as="printsAfterRebuild"/>
	<WaitUntil watch="Log.Count" key="GPUMessage.Print" differsFrom="printsAfterRebuild" timeoutFrames="60"/> <!-- 다시 만든 링도 돌려준다 -->
	<DevCommand line="gpu.inspect off"/>
	<DevCommand line="gpu.show off"/>
	<DevCommand line="gpu.thread 0"/>
	<DevCommand line="gpu.timings on"/>
	<WaitUntil watch="GPU.PassMs" key="Frame" atLeast="0" timeoutFrames="60"/> <!-- 측정한 프레임의 GPU 시간이 돌아왔다(되읽기는 몇 프레임 늦다) -->
	<DevCommand line="gpu.timings"/>
	<ExpectLog id="GPUTiming.Pass" atLeast="1"/>
	<Expect watch="GPU.FrameMs" atLeast="0"/>
	<Expect watch="GPU.PassMs" key="Frame" atLeast="0"/>
	<Pass/>
</Scenario>
