<?xml version="1.0" encoding="utf-8"?>
<?asset guid="3a73da4cbbb4ed8b6d5cf321294aebb2"?>
<!--
  런타임 인벤토리 화면(InventoryScreen) — 무대 maps/inventorydemo 의 Player(장비 컴포넌트: 가방 4 칸 · 무게 3), 바닥의 포션 더미 · 투구 · 장화 · 망토.
  ⑴ 줍기 → 칸 증가, ⑵ 패드만으로 동작 메뉴(X) → 나누기(수량 대화 상자 — 오른쪽으로 2) → 칸 둘, ⑶ 집기(A) · 옆 칸에 놓기(A) → 겹치기, 버리기(수량 2) → 월드 아이템 → 상호작용(E)으로 줍기,
  ⑷ 패드만으로 투구 장착(메뉴 → Equip) → 장비 칸 · 능력치(armor 3) · 외형(Head) 바뀜, ⑸ 칸 가득 → 줍기 거절(바닥에 남는다),
  ⑹ 세이브 · 정렬로 배치를 바꿈 · 불러오기 → 같은 배치 · 같은 장비 · 같은 돈. 감시 값 중심 — 마우스 끌어 놓기는 같은 명령(Move)이라 이 판정이 덮는다.
  실행: ctest -R Scenario.playground (체인)
-->
<Scenario name="game.playground.inventory" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/inventorydemo.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Player" equals="1" timeoutFrames="300"/>
	<Expect watch="Equipment.BagUsedSlots" target="Player" equals="0"/>

	<!-- ⑴ 줍기 -->
	<DevCommand line="item.pickup Player PotionPile"/>
	<Expect watch="Equipment.BagUsedSlots" target="Player" equals="1"/>
	<Expect watch="Equipment.ItemCount" target="Player" key="potion_health" equals="3"/>
	<Expect watch="Object.Exists" target="PotionPile" equals="0"/>
	<ExpectLog id="Pickup.PickedUp" count="1"/>

	<!-- ⑵ 패드만으로 나누기: 첫 입력은 기본 포커스(Slot0), X 는 동작 메뉴, 메뉴 순서 Use · Equip · Split -->
	<DevCommand line="exec InventoryDemo openInventory"/>
	<WaitUntil watch="UI.ActiveScreen" is="common/ui/inventory/inventory.ui.xml" timeoutFrames="30"/>
	<Tap slot="Gamepad.DPadDown" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Slot0" timeoutFrames="10"/>
	<Tap slot="Gamepad.X" hold="1"/>
	<WaitUntil watch="Inventory.MenuSlot" equals="0" timeoutFrames="10"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActUse" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActEquip" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActSplit" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/quantity.ui.xml" timeoutFrames="20"/>
	<WaitUntil watch="UI.FocusedWidget" is="Amount" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/> <!-- 1 → 2(최대는 3 - 1) -->
	<AdvanceSimulation frames="2"/>
	<Tap slot="Gamepad.DPadDown" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Accept" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="common/ui/inventory/inventory.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="Equipment.BagUsedSlots" target="Player" equals="2" timeoutFrames="10"/>
	<Expect watch="Equipment.BagCount" target="Player" key="0" equals="1"/>
	<Expect watch="Equipment.BagCount" target="Player" key="1" equals="2"/>
	<Expect watch="Inventory.LastResult" is="Ok"/>

	<!-- ⑶ 집기 · 놓기로 겹치기: 메뉴를 닫으면 포커스가 메뉴를 연 칸(Slot0)으로 돌아온다 -->
	<WaitUntil watch="UI.FocusedWidget" is="Slot0" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="Inventory.HeldSlot" equals="0" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Slot1" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="Equipment.BagUsedSlots" target="Player" equals="1" timeoutFrames="10"/>
	<Expect watch="Equipment.BagCount" target="Player" key="1" equals="3"/>
	<Expect watch="Inventory.HeldSlot" equals="-1"/>

	<!-- ⑶-2 버리기(메뉴 → Drop → 수량 2) → 월드 아이템이 생기고, 주우면 다시 겹친다 -->
	<Tap slot="Gamepad.X" hold="1"/>
	<WaitUntil watch="Inventory.MenuSlot" equals="1" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActEquip" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActSplit" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActDrop" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/quantity.ui.xml" timeoutFrames="20"/>
	<WaitUntil watch="UI.FocusedWidget" is="Amount" timeoutFrames="10"/> <!-- 처음 값은 절반(2) -->
	<Tap slot="Gamepad.DPadDown" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Accept" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="Object.Exists" target="Pickup" equals="1" timeoutFrames="30"/>
	<Expect watch="Equipment.BagCount" target="Player" key="1" equals="1"/>
	<Tap slot="Gamepad.B" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="none" timeoutFrames="30"/>
	<!-- 버린 것은 상호작용으로 다시 줍는다 — 캐릭터 장비 컴포넌트의 가방이 받는다(IItemReceiver) -->
	<WaitUntil watch="Interaction.Focus" target="Player" is="Pickup" timeoutFrames="30"/>
	<Tap slot="Key.E" hold="2"/>
	<WaitUntil watch="Object.Exists" target="Pickup" equals="0" timeoutFrames="20"/>
	<Expect watch="Equipment.BagCount" target="Player" key="1" equals="3"/>
	<ExpectLog id="Pickup.PickedUp" count="2"/>

	<!-- ⑷ 패드만으로 투구 장착 → 장비 칸 · 능력치 · 외형 -->
	<DevCommand line="item.pickup Player HelmetDrop"/>
	<Expect watch="Equipment.BagItem" target="Player" key="0" is="helmet_knight"/>
	<Expect watch="Equipment.Stat" target="Player" key="armor" equals="0"/>
	<DevCommand line="exec InventoryDemo openInventory"/>
	<WaitUntil watch="UI.ActiveScreen" is="common/ui/inventory/inventory.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="UI.FocusedWidget" is="Slot0" timeoutFrames="10"/> <!-- 패드로 열었다 — 탐색 방식이라 기본 포커스가 선다 -->
	<Tap slot="Gamepad.X" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActUse" timeoutFrames="10"/>
	<Tap slot="Gamepad.DPadRight" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="ActEquip" timeoutFrames="10"/>
	<Tap slot="Gamepad.A" hold="1"/>
	<WaitUntil watch="Equipment.Worn" target="Player" key="Head" is="helmet_knight" timeoutFrames="10"/>
	<Expect watch="Equipment.Stat" target="Player" key="armor" equals="3"/>
	<WaitUntil watch="Appearance.SlotItem" target="Player" key="Head" is="helmet_knight" timeoutFrames="30"/>
	<Expect watch="Equipment.BagItem" target="Player" key="0" is="(empty)"/>
	<Tap slot="Gamepad.B" hold="1"/>
	<WaitUntil watch="UI.ActiveScreen" is="none" timeoutFrames="30"/>

	<!-- ⑸ 칸 가득 → 줍기 거절: 장화 · 개발 명령으로 두 칸을 더 채운다(4/4) -->
	<DevCommand line="item.pickup Player BootsDrop"/>
	<DevCommand line="equipment.give Player boots_low"/>
	<DevCommand line="equipment.give Player boots_low"/>
	<Expect watch="Equipment.BagUsedSlots" target="Player" equals="4"/>
	<DevCommand line="item.pickup Player CapeDrop"/>
	<ExpectLog id="Pickup.PickUpRefused" count="1"/>
	<Expect watch="Object.Exists" target="CapeDrop" equals="1"/>
	<Expect watch="Equipment.ItemCount" target="Player" key="cape_rogue" equals="0"/>

	<!-- ⑹ 세이브 → 정렬로 배치를 바꾼다 → 불러오기: 같은 배치 · 장비 · 돈 -->
	<Store watch="Equipment.BagItem" target="Player" key="1" as="slot1Saved"/>
	<Store watch="Save.Written" as="writtenBefore"/>
	<DevCommand line="game.save empty/inventory"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<DevCommand line="equipment.sort Player"/>
	<Expect watch="Equipment.BagItem" target="Player" key="1" differsFrom="slot1Saved"/> <!-- 정렬이 정말 배치를 바꿨다(되돌림을 가리려면) -->
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.load empty/inventory"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Player" equals="1" timeoutFrames="300"/>
	<Expect watch="Equipment.BagItem" target="Player" key="1" sameAs="slot1Saved"/>
	<Expect watch="Equipment.BagCount" target="Player" key="1" equals="3"/>
	<Expect watch="Equipment.BagUsedSlots" target="Player" equals="4"/>
	<Expect watch="Equipment.Worn" target="Player" key="Head" is="helmet_knight"/>
	<Expect watch="Equipment.Stat" target="Player" key="armor" equals="3"/>
	<Expect watch="Demo.Gold" target="InventoryDemo" equals="100"/>
	<Pass/>
</Scenario>
