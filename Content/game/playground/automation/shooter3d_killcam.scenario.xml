<!--
  사격장 킬캠 프리셋 — shooter.cameras.xml 의 killcam(대상 정면 3인칭 · 얕은 초점 · 채도 0.8 · 비네트)이 읽히고 그려지는지 화면 전체를 골든과 견준다(IntentNetworkWiring 3절).
  프리셋을 개발 명령 camera.preset killcam 으로 고른다. 예전의 평균 휘도 문턱(meanLuma ≥ 0.30)은 골든 비교로 바꿨다 — 문턱은 빈 화면만 잡고 다른 시점은 못 잡았다.
  실행: App -scenario=game/playground/automation/shooter3d_killcam.scenario.xml -unattended (체인: ctest -R Scenario.playground.shooter3d)
-->
<Scenario name="game.playground.shooter3d_killcam" fixedDelta="0.0166667" timeoutFrames="200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="shooter3d"/>
	<Variable name="gv_cameraFieldOfView" value="80"/> <!-- 골든은 시야각 80 으로 찍었다(옛 게임 팩의 기본값) -->
	<DevCommand line="camera.preset killcam"/>
	<!-- 프리셋 블렌드가 끝나고 렌더(피사계 심도 · TAA · 노출)가 자리 잡을 때까지 -->
	<WaitUntil watch="CameraManager.Blending" target="PlayerCamera" equals="0" timeoutSeconds="3"/>
	<Screenshot file="killcam.ppm"/>
	<ExpectImage file="killcam.ppm" golden="killcam" region="0,0,1,1"/>
	<Pass/>
</Scenario>
