<!--
  서부극 스트리밍 셀 경계의 컷씬 트리거 — 무대 automation/wildwest_cellstate/cellstate.scene.xml(prairie 를 물려받음, 16 m 셀 · 32 m 반경)의 셀 A 에 든 CellGate(시퀀스 트리거)가
  늘 올라 있는 ArrivalDirector 를 튼다. 정책은 씬 데이터다: _progressFlag cellstate.gateSeen · _bOnce · _spawnInside Activate(트리거 계약 — 안에서 생성 = 진입).
  셀은 쿠킹본에만 있어 소스 콘텐츠로는 gv_sceneStreamSourceCells 로 씬 로드가 메모리에서 셀을 나눈다(automation/wildwest_cellstate 와 같다).
  ① 셀 A 가 내려간 자리로 기수가 바로 가면 셀이 기수를 둘러 올라온다 — 트리거가 안에서 생겼으니 진입이고 컷씬이 한 번 돈다(플래그가 선다).
  ② 재생 중 셀을 내린다 — 트리거는 파괴 길로 이탈하고(트리거 계약 6) 재생은 끊기지 않고 정상 끝까지 간다.
  ③ 셀이 다시 올라와도(발동 수는 떠 둔 상태로 돌아온다) 걸어 들어와도 다시 틀지 않는다.
  판정은 감시 값이다(사진 없음): Object.Exists(셀), Session.Flag, Object.Property SequenceTriggerComponent._fireCount, Sequence.History · Sequence.InputBlocked.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/wildwest_cellcutscene.scenario.xml -unattended
-->
<Scenario name="game.playground.wildwest_cellcutscene" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/automation/wildwest_cellstate/cellstate.scene.xml"/>
	<Launch variable="gv_sceneStreamSourceCells" value="true"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Scene.LoadedCellCount" atLeast="1" timeoutFrames="120"/> <!-- 원점 둘레 셀이 올랐다(셀을 나눠 스트리밍한다) -->
	<Expect watch="Object.Exists" target="CellGate" equals="0"/> <!-- 셀 A 는 반경 밖이다 -->
	<Expect watch="Session.Flag" key="cellstate.gateSeen" equals="0"/>

	<!-- ① 기수가 선 자리에 셀이 올라온다 — 안에서 생긴 트리거의 진입으로 한 번 -->
	<DevCommand line="teleport Player -72 0.05 12"/>
	<WaitUntil watch="Object.Exists" target="CellGate" equals="1" timeoutFrames="120"/>
	<WaitUntil watch="Object.Property" target="CellGate" key="SequenceTriggerComponent._fireCount" equals="1" timeoutFrames="30"/>
	<Expect watch="Session.Flag" key="cellstate.gateSeen" equals="1"/>
	<Expect watch="Sequence.History" target="ArrivalDirector" key="Started" equals="1"/>
	<WaitUntil watch="Sequence.InputBlocked" target="ArrivalDirector" equals="1" timeoutFrames="4"/>

	<!-- ② 재생 중 셀을 내린다 — 트리거가 사라져도 재생은 이어져 정상 끝까지 간다 -->
	<DevCommand line="teleport Player 0 0.05 70"/>
	<WaitUntil watch="Object.Exists" target="CellGate" equals="0" timeoutFrames="120"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="1"/> <!-- 아직 재생 중이다(3 초 시퀀스) -->
	<Expect watch="Sequence.History" target="ArrivalDirector" key="Stopped" equals="0"/>
	<WaitUntil watch="Sequence.History" target="ArrivalDirector" key="Finished" equals="1" timeoutFrames="300"/>
	<Expect watch="Sequence.Frame" target="ArrivalDirector" equals="90"/>
	<Expect watch="Sequence.History" target="ArrivalDirector" key="Stopped" equals="0"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="0"/>

	<!-- ③ 셀이 다시 올라와도 · 걸어 들어와도 다시 틀지 않는다 -->
	<DevCommand line="teleport Player -66 0.05 8"/>
	<WaitUntil watch="Object.Exists" target="CellGate" equals="1" timeoutFrames="120"/>
	<AdvanceSimulation frames="5"/> <!-- 트리거가 바깥에 선 기수를 본다(프레임 경계) -->
	<Expect watch="Object.Property" target="CellGate" key="SequenceTriggerComponent._fireCount" equals="1"/>
	<DevCommand line="teleport Player -72 0.05 12"/>
	<AdvanceSimulation frames="30"/> <!-- 다시 닿아도 반 초 동안 틀지 않는다(일어나지 않음 — 시간이 내용) -->
	<Expect watch="Sequence.History" target="ArrivalDirector" key="Started" equals="1"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="0"/>
	<Expect watch="Session.Flag" key="cellstate.gateSeen" equals="1"/>
	<Pass/>
</Scenario>
