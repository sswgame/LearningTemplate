<!--
  아레나 미니게임(abilityarena — 옛 게임 AbilityArena) 조종 시나리오 — 입력 층(가상 키) → 플레이어 조종자 → 의도 → 유닛 이동 · 어빌리티, 그리고 자동 플레이 스위치가 빙의를 옮기는 것.
  시나리오 시한은 조건 대기 프레임도 세므로 두 1500 프레임 대기를 넘는다.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/abilityarena_control.scenario.xml -unattended
-->
<Scenario name="game.playground.abilityarena_control" fixedDelta="0.0166667" timeoutFrames="3300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="abilityarena"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<!-- 플레이어가 가운데 서고 플레이어 조종자가 쥐었다. -->
	<WaitUntil watch="Arena.PlayerControllerKind" equals="0" timeoutFrames="60"/>
	<Expect watch="Arena.PlayerX" near="0" tolerance="0.01"/>
	<!-- D 를 반 초 — 이동 속도 6 m/s 라 3 m 남짓 오른쪽. 선 뒤에 잰다. -->
	<Press slot="Key.D"/>
	<AdvanceSimulation frames="30"/> <!-- 누른 채인 구간이 시험 내용이다(반 초) -->
	<Release slot="Key.D"/>
	<WaitUntil watch="Arena.PlayerX" atLeast="2" timeoutFrames="30"/>
	<Expect watch="Arena.PlayerZ" near="0" tolerance="0.01"/>
	<!-- K 한 번 = 화염구 하나. -->
	<Tap slot="Key.K" hold="1"/>
	<WaitUntil watch="Arena.PlayerShotCount" equals="1" timeoutFrames="30"/>
	<!-- 자동 플레이를 켜면 자동 전투 AI 가 플레이어 폰을 쥐고 싸운다. -->
	<Variable name="gv_playgroundAutoPlay" value="1"/>
	<WaitUntil watch="Arena.PlayerControllerKind" equals="1" timeoutFrames="30"/>
	<!-- 첫 처치와 셋째 발사까지만 기다린다. 둘 다 이번 판에 쌓이는 수라 먼저 닿은 쪽이 풀리지 않는다. -->
	<WaitUntil watch="Arena.KillCount" atLeast="1" timeoutFrames="1500"/>
	<WaitUntil watch="Arena.PlayerShotCount" atLeast="3" timeoutFrames="1500"/>
	<!-- 끄면 플레이어 조종자가 되찾는다. -->
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Arena.PlayerControllerKind" equals="0" timeoutFrames="60"/>
	<Pass/>
</Scenario>
