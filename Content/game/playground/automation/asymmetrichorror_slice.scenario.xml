<!--
  비대칭 공포 미니게임 한 판 — 수리 → 전원 → 탈출구 열기 → 탈출 → 결과 `win`. 생존자 0 은 플레이어와 같은 입력(Move · AsymmetricHorror.Use)으로만 움직이고, 생존자 1 은 봇이다.
  씬: 생존자 0 (-16,0) 곁에 발전기 (-16,1.5), 봇 (-16,-10) 곁에 발전기 (-16,-11.5). 둘이 고치면 전원이 든다. 탈출구 (-22,0) 은 서쪽으로 1.25 초(5 m). 살인마는 15 초 뒤에 (20,0) 에서 풀려난다.
  스킬 체크는 플레이어가 응답하지 않는다(놓치면 진행이 조금 깎인다 — 그래도 12 초 안에 끝난다).
  감시 값: AsymmetricHorror.Result(0 진행, 1 이김, 2 비김, 3 짐) · .Generators · .GatesPowered · .OpenGates · .Escaped · .Sacrificed · .PlayerX · .PlayerActivity.
  실행: App -scenario=game/playground/automation/asymmetrichorror_slice.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.asymmetrichorror_slice" fixedDelta="0.0166667" timeoutFrames="4800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="asymmetrichorror"/>
	<Launch variable="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="AsymmetricHorror.PlayerX" near="-16" tolerance="0.01" timeoutFrames="120"/>
	<Expect watch="AsymmetricHorror.Result" equals="0"/>
	<Expect watch="AsymmetricHorror.Generators" equals="0"/>
	<!-- 곁의 발전기를 고친다 — 봇은 자기 곁의 발전기를 고친다 -->
	<Action name="AsymmetricHorror.Use"/>
	<WaitUntil watch="AsymmetricHorror.PlayerActivity" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="AsymmetricHorror.GatesPowered" equals="1" timeoutSeconds="14"/>
	<Expect watch="AsymmetricHorror.Generators" equals="2"/>
	<!-- 탈출구로 가서 연다(봇이 먼저 열고 있으면 봇이 연다) -->
	<ActionAxis name="Move" x="-1" seconds="1.25"/>
	<WaitUntil watch="AsymmetricHorror.PlayerX" near="-21" tolerance="0.1" timeoutSeconds="3"/>
	<AdvanceSimulation frames="6"/> <!-- 축이 놓인 뒤에 누른다(걸음이 하던 일을 그만두게 한다 — 프레임 경계) -->
	<Action name="AsymmetricHorror.Use"/>
	<WaitUntil watch="AsymmetricHorror.OpenGates" atLeast="1" timeoutSeconds="8"/>
	<Action name="AsymmetricHorror.Use"/>
	<WaitUntil watch="AsymmetricHorror.Escaped" equals="2" timeoutSeconds="8"/>
	<Expect watch="AsymmetricHorror.Result" equals="1"/>
	<Expect watch="AsymmetricHorror.Sacrificed" equals="0"/>
	<ExpectLog id="AsymmetricHorror.Ended" contains="win" count="1"/>
	<!-- 결과를 보인 뒤 미니게임이 스스로 끝난다 -->
	<WaitUntil watch="Minigame.LastResult" is="win" timeoutWallSeconds="60"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<Pass/>
</Scenario>
