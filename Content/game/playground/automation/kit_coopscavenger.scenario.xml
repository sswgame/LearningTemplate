<!--
  장르 키트 시연 — 협동 수집 공포 키트(GF_CoopScavenger)의 원정 한 번: rust 착륙 → 볼트 셋(30)을 우주선에 실음 → 이륙 → 회사에서 매입 30 → 마감 판정에서 할당량을 채워 크레딧 92, 다음 할당량 73.
  감시 값: KitDemo.CoopScavenger.State(0 시작 전, 1 마침) · .Sold · .Credits · .NextQuota.
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.kit_coopscavenger" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/kit_coopscavenger.scene.xml"/>
	<WaitUntil watch="KitDemo.CoopScavenger.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.CoopScavenger.Sold" equals="30"/>
	<Expect watch="KitDemo.CoopScavenger.Credits" equals="92"/>
	<Expect watch="KitDemo.CoopScavenger.NextQuota" equals="73"/>
	<ExpectLog id="KitDemo.CoopScavengerDone" count="1"/>
	<Pass/>
</Scenario>
