<!--
  트리거 계약 — 지역 볼륨의 진입 · 이탈(DesignBacklog "트리거 Enter · Stay · Exit 계약"). 무대 maps/zoneshowcase 의 Swamp(늪, 볼륨 겹침 입력)와 Walker.
  볼륨을 끄면 안의 대상이 나가 이탈 할 일(이 출처 이펙트 지우기)이 돌고, 다시 켜면 진입한다. 대상을 끄면 나가고 켜면 든다. 안에서 파괴해도 오류가 없다.
  값으로 판정한다(골든 없음). 실행: App -scenario=game/playground/automation/zonecontract.scenario.xml -unattended
-->
<Scenario name="game.playground.zonecontract" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/zoneshowcase.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Zone.Sources" target="Walker" is="None"/>

	<DevCommand line="object.place Walker 0 0.05 0"/>
	<WaitUntil watch="Zone.Sources" target="Walker" is="volume:Swamp" timeoutFrames="10"/>
	<Expect watch="Ability.HasTag" target="Walker" key="State.Slowed" equals="1"/>

	<DevCommand line="object.active Swamp 0"/> <!-- 볼륨을 끈다 — 안의 대상이 나가고 이탈 할 일이 돈다 -->
	<WaitUntil watch="Zone.Sources" target="Walker" is="None" timeoutFrames="10"/>
	<Expect watch="Ability.HasTag" target="Walker" key="State.Slowed" equals="0"/>
	<DevCommand line="object.active Swamp 1"/>
	<WaitUntil watch="Zone.Sources" target="Walker" is="volume:Swamp" timeoutFrames="10"/>
	<Expect watch="Ability.HasTag" target="Walker" key="State.Slowed" equals="1"/>

	<DevCommand line="object.active Walker 0"/> <!-- 대상을 끈다 — 나간다 -->
	<WaitUntil watch="Zone.Sources" target="Walker" is="None" timeoutFrames="10"/>
	<DevCommand line="object.active Walker 1"/>
	<WaitUntil watch="Zone.Sources" target="Walker" is="volume:Swamp" timeoutFrames="10"/>

	<DevCommand line="object.destroy Walker"/> <!-- 안에서 파괴 — 기록은 이탈, 처리기는 부르지 않는다(대상이 없다) -->
	<AdvanceSimulation frames="3"/>
	<Pass/>
</Scenario>
