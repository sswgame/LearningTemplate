<!--
  부하 시나리오 — 게임 중 꾸미기의 수명 · 비용: 부품을 합친 Quaternius 마을 사람 50 명(townsfolk_merged)이 10 프레임마다 외형 씨앗을 바꿔 다시 입는다
  (-gv_stressTestAppearanceChurn — 씨앗 여덟 개를 돌린다, 측정 창 15 초에 캐릭터마다 약 90 번 · 모두 4500 번 교체).
  측정: 교체가 낀 프레임 시간(측정 창 <Load> 의 결과 — 구운 메시 캐시 적중 · 워커 조립). 판정: 교체를 수백 번 해도 오브젝트가 늘지 않고(부품 풀 · 구간 컴포넌트가 새지 않음),
  캐시 항목이 차림 수에서 멈추고, 되풀이되는 차림은 캐시가 내준다. 측정 창이 끝내므로 <Pass/> 가 없다.
  실행: ctest -L load (항목 Scenario.playground.load.appearancechurn) · App -scenario=game/playground/automation/load/appearancechurn.scenario.xml -unattended -gv_stressTestCharacters=50 -gv_stressTestCharacterColumns=10 -gv_stressTestCharacterPrefab=common/prefabs/quaternius/townsfolk_merged.prefab.xml -gv_stressTestAppearanceChurn=10
-->
<Scenario name="game.playground.load.appearancechurn" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<Launch variable="gv_stressTestCharacters" value="50"/>
	<Launch variable="gv_stressTestCharacterColumns" value="10"/>
	<Launch variable="gv_stressTestCharacterPrefab" value="common/prefabs/quaternius/townsfolk_merged.prefab.xml"/>
	<Launch variable="gv_stressTestAppearanceChurn" value="10"/>
	<Load durationSeconds="15"/>
	<!-- 측정 경로를 탔는지 스스로 본다 — 50 명이 다 서고 합친 몸을 그린다 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.MergedCharacters" atLeast="50" timeoutFrames="600"/>
	<Store watch="Scene.ObjectCount" as="objectsWarm"/>
	<Store watch="Appearance.BakedMeshHits" as="hitsWarm"/>
	<!-- 3 초(18 바퀴 · 900 번 교체) — 시간이 내용 -->
	<AdvanceSimulation frames="180"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Scene.ObjectCount" sameAs="objectsWarm"/>
	<Expect watch="Appearance.BakedMeshEntries" atMost="16"/> <!-- 차림 여섯(머리 셋 × 옷 둘) — 구운 키 · 합친 키 둘씩, 넉넉히 -->
	<Expect watch="Appearance.BakedMeshHits" increaseFrom="hitsWarm" increaseBy="100"/>
	<Expect watch="Appearance.MergedCharacters" atLeast="50"/>
</Scenario>
