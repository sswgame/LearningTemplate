<!--
  부하 시나리오 — 캐릭터 컨트롤러 500 명이 가운데로 걸어 모인다(load/charactermove/charactermove_load): 물리 PreStep 끝의 캐릭터 일괄 이동(`moveCharacters`, 감사 S-8)의
  비용을 워커 수별로 잰다. 볼 값: 프로파일의 GT.Physics.moveCharacters(고정 스텝마다 한 번) · GT.Scene.tick.physics. 워커 1 · 4 · 8 은 명령줄 `-workers=N` 로 바꿔 세 번 돈다.
  측정 창(<Load>)이 끝내므로 <Pass/> 가 없다. 하위 폴더라 게임 체인(Scenario.playground)이 줍지 않는다.
  실행: ctest -L load (항목 Scenario.playground.load.charactermove) · App -scenario=game/playground/automation/load/charactermove.scenario.xml -unattended -workers=1|4|8
-->
<Scenario name="game.playground.load.charactermove" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/automation/load/charactermove/charactermove_load.scene.xml"/>
	<Load durationSeconds="15"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="PlaygroundLoad.CrowdCharacters" atLeast="500" timeoutFrames="120"/>
	<Expect watch="PlaygroundLoad.CrowdCharacters" atLeast="500"/>
</Scenario>
