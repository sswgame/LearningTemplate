<!--
  부하 시나리오 — 머티리얼 파라미터 애니메이션. 큐브 512 개가 저마다 머티리얼 인스턴스를 들고(-gv_stressTestMaterialInstances=1 — 머티리얼 원소 512 개),
  그중 32 개의 값(색 · 러프니스)을 프레임마다 바꾼다. 비용이 머티리얼 수가 아니라 바뀐 수에 비례하는지 잰다(유니티 SRP Batcher · 언리얼 MID 자리).
  감시 값: GT.Material.refreshVisited(바뀐 주인의 원소만 — 32 근처여야 한다, 512 면 전부 맞추기), GT.Material.refreshBindingsAll(0 이어야 한다),
           RT.GPUScene.materialElementsUploaded(바뀐 원소 칸만 올린다), RT.GPUScene.uploadMaterials · GT.GPUScene.build 시간.
  짝: materialswap(머티리얼 교체) · materialpermutation(처음 보는 퍼뮤테이션). 측정 창(<Load>)은 시나리오마다 하나라 연산마다 파일을 나눴다.
  측정 창(<Load>)이 끝내므로 <Pass/> 가 없다. 하위 폴더라 게임 체인이 줍지 않는다.
  실행: ctest -L load (항목 Scenario.playground.load.materialparams)
-->
<Scenario name="game.playground.load.materialparams" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<Launch variable="gv_stressTestMeshes" value="512"/>
	<Launch variable="gv_stressTestMaterialInstances" value="1"/>
	<Launch variable="gv_stressTestTransparent" value="0"/>
	<Launch variable="gv_stressTestAnimate" value="0"/>
	<Launch variable="gv_stressTestMaterialChurn" value="32"/>
	<Load durationSeconds="15"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Scene.ObjectCount" atLeast="512"/>
</Scenario>
