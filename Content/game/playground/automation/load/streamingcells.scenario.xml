<!--
  부하 시나리오 — 씬 스트리밍(감사 A-13): 20 x 20 셀 × 셀마다 상자 5 개(모두 2000, maps/streaming_bulk.scene.xml)를 카메라가 대각선으로 지나가고 위 변을 따라 돌아온다.
  셀 내용의 비동기 읽기(워커) → 게임 스레드의 시간 예산 짓기 → 내릴 때 상태 뜨기가 프레임마다 돈다. 측정은 구간 `GT.Scene.service.SceneStreaming` 의 최대 프레임.
  셀은 쿠킹본에만 있다 — 소스 콘텐츠로 돌면 모든 상자가 늘 올라 있어 스트리밍을 재지 않는다. 쿠킹(`--cook-all`) 뒤 `-cooked-content` 로 돈다.
  측정 창(<Load>)이 끝내므로 <Pass/> 가 없다.
  실행: App -scenario=game/playground/automation/load/streamingcells.scenario.xml -unattended -cooked-content
-->
<Scenario name="game.playground.load.streamingcells" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/streaming_bulk.scene.xml"/>
