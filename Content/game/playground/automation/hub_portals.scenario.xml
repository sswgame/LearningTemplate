<?xml version="1.0" encoding="utf-8"?>
<?asset guid="01285eea14034d928deb4273e19b0345"?>
<!--
  허브의 미니게임 입구 — 정의(minigames/*.minigame.xml)의 portalSlot 하나가 입구 하나다(maps/hub 의 MinigamePortals 가 prefabs/minigameportal 를 세운다).
  미니게임(pixeltown · harvestvalley · voxelcraft · frontiertown · meadowvillage · themepark · abilityarena · velmora · starskirmish · kartracing · partyarena · rhythm · cardgame · sidescrollconquest)의 입구에 플레이어를 세워 들어가고, minigame.leave 로 나와 마을이 복원되는지 본다.
  돌아온 자리는 입구 안이다 — 다시 세운 입구가 나타난 플레이어를 세지 않는다(_spawnInside Ignore). 입구를 더하면 여기에 한 묶음을 더한다.
  실행: App -scenario=game/playground/automation/hub_portals.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.hub_portals" fixedDelta="0.0166667" timeoutFrames="7200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/hub.scene.xml"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Minigame.Active" is="none"/>
	<!-- 자리: 시작(-24, 32)에서 X 로 7 m 마다 -->
	<Expect watch="Object.X" target="MinigamePortal_pixeltown" near="-24" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_harvestvalley" near="-17" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_voxelcraft" near="-10" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_frontiertown" near="-3" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_frontiertown" near="32" tolerance="0.01"/>

	<!-- pixeltown — 입구 둘레에 다가오면 미리 읽기가 먼저 걸린다(들어가지는 않는다) -->
	<DevCommand line="teleport Player -24 0.05 36"/>
	<WaitUntil watch="Object.X" target="Player" near="-24" tolerance="0.05" timeoutFrames="10"/>
	<WaitUntil watch="Object.Property" target="MinigamePreload_pixeltown" key="MinigamePreloadTriggerComponent._fireCount" equals="1" timeoutFrames="30"/>
	<ExpectLog id="MinigameFlow.Preload" contains="'pixeltown'" atLeast="1"/>
	<Expect watch="Minigame.Active" is="none"/>
	<DevCommand line="teleport Player -24 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="pixeltown" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/pixeltown/maps/town.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<Expect watch="Object.X" target="Player" near="-24" tolerance="0.05"/>
	<AdvanceSimulation frames="30"/> <!-- 다시 세운 입구 안에 머문다 — 다시 들어가지 않음은 시간이 내용 -->
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Object.X" target="MinigamePortal_pixeltown" near="-24" tolerance="0.01"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>

	<!-- harvestvalley -->
	<DevCommand line="teleport Player -17 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="harvestvalley" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/harvestvalley/maps/farm.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="2" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>

	<!-- voxelcraft -->
	<DevCommand line="teleport Player -10 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="voxelcraft" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/voxelcraft/maps/island.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="3" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>

	<!-- frontiertown -->
	<DevCommand line="teleport Player -3 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="frontiertown" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/frontiertown/maps/frontier.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="4" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- meadowvillage -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="teleport Player 4 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="meadowvillage" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/meadowvillage/maps/meadow.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="5" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- themepark — 하위 레벨이다. 마을이 보인 채로 얹히고 정문(공원 좌표 20, -40)이 입구 앞 6 m 에 선다(portalOffset) -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="teleport Player 11 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="themepark" timeoutFrames="60"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<Expect watch="Object.X" target="themepark/ParkGate" near="11" tolerance="0.05"/>
	<Expect watch="Object.Z" target="themepark/ParkGate" near="38" tolerance="0.05"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="0" timeoutFrames="30"/>
	<Expect watch="Minigame.Active" is="none"/>

	<!-- abilityarena -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="teleport Player 18 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="abilityarena" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/abilityarena/maps/arena.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="6" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- velmora -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="teleport Player 25 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="velmora" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/velmora/maps/vale.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="7" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- starskirmish — 자리 8 은 둘째 줄 첫 칸(시작에서 Z 로 7 m)이다. 미니게임 레이어가 켠 가상 커서는 나오면 꺼진다 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_starskirmish" near="-24" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_starskirmish" near="39" tolerance="0.01"/>
	<DevCommand line="teleport Player -24 0.05 39"/>
	<WaitUntil watch="Minigame.Active" is="starskirmish" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/starskirmish/maps/skirmish.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="8" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<WaitUntil watch="Input.VirtualCursorEnabled" equals="0" timeoutFrames="60"/>
	<!-- kartracing — 자리 15 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_kartracing" near="25" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_kartracing" near="39" tolerance="0.01"/>
	<Store watch="Minigame.RestoreCount" as="before_kartracing"/>
	<DevCommand line="teleport Player 25 0.05 39"/>
	<WaitUntil watch="Minigame.Active" is="kartracing" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/kartracing/maps/circuit.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" increaseFrom="before_kartracing" increaseBy="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- partyarena — 자리 16 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_partyarena" near="-24" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_partyarena" near="46" tolerance="0.01"/>
	<Store watch="Minigame.RestoreCount" as="before_partyarena"/>
	<DevCommand line="teleport Player -24 0.05 46"/>
	<WaitUntil watch="Minigame.Active" is="partyarena" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/partyarena/maps/trampoline.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" increaseFrom="before_partyarena" increaseBy="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- rhythm — 자리 17 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_rhythm" near="-17" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_rhythm" near="46" tolerance="0.01"/>
	<Store watch="Minigame.RestoreCount" as="before_rhythm"/>
	<DevCommand line="teleport Player -17 0.05 46"/>
	<WaitUntil watch="Minigame.Active" is="rhythm" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/rhythm/maps/stage.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" increaseFrom="before_rhythm" increaseBy="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- cardgame — 자리 18 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_cardgame" near="-10" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_cardgame" near="46" tolerance="0.01"/>
	<Store watch="Minigame.RestoreCount" as="before_cardgame"/>
	<DevCommand line="teleport Player -10 0.05 46"/>
	<WaitUntil watch="Minigame.Active" is="cardgame" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/cardgame/maps/table.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" increaseFrom="before_cardgame" increaseBy="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>

	<!-- sidescrollconquest — 자리 19 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Object.X" target="MinigamePortal_sidescrollconquest" near="-3" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_sidescrollconquest" near="46" tolerance="0.01"/>
	<Store watch="Minigame.RestoreCount" as="before_sidescrollconquest"/>
	<DevCommand line="teleport Player -3 0.05 46"/>
	<WaitUntil watch="Minigame.Active" is="sidescrollconquest" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/sidescrollconquest/maps/front.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" increaseFrom="before_sidescrollconquest" increaseBy="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<Pass/>
</Scenario>
