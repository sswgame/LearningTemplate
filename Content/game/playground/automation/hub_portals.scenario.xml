<!--
  허브의 미니게임 입구 — 정의(minigames/*.minigame.xml)의 portalSlot 하나가 입구 하나다(maps/hub 의 MinigamePortals 가 prefabs/minigameportal 를 세운다).
  미니게임(pixeltown · harvestvalley · voxelcraft · frontiertown · meadowvillage · themepark · abilityarena · velmora · starskirmish · fighting · battleroyale · mecharena · metroidvania · kartracing · partyarena · rhythm · cardgame · sidescrollconquest · asymmetrichorror · coopscavenger · ghosthunt · survivalhorror · classicjrpg · monstercollector · monsterhuntrpg · restaurantsim)의 입구에 플레이어를 세워 들어가고, minigame.leave 로 나와 마을이 복원되는지 본다.
  돌아온 자리는 입구 안이다 — 다시 세운 입구가 나타난 플레이어를 세지 않는다(_spawnInside Ignore). 입구를 더하면 여기에 한 묶음을 더한다.
  실행: App -scenario=game/playground/automation/hub_portals.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.hub_portals" fixedDelta="0.0166667" timeoutFrames="21600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/hub.scene.xml"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Minigame.Active" is="none"/>
	<!-- 자리: 시작(-24, 32)에서 X 로 7 m 마다 -->
	<Expect watch="Object.X" target="MinigamePortal_pixeltown" near="-24" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_harvestvalley" near="-17" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_voxelcraft" near="-10" tolerance="0.01"/>
	<Expect watch="Object.X" target="MinigamePortal_frontiertown" near="-3" tolerance="0.01"/>
	<Expect watch="Object.Z" target="MinigamePortal_frontiertown" near="32" tolerance="0.01"/>

	<!-- pixeltown — 입구 둘레에 다가오면 미리 읽기가 먼저 걸린다(들어가지는 않는다) -->
	<DevCommand line="teleport Player -24 0.05 36"/>
	<WaitUntil watch="Object.X" target="Player" near="-24" tolerance="0.05" timeoutFrames="10"/>
	<WaitUntil watch="Object.Property" target="MinigamePreload_pixeltown" key="MinigamePreloadTriggerComponent._fireCount" equals="1" timeoutFrames="30"/>
	<ExpectLog id="MinigameFlow.Preload" contains="'pixeltown'" atLeast="1"/>
	<Expect watch="Minigame.Active" is="none"/>
	<DevCommand line="teleport Player -24 0.05 32"/>
	<WaitUntil watch="Minigame.Active" is="pixeltown" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/pixeltown/maps/town.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<Expect watch="Object.X" target="Player" near="-24" tolerance="0.05"/>
	<AdvanceSimulation frames="30"/> <!-- 다시 세운 입구 안에 머문다 — 다시 들어가지 않음은 시간이 내용 -->
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Object.X" target="MinigamePortal_pixeltown" near="-24" tolerance="0.01"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>

	<!-- harvestvalley -->
	<DevCommand line="teleport Player -17 0.05 32"/>
