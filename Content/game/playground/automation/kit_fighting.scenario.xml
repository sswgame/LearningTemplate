<!--
  장르 키트 시연 — 3D 격투 키트(GF_Fighting)의 대전 한 바퀴: 체력 10 캐릭터 둘 · 선승 1 라운드 → 0 번이 하단(피해 10) 한 방 → 1 번 K.O. → 대전 끝, 0 번 승리.
  감시 값: KitDemo.Fighting.State(0 시작 전, 1 마침) · .MatchWinner · .LoserHealth · .WinnerRounds.
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.kit_fighting" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstExperience" value="kit_fighting"/>
	<WaitUntil watch="KitDemo.Fighting.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.Fighting.MatchWinner" equals="0"/>
	<Expect watch="KitDemo.Fighting.LoserHealth" equals="0"/>
	<Expect watch="KitDemo.Fighting.WinnerRounds" equals="1"/>
	<ExpectLog id="KitDemo.FightingDone" count="1"/>
	<Pass/>
</Scenario>
