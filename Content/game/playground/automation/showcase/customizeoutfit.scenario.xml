<?asset guid="f04e128a602f402daca0449bbb74d078"?>
<!--
  게임 중 꾸미기 ② 머리 모양 · 장비 — 무대 maps/customizationshowcase 의 Hero(UBC 마을 사람, 부품을 몸 메시에 합침)와 Twin(같은 프리셋, 부품 그대로).
  ⑴ 머리 모양 교체(SimpleParted → Bearded — 수염 부품이 더해진다), ⑵ 투구가 머리카락만 감춘다(규칙 HelmetHidesHair — 눈썹 · 수염은 남는다),
  ⑶ 옷 교체(Ranger → Peasant — 피팅을 다시 굽는다), ⑷ 무기 바꾸기 · 칸 비우기(투구를 벗으면 머리카락이 돌아온다), ⑸ 숨김 칸(1인칭의 손 무기),
  ⑹ Hero 를 바꾸는 동안 같은 차림의 Twin 은 그대로다(공유 캐시 · 부품 풀이 번지지 않는다).
  거짓 통과 막기: 바꿀 때마다 앞 사진과 Hero 영역이 다른지(ExpectImagesDiffer), Twin 영역은 같은지 본다. 골든은 통합 담당이 뜬다(-scenario-record-missing-golden).
  실행: App -scenario=game/playground/automation/showcase/customizeoutfit.scenario.xml -unattended
-->
<Scenario name="game.playground.customizeoutfit" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/shooter3d/maps/customizationshowcase.scene.xml"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="Hero" key="Hair" is="SimpleParted"/>
	<Expect watch="Appearance.PartCount" target="Hero" key="Hair" equals="2"/> <!-- 머리카락 · 눈썹 -->
	<Expect watch="Appearance.PartCount" target="Hero" key="Outfit" equals="5"/> <!-- 레인저: 팔 · 몸 · 다리 · 장화 · 어깨받이 -->
	<Expect watch="Appearance.SlotItem" target="Hero" key="MainHand" is="scifi_pistol"/>
	<Expect watch="Appearance.MergedSections" target="Hero" atLeast="2"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_base.ppm"/>
	<ExpectImage file="outfit_base.ppm" golden="outfit_base"/>

	<!-- ⑴ 머리 모양 -->
	<Store watch="Appearance.AssembleCount" target="Hero" as="heroAssembles"/>
	<DevCommand line="exec Hero applyOptionValue Hair Bearded"/>
	<WaitUntil watch="Appearance.AssembleCount" target="Hero" increaseFrom="heroAssembles" increaseBy="1" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="Hero" key="Hair" is="Bearded"/>
	<Expect watch="Appearance.PartCount" target="Hero" key="Hair" equals="3"/> <!-- 머리카락 · 눈썹 · 수염 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_hair.ppm"/>
	<ExpectImage file="outfit_hair.ppm" golden="outfit_hair"/>
	<ExpectImagesDiffer first="outfit_base.ppm" second="outfit_hair.ppm" region="0.25,0.28,0.33,0.45" minDiffering="0.01"/>

	<!-- ⑵ 투구가 머리카락만 감춘다 -->
	<DevCommand line="exec Hero setSlotItem Head helmet_knight"/>
	<WaitUntil watch="Appearance.SlotItem" target="Hero" key="Head" is="helmet_knight" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.PartCount" target="Hero" key="Hair" equals="2"/> <!-- 눈썹 · 수염 — 머리카락은 투구 안 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_helmet.ppm"/>
	<ExpectImage file="outfit_helmet.ppm" golden="outfit_helmet"/>
	<ExpectImagesDiffer first="outfit_hair.ppm" second="outfit_helmet.ppm" region="0.25,0.28,0.33,0.45" minDiffering="0.01"/>

	<!-- ⑶ 옷 교체 — 덮는 몸을 피팅이 다시 뺀다 -->
	<DevCommand line="exec Hero applyOptionValue Outfit Peasant"/>
	<WaitUntil watch="Appearance.Value" target="Hero" key="Outfit" is="Peasant" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.PartCount" target="Hero" key="Outfit" equals="4"/> <!-- 농부: 팔 · 몸 · 다리 · 발 -->
	<Expect watch="Appearance.SlotItem" target="Hero" key="Head" is="helmet_knight"/> <!-- 옷을 바꿔도 칸은 그대로 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_peasant.ppm"/>
	<ExpectImage file="outfit_peasant.ppm" golden="outfit_peasant"/>
	<ExpectImagesDiffer first="outfit_helmet.ppm" second="outfit_peasant.ppm" region="0.18,0.25,0.4,0.75" minDiffering="0.01"/>

	<!-- ⑷ 무기 바꾸기 · 투구 벗기 — 머리카락이 돌아온다 -->
	<DevCommand line="exec Hero setSlotItem MainHand scifi_rifle"/>
	<DevCommand line="exec Hero setSlotItem Head"/>
	<WaitUntil watch="Appearance.SlotItem" target="Hero" key="Head" is="(empty)" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.SlotItem" target="Hero" key="MainHand" is="scifi_rifle"/>
	<Expect watch="Appearance.PartCount" target="Hero" key="Hair" equals="3"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_rifle.ppm"/>
	<ExpectImage file="outfit_rifle.ppm" golden="outfit_rifle"/>
	<ExpectImagesDiffer first="outfit_peasant.ppm" second="outfit_rifle.ppm" region="0.18,0.25,0.4,0.75" minDiffering="0.002"/>

	<!-- ⑸ 숨김 칸 — 1인칭처럼 손 무기만 숨기고 몸은 그린다. 다시 보이면 앞 사진과 같다 -->
	<DevCommand line="exec Hero setSlotHidden MainHand true"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_hidden.ppm"/>
	<ExpectImagesDiffer first="outfit_rifle.ppm" second="outfit_hidden.ppm" region="0.18,0.25,0.4,0.75" minDiffering="0.001"/>
	<DevCommand line="exec Hero setSlotHidden MainHand false"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="outfit_shown.ppm"/>
	<ExpectImagesDiffer first="outfit_rifle.ppm" second="outfit_shown.ppm" minDiffering="0" maxDiffering="0.002"/>

	<!-- ⑹ 같은 차림의 Twin 은 처음 그대로다 -->
	<Expect watch="Appearance.Value" target="Twin" key="Hair" is="SimpleParted"/>
	<Expect watch="Appearance.Value" target="Twin" key="Outfit" is="Ranger"/>
	<Expect watch="Appearance.SlotItem" target="Twin" key="MainHand" is="scifi_pistol"/>
	<ExpectImagesDiffer first="outfit_base.ppm" second="outfit_shown.ppm" region="0.4,0.25,0.82,0.75" minDiffering="0" maxDiffering="0.002"/>
	<Pass/>
</Scenario>
