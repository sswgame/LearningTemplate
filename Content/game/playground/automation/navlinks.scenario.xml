<!--
  내비 링크 · 장애물(maps/navlinks) — 경로 감시 값(Nav.PathLength · Nav.PathLinkCount, 대상 → key 오브젝트)으로 판정한다(골든 없음).
  ① Barrier(NavMeshObstacleComponent)가 Start(Z -4.5)와 Goal(Z 0.5) 사이를 뚫어 길이 곧은 5 m 보다 길다(옆으로 돈다). ② Barrier 를 치우면(object.place) 뚫린 타일을 다시 구워 곧은 길이 된다.
  ③ 바닥에서 단(PlatformGoal, Y 2)까지는 JumpLink(NavMeshLinkComponent) 하나를 건너야 끝까지 간다.
  ④ 월드 원점을 옮겨도(world.origin) 같은 길이고, 옮긴 월드에서 Barrier 를 되돌려 놓으면(로컬 자리) 다시 돌아간다 — 내비메시는 절대, 질의 · 장애물은 로컬 자리다.
  실행: App -scenario=game/playground/automation/navlinks.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.navlinks" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/navlinks.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Nav.PathLength" target="Start" key="Goal" atLeast="6" timeoutSeconds="5"/>

	<DevCommand line="object.place Barrier 20 0.5 -2"/>
	<WaitUntil watch="Nav.PathLength" target="Start" key="Goal" atMost="5.3" timeoutSeconds="5"/>

	<WaitUntil watch="Nav.PathLinkCount" target="Goal" key="PlatformGoal" equals="1" timeoutSeconds="5"/>

	<DevCommand line="world.origin 100 40"/>
	<Expect watch="Scene.WorldOriginX" equals="100"/>
	<Expect watch="Nav.PathLength" target="Start" key="Goal" atMost="5.3"/>
	<Expect watch="Nav.PathLinkCount" target="Goal" key="PlatformGoal" equals="1"/>
	<DevCommand line="object.place Barrier -100 0.5 -42"/>
	<WaitUntil watch="Nav.PathLength" target="Start" key="Goal" atLeast="6" timeoutSeconds="5"/>
	<Pass/>
</Scenario>
