<!--
  사격장 빗마당 — 밟은 표면마다 다른 발걸음 반응(SurfaceKindDef 의 _step · _wetStep — 소리 · 튀는 효과 · 발자국 · 발 적시기)과 비 날씨.
  무대 maps/rainyard.scene.xml: x = 0 줄에 흙(z -14 ~ -10) · 웅덩이(z -10 ~ -6, 얕은 물) · 진흙(z -6 ~ -2), 흙 옆 돌(x -3.5). 플레이어는 (0, -16) 에서 +Z 를 본다.
  Walker(스켈레톤 전사, 클립 알림)는 제자리 걷기라 object.place 로 옮기고, 플레이어 몸(UAL 클립, 알림 없음)은 발 닿음 감지가 발걸음을 낸다.
  둘이 함께 걸으므로 반응은 오브젝트마다의 감시 값(Surface.Object* — target)으로 본다.
  ① Walker 흙(마름): 흙먼지(footstep_dust) · 소리 Footstep.Dirt · 발자국(깊이 1.2 cm, 거의 메워지지 않는다). 사진 dirt_footprints 는 흙 패드의 발자국(골든).
  ② 돌(마름): 효과 없음 · 소리 Footstep.Stone · 발자국 없음.
  ③ 웅덩이: Water 로 세고 물 튀김(footstep_splash — 효과 풀 VFX.PoolPlayed) · 소리 Footstep.Water, 발이 젖는다.
  ④ 웅덩이 → 돌: 젖은 발이 마른 돌에 젖은 자국을 남긴다(Surface.WetPrintPlaced · DeformWetTexels — 표면 변형 층의 젖음 채널).
  ⑤ 진흙: 진흙 튐(footstep_mud) · 소리 Footstep.Mud.
  ⑥ 플레이어 1인칭: W 로 흙 → 웅덩이 → 진흙을 지나며 표면마다 흙먼지 · 물 튀김 · 진흙 튐과 그 소리가 난다.
  ⑦ 플레이어 3인칭: 시점을 바꿔 S 로 되돌아오며 같은 반응이 난다(발걸음은 시점과 무관한 몸의 포즈에서 온다).
  ⑧ 비(cheat.weather rain): 판 상태가 카탈로그의 바인딩대로 Weather.x = 1 · Rain.x = 1 을 쓰고, 같은 흙이 젖은 반응(진흙 튐 · Footstep.DirtWet)을 낸다.
  ⑨ 비 물결: 시간을 멈추고(링이 같은 위상, 팔 · 입자도 멈춘다) Rain.x 1 · 0 · 1 세 장을 찍는다. 1 과 0 은 달라야 하고(젖은 땅과 웅덩이가 비추는 흐린 하늘 — 스카이 라이트 — 이
     링의 노멀로 흔들린다), 처음과 마지막 1 은 같아야 한다(멈춘 시간의 두 장이 같다 — 팔 흔들림 · 입자 같은 다른 차이로 거짓 통과하지 않는다).
     날씨는 그대로라 판 상태는 Rain 을 다시 쓰지 않는다(바뀔 때만 쓴다).
  골든은 통합 때 기록한다(-scenario-record-missing-golden).
  실행: App -scenario=game/playground/automation/shooter3d_rainyard.scenario.xml -unattended (체인: ctest -R Scenario.playground.shooter3d)
-->
<Scenario name="game.playground.shooter3d_rainyard" fixedDelta="0.0166667" timeoutFrames="4800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="shooter3d_rainyard"/>
	<Variable name="gv_cameraFieldOfView" value="80"/> <!-- 골든은 시야각 80 으로 찍었다(옛 게임 팩의 기본값) -->
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Material.CollectionValue" target="engine/materials/weather.matparams.xml" key="Weather.x" equals="0" timeoutFrames="60"/>

	<!-- ① Walker 흙(마름) -->
	<DevCommand line="object.place Walker 0 0.05 -12.6"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="Walker" key="Dirt" atLeast="4" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Dirt"/>
	<Expect watch="Surface.ObjectLastFootstepState" target="Walker" is="dry"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="Walker" key="Dirt" is="engine/vfx/footstep_dust.vfx.xml"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="Walker" key="Dirt" is="Footstep.Dirt"/>
	<Expect watch="VFX.PoolPlayed" key="engine/vfx/footstep_dust.vfx.xml" atLeast="1"/>
	<Expect watch="Surface.FootprintPlaced" atLeast="2"/>
	<Expect watch="Surface.DeformDeepestNear" key="0 -12.6 0.6" atLeast="0.008"/>
	<AdvanceSimulation frames="1"/> <!-- 판정과 다음 자리 옮기기를 다른 프레임에 둔다(프레임 경계) -->
	<DevCommand line="object.place Walker 0 0.05 -11.4"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="Walker" key="Dirt" atLeast="8" timeoutSeconds="5"/>
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 16 0.05 -18"/> <!-- 사진에서 발자국을 가리지 않는 자리(무대 밖 돌 바닥) -->
	<WaitUntil watch="Surface.ObjectLastFootstep" target="Walker" is="Stone" timeoutSeconds="5"/>
	<Screenshot file="dirt_footprints.ppm" stability="Assets"/>

	<!-- ② 돌(마름) -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker -3.5 0.05 -12"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="Walker" key="Stone" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Stone"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="Walker" key="Stone" is="none"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="Walker" key="Stone" is="Footstep.Stone"/>
	<Expect watch="Surface.WetPrintPlaced" equals="0"/>

	<!-- ③ 웅덩이 -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 0 0.05 -8"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="Walker" key="Water" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Water"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="Walker" key="Water" is="engine/vfx/footstep_splash.vfx.xml"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="Walker" key="Water" is="Footstep.Water"/>
	<Expect watch="VFX.PoolPlayed" key="engine/vfx/footstep_splash.vfx.xml" atLeast="2"/>
	<Expect watch="VFX.PoolSize" key="engine/vfx/footstep_splash.vfx.xml" atMost="16"/>

	<!-- ④ 웅덩이 → 돌: 젖은 발자국 -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker -3.5 0.05 -12.6"/>
	<WaitUntil watch="Surface.WetPrintPlaced" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Stone"/>
	<Expect watch="Surface.ObjectLastFootstepState" target="Walker" is="dry"/>
	<Expect watch="Surface.DeformWetTexels" atLeast="1"/>

	<!-- ⑤ 진흙 -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 0 0.05 -4"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="Walker" key="Mud" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Mud"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="Walker" key="Mud" is="engine/vfx/footstep_mud.vfx.xml"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="Walker" key="Mud" is="Footstep.Mud"/>
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 16 0.05 -18"/> <!-- 플레이어의 길을 비운다 -->

	<!-- ⑥ 플레이어 1인칭: 흙 → 웅덩이 → 진흙(발 닿음 감지가 낸 발걸음). 표면마다 첫 걸음의 반응을 그 프레임에 본다. -->
	<Press slot="Key.W"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="PlayerBody" key="Dirt" atLeast="1" timeoutSeconds="4"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="PlayerBody" key="Dirt" is="engine/vfx/footstep_dust.vfx.xml"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="PlayerBody" key="Dirt" is="Footstep.Dirt"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="PlayerBody" key="Water" atLeast="1" timeoutSeconds="4"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="PlayerBody" key="Water" is="engine/vfx/footstep_splash.vfx.xml"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="PlayerBody" key="Water" is="Footstep.Water"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="PlayerBody" key="Mud" atLeast="1" timeoutSeconds="4"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="PlayerBody" key="Mud" is="engine/vfx/footstep_mud.vfx.xml"/>
	<Release slot="Key.W"/>

	<!-- ⑦ 플레이어 3인칭: 시점만 바꿔 뒤로 걸어 진흙 → 웅덩이 → 흙을 되밟는다 -->
	<DevCommand line="camera.preset thirdperson"/>
	<Press slot="Key.S"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="PlayerBody" key="Water" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectFootstepEffectOn" target="PlayerBody" key="Water" is="engine/vfx/footstep_splash.vfx.xml"/>
	<WaitUntil watch="Surface.ObjectFootstepCount" target="PlayerBody" key="Dirt" atLeast="2" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectFootstepSoundOn" target="PlayerBody" key="Dirt" is="Footstep.Dirt"/>
	<Release slot="Key.S"/>
	<DevCommand line="camera.preset firstperson"/>

	<!-- ⑧ 비: 같은 흙이 젖은 반응을 낸다. 흙 위로 먼저 옮긴 뒤 비를 내린다(진흙은 젖은 반응이 있어 진흙 위에서 비를 내리면 진흙 걸음이 먼저 wet 이 된다). -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 1 0.05 -13.5"/>
	<WaitUntil watch="Surface.ObjectLastFootstep" target="Walker" is="Dirt" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstepState" target="Walker" is="dry"/>
	<DevCommand line="cheat.weather rain"/>
	<WaitUntil watch="Material.CollectionValue" target="engine/materials/weather.matparams.xml" key="Weather.x" equals="1" timeoutFrames="60"/>
	<WaitUntil watch="Material.CollectionValue" target="engine/materials/weather.matparams.xml" key="Rain.x" equals="1" timeoutFrames="60"/>
	<WaitUntil watch="Surface.ObjectLastFootstepState" target="Walker" is="wet" timeoutSeconds="5"/>
	<Expect watch="Surface.ObjectLastFootstep" target="Walker" is="Dirt"/>
	<Expect watch="Surface.ObjectLastFootstepEffect" target="Walker" is="engine/vfx/footstep_mud.vfx.xml"/>
	<Expect watch="Surface.ObjectLastFootstepSound" target="Walker" is="Footstep.DirtWet"/>

	<!-- ⑨ 비 물결 켜기 · 끄기 · 다시 켜기: 걷는 이를 화면 밖으로 옮기고 시간을 멈춰 세 장이 링만 다르게 한다 -->
	<AdvanceSimulation frames="1"/>
	<DevCommand line="object.place Walker 16 0.05 -18"/>
	<AdvanceSimulation frames="90"/> <!-- 흙 패드의 마지막 진흙 튐(수명 0.5 초)이 다 사라질 시간 — 화면에 남은 입자가 사진의 차이에 섞이지 않게(시간이 내용) -->
	<Variable name="gv_timeScale" value="0"/>
	<Screenshot file="rain_rings_on.ppm" stability="Assets"/>
	<DevCommand line="matparam engine/materials/weather.matparams.xml Rain 0"/>
	<WaitUntil watch="Material.CollectionValue" target="engine/materials/weather.matparams.xml" key="Rain.x" equals="0" timeoutFrames="10"/>
	<Screenshot file="rain_rings_off.ppm" stability="Assets"/>
	<DevCommand line="matparam engine/materials/weather.matparams.xml Rain 1"/>
	<WaitUntil watch="Material.CollectionValue" target="engine/materials/weather.matparams.xml" key="Rain.x" equals="1" timeoutFrames="10"/>
	<Screenshot file="rain_rings_again.ppm" stability="Assets"/>
	<Variable name="gv_timeScale" value="1"/>
	<ExpectImagesDiffer first="rain_rings_on.ppm" second="rain_rings_off.ppm" region="0.25,0.7,0.66,1" minDiffering="0.002" fullResolution="true"/> <!-- 링은 화소 단위 무늬라 골든 크기로 줄이면 평균이 지운다. 영역은 웅덩이 자리(링이 생기는 곳) — 멈춘 시간의 두 장이 0 % 라 잡음 바닥이 0 이다 -->
	<ExpectImagesDiffer first="rain_rings_on.ppm" second="rain_rings_again.ppm" region="0.25,0.7,0.66,1" minDiffering="0" maxDiffering="0.0005" fullResolution="true"/>

	<ExpectImage file="dirt_footprints.ppm" golden="dirt_footprints"/>
	<ExpectImage file="rain_rings_on.ppm" golden="rain_rings_on"/>
	<Pass/>
</Scenario>
