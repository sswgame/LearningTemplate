<!--
  서부극 도착 컷씬의 입력 정책 — 기수가 마을 앞(TownArrival)에 닿아 ArrivalDirector 의 시퀀스가 게임 흐름(시퀀스 트리거)에서 튼다. 씬 데이터가 컷씬 옵션을 고른다
  (_playerMovement Blocked · _bHideHUD · _bSkippable · _bAllowFastForward — 언리얼 FMovieSceneSequencePlaybackSettings 의 bDisableMovementInput · bHideHud 자리).
  ① 재생 동안 컷씬 입력 레이어가 아래(이동 · 시선 · 게임 동작)를 막아 W 를 눌러도 기수가 서 있고, HUD 레이어가 숨는다.
  ② 빨리감기(Cutscene.FastForward, Period 를 누른 채)는 속도에 EngineConfig _sequencer._fastForwardRate(4)를 곱하고, 놓으면 1 배로 돌아온다.
  ③ 일시정지(게임 시간 정지 gv_timeScale 0 — 일시정지 메뉴와 같은 원천)면 재생 위치가 서 있고, 그 동안 자막을 끄고(gv_subtitles 0 — 옵션 메뉴 자리) 재개하면 그 자리부터 이어 가며 자막이 사라진다.
  ④ 건너뛰기(Cutscene.Skip, Backspace)는 끝 상태로 점프해 정상 끝이 되고, 화면은 게임 카메라, 입력 막기 · HUD 숨김이 풀려 W 가 다시 기수를 움직인다.
  ⑤ 범위 제한(Confined)으로 다시 틀면 움직일 수 있되 TownArrival 둘레 3 m 밖으로 나가지 못한다.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/wildwest_arrivalskip.scenario.xml -unattended
-->
<Scenario name="game.playground.wildwest_arrivalskip" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/prairie.scene.xml"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="0"/>
	<Expect watch="UI.HUDHidden" equals="0"/>

	<AdvanceSimulation frames="10"/> <!-- 볼륨이 나타난 창(8 프레임 — _spawnInside Ignore)을 지나야 순간이동이 걸어 들어온 것이다 -->
	<DevCommand line="teleport Player 40 0.05 0"/>
	<WaitUntil watch="Object.Property" target="TownArrival" key="SequenceTriggerComponent._fireCount" equals="1" timeoutFrames="30"/>
	<!-- ① 입력 막힘 · HUD 숨김 -->
	<WaitUntil watch="Sequence.InputBlocked" target="ArrivalDirector" equals="1" timeoutFrames="4"/>
	<Expect watch="UI.HUDHidden" equals="1"/>
	<Store watch="Object.Z" target="Player" as="blockedZ"/>
	<Press slot="Key.W"/>
	<AdvanceSimulation frames="20"/> <!-- 누른 채 시간이 흘러야 한다(일어나지 않음은 그 시간 뒤의 값) -->
	<Expect watch="Object.Z" target="Player" sameAs="blockedZ" tolerance="0.001"/>
	<Release slot="Key.W"/>

	<!-- ② 빨리감기: 4 배 — 1 틱에 시퀀스 두 프레임 -->
	<Press slot="Key.Period"/>
	<WaitUntil watch="Sequence.PlayRate" target="ArrivalDirector" equals="4" timeoutFrames="4"/>
	<Store watch="Sequence.Frame" target="ArrivalDirector" as="fastFrame"/>
	<AdvanceSimulation frames="4"/>
	<Expect watch="Sequence.Frame" target="ArrivalDirector" increaseFrom="fastFrame" increaseBy="6"/>
	<Release slot="Key.Period"/>
	<WaitUntil watch="Sequence.PlayRate" target="ArrivalDirector" equals="1" timeoutFrames="4"/>

	<!-- ③ 일시정지 중 위치가 서 있고, 자막을 끄고 재개하면 그 자리부터 -->
	<WaitUntil watch="UI.SubtitleShown" equals="1" timeoutFrames="30"/>
	<Variable name="gv_timeScale" value="0"/>
	<Store watch="Sequence.Frame" target="ArrivalDirector" as="pausedFrame"/>
	<AdvanceSimulation frames="10"/>
	<Expect watch="Sequence.Frame" target="ArrivalDirector" sameAs="pausedFrame"/>
	<Variable name="gv_subtitles" value="0"/>
	<Variable name="gv_timeScale" value="1"/>
	<WaitUntil watch="Sequence.Frame" target="ArrivalDirector" differsFrom="pausedFrame" timeoutFrames="10"/>
	<Expect watch="Sequence.Frame" target="ArrivalDirector" increaseFrom="pausedFrame" increaseBy="1"/>
	<WaitUntil watch="UI.SubtitleShown" equals="0" timeoutFrames="4"/>

	<!-- ④ 건너뛰기 → 끝 상태 · 조작 복귀 -->
	<Tap slot="Key.Backspace" hold="1"/>
	<WaitUntil watch="Sequence.History" target="ArrivalDirector" key="Finished" equals="1" timeoutFrames="6"/>
	<Expect watch="Sequence.Frame" target="ArrivalDirector" equals="90"/>
	<WaitUntil watch="Camera.FrameObject" is="GameCamera" timeoutFrames="6"/>
	<Expect watch="Cinematic.CutCamera" target="ArrivalDirector" is="none"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="0"/>
	<Expect watch="UI.HUDHidden" equals="0"/>
	<Store watch="Object.Z" target="Player" as="freeZ"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Object.Z" target="Player" differsFrom="freeZ" timeoutFrames="30"/>
	<Release slot="Key.W"/>

	<!-- ⑤ 범위 제한: 걸을 수 있되 TownArrival 둘레 3 m 안 -->
	<DevCommand line="teleport Player 40 0.05 0"/>
	<AdvanceSimulation frames="2"/> <!-- 순간이동이 물리에 닿는다(프레임 경계) -->
	<PlaySequence object="ArrivalDirector" movement="Confined"/>
	<Expect watch="Sequence.InputBlocked" target="ArrivalDirector" equals="0"/>
	<Press slot="Key.W"/>
	<AdvanceSimulation frames="120"/> <!-- 2 초 걸으면 3 m 를 넘는다 — 제한이 경계에서 세운다 -->
	<Expect watch="Object.DistanceTo" target="Player" key="TownArrival" atMost="3.3"/>
	<Expect watch="Object.DistanceTo" target="Player" key="TownArrival" atLeast="2"/>
	<Release slot="Key.W"/>
	<SkipSequence object="ArrivalDirector"/>
	<Pass/>
</Scenario>
