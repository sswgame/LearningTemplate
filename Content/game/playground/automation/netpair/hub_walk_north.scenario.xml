<!--
  허브 폰 두 클라이언트(북쪽(+Z)) — `py -3 -m Scripts net-pair mmo` 가 앞의 두 접속 뒤 같은 서버에 두 클라이언트를 함께 띄운다(회선 흉내: 지연 60 ms · 흔들림 10 ms · 손실 3 %).
  접속한 계정마다 서버가 폰을 세우고, 자기 폰은 예측하며(Hub.PawnPredicted), 남의 폰은 보간한 모습(HubRemotePawn)으로 보인다.
  ① 서로의 폰이 보이면 북쪽(+Z) 로 걷는다 — 자기 폰이 걷고(예측), 상대가 반대쪽으로 걷는 것이 보인다(복제). 걷는 동안 상대의 자리를 기다린다(둘이 같은 때 시작하지 않아도 된다).
     상대가 보는 문턱(2.5 m)은 자기가 멈추는 자리(5 m)보다 안쪽이다 — 먼저 끝난 쪽이 나가기 전에 상대가 본다.
  ② 어긋난 예측: 개발 명령 teleport 로 클라이언트의 자리만 20 m 옮긴다(속도 치트와 같은 모양) — 서버의 자리는 그대로이고, 되감아 맞춰 걷던 자리로 돌아온다(Hub.PawnCorrections).
  넷 걸음은 실제 시간으로 돌아 기다림은 실제 시간 시한(timeoutWallSeconds)이다. 회선 흉내 아래라 보정 횟수는 하한만 본다.
-->
<Scenario name="game.playground.netpair.hub_walk_north" fixedDelta="0.0166667" realTime="true" timeoutFrames="36000" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Expect watch="Hub.NetRole" equals="0"/>
	<Expect watch="Hub.PawnPredicted" equals="0"/>
	<DevCommand line="net.ticketconnect {gv_onlineServerAddress} hub_north hub_north_pw_1 playground_hub {gv_gameServerAddress}"/>
	<WaitUntil watch="Hub.AvatarID" atLeast="1" timeoutWallSeconds="30"/>
	<WaitUntil watch="Hub.PawnPredicted" equals="1" timeoutWallSeconds="20"/>
	<!-- ① 상대의 폰(HubRemotePawn)이 선 뒤 걷는다 — 자리 값이 있으면 보인다 -->
	<WaitUntil watch="Object.Y" target="HubRemotePawn" atLeast="-1" timeoutWallSeconds="60"/>
	<Press slot="Key.W"/>
	<WaitUntil watch="Object.Z" target="HubRemotePawn" atMost="-2.5" timeoutWallSeconds="30"/>
	<WaitUntil watch="Object.Z" target="Player" atLeast="5" timeoutWallSeconds="20"/>
	<Release slot="Key.W"/>
	<!-- ② 클라이언트만 옮긴 자리는 서버에 닿지 않는다 — 걷던 자리로 되돌아온다 -->
	<DevCommand line="teleport Player 20 0.05 20"/>
	<WaitUntil watch="Hub.PawnCorrections" atLeast="1" timeoutWallSeconds="20"/>
	<WaitUntil watch="Object.X" target="Player" near="0" tolerance="2" timeoutWallSeconds="20"/>
	<Expect watch="Object.Z" target="Player" atLeast="4"/>
	<Expect watch="Hub.PawnPredicted" equals="1"/>
	<!-- ③ 카드 탁자(턴 중계): 두 자리가 차면 시작하고, 규칙에 맞는 행동만 서버가 번호를 붙인다. 둘이 번갈아 두 번씩 뽑는다(뽑으면 차례가 넘어간다 — 낸 패는 차례를 건너뛸 수 있다) -->
	<DevCommand line="hub.cards join"/>
	<WaitUntil watch="Hub.CardsStarted" equals="1" timeoutWallSeconds="60"/>
	<Expect watch="Hub.CardsSeat" atLeast="0"/>
	<!-- 서버가 나눈 패 — 내 손패는 일곱 장이 다 오고 상대는 장수만 온다. HUD 가 그 패를 보인다 -->
	<WaitUntil watch="Hub.CardsHand" atLeast="7" timeoutWallSeconds="20"/>
	<Expect watch="Hub.CardsOpponentHand" atLeast="7"/>
	<WaitUntil watch="Hub.CardsHUDShown" equals="1" timeoutWallSeconds="10"/>
	<WaitUntil watch="Hub.CardsMyTurn" equals="1" timeoutWallSeconds="30"/>
	<DevCommand line="hub.cards draw"/>
	<WaitUntil watch="Hub.CardsMyTurn" equals="0" timeoutWallSeconds="20"/>
	<WaitUntil watch="Hub.CardsMyTurn" equals="1" timeoutWallSeconds="30"/>
	<DevCommand line="hub.cards draw"/>
	<WaitUntil watch="Hub.CardsActions" atLeast="4" timeoutWallSeconds="30"/>
	<Expect watch="Hub.CardsRejected" equals="0"/>
	<!-- ④ 움직이는 바닥: 상대(남쪽)가 왕복 발판에 실려 가는 것이 보인다 — 바닥이 도는 동안 바닥 기준의 자리를 보고에 남긴다(상대가 남긴 자기 자리와 `Scripts net-pair mmo` 가 견준다) -->
	<WaitUntil watch="Hub.RemotePawnFloor" equals="1" timeoutWallSeconds="60"/>
	<WaitUntil watch="Object.X" target="FloorShuttle" atLeast="8.5" timeoutWallSeconds="20"/>
	<WaitUntil watch="Object.X" target="FloorShuttle" atMost="5.5" timeoutWallSeconds="20"/>
	<Expect watch="Hub.RemotePawnFloor" equals="1"/>
	<Record watch="Hub.RemotePawnFloorX"/>
	<Record watch="Hub.RemotePawnFloorZ"/>
	<DevCommand line="hub.status"/>
	<Pass/>
</Scenario>
