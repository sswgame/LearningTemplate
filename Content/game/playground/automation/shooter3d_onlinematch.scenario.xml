<!--
  사격장 온라인 매치(K4)의 거절 길 — 프로세스 안 서버(Config/Server/Online/Playground.json, 전용 서버와 같은 파일)에 붙어 값으로 본다. 판을 끝까지 도는 길은 두 · 세 프로세스가 본다
  (py -3 -m Scripts online-local run 은 매치 서버 하나, net-pair match 는 접속한 허브 → 매치 서버 → 허브).
  ① 허브(시작 맵)에서 매치형 미니게임 shooter3d_match 로 들어가면 매칭 모드 arena_solo(data/playground.matchmodes.xml)에 줄을 서고, 디렉터리에 등록한 이 서버(_publicAddress)로 배정된다
     (OnlineMatchFound). 그 게임 포트에는 서버가 없어 붙지 못하고 허브에 남는다(MatchNotConnected · MatchState 0) — 매치를 이 프로세스에서 대신 돌지 않는다.
  ② 순위표 arena_kills(data/playground.leaderboards.xml)는 매치 서버의 점수만 받는다 — 클라이언트가 낸 점수는 거절된다(OnlineRefusedScoreCount).
  실행: App -scenario=game/playground/automation/shooter3d_onlinematch.scenario.xml -unattended (체인: ctest -R Scenario.playground.shooter3d)
-->
<Scenario name="game.playground.shooter3d_onlinematch" fixedDelta="0.0166667" timeoutFrames="30000" startAfter="ScenePlaying" startTimeoutFrames="900" requiresModule="GF_Server_Matchmaking">
	<AllowLog id="LoginTicketKey.AccountKitNoTicketKeySecretEnvironment" reason="프로세스 안 개발 서버는 티켓 주 키 없이 개발 키를 쓴다 - 게임 접속 티켓을 쓰지 않는다"/>
	<AllowLog id="GameNetSession.NetSessionCouldNot5" reason="배정된 게임 포트에 서버가 없는 것이 이 시나리오의 조건이다"/>
	<AllowLog id="Playground.MatchNotConnected" reason="배정된 게임 포트에 서버가 없는 것이 이 시나리오의 조건이다"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<Expect watch="Online.SessionClientCount" atLeast="6"/>
	<Expect watch="Playground.OnlineMatchFound" equals="0"/>
	<DevCommand line="online.local.start Config/Server/Online/Playground.json"/>
	<WaitUntil watch="Online.SessionState" atLeast="3" timeoutSeconds="20"/>
	<Expect watch="Online.SessionState" equals="3"/>
	<DevCommand line="playground.online.login"/>
	<WaitUntil watch="Playground.OnlineLoggedIn" equals="1" timeoutSeconds="20"/>
	<!-- ① 줄 → 배정 → 붙지 못함 → 허브 -->
	<DevCommand line="minigame.enter shooter3d_match"/>
	<WaitUntil watch="Playground.OnlineMatchFound" equals="1" timeoutSeconds="20"/>
	<WaitUntil watch="Playground.MatchState" equals="0" timeoutSeconds="60"/>
	<ExpectLog id="Playground.MatchNotConnected" count="1"/>
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Minigame.RestoreCount" equals="0"/>
	<!-- ② 클라이언트 점수는 거절된다 -->
	<DevCommand line="playground.online.submitkills 7"/>
	<WaitUntil watch="Playground.OnlineRefusedScoreCount" equals="1" timeoutSeconds="10"/>
	<Expect watch="Playground.OnlineSubmittedScoreCount" equals="0"/>
	<DevCommand line="online.disconnect"/>
	<Expect watch="Online.SessionState" equals="0"/>
	<Pass/>
</Scenario>
