<?xml version="1.0" encoding="utf-8"?>
<?asset guid="9166e73987fa4db4992367f679b41df9"?>
<!--
  런타임 하위 레벨 — 데이터 레이어 무대(datalayer.scene.xml)에 내부 씬(datalayer_house.scene.xml)을 `scene.sublevel add` 로 두 번 더한다(언리얼 LoadLevelInstance 자리).
  ① 더한 씬은 다음 갱신에 앵커 아래로 펼쳐 선다(Shop/Box 가 앵커 자리 Z 4, 회전한 Yard 도 자기 자리). ② 저장 뒤 Shop/Box 를 옮기고 Yard 를 빼도, 불러오면 둘 다 저장 때 상태로 다시 선다.
  ③ 빼면 앵커와 멤버가 모두 내려간다. 값으로 판정한다(골든 없음).
  실행: ctest -R Scenario.game.playground.sublevel
-->
<Scenario name="game.playground.sublevel" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/datalayer.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Scene.SubLevelCount" equals="0"/>

	<!-- ① 더하기 — 다음 프레임에 앵커 아래로 선다 -->
	<DevCommand line="scene.sublevel add Shop game/playground/maps/datalayer_house.scene.xml 0 0 4"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.Exists" target="Shop" equals="1"/>
	<Expect watch="Object.X" target="Shop/Box" equals="0"/>
	<Expect watch="Object.Z" target="Shop/Box" equals="4"/>
	<Expect watch="Object.Exists" target="Shop/Roof" equals="1"/> <!-- 내부 파일 id 로 붙은 Roof 가 바깥 씬의 엔티티 1 이 아니라 자기 Box 에 붙어 섰다 -->
	<DevCommand line="scene.sublevel add Yard game/playground/maps/datalayer_house.scene.xml -6 0 4 90"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Object.X" target="Yard/Box" equals="-6"/>
	<Expect watch="Object.Z" target="Yard/Box" equals="4"/>

	<!-- ② 저장 → 바꾸기(옮기고 빼기) → 불러오기 — 같은 씬이라 그 자리에서 교체하고 하위 레벨은 세이브의 상태로 다시 선다 -->
	<Store watch="Save.Written" as="writtenBefore"/>
	<DevCommand line="game.save empty/sublevel"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<DevCommand line="object.place Shop/Box 2 0.75 0"/>
	<Expect watch="Object.X" target="Shop/Box" equals="2"/>
	<DevCommand line="scene.sublevel remove Yard"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="1" timeoutFrames="30"/>
	<Expect watch="Object.Exists" target="Yard/Box" equals="0"/>
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.load empty/sublevel"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="2" timeoutFrames="60"/>
	<Expect watch="Object.X" target="Shop/Box" equals="0"/>
	<Expect watch="Object.X" target="Yard/Box" equals="-6"/>
	<Expect watch="Object.Exists" target="Shop/Roof" equals="1"/>

	<!-- ③ 빼기 — 앵커와 멤버가 모두 내려간다 -->
	<DevCommand line="scene.sublevel remove Shop"/>
	<DevCommand line="scene.sublevel remove Yard"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="0" timeoutFrames="30"/>
	<Expect watch="Object.Exists" target="Shop" equals="0"/>
	<Expect watch="Object.Exists" target="Shop/Roof" equals="0"/>
	<Expect watch="Object.Exists" target="Yard/Box" equals="0"/>
	<Pass/>
</Scenario>
