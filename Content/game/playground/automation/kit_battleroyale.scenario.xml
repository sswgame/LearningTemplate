<!--
  장르 키트 시연 — 배틀로얄 키트(GF_BattleRoyale)의 판 한 바퀴: 팀 A(둘) · 팀 B(하나) → 자기장 10 걸음 → B 가 A 둘을 기절 → 팀 전멸로 판 끝, B 승리.
  감시 값: KitDemo.BattleRoyale.State(0 시작 전, 1 마침) · .WinningTeam · .WinnerKills · .Remaining.
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.kit_battleroyale" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstExperience" value="kit_battleroyale"/>
	<WaitUntil watch="KitDemo.BattleRoyale.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.BattleRoyale.WinningTeam" equals="1"/>
	<Expect watch="KitDemo.BattleRoyale.WinnerKills" equals="2"/>
	<Expect watch="KitDemo.BattleRoyale.Remaining" equals="1"/>
	<ExpectLog id="KitDemo.BattleRoyaleDone" count="1"/>
	<Pass/>
</Scenario>
