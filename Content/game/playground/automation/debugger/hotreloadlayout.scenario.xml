<?xml version="1.0" encoding="utf-8"?>
<?asset guid="bc08b37a1745e2b9a62225e5cf330976"?>
<!--
  핫 리로드 디버그 확인 — 헤더가 바뀐 판(칸 하나와 그 생성자 값 7 을 더한다). 검증 체인 밖이다: `Scripts/dev/hot_reload_debug_check.py` 를 variant 값 layout 으로 부르면 lldb 아래에서 띄운다(XML 주석은 하이픈 둘을 못 담는다).
  리로드는 리플렉션 칸으로 상태를 옮기므로 씬 값(42)은 그대로이고, 새 칸은 새 생성자의 값이어야 한다. 브레이크포인트 판정은 스크립트가 한다.
-->
<Scenario name="game.playground.debugger.hotreloadlayout" fixedDelta="0.0166667" timeoutFrames="7200" startAfter="Immediately" input="exclusive">
	<LoadScene path="guid:17b7840f535c4af0c3bac9e51c7d66a3" timeoutFrames="600"/>
	<WaitUntil watch="HotReload.TestKept" equals="42" timeoutFrames="30"/> <!-- 탐침이 값을 받았다 -->
	<Expect watch="HotReload.TestKept" equals="42"/>
	<Expect watch="HotReload.TestAdded" equals="0"/>
	<Store watch="HotReload.TestVersion" as="before"/>
	<DevCommand line="module.reload SWGame"/>
	<WaitUntil watch="Module.ReloadPending" equals="0" timeoutWallSeconds="600"/>
	<WaitUntil watch="HotReload.TestVersion" differsFrom="before" timeoutFrames="30"/> <!-- 새 모듈의 코드가 돈다 -->
	<Expect watch="Module.GraphBroken" equals="0"/>
	<Expect watch="HotReload.TestKept" equals="42"/>
	<Expect watch="HotReload.TestAdded" equals="7"/>
	<Expect watch="HotReload.TestVersion" differsFrom="before"/> <!-- 새 모듈의 코드를 부른다 — 스크립트는 여기서 같은 브레이크포인트가 새 모듈에서 멈추는지 본다 -->
	<Pass/>
</Scenario>
