<?asset guid="84780097979e57e66bbbc80247a69d77"?>
<!--
  타일 걸음 마을 미니게임(미니게임 pixeltown — 옛 게임 PixelTown) 걸음 · 충돌 · 대화 시나리오 — 가상 키 → 플레이어 조종자 → 주인공 폰의 의도 → 오버월드 키트의 한 칸 걸음 → 디렉터의 대화.
  주인공은 스폰 칸 (7,7)에서 시작한다. 위로 두 칸 가면 집 벽(소품 레이어의 solid 브러시)에 막히고, 내려와 오른쪽 다섯 칸 가서
  위를 보면 촌장(대화 러너를 단 오브젝트)이 선 칸이라 막힌다. Space 로 말을 걸고 두 줄을 넘기면 대화가 끝나고 다시 걸을 수 있다.
  한 칸 걸음은 0.18 초(11 프레임)라 걸음 사이의 19 프레임은 걸음이 끝나는 시간이고, 막힘 · 대화 중 걷지 않음은 일어나지 않는 것을 보므로 고정 대기다.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/pixeltown_talk.scenario.xml -unattended
-->
<Scenario name="game.playground.pixeltown_talk" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="pixeltown"/>
	<WaitUntil watch="Overworld.HeroTileX" equals="7" timeoutFrames="10"/>
	<Expect watch="Overworld.HeroTileY" equals="7"/>
	<!-- 위로 두 칸, 셋째 칸은 집 벽이라 서서 위를 본다(3 = 위). -->
	<Tap slot="Key.W" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.W" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Expect watch="Overworld.HeroTileY" equals="5"/>
	<Tap slot="Key.W" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Expect watch="Overworld.HeroTileY" equals="5"/>
	<Expect watch="Overworld.HeroFacing" equals="3"/>
	<!-- 길로 내려와 오른쪽 다섯 칸. -->
	<Tap slot="Key.S" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.S" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.D" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.D" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.D" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.D" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Tap slot="Key.D" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Expect watch="Overworld.HeroTileX" equals="12"/>
	<Expect watch="Overworld.HeroTileY" equals="7"/>
	<!-- 위는 촌장이 선 칸이라 막히고 위를 본다. -->
	<Tap slot="Key.W" hold="2"/>
	<WaitUntil watch="Overworld.HeroWalking" equals="0" timeoutFrames="40"/>
	<Expect watch="Overworld.HeroTileY" equals="7"/>
	<Expect watch="Overworld.HeroFacing" equals="3"/>
	<Expect watch="Overworld.Talking" equals="0"/>
	<!-- 말을 건다 — 첫 줄. -->
	<Tap slot="Key.Space" hold="1"/>
	<WaitUntil watch="Overworld.Talking" equals="1" timeoutFrames="30"/>
	<Expect watch="Overworld.ShownLines" equals="1"/>
	<!-- 자막의 화자는 그래프 화자 목록(id 1 → Elder)에서 푼 이름이다 — 노드는 화자를 id 로 가리킨다. -->
	<WaitUntil watch="UI.SubtitleSpeaker" is="Elder" timeoutFrames="10"/>
	<!-- 대화 중에는 걷지 않는다 — 한 칸 걸음 길이(19 프레임) 동안 자리가 그대로인지 본다. -->
	<Tap slot="Key.D" hold="2"/>
	<AdvanceSimulation frames="19"/>
	<Expect watch="Overworld.HeroTileX" equals="12"/>
	<!-- 둘째 줄, 그리고 끝. -->
	<Tap slot="Key.Space" hold="1"/>
	<WaitUntil watch="Overworld.ShownLines" equals="2" timeoutFrames="30"/>
	<Expect watch="Overworld.Talking" equals="1"/>
	<Tap slot="Key.Space" hold="1"/>
	<WaitUntil watch="Overworld.Talking" equals="0" timeoutFrames="30"/>
	<Expect watch="Overworld.FinishedTalks" equals="1"/>
	<!-- 대화가 끝나면 다시 걷는다 — 대화를 닫은 직후의 상호작용 동안은 걷기 입력을 받지 않으니, 닿을 때까지 누르고 있다. -->
	<Press slot="Key.D"/>
	<WaitUntil watch="Overworld.HeroTileX" equals="13" timeoutFrames="30"/>
	<Release slot="Key.D"/>
	<Pass/>
</Scenario>
