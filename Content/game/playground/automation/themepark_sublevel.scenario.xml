<?xml version="1.0" encoding="utf-8"?>
<?asset guid="49e047f0c2333b83f3624f718175682b"?>
<!--
  테마파크 하위 레벨(미니게임 themepark) — 무대의 FarEntrance(500, 2, -300 · 요 90 도)에 얹으면 공원 전체가 그 자리에서 열린다.
  ① 정문(공원 좌표 20, 0, -40 → 월드 460, 2, -320)과 손님 · 입구가 얹은 자리에 서고, 공원 카메라(우선순위 10)가 화면을 맡는다.
  ② 조작: 공원 레이어의 Tab 이 배치를 고르고 B 가 짓는다(씬의 ParkViewComponent 액션 이름 — 디렉터 명령).
  ③ 나가면 하위 레벨과 세운 모습(손님 풀)이 모두 사라지고 무대는 그대로이며, 미니게임 범위에 남은 것이 없다.
  ④ 다시 들어가도 새 공원이 열린다(앞 판의 시계 · 손님이 남지 않는다 — 손님 풀은 다시 정문에 선다).
  ⑤ 안에서 저장한다 — 막히지 않고, 나와서 불러오면 지은 것까지 그 공원으로 같은 자리에 이어진다.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/themepark_sublevel.scenario.xml -unattended
-->
<Scenario name="game.playground.themepark_sublevel" fixedDelta="0.0166667" timeoutFrames="4800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/automation/themepark_stage/stage.scene.xml"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<Expect watch="Minigame.Active" is="none"/>

	<!-- ① 얹은 자리에서 열린다 -->
	<DevCommand line="minigame.enter themepark FarEntrance"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutFrames="60"/>
	<ExpectActiveScene path="guid:f947709c4342f28d37ed4bf6089d2700"/>
	<Expect watch="Minigame.Active" is="themepark"/>
	<WaitUntil watch="Object.Exists" target="ParkGuest[3]" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.X" target="themepark/ParkGate" near="460" tolerance="0.05"/>
	<Expect watch="Object.Y" target="themepark/ParkGate" near="2" tolerance="0.05"/>
	<Expect watch="Object.Z" target="themepark/ParkGate" near="-320" tolerance="0.05"/>
	<Expect watch="Object.X" target="ParkGuest[3]" near="460" tolerance="0.05"/>
	<Expect watch="Object.Z" target="ParkGuest[3]" near="-320" tolerance="0.05"/>
	<!-- 회전목마 입구(공원 좌표 -10, 0, -27.5 → 월드 472.5, 2, -290) -->
	<WaitUntil watch="Object.Exists" target="RideEntrance[0]" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.X" target="RideEntrance[0]" near="472.5" tolerance="0.05"/>
	<Expect watch="Object.Z" target="RideEntrance[0]" near="-290" tolerance="0.05"/>
	<WaitUntil watch="Camera.DrawnAspect" target="themepark/GameCamera" atLeast="0.1" timeoutFrames="60"/>

	<!-- ② 조작 — 다음 배치를 골라 짓는다(회전목마 · 코스터 하나는 이미 서 있다) -->
	<Expect watch="Object.Exists" target="RideEntrance[2]" equals="0"/>
	<Tap slot="Key.Tab" hold="1"/>
	<WaitUntil watch="Object.Property" target="themepark/ParkGameMode" key="ParkViewComponent._selectedPlacement" equals="1" timeoutFrames="30"/>
	<Tap slot="Key.B" hold="1"/>
	<WaitUntil watch="Object.Exists" target="RideEntrance[2]" equals="1" timeoutFrames="30"/>
	<WaitUntil watch="ThemePark.GuestCount" atLeast="1" timeoutSeconds="30"/>

	<!-- ③ 나가면 무대만 남는다 -->
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="0" timeoutFrames="30"/>
	<WaitUntil watch="Object.Exists" target="ParkGuest[0]" equals="0" timeoutFrames="30"/>
	<Expect watch="Object.Exists" target="RideEntrance[0]" equals="0"/>
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<ExpectActiveScene path="guid:f947709c4342f28d37ed4bf6089d2700"/>

	<!-- ④ 다시 들어가면 새 공원이다 -->
	<DevCommand line="minigame.enter themepark ParkEntrance"/>
	<WaitUntil watch="Object.Exists" target="ParkGuest[0]" equals="1" timeoutFrames="60"/>
	<Expect watch="ThemePark.GuestCount" equals="0"/>
	<Expect watch="Object.X" target="themepark/ParkGate" near="20" tolerance="0.05"/>
	<Expect watch="Object.Z" target="themepark/ParkGate" near="-40" tolerance="0.05"/>

	<!-- ⑤ 세이브 왕복 — 셋째 배치까지 지은 공원이 이어진다 -->
	<WaitUntil watch="Object.Exists" target="RideEntrance[1]" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.Exists" target="RideEntrance[2]" equals="0"/>
	<Tap slot="Key.Tab" hold="1"/>
	<WaitUntil watch="Object.Property" target="themepark/ParkGameMode" key="ParkViewComponent._selectedPlacement" equals="1" timeoutFrames="30"/>
	<Tap slot="Key.B" hold="1"/>
	<WaitUntil watch="Object.Exists" target="RideEntrance[2]" equals="1" timeoutFrames="30"/>
	<Expect watch="Save.Blocked" equals="0"/>
	<Store watch="Save.Written" as="writtenBefore"/>
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.save themeparksublevel/a"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="0" timeoutFrames="30"/>
	<WaitUntil watch="Object.Exists" target="RideEntrance[0]" equals="0" timeoutFrames="30"/>
	<DevCommand line="game.load themeparksublevel/a"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.LoadedSubLevelCount" equals="1" timeoutWallSeconds="30"/>
	<Expect watch="Minigame.Active" is="themepark"/>
	<Expect watch="Minigame.Depth" equals="1"/>
	<Expect watch="Object.X" target="themepark/ParkGate" near="20" tolerance="0.05"/>
	<Expect watch="Object.Z" target="themepark/ParkGate" near="-40" tolerance="0.05"/>
	<WaitUntil watch="Object.Exists" target="RideEntrance[2]" equals="1" timeoutFrames="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Scene.SubLevelCount" equals="0" timeoutFrames="30"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<Pass/>
</Scenario>
