<!--
  장르 키트 시연 — 몬스터 사냥 키트(GF_MonsterHuntRPG)의 계약 한 바퀴: griffin 조사(단서 blood → feather → eggs, 두 단계) 풀림 →
  흥정(151 은 한도 150 초과로 맞제안, 150 은 수락) 보상 150 → ghoul 두 번 처치로 도감 지식 1.
  감시 값: KitDemo.MonsterHuntRPG.State(0 시작 전, 1 마침) · .Solved · .Reward · .Knowledge.
  실행: ctest -R Scenario.playground
-->
<Scenario name="game.playground.kit_monsterhuntrpg" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/kit_monsterhuntrpg.scene.xml"/>
	<WaitUntil watch="KitDemo.MonsterHuntRPG.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.MonsterHuntRPG.Solved" equals="1"/>
	<Expect watch="KitDemo.MonsterHuntRPG.Reward" equals="150"/>
	<Expect watch="KitDemo.MonsterHuntRPG.Knowledge" equals="1"/>
	<ExpectLog id="KitDemo.MonsterHuntRPGDone" count="1"/>
	<Pass/>
</Scenario>
