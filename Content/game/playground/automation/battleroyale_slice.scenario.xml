<?asset guid="5d87f4bddf1a4f4a948ba00eaaf4b2f3"?>
<!--
  배틀로얄 미니게임(battleroyale — GF_BattleRoyale 키트)의 한 판 — 비행 → 플레이어가 뛰어내림 → 전투 시작 → 구역이 줄기 시작 → 자동 플레이로 판 끝 → 결과 보고 → 허브.
  플레이어 조작은 입력 맵 액션(BattleRoyale.Use)으로만 한다. 이긴 분대는 씨앗에 달려 판정하지 않는다 — 기절이 나오고 판이 끝나 결과가 나가는 것을 본다.
  비행 창: 경로는 81 ~ 141 m(맵 100 m, 어긋남 0.6)라 0.25 ~ 0.75 구간이 늘 1.6 초를 품는다(25 m/s).
  감시 값: BattleRoyale.Phase(0 낙하, 1 전투, 2 끝) · .PlayerDropStage(0 비행기, 1 낙하, 2 땅) · .Remaining · .ZoneRadius.
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/battleroyale_slice.scenario.xml -unattended
-->
<Scenario name="game.playground.battleroyale_slice" fixedDelta="0.0166667" timeoutFrames="9000" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="battleroyale"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Minigame.Active" is="battleroyale" timeoutWallSeconds="60"/>
	<Expect watch="Save.Blocked" equals="1"/>
	<WaitUntil watch="BattleRoyale.Remaining" equals="6" timeoutFrames="120"/>
	<Expect watch="BattleRoyale.Phase" equals="0"/>
	<Expect watch="BattleRoyale.ZoneRadius" near="70.71" tolerance="0.1"/>
	<AdvanceSimulation frames="96"/> <!-- 뛰어내릴 수 있는 구간(비행 1.6 초 — 시간이 내용) -->
	<Expect watch="BattleRoyale.PlayerDropStage" equals="0"/>
	<Action name="BattleRoyale.Use"/>
	<WaitUntil watch="BattleRoyale.PlayerDropStage" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="BattleRoyale.PlayerDropStage" equals="2" timeoutFrames="600"/>
	<WaitUntil watch="BattleRoyale.Phase" equals="1" timeoutFrames="900"/>
	<ExpectLog id="BattleRoyale.BattleStarted" count="1"/>
	<!-- 구역은 1 초 기다린 뒤 줄기 시작한다 -->
	<WaitUntil watch="BattleRoyale.ZoneRadius" atMost="70" timeoutFrames="180"/>
	<ExpectLog id="BattleRoyale.ZoneShrinks" atLeast="1"/>
	<!-- 자동 플레이로 끝까지 — 구역은 44 초 안에 점이 되어 남은 사람도 구역 피해로 끝난다 -->
	<Variable name="gv_playgroundAutoPlay" value="1"/>
	<WaitUntil watch="BattleRoyale.Phase" equals="2" timeoutFrames="5400"/>
	<ExpectLog id="BattleRoyale.Downed" atLeast="1"/>
	<ExpectLog id="BattleRoyale.Ended" count="1"/>
	<!-- 결과를 3 초 보인 뒤 스스로 끝나 허브(입구 씬)로 간다 -->
	<WaitUntil watch="Minigame.Active" is="none" timeoutFrames="600"/>
	<AdvanceSimulation frames="2"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/hub.scene.xml"/>
	<ExpectLog id="MinigameFlow.Finished" contains="'battleroyale' finished" count="1"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<Pass/>
</Scenario>
