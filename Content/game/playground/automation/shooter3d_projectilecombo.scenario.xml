<!--
  사격장 무기 · 탄 조합 — 같은 소총에 다른 탄(projectiles.xml)을 넣으면 한 발의 값과 그림이 탄을 따른다.
  기본 탄(rifle_round, 피해 14, 노란 탄도선)으로 한 발, 치트로 소이탄(incendiary_round — rifle_round 를 물려받아 피해 11, 붉고 굵은 탄도선)을 넣고 한 발 쏜다.
  피해는 감시값(Shooter.ShotDamage)으로, 궤적은 그리게 넘긴 탄도선 두께(Shooter.TracerWidth)로 본다. 탄이 궤적을 바꾸지 않으면(궤적 칸을 읽지 않으면) 진다.
  탄도선 시작점은 시점 총의 총구(무기 소켓 에셋의 Muzzle)라 눈에서 총 길이만큼 앞이다(Shooter.TracerStartAhead, 총은 눈 앞 0.42 m · 총구는 그보다 앞).
  총구를 못 찾던 때는 눈 아래(앞 0 m)에서 시작해 총에 가렸다 — 이제 총구가 없으면 오류로 남고 탄도선이 나가지 않아 이 단계가 진다. 끝에 기본 탄으로 되돌린다.
  실행: App -scenario=game/playground/automation/shooter3d_projectilecombo.scenario.xml -unattended (체인: ctest -R Scenario.playground.shooter3d)
-->
<Scenario name="game.playground.shooter3d_projectilecombo" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="shooter3d"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<Expect watch="Shooter.WeaponIndex" equals="0"/>
	<AdvanceSimulation frames="20"/> <!-- 자동 플레이를 끈 뒤 조종이 사람 입력으로 넘어오는 간격(볼 상태가 없다) -->
	<Expect watch="Shooter.ShotDamage" equals="14"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<WaitUntil watch="Shooter.ShotCount" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="Shooter.TracerWidth" equals="0.025" timeoutFrames="10"/>
	<Expect watch="Shooter.TracerStartAhead" atLeast="0.4"/>
	<!-- 연사 간격이 지난 뒤 탄을 바꾼다(둘째 탭이 쿨다운에 막히지 않게) -->
	<WaitUntil watch="Shooter.FireReady" equals="1" timeoutFrames="60"/>
	<DevCommand line="cheat.shooter.projectile incendiary_round"/>
	<WaitUntil watch="Shooter.ShotDamage" equals="11" timeoutFrames="10"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<WaitUntil watch="Shooter.ShotCount" equals="2" timeoutFrames="10"/>
	<WaitUntil watch="Shooter.TracerWidth" equals="0.08" timeoutFrames="10"/>
	<!-- 다른 무기는 자기 기본 탄이다(산탄 9). 되돌리면 소총도 기본 탄이다 -->
	<Tap slot="Key.Digit2" hold="2"/>
	<WaitUntil watch="Shooter.WeaponIndex" equals="1" timeoutFrames="30"/>
	<Expect watch="Shooter.ShotDamage" equals="9"/>
	<Tap slot="Key.Digit1" hold="2"/>
	<WaitUntil watch="Shooter.ShotDamage" equals="11" timeoutFrames="30"/>
	<DevCommand line="cheat.shooter.projectile"/>
	<WaitUntil watch="Shooter.ShotDamage" equals="14" timeoutFrames="10"/>
	<Expect watch="Shooter.PlayerAlive" equals="1"/>
	<Pass/>
</Scenario>
