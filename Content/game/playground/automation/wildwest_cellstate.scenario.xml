<?xml version="1.0" encoding="utf-8"?>
<?asset guid="6b76c00adfc54c04870d5d61dae6455e"?>
<!--
  서부극 스트리밍 셀 경계 — prairie 를 물려받은 무대(automation/wildwest_cellstate/cellstate.scene.xml, 16 m 셀 · 32 m 반경 · 여유 8 m)를 기수가 오가며 셀 A(X -80 ~ -64)를 올리고 내린다.
  셀은 쿠킹본에만 있어 소스 콘텐츠로는 gv_sceneStreamSourceCells 로 씬 로드가 메모리에서 셀을 나눈다(언리얼 PIE 의 World Partition 스트리밍 자리).
  ① 셀 A 가 내려가 있는 동안 그 위 선반의 늘 올라 있는 상자는 쥐여 떨어지지 않고, 늘 올라 있는 땅 위 상자 · 말은 쥐지 않는다. ② 상자 볼륨의 발동 수(RuntimeState)와 문 자리가 내렸다 올려도 남는다.
  ③ NPC 가 셀 B 로 걸어간 뒤 A 를 내려도 NPC 는 하나 그대로다(B 로 옮겨 산다). ④ A 가 내려간 채 저장 → 바꾼 뒤 불러오면 B 의 NPC 자리와 A 의 떠 둔 상태가 돌아온다.
  ⑤ B 까지 내리면 NPC 는 B 에 떠 두었다가 B 가 오를 때 그 자리로 돌아온다. 값으로 판정한다(골든 없음).
  실행: ctest -R Scenario.playground · App -scenario=game/playground/automation/wildwest_cellstate.scenario.xml -unattended
-->
<Scenario name="game.playground.wildwest_cellstate" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/automation/wildwest_cellstate/cellstate.scene.xml"/>
	<Launch variable="gv_sceneStreamSourceCells" value="true"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Scene.LoadedCellCount" atLeast="1" timeoutFrames="120"/> <!-- 원점 둘레 셀이 올랐다(셀을 나눠 스트리밍한다) -->
	<Expect watch="Object.Exists" target="CellChest" equals="0"/>             <!-- 셀 A 는 반경 밖이다 -->
	<AdvanceSimulation frames="30"/>                                            <!-- 바닥 셀(선반)이 없는 동안 상자가 떨어지지 않는다(일어나지 않음 — 시간이 내용) -->
	<Expect watch="Object.Y" target="LedgeCrate" atLeast="3.4"/>
	<Expect watch="Physics.StreamingHeldBodies" atLeast="1"/>
	<Expect watch="Object.StreamingHeld" target="LedgeCrate" equals="1"/>  <!-- 몸 아래 받쳐 줄 것이 없다 -->
	<Expect watch="Object.StreamingHeld" target="GroundCrate" equals="0"/> <!-- 셀 A 자리지만 늘 올라 있는 땅 위다 -->
	<Expect watch="Object.Y" target="GroundCrate" atMost="0.3"/>

	<!-- ① 셀 A 로 간다 — 셀이 오르고 상자가 풀려 선반 위에 선다 -->
	<DevCommand line="teleport Player -66 0.05 8"/>
	<WaitUntil watch="Object.Exists" target="CellChest" equals="1" timeoutFrames="120"/>
	<Expect watch="Object.Exists" target="CellNpc" equals="1"/>
	<AdvanceSimulation frames="30"/> <!-- 풀린 상자가 선반에 앉는다(시간이 내용) -->
	<Expect watch="Object.Y" target="LedgeCrate" atLeast="3.4"/>

	<!-- ② 기믹: 상자 볼륨을 발동하고(RuntimeState), 문을 연다(자리). ③ NPC 가 셀 B 로 걸어간다 -->
	<DevCommand line="teleport Player -68 0.05 5"/>
	<WaitUntil watch="Object.Property" target="CellChest" key="AutosaveTriggerComponent._fireCount" equals="1" timeoutFrames="30"/>
	<WaitUntil watch="Autosave.SaveCount" atLeast="1" timeoutSeconds="5"/> <!-- 체크포인트 저장이 끝났다 — 아래 저장 수 판정과 겹치지 않게 -->
	<DevCommand line="teleport CellDoor -76 0 6"/>
	<DevCommand line="move CellNpc -40 0 8"/>

	<!-- 셀 A 를 내린다(원점을 X -16 으로) — 상자 · 문은 떠 두고, B 에 선 NPC 는 B 로 옮겨 산다(하나 — 둘이면 이름으로 고르지 못해 진다) -->
	<DevCommand line="teleport Player -16 0.05 8"/>
	<WaitUntil watch="Object.Exists" target="CellChest" equals="0" timeoutFrames="120"/>
	<Expect watch="Object.Exists" target="CellNpc" equals="1"/>
	<Expect watch="Object.X" target="CellNpc" equals="-40"/>
	<AdvanceSimulation frames="30"/> <!-- 바닥 셀이 내려간 동안 상자가 떨어지지 않는다(시간이 내용) -->
	<Expect watch="Object.Y" target="LedgeCrate" atLeast="3.4"/>
	<Expect watch="Physics.StreamingHeldBodies" atLeast="1"/>
	<Expect watch="Object.StreamingHeld" target="GroundCrate" equals="0"/>
	<Expect watch="Object.StreamingHeld" target="Bessie" equals="0"/> <!-- 순간이동으로 남겨진 말 둘은 땅 위라 서지 않는다 -->
	<Expect watch="Object.StreamingHeld" target="Shadow" equals="0"/>

	<!-- ④ A 가 내려간 채 저장 → NPC 를 옮긴 뒤 불러온다 — 같은 씬이라 그 자리에서 교체하고 셀은 세이브의 상태로 다시 선다 -->
	<Store watch="Save.Written" as="writtenBeforeSave"/>
	<DevCommand line="game.save cellstate/a"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBeforeSave" timeoutWallSeconds="10"/>
	<DevCommand line="teleport CellNpc -36 0 8"/>
	<Expect watch="Object.X" target="CellNpc" equals="-36"/>
	<DevCommand line="game.load cellstate/a"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="60"/>
	<WaitUntil watch="Object.Exists" target="CellNpc" equals="1" timeoutFrames="120"/>
	<Expect watch="Object.X" target="CellNpc" equals="-40"/>
	<Expect watch="Object.Exists" target="CellChest" equals="0"/>

	<!-- A 로 돌아간다 — 발동 수 · 문 자리가 내렸다 올리고 저장 · 불러온 뒤에도 남는다 -->
	<DevCommand line="teleport Player -66 0.05 8"/>
	<WaitUntil watch="Object.Exists" target="CellChest" equals="1" timeoutFrames="120"/>
	<Expect watch="Object.Property" target="CellChest" key="AutosaveTriggerComponent._fireCount" equals="1"/>
	<Expect watch="Object.Z" target="CellDoor" equals="6"/>
	<Expect watch="Object.Exists" target="CellNpc" equals="1"/>
	<AdvanceSimulation frames="30"/> <!-- 다시 오른 선반 위 상자가 그대로 앉아 있다(시간이 내용) -->
	<Expect watch="Object.Y" target="LedgeCrate" atLeast="3.4"/>

	<!-- ⑤ 모두 내렸다가 B 로 돌아온다 — NPC 는 내려간 B 에 떠 두었다가 그 자리로 다시 선다 -->
	<DevCommand line="teleport Player 0 0.05 70"/>
	<WaitUntil watch="Object.Exists" target="CellNpc" equals="0" timeoutFrames="120"/>
	<DevCommand line="teleport Player -16 0.05 8"/>
	<WaitUntil watch="Object.Exists" target="CellNpc" equals="1" timeoutFrames="120"/>
	<Expect watch="Object.X" target="CellNpc" equals="-40"/>
	<Pass/>
</Scenario>
