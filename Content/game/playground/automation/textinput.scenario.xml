<?xml version="1.0" encoding="utf-8"?>
<?asset guid="2840cc2afc54a877a62edbcd4ea7967e"?>
<!--
  글 입력 칸 — 키보드 탭 순서로 입력 칸(UI 견본의 NameInput)에 포커스를 옮기고, 확정 글과 한글 IME 조합(ㅎ → 하 → 한, 확정 전에는 확정 글에 들지 않는다)을 넣은 뒤
  확정하면 확정 글 뒤에 붙고, 지우기가 음절 하나를 지우는지 본다. 데스크톱 IME 가 창 메시지로 내는 조합 · 확정을 같은 원시 입력(<Text composition="true"> · <Text>)으로 흉내 낸다.
  견본 화면(gv_uiDemo)의 탭 순서: Start · Continue · Options · Credits · Quit · 슬라이더 · 체크 · 콤보 · 입력 칸.
  실행: ctest -R Scenario.playground (체인)
-->
<Scenario name="game.playground.textinput" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/rendertest3d.scene.xml"/>
	<Variable name="gv_uiDemo" value="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Start" timeoutFrames="30"/> <!-- 견본 화면은 탐색 방식으로 열려 첫 단추에 포커스가 선다 -->
	<Tap slot="Key.Tab" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="Continue" timeoutFrames="10"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<AdvanceSimulation frames="2"/>
	<Tap slot="Key.Tab" hold="1"/>
	<WaitUntil watch="UI.FocusedWidget" is="NameInput" timeoutFrames="10"/>

	<Text value="Ann"/>
	<WaitUntil watch="UI.FocusedText" is="Ann" timeoutFrames="10"/>
	<Text value="ㅎ" composition="true"/>
	<WaitUntil watch="UI.FocusedComposition" is="ㅎ" timeoutFrames="10"/>
	<Text value="하" composition="true"/>
	<WaitUntil watch="UI.FocusedComposition" is="하" timeoutFrames="10"/>
	<Text value="한" composition="true"/>
	<WaitUntil watch="UI.FocusedComposition" is="한" timeoutFrames="10"/>
	<Expect watch="UI.FocusedText" is="Ann"/> <!-- 조합은 확정 전이라 글에 들지 않는다 -->
	<Text value="한"/>
	<WaitUntil watch="UI.FocusedText" is="Ann한" timeoutFrames="10"/>
	<Expect watch="UI.FocusedText" is="Ann한"/>
	<Tap slot="Key.Backspace" hold="1"/>
	<WaitUntil watch="UI.FocusedText" is="Ann" timeoutFrames="10"/> <!-- 지우기는 코드 포인트 하나(음절 하나) -->
	<Variable name="gv_uiDemo" value="0"/>
	<Pass/>
</Scenario>
