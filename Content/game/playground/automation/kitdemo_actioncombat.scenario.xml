<?asset guid="e560501ee9900b0a6b1bab1cba9eebe2"?>
<!--
  장르 완결 루프 — 액션 컴뱃 키트(GF_ActionCombat)의 한 판: 홀 전투 → 보스 룸 → 승리. 플레이어와 같은 입력 맵 액션(Move · KitDemo.Attack)으로만 움직이고 테스트 전용 경로를 쓰지 않는다.
  디렉터는 키트 ActionCombatGameModeComponent, 입력 · 그리기 · HP 바는 클라이언트 모듈 GF_Client_ActionCombat 의 ActionCombatAvatarComponent.
  씬: 플레이어는 (0,0) 오른쪽을 보고 선다. 홀 졸개 둘(1.2,0) · (-1.5,0), 보스 (1.6,0) — 모두 제자리라 닿은 피해가 들지 않는다. 공격 30(34 - 방어 4): 졸개 두 번, 보스 네 번.
  감시 값: ActionCombat.Phase(0 홀, 1 보스 대기, 2 보스, 3 승리, 4 패배) · ActionCombat.Alive · ActionCombat.PlayerHP · ActionCombat.PlayerX.
  실행: ctest -R Scenario.game.playground.kitdemo_actioncombat
-->
<Scenario name="game.playground.kitdemo_actioncombat" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="kitdemo_actioncombat"/>
	<WaitUntil watch="ActionCombat.Alive" equals="2" timeoutFrames="120"/>
	<Expect watch="ActionCombat.Phase" equals="0"/>
	<Expect watch="ActionCombat.PlayerHP" equals="100"/>
	<!-- 게임 기능 ActionCombat 가 받는 이름 Combatant 의 허수아비에 키트의 체력 컴포넌트를 붙였다 -->
	<Expect watch="GameFeature.AddedComponents" equals="1"/>
	<Expect watch="Object.Property" target="TrainingDummy" key="UnitStatsComponent._bIsDead" equals="0"/>
	<!-- 홀: 오른쪽 졸개를 두 번 친다(쿨다운 0.28 초) -->
	<Action name="KitDemo.Attack"/>
	<AdvanceSimulation frames="24"/> <!-- 공격 쿨다운(0.28 초)이 지나는 0.4 초(시간이 내용) -->
	<Action name="KitDemo.Attack"/>
	<WaitUntil watch="ActionCombat.Alive" equals="1" timeoutFrames="60"/>
	<!-- 왼쪽으로 0.1 초(0.4 m) 걸어 돌아서고 왼쪽 졸개를 두 번 친다 -->
	<ActionAxis name="Move" x="-1" seconds="0.1"/>
	<AdvanceSimulation frames="24"/> <!-- 이동 축은 기다리지 않는다 — 앞 공격에서 쿨다운(0.28 초)이 지나야 다음 공격이 든다(0.2 초면 첫 공격이 먹혔다) -->
	<Expect watch="ActionCombat.PlayerX" near="-0.4" tolerance="0.1"/>
	<Action name="KitDemo.Attack"/>
	<AdvanceSimulation frames="24"/>
	<Action name="KitDemo.Attack"/>
	<WaitUntil watch="ActionCombat.Phase" equals="1" timeoutFrames="60"/>
	<ExpectLog id="ActionCombat.HallCleared" count="1"/>
	<!-- 보스 룸이 열린다(1 초) -->
	<WaitUntil watch="ActionCombat.Phase" equals="2" timeoutFrames="120"/>
	<Expect watch="ActionCombat.Alive" equals="1"/>
	<!-- 오른쪽으로 돌아서 보스를 네 번 친다 -->
	<ActionAxis name="Move" x="1" seconds="0.1"/>
	<AdvanceSimulation frames="12"/> <!-- 돌아서는 0.2 초 -->
	<Action name="KitDemo.Attack"/>
	<AdvanceSimulation frames="24"/>
	<Action name="KitDemo.Attack"/>
	<AdvanceSimulation frames="24"/>
	<Action name="KitDemo.Attack"/>
	<AdvanceSimulation frames="24"/>
	<Action name="KitDemo.Attack"/>
	<WaitUntil watch="ActionCombat.Phase" equals="3" timeoutFrames="60"/>
	<Expect watch="ActionCombat.Alive" equals="0"/>
	<Expect watch="ActionCombat.PlayerHP" equals="100"/>
	<ExpectLog id="ActionCombat.Victory" count="1"/>
	<Record watch="ActionCombat.PlayerX"/>
	<Pass/>
</Scenario>
