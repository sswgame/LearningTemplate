<?asset guid="9b2e47d1c6a54f0e8d3b7a61f2c09e45"?>
<!--
  미니게임 쌓기 · 교체 · 결과(docs/DesignBacklog.md "게임 기능 · 미니게임"). 무대: 첫 씬 maps/fogshowcase.
  ① 쌓기: smoketest(맵 editortest) 위에 pixeltown 을 쌓고(깊이 2), minigame.leave win 이 editortest 를 복원한 뒤 덮였던 smoketest 를 다시 켠 채로 결과를 넘긴다(Minigame.LastResult).
  ② 다시 나가면 fogshowcase 로 돌아간다(깊이 0).
  ③ 교체(마리오 파티식): smoketest 에서 minigame.switch pixeltown — 깊이는 1 그대로, 나가면 처음 자리(fogshowcase)로 돌아간다.
  실행: App -scenario=game/playground/automation/minigamestack.scenario.xml -unattended (체인: ctest -R Scenario.playground)
-->
<Scenario name="game.playground.minigamestack" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/playground/maps/fogshowcase.scene.xml"/>
	<Expect watch="Minigame.Depth" equals="0"/>
	<Expect watch="Minigame.LastResult" is="none"/>

	<!-- ① 쌓기 -->
	<DevCommand line="minigame.enter smoketest"/>
	<WaitUntil watch="Minigame.Active" is="smoketest" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.enter pixeltown"/>
	<WaitUntil watch="Minigame.Active" is="pixeltown" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/pixeltown/maps/town.scene.xml"/>
	<Expect watch="Minigame.Depth" equals="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave win"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="1" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/editortest.scene.xml"/>
	<Expect watch="Minigame.Active" is="smoketest"/> <!-- 덮였던 미니게임이 다시 켜졌다 -->
	<Expect watch="Minigame.Depth" equals="1"/>
	<Expect watch="Minigame.LastResult" is="win"/>
	<ExpectLog id="MinigameFlow.Finished" contains="'pixeltown' finished (result 'win')" count="1"/>

	<!-- ② 다시 나가기 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave lose"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="2" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/fogshowcase.scene.xml"/>
	<Expect watch="Minigame.Active" is="none"/>
	<Expect watch="Minigame.Depth" equals="0"/>
	<Expect watch="Minigame.LastResult" is="lose"/>

	<!-- ③ 교체 -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.enter smoketest"/>
	<WaitUntil watch="Minigame.Active" is="smoketest" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.switch pixeltown"/>
	<ExpectLog id="DevCommand.Reply" contains="minigame.switch: switching 'pixeltown'" atLeast="1"/>
	<WaitUntil watch="Minigame.Active" is="pixeltown" timeoutWallSeconds="60"/>
	<Expect watch="Minigame.Depth" equals="1"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="minigame.leave"/>
	<WaitUntil watch="Minigame.RestoreCount" equals="3" timeoutWallSeconds="60"/>
	<ExpectActiveScene path="game/playground/maps/fogshowcase.scene.xml"/>
	<Expect watch="Minigame.Depth" equals="0"/>
	<Expect watch="Minigame.LeakCount" equals="0"/>
	<Pass/>
</Scenario>
