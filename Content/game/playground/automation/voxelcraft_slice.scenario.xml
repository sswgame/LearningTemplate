<!--
  장르 수직 슬라이스(G1, 복셀 광산 미니게임 voxelcraft) — 시작 → 목표(voxelcraft_control.scenario.xml 의 단계 그대로) → 결과 → 저장 · 복원 해시 동일.
  목표 단계는 그 시나리오가 정본이다 — 거기를 고치면 이 파일도 맞춘다. 저장 슬롯은 voxelcraft/slice.
-->
<Scenario name="game.playground.voxelcraft_slice" fixedDelta="0.0166667" timeoutFrames="1800" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstMinigame" value="voxelcraft"/>
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<!-- 몸이 땅에 내려앉을 때까지(걷기 거리를 그 뒤부터 잰다). -->
	<WaitUntil watch="Voxel.OnGround" equals="1" timeoutFrames="120"/>
	<Expect watch="Voxel.ControllerKind" equals="0"/>

	<!-- 걷기: W 를 1 초 — 몸이 1 m 넘게 간다. -->
	<Press slot="Key.W"/>
	<AdvanceSimulation frames="60"/> <!-- 누른 채인 1 초가 시험 내용이다 -->
	<Release slot="Key.W"/>
	<WaitUntil watch="Voxel.WalkedDistance" atLeast="1" timeoutFrames="30"/>

	<!-- 핫바: 3 을 한 번 — 셋째 칸. -->
	<Tap slot="Key.Digit3" hold="1"/>
	<WaitUntil watch="Voxel.HotbarSlot" equals="2" timeoutFrames="30"/>

	<!-- 시선: 마우스 오른쪽 100 px — 조종 요가 시작 0.6 에서 100 × 0.0022 만큼 돈다. -->
	<MouseDelta x="100" y="0"/>
	<WaitUntil watch="Voxel.ControlYaw" near="0.82" tolerance="0.01" timeoutFrames="30"/>

	<!-- 부수기: 아래를 보고 왼쪽 버튼을 4 초 — 블록이 하나 넘게 부서진다. -->
	<MouseDelta x="0" y="400"/>
	<WaitUntil watch="Voxel.ControlPitch" atMost="-0.5" timeoutFrames="30"/> <!-- 시선이 아래로 돌았다 -->
	<Press slot="Mouse.Left"/>
	<WaitUntil watch="Voxel.BrokenCount" atLeast="1" timeoutSeconds="6"/> <!-- 누른 채 블록이 부서질 때까지 -->
	<Release slot="Mouse.Left"/>
	<WaitUntil watch="Voxel.BrokenCount" atLeast="1" timeoutFrames="30"/>

	<!-- 자동 플레이 = AI 조종자의 빙의. 얼마 동안 AI 가 몸을 움직이게 둔 뒤 끄면 플레이어 조종자가 다시 쥐고 키가 먹는다. -->
	<Variable name="gv_playgroundAutoPlay" value="1"/>
	<WaitUntil watch="Voxel.ControllerKind" equals="1" timeoutFrames="30"/>
	<WaitUntil watch="AI.State" target="VoxelAutoPlay" is="Break" timeoutSeconds="12"/> <!-- AI 가 몸을 움직여 부수기에 들어갔다 -->
	<Variable name="gv_playgroundAutoPlay" value="0"/>
	<WaitUntil watch="Voxel.ControllerKind" equals="0" timeoutFrames="30"/>
	<Tap slot="Key.Digit5" hold="1"/>
	<WaitUntil watch="Voxel.HotbarSlot" equals="4" timeoutFrames="30"/>
	<!-- 저장 → 세계를 더 돌림 → 두 번 복원: 같은 슬롯을 두 번 불러온 직후의 씬 상태 해시가 같아야 한다(복원이 세계를 다 되살린다 — 저장 순간의 해시와 견주면 명령이 도는 프레임만큼 흔들린다) -->
	<DevCommand line="game.save voxelcraft/slice"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<AdvanceSimulation frames="60"/> <!-- 저장 · 복원 사이 세계를 더 돌린다(시간이 내용) -->
	<DevCommand line="game.load voxelcraft/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="10"/>
	<RecordStateHash key="restored"/>
	<AdvanceSimulation frames="60"/> <!-- 저장 · 복원 사이 세계를 더 돌린다(시간이 내용) -->
	<DevCommand line="game.load voxelcraft/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="2" timeoutWallSeconds="10"/>
	<ExpectStateHash key="restored"/>
	<WaitUntil watch="Object.Exists" target="VoxelChunk[0]" equals="1" timeoutFrames="30"/> <!-- 복원한 월드의 청크 뷰가 다시 선다 -->
	<Pass/>
</Scenario>
