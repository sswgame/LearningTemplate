<?xml version="1.0" encoding="utf-8"?>
<!-- AbilityArena 팩의 설정 — 시작 맵은 아레나 씬이다(게임마다 팩의 data/gamesettings.xml 하나다). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Ability Arena" _userSettingsSchema="game/abilityarena/data/arena.settings.xml" _bUIPauseMenu="true" />
  <startMap>game/abilityarena/maps/arena.scene.xml</startMap>
  <inputMap>game/abilityarena/data/arena.input.xml</inputMap>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/abilityarena/audio/abilityarena.audioevents.xml</audioEvents>
</GameSettings>
