<?xml version="1.0" encoding="utf-8"?>
<!--
  AbilityArena 원거리 적(Caster)의 판단 — 적당한 거리(5 ~ 9 m)를 지키며 12 m 안이면 화염구를 쏜다. 물러나도 대상을 본다(초점).
  감각은 ArenaEnemyAIComponent(SelfPosition · TargetPosition · TargetDistance). 상태 이름은 움직임 쪽이다(쏘기는 거리마다 겹친다).
-->
<BehaviorTree>
	<Selector id="root" name="Caster">
		<Sequence id="idle" name="NoTarget">
			<Condition test="!hasBlackboard(TargetPosition)"/>
			<Action name="Idle" task="ai.state" state="Idle"/>
			<Action task="ai.stop"/>
			<Action task="ai.clearFocus"/>
		</Sequence>
		<Sequence id="fight" name="Fight">
			<Action name="FaceTarget" task="ai.focus" key="TargetPosition"/>
			<Selector id="spacing" name="Spacing">
				<Sequence id="chase" name="Chase">
					<Condition test="blackboard(TargetDistance) > 9"/>
					<Action name="Chase" task="ai.state" state="Chase"/>
					<Action task="ai.moveTo" key="TargetPosition"/>
				</Sequence>
				<Sequence id="retreat" name="Retreat">
					<Condition test="blackboard(TargetDistance) &lt; 5"/>
					<Action name="Retreat" task="ai.state" state="Retreat"/>
					<Action task="ai.moveAway" from="SelfPosition" away="TargetPosition" distance="5"/>
				</Sequence>
				<Sequence id="hold" name="Hold">
					<Action name="Hold" task="ai.state" state="Hold"/>
					<Action task="ai.stop"/>
				</Sequence>
			</Selector>
			<ForceSuccess>
				<Sequence id="fire" name="Fire">
					<Condition test="blackboard(TargetDistance) &lt;= 12"/>
					<Action name="Fireball" task="ai.press" button="Arena.Fireball"/>
				</Sequence>
			</ForceSuccess>
		</Sequence>
	</Selector>
</BehaviorTree>
