<?xml version="1.0" encoding="utf-8"?>
<!--
  AbilityArena 근접 적(Grunt)의 판단 — 닿는 거리(1.4 m) 밖이면 다가오고, 안이면 때린다. 감각은 ArenaEnemyAIComponent(SelfPosition · TargetPosition · TargetDistance, 대상이 없으면 지운다).
  잎은 모두 그 자리에서 끝나므로 매 판단 루트부터 다시 고른다. 상태 이름(ai.state)은 시나리오 automation/ai.scenario.xml 의 데이터다(Chase, Strike).
-->
<BehaviorTree>
	<Selector id="root" name="Grunt">
		<Sequence id="idle" name="NoTarget">
			<Condition test="!hasBlackboard(TargetPosition)"/>
			<Action name="Idle" task="ai.state" state="Idle"/>
			<Action task="ai.stop"/>
			<Action task="ai.clearFocus"/>
		</Sequence>
		<Sequence id="fight" name="Fight">
			<Action name="FaceTarget" task="ai.focus" key="TargetPosition"/>
			<Selector name="Approach">
				<Sequence id="chase" name="Chase">
					<Condition test="blackboard(TargetDistance) > 1.4"/>
					<Action name="Chase" task="ai.state" state="Chase"/>
					<Action task="ai.moveTo" key="TargetPosition"/>
				</Sequence>
				<Sequence id="strike" name="Strike">
					<Action name="Strike" task="ai.state" state="Strike"/>
					<Action task="ai.stop"/>
					<Action task="ai.press" button="Arena.Melee"/>
				</Sequence>
			</Selector>
		</Sequence>
	</Selector>
</BehaviorTree>
