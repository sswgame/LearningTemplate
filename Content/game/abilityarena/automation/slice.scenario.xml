<?xml version="1.0" encoding="utf-8"?>
<!--
  장르 수직 슬라이스(G1) — 시작 → 목표(control.scenario.xml 의 단계 그대로) → 결과 → 저장 · 복원 해시 동일.
  목표 단계는 그 시나리오가 정본이다 — 거기를 고치면 이 파일도 맞춘다. 저장 슬롯은 abilityarena/slice.
-->
<Scenario name="game.abilityarena.slice" fixedDelta="0.0166667" timeoutFrames="3900" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_arenaAutoPlay" value="0"/>
	<!-- 플레이어가 가운데 서고 플레이어 조종자가 쥐었다. -->
	<WaitUntil watch="Arena.PlayerControllerKind" equals="0" timeoutFrames="60"/>
	<Expect watch="Arena.PlayerX" near="0" tolerance="0.01"/>
	<!-- D 를 반 초 — 이동 속도 6 m/s 라 3 m 남짓 오른쪽. 선 뒤에 잰다. -->
	<Wait frames="1"/>
	<Press slot="Key.D"/>
	<Wait frames="30"/>
	<Release slot="Key.D"/>
	<Wait frames="4"/>
	<Expect watch="Arena.PlayerX" atLeast="2"/>
	<Expect watch="Arena.PlayerZ" near="0" tolerance="0.01"/>
	<!-- K 한 번 = 화염구 하나. -->
	<Wait frames="1"/>
	<Tap slot="Key.K" hold="1"/>
	<WaitUntil watch="Arena.PlayerShotCount" equals="1" timeoutFrames="30"/>
	<!-- 자동 플레이를 켜면 자동 전투 AI 가 플레이어 폰을 쥐고 싸운다. -->
	<Variable name="gv_arenaAutoPlay" value="1"/>
	<WaitUntil watch="Arena.PlayerControllerKind" equals="1" timeoutFrames="30"/>
	<!-- 첫 처치와 셋째 발사까지만 기다린다. 둘 다 이번 판에 쌓이는 수라 먼저 닿은 쪽이 풀리지 않는다. -->
	<WaitUntil watch="Arena.KillCount" atLeast="1" timeoutFrames="1500"/>
	<WaitUntil watch="Arena.PlayerShotCount" atLeast="3" timeoutFrames="1500"/>
	<!-- 끄면 플레이어 조종자가 되찾는다. -->
	<Variable name="gv_arenaAutoPlay" value="0"/>
	<WaitUntil watch="Arena.PlayerControllerKind" equals="0" timeoutFrames="60"/>
	<!-- 저장 → 세계를 더 돌림 → 두 번 복원: 같은 슬롯을 두 번 불러온 직후의 씬 상태 해시가 같아야 한다(복원이 세계를 다 되살린다 — 저장 순간의 해시와 견주면 명령이 도는 프레임만큼 흔들린다) -->
	<Wait frames="1"/>
	<DevCommand line="game.save abilityarena/slice"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load abilityarena/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="10"/>
	<RecordStateHash key="restored"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load abilityarena/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="2" timeoutWallSeconds="10"/>
	<ExpectStateHash key="restored"/>
	<Pass/>
</Scenario>
