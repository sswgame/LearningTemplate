<?xml version="1.0" encoding="utf-8"?>
<!-- 툰 쇼케이스(toonshowcase.scene.xml)의 툰 구 — PBR 구와 같은 기본색, 칼같은 계단 · 푸른 그림자색 · 림 · 화면 기준 외곽선. -->
<MaterialDef formatVersion="0" name="ToonShowcaseToon" _base="engine/materials/toon.material">
	<_properties>
		<item name="_baseColor" defaultValue="0.95 0.55 0.35 1.0" />
		<item name="_shadeColor" defaultValue="0.45 0.3 0.55 1.0" />
		<item name="_rimColor" defaultValue="0.25 0.2 0.15 1.0" />
		<item name="_outlineColor" defaultValue="0.12 0.05 0.08 1.0" />
		<item name="_shadingShift" defaultValue="-0.1" />
		<item name="_shadingToony" defaultValue="0.95" />
		<item name="_rimFresnelPower" defaultValue="4.0" />
		<item name="_rimLift" defaultValue="0.05" />
		<item name="_outlineWidth" defaultValue="0.005" />
		<item name="_outlineLightingMix" defaultValue="0.5" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_FORWARD_ONLY</item>
		</_alwaysDefines>
		<_staticSwitches>
			<item name="Outline" keyword="MATERIAL_OUTLINE" bEnabled="1" bShaderFeature="0" />
		</_staticSwitches>
	</_permutations>
</MaterialDef>
