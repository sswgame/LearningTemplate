<?xml version="1.0" encoding="utf-8"?>
<!-- bound_a 와 다른 머티리얼이다 — 같은 묶음 값을 읽는다. -->
<MaterialDef formatVersion="0" name="matparams_bound_b" _base="engine/materials/defaultmaterial.material">
	<_properties>
		<item name="_color" collection="game/empty/materials/matparams/world.matparams.xml" collectionParameter="WorldTint"/>
		<item name="_roughness" defaultValue="0.2"/>
	</_properties>
</MaterialDef>
