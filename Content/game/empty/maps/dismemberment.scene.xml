<Scene formatVersion="2" name="Dismemberment">
	<!-- 절단 시나리오(automation/dismemberment)의 무대 — 해골 전사(몸 영역 표 skeleton_warrior.fit.xml 이 있는 유일한 리그)에 래그돌과 절단을 붙여 바닥 위에 세운다.
	     게임 안의 같은 길은 Shooter3D 해골 적(prefabs/skeleton.prefab.xml · automation/dismemberment)이 본다. 여기는 치명 표시를 단 맞음(combat.fatalhit)과 자를 수 없는 영역을 본다. -->
