<Scene formatVersion="2" name="MeleeDuel">
	<!-- 근접 판정 시나리오(automation/meleeduel)의 무대(2D 물리) — Fighter 의 MeleeHitboxComponent 칼날(오른쪽 0.3 ~ 1.4 m)이 Dummy(1 m 오른쪽, HP 30)를 쓸고,
	     맞음은 UnitStatsComponent 가 피해로 받는다(ActionCombat 키트, 액션 룸의 근접 공격과 같은 길). 중력 없는 판이라 몸은 제자리에 있다. -->
	<SceneSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</SceneSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="0.5,0,-10" _localRotation="0,0,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _fovY="0.7" _nearZ="0.1" _farZ="100" _orthoHeight="6" _priority="0" _role="Game" _bOrthographic="true" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Fighter">
			<GameObject _schemaVersion="0" _name="Fighter" _bActive="true">
				<_listComponent>
					<RigidBody2DComponent _localPosition="0,0,0" _localRotation="0,0,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _bodyType="Kinematic" _layer="Default" _material="None" _mass="0" _linearDamping="0.05" _angularDamping="0.05" _gravityFactor="0" _bTrigger="false" _bContinuous="false" _bLockRotation="true" _bInterpolate="false">
						<_listShape>
							<PhysicsShapeDesc2D _type="Box" _halfExtents="0.25,0.5" _localPosition="0,0" _localAngle="0" _material="None" _bLoop="false">
								<_listPoint />
							</PhysicsShapeDesc2D>
						</_listShape>
					</RigidBody2DComponent>
					<MeshComponent _localPosition="0,0,0" _localRotation="0,0,0" _localScale="0.5,1,0.5" _attachOwner="None" _attachComponent="RigidBody2DComponent#0" _meshID="Cube" _materialPath="engine/materials/prototypegrid_orange.material" _boundsRadius="1" />
					<MeleeHitboxComponent _bladeStart="0.3,0,0" _bladeEnd="1.4,0,0" _bladeRadius="0.1" _damage="10" _duration="0.2" _currentDuration="0" _bIsAttacking="false">
						<_listHitTarget />
					</MeleeHitboxComponent>
					<UnitStatsComponent _hp="50" _maxHP="50" _attack="5" _defense="0" _moveSpeed="2" _maxInvincibilityTime="0" _bIsDead="false" _bShowDamageNumbers="false" _damageNumberOffset="0,0.6,0" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Dummy">
			<GameObject _schemaVersion="0" _name="Dummy" _bActive="true">
				<_listComponent>
					<RigidBody2DComponent _localPosition="1,0,0" _localRotation="0,0,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _bodyType="Kinematic" _layer="Default" _material="None" _mass="0" _linearDamping="0.05" _angularDamping="0.05" _gravityFactor="0" _bTrigger="false" _bContinuous="false" _bLockRotation="true" _bInterpolate="false">
						<_listShape>
							<PhysicsShapeDesc2D _type="Box" _halfExtents="0.25,0.5" _localPosition="0,0" _localAngle="0" _material="None" _bLoop="false">
								<_listPoint />
							</PhysicsShapeDesc2D>
						</_listShape>
					</RigidBody2DComponent>
					<MeshComponent _localPosition="0,0,0" _localRotation="0,0,0" _localScale="0.5,1,0.5" _attachOwner="None" _attachComponent="RigidBody2DComponent#0" _meshID="Cube" _materialPath="game/empty/materials/renderstate/plain_red.material" _boundsRadius="1" />
					<UnitStatsComponent _hp="30" _maxHP="30" _attack="5" _defense="0" _moveSpeed="2" _maxInvincibilityTime="0" _bIsDead="false" _bShowDamageNumbers="false" _damageNumberOffset="0,0.6,0" />
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
