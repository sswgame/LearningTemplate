<Scene formatVersion="2" name="SkinningMethod">
	<!-- 시나리오 automation/skinningmethod 의 무대 — 기사 하나를 선형 스키닝(SkinningMethod::Linear)으로 그린다. skinningmethod_dq 가 이 씬을 물려받아 방식만 듀얼 쿼터니언으로 바꾼다.
	     어깨 · 팔꿈치처럼 회전이 다른 본 둘이 섞인 정점에서 두 그림이 달라진다(DQ 는 비튼 관절이 가늘어지지 않는다). -->
	<SceneSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</SceneSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="0,1.2,-3"
					                 _localRotation="0.05,0,0"
					                 _localScale="1,1,1"
					                 _attachOwner="None"
					                 _attachComponent="None"
					                 _fovY="0.7"
					                 _nearZ="0.1"
					                 _farZ="100"
					                 _orthoHeight="10"
					                 _priority="0"
					                 _role="Game"
					                 _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Sun">
			<GameObject _schemaVersion="0" _name="Sun" _bActive="true">
				<_listComponent>
					<DirectionalLightComponent _localPosition="0,0,0"
					                           _localRotation="0.628882,0.93002,0"
					                           _localScale="1,1,1"
					                           _attachOwner="None"
					                           _attachComponent="None"
					                           _color="1,0.96,0.9"
					                           _intensity="1.2"
					                           _ambient="0.3"
					                           _shadowExtent="8"
					                           _shadowDistance="20"
					                           _bCastShadow="true" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Ground">
			<GameObject _schemaVersion="0" _name="Ground" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="0,0,2"
					               _localRotation="0,0,0"
					               _localScale="16,1,16"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="Plane"
					               _materialPath="engine/materials/prototypegrid_dark.material"
					               _boundsRadius="12" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="4" name="Knight">
			<GameObject _schemaVersion="0" _name="Knight" _bActive="true">
				<_listComponent>
					<SkeletalMeshComponent _componentName="SkeletalMeshComponent"
					                       _bActive="true"
					                       _localPosition="0,0,0"
					                       _localRotation="0,3.1415927,0"
					                       _localScale="1,1,1"
					                       _attachOwner="None"
					                       _attachOwnerID="0"
					                       _attachComponent="None"
					                       _meshID="common/models/kaykit/knight.mesh"
					                       _materialPath="common/materials/kaykit_knight.material"
					                       _boundsRadius="2"
					                       _gpuSpinSeed="0"
					                       _bVisible="true"
					                       _skeletonPath="common/models/kaykit/knight/knight.skeleton.xml"
					                       _updateRateDivisor="1"
					                       _skinningMethod="Linear"
					                       _bFollowParentPose="false"
					                       _bAnimateWhenOffscreen="false" />
					<SkeletalAnimatorComponent _componentName="SkeletalAnimatorComponent"
					                           _bActive="true"
					                           _animationGraphPath="common/data/anim/adventurer.animgraph.xml"
					                           _animationSetPath="common/models/kaykit/knight/knight.animset.xml"
					                           _initialState="Idle"
					                           _currentState=""
					                           _stateTime="0.8"
					                           _playRate="0"
					                           _blendSeconds="0.2"
					                           _syncGroup=""
					                           _syncWeight="1"
					                           _bExtractRootMotion="false"
					                           _bPlayOnBegin="true" />
				</_listComponent>
			</GameObject>
		</entity>
		</entities>
</Scene>
