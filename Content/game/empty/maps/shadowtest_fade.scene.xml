					                           _localScale="1,1,1"
					                           _attachOwner="None"
					                           _attachComponent="None"
					                           _color="1,0.96,0.9"
					                           _intensity="1.2"
					                           _ambient="0.3"
					                           _shadowExtent="8"
					                           _shadowDistance="20"
					                           _shadowViewDistance="14"
					                           _shadowCascadeCount="2"
					                           _shadowFadeFraction="0.5"
					                           _bCastShadow="true">
						<_shadowSettings _sourceSize="3" />
					</DirectionalLightComponent>
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
