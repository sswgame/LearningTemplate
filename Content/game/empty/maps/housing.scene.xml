<!--
  하우징 시연(GF_Housing) — 8 x 6 칸 · 2 층 부지 하나(원점 0,0,0 에서 +X · +Z 로 뻗는다)와 카탈로그 data/housingparts.xml(바닥 · 벽 · 문 · 탁자 · 침대).
  부지는 비어 시작한다. 시나리오 automation/housing.scenario.xml 이 개발 명령 housing.* 로 짓고 고스트 · 되돌리기 · 저장 · 재로드를 값으로 본다.
-->
<Scene formatVersion="2" name="Housing">
	<SceneSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</SceneSettings>
	<entities>
		<entity id="1" name="Camera">
			<GameObject _schemaVersion="0" _name="Camera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="4,9,-6"
					                 _localRotation="0.785,0,0"
					                 _localScale="1,1,1"
					                 _attachOwner="None"
					                 _attachComponent="None"
					                 _fovY="0.8"
					                 _nearZ="0.1"
					                 _farZ="100"
					                 _orthoHeight="10"
					                 _priority="0"
					                 _role="Game"
					                 _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Sun">
			<GameObject _schemaVersion="0" _name="Sun" _bActive="true">
				<_listComponent>
					<DirectionalLightComponent _localPosition="0,0,0"
					                           _localRotation="0.9,2.6,0"
					                           _localScale="1,1,1"
					                           _attachOwner="None"
					                           _attachComponent="None"
					                           _color="1,0.96,0.9"
					                           _intensity="1.2"
					                           _ambient="0.35"
					                           _shadowExtent="10"
					                           _shadowDistance="30"
					                           _bCastShadow="true" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Ground">
			<GameObject _schemaVersion="0" _name="Ground" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="4,-0.05,3"
					               _localRotation="0,0,0"
					               _localScale="16,0.1,14"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="Cube"
					               _materialPath="engine/materials/prototypegrid_dark.material"
					               _boundsRadius="0.866"
					               _gpuSpinSeed="0"
					               _bVisible="true" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="4" name="HousingPlot">
			<GameObject _schemaVersion="0" _name="HousingPlot" _bActive="true">
				<_listComponent>
					<SceneComponent _localPosition="0,0,0"
					                _localRotation="0,0,0"
					                _localScale="1,1,1"
					                _attachOwner="None"
					                _attachComponent="None" />
					<HousingPlotComponent _bAutoPlay="false"
					                      _partCatalog="game/empty/data/housingparts.xml"
					                      _startingFunds="500"
					                      _ghostPlaceablePrefab="game/empty/prefabs/housing/ghost_placeable.prefab.xml"
					                      _ghostBlockedPrefab="game/empty/prefabs/housing/ghost_blocked.prefab.xml">
						<_settings _plotID="home" _sizeX="8" _sizeZ="6" _levelCount="2" _historyLimit="64" _bFreePlacement="true" />
					</HousingPlotComponent>
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
