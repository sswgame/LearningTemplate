<Scene formatVersion="2" _base="game/empty/maps/shadowtest.scene.xml" name="ShadowTestContact">
	<!-- 시나리오 automation/shadow_contact 의 둘째 무대 — shadowtest 를 물려받아 해(0.6 m)와 점광(0.4 m)의 접촉 그림자 길이만 켠다(LightShadowSettings::_contactShadowLength).
