<Scene formatVersion="2" name="Afterimage">
	<!-- 잔상 시나리오(automation/afterimage)의 무대 — 해골(Actor)이 쉬는 자세로 서 있고 PoseAfterimageComponent 가 0.1 초마다 포즈를 고정한 반투명 사본을 남긴다(최대 6, 0.6 초에 사라짐).
	     시나리오가 Actor 를 옆으로 순간이동시키면 옛 자리에 잔상이 남는다. 잔상 머티리얼은 인스턴스 값 0 을 색으로 쓰는 엔진 반투명 머티리얼이다. -->
	<SceneSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
	</SceneSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="1.5,1.6,-6" _localRotation="0.12,0,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _fovY="0.8" _nearZ="0.1" _farZ="100" _orthoHeight="10" _priority="10" _role="Game" _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Sun">
			<GameObject _schemaVersion="0" _name="Sun" _bActive="true">
				<_listComponent>
					<DirectionalLightComponent _localPosition="0,0,0" _localRotation="0.356582,-2.338715,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _color="1,1,1" _intensity="1.2" _ambient="0.5" _shadowExtent="8" _shadowDistance="20" _bCastShadow="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="3" name="Ground">
			<GameObject _schemaVersion="0" _name="Ground" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="0,0,0" _localRotation="0,0,0" _localScale="30,1,30" _attachOwner="None" _attachComponent="None" _meshID="Plane" _materialPath="engine/materials/prototypegrid_dark.material" _boundsRadius="25" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="4" name="Actor">
			<GameObject _schemaVersion="0" _name="Actor" _bActive="true">
				<_listComponent>
					<SkeletalMeshComponent _localPosition="0,0,0" _localRotation="0,3.1415927,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _meshID="" _materialPath="" _boundsRadius="2" />
