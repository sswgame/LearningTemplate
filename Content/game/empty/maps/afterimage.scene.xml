					<CharacterAppearanceComponent _presetID="SkeletonMinion" _seed="0" _bMergeParts="true" />
					<PoseAfterimageComponent _materialPath="engine/materials/instancecustomcolor.material" _color="0.4,0.8,1,0.6" _capturePeriod="0.1" _lifetime="0.6" _maxGhosts="6" _bCaptureOnBeginPlay="true">
						<_opacityOverLife>
							<_listKey>
								<FloatCurveKey _time="0" _value="1" _interpolation="Linear" />
								<FloatCurveKey _time="1" _value="0" _interpolation="Linear" />
							</_listKey>
						</_opacityOverLife>
					</PoseAfterimageComponent>
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
