msgstr "정찰병"

#. Context: Subtitle line
#: game/empty/audio/empty.audioevents.xml
msgctxt "Subtitle.ScoutLine"
msgid "Movement on the ridge. Stay low."
msgstr "능선에 움직임이 있다. 몸을 낮춰."

#. Context: SequenceTrackItem._text
#: game/empty/data/cinematic.seq.xml
msgctxt "The warrior wakes."
msgid "The warrior wakes."
msgstr "전사가 깨어난다."