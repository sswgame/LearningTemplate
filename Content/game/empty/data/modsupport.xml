<?xml version="1.0" encoding="utf-8"?>
<!--
  Empty 게임의 모드 정책(GF_ModSupport, ModSupportSettings). 모드는 이 판(contentVersion)을 받는 매니페스트만 켜고, 아래 접두의 기본 리소스만 덮어쓴다.
  한계는 바깥 입력(매니페스트 · 팩)을 읽기 전에 견주는 값이다 — 모드 팩 64 MiB, 항목 2048 개, 항목 하나 16 MiB, 매니페스트 16 KiB, 한 세션 16 개.
-->
<ModSupportSettings contentVersion="1" maxModCount="16" maxManifestBytes="16384" maxPackBytes="67108864" maxEntryCount="2048" maxEntryBytes="16777216">
	<Overridable prefix="game/empty/data/mods/"/>
</ModSupportSettings>
