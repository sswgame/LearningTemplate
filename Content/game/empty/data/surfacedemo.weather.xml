<?xml version="1.0" encoding="utf-8"?>
<!-- 표면 상호작용 무대(maps/surfaceinteraction)의 날씨 — wetness 는 SurfaceExposureComponent 가 비의 세기로 읽는다(_precipitationValue).
     시나리오가 cheat.weather 로 바꾸므로 맑음만 고를 무게를 갖고, 비 · 눈은 무게 0 이다(저절로 오지 않는다). -->
<WeatherCatalog transition="5">
	<Weather id="clear" weight="1" minDuration="100000" maxDuration="100000">
		<Values wetness="0"/>
	</Weather>
	<Weather id="rain" weight="0" minDuration="100000" maxDuration="100000">
		<Values wetness="1"/>
	</Weather>
	<Weather id="snow" weight="0" minDuration="100000" maxDuration="100000">
		<Values wetness="0.1" snowfall="1"/>
	</Weather>
</WeatherCatalog>
