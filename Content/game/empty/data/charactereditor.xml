<?xml version="1.0" encoding="utf-8"?>
<!-- 캐릭터 편집 창(GF_EditorPlugin_CharacterEditor)이 템플릿 게임에서 여는 데이터 — 에디터 시나리오(engine/automation/editor/charactereditor)가 기본 게임으로 돈다.
     Empty 팩에는 캐릭터가 없어 Shooter3D 팩의 KayKit 데이터를 가리킨다(다른 팩을 쓰는 의존이 코드가 아니라 이 데이터에 보인다). 여섯 칸은 필수이고 rig(미리보기 몸에 얹어 볼 제약 리그)만 선택이다.
     레퍼런스 포즈는 스켈레톤 이름에서 만든다(knight.refpose.xml). previewPreset 은 창의 미리보기 몸(기준 프리셋이 없을 때 입히는 프리셋)이다. -->
<CharacterEditor sockets="common/data/sockets/kaykit_humanoid.sockets.xml"
                 skeleton="common/models/kaykit/knight/knight.skeleton.xml"
                 items="common/data/items.xml"
                 appearance="common/data/appearance"
                 clipFolder="common/models/kaykit/knight/clips"
                 previewPreset="Adventurer"
                 rig="common/rigs/player_body.rig.xml"/>
