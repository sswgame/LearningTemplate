<!--
	파이프라인 XML 만으로 컴퓨트 효과를 더한 포워드 파이프라인 — 코드 없이 패스 한 줄과 셰이더 하나다. 시나리오: automation/computepass.
	고르는 법: `-gv_renderPipeline=game/empty/pipeline/computepasspipeline.xml`.
-->
<RenderPipelineDesc _base="game/empty/pipeline/tessellationstagepipeline.xml" _name="ComputePassPipeline">
	<_listAttachment>
		<RenderPassAttachment _name="TonemapColor" _op="Remove" />
		<RenderPassAttachment _name="SwappedColor" _format="R16G16B16A16_FLOAT" _clearColor="0,0,0,1" _loadOp="Load" _role="" _resolutionDivisor="1" />
	</_listAttachment>
	<_listPass>
		<RenderGraphPassDesc _name="Tonemap" _op="Remove" />
		<RenderGraphPassDesc _name="ChannelSwap" _after="ForwardOpaque" _type="Compute" _depthAttachment="" _shaderPath="game/empty/shaders/compute_channelswap.hlsl" _vertexEntryPoint="" _pixelEntryPoint="" _computeEntryPoint="CSMain" _geometryEntryPoint="" _hullEntryPoint="" _domainEntryPoint="" _threadGroupSize="8" _cullMode="None" _bEnableDepthTest="false" _bEnableDepthWrite="false" _minPostQuality="0">
			<_listInput>
				<item>SceneColor</item>
			</_listInput>
			<_listOutput>
				<item>SwappedColor</item>
			</_listOutput>
			<_listPermutation />
		</RenderGraphPassDesc>
		<RenderGraphPassDesc _name="Present" _shaderPath="engine/shaders/post_chain.hlsl">
			<_listInput>
				<item>SwappedColor</item>
			</_listInput>
			<_listPermutation>
				<item>SW_POST_TONEMAP=1</item>
			</_listPermutation>
		</RenderGraphPassDesc>
	</_listPass>
</RenderPipelineDesc>
