<!--
	모듈 렌더 확장 시연 파이프라인(ExtensionRenderPass M3 · M4) — 포워드 파이프라인(`engine/pipeline/forwardpipeline.xml`)과 같은 패스 목록이다. 모듈 패스는 이 XML 에 적지 않는다:
	게임 모듈(EmptyGame)이 `IRenderExtension` 을 등록하고, 렌더러가 프레임마다 그 확장이 선언한 패스(`Empty.DrawDemo` · `Empty.TintDemo`)를 같은 RenderGraph 에 끼운다
	(PrePostProcess 자리 = 피사계 심도 앞). 이 파일이 하는 일은 모듈이 쓸 셰이더를 `_listExtensionShader` 로 선언하는 것뿐이다.
	시나리오 `game/empty/automation/extensionpass.scenario.xml` 이 `gv_renderPipeline` 로 고른다.
-->
<RenderPipelineDesc _base="engine/pipeline/forwardpipeline.xml" _name="ModulePassPipeline">
	<_listPass>
		<RenderGraphPassDesc _name="Fog" _op="Remove" />
		<RenderGraphPassDesc _name="SceneDepthCopy" _op="Remove" />
		<RenderGraphPassDesc _name="SceneColorCopy" _op="Remove" />
		<RenderGraphPassDesc _name="Transparent">
			<_listInput>
				<item>SceneColor</item>
				<item>SceneDepth</item>
			</_listInput>
		</RenderGraphPassDesc>
	</_listPass>
	<_listRenderPassRef>
		<item>engine/renderpass/defaultrenderpass.xml</item>
		<item>engine/renderpass/framecomputerenderpass.xml</item>
		<item>engine/renderpass/forwardcolorrenderpass.xml</item>
	</_listRenderPassRef>
	<_listExtensionShader>
		<item>engine/shaders/extension_pass_demo.hlsl</item>
		<item>engine/shaders/extension_draw_demo.hlsl</item>
	</_listExtensionShader>
</RenderPipelineDesc>
