<?xml version="1.0" encoding="utf-8"?>
<!--
  천 LOD — 기사 등의 물리 천(maps/clothlod.scene.xml, _iterationCount 6 · _listLODIterationCount 4, 2 · _maxLOD 2)은 기사 스켈레탈 메시의 애니메이션 LOD 등급을 읽는다.
  카메라를 멀리 옮기면(object.place) 화면 크기가 줄어 등급이 오른다(engine/animation/animationlod.xml: 0.25 · 0.10 · 0.04 문턱, 기사 경계 구 지름 4, fovY 0.7).
  ① 가까이(3.4 m) 등급 0 → 6 반복 ② 35 m 등급 1 → 4 반복 ③ 90 m 등급 2 → 2 반복 ④ 200 m 등급 3 → 천을 내린다(반복 0, 쉬는 격자) ⑤ 다시 가까이 → 새로 만들어 6 반복.
  값으로 판정한다(그림 골든은 두지 않는다) — 반복 수가 등급을 따라 바뀌지 않으면 천이 LOD 칸을 읽지 않은 것이다.
  실행: App -scenario=game/empty/automation/clothlod.scenario.xml -unattended (체인: ctest -R Scenario.game.empty.clothlod)
-->
<Scenario name="game.empty.clothlod" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/clothlod.scene.xml"/>
	<Launch variable="gv_viewDistanceScale" value="1"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="30"/>
	<Expect watch="Cloth.LODGrade" equals="0"/>
	<Expect watch="Cloth.LODSuspended" equals="0"/>
	<Expect watch="Cloth.IterationCount" equals="6"/>
	<Wait frames="1"/>

	<DevCommand line="object.place GameCamera 0 1 -35"/>
	<WaitUntil watch="Cloth.LODGrade" equals="1" timeoutFrames="60"/>
	<WaitUntil watch="Cloth.IterationCount" equals="4" timeoutFrames="10"/>
	<Expect watch="Cloth.LODSuspended" equals="0"/>
	<Wait frames="1"/>

	<DevCommand line="object.place GameCamera 0 1 -90"/>
	<WaitUntil watch="Cloth.LODGrade" equals="2" timeoutFrames="60"/>
	<WaitUntil watch="Cloth.IterationCount" equals="2" timeoutFrames="10"/>
	<Expect watch="Cloth.LODSuspended" equals="0"/>
	<Wait frames="1"/>

	<DevCommand line="object.place GameCamera 0 1 -200"/>
	<WaitUntil watch="Cloth.LODGrade" equals="3" timeoutFrames="60"/>
	<WaitUntil watch="Cloth.LODSuspended" equals="1" timeoutFrames="10"/>
	<Expect watch="Cloth.IterationCount" equals="0"/>
	<Wait frames="1"/>

	<DevCommand line="object.place GameCamera 0 1 -3.4"/>
	<WaitUntil watch="Cloth.LODGrade" equals="0" timeoutFrames="60"/>
	<WaitUntil watch="Cloth.LODSuspended" equals="0" timeoutFrames="10"/>
	<WaitUntil watch="Cloth.IterationCount" equals="6" timeoutFrames="10"/>
	<Pass/>
</Scenario>
