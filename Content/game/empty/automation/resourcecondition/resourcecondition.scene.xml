<Scene formatVersion="2" name="ResourceCondition">
	<!-- 리소스 조건 확인(automation/resourcecondition)의 무대 — 상호작용 대상 Probe 가 조건이 든 표(table.interactions.xml)의 Use 를 쥔다. Night 레이어는 처음에 꺼져 있고 엔티티가 없다(태그만 켠다). -->
	<SceneSettings _bStreaming="false" _unloadMargin="0" _maxCellLoadsPerFrame="0">
		<_cellGrid _cellSize="0" _loadingRadius="0" />
		<_listDataLayer>
			<SceneDataLayerDef _name="Night" _bInitiallyActive="false" />
		</_listDataLayer>
	</SceneSettings>
	<entities>
		<entity id="1" name="GameCamera">
			<GameObject _schemaVersion="0" _name="GameCamera" _bActive="true">
				<_listComponent>
					<CameraComponent _localPosition="0,4,-8" _localRotation="0.4,0,0" _localScale="1,1,1" _attachOwner="None" _attachComponent="None" _fovY="0.7" _nearZ="0.1" _farZ="100" _orthoHeight="10" _priority="0" _role="Game" _bOrthographic="false" />
				</_listComponent>
			</GameObject>
		</entity>
		<entity id="2" name="Probe">
			<GameObject _schemaVersion="0" _name="Probe" _bActive="true">
				<_listComponent>
					<MeshComponent _localPosition="0,0.5,0"
					               _localRotation="0,0,0"
					               _localScale="1,1,1"
					               _attachOwner="None"
					               _attachComponent="None"
					               _meshID="Cube"
					               _materialPath="engine/materials/prototypegrid_orange.material"
					               _boundsRadius="0.9" />
					<InteractableComponent _componentName="InteractableComponent"
					                       _bActive="true"
					                       _interactionID="Use"
					                       _catalogPath="game/empty/automation/resourcecondition/table.interactions.xml"
					                       _priority="0"
					                       _bEnabled="true" />
				</_listComponent>
			</GameObject>
		</entity>
	</entities>
</Scene>
