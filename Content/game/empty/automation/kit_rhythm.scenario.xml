<?asset guid="176fea0363d045ee977d38fe7e169497"?>
<!--
  장르 키트 시연 — 리듬 키트(GF_Rhythm)의 한 곡: 레인 둘 · 노트 둘(롱노트 하나)의 채보를 오토플레이로 끝까지 → 판정 셋이 모두 가장 좁은 창(100 점) → 곡을 깸.
  감시 값: KitDemo.Rhythm.State(0 시작 전, 1 마침) · .Score · .MaxCombo · .Cleared.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.kit.rhythm" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/kit_rhythm.scene.xml"/>
	<WaitUntil watch="KitDemo.Rhythm.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.Rhythm.Score" equals="300"/>
	<Expect watch="KitDemo.Rhythm.MaxCombo" equals="3"/>
	<Expect watch="KitDemo.Rhythm.Cleared" equals="1"/>
	<ExpectLog id="KitDemo.RhythmDone" count="1"/>
	<Pass/>
</Scenario>
