<?xml version="1.0" encoding="utf-8"?>
<!--
  핫 리로드 디버그 확인 — 헤더가 바뀐 판(칸 하나와 그 생성자 값 7 을 더한다). 검증 체인 밖이다: `py -3 Scripts/dev/hot_reload_debug_check.py --variant layout` 가 lldb 아래에서 띄운다.
  리로드는 리플렉션 칸으로 상태를 옮기므로 씬 값(42)은 그대로이고, 새 칸은 새 생성자의 값이어야 한다. 브레이크포인트 판정은 스크립트가 한다.
-->
<Scenario name="game.empty.debugger.hotreloadlayout" fixedDelta="0.0166667" timeoutFrames="7200" startAfter="Immediately" input="exclusive">
	<LoadScene path="game/empty/maps/hotreloadprobe.scene.xml" timeoutFrames="600"/>
	<Wait frames="10"/>
	<Expect watch="HotReload.ProbeKept" equals="42"/>
	<Expect watch="HotReload.ProbeAdded" equals="0"/>
	<Remember watch="HotReload.ProbeVersion" as="before"/>
	<Wait frames="1"/>
	<DevCommand line="module.reload SWGame"/>
	<WaitUntil watch="Module.ReloadPending" equals="0" timeoutWallSeconds="600"/>
	<Wait frames="5"/>
	<Expect watch="Module.GraphBroken" equals="0"/>
	<Expect watch="HotReload.ProbeKept" equals="42"/>
	<Expect watch="HotReload.ProbeAdded" equals="7"/>
	<Expect watch="HotReload.ProbeVersion" differsFrom="before"/> <!-- 새 모듈의 코드를 부른다 — 스크립트는 여기서 같은 브레이크포인트가 새 모듈에서 멈추는지 본다 -->
	<Pass/>
</Scenario>
