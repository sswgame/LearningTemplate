<!--
  장르 키트 시연 — 비대칭 공포 키트(GF_AsymmetricHorror)의 판 한 바퀴: 생존자 하나가 발전기 둘을 고침 → 전원 → 탈출문 열기 → 탈출 → 생존자 팀(0) 승리.
  감시 값: KitDemo.AsymmetricHorror.State(0 시작 전, 1 마침) · .Generators · .Escaped · .WinningTeam.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.kit_asymmetrichorror" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/kit_asymmetrichorror.scene.xml"/>
	<WaitUntil watch="KitDemo.AsymmetricHorror.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.AsymmetricHorror.Generators" equals="2"/>
	<Expect watch="KitDemo.AsymmetricHorror.Escaped" equals="1"/>
	<Expect watch="KitDemo.AsymmetricHorror.WinningTeam" equals="0"/>
	<ExpectLog id="KitDemo.AsymmetricHorrorDone" count="1"/>
	<Pass/>
</Scenario>
