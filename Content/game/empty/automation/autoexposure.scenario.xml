<?xml version="1.0" encoding="utf-8"?>
<!--
  자동 노출 적응(PostProcessValues._autoExposureMinEv · MaxEv, auto_exposure.hlsl) — 어두운 곳에서 밝은 곳으로 바뀐 직후의 화면은 하얗게 날아가고, 시간이 지나면 노출이 내려가 다른 그림이 되며, 다 적응하면 그림이 멈춘다.
  적응이 돌지 않으면(노출 고정 · 측정 없음) 첫 두 장이 같아서 진다. 적응이 끝나지 않고 떨리면 셋째 판정이 진다. 골든이 아니라 같은 실행의 세 장이다.
  적응 시계는 씬의 게임 시계라(FramePassExecutor 가 getVertexAnimationTime 을 넘긴다) 고정 프레임 시간이면 같은 프레임이 같은 노출이다.
  실행: App -scenario=game/empty/automation/autoexposure.scenario.xml -unattended (체인: ctest -R Scenario.empty)
-->
<Scenario name="game.empty.autoexposure" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/autoexposure.scene.xml"/>
	<Launch variable="gv_postQuality" value="2"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<!-- 어두운 벽에 다 적응한다(속도 3/s, 3 초면 0.01 % 안). -->
	<Wait frames="180"/>
	<DevCommand line="scene.layer Bright on"/>
	<Wait frames="2"/>
	<Screenshot file="exposure_first.ppm"/>
	<Wait frames="300"/>
	<Screenshot file="exposure_adapted.ppm"/>
	<Wait frames="30"/>
	<Screenshot file="exposure_settled.ppm"/>
	<Wait frames="5"/>
	<ExpectImagesDiffer first="exposure_first.ppm" second="exposure_adapted.ppm" region="0.2,0.2,0.8,0.8" minDiffering="0.5"/>
	<ExpectImagesDiffer first="exposure_adapted.ppm" second="exposure_settled.ppm" region="0.2,0.2,0.8,0.8" minDiffering="0" maxDiffering="0.01"/>
	<Pass/>
</Scenario>
