<!--
  게임 중 꾸미기 ⑥ 걷는 동안 체형 · 굽 신발 — 무대 maps/bodycustomization 의 Dancer(해골 전사, 발 디딤 리그 skeleton_bodydemo). customizeheels 와 같은 몸(CustomizeDancer)을
  개발 명령 anim.play 로 제자리 걷기(Walking_A)에 두고, 다리 길이 극값(LegLength ±1) · 굽(heels_high)에서 발바닥이 땅에 서는지 값으로 본다.
  감시 값은 발 디딤 노드 출력이다 — sole_gap_peak(최근 1 ~ 2 초 가장 낮은 발목 - (땅 + 레퍼런스 발목 높이 + 굽)의 절댓값 최댓값 — 걷기 한 주기를 덮는다),
  leg_lift(체형의 다리 길이 비로 골반을 옮긴 높이). ground_hits 는 광선이 땅에 닿은 수라 다리가 땅에 묻혀도 2 다 — 발 높이는 sole_gap 만 본다.
  고친 결함: 다리 길이 비율이 다리를 늘여도 골반은 그대로라 디딘 발이 늘인 만큼 땅에 묻혔다(줄이면 떴다) — 발 디딤이 다리 길이 비만큼 골반을 옮긴다.
  창(1 초 칸 두 개)이 바뀐 몸의 걸음으로만 차도록 값을 바꾼 뒤 걷기 한 주기 남짓(70 프레임) 돌리고 판정한다. 걷기라 사진은 프레임마다 다르다 — 값으로 판정한다.
  실행: App -scenario=game/empty/automation/customizewalk.scenario.xml -unattended
-->
<Scenario name="game.empty.customizewalk" fixedDelta="0.0166667" timeoutFrames="3000" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/bodycustomization.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="appearance.preset Dancer CustomizeDancer 0"/>
	<WaitUntil watch="Appearance.Preset" target="Dancer" is="CustomizeDancer" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<DevCommand line="anim.play Dancer Walking_A"/>
	<WaitUntil watch="Animation.State" target="Dancer" is="Walking_A" timeoutFrames="60"/>

	<!-- ⑴ 기본 몸 — 걷는 클립 자체의 발 높이 오차(기준) -->
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.leg_lift" near="0" tolerance="0.005" timeoutFrames="30"/>
	<AdvanceSimulation frames="70" render="true"/> <!-- 창이 걷는 몸의 값으로 찬다 -->
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.sole_gap_peak" atMost="0.03" timeoutFrames="120"/>

	<!-- ⑵ 다리를 늘인다 — 골반이 올라가고(leg_lift > 0) 발은 땅에 선다 -->
	<DevCommand line="appearance.value Dancer LegLength 1"/>
	<WaitUntil watch="Appearance.Value" target="Dancer" key="LegLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.leg_lift" atLeast="0.03" timeoutFrames="30"/>
	<AdvanceSimulation frames="70" render="true"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.sole_gap_peak" atMost="0.03" timeoutFrames="120"/>

	<!-- ⑶ 다리를 줄인다 — 골반이 내려가고(leg_lift < 0) 발이 뜨지 않는다 -->
	<DevCommand line="appearance.value Dancer LegLength -1"/>
	<WaitUntil watch="Appearance.Value" target="Dancer" key="LegLength" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.leg_lift" atMost="-0.03" timeoutFrames="30"/>
	<AdvanceSimulation frames="70" render="true"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.sole_gap_peak" atMost="0.03" timeoutFrames="120"/>

	<!-- ⑷ 줄인 다리 + 높은 굽 — 발목이 땅 + 굽에 선다 -->
	<DevCommand line="appearance.slot Dancer Feet heels_high"/>
	<WaitUntil watch="Appearance.SlotItem" target="Dancer" key="Feet" is="heels_high" timeoutFrames="10"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.foot_lift" near="0.1" tolerance="0.001" timeoutFrames="60"/>
	<AdvanceSimulation frames="70" render="true"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.sole_gap_peak" atMost="0.03" timeoutFrames="120"/>

	<!-- ⑸ 늘인 다리 + 높은 굽 -->
	<DevCommand line="appearance.value Dancer LegLength 1"/>
	<WaitUntil watch="Appearance.Value" target="Dancer" key="LegLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Dancer" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.leg_lift" atLeast="0.03" timeoutFrames="30"/>
	<AdvanceSimulation frames="70" render="true"/>
	<WaitUntil watch="Rig.Output" target="Dancer" key="Feet.sole_gap_peak" atMost="0.03" timeoutFrames="120"/>
	<Expect watch="Rig.Output" target="Dancer" key="Feet.ground_hits" near="2" tolerance="0.01"/>
	<Pass/>
</Scenario>
