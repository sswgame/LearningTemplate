<?xml version="1.0" encoding="utf-8"?>
<!--
  집기(GrabberComponent) · 눌림판 무게(GimmickWeightComponent) · 씬 너머 남기기(PersistAcrossScenesComponent) — 값으로 판정한다(골든 없음).
  ① Hand 가 상자를 집으면(개발 명령 grab.pick — 게임의 집기 입력과 같은 함수) 상자가 손을 따라 키네마틱으로 붙는다. ② 손을 눌림판 위로 옮기고 내려놓으면(grab.throw 0 0 0)
  상자가 동적으로 돌아가 떨어지고, 눌림판이 재는 무게는 강체 질량 5 가 아니라 상자의 무게 덮어쓰기 40 이다. ③ 씬을 바꾸면 Keeper 만 남는다.
  실행: App -scenario=game/empty/automation/grabcarry.scenario.xml -unattended (체인: ctest -R Scenario.empty)
-->
<Scenario name="game.empty.grabcarry" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/grabcarry.scene.xml"/>
	<Wait frames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="30"/>
	<Expect watch="Grab.Held" target="Hand" is="none"/>
	<Expect watch="Gimmick.OccupantWeight" target="Plate" equals="0"/>

	<DevCommand line="grab.pick Hand Crate"/>
	<Expect watch="Grab.Held" target="Hand" is="Crate"/>
	<DevCommand line="object.place Hand 2 1.5 0"/>
	<WaitUntil watch="Object.DistanceTo" target="Crate" key="Hand" atMost="0.05" timeoutFrames="10"/>
	<Expect watch="Gimmick.OccupantWeight" target="Plate" equals="0"/>

	<DevCommand line="grab.throw Hand 0 0 0"/>
	<Expect watch="Grab.Held" target="Hand" is="none"/>
	<WaitUntil watch="Gimmick.OccupantWeight" target="Plate" near="40" tolerance="0.01" timeoutSeconds="3"/>
	<WaitUntil watch="Object.Y" target="Crate" atMost="0.3" timeoutSeconds="3"/>
	<Wait frames="1"/>

	<LoadScene path="game/empty/maps/dismemberment.scene.xml" timeoutFrames="600"/>
	<Wait frames="5"/>
	<Expect watch="Object.Exists" target="Keeper" equals="1"/>
	<Expect watch="Object.Exists" target="Crate" equals="0"/>
	<Expect watch="Object.Exists" target="Skeleton" equals="1"/>
	<Pass/>
</Scenario>
