<?xml version="1.0" encoding="utf-8"?>
<!--
  컬러 그레이딩(post_grade.hlsli 의 CameraGrade::applyColorGrading · applyLut) — 레이어 Grading 의 무한 볼륨이 화이트 밸런스 4000 K, 그림자 · 밝은 부분 게인,
  세피아 LUT(세기 0.5)를 건다. 켠 그림은 끈 그림과 달라야 하고(그레이딩 · LUT 가 돌지 않으면 같다), 끄면 처음 그림으로 돌아와야 한다(중립 값은 그림을 바꾸지 않는다).
  LUT 는 비동기로 읽힌다 — 레이어를 켠 뒤 에셋 대기가 끝나야 LUT 가 걸린다.
  실행: ctest -R Scenario.game.empty.postprocess_grading
-->
<Scenario name="game.empty.postprocess_grading" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/postprocessvolume.scene.xml"/>
	<Launch variable="gv_postQuality" value="2"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Launch variable="gv_viewDistanceScale" value="1"/>
	<Wait frames="40"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Screenshot file="ppgrading_off.ppm"/>

	<DevCommand line="scene.layer Grading on"/>
	<Wait frames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="5"/>
	<Screenshot file="ppgrading_on.ppm"/>

	<DevCommand line="scene.layer Grading off"/>
	<Wait frames="10"/>
	<Screenshot file="ppgrading_back.ppm"/>

	<Wait frames="5"/>
	<ExpectImagesDiffer first="ppgrading_off.ppm" second="ppgrading_on.ppm" region="0.1,0.1,0.9,0.9" minDiffering="0.3"/>
	<ExpectImagesDiffer first="ppgrading_off.ppm" second="ppgrading_back.ppm" region="0.1,0.1,0.9,0.9" minDiffering="0" maxDiffering="0.001"/>
	<ExpectImage file="ppgrading_on.ppm" golden="ppgrading_on"/>
	<Pass/>
</Scenario>
