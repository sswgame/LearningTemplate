<!--
  장르 키트 시연 — 유령 사냥 키트(GF_GhostHunt)의 싸움 한 바퀴: 유령 goob 을 내어 공격 동작까지 기다림 → 손전등으로 기절 → 흡입 1 초로 서지 게이지를 채움 → 서지로 잡아 동전 10.
  감시 값: KitDemo.GhostHunt.State(0 시작 전, 1 마침) · .Stunned · .Coins · .Remaining.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.kit_ghosthunt" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/kit_ghosthunt.scene.xml"/>
	<WaitUntil watch="KitDemo.GhostHunt.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.GhostHunt.Stunned" equals="1"/>
	<Expect watch="KitDemo.GhostHunt.Coins" equals="10"/>
	<Expect watch="KitDemo.GhostHunt.Remaining" equals="0"/>
	<ExpectLog id="KitDemo.GhostHuntDone" count="1"/>
	<Pass/>
</Scenario>
