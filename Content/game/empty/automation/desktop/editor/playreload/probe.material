<?xml version="1.0" encoding="utf-8"?>
<?asset guid="e09bfb298f7c4a05b8001826f9182c33"?>
<!-- 플레이 중 리로드 시나리오의 상자 머티리얼 — 같은 폴더의 텍스처(probe.dds)를 쓴다. probe_edited.material 은 색만 다른 같은 머티리얼이다(asset.overwriteScratch 가 덮는다). -->
<MaterialDef formatVersion="0" name="PlayReloadProbe" _base="engine/materials/pbrmaterial.material">
	<_properties>
		<item name="_color" defaultValue="1 1 1 1" />
		<item name="_roughness" defaultValue="0.7" />
		<item name="_metallic" defaultValue="0" />
		<item name="_albedoMap" assetPath="game/empty/automation/desktop/editor/playreload/probe.dds" />
	</_properties>
</MaterialDef>
