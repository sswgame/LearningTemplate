<?xml version="1.0" encoding="utf-8"?>
<!--
  머티리얼 파라미터 묶음 — 런타임에 묶음의 값 하나를 바꾸면 그 값을 묶은 다른 머티리얼 둘(왼쪽 · 오른쪽 상자)의 그림이 함께 바뀐다(언리얼 Material Parameter Collection).
  값은 머티리얼 데이터로 다시 패킹되므로 슬롯 · 바인딩이 그대로다 — 네 백엔드가 같은 길이다. 같은 실행의 두 장을 영역마다 견주며 골든은 두지 않는다.
  실행: ctest -R Scenario.game.empty.matparamcollection (Shipping 은 개발 명령이 없어 건너뛴다)
-->
<Scenario name="game.empty.matparamcollection" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/matparamcollection.scene.xml"/>
	<Launch variable="gv_deferredShading" value="0"/>
	<Launch variable="gv_postQuality" value="2"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="matparam_before.ppm"/>
	<DevCommand line="matparam game/empty/materials/matparams/world.matparams.xml WorldTint 0.1 0.2 0.9 1"/>
	<Wait frames="10"/>
	<Screenshot file="matparam_after.ppm"/>
	<Wait frames="2"/>
	<ExpectImagesDiffer first="matparam_before.ppm" second="matparam_after.ppm" region="0.2,0.3,0.45,0.7" minDiffering="0.2"/>
	<ExpectImagesDiffer first="matparam_before.ppm" second="matparam_after.ppm" region="0.55,0.3,0.8,0.7" minDiffering="0.2"/>
	<Pass/>
</Scenario>
