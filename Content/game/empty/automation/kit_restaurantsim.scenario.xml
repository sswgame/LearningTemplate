<!--
  장르 키트 시연 — 식당 키트(GF_RestaurantSim)의 하루 영업: 요리사 · 서버(급여 각 10), 면 둘(원가 각 5), 라멘(40) 메뉴로 문을 열고 손님 둘을 들여 60 분 → 닫고 결산.
  손님 둘 모두 계산 → 매출 80, 팁 0(팁 비율 0), 이익 80 - 재료비 10 - 급여 20 = 50.
  감시 값: KitDemo.RestaurantSim.State(0 시작 전, 1 마침) · .Served · .Revenue · .Profit.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.kit_restaurantsim" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/kit_restaurantsim.scene.xml"/>
	<WaitUntil watch="KitDemo.RestaurantSim.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.RestaurantSim.Served" equals="2"/>
	<Expect watch="KitDemo.RestaurantSim.Revenue" equals="80"/>
	<Expect watch="KitDemo.RestaurantSim.Profit" equals="50"/>
	<ExpectLog id="KitDemo.RestaurantSimDone" count="1"/>
	<Pass/>
</Scenario>
