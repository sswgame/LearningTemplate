<?xml version="1.0" encoding="utf-8"?>
<!--
  씬 활성화는 GPU 를 기다리지 않는다 — 옛 씬의 자원은 지연 해제(`releaseHandle` · 해제 큐)가 GPU 뒤로 미루고, 새 씬은 렌더 스레드만 비운 채 자원을 올린다(`IRHIDevice::flushRenderThread`).
  rendertest3d 에서 fogshowcase 로 바꾸는 동안 GPU 대기 누계(RHI.GPUIdleWaits)가 그대로인지 본다. 웹 백엔드는 GPU 를 동기로 기다릴 수 없어 이 길만 남는다. 에셋 핫 리로드는 editor/assetcascade 가 같은 값을 본다.
  실행: ctest -R Scenario.game.empty.noidlewait
-->
<Scenario name="game.empty.noidlewait" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/rendertest3d.scene.xml"/>
	<Wait frames="2"/>
	<Store watch="RHI.GPUIdleWaits" as="beforeLoad"/>
	<LoadScene path="game/empty/maps/fogshowcase.scene.xml" timeoutFrames="600"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.ObjectCount" atLeast="1" timeoutFrames="60"/>
	<Wait frames="10"/>
	<Expect watch="RHI.GPUIdleWaits" sameAs="beforeLoad"/>
	<Pass/>
</Scenario>
