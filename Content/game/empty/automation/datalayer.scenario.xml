<?xml version="1.0" encoding="utf-8"?>
<!--
  데이터 레이어 — Winter 레이어의 Snow 는 처음에 오르지 않고, `scene.layer Winter on` 으로 오른다. 같은 실행의 두 장을 견주는 음성 대조다(`ExpectImagesDiffer`) — 레이어가 오브젝트를 올리지 않으면 진다.
  무대는 내부 씬을 앵커로 두 번 넣은 씬이라(datalayer.scene.xml) 씬 인스턴스가 펼쳐져 그려지는 것도 지난다. 끄면 다시 첫 그림으로 돌아오므로 세 번째 장은 두 번째 장과 다르다.
  실행: ctest -R Scenario.game.empty.datalayer
-->
<Scenario name="game.empty.datalayer" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/datalayer.scene.xml"/>
	<Launch variable="gv_deferredShading" value="0"/>
	<Launch variable="gv_postQuality" value="2"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Launch variable="gv_viewDistanceScale" value="1"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="datalayer_off.ppm"/>
	<DevCommand line="scene.layer Winter on"/>
	<Wait frames="5"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="datalayer_on.ppm"/>
	<DevCommand line="scene.layer Winter off"/>
	<Wait frames="15"/>
	<Screenshot file="datalayer_off_again.ppm"/>
	<Wait frames="2"/>
	<ExpectImagesDiffer first="datalayer_off.ppm" second="datalayer_on.ppm" region="0.25,0.2,0.5,0.6" minDiffering="0.02"/>
	<ExpectImagesDiffer first="datalayer_on.ppm" second="datalayer_off_again.ppm" region="0.25,0.2,0.5,0.6" minDiffering="0.02"/>
	<Pass/>
</Scenario>
