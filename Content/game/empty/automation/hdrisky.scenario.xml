<?xml version="1.0" encoding="utf-8"?>
<!--
  HDRI 하늘(SkyMode::Hdri, sky.hlsl evaluateHdri) — 낮 HDRI 와 밤 HDRI 를 레이어로 갈아 끼우면 하늘 그림이 달라진다. 텍스처가 걸리지 않으면 두 장 다 검어서 진다(같은 실행의 두 장, 골든 없음).
  이 판정은 "달라졌다" 까지이고, 이음매 · 방향 식은 C++ 단위 테스트(SkyTest.HdriEvaluatesAmbientWithRotation)와 프리팹 생성기가 같은 식을 쓰는 것으로 묶는다.
  실행: App -scenario=game/empty/automation/hdrisky.scenario.xml -unattended (체인: ctest -R Scenario.empty)
-->
<Scenario name="game.empty.hdrisky" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/hdrisky.scene.xml"/>
	<Launch variable="gv_postQuality" value="2"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="hdri_day.ppm"/>
	<Wait frames="2"/>
	<DevCommand line="scene.layer Day off"/>
	<DevCommand line="scene.layer Night on"/>
	<Wait frames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="hdri_night.ppm"/>
	<Wait frames="5"/>
	<ExpectImagesDiffer first="hdri_day.ppm" second="hdri_night.ppm" region="0.1,0.1,0.9,0.9" minDiffering="0.5"/>
	<Pass/>
</Scenario>
