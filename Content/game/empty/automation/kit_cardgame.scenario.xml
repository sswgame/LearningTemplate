<!--
  장르 키트 시연 — 카드 게임 키트(GF_CardGame)의 덱 빌딩 전투 한 판: 공격 카드(피해 6) 다섯 장 · 에너지 3 → 첫 턴 셋(적 30 → 12) → 적 공격 5(내 체력 50 → 45) → 둘째 턴 둘로 적을 쓰러뜨려 승리.
  감시 값: KitDemo.CardGame.State(0 시작 전, 1 마침) · .Phase(1 승리) · .Turn · .PlayerHP.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.kit_cardgame" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/kit_cardgame.scene.xml"/>
	<WaitUntil watch="KitDemo.CardGame.State" equals="1" timeoutFrames="120"/>
	<Expect watch="KitDemo.CardGame.Phase" equals="1"/>
	<Expect watch="KitDemo.CardGame.Turn" equals="2"/>
	<Expect watch="KitDemo.CardGame.PlayerHP" equals="45"/>
	<ExpectLog id="KitDemo.CardGameDone" count="1"/>
	<Pass/>
</Scenario>
