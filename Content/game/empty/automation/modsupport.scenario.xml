<?xml version="1.0" encoding="utf-8"?>
<!--
  모드 지원 키트(GF_ModSupport) 시연 — 시연 모드 Test/Mods/demo_lantern 을 켜고 시작한다(`-gv_modList`). 소스 모드라 시작 때 팩으로 묶여 기본 팩 위에 올라간다.
  값으로 판정한다: 켠 모드 하나와 구성 글(mod.status), 모드가 덮어쓴 기본 리소스의 글(소스 구성에서도 낱개 파일 위에 선다), 모드가 더한 새 리소스의 글.
  짝인 modsupport_off 가 바로 다음 단계에서 모드 없이 기본 글을 읽는다 — 세션이 끝나면 모드 팩이 내려가 다음 단계에 남지 않는다.
  실행: App -scenario=game/empty/automation/modsupport.scenario.xml -unattended (체인: ctest -R Scenario.empty)
-->
<Scenario name="game.empty.modsupport" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/fogshowcase.scene.xml"/>
	<Launch variable="gv_modList" value="demo_lantern"/>
	<Wait frames="5"/>
	<ExpectLog id="ModSession.Applied" contains="Mods applied: 1 [demo_lantern@1.0.0#" atLeast="1"/>
	<WaitUntil watch="Mods.ActiveCount" equals="1" timeoutWallSeconds="10"/>
	<DevCommand line="mod.status"/>
	<ExpectLog id="DevCommand.Reply" contains="mods: 1 active [demo_lantern@1.0.0#" atLeast="1"/>
	<DevCommand line="mod.read game/empty/data/mods/welcome.xml"/>
	<ExpectLog id="DevCommand.Reply" contains="Lantern mod welcome" atLeast="1"/>
	<DevCommand line="mod.read mods/demo_lantern/data/lantern.xml"/>
	<ExpectLog id="DevCommand.Reply" contains="color=&quot;amber&quot;" atLeast="1"/>
	<!-- 넷 세션 와이어 버전 · 세이브 머리가 이 구성 해시를 싣는다(혼자 하는 실행이라 세션은 열리지 않는다 — 단위 테스트 GameStateSnapshotTest.HeaderCarriesTheContentConfiguration) -->
	<!-- 배포 형태로 묶기: Saved/ModPacks/demo_lantern/(mod.xml + content.pack) — 배포 패키지(Scripts/package/pack.py --mods demo_lantern)가 여기서 베낀다 -->
	<DevCommand line="mod.pack demo_lantern"/>
	<ExpectLog id="ModSession.Exported" contains="Mod 'demo_lantern' packed for shipping" count="1"/>
	<Wait frames="1"/>
	<Pass/>
</Scenario>
