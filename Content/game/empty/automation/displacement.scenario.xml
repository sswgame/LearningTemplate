<?xml version="1.0" encoding="utf-8"?>
<!--
  머티리얼 변위(MATERIAL_DISPLACEMENT) — 체커 높이 맵으로 칸이 솟은 판의 먼 가장자리가 계단 윤곽이 된다(헐 · 도메인 변형, material_displacement.hlsli).
  같은 실행의 두 장을 견주는 음성 대조다 — 변위가 윤곽(판 위쪽 띠)을 바꾸지 않으면 진다. 바뀐 그림은 골든으로도 지킨다. 그림자 · 깊이 프리패스도 같은 변위로 그린다(그림자 켬).
  머티리얼 테셀레이션이 없는 백엔드(OpenGL · WebGPU — RHICapabilities::_bMaterialTessellation)는 변위 판을 그리지 않고 오류를 남기는 것이 규칙이라 이 시나리오를 건너뛴다.
  실행: ctest -R Scenario.empty
-->
<Scenario name="game.empty.displacement" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/displacement_flat.scene.xml"/>
	<Launch variable="gv_deferredShading" value="0"/>
	<Launch variable="gv_renderScale" value="1"/>
	<Launch variable="gv_viewDistanceScale" value="1"/>
	<SkipUnless watch="RHI.MaterialTessellation" reason="this backend declares no material tessellation - displaced materials are not drawn (FramePSOManager.DisplacementUnsupported)"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="10"/>
	<Screenshot file="displacement_off.ppm"/>
	<LoadScene path="game/empty/maps/displacement.scene.xml" timeoutFrames="600"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.ObjectCount" atLeast="1" timeoutFrames="60"/>
	<Wait frames="20"/>
	<Screenshot file="displacement_on.ppm"/>
	<Wait frames="2"/>
	<ExpectLog id="FramePSOManager.DisplacementUnsupported" count="0"/>
	<ExpectImagesDiffer first="displacement_off.ppm" second="displacement_on.ppm" region="0,0.25,1,0.5" minDiffering="0.02"/>
	<ExpectImage file="displacement_on.ppm" golden="displacement"/>
	<Pass/>
</Scenario>
