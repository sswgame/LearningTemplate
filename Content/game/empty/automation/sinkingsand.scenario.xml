<?xml version="1.0" encoding="utf-8"?>
<!--
  모래 함몰 구역(SinkingSandZoneComponent) — 무대 maps/surfaceinteraction 의 Quicksand(가운데 8,0 · 반 크기 1.5 × 2.5, 빠짐 0.2 m/s, 최대 0.9 m, 뛰면 0.3 m, 바닥에 2 초면 삼켜짐).
  ① 모래 패드 가장자리(8,0,2.8 — 구역 밖, Sand 표면): 단계 None · 이동 계수 Sand 0.85(단순 모래는 함몰 상태가 없다). ② 구역 안: 깊이가 오르고 이동 계수가 깊이로 준다(같은 상태).
  ③ character.jump 두 번: 탈출 수 2, 깊이가 준다. ④ 구역을 나가면 상태가 사라진다(깊이 0, 메시는 원래 자리). ⑤ 다시 들어가 바닥에 머물면 Engulfed, 이동 계수 0.
  값으로 판정한다(골든 없음). 실행: App -scenario=game/empty/automation/sinkingsand.scenario.xml -unattended (체인: ctest -R Scenario.empty)
-->
<Scenario name="game.empty.sinkingsand" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/surfaceinteraction.scene.xml"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="object.place Walker 8 0.05 2.8"/>
	<Wait frames="30"/>
	<Expect watch="SinkingSand.Phase" target="Walker" is="None"/>
	<Expect watch="Surface.GroundKind" target="Walker" is="Sand"/>
	<Expect watch="Surface.MoveScale" target="Walker" near="0.85" tolerance="0.01"/>

	<DevCommand line="object.place Walker 8 0.05 0"/>
	<Wait frames="90"/>
	<Expect watch="SinkingSand.Phase" target="Walker" is="Sinking"/>
	<Expect watch="SinkingSand.Depth" target="Walker" near="0.3" tolerance="0.06"/>
	<Expect watch="Surface.MoveScale" target="Walker" atMost="0.75"/>

	<DevCommand line="character.jump Walker 4"/>
	<WaitUntil watch="SinkingSand.Escapes" target="Walker" equals="1" timeoutSeconds="1"/>
	<Wait frames="60"/>
	<DevCommand line="character.jump Walker 4"/>
	<WaitUntil watch="SinkingSand.Escapes" target="Walker" equals="2" timeoutSeconds="1"/>
	<Expect watch="SinkingSand.Depth" target="Walker" atMost="0.3"/>

	<DevCommand line="object.place Walker -3 0.05 0"/>
	<Wait frames="30"/>
	<Expect watch="SinkingSand.Phase" target="Walker" is="None"/>
	<Expect watch="SinkingSand.Depth" target="Walker" equals="0"/>

	<DevCommand line="object.place Walker 8 0.05 0"/>
	<WaitUntil watch="SinkingSand.Phase" target="Walker" is="Engulfed" timeoutSeconds="8"/>
	<Expect watch="SinkingSand.Depth" target="Walker" near="0.9" tolerance="0.01"/>
	<Wait frames="2"/>
	<Expect watch="Surface.MoveScale" target="Walker" equals="0"/>
	<Pass/>
</Scenario>
