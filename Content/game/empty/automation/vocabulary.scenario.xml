<?xml version="1.0" encoding="utf-8"?>
<!--
  공통 어휘 — 행동 트리 · 스케줄 · 대화가 같은 조건(`flag`)과 같은 동작(`flag.set` · `flag.add`)을 한 플래그 표 위에서 쓴다.
  행동 트리가 경보를 켜고(alarm=1), 스케줄은 경보가 켜진 날에만 문으로 가서 도착할 때 visits 를 올리며(visits=1), 대화는 둘을 모두 본 뒤 보고를 남긴다(reported=1).
  셋 중 하나라도 어휘를 따로 가지면 앞 단계의 값을 보지 못해 뒤 값이 0 으로 남는다. 그림은 보지 않는다(골든 없음).
  실행: ctest -R Scenario.game.empty.vocabulary
-->
<Scenario name="game.empty.vocabulary" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/rendertest3d.scene.xml"/>
	<Wait frames="2"/>
	<DevCommand line="vocabulary.check game/empty/data/vocabulary"/>
	<Expect watch="Vocabulary.Flag" key="alarm" equals="1"/>
	<Expect watch="Vocabulary.Flag" key="visits" equals="1"/>
	<Expect watch="Vocabulary.Flag" key="reported" equals="1"/>
	<Pass/>
</Scenario>
