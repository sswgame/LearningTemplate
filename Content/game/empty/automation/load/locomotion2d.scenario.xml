<?xml version="1.0" encoding="utf-8"?>
<!--
  부하 시나리오 — 2D 이동 블렌드 스페이스(9 표본, common/data/anim/ubc_locomotion2d.animgraph.xml)를 쓰는 Quaternius 마을 사람 500 명(25 열 격자).
  -gv_stressTestCharacterBlend=1 이 캐릭터마다 Speed · Posture 를 범위 안에 흩어(벤치 데이터 _characterBlend*) 표본 위가 아니라 삼각형 안을 섞게 한다.
  보는 값은 GT.Animation 의 BasePose 구간이다(삼각분할이면 캐릭터당 샘플 클립 많아야 셋). 감시 값 Animation.BlendSpaceActiveSamples 로 파라미터가 흩어졌는지(표본 위가 아닌지) 먼저 확인한다. 프리팹은 common/prefabs/quaternius/townsfolk_locomotion2d.prefab.xml 이다. 측정 창(<Load>)이 끝내므로 <Pass/> 가 없다.
  실행: ctest -L load (항목 Scenario.empty.load.locomotion2d) · App -scenario=game/empty/automation/load/locomotion2d.scenario.xml -unattended -gv_stressTestCharacters=500 -gv_stressTestCharacterColumns=25 -gv_stressTestCharacterBlend=1 -gv_stressTestCharacterPrefab=common/prefabs/quaternius/townsfolk_locomotion2d.prefab.xml
-->
<Scenario name="game.empty.load.locomotion2d" fixedDelta="0.0166667" startAfter="ScenePlaying" startTimeoutFrames="1800" input="exclusive">
	<Launch variable="gv_stressTestCharacters" value="500"/>
	<Launch variable="gv_stressTestCharacterColumns" value="25"/>
	<Launch variable="gv_stressTestCharacterBlend" value="1"/>
	<Launch variable="gv_stressTestCharacterPrefab" value="common/prefabs/quaternius/townsfolk_locomotion2d.prefab.xml"/>
	<Load durationSeconds="15"/>
	<!-- 측정이 의미 있는지 스스로 본다 — 캐릭터마다 표본 위(하나)가 아니라 삼각형 안(둘 · 셋)을 섞어야 한다: 500 명이면 평균 둘 이상(1000) · 많아야 셋(1500). -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Animation.BlendSpaceActiveSamples" atLeast="1000" timeoutFrames="300"/>
	<Expect watch="Animation.BlendSpaceActiveSamples" atLeast="1000"/>
	<Expect watch="Animation.BlendSpaceActiveSamples" atMost="1500"/>
</Scenario>
