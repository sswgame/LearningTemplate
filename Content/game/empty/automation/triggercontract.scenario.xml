<?asset guid="41bfcdf683cb402ba9030a75b548c9b0"?>
<!--
  트리거 계약 — 물리 트리거(2D 센서)의 진입 · 이탈(DesignBacklog "트리거 Enter · Stay · Exit 계약"). 무대 maps/gimmickshowcase 의 Spring(발사 발판, 트리거)과 Barrel(겹침 콜라이더).
  감시 값 Physics.OverlapCount(대상이 낀 겹침 오브젝트 쌍 수 — 진입 · 이탈과 같은 장부)로 본다: 안으로 순간 이동 → 1, 트리거 끔 → 0, 켬 → 1, 대상 끔 → 0, 켬 → 1,
  밖으로 → 0, 트리거를 건너뛰는 순간 이동 → 0 그대로(지나친 길은 이벤트 없음), 안에서 파괴(로그아웃 · 죽음) → 0. 값으로 판정한다(골든 없음).
  실행: App -scenario=game/empty/automation/triggercontract.scenario.xml -unattended
-->
<Scenario name="game.empty.triggercontract" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/gimmickshowcase.scene.xml"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Expect watch="Physics.OverlapCount" target="Spring" equals="0"/>

	<DevCommand line="object.place Barrel -4 0 3"/> <!-- 트리거 안으로 — 다음 물리 스텝에 진입 한 번 -->
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="1" timeoutFrames="10"/>

	<DevCommand line="object.active Spring 0"/> <!-- 트리거를 끈다 — 안의 대상이 나간다 -->
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="0" timeoutFrames="10"/>
	<DevCommand line="object.active Spring 1"/>
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="1" timeoutFrames="10"/>

	<DevCommand line="object.active Barrel 0"/> <!-- 대상을 끈다(유니티 함정 — 여기서는 나간다) -->
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="0" timeoutFrames="10"/>
	<DevCommand line="object.active Barrel 1"/>
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="1" timeoutFrames="10"/>

	<DevCommand line="object.place Barrel 8 0 3"/> <!-- 밖으로 -->
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="0" timeoutFrames="10"/>
	<DevCommand line="object.place Barrel -12 0 3"/> <!-- 트리거(x -4)를 건너뛰는 순간 이동 — 이벤트 없음 -->
	<AdvanceSimulation frames="5"/>
	<Expect watch="Physics.OverlapCount" target="Spring" equals="0"/>

	<DevCommand line="object.place Barrel -4 0 3"/>
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="1" timeoutFrames="10"/>
	<DevCommand line="object.destroy Barrel"/> <!-- 안에서 파괴 — 이탈 한 번 -->
	<WaitUntil watch="Physics.OverlapCount" target="Spring" equals="0" timeoutFrames="10"/>
	<Pass/>
</Scenario>
