<?xml version="1.0" encoding="utf-8"?>
<!--
  KayKit 리그 벤치의 아틀라스 색 — 후처리 리그를 건 기사 한 명(-gv_stressTestRig=1)의 몸 · 쇠뇌(_rigWeaponMaterial) · 망토(_rigCapeMaterial)가 KayKit 머티리얼로 그려지는지 눈으로 본다.
  카메라 시점(-gv_stressTestRigView)마다 한 장: 0 왼쪽 앞(시선 · 왼손 · 발) · 2 오른쪽 옆(쇠뇌 · 망토).
  실행: ctest -R Scenario.game.empty.kaykitrig (Shipping 은 벤치 변수가 없어 건너뛴다)
-->
<Scenario name="game.empty.kaykitrig" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_stressTestRig" value="1"/>
	<Wait frames="60"/>
	<Screenshot file="empty/kaykit_rig_view0.ppm"/>
	<Wait frames="10"/>
	<Variable name="gv_stressTestRigView" value="2"/>
	<Wait frames="60"/>
	<Screenshot file="empty/kaykit_rig_view2.ppm"/>
	<Wait frames="10"/>
	<!-- 그림을 골든과 견준다 — 사진만 남기면 화면이 틀려도 통과다(시점이 경사면에 막힌 view2 가 그렇게 지나갔다). -->
	<ExpectImage file="empty/kaykit_rig_view0.ppm" golden="kaykit_rig_view0"/>
	<ExpectImage file="empty/kaykit_rig_view2.ppm" golden="kaykit_rig_view2"/>
	<Pass/>
</Scenario>
