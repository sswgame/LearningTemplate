<?xml version="1.0" encoding="utf-8"?>
<!--
  VFX 변형과 사용자 파라미터 — sparks_tinted 는 _base 로 sparks 를 물려받고, 컴포넌트가 색 · 크기 파라미터를 덮으면 불꽃의 그림이 바뀐다.
  같은 실행의 두 장을 견주는 음성 대조다(`ExpectImagesDiffer`) — 칸이 그림을 바꾸지 않으면 진다. 골든은 두지 않는다.
  실행: ctest -R Scenario.game.empty.vfxvariant
-->
<Scenario name="game.empty.vfxvariant" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/vfxvariant.scene.xml"/>
	<Wait frames="20"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<Wait frames="60"/>
	<Screenshot file="vfxvariant_off.ppm" waitForStability="false"/>
	<LoadScene path="game/empty/maps/vfxvariant_tinted.scene.xml" timeoutFrames="600"/>
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Scene.ObjectCount" atLeast="1" timeoutFrames="60"/>
	<Wait frames="60"/>
	<Screenshot file="vfxvariant_on.ppm" waitForStability="false"/>
	<Wait frames="2"/>
	<ExpectImagesDiffer first="vfxvariant_off.ppm" second="vfxvariant_on.ppm" region="0.2,0,0.8,0.8" minDiffering="0.005"/>
	<Pass/>
</Scenario>
