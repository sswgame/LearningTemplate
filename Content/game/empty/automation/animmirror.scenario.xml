<?asset guid="9d1c20dc99659c054fba32394081534e"?>
<!--
  포즈 노드 Mirror — 같은 자리(원점, Y 로 반 바퀴)의 기사 둘이 같은 프레임에 조준(1h_ranged_aiming — 한 손이 앞으로 나온 비대칭 자세)과 그 미러 상태(AimMirrored)를 시작한다.
  미러는 짝 본(스켈레톤 옆 common/models/kaykit/knight.mirrortable.xml)의 포즈를 모델 공간 X 면으로 비추므로, 미러 기사의 왼손 월드 X 는 조준 기사의 오른손 월드 X 의 부호만 바뀐 값이고 오른손도 같다.
  시간을 멈춰(gv_timeScale=0) 두 기사의 포즈를 한 순간에 고정한 뒤 본 X(감시 값 Animation.BoneX)를 기억해 견준다(oppositeOf — 부호를 뒤집은 값과 허용 폭 안).
  조준 자세는 두 손이 거울상이 아니어야 판정이 미러를 가른다(대칭 자세면 미러가 없어도 지난다) — 그래서 한 손이 앞으로 나온 조준 클립을 쓴다.
  실행: App -scenario=game/empty/automation/animmirror.scenario.xml -unattended (체인: ctest -R Scenario.game.empty.animmirror)
-->
<Scenario name="game.empty.animmirror" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/animmirror.scene.xml"/>
	<Launch variable="gv_deferredShading" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<AdvanceSimulation frames="30"/> <!-- 멈추기 전 애니메이션 시각(결정적 자세) -->
	<Variable name="gv_timeScale" value="0"/>
	<AdvanceSimulation frames="1"/> <!-- 시간 배율 0 이 먹은 뒤에 뼈를 읽는다(프레임 경계) -->
	<Store watch="Animation.BoneX" target="KnightAim" key="hand.l" as="aimLeft"/>
	<Store watch="Animation.BoneX" target="KnightAim" key="hand.r" as="aimRight"/>
	<Expect watch="Animation.BoneX" target="KnightMirrored" key="hand.l" oppositeOf="aimRight" tolerance="0.002"/>
	<Expect watch="Animation.BoneX" target="KnightMirrored" key="hand.r" oppositeOf="aimLeft" tolerance="0.002"/>
	<Pass/>
</Scenario>
