<?asset guid="568ac94dcbee401eb56bc01fec12dcb8"?>
<!--
  그리지 않는 진행(AdvanceSimulation)이 그리며 진행한 것과 같은 게임 상태를 내는지 — 2D 물리 묶음(캐릭터 낙하 · 힌지 판 · 시한 폭탄 상자)을 두 번 연다.
  첫 길은 <Wait> 로 120 프레임을 그리며 흘리고 씬 변환 해시를 담는다. 둘째 길은 같은 씬을 다시 열어 <AdvanceSimulation> 으로 같은 120 프레임을 흘리고 해시가 같은지 본다.
  두 길은 같은 단계 · 같은 프레임 수다(씬 열기는 설 때까지 붙잡는다 — 붙잡은 프레임은 두 길이 같다). <Wait> 를 지울 때 첫 길은 그리는 진행 단계로 바꾼다.
  실행: ctest -R Scenario.empty · App -scenario=game/empty/automation/advancesimulation.scenario.xml -unattended
-->
<Scenario name="game.empty.advancesimulation" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/empty/maps/twodphysics.scene.xml"/>
	<Launch variable="gv_renderPipeline" value="engine/pipeline/forward2dpipeline.xml"/>
	<!-- 첫 길: 그리며 진행 -->
	<LoadScene path="game/empty/maps/twodphysics.scene.xml" timeoutFrames="600"/>
	<Wait frames="120"/>
	<Store watch="Scene.TransformHash" as="drawn"/>
	<!-- 둘째 길: 같은 씬을 다시 열어 그리지 않고 진행 -->
	<LoadScene path="game/empty/maps/twodphysics.scene.xml" timeoutFrames="600"/>
	<AdvanceSimulation frames="120"/>
	<Expect watch="Scene.TransformHash" sameAs="drawn"/>
	<Pass/>
</Scenario>
