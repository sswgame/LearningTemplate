<!--
	Shooter3D 사운드 이벤트(AudioEventLibrary). 게임 코드는 이벤트 이름만 안다 — 클립 · 범위 · 상한은 여기서 정한다.
	플레이어 자신의 소리(착지 · 명중 확인음)는 2D, 적 처치는 그 자리에서 3D(Default 감쇠 · 벽 뒤 가림).
-->
<AudioEventLibrary>
	<_listEvent>
		<AudioEventDef _name="Land"
		                _bus="sfx"
		                _container="Random"
		                _priority="40"
		                _cooldownSeconds="0.15"
		                _maxInstances="2"
		                _steal="Oldest"
		                _volumeDbMin="-4"
		                _volumeDbMax="0"
		                _pitchMin="-1.5"
		                _pitchMax="1">
			<_listClip>
				<AudioClipEntry _path="game/shooter3d/sounds/footstep_concrete_000.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="HitEnemy"
		                _bus="sfx"
		                _container="Random"
		                _priority="55"
		                _cooldownSeconds="0.03"
		                _maxInstances="4"
		                _steal="Oldest"
		                _volumeDbMin="-3"
		                _volumeDbMax="0"
		                _pitchMin="-2"
		                _pitchMax="2">
			<_listClip>
				<AudioClipEntry _path="game/shooter3d/sounds/impact_metal_light_001.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="HitCover"
		                _bus="sfx"
		                _container="Random"
		                _priority="45"
		                _cooldownSeconds="0.03"
		                _maxInstances="4"
		                _steal="Oldest"
		                _volumeDbMin="-5"
		                _volumeDbMax="-1"
		                _pitchMin="-2"
		                _pitchMax="2">
			<_listClip>
				<AudioClipEntry _path="game/shooter3d/sounds/impact_plank_medium_000.ogg" />
			</_listClip>
		</AudioEventDef>
		<AudioEventDef _name="EnemyDown"
		                _bus="sfx"
		                _attenuation="Default"
		                _container="Layer"
		                _priority="60"
		                _maxInstances="6"
		                _steal="Farthest"
		                _volumeDbMin="-2"
		                _volumeDbMax="0"
		                _pitchMin="-3"
		                _pitchMax="0"
		                _virtual="Stop">
			<_listClip>
				<AudioClipEntry _path="game/shooter3d/sounds/impact_metal_medium_000.ogg" />
				<AudioClipEntry _path="game/shooter3d/sounds/impact_metal_light_001.ogg" _volumeDb="-8" />
			</_listClip>
		</AudioEventDef>
		<!-- 아레나 환경음(AudioAmbientEmitterComponent) — 루프. 영역 소리는 ambient 버스로 간다. 발전기 쪽은 같은 소리를 점에서 낸다(벽 뒤 가림). -->
		<AudioEventDef _name="ArenaHum"
		                _bus="ambient"
		                _attenuation="Default"
		                _priority="20"
		                _maxInstances="2"
		                _steal="Farthest"
		                _volumeDbMin="-16"
		                _volumeDbMax="-16"
		                _bLoop="true">
			<_listClip>
				<AudioClipEntry _path="common/sounds/kenney_scifi_sounds/thruster_fire_000.ogg" />
			</_listClip>
		</AudioEventDef>
	</_listEvent>
</AudioEventLibrary>
