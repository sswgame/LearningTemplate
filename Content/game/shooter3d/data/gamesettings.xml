<?xml version="1.0" encoding="utf-8"?>
<!-- Shooter3D 팩의 설정 — 시작 맵은 아레나 씬이다(게임마다 팩의 data/gamesettings.xml 하나다).
     inputMap 줄들은 입력 맵 묶음이다 — 기본 맵, 공통 파일들, 맨 끝이 게임 차이다(docs/InputMapBundle.md). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Shooter 3D" _userSettingsSchema="game/shooter3d/data/shooter3d.settings.xml" _telemetrySchema="game/shooter3d/data/shooter3d.telemetry.xml" _bUIPauseMenu="true">
    <_mapUserSettingDefault>
      <entry key="gameplay.fieldOfView">80</entry>
    </_mapUserSettingDefault>
  </Engine>
  <startMap>game/shooter3d/maps/arena.scene.xml</startMap>
  <!-- 온라인 세션(OnlineSession) — 연결은 게임이 connect 로 연다. 서버 설정은 Config/Server/Online/Shooter3D.json -->
  <onlineServerAddress>127.0.0.1:17793</onlineServerAddress>
  <onlineGameBuild>1.0.0</onlineGameBuild>
  <!-- 플레이어 통계 · 업적(PlayerStatsSubsystem) — 업적은 로컬 플랫폼 서비스(SDK 없음)까지 간다 -->
  <statCatalog>game/shooter3d/data/shooter3d.stats.xml</statCatalog>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/move.input.xml"/>
  <inputMap path="common/input/traversal.input.xml"/>
  <inputMap path="common/input/look.input.xml"/>
  <inputMap path="common/input/camera.input.xml"/>
  <inputMap path="common/input/cameraorbit.input.xml"/>
  <inputMap path="game/shooter3d/data/shooter.input.xml"/>
  <localizationProject>game/shooter3d/data/localization/shooter3d.locproject.xml</localizationProject>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/shooter3d/audio/shooter3d.audioevents.xml</audioEvents>
  <!-- 아이템 · 외형은 캐릭터 키트와 함께 공용 팩(common)에 있다 — 자리는 등록 줄의 팩 안 규칙(common/data/items.xml · common/data/appearance) -->
  <RequiredData kind="items" pack="common"/>
  <RequiredData kind="appearance" pack="common"/>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
