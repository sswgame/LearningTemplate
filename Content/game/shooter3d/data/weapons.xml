<?xml version="1.0" encoding="utf-8"?>
<!-- Shooter3D 의 무기 — 쏘는 법만 적는다. 속성 이름은 WeaponDef 의 필드 이름이다(빠진 것은 기본값). 각도는 도, 시간은 초.
     날아가는 것(피해 · 사거리 · 궤적)은 탄 표(projectiles.xml)다. projectile 은 기본으로 장전하는 탄이고, accepts 는 받는 탄의 태그 조건이다(그냥 이름은 태그).
     item 은 무기를 나타내는 장비 아이템(items.xml)의 id 다. 표시 이름과 외형은 그 아이템이 정하므로 여기에는 name 을 적지 않는다(원본이 하나다).
     퍼짐은 쏠 때마다 spreadPerShot 만큼 커져 maxSpread 에서 멈추고 초당 spreadRecovery 만큼 minSpread 로 돌아온다. -->
<!-- twoHanded 는 아직 켜지 않는다: 구운 두 손 조준 클립(ubc_2h_ranged_aiming)이 UBC 에서 조준 자세가 아니다(왼손이 앞손잡이를 놓고 펴진다 · 1 인칭 하체가 빠진다 —
     shooter3d autoplay · bodyviews 골든이 5~11% 졌다). 리타깃 팔 사슬을 고친 뒤 소총 · 산탄총에 켜고 골든을 다시 뜬다(docs/NEXT.md). -->
<WeaponCatalog>
  <Weapon id="rifle" item="scifi_rifle" projectile="rifle_round" accepts="Ammo.Rifle" fireInterval="0.095" reloadTime="1.9" minSpread="0.4" maxSpread="3.5"
          spreadPerShot="0.45" spreadRecovery="7" recoilPitch="0.55" magazineSize="30" maxReserveAmmo="240" pelletCount="1" automatic="true"/>
  <Weapon id="shotgun" item="scifi_shotgun" projectile="buckshot" accepts="Ammo.Shell" fireInterval="0.85" reloadTime="2.4" minSpread="5" maxSpread="6.5"
          spreadPerShot="1.5" spreadRecovery="4" recoilPitch="3.2" magazineSize="6" maxReserveAmmo="36" pelletCount="9" automatic="false"/>
  <Weapon id="pistol" item="scifi_pistol" projectile="pistol_round" accepts="Ammo.Pistol" fireInterval="0.16" reloadTime="1.3" minSpread="0.2" maxSpread="2.2"
          spreadPerShot="0.8" spreadRecovery="6" recoilPitch="1.1" magazineSize="12" maxReserveAmmo="96" pelletCount="1" automatic="false"/>
</WeaponCatalog>
