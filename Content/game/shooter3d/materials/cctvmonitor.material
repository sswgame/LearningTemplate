<?xml version="1.0" encoding="utf-8"?>
<!-- CCTV 모니터 화면 — 알베도가 렌더 텍스처(rendertarget/shooter_cctv)다. CctvCamera 의 캡처 카메라가 그 텍스처에 10 Hz 로 그린다.
     셰이더는 게임 도메인의 cctvmonitor.hlsl 이다 — 빛을 받지 않는 화면에 가로 주사선을 겹친다. 프로퍼티는 그 셰이더의 머티리얼 구조체와 이름 · 순서가 같다. -->
<MaterialDesc formatVersion="0" name="ShooterCctvMonitor" shaderPath="game/shooter3d/shaders/cctvmonitor.hlsl" blendMode="Opaque">
	<_properties>
		<item name="_color" type="Color" shaderType="Float4" defaultValue="1.0 1.0 1.0 1.0" displayName="Screen Tint" group="Surface" bHdr="0" bSrgb="1"/>
		<item name="_albedoMap" type="Texture2D" assetPath="rendertarget/shooter_cctv" displayName="Screen" group="Surface" bSrgb="1"/>
		<item name="_scanlineCount" type="Range" shaderType="Float" defaultValue="90.0" min="1.0" max="400.0" displayName="Scanline Count" group="Screen"/>
		<item name="_scanlineStrength" type="Range" shaderType="Float" defaultValue="0.35" min="0.0" max="1.0" displayName="Scanline Strength" group="Screen"/>
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
