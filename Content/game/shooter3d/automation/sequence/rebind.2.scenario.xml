<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 키 다시 잡기 두 번 기동 ② — rebind.1 이 남긴 사용자 설정 파일로 새로 기동했을 때 점프 키가 J 로 남아 있다: J 는 점프하고 Space 는 점프하지 않으며 패드 A 는 그대로다.
  설정은 바꾸지 않는다(첫 단언이 파일에서 읽은 값을 본다). 끝에서 Space 로 되돌린다. 혼자 돌면 ① 이 없어 진다 — CTest 항목 Scenario.shooter3d.sequence.rebind 로만 돈다.
  "Space 는 점프하지 않는다" 는 일어나지 않음을 보는 단언이라 고정 대기 뒤에 본다.
  (예전 이름 rebindrestart — 쌍 규칙 <묶음>.1 · .2 에 맞춰 바꿨다)
-->
<Scenario name="game.shooter3d.rebind.2" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<!-- 파일에서 읽은 J 가 점프한다. -->
	<Wait frames="12"/>
	<Tap slot="Key.J" hold="1"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<Wait frames="10"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/>
	<!-- 기본 키 Space 는 점프하지 않는다. -->
	<Wait frames="2"/>
	<Tap slot="Key.Space" hold="1"/>
	<Wait seconds="0.2"/>
	<Expect watch="Object.Y" target="Player" atMost="1.65"/>
	<!-- 같은 액션의 패드 바인딩(A)은 그대로다. -->
	<Wait frames="2"/>
	<Action name="Jump" device="gamepad"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<Wait frames="10"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/>
	<Wait frames="2"/>
	<DevCommand line="settings.apply controls.jump=Key.Space"/>
	<Pass/>
</Scenario>
