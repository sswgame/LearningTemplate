<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 키 다시 잡기 두 번 기동 ① — 점프 키를 J 로 바꿔 사용자 설정 파일에 남기고 끝낸다(설정을 되돌리지 않는다).
  ② rebind.2 가 같은 설정 파일로 다시 기동해 J 가 남았는지 본다. 혼자 돌면 ② 의 전제를 만들 뿐이라 게임 체인은 이 폴더(sequence/)를 줍지 않는다.
  CTest 항목 Scenario.shooter3d.sequence.rebind 가 빈 폴더의 설정 파일(-gv_userSettingsFile)로 ① → ② 를 잇는다(Test/Scenario/RunStateDirPair.cmake).
  (예전 이름 rebindsave — 쌍 규칙 <묶음>.1 · .2 에 맞춰 바꿨다)
-->
<Scenario name="game.shooter3d.rebind.1" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<DevCommand line="settings.apply controls.jump=Key.J"/>
	<Wait frames="12"/>
	<Tap slot="Key.J" hold="1"/>
	<WaitUntil watch="Object.Y" target="Player" atLeast="1.9" timeoutSeconds="0.1"/>
	<Wait frames="10"/>
	<WaitUntil watch="Object.Y" target="Player" atMost="1.61" timeoutSeconds="1"/>
	<Wait frames="2"/>
	<Pass/>
</Scenario>
