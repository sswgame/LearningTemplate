<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 사격 — 플레이어의 클릭이 사격으로 이어진다(서브틱 입력: 폰의 `_triggerLookButton`(Fire)이 눌린 틱의 의도가 발동 시선을 싣고 `ShooterPlayerComponent` 가 그 방향으로 쏜다).
  자동 플레이를 끄고 왼쪽 버튼을 한 프레임 눌러 `Shooter3D.ShotCount` 가 정확히 하나 늘고, 길게 눌러도(연사 소총) 계속 쏘는지 본다. 방향 계산 자체는 `ControlTest.TriggerLookCarriesTheControlRotationAtTheClick` 가 본다.
  실행: App -scenario=game/shooter3d/automation/firelook.scenario.xml -unattended (체인: ctest -R Scenario.shooter3d)
-->
<Scenario name="game.shooter3d.firelook" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<Expect watch="Shooter3D.ShotCount" equals="0"/>
	<Wait frames="20"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<WaitUntil watch="Shooter3D.ShotCount" equals="1" timeoutFrames="10"/>
	<!-- 한 프레임 누름은 한 발이다 — 더 쏘지 않는지 보려면 프레임이 흘러야 한다 -->
	<Wait frames="10"/>
	<Expect watch="Shooter3D.ShotCount" equals="1"/>
	<Tap slot="Mouse.Left" hold="30"/>
	<WaitUntil watch="Shooter3D.ShotCount" atLeast="3" timeoutFrames="50"/>
	<Expect watch="Shooter3D.PlayerAlive" equals="1"/>
	<Pass/>
</Scenario>
