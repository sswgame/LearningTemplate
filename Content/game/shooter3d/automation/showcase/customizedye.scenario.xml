<?xml version="1.0" encoding="utf-8"?>
<?asset guid="5bc2cf1a09a943aca535de4db4ab82aa"?>
<!--
  게임 중 꾸미기 ③ 염색 · 프리셋 저장 — 무대 maps/customizationshowcase 의 Hero(부품을 합침)와 Twin(부품 그대로)이 같은 머리 모양 · 같은 머티리얼(hair_1)을 입는다.
  ⑴ 같은 아이템을 두 캐릭터가 다른 색으로(머티리얼 인스턴스가 공유돼 서로 번지지 않는가 — 머리 영역 두 곳이 다르고 값도 따로다),
  ⑵ 머리 모양을 바꿨다 되돌려도, 투구를 썼다 벗어도 색이 남는다(사진이 염색 직후와 같다), 같은 차림으로 되돌리면 구운 메시 캐시가 적중한다,
  ⑶ 프리셋 저장 · 불러오기 왕복(공유 코드 — 플레이어 프리셋 저장소의 형식): 저장한 뒤 바꾸고(앞 사진과 다른지 먼저 본다 — 거짓 통과 막기) 불러오면 값과 사진이 저장 때와 같다.
  왕복 사이에는 꾸미기 값만 바꾼다 — 슬롯 덮어쓰기(setSlotItem · 무기 표)는 게임이 정하는 층이라 선택보다 위에 남는다.
  골든은 통합 담당이 뜬다(-scenario-record-missing-golden).
  실행: App -scenario=game/shooter3d/automation/showcase/customizedye.scenario.xml -unattended
-->
<Scenario name="game.shooter3d.customizedye" fixedDelta="0.0166667" timeoutFrames="2400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/shooter3d/maps/customizationshowcase.scene.xml"/>
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="dye_base.ppm"/>

	<!-- ⑴ 같은 머리 모양, 다른 색 -->
	<DevCommand line='exec Hero applyColorValue HairRoot "0.9 0.15 0.1 1"'/>
	<DevCommand line='exec Hero applyColorValue HairTip "0.95 0.6 0.1 1"'/>
	<DevCommand line='exec Twin applyColorValue HairRoot "0.1 0.2 0.9 1"'/>
	<DevCommand line='exec Twin applyColorValue HairTip "0.3 0.8 0.95 1"'/>
	<WaitUntil watch="Appearance.Value" target="Twin" key="HairTip.g" near="0.8" tolerance="0.01" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.r" near="0.9" tolerance="0.01"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.b" near="0.1" tolerance="0.01"/>
	<Expect watch="Appearance.Value" target="Twin" key="HairRoot.r" near="0.1" tolerance="0.01"/>
	<Expect watch="Appearance.Value" target="Twin" key="HairRoot.b" near="0.9" tolerance="0.01"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="dye_split.ppm"/>
	<ExpectImage file="dye_split.ppm" golden="dye_split"/>
	<ExpectImage file="dye_split.ppm" golden="dye_split_hero" region="0.25,0.28,0.33,0.45"/>
	<ExpectImage file="dye_split.ppm" golden="dye_split_twin" region="0.46,0.28,0.54,0.45"/>
	<!-- 두 머리가 모두 처음과 달라졌다 — 한쪽 색이 다른 쪽 인스턴스에 덮였으면 한 영역은 처음 그대로이거나 둘이 같은 색이 된다 -->
	<ExpectImagesDiffer first="dye_base.ppm" second="dye_split.ppm" region="0.25,0.28,0.33,0.45" minDiffering="0.01"/>
	<ExpectImagesDiffer first="dye_base.ppm" second="dye_split.ppm" region="0.46,0.28,0.54,0.45" minDiffering="0.01"/>
	<!-- 해골(다른 머티리얼)은 그대로다 -->
	<ExpectImagesDiffer first="dye_base.ppm" second="dye_split.ppm" region="0.62,0.25,0.82,0.75" minDiffering="0" maxDiffering="0.002"/>

	<!-- ⑵ 머리 모양을 바꿨다 되돌려도 색이 남고, 같은 차림이라 캐시가 적중한다 -->
	<Store watch="Appearance.BakedMeshHits" as="hitsBeforeReturn"/>
	<DevCommand line="exec Hero applyOptionValue Hair Buzzed"/>
	<WaitUntil watch="Appearance.Value" target="Hero" key="Hair" is="Buzzed" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<DevCommand line="exec Hero applyOptionValue Hair SimpleParted"/>
	<WaitUntil watch="Appearance.Value" target="Hero" key="Hair" is="SimpleParted" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.BakedMeshHits" increaseFrom="hitsBeforeReturn" increaseBy="1"/>
	<Expect watch="Appearance.BakedMeshEntries" atLeast="2"/> <!-- 두 머리 모양의 차림을 함께 쥔다(되돌린 차림을 다시 굽지 않았다) -->
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.r" near="0.9" tolerance="0.01"/>
	<!-- 투구를 썼다 벗는다(투구가 머리카락을 감췄다 돌려준다) -->
	<DevCommand line="exec Hero setSlotItem Head helmet_knight"/>
	<WaitUntil watch="Appearance.PartCount" target="Hero" key="Hair" equals="1" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<DevCommand line="exec Hero setSlotItem Head"/>
	<WaitUntil watch="Appearance.PartCount" target="Hero" key="Hair" equals="2" timeoutFrames="10"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.r" near="0.9" tolerance="0.01"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="dye_back.ppm"/>
	<ExpectImagesDiffer first="dye_split.ppm" second="dye_back.ppm" minDiffering="0" maxDiffering="0.002"/>

	<!-- ⑶ 프리셋 저장 · 불러오기 왕복 -->
	<DevCommand line="appearance.save Hero {out}/hero.appearance"/>
	<DevCommand line="exec Hero applyOptionValue Hair Bearded"/>
	<DevCommand line='exec Hero applyColorValue HairRoot "0.2 0.9 0.2 1"'/>
	<DevCommand line="exec Hero applySliderValue HairHighlightAmount 1"/>
	<WaitUntil watch="Appearance.Value" target="Hero" key="Hair" is="Bearded" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="dye_changed.ppm"/>
	<ExpectImagesDiffer first="dye_split.ppm" second="dye_changed.ppm" region="0.25,0.28,0.33,0.45" minDiffering="0.01"/>
	<DevCommand line="appearance.load Hero {out}/hero.appearance"/>
	<WaitUntil watch="Appearance.Value" target="Hero" key="Hair" is="SimpleParted" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Hero" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.r" near="0.9" tolerance="0.01"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairRoot.g" near="0.15" tolerance="0.01"/>
	<Expect watch="Appearance.Value" target="Hero" key="HairHighlightAmount" near="0"/>
	<Expect watch="Appearance.Value" target="Hero" key="Outfit" is="Ranger"/>
	<Expect watch="Appearance.SlotItem" target="Hero" key="MainHand" is="scifi_pistol"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="dye_loaded.ppm"/>
	<ExpectImagesDiffer first="dye_split.ppm" second="dye_loaded.ppm" minDiffering="0" maxDiffering="0.002"/>
	<!-- Twin 은 내내 제 색이다 -->
	<Expect watch="Appearance.Value" target="Twin" key="HairRoot.b" near="0.9" tolerance="0.01"/>
	<Pass/>
</Scenario>
