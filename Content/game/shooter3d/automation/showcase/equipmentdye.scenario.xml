<?xml version="1.0" encoding="utf-8"?>
<?asset guid="33d51a24995c4479ae210470daa6b8b7"?>
<!--
  게임 중 꾸미기 ④ 장비 염색(아이템 인스턴스) — 무대 maps/equipmentdyeshowcase 의 KnightA(부품 합침) · KnightB(부품 그대로), 장비 컴포넌트(장비 칸 + 가방).
  같은 아이템 정의(helmet_knight_tinted, 스키마 ArmorDye)의 인스턴스마다 색이 다르다 — 색은 인스턴스(InventorySlot 의 꾸미기 값)를 따라 외형 해석을 지나 그 부품의 머티리얼 값이 된다.
  ⑴ A 의 투구만 염색 — 같은 투구를 쓴 B 는 기본색 그대로(인스턴스가 번지지 않는다), ⑵ 같은 정의의 기본색 인스턴스와 번갈아 바꿔 껴도(소켓 부품 풀이 부품을 다시 꺼낸다)
  색이 정확히 갈리고 기본색 사진이 처음과 같다, ⑶ 벗어 가방에 넣었다 다시 껴도 인스턴스 색이 남는다, ⑷ 게임 세이브 · 불러오기 뒤에도 낀 것 · 가방의 것(입지 않은 염색 아이템)의
  색과 캐릭터 꾸미기 값(머리 모양)이 같다 — 세이브 뒤 바꿔 두어(사진이 다른지 먼저 본다) 불러오기가 정말 되돌렸는지 가린다.
  ⑸ 옛 판 세이브 표본(꾸미기 스키마 판 칸이 없던 CEQP 판 1 — 손으로 쓴 바이트)을 불러도 판 올림 사슬(CEQP 1 → 2, 가방 INVT 2 → 3)을 지나 같은 색 · 같은 사진이다.
  가방 칸: 껴 있던 것은 비워진 앞 칸으로 돌아가므로 교체 뒤 벗은 인스턴스는 0 칸에 있다(Equipment.BagItem 이 확인한다).
  골든은 통합 담당이 뜬다(-scenario-record-missing-golden).
  실행: App -scenario=game/shooter3d/automation/showcase/equipmentdye.scenario.xml -unattended
-->
<Scenario name="game.shooter3d.equipmentdye" fixedDelta="0.0166667" timeoutFrames="3000" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/shooter3d/maps/equipmentdyeshowcase.scene.xml"/>
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<!-- 같은 투구 인스턴스: A 에 둘(하나는 나중에 염색), B 에 하나 -->
	<DevCommand line="equipment.give KnightA helmet_knight_tinted"/>
	<DevCommand line="equipment.give KnightA helmet_knight_tinted"/>
	<DevCommand line="equipment.give KnightB helmet_knight_tinted"/>
	<Expect watch="Equipment.BagItem" target="KnightA" key="1" is="helmet_knight_tinted"/> <!-- 인스턴스마다 한 칸(겹치지 않는 장비) -->
	<DevCommand line="equipment.equip KnightA 0 Head"/>
	<DevCommand line="equipment.equip KnightB 0 Head"/>
	<WaitUntil watch="Appearance.SlotItem" target="KnightA" key="Head" is="helmet_knight_tinted" timeoutFrames="10"/>
	<WaitUntil watch="Appearance.SlotItem" target="KnightB" key="Head" is="helmet_knight_tinted" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<Store watch="Appearance.PartMaterial" target="KnightA" key="Head._color" as="plainColor"/>
	<Expect watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="plainColor"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_plain.ppm"/>
	<ExpectImage file="eqdye_plain.ppm" golden="eqdye_plain"/>

	<!-- ⑴ A 의 투구 인스턴스만 붉게 — B 는 기본색 그대로, 메시는 다시 굽지 않는다(염색은 머티리얼 값) -->
	<Store watch="Appearance.BakedMeshEntries" as="entriesBeforeDye"/>
	<DevCommand line="equipment.dye KnightA Head Tint 0.9 0.15 0.1"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightA" key="Head._color" differsFrom="plainColor" timeoutFrames="10"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="plainColor"/>
	<Expect watch="Appearance.BakedMeshEntries" sameAs="entriesBeforeDye"/>
	<Store watch="Appearance.PartMaterial" target="KnightA" key="Head._color" as="redColor"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_red.ppm"/>
	<ExpectImage file="eqdye_red.ppm" golden="eqdye_red"/>
	<ExpectImagesDiffer first="eqdye_plain.ppm" second="eqdye_red.ppm" region="0.355,0.25,0.435,0.45" minDiffering="0.01"/>
	<ExpectImagesDiffer first="eqdye_plain.ppm" second="eqdye_red.ppm" region="0.5,0.2,0.75,0.8" minDiffering="0" maxDiffering="0.002"/>

	<!-- ⑵ 같은 정의의 기본색 인스턴스(가방 1 칸)로 바꿔 낀다 — 풀에서 다시 꺼낸 부품이 붉은색을 남기지 않는다 -->
	<DevCommand line="equipment.equip KnightA 1 Head"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightA" key="Head._color" sameAs="plainColor" timeoutFrames="30"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<Expect watch="Equipment.BagItem" target="KnightA" key="0" is="helmet_knight_tinted +1"/> <!-- 붉은 인스턴스는 가방으로 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_swapplain.ppm"/>
	<ExpectImagesDiffer first="eqdye_plain.ppm" second="eqdye_swapplain.ppm" minDiffering="0" maxDiffering="0.002"/>
	<!-- 다시 붉은 인스턴스로 -->
	<DevCommand line="equipment.equip KnightA 0 Head"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightA" key="Head._color" sameAs="redColor" timeoutFrames="30"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<Expect watch="Equipment.BagItem" target="KnightA" key="0" is="helmet_knight_tinted"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_swapred.ppm"/>
	<ExpectImagesDiffer first="eqdye_red.ppm" second="eqdye_swapred.ppm" minDiffering="0" maxDiffering="0.002"/>

	<!-- ⑶ 벗어 가방에 넣었다 다시 낀다 — 인스턴스 색이 남는다 -->
	<DevCommand line="exec KnightA unequipToBag Head"/>
	<WaitUntil watch="Appearance.SlotItem" target="KnightA" key="Head" is="(empty)" timeoutFrames="10"/>
	<Expect watch="Equipment.BagItem" target="KnightA" key="1" is="helmet_knight_tinted +1"/>
	<DevCommand line="equipment.equip KnightA 1 Head"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightA" key="Head._color" sameAs="redColor" timeoutFrames="30"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>

	<!-- ⑷ 게임 세이브 · 불러오기 — 낀 붉은 투구, 가방의 기본색 투구, B 의 파란 투구는 가방에 두고(입지 않은 염색 아이템), A 의 머리 모양 -->
	<DevCommand line="equipment.dye KnightB Head Tint 0.1 0.2 0.9"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightB" key="Head._color" differsFrom="plainColor" timeoutFrames="10"/>
	<Store watch="Appearance.PartMaterial" target="KnightB" key="Head._color" as="blueColor"/>
	<DevCommand line="exec KnightB unequipToBag Head"/>
	<WaitUntil watch="Appearance.SlotItem" target="KnightB" key="Head" is="(empty)" timeoutFrames="10"/>
	<DevCommand line="exec KnightA applyOptionValue Hair Bearded"/>
	<WaitUntil watch="Appearance.Value" target="KnightA" key="Hair" is="Bearded" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_saved.ppm"/>
	<ExpectImage file="eqdye_saved.ppm" golden="eqdye_saved"/>
	<Store watch="Save.Written" as="writtenBefore"/>
	<DevCommand line="game.save customize/equipmentdye"/>
	<WaitUntil watch="Save.Written" differsFrom="writtenBefore" timeoutWallSeconds="10"/>
	<!-- 세이브 뒤 바꾼다 — 불러오기가 정말 되돌리는지 가리려고 사진이 먼저 달라야 한다 -->
	<DevCommand line="equipment.dye KnightA Head Tint 0.2 0.9 0.2"/>
	<DevCommand line="exec KnightA applyOptionValue Hair Buzzed"/>
	<DevCommand line="equipment.equip KnightB 0 Head"/>
	<WaitUntil watch="Appearance.Value" target="KnightA" key="Hair" is="Buzzed" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_changed.ppm"/>
	<ExpectImagesDiffer first="eqdye_saved.ppm" second="eqdye_changed.ppm" region="0.3,0.2,0.7,0.8" minDiffering="0.01"/>
	<Store watch="Save.Loaded" as="loadedBefore"/>
	<DevCommand line="game.load customize/equipmentdye"/>
	<WaitUntil watch="Save.Loaded" differsFrom="loadedBefore" timeoutWallSeconds="60"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightA" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<Expect watch="Appearance.Value" target="KnightA" key="Hair" is="Bearded"/>
	<Expect watch="Equipment.Worn" target="KnightA" key="Head" is="helmet_knight_tinted"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightA" key="Head._color" sameAs="redColor" timeoutFrames="30"/>
	<Expect watch="Equipment.BagItem" target="KnightA" key="0" is="helmet_knight_tinted"/> <!-- 가방의 기본색 인스턴스 -->
	<Expect watch="Equipment.Worn" target="KnightB" key="Head" is="(empty)"/>
	<Expect watch="Equipment.BagItem" target="KnightB" key="0" is="helmet_knight_tinted +1"/> <!-- 입지 않은 염색 아이템 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_loaded.ppm"/>
	<ExpectImagesDiffer first="eqdye_saved.ppm" second="eqdye_loaded.ppm" minDiffering="0" maxDiffering="0.002"/>
	<!-- 가방의 파란 투구를 껴 본다 — 입지 않은 채 실린 색이 그대로다 -->
	<DevCommand line="equipment.equip KnightB 0 Head"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="blueColor" timeoutFrames="30"/>

	<!-- ⑸ 옛 판 세이브 표본 — 먼저 B 의 투구를 지금 판으로 붉게 칠해 사진을 뜬다(기준) -->
	<DevCommand line="equipment.dye KnightB Head Tint 0.9 0.15 0.1"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="redColor" timeoutFrames="30"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_bred.ppm"/>
	<!-- 다시 파랗게 칠해 둔 뒤(불러오기가 정말 바꿨는지 가린다) 판 1 장비 상태를 건다: 낀 칸 Head = 붉게 염색한 투구(Tint 0.9 0.15 0.1, 판 칸 없음), 가방 = 기본색 투구 하나.
	     바이트: 'CEQP' · 판 1 · 낀 칸 1(칸 이름 · 슬롯: 이름 · 개수 · 내구도 · 피해 · 꾸미기 수 + 값 · 뗀 부품 수) · 가방(인벤토리 판 2: 최대 무게 · 넘침 0 · 슬롯 1) -->
	<DevCommand line="equipment.dye KnightB Head Tint 0.1 0.2 0.9"/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="blueColor" timeoutFrames="30"/>
	<DevCommand line="equipment.restore KnightB Q0VRUAEAAAABAAAABAAAAEhlYWQUAAAAaGVsbWV0X2tuaWdodF90aW50ZWQBAAAAAAAAAAAAAAABAAAABAAAAFRpbnQAAAAAZmZmP5qZGT7NzMw9AACAPwAAAAAAAAAAAAAAAAEAAAAUAAAAaGVsbWV0X2tuaWdodF90aW50ZWQBAAAAAAAAAAAAAAAAAAAAAAAAAA=="/>
	<WaitUntil watch="Appearance.PartMaterial" target="KnightB" key="Head._color" sameAs="redColor" timeoutFrames="30"/>
	<Expect watch="Equipment.Worn" target="KnightB" key="Head" is="helmet_knight_tinted"/>
	<Expect watch="Equipment.BagItem" target="KnightB" key="0" is="helmet_knight_tinted"/> <!-- 가방의 기본색 인스턴스(인스턴스 상태 없음) -->
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="KnightB" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="eqdye_brestored.ppm"/>
	<ExpectImagesDiffer first="eqdye_bred.ppm" second="eqdye_brestored.ppm" minDiffering="0" maxDiffering="0.002"/>
	<Pass/>
</Scenario>
