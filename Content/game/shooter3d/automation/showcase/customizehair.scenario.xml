<?asset guid="b6f1e0c2a8d94b3e9c47a5d1f2e83b60"?>
<!--
  게임 중 꾸미기 ⑦ 머리 교체 뒤 머리 물리 — 무대 maps/customizationshowcase 의 Twin(부품 그대로)을 마을 사람 여자(TownsfolkFemale)로 바꾸고 긴 머리(Long = hair_long_spring —
  사슬 4 뼈 메시 + 리그 ubc_hair_long, 뿌리는 몸의 Head, SpringChain "Hair")를 입힌다. 감시 값은 Appearance.PartRigOutput(key '<부품>.<노드>.<출력>'):
  Hair.Hair.speed(지난 평가의 가장 빠른 입자 속도, m/s — 튐), Hair.Hair.offset(입자가 애니메이션 자세에서 벗어난 거리, m — 쉼).
  교체 계약: 부품을 바꾸면 새 리그라 새 바인드 포즈에서 처음부터, 남긴 부품은 몸이 바뀌면(본 비율 · 몸 메시) 외형이 시뮬레이션을 다시 시작한다(restartPartDynamics —
  언리얼 AnimDynamics ResetDynamics · Chaos Cloth ForceNextUpdateTeleportAndReset, 유니티 Spring Bone 리셋).
  ⑴ 긴 머리 ↔ 묶은 머리(Buns — 리그 없음) 교체: 사진이 다르고, 다시 긴 머리로 바꾼 직후 몇 프레임 속도가 낮다. ⑵ 투구를 썼다 벗기: 규칙(HelmetHidesHair)이 머리카락 부품을
  거뒀다가 새로 세운다 — 벗은 직후 몇 프레임 속도가 낮다. ⑶ 빠른 회전(object.turn 150 도): 대조로 회전만 하면 머리카락이 튄다(속도가 오른다 — 감시 값이 움직임을 본다),
  회전과 같은 프레임에 체형(LegLength)을 바꾸면 남긴 머리카락의 시뮬레이션이 새 포즈에서 다시 시작해 튀지 않는다. 끝에 사슬이 쉰다.
  골든은 통합 담당이 뜬다. 실행: App -scenario=game/shooter3d/automation/showcase/customizehair.scenario.xml -unattended
-->
<Scenario name="game.shooter3d.customizehair" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_firstScene" value="game/shooter3d/maps/customizationshowcase.scene.xml"/>
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<DevCommand line="exec Twin setPreset TownsfolkFemale 0"/>
	<WaitUntil watch="Appearance.Preset" target="Twin" is="TownsfolkFemale" timeoutFrames="10"/>
	<DevCommand line="exec Twin applyOptionValue Hair Long"/>
	<WaitUntil watch="Appearance.Value" target="Twin" key="Hair" is="Long" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.05" timeoutFrames="300"/> <!-- 리그가 묶여 사슬이 쉰다 -->
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="hair_long.ppm"/>
	<ExpectImage file="hair_long.ppm" golden="hair_long"/>

	<!-- ⑴ 묶은 머리(리그 없음)로 바꿨다가 긴 머리로 돌아온다 -->
	<DevCommand line="exec Twin applyOptionValue Hair Buns"/>
	<WaitUntil watch="Appearance.Value" target="Twin" key="Hair" is="Buns" timeoutFrames="2"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="hair_buns.ppm"/>
	<ExpectImagesDiffer first="hair_long.ppm" second="hair_buns.ppm" region="0.42,0.28,0.58,0.46" minDiffering="0.01"/>
	<DevCommand line="exec Twin applyOptionValue Hair Long"/>
	<WaitUntil watch="Appearance.Value" target="Twin" key="Hair" is="Long" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.offset" atLeast="0" timeoutFrames="60"/> <!-- 새 부품의 리그가 묶였다 -->
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<AdvanceSimulation frames="1" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<AdvanceSimulation frames="1" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<AdvanceSimulation frames="2" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.05" timeoutFrames="300"/>
	<WaitRenderStable/> <!-- 사진 앞 렌더 안정(TAA · 노출 · 에셋) -->
	<Screenshot file="hair_long_again.ppm"/>
	<ExpectImagesDiffer first="hair_long.ppm" second="hair_long_again.ppm" minDiffering="0" maxDiffering="0.002"/> <!-- 새 바인드 포즈에서 시작해 처음 모습으로 쉰다 -->

	<!-- ⑵ 투구를 썼다 벗는다 — 규칙이 머리카락을 거뒀다가 새로 세운다 -->
	<DevCommand line="exec Twin setSlotItem Head helmet_knight"/>
	<WaitUntil watch="Appearance.HiddenBy" target="Twin" key="Hair.Hair" is="HelmetHidesHair" timeoutFrames="10"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<DevCommand line="exec Twin setSlotItem Head"/>
	<WaitUntil watch="Appearance.HiddenBy" target="Twin" key="Hair.Hair" is="(visible)" timeoutFrames="10"/>
	<WaitUntil watch="Appearance.Idle" target="Twin" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.offset" atLeast="0" timeoutFrames="60"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<AdvanceSimulation frames="1" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<AdvanceSimulation frames="2" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.5"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.05" timeoutFrames="300"/>

	<!-- ⑶ 대조: 회전만 하면 머리카락이 튄다(감시 값이 움직임을 본다 — 거짓 통과 막기) -->
	<DevCommand line="object.turn Twin 150"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atLeast="0.3" timeoutFrames="5"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.05" timeoutFrames="300"/>
	<!-- 회전과 같은 프레임에 체형을 바꾼다 — 조립(AssembleCount)이 남긴 머리카락의 시뮬레이션을 새 포즈에서 다시 시작해, 회전의 튐이 이어지지 않는다
	     (다시 시작하지 않으면 감쇠 0.2 로 몇 프레임 동안 0.3 m/s 를 넘는다 — 위 대조) -->
	<Store watch="Appearance.AssembleCount" target="Twin" as="assembledBeforeLeg"/>
	<DevCommand line="object.turn Twin -150"/>
	<DevCommand line="exec Twin applySliderValue LegLength 1"/>
	<WaitUntil watch="Appearance.Value" target="Twin" key="LegLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.AssembleCount" target="Twin" increaseFrom="assembledBeforeLeg" increaseBy="1" timeoutFrames="10"/>
	<AdvanceSimulation frames="2" render="true"/> <!-- 다시 시작한 평가가 출력 사본에 오른다(준비 단계가 지난 평가를 옮긴다) -->
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.3"/>
	<AdvanceSimulation frames="1" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.3"/>
	<AdvanceSimulation frames="2" render="true"/>
	<Expect watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.3"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.speed" atMost="0.05" timeoutFrames="300"/>
	<WaitUntil watch="Appearance.PartRigOutput" target="Twin" key="Hair.Hair.offset" atMost="0.05" timeoutFrames="300"/> <!-- 사슬이 애니메이션 자세 곁에 쉰다 -->
	<Pass/>
</Scenario>
