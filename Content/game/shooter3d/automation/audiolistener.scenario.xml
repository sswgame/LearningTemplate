<?xml version="1.0" encoding="utf-8"?>
<!--
  Shooter3D 듣는 자리 — 플레이어 눈에 AudioListenerComponent 가 있어, 화면 시점(ViewCamera — PlayerCamera 의 카메라 매니저가 받는 뷰 타깃)을 3인칭 궤도(orbit)로 띄워도 소리는 몸에서 듣는다
  (리스너가 없으면 게임 카메라가 듣는다. 언리얼 3인칭 게임이 리스너를 폰에 두는 것과 같다).
  ① 궤도 카메라는 플레이어에서 멀리 떨어져 있다. ② 벽의 전력함 점 소리(PowerBoxHum, -19.95 1.4 6)까지 거리는 플레이어 자리(스폰 0 · -16, 눈 높이)에서 잰 값 약 29.7 m 다.
  카메라가 들었다면 궤도 거리만큼 달라진다. 값으로 판정한다(골든 없음).
  실행: App -scenario=game/shooter3d/automation/audiolistener.scenario.xml -unattended (체인: ctest -R Scenario.shooter3d)
-->
<Scenario name="game.shooter3d.audiolistener" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<AllowLog id="Audio.DeviceLost" reason="장치 없는 러너에서도 오프라인으로 돈다"/>
	<DevCommand line="camera.preset orbit"/>
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<Wait frames="5"/>
	<WaitUntil watch="Audio.InstanceCount" atLeast="2" timeoutWallSeconds="10"/>
	<!-- 궤도 감쇠(0.2 초)가 자리 잡을 시간 -->
	<Wait frames="60"/>
	<Expect watch="Object.DistanceTo" target="ViewCamera" key="Player" atLeast="5"/>
	<!-- 그리는 카메라는 PlayerCamera 이고 카메라 매니저가 뷰 타깃 ViewCamera(디렉터) 자리에 둔다 -->
	<Expect watch="Camera.FrameObject" is="PlayerCamera"/>
	<Expect watch="Object.DistanceTo" target="PlayerCamera" key="ViewCamera" atMost="0.01"/>
	<Expect watch="Audio.EmitterDistance" target="PowerBoxHum" near="29.7" tolerance="0.6"/>
	<Pass/>
</Scenario>
