<?xml version="1.0" encoding="utf-8"?>
<!--
  렌더 장치 분실(감사 R-2) — 개발 명령 rhi.removeDevice 로 TDR 처럼 DX12 장치를 제거하면 EngineConfig _deviceLostPolicy(Quit)대로 엔진이 스스로
  종료 코드 DeviceLost(18, Config/Engine/ProcessExitCodes.json)를 요청하고 10 초 안에 루프를 끝내는지(멈추지 않는지) 본다. ExpectExitWithin exitCode 가 그 코드를 판정하고,
  맞으면 시나리오는 통과(0)로 끝난다. 백엔드는 DX12 로 묶는다(장치 제거 경로와 허용 로그가 백엔드마다 다르다 — Vulkan 은 손실 표시만 한다).
  프로세스를 끝내므로 체인에 넣지 못해 desktop/ 에 둔다(CTest 가 하나씩 혼자 돌린다). Recreate 정책(같은 백엔드로 다시 만들기)은 devicerecreate 시나리오가 본다(gv_deviceLostPolicy=2) —
  판정 규칙은 단위 EngineRenderDriverTest.RecreatePolicyQuitsOnBackendsThatCannotRecreate.
  실행: App -scenario=game/shooter3d/automation/desktop/devicelost.scenario.xml -unattended (ctest -R Scenario.shooter3d.desktop.devicelost)
-->
<Scenario name="game.shooter3d.devicelost" fixedDelta="0.0166667" timeoutFrames="600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Launch variable="gv_rhiBackend" value="DirectX12"/>
	<AllowLog id="D3D12.RemovingD3D12DeviceRequest" reason="rhi.removeDevice 가 일부러 장치를 제거한다"/>
	<AllowLog id="D3D12.D3D12DeviceLostWhile" reason="제거된 장치의 다음 GPU 호출이 손실을 본다"/>
	<AllowLog id="GPUBreadcrumbs.DeviceLostLastPass" reason="손실을 처음 본 백엔드의 브레드크럼 보고"/>
	<AllowLog id="GPUBreadcrumbs.DeviceLostLastCompleted" reason="손실을 처음 본 백엔드의 브레드크럼 보고"/>
	<AllowLog id="GPUBreadcrumbs.DeviceLostGPUBreadcrumb" reason="손실을 처음 본 백엔드의 브레드크럼 보고"/>
	<AllowLog id="GPUBreadcrumbs.DeviceLostGPULast" reason="손실을 처음 본 백엔드의 브레드크럼 보고"/>
	<AllowLog id="GPUBreadcrumbs.DeviceLostBackendLeaves" reason="손실을 처음 본 백엔드의 브레드크럼 보고"/>
	<AllowLog id="Render.DeviceLostQuit" reason="Quit 정책이 종료 코드 DeviceLost 로 끝낸다 — 이 시나리오가 보는 것"/>
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<Wait frames="30"/>
	<DevCommand line="rhi.removeDevice"/>
	<ExpectExitWithin seconds="10" exitCode="18"/>
</Scenario>
