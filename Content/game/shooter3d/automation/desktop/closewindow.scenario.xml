<?xml version="1.0" encoding="utf-8"?>
<!--
  창 닫기 — 플레이 중 커서 잠금 → 포커스 잃음이 잠금을 푼다 → 다시 활성화만으로는 잡지 않는다 → 클라이언트 클릭이 다시 잡는다 → Esc 가 푼다 →
  Esc 가 다시 잡는다 → WM_CLOSE 로 10 초 안 종료(코드 0). 진짜 ClipCursor 를 보므로 input="mixed"(OS 포커스 사건을 버리지 않는다) — 도는 동안 키보드 · 마우스를
  만지지 말 것. 전경을 못 얻는 세션(원격 · 잠긴 화면 · 다른 창이 전경을 쥠)이면 13(건너뜀), Windows 밖에서도 13.
  전경은 루트 속성(requireForeground)이라 실행기가 시작을 기다리는 동안 가져온다 — 카메라가 잠금을 켜는 첫 틱보다 먼저 전경이어야 바로 잡는다
  (전경이 아닐 때 켠 잠금은 클라이언트를 눌러야 잡는다 — InputManager::setMouseLockMode).
  데스크톱 전역 상태(커서 클립 · 전경)를 쓰고 프로세스를 끝내므로 체인(백엔드 넷이 동시에 돈다)에 넣지 못한다 — desktop/ 의 시나리오는 CTest 가 하나씩 혼자(RUN_SERIAL) 돌린다.
  커서 클립은 감시 값이 아니라 단계(ExpectCursorClip)가 보므로 WaitUntil 대신 고정 대기 뒤에 본다.
  실행: App -scenario=game/shooter3d/automation/desktop/closewindow.scenario.xml -unattended (ctest -R Scenario.shooter3d.desktop.closewindow)
-->
<Scenario name="game.shooter3d.closewindow" requireForeground="true" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" startTimeoutFrames="900" input="mixed">
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<!-- 1인칭 카메라가 첫 틱에 잠금을 켠다 — 전경이면 바로 잡는다 -->
	<Wait frames="10"/>
	<ExpectCursorClip state="locked"/>
	<!-- 포커스 잃음(알트탭과 같은 메시지) → 풀린다 -->
	<Wait frames="10"/>
	<PostWindowMessage message="WM_ACTIVATE_INACTIVE"/>
	<PostWindowMessage message="WM_KILLFOCUS"/>
	<Wait frames="5"/>
	<ExpectCursorClip state="free"/>
	<!-- 다시 활성화만으로는 잡지 않는다(제목 표시줄 X 를 누를 수 있게) -->
	<Wait frames="5"/>
	<PostWindowMessage message="WM_ACTIVATE_ACTIVE"/>
	<PostWindowMessage message="WM_SETFOCUS"/>
	<Wait frames="5"/>
	<ExpectCursorClip state="free"/>
	<!-- 클라이언트 클릭이 다시 잡는다 -->
	<Wait frames="5"/>
	<PostWindowMessage message="WM_LBUTTONDOWN_CLIENT"/>
	<PostWindowMessage message="WM_LBUTTONUP_CLIENT"/>
	<Wait frames="5"/>
	<ExpectCursorClip state="locked"/>
	<!-- Esc(가상 키보드 — 입력 층)가 푼다 -->
	<Wait frames="5"/>
	<Tap slot="Key.Escape" hold="1"/>
	<Wait frames="5"/>
	<ExpectCursorClip state="free"/>
	<!-- Esc 다시 → 잠근다 -->
	<Wait frames="5"/>
	<Tap slot="Key.Escape" hold="1"/>
	<Wait frames="5"/>
	<ExpectCursorClip state="locked"/>
	<!-- 창의 X 와 같은 WM_CLOSE → 10 초 안에 종료 코드 0 -->
	<Wait frames="5"/>
	<PostWindowMessage message="WM_CLOSE"/>
	<ExpectExitWithin seconds="10"/>
</Scenario>
