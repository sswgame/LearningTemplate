<!--
  Shooter3D 플레이어 몸 체형 — 몸 부품(UBC)의 체형 축(common/characters/ubc/ubc.bodyshape.xml: Shoulder.Width · Arm.Length · Leg.Length)을 마을 사람 스키마 슬라이더
  (ShoulderWidth · ArmLength · LegLength)로 바꾼 뒤에도 손 IK 가 총의 Grip · SupportHand 에 닿고(Shooter3D.HandReachError ≤ 0.03 m, bodyviews 와 같은 한도)
  발이 땅에 서는지(발 디딤 Feet.sole_gap_peak 가 다리를 바꾸기 전 기준에서 1.5 cm 안) 본다. 손 IK(TwoBoneIK)는 지금 포즈의 마디 길이로 풀고, 발 디딤은 다리 길이 비만큼 골반을 옮긴다(leg_lift).
  소총(1 — 두 손 견착)을 든 채 3인칭(camera.preset thirdperson)에서 걷고, 1인칭(시점 총)에서 다시 걷는다. 값으로 판정한다(사진 없음).
  실행: App -scenario=game/shooter3d/automation/bodyshapehands.scenario.xml -unattended (체인: ctest -R Scenario.shooter3d)
-->
<Scenario name="game.shooter3d.bodyshapehands" fixedDelta="0.0166667" timeoutFrames="3600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_shooterAutoPlay" value="0"/>
	<WaitUntil watch="Assets.Pending" equals="0" timeoutWallSeconds="60"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="600"/>
	<Tap slot="Key.Digit1" hold="1"/>
	<WaitUntil watch="Shooter3D.WeaponIndex" equals="0" timeoutFrames="30"/>
	<AdvanceSimulation frames="25"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>

	<!-- ⑴ 긴 팔 · 3인칭 걷기 — 시작 카메라는 1인칭이라 3인칭으로 바꾼다(1인칭 손 IK 가 켜져 있으면 시점 총을 잡는 손을 본다) -->
	<DevCommand line="camera.preset thirdperson"/>
	<DevCommand line="appearance.value PlayerBody ArmLength 1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ArmLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<Press slot="Key.W"/>
	<AdvanceSimulation frames="60"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>
	<Release slot="Key.W"/>
	<!-- ⑵ 짧은 팔 -->
	<DevCommand line="appearance.value PlayerBody ArmLength -1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ArmLength" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<Press slot="Key.S"/>
	<AdvanceSimulation frames="60"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>
	<Release slot="Key.S"/>
	<!-- ⑶ 어깨 폭 극값(짧은 팔 그대로 — 가장 멀다. 넓은 쪽 2.5 cm 가 이 조합에서 닿는 한도다) -->
	<DevCommand line="appearance.value PlayerBody ShoulderWidth 1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ShoulderWidth" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<AdvanceSimulation frames="20"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>
	<DevCommand line="appearance.value PlayerBody ShoulderWidth -1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ShoulderWidth" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<AdvanceSimulation frames="20"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>

	<!-- ⑷ 다리 길이 극값 — 서서 발바닥 틈을 본다(창 1 ~ 2 초가 바뀐 몸의 값으로 찬 뒤). 기준은 다리를 바꾸기 전 몸의 틈 최댓값이다(대기 클립의 무게 옮김도 발을 잠깐 든다) -->
	<AdvanceSimulation frames="130"/>
	<Store watch="Rig.Output" target="PlayerBody" key="Feet.sole_gap_peak" as="soleGapBase"/>
	<DevCommand line="appearance.value PlayerBody LegLength 1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="LegLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="PlayerBody" key="Feet.leg_lift" atLeast="0.03" timeoutFrames="30"/>
	<AdvanceSimulation frames="70"/>
	<WaitUntil watch="Rig.Output" target="PlayerBody" key="Feet.sole_gap_peak" sameAs="soleGapBase" tolerance="0.015" timeoutFrames="120"/>
	<DevCommand line="appearance.value PlayerBody LegLength -1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="LegLength" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<WaitUntil watch="Rig.Output" target="PlayerBody" key="Feet.leg_lift" atMost="-0.03" timeoutFrames="30"/>
	<AdvanceSimulation frames="70"/>
	<WaitUntil watch="Rig.Output" target="PlayerBody" key="Feet.sole_gap_peak" sameAs="soleGapBase" tolerance="0.015" timeoutFrames="120"/>

	<!-- ⑸ 1인칭 — 시점 총의 Grip · SupportHand 를 긴 팔 · 짧은 팔로 잡는다 -->
	<DevCommand line="camera.preset firstperson"/>
	<!-- 다리는 ⑷ 의 짧은 다리 그대로 — 1인칭 눈높이가 몸(rest_leg_lift)을 따라 내려가 시점 총도 함께 내려간다 -->
	<WaitUntil watch="Rig.Output" target="PlayerBody" key="Feet.rest_leg_lift" atMost="-0.03" timeoutFrames="10"/>
	<DevCommand line="appearance.value PlayerBody ArmLength 1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ArmLength" near="1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<Press slot="Key.W"/>
	<AdvanceSimulation frames="60"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>
	<Release slot="Key.W"/>
	<DevCommand line="appearance.value PlayerBody ArmLength -1"/>
	<WaitUntil watch="Appearance.Value" target="PlayerBody" key="ArmLength" near="-1" timeoutFrames="2"/>
	<WaitUntil watch="Appearance.Idle" target="PlayerBody" equals="1" timeoutFrames="300"/>
	<Press slot="Key.S"/>
	<AdvanceSimulation frames="60"/>
	<Expect watch="Shooter3D.HandReachError" atMost="0.03"/>
	<Release slot="Key.S"/>
	<Pass/>
</Scenario>
