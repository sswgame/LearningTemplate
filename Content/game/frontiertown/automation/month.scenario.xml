<?xml version="1.0" encoding="utf-8"?>
<!--
  FrontierTown 키트 둘의 흐름 — 도시와 RTS 가 한 땅 · 한 지갑 · 한 시계를 나누며 판이 열리고, 공유 시계를 날 단위로 감아 도시의 달 결산이 돈다.
  땅을 나누는 규칙(도시 땅에 짓지 못함 · 해병이 신전을 돌아감)은 단위 테스트 KitCompositionTest.CityAndSkirmish* 가 같은 배치로 단언한다.
  배치가 땅과 맞지 않아 거절되면 로그에 `[Frontier] ... was refused` 가 남는다 — 끝에서 그 줄이 없는지 본다.
  감기 사이의 2 프레임은 지나간 날 경계 알림을 다음 틱의 디렉터가 받는 자리다(그 틱이 돌아야 한다).
  실행: ctest -R Scenario.frontiertown (SW_ACTIVE_GAME=FrontierTown) · App -scenario=game/frontiertown/automation/month.scenario.xml -unattended
-->
<Scenario name="game.frontiertown.month" fixedDelta="0.0166667" timeoutFrames="900" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_frontierAutoPlay" value="0"/>
	<!-- 시계는 6 시에 시작하고 하루가 실제 24 초다(FrontierTownData) — 시작 전 프레임까지 합쳐 한 시간이 지나기 전이다. -->
	<Wait frames="1"/>
	<Expect watch="Clock.Day" equals="0"/>
	<Expect watch="Clock.Hour" atLeast="6"/>
	<Expect watch="Clock.Hour" atMost="7"/>
	<Wait frames="1"/>
	<AdvanceGameTime hours="24"/>
	<Wait frames="2"/>
	<Expect watch="Clock.Day" equals="1"/>
	<Wait frames="1"/>
	<AdvanceGameTime hours="24"/>
	<Wait frames="2"/>
	<AdvanceGameTime hours="24"/>
	<Wait frames="2"/>
	<Expect watch="Clock.Day" equals="3"/>
	<ExpectLog contains="was refused" count="0"/>
	<Record watch="Clock.Day"/>
	<Pass/>
</Scenario>
