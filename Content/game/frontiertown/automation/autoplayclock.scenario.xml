<?xml version="1.0" encoding="utf-8"?>
<!--
  FrontierTown 자동 플레이 — gv_frontierAutoPlay 를 켜면 도시 디렉터가 공유 시계를 8 배로 흘려(하루 24 초 → 3 초) 달 결산과 RTS 가 스스로 돈다.
  시계는 아침 6 시에 시작하므로 8 배속이면 이틀째로 넘어가는 것이 5 초 즈음이다. 1 배속이면 42 초라 시한(30 초)에서 진다 — 스위치가 안 먹은 것을 잡는다.
  month 시나리오는 AdvanceGameTime 으로 시계를 감아 보지만 이 시나리오는 스위치가 만든 시간 흐름만 본다. 시나리오 시한은 조건 대기 프레임도 세므로 30 초보다 길다.
  배치가 땅과 맞지 않아 거절되면 `[Frontier] ... was refused` 가 남는다 — 끝에서 그 줄이 없는지 본다.
  실행: ctest -R Scenario.frontiertown (SW_ACTIVE_GAME=FrontierTown) · App -scenario=game/frontiertown/automation/autoplayclock.scenario.xml -unattended
-->
<Scenario name="game.frontiertown.autoplayclock" fixedDelta="0.0166667" timeoutFrames="2000" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_frontierAutoPlay" value="1"/>
	<WaitUntil watch="Clock.Day" atLeast="2" timeoutSeconds="30"/>
	<ExpectLog contains="was refused" count="0"/>
	<Pass/>
</Scenario>
