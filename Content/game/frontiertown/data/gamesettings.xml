<?xml version="1.0" encoding="utf-8"?>
<!-- FrontierTown 팩의 설정 — 시작 맵은 마을 씬이다(게임마다 팩의 data/gamesettings.xml 하나다).
     inputMap 줄들은 입력 맵 묶음이다(docs/InputMapBundle.md). 이 게임은 공통 파일만으로 된다. -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Frontier Town" _userSettingsSchema="game/frontiertown/data/frontier.settings.xml" _bUIPauseMenu="true" />
  <startMap>game/frontiertown/maps/frontier.scene.xml</startMap>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/fastforward.input.xml"/>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
