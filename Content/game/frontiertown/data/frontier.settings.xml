<?xml version="1.0" encoding="utf-8"?>
<!-- FrontierTown 의 사용자 설정 — 엔진 스키마(engine/settings/engine.settings.xml) 위에 덧붙는다(gamesettings.xml 의 _userSettingsSchema).
     조작 탭의 키 바인딩: 입력 맵(data/frontier.input.xml)의 액션마다 첫 바인딩을 다시 잡을 수 있다. 빈 default 는 "입력 맵의 기본 바인딩"이다. -->
<UserSettingsSchema version="1">
	<Setting id="controls.frontierFastForward" category="controls" type="keyBinding" action="Frontier.FastForward" bindIndex="0" default=""/>
</UserSettingsSchema>
