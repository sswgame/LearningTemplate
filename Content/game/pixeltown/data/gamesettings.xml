<?xml version="1.0" encoding="utf-8"?>
<!-- PixelTown 팩의 설정 — 시작 맵은 마을 씬이다(게임마다 팩의 data/gamesettings.xml 하나다). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Pixel Town" />
  <startMap>game/pixeltown/maps/town.scene.xml</startMap>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/move.input.xml"/>
  <inputMap path="common/input/interact.input.xml"/>
  <inputMap path="game/pixeltown/data/town.input.xml"/>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
