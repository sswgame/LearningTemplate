<?xml version="1.0" encoding="utf-8"?>
<!--
  장르 수직 슬라이스(G1) — 시작 → 목표(guests.scenario.xml 의 단계 그대로) → 결과 → 저장 · 복원 해시 동일.
  목표 단계는 그 시나리오가 정본이다 — 거기를 고치면 이 파일도 맞춘다. 저장 슬롯은 themepark/slice.
-->
<Scenario name="game.themepark.slice" fixedDelta="0.0166667" timeoutFrames="5600" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_parkAutoBuild" value="1"/>
	<WaitUntil watch="Object.Exists" target="ParkGuest[3]" equals="1" timeoutFrames="60"/>
	<Expect watch="Object.Property" target="ParkGuest[0]" key="ParkGuestComponent._guestIndex" equals="0"/>
	<Expect watch="Object.Property" target="ParkGuest[3]" key="ParkGuestComponent._guestIndex" equals="3"/>
	<Expect watch="Object.Property" target="ParkGuest_2" key="ParkGuestComponent._guestIndex" equals="1"/>
	<Store watch="Object.X" target="ParkGuest[0]" as="gateX"/>
	<!-- 첫 손님이 들어와 0 번 뷰가 정문에서 움직인다. -->
	<WaitUntil watch="ThemePark.GuestCount" atLeast="1" timeoutSeconds="30"/>
	<WaitUntil watch="Object.X" target="ParkGuest[0]" differsFrom="gateX" timeoutSeconds="20"/>
	<!-- 자동 건설이 첫 놀이기구를 짓는다. -->
	<WaitUntil watch="Object.Exists" target="RideEntrance[0]" equals="1" timeoutSeconds="30"/>
	<Record watch="ThemePark.GuestCount"/>
	<!-- 저장 → 세계를 더 돌림 → 두 번 복원: 같은 슬롯을 두 번 불러온 직후의 씬 상태 해시가 같아야 한다(복원이 세계를 다 되살린다 — 저장 순간의 해시와 견주면 명령이 도는 프레임만큼 흔들린다) -->
	<Wait frames="1"/>
	<DevCommand line="game.save themepark/slice"/>
	<WaitUntil watch="Save.Written" atLeast="1" timeoutWallSeconds="10"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load themepark/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="1" timeoutWallSeconds="10"/>
	<RecordStateHash key="restored"/>
	<Wait seconds="1"/>
	<DevCommand line="game.load themepark/slice"/>
	<WaitUntil watch="Save.Loaded" atLeast="2" timeoutWallSeconds="10"/>
	<ExpectStateHash key="restored"/>
	<Pass/>
</Scenario>
