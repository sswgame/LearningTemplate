<?xml version="1.0" encoding="utf-8"?>
<!--
  ThemeParkTycoon 그림자 — 직교 카메라가 화면 끝까지 그림자를 받는가(그림자 볼륨이 화면에 맞는가). 고정 카메라(카메라 디렉터의 직교 프리셋, 배타 입력이라 아무도 움직이지 않는다) ·
  고정 해(Sun) · 고정 프레임 시간 · 자동 짓기 끔.
  화면 띠 · 나무 줄 · 가운데 다섯 영역을 백엔드별 골든과 견준다(예전의 darkFraction 문턱 대신) — 그림자가 화면 어느 띠에서 통째로 사라지면 그 영역이 진다.
  아래 · 오른쪽 띠는 지도 밖 빈 곳(어두운 배경)이 커서 쓰지 않는다. 180 프레임은 옛 시나리오의 찍는 프레임 그대로다(공원이 돌아가는 시뮬레이션 시간).
  실행: ctest -R Scenario.themepark (SW_ACTIVE_GAME=ThemeParkTycoon) · App -scenario=game/themepark/automation/shadow.scenario.xml -unattended
-->
<Scenario name="game.themepark.shadow" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<Variable name="gv_parkAutoBuild" value="0"/>
	<Wait frames="180"/>
	<Screenshot file="park.ppm"/>
	<Wait frames="1"/>
	<ExpectImage file="park.ppm" golden="shadow_top" region="0.0,0.0,1.0,0.12"/>
	<ExpectImage file="park.ppm" golden="shadow_left" region="0.0,0.0,0.12,1.0"/>
	<ExpectImage file="park.ppm" golden="shadow_center" region="0.3,0.3,0.7,0.7"/>
	<ExpectImage file="park.ppm" golden="shadow_trees_topright" region="0.75,0.0,1.0,0.25"/>
	<ExpectImage file="park.ppm" golden="shadow_trees_bottom" region="0.3,0.8,0.6,1.0"/>
	<Pass/>
</Scenario>
