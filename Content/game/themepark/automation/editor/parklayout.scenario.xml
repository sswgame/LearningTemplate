<?xml version="1.0" encoding="utf-8"?>
<!--
  ThemeParkTycoon 에디터 시나리오 — 공원 배치 창(themepark.layout, ThemePark 키트의 에디터 확장). 배치 파일(game/themepark/data/rides.xml)은 이 게임에만 있어
  엔진 에디터 체인에서는 창이 "배치 데이터 없음" 이다.
  ① 창을 열면 배치의 놀이기구(평지 셋 + 코스터 셋)가 표에 뜬다. ② Reload 는 파일을 다시 읽는다(로그 한 줄, 놀이기구 수는 그대로).
  ③ 줄을 두 번 누르면(더블클릭) 씬 뷰 카메라가 그 놀이기구로 간다 — Spinning Cups(x 45) 다음 Sky Drop(x -28) 으로 옮기면 카메라 X 가 바뀐다.
  에디터 단계를 쓰므로 게임 체인(Scenario.themepark, 에디터 없음)이 줍지 않게 하위 폴더 editor/ 에 둔다.
  감시 값: Editor.ParkLayoutRideCount(읽힌 놀이기구 수) · Editor.SceneViewCameraX.
  실행: App -EnableEditor -game=ThemeParkTycoon -scenario=game/themepark/automation/editor/parklayout.scenario.xml -unattended
-->
<Scenario name="game.themepark.parklayout" fixedDelta="0.0166667" timeoutFrames="1200" startAfter="Immediately" input="exclusive">
	<WaitUntil watch="Scene.Transitioning" equals="0" timeoutWallSeconds="60"/>
	<ResizeWindow width="1920" height="1080"/>
	<Variable name="gv_editorUiScale" value="1"/>
	<EditorWaitStable/>
	<DevCommand line="layout.reset"/>
	<EditorWaitStable/>
	<!-- ① 창 열기 — 놀이기구 표 -->
	<DevCommand line="panel.focus themepark.layout"/>
	<WaitUntil watch="Editor.ParkLayoutRideCount" equals="6" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- ② Reload — 다시 읽어도 같은 배치 -->
	<EditorClick mark="themepark.layout.reload"/>
	<EditorWaitStable/>
	<ExpectLog id="ParkLayoutPanel.ParkLayoutReloadedRequest" count="1"/>
	<Expect watch="Editor.ParkLayoutRideCount" equals="6"/>
	<!-- ③ 더블클릭 — 씬 뷰 카메라가 놀이기구로 -->
	<Store watch="Editor.SceneViewCameraX" as="startX"/>
	<EditorClick mark="themepark.layout.ride.1"/>
	<EditorWaitStable/>
	<EditorClick mark="themepark.layout.ride.1"/>
	<WaitUntil watch="Editor.SceneViewCameraX" differsFrom="startX" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Store watch="Editor.SceneViewCameraX" as="cupsX"/>
	<EditorClick mark="themepark.layout.ride.2"/>
	<EditorWaitStable/>
	<EditorClick mark="themepark.layout.ride.2"/>
	<WaitUntil watch="Editor.SceneViewCameraX" differsFrom="cupsX" timeoutFrames="60"/>
	<EditorWaitStable/>
	<!-- ④ 정문 보기 — Sky Drop(x -28) 에서 정문(x 20)으로 -->
	<Store watch="Editor.SceneViewCameraX" as="dropX"/>
	<EditorClick mark="themepark.layout.gate"/>
	<WaitUntil watch="Editor.SceneViewCameraX" differsFrom="dropX" timeoutFrames="60"/>
	<EditorWaitStable/>
	<Variable name="gv_editorUiScale" value="0"/>
	<Pass/>
</Scenario>
