<!-- ThemePark 의 롤러코스터 레이아웃. 조각은 차례로 이어지고 끝에서 스테이션까지는 빌더가 곡선으로 잇는다 — 끝이 스테이션 몇 m 뒤에 오도록
     마지막 직선 길이를 맞춘다(앞으로 지나치면 연결이 접혀 큰 횡 G 가 난다 · CoasterTrackBuilder::makeTrack 가 경고한다).
     각 레이아웃은 테스트 운행(CoasterRideAnalyzer)으로 흥분 · 강도 · 멀미를 받고 그 값이 손님을 끈다. -->
<CoasterLayoutCatalog>
  <!-- 열차 물리(CoasterPhysicsParams)와 승차 평가 계수(CoasterRatingWeights) — 모든 칸이 필수다. 단위는 m, s, 적분 간격은 1/240 초 -->
  <Physics gravity="9.81" rollingResistance="0.012" dragCoefficient="0.0004" liftSpeed="4" stationSpeed="3" boosterSpeed="22" boosterAcceleration="9" brakeSpeed="5" brakeDeceleration="10" fixedStep="0.00416667" stallSpeed="0.3" stallSeconds="3" gForceWarmupSeconds="0.5"/>
