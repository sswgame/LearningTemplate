<?xml version="1.0" encoding="utf-8"?>
<!--
  ThemeParkTycoon 의 입력 차이 — 공통 묶음(gamesettings.xml 의 <inputMap> 줄) 위에 얹힌다. 게임 코드는 키를 직접 묻지 않고 액션 이름만 묻는다. 한 게임만 쓰는 이름은 게임 접두(Park.)다.
-->
<InputMap>
	<action name="Park.NextRide" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="Tab"/>
	</action>

	<action name="Park.ToggleOpen" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="O"/>
	</action>

	<action name="Park.PriceDown" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="LeftBracket"/>
	</action>

	<action name="Park.PriceUp" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="RightBracket"/>
	</action>

	<action name="Park.FeeDown" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="Minus"/>
	</action>

	<action name="Park.FeeUp" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="Equal"/>
	</action>

	<action name="Park.Build" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="B"/>
	</action>

	<action name="Park.Ride" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="V"/>
	</action>

	<action name="Park.Thoughts" layer="Gameplay" trigger="Pressed">
		<bind source="Key" code="G"/>
	</action>
	<!-- 일시정지는 UI 메뉴만 쓴다. -->
	<remove name="Pause"/>
</InputMap>
