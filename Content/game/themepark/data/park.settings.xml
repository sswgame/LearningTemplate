<?xml version="1.0" encoding="utf-8"?>
<!-- ThemeParkTycoon 의 사용자 설정 — 엔진 스키마(engine/settings/engine.settings.xml) 위에 덧붙는다(Config/Game/ThemeParkTycoon.json 의 _userSettingsSchema).
     조작 탭의 키 바인딩: 입력 맵(data/park.input.xml)의 액션마다 첫 바인딩을 다시 잡을 수 있다. 빈 default 는 "입력 맵의 기본 바인딩"이다.
     text 를 적지 않았으므로 메뉴는 설정 id 를 보인다(표시 이름은 로컬라이제이션 수집 뒤에 text 키로 더한다). -->
<UserSettingsSchema version="1">
	<Setting id="controls.parkNextRide" category="controls" type="keyBinding" action="Park.NextRide" bindIndex="0" default=""/>
	<Setting id="controls.parkToggleOpen" category="controls" type="keyBinding" action="Park.ToggleOpen" bindIndex="0" default=""/>
	<Setting id="controls.parkPriceDown" category="controls" type="keyBinding" action="Park.PriceDown" bindIndex="0" default=""/>
	<Setting id="controls.parkPriceUp" category="controls" type="keyBinding" action="Park.PriceUp" bindIndex="0" default=""/>
	<Setting id="controls.parkFeeDown" category="controls" type="keyBinding" action="Park.FeeDown" bindIndex="0" default=""/>
	<Setting id="controls.parkFeeUp" category="controls" type="keyBinding" action="Park.FeeUp" bindIndex="0" default=""/>
	<Setting id="controls.parkBuild" category="controls" type="keyBinding" action="Park.Build" bindIndex="0" default=""/>
	<Setting id="controls.parkRide" category="controls" type="keyBinding" action="Park.Ride" bindIndex="0" default=""/>
	<Setting id="controls.parkThoughts" category="controls" type="keyBinding" action="Park.Thoughts" bindIndex="0" default=""/>
	<Setting id="controls.parkStatus" category="controls" type="keyBinding" action="Park.Status" bindIndex="0" default=""/>
</UserSettingsSchema>
