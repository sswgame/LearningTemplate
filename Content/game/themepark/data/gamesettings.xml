<?xml version="1.0" encoding="utf-8"?>
<!-- ThemeParkTycoon 팩의 설정 — 시작 맵은 공원 씬이다(게임마다 팩의 data/gamesettings.xml 하나다). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Theme Park Tycoon" _userSettingsSchema="game/themepark/data/park.settings.xml" _bUIPauseMenu="true" />
  <startMap>game/themepark/maps/park.scene.xml</startMap>
  <inputMap>game/themepark/data/park.input.xml</inputMap>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/themepark/audio/themepark.audioevents.xml</audioEvents>
</GameSettings>
