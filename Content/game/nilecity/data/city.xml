<?asset guid="b9b78a37f924b6b00dd1d7c53dc18678"?>
<!-- NileCity 의 도시 데이터(파라오 장르, GF_CityBuilder 의 CityCatalog 형식).
     Terrain · Service: 땅 · 서비스의 종류(규칙 깃발 · 색). 도시의 칸 · 집 · 일꾼은 행 번호로 든다(저장은 id 로 옮긴다).
     Good: 물자. 집이 먹는 물자는 HouseLevel 의 goods 가 이름으로 적는다. Building: kind = House · Service · Producer · Storage · Market · Decoration.
       service + delivery(Walker = 도로를 도는 일꾼 · Radius = 반경 안 집에 늘) · range(걸음 수 · 반경 칸) · walkerInterval(초).
       Producer: goods 첫 칸을 productionTime 초마다 amount 만큼(일꾼이 다 찼을 때). terrain="Floodplain" 이면 해마다의 범람이 양을 정한다.
       Storage · Market: goods 는 받는 · 파는 물자, capacity 는 상한. desirability(음수 = 싫은 이웃) · desirabilityRadius.
     HouseLevel: 적은 순서가 단계(0 = 처음 짓는 오두막). services · goods 를 받고 매력도가 desirability 이상이 이어지면 오른다.
     세금(tax)은 세리가 다녀간 집만 사람마다 달마다 낸다. -->
<CityCatalog roadCost="2">
	<!-- 규칙(CitySettings) — 모든 칸이 필수다. 순회 서비스가 남는 시간은 이 도시의 도로망 한 바퀴(60 초)다 -->
	<Rules walkerSpeed="2.5" workerRatio="0.4" serviceDuration="60" immigrationInterval="1.5" immigrationJobMargin="4" immigrationMaxIdleRatio="0.25" floodFertilityStart="0.8" floodFertilityMin="0.4" floodFertilityMax="1" evolveDelay="3" wagePerWorkerPerMonth="0.5" fixedStep="0.25" serviceReach="2" goodsPerFourPeople="1" randomSeed="3100" currency="Deben"/>
  <!-- 땅 — 첫 행이 새 도시의 땅이다. blocked=true 면 도로 · 건물을 놓지 못한다. flood=true 인 땅을 요구하는 농장은 해마다의 범람이 양을 정한다. 색 · 높이(m)는 땅 상자의 모습이다 -->
  <Terrain id="Grass" name="Grass" color="0.45,0.62,0.3,1"/>
  <Terrain id="Sand" name="Sand" color="0.86,0.76,0.5,1"/>
  <Terrain id="Floodplain" name="Floodplain" color="0.36,0.42,0.2,1" flood="true"/>
  <Terrain id="Water" name="Water" color="0.2,0.45,0.75,1" blocked="true" surfaceHeight="-0.15"/>
  <Terrain id="Rock" name="Rock" color="0.5,0.47,0.44,1" blocked="true" rockHeight="0.8"/>

  <!-- 서비스 — laborFirst 는 일꾼을 먼저 받는다. tax 가 다녀간 집은 세금을 낸다. culture 를 모두 받는 집이 문화 평가에 든다 -->
  <Service id="Water" name="Water" color="0.25,0.5,0.95,1" laborFirst="true"/>
  <Service id="Religion" name="Religion" color="0.95,0.8,0.2,1" culture="true"/>
  <Service id="Entertainment" name="Entertainment" color="0.7,0.35,0.85,1" culture="true"/>
  <Service id="Health" name="Health" color="0.9,0.3,0.3,1"/>
  <Service id="Education" name="Education" color="0.2,0.75,0.7,1"/>
  <Service id="Tax" name="Tax" color="0.95,0.55,0.15,1" tax="true"/>

  <Good id="grain" name="Grain" price="8"/>
  <Good id="figs" name="Figs" price="10"/>
  <Good id="pottery" name="Pottery" price="20"/>
  <Good id="beer" name="Beer" price="24"/>

  <!-- 집 -->
  <Building id="house" name="Housing Plot" kind="House" size="1" cost="10" blockHeight="0.15" modelTint="1,1,1,1" blockColor="0.75,0.62,0.42,1"/>

  <!-- 물 -->
  <Building id="well" name="Well" kind="Service" service="Water" delivery="Radius" range="3" size="1" cost="15" desirability="1" desirabilityRadius="1" blockHeight="1.2" modelTint="0.625,0.75,0.975,1" blockColor="0.25,0.5,0.95,1"/>
  <Building id="water_supply" name="Water Supply" kind="Service" service="Water" range="40" walkerInterval="3" workers="4" size="2" cost="60" desirability="2" desirabilityRadius="2" blockHeight="1.2" modelTint="0.625,0.75,0.975,1" blockColor="0.25,0.5,0.95,1"/>

  <!-- 순회 서비스 -->
  <Building id="shrine" _base="water_supply" name="Shrine to Osiris" service="Religion" workers="2" size="1" cost="40" desirability="4" modelTint="0.975,0.9,0.6,1" blockColor="0.95,0.8,0.2,1"/>
  <Building id="juggler" name="Juggler School" kind="Service" service="Entertainment" range="40" walkerInterval="3" workers="3" size="2" cost="50" blockHeight="1.2" modelTint="0.85,0.675,0.925,1" blockColor="0.7,0.35,0.85,1"/>
  <Building id="apothecary" _base="shrine" name="Apothecary" service="Health" workers="3" desirability="1" desirabilityRadius="1" modelTint="0.95,0.65,0.65,1" blockColor="0.9,0.3,0.3,1"/>
  <Building id="scribe_school" _base="water_supply" name="Scribal School" service="Education" walkerInterval="4" cost="80" desirability="3" modelTint="0.6,0.875,0.85,1" blockColor="0.2,0.75,0.7,1"/>
  <Building id="tax_collector" name="Tax Collector" kind="Service" service="Tax" range="48" walkerInterval="3" workers="4" size="2" cost="80" blockHeight="1.2" modelTint="0.975,0.775,0.575,1" blockColor="0.95,0.55,0.15,1"/>

  <!-- 생산 — 범람원 농장은 해마다의 범람이 양을 정한다 -->
  <Building id="grain_farm" name="Grain Farm" kind="Producer" goods="grain" productionTime="10" amount="16" terrain="Floodplain" workers="6" size="3" cost="40" desirability="-2" desirabilityRadius="2" blockHeight="0.25" modelTint="0.85,0.65,0.5,1" blockColor="0.78,0.8,0.3,1"/>
  <Building id="fig_farm" _base="grain_farm" name="Fig Farm" goods="figs" amount="14"/>
  <Building id="potter" name="Potter" kind="Producer" goods="pottery" productionTime="16" amount="6" workers="5" size="2" cost="60" desirability="-4" desirabilityRadius="2" blockHeight="0.9" modelTint="0.85,0.65,0.5,1" blockColor="0.6,0.42,0.3,1"/>
  <Building id="brewery" _base="potter" name="Brewery" goods="beer" productionTime="18"/>

  <!-- 저장 · 시장 -->
  <Building id="granary" name="Granary" kind="Storage" goods="grain,figs" capacity="400" workers="4" size="3" cost="80" desirability="-2" desirabilityRadius="1" blockHeight="1.3" modelTint="0.8,0.68,0.55,1" blockColor="0.5,0.35,0.2,1"/>
  <Building id="storage_yard" name="Storage Yard" kind="Storage" goods="pottery,beer" capacity="200" workers="3" size="3" cost="60" desirability="-3" desirabilityRadius="2" blockHeight="1.3" modelTint="0.8,0.68,0.55,1" blockColor="0.5,0.35,0.2,1"/>
  <Building id="bazaar" name="Bazaar" kind="Market" goods="grain,figs,pottery,beer" capacity="160" range="40" walkerInterval="3" workers="3" size="2" cost="40" desirability="-1" desirabilityRadius="1" blockHeight="0.8" modelTint="1,0.75,0.55,1" blockColor="0.9,0.45,0.2,1"/>

  <!-- 장식 — 매력도만 -->
  <Building id="garden" name="Garden" kind="Decoration" size="1" cost="12" desirability="4" desirabilityRadius="3" blockHeight="0.4" modelTint="1,1,1,1" blockColor="0.3,0.75,0.35,1"/>
  <Building id="statue" _base="garden" name="Small Statue" cost="30" desirability="6"/>
  <Building id="plaza" name="Plaza" kind="Decoration" size="2" cost="40" desirability="8" desirabilityRadius="4" blockHeight="0.4" modelTint="1,1,1,1" blockColor="0.3,0.75,0.35,1"/>

  <!-- 집 단계 — 파라오의 이름(Crude Hut … Spacious Homestead) -->
  <HouseLevel name="Crude Hut" population="5" tax="1" blockHeight="0.5"/>
  <HouseLevel name="Sturdy Hut" population="7" services="Water" tax="1" blockHeight="0.7"/>
  <HouseLevel name="Meager Shanty" population="9" services="Water,Religion" goods="grain" desirability="-10" tax="1" blockHeight="0.9"/>
  <HouseLevel name="Common Shanty" population="11" services="Water,Religion,Entertainment" goods="grain" desirability="-6" tax="2" blockHeight="1.1"/>
  <HouseLevel name="Rough Cottage" population="13" services="Water,Religion,Entertainment,Health" goods="grain" desirability="-2" tax="2" blockHeight="1.3"/>
  <HouseLevel name="Ordinary Cottage" population="15" services="Water,Religion,Entertainment,Health" goods="grain,pottery" desirability="2" tax="3" blockHeight="1.5"/>
  <HouseLevel name="Modest Homestead" population="18" services="Water,Religion,Entertainment,Health,Education" goods="grain,figs,pottery" desirability="6" tax="3" blockHeight="1.7"/>
  <HouseLevel name="Spacious Homestead" population="21" services="Water,Religion,Entertainment,Health,Education" goods="grain,figs,pottery,beer" desirability="10" tax="4" blockHeight="1.9"/>
</CityCatalog>
