<?xml version="1.0" encoding="utf-8"?>
<!-- NileCity 팩의 설정 — 시작 맵은 나일 도시 씬이다(게임마다 팩의 data/gamesettings.xml 하나다). -->
<GameSettings>
  <!-- 엔진이 읽는 칸(PackEngineSettings) — 창 제목 · 렌더 파이프라인 · 사용자 설정과 텔레메트리 스키마 · UI 규칙 -->
  <Engine _windowTitle="Nile City" _userSettingsSchema="game/nilecity/data/nile.settings.xml" _bUIPauseMenu="true" />
  <startMap>game/nilecity/maps/nile.scene.xml</startMap>
  <inputMap path="common/input/base.input.xml"/>
  <inputMap path="common/input/virtualcursor.input.xml"/>
  <inputMap path="common/input/camera.input.xml"/>
  <inputMap path="common/input/camerapan.input.xml"/>
  <inputMap path="common/input/menu.input.xml"/>
  <inputMap path="common/input/time.input.xml"/>
  <inputMap path="game/nilecity/data/nile.input.xml"/>
  <loadingScreen>engine/ui/loading.ui.xml</loadingScreen>
  <audioEvents>game/nilecity/audio/nilecity.audioevents.xml</audioEvents>
  <defaultLanguage>ko_kr</defaultLanguage>
</GameSettings>
