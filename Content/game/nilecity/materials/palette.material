<?xml version="1.0" encoding="utf-8"?>
<!-- Kenney City Kit (Suburban) 모델의 팔레트 머티리얼 — _albedoMap 이 키트의 색 칸 텍스처다(모델 UV 가 칸을 고른다). 도로 · 건물 모델이 이 하나를 나눠 쓰고, 건물 종류 색은 디렉터가 만든 인스턴스가 곱한다. -->
<MaterialDef formatVersion="0" name="NileCityPalette" _base="engine/materials/benchtextured.material">
	<_properties>
		<item name="_albedoMap" assetPath="game/nilecity/textures/suburban_colormap.dds" />
	</_properties>
</MaterialDef>
