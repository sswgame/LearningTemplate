<!--
  팩 기본 시야각(둘째 팩 NileCity) — 팩 설정(data/gamesettings.xml 의 gameplay.fieldOfView 80)이 전역 변수 gv_cameraFieldOfView 로 적용되는지 본다.
  엔진 기본값은 70 이라, 팩 설정이 안 먹으면 70 으로 남아 실패한다.
  실행: App -scenario=game/nilecity/automation/fieldofview.scenario.xml -unattended (체인: ctest -R Scenario.nilecity)
-->
<Scenario name="game.nilecity.fieldofview" fixedDelta="0.0166667" timeoutFrames="60" startAfter="ScenePlaying" startTimeoutFrames="900" input="exclusive">
	<ExpectVariable name="gv_cameraFieldOfView" value="80" tolerance="0.001"/>
	<Pass/>
</Scenario>
