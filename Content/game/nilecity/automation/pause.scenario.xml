<?xml version="1.0" encoding="utf-8"?>
<!--
  NileCity 일시정지 메뉴 시나리오 — Esc 로 엔진 일시정지 메뉴(engine/ui/pause.ui.xml)가 뜨고, 떠 있는 동안 UI 가 먹은 입력(패드 B = 뒤로)은
  디렉터의 허물기(Nile.Demolish)로 새지 않는다(UIInputMapView). 배타 입력에서도 가상 커서는 돌아 패드 B 가 마우스 오른쪽도 내므로, 그 오른쪽까지 소비로 쳐야 한다
  (UIInputConsumption::isSlotConsumed 의 가상 커서 길). 메뉴를 닫은 뒤의 오른쪽 버튼은 허물기다(대조).
  디렉터는 마우스 버튼이 아니라 액션을 읽는다. 커서는 포인터 위치(화면 가운데), 짓기 · 허물기는 마우스 버튼 슬롯(왼쪽 · 오른쪽), 메뉴 뒤로는 패드 B(UI 입력 맵)다.
  실행: ctest -R Scenario.nilecity (SW_ACTIVE_GAME=NileCity) · App -scenario=game/nilecity/automation/pause.scenario.xml -unattended
-->
<Scenario name="game.nilecity.pause" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_nileAutoPlay" value="0"/>
	<WaitUntil watch="Input.VirtualCursorEnabled" equals="1" timeoutFrames="60"/>
	<MousePosition x="0.5" y="0.5"/>
	<Wait frames="2"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<!-- 사람의 누름처럼 여러 프레임(6) 누른다. 한 프레임짜리 누름은 UI 층이 켜지기 전에 떼어져, 같은 Esc 의 Back 이 메뉴를 닫는 결함을 가렸다 -->
	<Wait frames="8"/>
	<Tap slot="Key.Escape" hold="6"/>
	<!-- 화면 상태는 감시 값이 아니라 ExpectUI 로 본다 — 누름이 끝난 뒤에 -->
	<Wait frames="6"/>
	<ExpectUI screen="engine/ui/pause.ui.xml"/>
	<!-- 메뉴가 떠 있다: B 는 UI 뒤로가기라 메뉴를 닫고, 같은 B 로 허물지는 않는다(일어나지 않는 것을 보므로 고정 대기) -->
	<Wait frames="2"/>
	<Tap slot="Gamepad.B" hold="1"/>
	<Wait frames="22"/>
	<ExpectUI screen="none"/>
	<ExpectLog contains="[Nile] demolished" count="0"/>
	<!-- 메뉴를 닫은 뒤의 오른쪽 버튼은 디렉터의 것이다 -->
	<Wait frames="4"/>
	<Tap slot="Mouse.Right" hold="1"/>
	<Wait frames="6"/>
	<ExpectLog contains="[Nile] demolished" count="1"/>
	<Pass/>
</Scenario>
