<!--
  NileCity 일시정지 메뉴 시나리오 — Esc 로 엔진 일시정지 메뉴(engine/ui/pause.ui.xml)가 뜨고, 떠 있는 동안 UI 가 먹은 입력(패드 B = 뒤로)은
  디렉터의 허물기(Nile.Demolish)로 새지 않는다(UIInputMapView). 배타 입력에서도 가상 커서는 돌아 패드 B 가 마우스 오른쪽도 내므로, 그 오른쪽까지 소비로 쳐야 한다
  (UIInputConsumption::isSlotConsumed 의 가상 커서 길). 메뉴를 닫은 뒤의 오른쪽 버튼은 허물기다(대조).
  짓기 입력(CityBuildInputComponent)은 마우스 버튼이 아니라 액션을 읽는다. 커서는 포인터 위치(화면 가운데), 짓기 · 허물기는 마우스 버튼 슬롯(왼쪽 · 오른쪽), 메뉴 뒤로는 패드 B(UI 입력 맵)다.
  실행: ctest -R Scenario.nilecity (SW_ACTIVE_GAME=NileCity) · App -scenario=game/nilecity/automation/pause.scenario.xml -unattended
-->
<Scenario name="game.nilecity.pause" fixedDelta="0.0166667" timeoutFrames="400" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_nileAutoPlay" value="0"/>
	<WaitUntil watch="Input.VirtualCursorEnabled" equals="1" timeoutFrames="60"/>
	<MousePosition x="0.5" y="0.5"/>
	<WaitUntil watch="City.CursorCellX" atLeast="0" timeoutFrames="10"/> <!-- 커서가 포인터 아래 땅 칸을 잡았다 -->
	<Store watch="City.BuildCount" as="builds"/>
	<Store watch="City.DemolishCount" as="demolishes"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<!-- 사람의 누름처럼 여러 프레임(6) 누른다. 한 프레임짜리 누름은 UI 층이 켜지기 전에 떼어져, 같은 Esc 의 Back 이 메뉴를 닫는 결함을 가렸다 -->
	<WaitUntil watch="City.BuildCount" differsFrom="builds" timeoutFrames="10"/> <!-- 도로를 깔았다 -->
	<Tap slot="Key.Escape" hold="6"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/pause.ui.xml" timeoutFrames="30"/> <!-- 메뉴가 떴다 -->
	<AdvanceSimulation frames="6"/> <!-- 누름이 끝나도 메뉴가 닫히지 않는다(일어나지 않음 — 시간이 내용) -->
	<ExpectUI screen="engine/ui/pause.ui.xml"/>
	<!-- 메뉴가 떠 있다: B 는 UI 뒤로가기라 메뉴를 닫고, 같은 B 로 허물지는 않는다(일어나지 않는 것을 보므로 시간이 내용 — AdvanceSimulation) -->
	<Tap slot="Gamepad.B" hold="1"/>
	<AdvanceSimulation frames="22"/> <!-- 일어나지 않음 — 시간이 내용 -->
	<ExpectUI screen="none"/>
	<ExpectLog id="City.Demolished" count="0"/>
	<Expect watch="City.DemolishCount" sameAs="demolishes"/>
	<!-- 메뉴를 닫은 뒤의 오른쪽 버튼은 디렉터의 것이다 -->
	<Tap slot="Mouse.Right" hold="1"/>
	<WaitUntil watch="City.DemolishCount" differsFrom="demolishes" timeoutFrames="10"/> <!-- 메뉴를 닫은 뒤의 오른쪽 버튼으로 허물었다 -->
	<ExpectLog id="City.Demolished" count="1"/>
	<!-- 게임 시간이 멈춰도 입력은 실제 시간으로 흐른다 — 메뉴 위에서도 패드 가상 커서가 움직인다 -->
	<Tap slot="Key.Escape" hold="6"/>
	<WaitUntil watch="UI.ActiveScreen" is="engine/ui/pause.ui.xml" timeoutFrames="30"/>
	<WaitUntil watch="Time.Paused" equals="1" timeoutFrames="10"/>
	<Store watch="Input.MouseX" as="pausedX"/>
	<GamepadAxis axis="0" value="1"/>
	<WaitUntil watch="Input.MouseX" differsFrom="pausedX" timeoutFrames="30"/>
	<Pass/>
</Scenario>
