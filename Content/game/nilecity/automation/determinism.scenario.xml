<!--
  NileCity 결정적 재생 — 자동 계획으로 도시를 고정 틱(1/60 초)에 돌리고 같은 프레임(도구를 바꾼 뒤 272 · 1172 프레임)의 도시 상태(인구 · 돈 · 달 · 오브젝트 위치 해시)를 보고의 records 에 남긴다.
  게임 상태는 CPU 에서만 정해지므로 네 백엔드가 같은 기록을 내야 한다. 시뮬레이션 시간이 흘러야 하는 시나리오라 AdvanceSimulation 이다(기록 프레임이 시험 내용).
  사이에 액션 단계로 도구를 바꾸고(Nile.NextTool → Nile.RoadTool) 자동 계획이 끝까지 도시를 키우는지 본다.
  실행: ctest -R Scenario.nilecity (SW_ACTIVE_GAME=NileCity) · App -scenario=game/nilecity/automation/determinism.scenario.xml -unattended
-->
<Scenario name="game.nilecity.determinism" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_nileAutoPlay" value="1"/>
	<AdvanceSimulation frames="20"/> <!-- 자동 계획이 돌 시간 — 기록 프레임이 시험 내용 -->
	<Action name="Nile.NextTool"/>
	<WaitUntil watch="Nile.Tool" equals="1" timeoutFrames="10"/> <!-- 다음 도구를 골랐다 -->
	<Action name="Nile.RoadTool"/>
	<WaitUntil watch="Nile.Tool" equals="0" timeoutFrames="10"/> <!-- 도로 도구로 돌아왔다 -->
	<ExpectLog id="Nile.ToolSelected" atLeast="2"/>
	<!-- 도구를 바꾼 뒤 272 프레임(약 5 초) -->
	<AdvanceSimulation frames="272"/>
	<Record watch="Nile.Month"/>
	<Record watch="Nile.Population"/>
	<Record watch="Nile.Money"/>
	<Record watch="Scene.ObjectCount"/>
	<Record watch="Scene.TransformHash"/>
	<!-- 그 뒤 900 프레임(약 20 초) -->
	<AdvanceSimulation frames="900"/>
	<WaitUntil watch="Nile.Month" atLeast="1" timeoutFrames="120"/> <!-- 첫 달(20 초)이 끝났다 — 위 진행은 19.9 초라 달 경계 바로 앞이다 -->
	<Expect watch="Nile.Population" atLeast="1"/>
	<Record watch="Nile.Month"/>
	<Record watch="Nile.Population"/>
	<Record watch="Nile.Money"/>
	<Record watch="Scene.ObjectCount"/>
	<Record watch="Scene.TransformHash"/>
	<Pass/>
</Scenario>
