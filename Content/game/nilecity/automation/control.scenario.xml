<!--
  NileCity 조작 시나리오 — 짓기 입력(CityBuildInputComponent)은 마우스 버튼이 아니라 액션(Nile.Place · Nile.Demolish)을 읽는다.
  커서는 포인터 위치(MousePosition — 화면 가운데 = 리그 초점 칸), 누르는 것은 마우스 버튼 슬롯(왼쪽 = 짓기, 오른쪽 = 허물기) — 패드 A · B 는 가상 커서가 마우스 버튼으로 바꾼다(배타 가상 입력에서도 돈다). — 처음 도구(도로)를 깔고 같은 칸을 허문다.
  실행: ctest -R Scenario.nilecity (SW_ACTIVE_GAME=NileCity) · App -scenario=game/nilecity/automation/control.scenario.xml -unattended
-->
<Scenario name="game.nilecity.control" fixedDelta="0.0166667" timeoutFrames="300" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_nileAutoPlay" value="0"/>
	<WaitUntil watch="Input.VirtualCursorEnabled" equals="1" timeoutFrames="60"/>
	<MousePosition x="0.5" y="0.5"/>
	<WaitUntil watch="City.CursorCellX" atLeast="0" timeoutFrames="10"/> <!-- 커서가 포인터 아래 땅 칸을 잡았다 -->
	<Store watch="City.CursorCellX" as="cellX"/>
	<Store watch="City.CursorCellZ" as="cellZ"/>
	<Store watch="City.BuildCount" as="builds"/>
	<Store watch="City.DemolishCount" as="demolishes"/>
	<Tap slot="Mouse.Left" hold="1"/>
	<WaitUntil watch="City.BuildCount" differsFrom="builds" timeoutFrames="10"/> <!-- 도로를 깔았다 -->
	<Tap slot="Mouse.Right" hold="1"/>
	<WaitUntil watch="City.DemolishCount" differsFrom="demolishes" timeoutFrames="10"/> <!-- 허물었다 -->
	<Expect watch="City.CursorCellX" sameAs="cellX"/> <!-- 깐 칸을 허물었다 -->
	<Expect watch="City.CursorCellZ" sameAs="cellZ"/>
	<ExpectLog id="City.Demolished" count="1"/>
	<Pass/>
</Scenario>
