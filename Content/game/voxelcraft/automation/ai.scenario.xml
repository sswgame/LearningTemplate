<?xml version="1.0" encoding="utf-8"?>
<!--
  VoxelCraft 자동 플레이 AI — 빙의(Pawn.Controller)와 판단 상태(AI.State)를 단언한다. 자동 플레이를 켜면 디렉터가 VoxelAutoPlay 조종자를 세워 플레이어 폰(Player)에
  빙의시키고, 조종자는 한 주기(12 초) 동안 걷다가(Walk) 3 ~ 6.5 초에 부수고(Break) 9 초에 한 번 놓는다(Place, 한 틱). 끄면 플레이어 조종자가 되찾고 AI 는 걷힌다.
  실행: ctest -R Scenario.voxelcraft (SW_ACTIVE_GAME=VoxelCraft) · App -scenario=game/voxelcraft/automation/ai.scenario.xml -unattended
-->
<Scenario name="game.voxelcraft.ai" fixedDelta="0.0166667" timeoutFrames="1500" startAfter="ScenePlaying" input="exclusive">
	<Variable name="gv_voxelAutoPlay" value="0"/>
	<WaitUntil watch="Pawn.Controller" target="Player" is="PlayerController" timeoutFrames="120"/>
	<Variable name="gv_voxelAutoPlay" value="1"/>
	<WaitUntil watch="Pawn.Controller" target="Player" is="VoxelAutoPlay" timeoutFrames="30"/>
	<Expect watch="AI.State" target="VoxelAutoPlay" is="Walk"/>
	<!-- 첫 주기의 놓기(9 초)까지 걷기 → 부수기 → 걷기 → 놓기를 이 순서로 거친다. 놓기는 한 틱이지만 이력은 값이 바뀔 때 적으므로 남는다.
	     조종자 오브젝트는 자동 플레이를 켤 때 생기므로 이력은 그때부터다(옛 since 프레임은 조건 대기가 프레임을 옮겨 적지 않는다). -->
	<WaitUntil watch="AI.State" target="VoxelAutoPlay" is="Place" timeoutSeconds="12"/>
	<ExpectVisited watch="AI.State" target="VoxelAutoPlay" sequence="Walk, Break, Walk, Place"/>
	<Expect watch="VoxelCraft.BrokenCount" atLeast="1"/>
	<Record watch="VoxelCraft.BrokenCount"/>
	<!-- 끄면 플레이어 조종자가 되찾고 자동 플레이 조종자 오브젝트는 사라진다. -->
	<Wait frames="1"/>
	<Variable name="gv_voxelAutoPlay" value="0"/>
	<WaitUntil watch="Pawn.Controller" target="Player" is="PlayerController" timeoutFrames="30"/>
	<WaitUntil watch="Object.Exists" target="VoxelAutoPlay" equals="0" timeoutFrames="30"/>
	<Pass/>
</Scenario>
