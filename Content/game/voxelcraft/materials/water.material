<?xml version="1.0" encoding="utf-8"?>
<!-- 블록 청크의 물(반투명) 머티리얼 — 유리 머티리얼과 같은 블렌드에 _albedoMap 이 블록 아틀라스다. 알파는 메셔의 정점 색이 준다. -->
<MaterialDesc formatVersion="0" name="VoxelWater" _base="engine/materials/benchtextured.material" alphaMode="Blend">
	<_properties>
		<item name="_albedoMap" assetPath="game/voxelcraft/textures/blocks.dds" />
	</_properties>
	<_permutations quality="High" shaderLOD="300" usage="StaticMesh">
		<_alwaysDefines>
			<item>MATERIAL_DOMAIN_SURFACE</item>
			<item>MATERIAL_BLEND_TRANSLUCENT</item>
		</_alwaysDefines>
		<_multiCompiles>
			<item name="FogMode" selected="FOG_OFF">
				<_options>
					<item>FOG_OFF</item>
					<item>FOG_LINEAR</item>
					<item>FOG_EXP</item>
				</_options>
			</item>
		</_multiCompiles>
	</_permutations>
</MaterialDesc>
